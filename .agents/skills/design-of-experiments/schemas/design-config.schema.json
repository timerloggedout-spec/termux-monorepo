{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "design",
    "factors",
    "model",
    "seed"
  ],
  "properties": {
    "design": {
      "enum": [
        "full-factorial",
        "fractional-factorial",
        "face-centered-ccd",
        "box-behnken"
      ]
    },
    "factors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "low",
          "high"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9]*$"
          },
          "low": {
            "type": "number"
          },
          "high": {
            "type": "number"
          },
          "units": {
            "type": "string"
          }
        }
      }
    },
    "model": {
      "enum": [
        "main",
        "two-factor",
        "quadratic"
      ]
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "replicates": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "center_points": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "generators": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}