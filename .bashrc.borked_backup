alias dep='bash ~/workspace/llm_map/depgraph.sh'
alias depmenu='bash ~/workspace/llm_map/depmenu.sh'
# LLM Context: given a file and a question, build an injection bundle
llmctx() {
  local target="$1"
  local question="${*:2}"
  echo "=== Ecosystem Context ==="
  echo "File: $target"
  echo "Functions:"
  funcfind "$target" 2>/dev/null || echo "(no functions found)"
  echo ""
  echo "Dependencies:"
  dep "$target" 2>/dev/null || echo "(no deps found)"
  echo ""
  echo "Question: $question"
