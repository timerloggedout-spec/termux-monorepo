{
  "name": "termux-monorepo-agent",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bullseye",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "configureZshAsDefaultShell": false,
      "installOhMyZsh": false,
      "upgradePackages": true
    },
    "ghcr.io/devcontainers/features/node:1": { "version": "20" },
    "ghcr.io/devcontainers/features/rust:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "postCreateCommand": "bash -c 'export ARCHWIZ_ENV=codespace; bash setup.sh || true; git submodule update --init --recursive --depth 1 || true'",
  "postStartCommand": "bash -c 'echo \"[codespace] agent lane ready: $(date -u +%Y-%m-%dT%H:%M:%SZ)\"'",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "rust-lang.rust-analyzer",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "GitHub.copilot",
        "GitHub.vscode-pull-request-github"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "terminal.integrated.defaultProfile.linux": "bash",
        "files.watcherExclude": {
          "**/.git/objects/**": true,
          "**/.git/subtree-cache/**": true,
          "**/node_modules/**": true,
          "**/.venv/**": true
        }
      }
    },
    "codespaces": {
      "repositories": {}
    }
  },
  "remoteEnv": {
    "ARCHWIZ_ENV": "codespace",
    "CODESPACE_AGENT": "1"
  },
  "forwardPorts": [],
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  },
  "shutdownAction": "stopContainer"
}
