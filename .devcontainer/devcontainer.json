{
  "name": "termux-monorepo / hindsight-self-host",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "moby": false,
      "enableNonRootDocker": true
    }
  },
  "hostRequirements": { "cpus": 4, "memory": "8gb", "storage": "32gb" },
  "forwardPorts": [8888, 8000, 8800],
  "portsAttributes": {
    "8888": { "label": "hindsight-api", "onAutoForward": "silent" },
    "8000": { "label": "kimi-free-api", "onAutoForward": "silent" },
    "8800": { "label": "deepcli-server", "onAutoForward": "silent" }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/post-start.sh",
  "remoteEnv": {
    "HINDSIGHT_BASE_URL": "http://localhost:8888",
    "KIMI_LOCAL_URL": "http://localhost:8000",
    "HINDSIGHT_API_LLM_PROVIDER": "gemini"
  },
  "secrets": {
    "HINDSIGHT_API_LLM_API_KEY": { "description": "Google AI Studio key" },
    "HINDSIGHT_API_KEY":          { "description": "Existing cloud key" },
    "MOONSHOT_REFRESH_TOKEN":     { "description": "Kimi refresh_token" }
  }
}
