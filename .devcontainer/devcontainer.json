{
  "name": "hindsight-glibc",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": { "version": "latest" }
  },
  "hostRequirements": { "cpus": 4, "memory": "8gb", "storage": "32gb" },
  "forwardPorts": [8888, 8502],
  "portsAttributes": {
    "8888": { "label": "hindsight", "onAutoForward": "silent" },
    "8502": { "label": "observatory", "onAutoForward": "silent" }
  },
  "containerEnv": {
    "HINDSIGHT_API_LLM_PROVIDER": "gemini",
    "HINDSIGHT_API_LLM_MODEL": "gemini-2.0-flash",
    "HINDSIGHT_API_LLM_GEMINI_SERVICE_TIER": "on_demand",
    "HINDSIGHT_API_EMBEDDINGS_PROVIDER": "gemini",
    "HINDSIGHT_API_EMBEDDINGS_MODEL": "text-embedding-004",
    "HINDSIGHT_API_RERANKER_PROVIDER": "none",
    "HINDSIGHT_API_FILE_PARSER": "markitdown",
    "HINDSIGHT_API_FILE_PARSER_ALLOWLIST": "markitdown"
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/post-start.sh"
}
