// General dev/build lane — Codespaces Infrastructure multi-lane setup.
// Sibling lanes in this same .devcontainer directory:
//   - root .devcontainer/devcontainer.json      → BASH/ops agent lane (#530/#531, unchanged default)
//   - .devcontainer/docs-lane/devcontainer.json  → lightweight Docs/Mintlify lane
//   - .devcontainer/governance-lane/devcontainer.json → PR-triage/governance lane
//   - .devcontainer/general-dev/devcontainer.json (this file) → full monorepo code stack
//
// Maps to docs/ops/SKILLS-INVENTORY.md role load matrix: Collaborator / Codespace agent role.
// On start, load `adaptive-feedback-cycle`, then run the dual-gate
// (`scripts/ci/repo_gate.py` + `scripts/ci/termux_smoke.py`) plus repo conventions.
{
  "name": "termux-monorepo-general-dev-lane",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bullseye",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "configureZshAsDefaultShell": false,
      "installOhMyZsh": false,
      "upgradePackages": true
    },
    "ghcr.io/devcontainers/features/node:1": { "version": "20" },
    "ghcr.io/devcontainers/features/rust:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "postCreateCommand": "bash -c 'export ARCHWIZ_ENV=codespace; export DEBIAN_FRONTEND=noninteractive; sudo apt-get update -qq && sudo apt-get install -y -qq jq ripgrep fd-find shellcheck 2>/dev/null || true; bash setup.sh || true; git submodule update --init --recursive --depth 1 || true; python3 scripts/ci/repo_gate.py --help > /dev/null 2>&1 || true; python3 scripts/ci/termux_smoke.py --help > /dev/null 2>&1 || true; echo \"[codespace] general-dev lane ready: dual-gate smoke helpers verified\"; echo \"[skills] role: Collaborator / Codespace agent -- look up the current skill set in docs/ops/SKILLS-INVENTORY.md (Role load matrix table, do not hardcode a SHA); as of last check: load adaptive-feedback-cycle first, then the dual-gate (repo_gate + termux_smoke) + conventions, optional review-loop\"'",
  "postStartCommand": "bash -c 'echo \"[codespace] general-dev lane ready: $(date -u +%Y-%m-%dT%H:%M:%SZ) ARCHWIZ_ENV=$ARCHWIZ_ENV CODESPACE_LANE=$CODESPACE_LANE\"'",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "rust-lang.rust-analyzer",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "GitHub.copilot",
        "GitHub.vscode-pull-request-github"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "terminal.integrated.defaultProfile.linux": "bash",
        "files.watcherExclude": {
          "**/.git/objects/**": true,
          "**/.git/subtree-cache/**": true,
          "**/node_modules/**": true,
          "**/.venv/**": true
        }
      }
    },
    "codespaces": {
      "repositories": {}
    }
  },
  "remoteEnv": {
    "ARCHWIZ_ENV": "codespace",
    "CODESPACE_AGENT": "1",
    "CODESPACE_LANE": "general-dev"
  },
  "forwardPorts": [],
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  },
  "shutdownAction": "stopContainer"
}