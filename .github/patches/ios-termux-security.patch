--- /dev/null
+++ b/tests/test_security_regressions.py
@@ -0,0 +1,30 @@
+import pytest
+
+from ios2termux.brains import evaluate
+
+
+@pytest.mark.parametrize("request", [
+    {"expose_sshd_public": True},
+    {"expose_sshd_public": True, "auth": True},
+    {"expose_sshd_public": True, "password_auth": True},
+    {"expose_sshd_public": True, "password_auth_only": True},
+    {"public_internet": True, "password_auth": True},
+    {"sshd_public": True, "auth": "password"},
+])
+def test_public_ssh_without_explicit_key_auth_is_held(request):
+    assert any(
+        gate.trigger == "sshd_public_no_auth"
+        for gate in evaluate(request)
+    )
+
+
+@pytest.mark.parametrize("request", [
+    {"expose_sshd_public": True, "key_auth": True},
+    {"expose_sshd_public": True, "use_key": True},
+    {"expose_sshd_public": True, "public_key_auth": True},
+])
+def test_public_ssh_with_explicit_key_auth_clears_this_gate(request):
+    assert not any(
+        gate.trigger == "sshd_public_no_auth"
+        for gate in evaluate(request)
+    )
