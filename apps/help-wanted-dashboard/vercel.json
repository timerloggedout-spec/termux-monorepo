{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/matrix", "destination": "/matrix.html" },
    { "source": "/lane-matrix", "destination": "/matrix.html" }
  ],
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=60, s-maxage=60" }
      ]
    }
  ]
}
