[Unit]
Description=Match Impact Desk procurement workflow
After=network.target

[Service]
Type=simple
User=matchdesk
Group=matchdesk
WorkingDirectory=/opt/match-impact-desk
EnvironmentFile=/etc/match-impact-desk.env
Environment=MATCHDESK_ENV=production
Environment=MATCHDESK_HOST=127.0.0.1
Environment=MATCHDESK_PORT=8080
ExecStart=/usr/bin/python3 /opt/match-impact-desk/app.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/match-impact-desk/data
RestrictSUIDSGID=true
UMask=0077

[Install]
WantedBy=multi-user.target
