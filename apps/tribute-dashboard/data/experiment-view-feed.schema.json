{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timerloggedout-spec.github.io/tribute/data/experiment-view-feed.schema.json",
  "title": "RFP Published View Feed",
  "type": "object",
  "required": [
    "schema_version",
    "feed_status",
    "methods",
    "phases",
    "design_classes",
    "campaigns",
    "workstreams",
    "experiments",
    "runs"
  ],
  "properties": {
    "schema_version": {
      "const": "rfp-published-views/v1"
    },
    "feed_status": {
      "type": "string"
    },
    "generated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "additionalProperties": true
    },
    "methods": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "kind",
          "status",
          "design",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "design": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "order",
          "name",
          "theme"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "type": "string"
          },
          "theme": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "design_classes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "status",
          "generator",
          "purpose"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "enum": [
              "implemented",
              "skill-named",
              "candidate"
            ]
          },
          "generator": {
            "type": [
              "string",
              "null"
            ]
          },
          "purpose": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "campaigns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "campaign_id"
        ],
        "properties": {
          "campaign_id": {
            "type": "string"
          },
          "method_id": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "workstreams": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "method_id": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "start": {
            "type": "string",
            "anyOf": [{"format": "date"}, {"format": "date-time"}]
          },
          "end": {
            "type": "string",
            "anyOf": [{"format": "date"}, {"format": "date-time"}]
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "experiments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "experiment_id"
        ],
        "properties": {
          "experiment_id": {
            "type": "string"
          },
          "method_id": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "run_id",
          "experiment_id"
        ],
        "properties": {
          "run_id": {
            "type": "string"
          },
          "experiment_id": {
            "type": "string"
          },
          "method_id": {
            "type": "string"
          },
          "outcome": {},
          "validity": {
            "type": "string"
          },
          "evidence_url": {
            "type": "string",
            "format": "uri"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
