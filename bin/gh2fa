#!/data/data/com.termux/files/usr/bin/bash
# gh2fa — print current GitHub TOTP. Auto-reprime gpg-agent on failure.
set -eu
BIN="$(dirname "$(readlink -f "$0")")"
code=""
if ! code="$(pass otp secret/github 2>/dev/null)" || [ -z "$code" ]; then
    "$BIN/gpg-prime" >/dev/null 2>&1 || true
    code="$(pass otp secret/github)"
fi
printf '%s\n' "$code"
