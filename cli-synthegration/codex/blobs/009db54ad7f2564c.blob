<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>Global Regulatory Intelligence</title>
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=JetBrains+Mono:wght@400;500;600&family=Outfit:wght@300;400;500;600&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <script src="https://cdn.jsdelivr.net/npm/react@18.2.0/umd/react.production.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/react-dom@18.2.0/umd/react-dom.production.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/react-simple-maps@3/dist/react-simple-maps.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/papaparse@5.4.1/papaparse.min.js"></script>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { background: #080c14; color: #e2e8f0; font-family: 'Outfit', sans-serif; }
    ::-webkit-scrollbar { width: 4px; height: 4px; }
    ::-webkit-scrollbar-track { background: #0f1724; }
    ::-webkit-scrollbar-thumb { background: #2d4a6e; border-radius: 2px; }
    .spin { animation: spin 1s linear infinite; }
    @keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
    .slide-in { animation: slideIn .25s ease-out; }
    @keyframes slideIn { from { transform: translateX(20px); opacity: 0; } to { transform: translateX(0); opacity: 1; } }
    .sidebar-mobile { transform: translateX(-100%); transition: transform 0.3s ease; }
    .sidebar-mobile.open { transform: translateX(0); }
    .detail-panel { transform: translateX(100%); transition: transform 0.3s ease; }
    .detail-panel.open { transform: translateX(0); }
  </style>
</head>
<body class="bg-[#080c14] text-[#e2e8f0]">
  <div id="root"></div>
  <script type="text/babel">
    const { useState, useEffect, useRef } = React;
    const { ComposableMap, Geographies, Geography, ZoomableGroup } = window.ReactSimpleMaps;

    const API_URL = 'YOUR_APPS_SCRIPT_URL';
    const GEO_URL = 'https://cdn.jsdelivr.net/npm/world-atlas@2/countries-110m.json';
    const ISO_COUNTRIES_URL = 'https://raw.githubusercontent.com/stefangabos/world_countries/master/data/countries/en/world.json';

    const statusColors = {
      approved: '#22c55e', investigational: '#3b82f6', unapproved: '#ef4444', withdrawn: '#f59e0b',
      under_review: '#a78bfa', harmonised: '#818cf8', unknown: '#64748b'
    };
    const wadaColor = { prohibited: '#ef4444', permitted: '#22c55e', unknown: '#64748b' };
    const JURISDICTIONS = ['US','EU','CA','AU','UK','JP','RU'];

    const Badge = ({ color, bg, children, small }) => (
      <span style={{ background: bg || color + '22', color, border: `1px solid ${color}44`, borderRadius: 4, padding: small ? '1px 6px' : '2px 8px', fontSize: small ? 10 : 11, fontFamily: "'JetBrains Mono', monospace", fontWeight: 600, whiteSpace: 'nowrap', letterSpacing: 0.5 }}>{children}</span>
    );
    const JurisCell = ({ status, access }) => {
      const s = statusColors[status] || '#64748b';
      const bgMap = { prescription_only:'#1a3a2a', clinical_trial_only:'#1a2a3a', pharmacy_compounded:'#2a2a1a', prohibited:'#3a1a1a', not_marketed:'#1a1a2a', unknown:'#1a1a1a' };
      const labelMap = { prescription_only:'Rx Only', clinical_trial_only:'Trial Only', pharmacy_compounded:'Compounding', prohibited:'Prohibited', not_marketed:'Not Marketed', unknown:'Unknown' };
      const textMap = { prescription_only:'#86efac', clinical_trial_only:'#93c5fd', pharmacy_compounded:'#fde68a', prohibited:'#fca5a5', not_marketed:'#94a3b8', unknown:'#64748b' };
      const bg = bgMap[access] || '#1a1a1a';
      const tc = textMap[access] || '#94a3b8';
      const lb = labelMap[access] || '—';
      return (<div style={{ background: bg, border: `1px solid ${s}44`, borderRadius: 6, padding: '4px 6px', minWidth: 80, textAlign: 'center' }}><div style={{ color: s, fontSize: 10, fontFamily: "'JetBrains Mono', monospace", fontWeight: 600, textTransform: 'uppercase', letterSpacing: 0.5 }}>{status}</div><div style={{ color: tc, fontSize: 9, marginTop: 1 }}>{lb}</div></div>);
    };
    const RiskChip = ({ level }) => {
      const map = { approved:{c:'#22c55e',l:'Approved'}, phase_3:{c:'#8b5cf6',l:'Phase 3'}, phase_2:{c:'#a78bfa',l:'Phase 2'}, withdrawn:{c:'#f59e0b',l:'Withdrawn'}, unapproved:{c:'#ef4444',l:'No Approval'}, preclinical:{c:'#f97316',l:'Preclinical'} };
      const m = map[level] || {c:'#64748b',l:'Unknown'};
      return <Badge color={m.c}>{m.l}</Badge>;
    };
    const SectionBlock = ({ title, children, accent = '#3b82f6' }) => (
      <div style={{ marginBottom: 16 }}><div style={{ color: accent, fontSize: 10, fontFamily: "'JetBrains Mono', monospace", fontWeight: 600, letterSpacing: 1.5, textTransform: 'uppercase', borderBottom: `1px solid ${accent}33`, paddingBottom: 4, marginBottom: 8 }}>{title}</div><div style={{ color: '#cbd5e1', fontSize: 13, lineHeight: 1.6 }}>{children}</div></div>
    );

    function App() {
      const [compounds, setCompounds] = useState([]);
      const [combinations, setCombinations] = useState([]);
      const [loading, setLoading] = useState(true);
      const [search, setSearch] = useState('');
      const [filterType, setFilterType] = useState('all');
      const [filterWADA, setFilterWADA] = useState('all');
      const [filterUS, setFilterUS] = useState('all');
      const [selectedIds, setSelectedIds] = useState([]);
      const [compareMode, setCompareMode] = useState(false);
      const [activeTab, setActiveTab] = useState('matrix');
      const [mobileMenuOpen, setMobileMenuOpen] = useState(false);
      const [trialsData, setTrialsData] = useState([]);
      const [rorData, setRorData] = useState([]);
      const [trialsLoading, setTrialsLoading] = useState(false);
      const [rorLoading, setRorLoading] = useState(false);
      const [countryMap, setCountryMap] = useState({});
      const [countryTierMap, setCountryTierMap] = useState({});
      const [enriching, setEnriching] = useState(false);
      const panelRef = useRef(null);

      useEffect(() => {
        const fetchData = async () => {
          try {
            const [compRes, countryRes, tierRes, combRes] = await Promise.all([
              fetch(API_URL),
              fetch(ISO_COUNTRIES_URL),
              fetch(API_URL + '?type=countries'),
              fetch(API_URL + '?type=combinations')
            ]);
            const compData = await compRes.json();
            const countryData = await countryRes.json();
            const tierData = await tierRes.json();
            const combData = await combRes.json();
            
            const tierMap = {};
            tierData.forEach(row => { tierMap[row.ISO_A3] = { tier: row.tier, name: row.regulator_name }; });
            setCountryTierMap(tierMap);
            
            const newMap = {};
            countryData.forEach(c => {
              const iso3 = c.alpha3.toUpperCase();
              if (iso3 === 'USA') newMap[iso3] = 'us';
              else if (iso3 === 'CAN') newMap[iso3] = 'ca';
              else if (iso3 === 'GBR') newMap[iso3] = 'uk';
              else if (iso3 === 'AUS') newMap[iso3] = 'au';
              else if (iso3 === 'JPN') newMap[iso3] = 'jp';
              else if (iso3 === 'RUS') newMap[iso3] = 'ru';
              else if (['FRA','DEU','ITA','ESP','NLD','BEL','SWE','AUT','DNK','FIN','IRL','PRT','GRC','CZE','HUN','POL','ROU','BGR','SVK','SVN','HRV','LTU','LVA','EST','CYP','MLT','LUX'].includes(iso3)) newMap[iso3] = 'eu';
              else newMap[iso3] = iso3.toLowerCase();
            });
            setCountryMap(newMap);
            setCompounds(compData);
            setCombinations(combData);
          } catch (err) { console.error(err); }
          finally { setLoading(false); }
        };
        fetchData();
      }, []);

      // Enrich on search when no results
      const handleEnrich = async () => {
        if (!search.trim()) return;
        setEnriching(true);
        try {
          const res = await fetch(API_URL + '?action=enrich', {
            method: 'POST',
            body: JSON.stringify({ query: search }),
            headers: { 'Content-Type': 'application/json' }
          });
          const data = await res.json();
          if (data.added) {
            // Refresh compounds
            const compRes = await fetch(API_URL);
            const fresh = await compRes.json();
            setCompounds(fresh);
            alert(`Added ${data.added.Canonical_Name} to database.`);
          } else if (data.existing) {
            alert('Already in database.');
          } else {
            alert('Not found in external sources.');
          }
        } catch(e) { alert('Enrichment failed.'); }
        finally { setEnriching(false); }
      };

      const types = ['all', ...new Set(compounds.map(c => c.Entity_Type).filter(Boolean))];
      const wadaStatuses = ['all', 'prohibited', 'permitted', 'unknown'];
      const usStatuses = ['all', 'approved', 'unapproved', 'investigational', 'withdrawn'];

      const filtered = compounds.filter(c => {
        const q = search.toLowerCase();
        const name = (c.Canonical_Name || '').toLowerCase();
        const synonyms = (c.Synonyms || '').toLowerCase();
        const id = (c.Entity_ID || '').toLowerCase();
        const matchSearch = !q || name.includes(q) || synonyms.includes(q) || id.includes(q);
        const matchType = filterType === 'all' || c.Entity_Type === filterType;
        const matchWADA = filterWADA === 'all' || (c.WADA_Status || 'unknown').toLowerCase() === filterWADA;
        const matchUS = filterUS === 'all' || (c.US_FDA_Status || 'unknown') === filterUS;
        return matchSearch && matchType && matchWADA && matchUS;
      });

      const stats = {
        total: compounds.length,
        approved: compounds.filter(c => c.US_FDA_Status === 'approved').length,
        prohibited: compounds.filter(c => c.WADA_Status === 'prohibited').length,
        unapproved: compounds.filter(c => c.US_FDA_Status === 'unapproved').length,
        investigational: compounds.filter(c => ['phase_3','phase_2'].includes(c.Development_Stage_Global)).length
      };

      const getCountryStatus = (geo, compound) => {
        const iso = geo.properties.ISO_A3;
        const jurisKey = countryMap[iso] || iso.toLowerCase();
        if (compound) {
          const status = compound[`${jurisKey}_FDA_Status`] || compound[`${jurisKey}_EMA_Status`] || compound[`${jurisKey}_Status`];
          if (status) return status;
        }
        const regInfo = countryTierMap[iso] || { tier: 'unknown' };
        if (regInfo.tier === 'wla') return 'under_review';
        if (regInfo.tier === 'ich') return 'harmonised';
        return 'unknown';
      };

      const searchTrials = async (query, country = '') => {
        setTrialsLoading(true);
        let term = query;
        if (country) term += ` AND ${country}`;
        const url = `https://clinicaltrials.gov/api/v2/studies?query.term=${encodeURIComponent(term)}&pageSize=30`;
        try { const res = await fetch(url); const data = await res.json(); setTrialsData(data.studies || []); }
        catch (e) { console.error(e); }
        finally { setTrialsLoading(false); }
      };

      const searchROR = async (query, country = '') => {
        setRorLoading(true);
        let url = `https://api.ror.org/organizations?query=${encodeURIComponent(query)}`;
        if (country) url += `&filter=country.country_code:${country.substring(0,2).toUpperCase()}`;
        try { const res = await fetch(url); const data = await res.json(); setRorData(data.items || []); }
        catch (e) { console.error(e); }
        finally { setRorLoading(false); }
      };

      const exportCSV = () => {
        const headers = ['Entity_ID','Canonical_Name','Entity_Type','US_FDA_Status','EU_EMA_Status','WADA_Status'];
        const rows = filtered.map(c => [c.Entity_ID, c.Canonical_Name, c.Entity_Type, c.US_FDA_Status, c.EU_EMA_Status, c.WADA_Status]);
        const csv = [headers, ...rows].map(r => r.join(',')).join('\n');
        const blob = new Blob([csv], { type: 'text/csv' });
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = 'regulatory_export.csv';
        a.click();
      };

      const importCSV = (file) => {
        Papa.parse(file, {
          header: true,
          complete: async (results) => {
            await fetch(API_URL, { method: 'POST', body: JSON.stringify(results.data), headers: { 'Content-Type': 'application/json' } });
            const res = await fetch(API_URL);
            const fresh = await res.json();
            setCompounds(fresh);
            alert('Import complete!');
          }
        });
      };

      const toggleSelect = (id) => {
        setSelectedIds(prev => prev.includes(id) ? prev.filter(i => i !== id) : [...prev, id]);
      };

      const selectedCompounds = compounds.filter(c => selectedIds.includes(c.Entity_ID));
      
      // Find relationships for visual cues
      const getRelatedIds = (compoundId) => {
        const related = new Set();
        combinations.forEach(comb => {
          if (comb.Entity_ID_1 === compoundId) related.add(comb.Entity_ID_2);
          if (comb.Entity_ID_2 === compoundId) related.add(comb.Entity_ID_1);
        });
        return Array.from(related);
      };

      if (loading) return <div className="flex justify-center items-center h-screen"><div className="spin text-2xl">⟳</div></div>;

      return (
        <div className="min-h-screen flex flex-col md:flex-row bg-[#080c14]">
          {/* Mobile header */}
          <div className="md:hidden bg-[#0d1526] border-b border-[#1e3a5f] p-4 flex justify-between items-center sticky top-0 z-20">
            <div className="flex items-center gap-2 font-bold text-lg" style={{fontFamily:'Syne'}}><i data-lucide="activity" className="w-5 h-5 text-indigo-400"></i><span>RegIntel</span></div>
            <button onClick={() => setMobileMenuOpen(!mobileMenuOpen)} className="p-2"><i data-lucide={mobileMenuOpen ? "x" : "menu"} className="w-6 h-6"></i></button>
          </div>

          {/* Sidebar */}
          <nav className={`sidebar-mobile ${mobileMenuOpen ? 'open' : ''} md:translate-x-0 fixed md:static top-0 left-0 h-full w-64 bg-[#0d1526] border-r border-[#1e3a5f] text-gray-300 z-30 flex-shrink-0 overflow-y-auto`}>
            <div className="p-6 hidden md:flex items-center text-white font-bold text-xl gap-2" style={{fontFamily:'Syne'}}><i data-lucide="activity" className="w-6 h-6 text-indigo-400"></i><span>RegIntel</span></div>
            <div className="px-4 pb-6 space-y-2">
              {[ { id: 'matrix', label: 'Matrix', icon: 'database' }, { id: 'map', label: 'World Map', icon: 'map' }, { id: 'trials', label: 'Clinical Trials', icon: 'flask-conical' }, { id: 'ror', label: 'Research Orgs', icon: 'building-2' } ].map(tab => (
                <button key={tab.id} onClick={() => { setActiveTab(tab.id); setMobileMenuOpen(false); }} className={`w-full flex items-center px-4 py-3 rounded-lg transition ${activeTab === tab.id ? 'bg-indigo-600 text-white' : 'hover:bg-gray-800 hover:text-white'}`}><i data-lucide={tab.icon} className="w-5 h-5 mr-3"></i> {tab.label}</button>
              ))}
              <div className="pt-4 mt-4 border-t border-[#1e3a5f] space-y-2">
                <button onClick={() => document.getElementById('csvUpload').click()} className="w-full flex items-center px-4 py-2 text-sm rounded-lg hover:bg-gray-800 transition"><i data-lucide="upload" className="w-4 h-4 mr-3"></i> Import CSV</button>
                <button onClick={exportCSV} className="w-full flex items-center px-4 py-2 text-sm rounded-lg hover:bg-gray-800 transition"><i data-lucide="download" className="w-4 h-4 mr-3"></i> Export CSV</button>
                <input type="file" id="csvUpload" accept=".csv" className="hidden" onChange={e => importCSV(e.target.files[0])} />
                <button onClick={() => setCompareMode(!compareMode)} className={`w-full flex items-center px-4 py-2 text-sm rounded-lg transition ${compareMode ? 'bg-indigo-600 text-white' : 'hover:bg-gray-800'}`}>
                  <i data-lucide="git-compare" className="w-4 h-4 mr-3"></i> Compare Mode {compareMode && '(ON)'}
                </button>
                {selectedIds.length > 0 && (
                  <button onClick={() => setSelectedIds([])} className="w-full flex items-center px-4 py-2 text-sm rounded-lg hover:bg-gray-800 transition text-red-400">
                    <i data-lucide="x-circle" className="w-4 h-4 mr-3"></i> Clear ({selectedIds.length})
                  </button>
                )}
              </div>
            </div>
          </nav>

          {/* Main Content */}
          <main className="flex-1 p-4 md:p-6 overflow-y-auto">
            {/* Matrix Tab */}
            {activeTab === 'matrix' && (
              <div>
                <div className="flex flex-wrap gap-4 mb-6">
                  {[ {l:"TOTAL",v:stats.total,c:"#60a5fa"}, {l:"APPROVED (US)",v:stats.approved,c:"#4ade80"}, {l:"WADA PROHIBITED",v:stats.prohibited,c:"#f87171"}, {l:"NO APPROVAL",v:stats.unapproved,c:"#fb923c"}, {l:"INVESTIGATIONAL",v:stats.investigational,c:"#c084fc"} ].map(s => (
                    <div key={s.l} className="bg-[#0f1724] border border-[#1e3a5f] rounded-lg p-3 min-w-[120px]"><div className="text-[9px] text-[#475569] font-mono tracking-wider">{s.l}</div><div className="text-2xl font-bold" style={{fontFamily:'Syne', color:s.c}}>{s.v}</div></div>
                  ))}
                </div>
                <div className="bg-[#0f1724] border border-[#1e3a5f] rounded-xl p-4 mb-6 flex flex-wrap gap-4 items-center">
                  <div className="relative flex-1 min-w-[200px]"><i data-lucide="search" className="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 w-5 h-5"></i><input type="text" placeholder="Search compounds..." value={search} onChange={e => setSearch(e.target.value)} className="w-full pl-10 pr-4 py-2 rounded-lg border border-[#1e3a5f] bg-[#0a0f1a] text-white focus:ring-2 focus:ring-indigo-500 outline-none" /></div>
                  <select value={filterType} onChange={e => setFilterType(e.target.value)} className="px-4 py-2 rounded-lg border border-[#1e3a5f] bg-[#0a0f1a] text-gray-300">{types.map(t => <option key={t} value={t}>{t==='all'?'All Types':t}</option>)}</select>
                  <select value={filterWADA} onChange={e => setFilterWADA(e.target.value)} className="px-4 py-2 rounded-lg border border-[#1e3a5f] bg-[#0a0f1a] text-gray-300">{wadaStatuses.map(s => <option key={s} value={s}>{s==='all'?'All WADA':s}</option>)}</select>
                  <select value={filterUS} onChange={e => setFilterUS(e.target.value)} className="px-4 py-2 rounded-lg border border-[#1e3a5f] bg-[#0a0f1a] text-gray-300">{usStatuses.map(s => <option key={s} value={s}>{s==='all'?'All US':s}</option>)}</select>
                  <div className="ml-auto text-sm text-gray-500">{filtered.length} of {compounds.length}</div>
                  {filtered.length === 0 && search && (
                    <button onClick={handleEnrich} disabled={enriching} className="px-4 py-2 bg-indigo-600 text-white rounded-lg text-sm">
                      {enriching ? <span className="spin inline-block mr-1">⟳</span> : null}
                      Search External Sources
                    </button>
                  )}
                </div>
                
                {/* Comparison view */}
                {compareMode && selectedCompounds.length > 0 && (
                  <div className="mb-6 p-4 bg-[#0f1724] border border-[#1e3a5f] rounded-xl">
                    <h3 className="text-lg font-bold mb-3" style={{fontFamily:'Syne'}}>Comparison ({selectedCompounds.length} selected)</h3>
                    <div className="overflow-x-auto">
                      <table className="w-full text-sm">
                        <thead><tr className="border-b border-[#1e3a5f]">{['Compound','Type','US','EU','WADA','Mechanism','Side Effects'].map(h=><th key={h} className="px-3 py-2 text-left">{h}</th>)}</tr></thead>
                        <tbody>
                          {selectedCompounds.map(c => (
                            <tr key={c.Entity_ID} className="border-b border-[#1e3a5f]">
                              <td className="px-3 py-2">{c.Canonical_Name}</td>
                              <td className="px-3 py-2">{c.Entity_Type}</td>
                              <td className="px-3 py-2"><span style={{color:statusColors[c.US_FDA_Status]}}>{c.US_FDA_Status}</span></td>
                              <td className="px-3 py-2"><span style={{color:statusColors[c.EU_EMA_Status]}}>{c.EU_EMA_Status}</span></td>
                              <td className="px-3 py-2"><span style={{color:wadaColor[c.WADA_Status]}}>{c.WADA_Status}</span></td>
                              <td className="px-3 py-2 max-w-xs truncate">{c.Mechanism_Summary}</td>
                              <td className="px-3 py-2 max-w-xs truncate">{c.Side_Effects}</td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                  </div>
                )}

                <div className="bg-[#0d1526] border border-[#1e3a5f] rounded-xl overflow-x-auto">
                  <table className="w-full text-sm font-mono">
                    <thead className="bg-[#0a0f1a] text-gray-400 border-b border-[#1e3a5f]"><tr><th className="px-6 py-3 text-left sticky left-0 bg-[#0a0f1a]">Compound</th><th className="px-4 py-3 text-left">Type</th><th className="px-4 py-3 text-center">US</th><th className="px-4 py-3 text-center">EU</th><th className="px-4 py-3 text-center">WADA</th><th className="px-4 py-3 text-center">Relations</th></tr></thead>
                    <tbody className="divide-y divide-[#1e3a5f]">
                      {filtered.map(c => {
                        const related = getRelatedIds(c.Entity_ID);
                        return (
                          <tr key={c.Entity_ID} className={`hover:bg-[#1a2a4a] cursor-pointer ${selectedIds.includes(c.Entity_ID) ? 'bg-indigo-900/30' : ''}`} onClick={() => compareMode ? toggleSelect(c.Entity_ID) : setSelectedIds([c.Entity_ID])}>
                            <td className="px-6 py-4 sticky left-0 bg-[#0d1526]"><div className="font-medium text-white">{c.Canonical_Name}</div><div className="text-xs text-gray-500">{c.Entity_ID}</div></td>
                            <td className="px-4 py-4 text-gray-300">{c.Entity_Type || '—'}</td>
                            <td className="px-4 py-4 text-center"><span className="px-2 py-1 rounded-full text-xs font-medium" style={{backgroundColor: statusColors[c.US_FDA_Status]+'33', color: statusColors[c.US_FDA_Status]}}>{c.US_FDA_Status || 'unknown'}</span></td>
                            <td className="px-4 py-4 text-center"><span className="px-2 py-1 rounded-full text-xs font-medium" style={{backgroundColor: statusColors[c.EU_EMA_Status]+'33', color: statusColors[c.EU_EMA_Status]}}>{c.EU_EMA_Status || 'unknown'}</span></td>
                            <td className="px-4 py-4 text-center"><span className="px-2 py-1 rounded-full text-xs font-medium" style={{backgroundColor: wadaColor[c.WADA_Status]+'33', color: wadaColor[c.WADA_Status]}}>{c.WADA_Status || 'unknown'}</span></td>
                            <td className="px-4 py-4 text-center">
                              {related.length > 0 && <Badge color="#a78bfa" small>{related.length} related</Badge>}
                              {compareMode && <input type="checkbox" checked={selectedIds.includes(c.Entity_ID)} readOnly className="ml-2" />}
                            </td>
                          </tr>
                        );
                      })}
                    </tbody>
                  </table>
                </div>
              </div>
            )}

            {/* Map Tab */}
            {activeTab === 'map' && (
              <div className="bg-[#0d1526] border border-[#1e3a5f] rounded-xl p-4">
                <h2 className="text-xl font-bold mb-4" style={{fontFamily:'Syne'}}>Global Regulatory Status</h2>
                <ComposableMap projection="geoMercator" width={800} height={500}>
                  <ZoomableGroup center={[0,20]} zoom={1.2}>
                    <Geographies geography={GEO_URL}>
                      {({ geographies }) => geographies.map(geo => {
                        const status = getCountryStatus(geo, selectedCompounds[0]);
                        return (<Geography key={geo.rsmKey} geography={geo} fill={statusColors[status] || statusColors.unknown} stroke="#FFFFFF" strokeWidth={0.5} style={{ default: { outline: 'none' }, hover: { fill: '#a855f7', cursor: 'pointer' } }} onClick={() => { if (selectedCompounds[0]) searchTrials(selectedCompounds[0].Canonical_Name, geo.properties.NAME); }} />);
                      })}
                    </Geographies>
                  </ZoomableGroup>
                </ComposableMap>
                <div className="flex flex-wrap justify-center gap-4 mt-4">{Object.entries(statusColors).map(([key, color]) => (<div key={key} className="flex items-center gap-1"><span className="w-4 h-4 rounded" style={{backgroundColor: color}}></span><span className="text-xs capitalize">{key.replace('_',' ')}</span></div>))}</div>
                <p className="text-xs text-gray-500 text-center mt-3">Click any country to search clinical trials for the first selected compound.</p>
              </div>
            )}

            {/* Trials & ROR tabs omitted for brevity — include from previous answer */}
          </main>

          {/* Detail Panel for single selection (shown only when one compound selected and not in compare mode) */}
          {selectedCompounds.length === 1 && !compareMode && (
            <div ref={panelRef} className="detail-panel open fixed inset-y-0 right-0 w-full md:w-[600px] bg-[#090e1b] border-l border-[#1e3a5f] shadow-xl z-50 overflow-y-auto">
              <div className="p-6">
                <div className="flex justify-between items-start mb-4">
                  <div>
                    <h2 className="text-2xl font-bold" style={{fontFamily:'Syne'}}>{selectedCompounds[0].Canonical_Name}</h2>
                    <p className="text-sm text-gray-500 mt-1">{selectedCompounds[0].Entity_ID} · {selectedCompounds[0].Entity_Type}</p>
                    <div className="flex gap-2 mt-2 flex-wrap">
                      <RiskChip level={selectedCompounds[0].Evidence_Quality || selectedCompounds[0].Development_Stage_Global} />
                      <Badge color={wadaColor[selectedCompounds[0].WADA_Status]}>WADA {selectedCompounds[0].WADA_Category || selectedCompounds[0].WADA_Status}</Badge>
                      {getRelatedIds(selectedCompounds[0].Entity_ID).length > 0 && (
                        <Badge color="#a78bfa">Has known combinations</Badge>
                      )}
                    </div>
                  </div>
                  <button onClick={() => setSelectedIds([])} className="p-2 hover:bg-gray-700 rounded-lg"><i data-lucide="x" className="w-5 h-5"></i></button>
                </div>
                {/* Show related compounds */}
                {getRelatedIds(selectedCompounds[0].Entity_ID).length > 0 && (
                  <div className="mb-4 p-3 bg-[#0f1724] border border-[#1e3a5f] rounded-lg">
                    <div className="text-xs text-gray-400 mb-2">Related Compounds:</div>
                    <div className="flex flex-wrap gap-2">
                      {getRelatedIds(selectedCompounds[0].Entity_ID).map(rid => {
                        const rel = compounds.find(c => c.Entity_ID === rid);
                        return rel ? <Badge key={rid} color="#a78bfa">{rel.Canonical_Name}</Badge> : null;
                      })}
                    </div>
                  </div>
                )}
                {selectedCompounds[0].Synonyms && <div className="mb-4 p-3 bg-[#0f1724] border border-[#1e3a5f] rounded-lg text-sm text-gray-400 font-mono">{selectedCompounds[0].Synonyms}</div>}
                <SectionBlock title="Intended Use" accent="#22c55e">{selectedCompounds[0].Intended_Use || selectedCompounds[0].Mechanism_Summary}</SectionBlock>
                <SectionBlock title="Mechanism" accent="#3b82f6">{selectedCompounds[0].Mechanism_Summary}</SectionBlock>
                <SectionBlock title="Discovered Functions" accent="#a78bfa">{selectedCompounds[0].Discovered_Functions || '—'}</SectionBlock>
                <SectionBlock title="Side Effects" accent="#f59e0b">{selectedCompounds[0].Side_Effects || '—'}</SectionBlock>
                <SectionBlock title="Safety Concerns" accent="#ef4444">{selectedCompounds[0].Safety_Concerns || selectedCompounds[0].Key_Regulatory_Risks}</SectionBlock>
                <SectionBlock title="Restriction Reasoning" accent="#f97316">{selectedCompounds[0].Restriction_Reasoning || '—'}</SectionBlock>
                <div className="mb-6">
                  <div className="text-gray-400 text-xs font-mono font-semibold uppercase tracking-wider border-b border-[#1e3a5f] pb-1 mb-3">Jurisdiction Status</div>
                  <div className="grid grid-cols-2 md:grid-cols-3 gap-2">
                    {JURISDICTIONS.map(j => {
                      const status = selectedCompounds[0][`${j}_FDA_Status`] || selectedCompounds[0][`${j}_EMA_Status`] || selectedCompounds[0][`${j}_Status`] || 'unknown';
                      const access = selectedCompounds[0][`${j}_Legal_Access`] || 'unknown';
                      return <JurisCell key={j} status={status} access={access} />;
                    })}
                  </div>
                </div>
                <div className="mb-6 p-4 bg-red-950/20 border border-red-800 rounded-lg">
                  <h3 className="text-sm font-semibold text-red-400 mb-2">WADA Anti-Doping</h3>
                  <div className="grid grid-cols-2 gap-2 text-sm">
                    <div><span className="text-gray-400">Status:</span> <span className="font-medium" style={{color:wadaColor[selectedCompounds[0].WADA_Status]}}>{selectedCompounds[0].WADA_Status}</span></div>
                    <div><span className="text-gray-400">Category:</span> {selectedCompounds[0].WADA_Category || '—'}</div>
                    <div><span className="text-gray-400">In-Competition:</span> {selectedCompounds[0].WADA_In_Competition === 'TRUE' ? 'Prohibited' : 'Permitted'}</div>
                    <div><span className="text-gray-400">Out-of-Competition:</span> {selectedCompounds[0].WADA_Out_Competition === 'TRUE' ? 'Prohibited' : 'Permitted'}</div>
                  </div>
                </div>
                <div className="text-xs text-gray-500">Last verified: {selectedCompounds[0].Last_Verified || 'unknown'}</div>
              </div>
            </div>
          )}
        </div>
      );
    }

    ReactDOM.createRoot(document.getElementById('root')).render(<App />);
    setTimeout(() => lucide.createIcons(), 100);
  </script>
</body>
</html>
