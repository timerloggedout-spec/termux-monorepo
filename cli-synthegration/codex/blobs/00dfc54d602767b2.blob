import React, { useRef, useState } from 'react';
import { Upload, Download, RefreshCw } from 'lucide-react';
import Papa from 'papaparse';
import { batchUpdateCompounds, fetchCompounds } from '../services/api';
import { useAppContext } from '../context/AppContext';

export default function CSVImportExport() {
  const fileInputRef = useRef(null);
  const [importing, setImporting] = useState(false);
  const [message, setMessage] = useState(null);
  const { dispatch } = useAppContext();

  const handleExport = () => {
    // Trigger export via the main export function - this will be implemented
    // but we need to access current compounds from context. For simplicity,
    // we'll dispatch an event that the parent can handle, or we can store
    // the export function in context. Here we'll just alert.
    alert('Export functionality is available in the Matrix View tab.');
  };

  const handleImport = async (event) => {
    const file = event.target.files[0];
    if (!file) return;

    setImporting(true);
    setMessage(null);

    Papa.parse(file, {
      header: true,
      skipEmptyLines: true,
      complete: async (results) => {
        try {
          const compounds = results.data.map(row => {
            // Normalize field names to match Google Sheets schema
            const normalized = {};
            Object.keys(row).forEach(key => {
              // Keep original column names as they appear in the sheet
              normalized[key] = row[key];
            });
            return normalized;
          });

          if (compounds.length === 0) {
            throw new Error('No valid data found in CSV');
          }

          const result = await batchUpdateCompounds(compounds);
          setMessage({ type: 'success', text: `Imported ${result.count} compounds successfully. Refreshing...` });
          
          // Refresh data
          const freshData = await fetchCompounds();
          dispatch({ type: 'SET_COMPOUNDS', payload: freshData });
          
          // Clear file input
          if (fileInputRef.current) fileInputRef.current.value = '';
        } catch (err) {
          setMessage({ type: 'error', text: `Import failed: ${err.message}` });
        } finally {
          setImporting(false);
        }
      },
      error: (err) => {
        setMessage({ type: 'error', text: `CSV parsing error: ${err.message}` });
        setImporting(false);
      },
    });
  };

  return (
    <div className="space-y-3">
      <div className="text-xs font-semibold text-gray-400 uppercase tracking-wider px-2">
        Data Management
      </div>
      <button
        onClick={() => fileInputRef.current?.click()}
        disabled={importing}
        className="w-full flex items-center px-4 py-2 text-sm rounded-lg text-gray-300 hover:bg-gray-800 hover:text-white transition-colors"
      >
        <Upload className="w-4 h-4 mr-3" />
        {importing ? 'Importing...' : 'Import CSV'}
      </button>
      <input
        ref={fileInputRef}
        type="file"
        accept=".csv"
        onChange={handleImport}
        className="hidden"
      />
      {message && (
        <div className={`text-xs px-2 py-1 rounded ${message.type === 'success' ? 'text-green-400' : 'text-red-400'}`}>
          {message.text}
        </div>
      )}
    </div>
  );
}
