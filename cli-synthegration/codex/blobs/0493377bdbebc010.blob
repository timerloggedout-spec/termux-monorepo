<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>🎰 QuanTM FOAM v10.0 - DEX Arbitrage Casino</title>
    <style>
        :root {
            --neon-pink: #ff00ff;
            --neon-cyan: #00f0ff;
            --neon-green: #00ffaa;
            --bg: #0a0a1a;
            --card-bg: #1a1a2a;
            --border: #2a2a3a;
            --gold: #ffd700;
        }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            background: #0a0a1a;
            color: #a0a0ff;
            font-family: 'Courier New', monospace;
            font-size: 11px;
            overflow-x: hidden;
            position: relative;
        }
        canvas#particleCanvas {
            position: fixed; top:0; left:0; width:100%; height:100%; pointer-events: none; z-index: 9999;
        }
        .container { max-width: 1400px; margin: 0 auto; padding: 10px; position: relative; z-index:1; }
        h1 {
            color: var(--gold);
            font-size: 18px;
            text-shadow: 0 0 10px var(--neon-pink), 0 0 20px var(--neon-cyan);
            margin-bottom: 5px;
            letter-spacing: 2px;
            animation: flicker 2s infinite;
        }
        @keyframes flicker {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.8; text-shadow: 0 0 20px var(--neon-pink), 0 0 40px var(--neon-cyan); }
        }
        .status-bar {
            padding: 8px 12px;
            margin: 8px 0;
            background: linear-gradient(145deg, #0a0a1a, #1a1a2a);
            border-radius: 8px;
            border-left: 4px solid var(--neon-cyan);
            font-weight: bold;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 0 15px rgba(0,240,255,0.3);
        }
        .controls {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin: 10px 0;
        }
        button, .neon-btn {
            background: #111;
            border: 2px solid var(--neon-pink);
            color: var(--neon-pink);
            padding: 8px 14px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: bold;
            cursor: pointer;
            font-family: 'Courier New', monospace;
            transition: all 0.2s;
            text-transform: uppercase;
            letter-spacing: 1px;
            box-shadow: 0 0 8px var(--neon-pink);
            position: relative;
            overflow: hidden;
        }
        button:hover, .neon-btn:hover {
            background: var(--neon-pink);
            color: #000;
            box-shadow: 0 0 20px var(--neon-pink);
        }
        button:active { transform: scale(0.95); }
        button.cyan {
            border-color: var(--neon-cyan);
            color: var(--neon-cyan);
            box-shadow: 0 0 8px var(--neon-cyan);
        }
        button.cyan:hover { background: var(--neon-cyan); color: #000; }
        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 12px;
            margin: 12px 0;
        }
        .card {
            background: var(--card-bg);
            border-radius: 10px;
            padding: 12px;
            border: 1px solid var(--border);
            box-shadow: 0 0 15px rgba(255,0,255,0.2);
            transition: all 0.3s;
            position: relative;
        }
        .card:hover {
            border-color: var(--neon-pink);
            box-shadow: 0 0 25px rgba(255,0,255,0.5);
        }
        .card h3 {
            color: var(--neon-cyan);
            font-size: 13px;
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            gap: 5px;
        }
        .exchange-status {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 6px;
            background: #0a0a1a;
            border-radius: 6px;
            margin: 4px 0;
            font-size: 10px;
            border: 1px solid #2a2a3a;
        }
        .indicator {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: #ff4444;
            box-shadow: 0 0 8px #ff4444;
        }
        .indicator.online {
            background: var(--neon-green);
            box-shadow: 0 0 12px var(--neon-green);
            animation: pulse 1.5s infinite;
        }
        @keyframes pulse { 0%,100%{opacity:1;box-shadow:0 0 8px var(--neon-green);} 50%{opacity:0.5;box-shadow:0 0 20px var(--neon-green);} }
        .stat { display: flex; justify-content: space-between; padding: 4px 0; font-size: 11px; }
        .stat-value { color: var(--gold); font-weight: bold; }
        .rolling-number {
            font-family: 'Courier New', monospace;
            font-size: 16px;
            color: var(--gold);
            font-weight: bold;
            transition: all 0.2s;
        }
        .opp-section {
            margin: 12px 0;
            padding: 8px;
            background: #0f0f1f;
            border-radius: 8px;
            border: 1px solid #2a2a3a;
        }
        .opp-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 8px;
            background: #1a1a2a;
            border-radius: 6px;
            cursor: pointer;
            font-weight: bold;
            color: var(--neon-pink);
        }
        .opp-list { max-height: 400px; overflow-y: auto; }
        .opportunity {
            background: #111;
            padding: 10px;
            margin: 5px 0;
            border-radius: 8px;
            border-left: 4px solid var(--neon-green);
            transition: all 0.2s;
            cursor: pointer;
        }
        .opportunity:hover {
            border-left-color: var(--neon-pink);
            background: #1a1a2a;
            box-shadow: 0 0 15px rgba(255,0,255,0.4);
        }
        .opportunity.mega {
            border-left-color: var(--gold);
            animation: goldenPulse 1s infinite alternate;
        }
        @keyframes goldenPulse {
            from { box-shadow: 0 0 5px var(--gold); }
            to { box-shadow: 0 0 20px var(--gold); }
        }
        .path-visual { font-size: 9px; color: var(--neon-cyan); margin: 4px 0; }
        .depth-info { font-size: 8px; color: #ffaa00; }
        .log-container { background: #000; padding: 8px; border-radius: 5px; max-height: 200px; overflow-y: auto; font-size: 9px; }
        .log-entry { padding: 2px 0; border-bottom: 1px solid #222; }
        .error { color: #ff4444; } .success { color: #00ff00; } .warning { color: #ffaa00; } .info { color: #00f0ff; }
        .bet-slider { width: 100%; margin: 8px 0; appearance: none; height: 6px; border-radius: 3px; background: #333; outline: none; }
        .bet-slider::-webkit-slider-thumb { appearance: none; width: 20px; height: 20px; background: var(--neon-pink); border-radius: 50%; box-shadow: 0 0 10px var(--neon-pink); }
        .modal { display: none; position: fixed; top:0; left:0; width:100%; height:100%; background: rgba(0,0,0,0.8); z-index:10000; align-items: center; justify-content: center; }
        .modal-content { background: #1a1a2a; border: 2px solid var(--neon-pink); border-radius: 15px; padding: 20px; max-width: 500px; width: 90%; color: white; }
        .flex-row { display: flex; gap: 8px; align-items: center; }
        .chip { background: var(--neon-pink); color: #000; padding: 2px 8px; border-radius: 10px; font-size: 10px; font-weight: bold; }
        @media (max-width:768px) {
            .grid { grid-template-columns: 1fr; }
            .controls { justify-content: center; }
        }
    </style>
</head>
<body>
    <canvas id="particleCanvas"></canvas>
    <div class="container">
        <h1>🎰 QUANTM FOAM <span style="font-size:12px;">ARBITRAGE CASINO</span></h1>
        <div class="status-bar" id="mainStatus">🟡 READY TO SPIN</div>
        
        <div class="controls">
            <button class="neon-btn cyan" onclick="initSystem()">🔄 INITIALIZE</button>
            <button id="scanBtn" class="neon-btn" onclick="runFullScan()" disabled>🎲 FULL SCAN</button>
            <button class="neon-btn" onclick="scanMicroCaps()">💎 MICRO CAPS</button>
            <button class="neon-btn cyan" onclick="connectWebSockets()">📡 LIVE STREAM</button>
            <button class="neon-btn" onclick="toggleLogs()">📋 LOGS</button>
            <button class="neon-btn" onclick="toggleTheme()">🎨 THEME</button>
            <button class="neon-btn cyan" onclick="shareJackpot()">📤 SHARE</button>
        </div>

        <div class="flex-row" style="margin:10px 0; background:#1a1a2a; padding:10px; border-radius:10px;">
            <span style="color:var(--gold);">💰 BANKROLL:</span>
            <span class="rolling-number" id="bankroll">$10,000.00</span>
            <span style="margin-left:auto; color:var(--neon-cyan);">📈 TODAY'S P/L:</span>
            <span id="pnl" style="color:var(--neon-green);">$0.00 (0.00%)</span>
        </div>

        <h2>⚡ LIVE EXCHANGES</h2>
        <div class="grid" id="exchangeStatus"></div>

        <div class="grid">
            <div class="card">
                <h3>🔥 ULTRA LOW (&lt;$0.0001)</h3>
                <div id="ultraLowValue" style="max-height:200px; overflow-y:auto;"></div>
            </div>
            <div class="card">
                <h3>💧 MICRO CAP (&lt;$0.001)</h3>
                <div id="microCap" style="max-height:200px; overflow-y:auto;"></div>
            </div>
            <div class="card">
                <h3>📊 STATISTICS</h3>
                <div class="stat"><span>Pairs:</span><span class="stat-value" id="totalPairs">0</span></div>
                <div class="stat"><span>Nodes:</span><span class="stat-value" id="graphNodes">0</span></div>
                <div class="stat"><span>Edges:</span><span class="stat-value" id="graphEdges">0</span></div>
                <div class="stat"><span>Triangles:</span><span class="stat-value" id="triangleCount">0</span></div>
                <div class="stat"><span>API Calls:</span><span class="stat-value" id="apiCalls">0</span></div>
                <div class="stat"><span>WS Bytes:</span><span class="stat-value" id="wsBytes">0 KB</span></div>
                <div class="stat"><span>Opps:</span><span class="stat-value rolling-number" id="oppCount">0</span></div>
            </div>
        </div>

        <div class="flex-row" style="margin:10px 0;">
            <label style="color:var(--neon-cyan);">🎚️ BET SIZE:</label>
            <input type="range" class="bet-slider" id="betSlider" min="100" max="10000" value="1000" step="100" oninput="updateBetDisplay()">
            <span id="betDisplay" style="color:var(--gold);">$1,000</span>
        </div>

        <h2>🎯 ARBITRAGE OPPORTUNITIES</h2>
        <div class="opp-section">
            <div class="opp-header" onclick="toggleSection('megaOpps')">🌟 MEGA JACKPOTS (&gt;5%) <span id="megaCount">0</span></div>
            <div id="megaOpps" class="opp-list"></div>
        </div>
        <div class="opp-section"><div class="opp-header" onclick="toggleSection('triangularOpps')">📐 TRIANGULAR <span id="triangularCount">0</span></div><div id="triangularOpps" class="opp-list"></div></div>
        <div class="opp-section"><div class="opp-header" onclick="toggleSection('bellmanOpps')">🔍 BELLMAN-FORD <span id="bellmanCount">0</span></div><div id="bellmanOpps" class="opp-list"></div></div>
        <div class="opp-section"><div class="opp-header" onclick="toggleSection('microOpps')">💎 MICRO OPPORTUNITIES <span id="microCount">0</span></div><div id="microOpps" class="opp-list"></div></div>

        <h2 style="cursor:pointer;" onclick="toggleLogs()">📜 SYSTEM LOGS</h2>
        <div class="log-container" id="logs" style="display:none;"></div>
    </div>

    <!-- Trade Execution Modal -->
    <div id="tradeModal" class="modal">
        <div class="modal-content">
            <h3 style="color:var(--gold);">🎰 EXECUTE ARBITRAGE</h3>
            <div id="tradeDetails"></div>
            <div style="margin-top:15px; display:flex; gap:10px; justify-content:flex-end;">
                <button class="neon-btn" onclick="closeModal()">CANCEL</button>
                <button class="neon-btn cyan" id="executeTradeBtn">💸 PULL LEVER</button>
            </div>
        </div>
    </div>

    <script>
        // ==================== SOUND ENGINE (Web Audio API) ====================
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        function playTone(freq, duration, type='square', vol=0.1) {
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.type = type;
            osc.frequency.value = freq;
            gain.gain.setValueAtTime(vol, audioCtx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + duration);
            osc.connect(gain); gain.connect(audioCtx.destination);
            osc.start(); osc.stop(audioCtx.currentTime + duration);
        }
        function playSpinSound() { playTone(800, 0.1, 'sawtooth', 0.05); }
        function playWinSound() {
            playTone(523, 0.15, 'square', 0.1);
            setTimeout(()=>playTone(659, 0.15, 'square', 0.1), 150);
            setTimeout(()=>playTone(784, 0.25, 'square', 0.1), 300);
        }
        function playJackpotSound() {
            const notes = [523, 659, 784, 1047];
            notes.forEach((freq, i) => setTimeout(() => playTone(freq, 0.3, 'square', 0.15), i * 150));
        }

        // ==================== PARTICLE SYSTEM ====================
        const canvas = document.getElementById('particleCanvas');
        const ctx = canvas.getContext('2d');
        let particles = [];
        function resizeCanvas() { canvas.width = window.innerWidth; canvas.height = window.innerHeight; }
        window.addEventListener('resize', resizeCanvas); resizeCanvas();
        function Particle(x,y,vx,vy,color,life) {
            this.x=x; this.y=y; this.vx=vx; this.vy=vy; this.color=color; this.life=life;
        }
        function animateParticles() {
            ctx.clearRect(0,0,canvas.width,canvas.height);
            for(let i=particles.length-1;i>=0;i--) {
                const p = particles[i];
                p.x += p.vx; p.y += p.vy;
                p.vy += 0.1; p.life -= 0.02;
                ctx.fillStyle = p.color;
                ctx.globalAlpha = p.life;
                ctx.fillRect(p.x,p.y,4,4);
                if(p.life<=0) particles.splice(i,1);
            }
            requestAnimationFrame(animateParticles);
        }
        animateParticles();
        function spawnConfetti(x,y,count=30) {
            const colors = ['#ff00ff','#00f0ff','#ffd700','#00ffaa'];
            for(let i=0;i<count;i++) {
                particles.push(new Particle(x,y,(Math.random()-0.5)*8,(Math.random()-0.5)*8-3,
                    colors[Math.floor(Math.random()*colors.length)],0.8+Math.random()*0.4));
            }
        }

        // ==================== STATE ====================
        const state = {
            exchanges: {
                okx: { name: 'OKX', status: 'offline', pairs:[], ws:null, bytesReceived:0 },
                coinbase: { name:'Coinbase', status:'offline', pairs:[], bytesReceived:0 },
                uniswap: { name:'Uniswap V3', status:'offline', pairs:[], bytesReceived:0 },
                pumpfun: { name:'Pump.fun', status:'offline', pairs:[], bytesReceived:0 }
            },
            opportunities: { mega:[], triangular:[], bellman:[], micro:[] },
            stats: { totalPairs:0, graphNodes:0, graphEdges:0, triangleCount:0, apiCalls:0, wsBytes:0, oppCount:0 },
            systemReady: false,
            graph: {},
            triangles: [],
            allPairs: [],
            bankroll: 10000,
            pnl: 0,
            trades: []
        };

        function log(msg, type) {
            const t = new Date().toLocaleTimeString();
            const el = document.getElementById('logs');
            el.innerHTML = `<div class="log-entry ${type||'info'}">[${t}] ${msg}</div>` + el.innerHTML;
            console.log(`[${t}] ${msg}`);
        }
        function updateStatus(msg) { document.getElementById('mainStatus').innerHTML = msg; }
        function updateStats() {
            document.getElementById('totalPairs').textContent = state.stats.totalPairs;
            document.getElementById('graphNodes').textContent = state.stats.graphNodes;
            document.getElementById('graphEdges').textContent = state.stats.graphEdges;
            document.getElementById('triangleCount').textContent = state.stats.triangleCount;
            document.getElementById('apiCalls').textContent = state.stats.apiCalls;
            document.getElementById('wsBytes').textContent = (state.stats.wsBytes/1024).toFixed(2)+' KB';
            document.getElementById('oppCount').textContent = state.stats.oppCount;
            document.getElementById('megaCount').textContent = state.opportunities.mega.length;
            document.getElementById('triangularCount').textContent = state.opportunities.triangular.length;
            document.getElementById('bellmanCount').textContent = state.opportunities.bellman.length;
            document.getElementById('microCount').textContent = state.opportunities.micro.length;
            document.getElementById('bankroll').textContent = '$'+state.bankroll.toFixed(2);
            const pnlPercent = state.bankroll>0 ? ((state.bankroll-10000)/10000*100).toFixed(2) : 0;
            document.getElementById('pnl').innerHTML = `$${(state.bankroll-10000).toFixed(2)} (${pnlPercent}%)`;
            document.getElementById('pnl').style.color = (state.bankroll>=10000) ? '#00ff00' : '#ff4444';
        }
        function toggleLogs() { document.getElementById('logs').style.display = document.getElementById('logs').style.display==='none'?'block':'none'; }
        function toggleSection(id) { document.getElementById(id).style.display = document.getElementById(id).style.display==='none'?'block':'none'; }
        function updateExchangeDisplay() {
            const container = document.getElementById('exchangeStatus');
            container.innerHTML = '';
            Object.keys(state.exchanges).forEach(key => {
                const ex = state.exchanges[key];
                container.innerHTML += `<div class="exchange-status">
                    <div class="indicator ${ex.status==='online'?'online':''}"></div>
                    <div><strong>${ex.name}</strong><br><small>${ex.status.toUpperCase()} · ${ex.pairs.length} pairs</small></div></div>`;
            });
        }
        function updateBetDisplay() {
            document.getElementById('betDisplay').textContent = '$'+Number(document.getElementById('betSlider').value).toLocaleString();
        }

        // ==================== API FETCHING ====================
        async function loadOKX() {
            try {
                log('Fetching OKX...','info');
                const response = await fetch('https://www.okx.com/api/v5/market/tickers?instType=SPOT');
                if(!response.ok) throw new Error('HTTP '+response.status);
                const data = await response.json(); state.stats.apiCalls++;
                state.exchanges.okx.pairs = data.data.slice(0,500).map(t => {
                    const parts = t.instId.split('-'); if(parts.length!==2) return null;
                    const price = parseFloat(t.last)||0;
                    const vol = parseFloat(t.volCcy24h)*price||0;
                    return { base:parts[0], target:parts[1], price, volume:vol, liquidity:vol, bidPrice:parseFloat(t.bidPx)||price*0.999, askPrice:parseFloat(t.askPx)||price*1.001, spread:0, exchange:'okx' };
                }).filter(p=>p&&p.price>0);
                state.exchanges.okx.status='online';
                log('OKX: '+state.exchanges.okx.pairs.length+' pairs','success');
                return true;
            } catch(e) { state.exchanges.okx.status='offline'; log('OKX failed: '+e.message,'error'); return false; }
        }
        async function loadCoinbase() {
            try {
                log('Fetching Coinbase...','info');
                const resp = await fetch('https://api.exchange.coinbase.com/products');
                if(!resp.ok) throw new Error('HTTP '+resp.status);
                const data = await resp.json(); state.stats.apiCalls++;
                state.exchanges.coinbase.pairs = data.slice(0,300).map(p => ({
                    base:p.base_currency, target:p.quote_currency, price:p.price||1, volume:p.volume*p.price||0,
                    liquidity:p.volume*p.price||0, bidPrice:p.price*0.998, askPrice:p.price*1.002, spread:0.004, exchange:'coinbase'
                })).filter(p=>p.price>0);
                state.exchanges.coinbase.status='online';
                log('Coinbase: '+state.exchanges.coinbase.pairs.length+' pairs','success');
                return true;
            } catch(e) { state.exchanges.coinbase.status='offline'; log('Coinbase failed: '+e.message,'error'); return false; }
        }
        async function loadUniswap() {
            try {
                log('Fetching Uniswap (DexScreener)...','info');
                const resp = await fetch('https://api.dexscreener.com/latest/dex/pairs/ethereum');
                if(!resp.ok) throw new Error('HTTP '+resp.status);
                const data = await resp.json(); state.stats.apiCalls++;
                state.exchanges.uniswap.pairs = (data.pairs||[]).slice(0,300).map(p => {
                    const price = parseFloat(p.priceUsd)||0;
                    const liq = p.liquidity?.usd||0;
                    const spread = liq>0?Math.max(0.003,Math.min(0.03,5000/liq)):0.03;
                    return { base:p.baseToken?.symbol||'UNKNOWN', target:p.quoteToken?.symbol||'ETH', price, volume:p.volume?.h24||0, liquidity:liq, bidPrice:price*(1-spread/2), askPrice:price*(1+spread/2), spread, exchange:'uniswap' };
                }).filter(p=>p.base!=='UNKNOWN'&&p.price>0);
                state.exchanges.uniswap.status='online';
                log('Uniswap: '+state.exchanges.uniswap.pairs.length+' pairs','success');
                return true;
            } catch(e) { state.exchanges.uniswap.status='offline'; log('Uniswap failed: '+e.message,'error'); return false; }
        }
        async function loadPumpFun() {
            try {
                log('Fetching Pump.fun...','info');
                const resp = await fetch('https://frontend-api.pump.fun/coins?offset=0&limit=100&sort=created_timestamp&order=DESC');
                if(!resp.ok) throw new Error('HTTP '+resp.status);
                const data = await resp.json(); state.stats.apiCalls++;
                state.exchanges.pumpfun.pairs = data.map(t => {
                    const price = parseFloat(t.usd_market_cap)/parseFloat(t.total_supply)||0;
                    const liq = parseFloat(t.usd_market_cap)*0.1||0;
                    return { base:t.symbol||'UNKNOWN', target:'SOL', price, volume:liq*0.5, liquidity:liq, bidPrice:price*0.95, askPrice:price*1.05, spread:0.10, exchange:'pumpfun' };
                }).filter(p=>p.base!=='UNKNOWN'&&p.price>0);
                state.exchanges.pumpfun.status='online';
                log('Pump.fun: '+state.exchanges.pumpfun.pairs.length+' tokens','success');
                return true;
            } catch(e) { state.exchanges.pumpfun.status='offline'; log('Pump.fun failed: '+e.message,'error'); return false; }
        }

        async function initSystem() {
            log('🎰 INITIALIZING CASINO...','info');
            updateStatus('🔄 LOADING...');
            await Promise.allSettled([loadOKX(), loadCoinbase(), loadUniswap(), loadPumpFun()]);
            state.allPairs = [];
            Object.values(state.exchanges).forEach(ex => state.allPairs.push(...ex.pairs));
            state.stats.totalPairs = state.allPairs.length;
            buildGraph(); buildTriangles(); displayLowValue();
            updateExchangeDisplay(); updateStats();
            const online = Object.values(state.exchanges).filter(e=>e.status==='online').length;
            if(online>0) {
                state.systemReady=true; document.getElementById('scanBtn').disabled=false;
                updateStatus('✅ READY - '+online+'/4 online');
                log('🎰 SYSTEM READY','success');
                playSpinSound();
            } else { updateStatus('❌ NO EXCHANGES'); log('INIT FAILED','error'); }
        }

        function buildGraph() {
            state.graph = {}; let edges=0;
            const minLiq = 100;
            state.allPairs.forEach(p => {
                if(p.liquidity<minLiq) return;
                if(!state.graph[p.base]) state.graph[p.base]={};
                if(!state.graph[p.target]) state.graph[p.target]={};
                state.graph[p.base][p.target] = { rate:1/p.askPrice, weight:-Math.log(1/p.askPrice), volume:p.volume, liquidity:p.liquidity, spread:p.spread, exchange:p.exchange };
                edges++;
                state.graph[p.target][p.base] = { rate:p.bidPrice, weight:-Math.log(p.bidPrice), volume:p.volume, liquidity:p.liquidity, spread:p.spread, exchange:p.exchange };
                edges++;
            });
            state.stats.graphNodes=Object.keys(state.graph).length;
            state.stats.graphEdges=edges;
        }
        function buildTriangles() {
            state.triangles = [];
            const nodes = Object.keys(state.graph);
            for(let i=0;i<Math.min(nodes.length,100);i++) {
                const A=nodes[i]; const neighborsA = Object.keys(state.graph[A]||{});
                for(const B of neighborsA) {
                    const neighborsB = Object.keys(state.graph[B]||{});
                    for(const C of neighborsB) {
                        if(state.graph[C]&&state.graph[C][A]) state.triangles.push([A,B,C]);
                    }
                }
            }
            state.stats.triangleCount=state.triangles.length;
        }
        function displayLowValue() {
            const ultra = state.allPairs.filter(p=>p.price<0.0001&&p.price>0&&p.liquidity>=10).sort((a,b)=>a.price-b.price).slice(0,20);
            const micro = state.allPairs.filter(p=>p.price<0.001&&p.price>=0.0001&&p.liquidity>=10).sort((a,b)=>a.price-b.price).slice(0,20);
            document.getElementById('ultraLowValue').innerHTML = ultra.length?ultra.map(c=>`<div class="coin-item" style="display:flex;justify-content:space-between;padding:2px 0;"><span>${c.base} (${c.exchange})</span><span>$${c.price.toFixed(10)}</span></div>`).join(''):'None';
            document.getElementById('microCap').innerHTML = micro.length?micro.map(c=>`<div class="coin-item" style="display:flex;justify-content:space-between;padding:2px 0;"><span>${c.base} (${c.exchange})</span><span>$${c.price.toFixed(8)}</span></div>`).join(''):'None';
        }

        // ==================== ARBITRAGE ALGORITHMS ====================
        function calculateMaxTradeSize(edges) {
            let minLiq = Infinity;
            edges.forEach(e => { if(e.liquidity<minLiq) minLiq=e.liquidity; });
            return minLiq*0.05;
        }
        function scanTriangular(minProfit=0.0001) {
            const opps = [];
            const baseInv = 1000;
            state.triangles.forEach(([A,B,C]) => {
                const e1=state.graph[A]?.[B], e2=state.graph[B]?.[C], e3=state.graph[C]?.[A];
                if(!e1||!e2||!e3) return;
                const final = baseInv*e1.rate*e2.rate*e3.rate;
                const profit = final-baseInv, pct = (profit/baseInv)*100;
                if(pct>=minProfit) {
                    const maxSize = calculateMaxTradeSize([e1,e2,e3]);
                    opps.push({type:'triangular', path:[A,B,C,A], profitPercent:pct, profit, actualProfit:(maxSize/baseInv)*profit, maxTradeSize:maxSize, totalLiquidity:Math.min(e1.liquidity,e2.liquidity,e3.liquidity), edges:[e1,e2,e3] });
                }
            });
            return opps;
        }
        function bellmanFord(startCurr, maxPath=5) {
            const currencies = Object.keys(state.graph);
            if(!currencies.includes(startCurr)) return [];
            const dist={}, pred={};
            currencies.forEach(c=>{ dist[c]=Infinity; pred[c]=null; });
            dist[startCurr]=0;
            for(let i=0;i<Math.min(maxPath-1,currencies.length-1);i++) {
                let updated=false;
                for(const u of currencies) {
                    const neighbors=state.graph[u]; if(!neighbors) continue;
                    for(const v in neighbors) {
                        const w = neighbors[v].weight;
                        if(dist[u]!==Infinity && dist[u]+w<dist[v]) {
                            dist[v]=dist[u]+w; pred[v]=u; updated=true;
                        }
                    }
                }
                if(!updated) break;
            }
            const opps=[];
            for(const u of currencies) {
                const neighbors=state.graph[u]; if(!neighbors) continue;
                for(const v in neighbors) {
                    if(dist[u]!==Infinity && dist[u]+neighbors[v].weight<dist[v]) {
                        const cycle = reconstructCycle(v,pred,maxPath);
                        if(cycle&&cycle.length>=3&&cycle[0]===startCurr) {
                            const opp = calculateCycleOpp(cycle);
                            if(opp) opps.push(opp);
                        }
                    }
                }
            }
            return opps;
        }
        function reconstructCycle(start,pred,maxLen) {
            const cycle=[start]; let curr=pred[start]; const visited=new Set([start]);
            while(curr&&!visited.has(curr)&&cycle.length<maxLen) { cycle.unshift(curr); visited.add(curr); curr=pred[curr]; }
            return cycle.length>=3?cycle:null;
        }
        function calculateCycleOpp(cycle) {
            let amount=1000; const edges=[]; let totalLiq=Infinity;
            for(let i=0;i<cycle.length-1;i++) {
                const edge=state.graph[cycle[i]]?.[cycle[i+1]]; if(!edge) return null;
                amount*=edge.rate; edges.push(edge); totalLiq=Math.min(totalLiq,edge.liquidity);
            }
            const lastEdge=state.graph[cycle[cycle.length-1]]?.[cycle[0]]; if(!lastEdge) return null;
            amount*=lastEdge.rate; edges.push(lastEdge); totalLiq=Math.min(totalLiq,lastEdge.liquidity);
            const profit=amount-1000, pct=(profit/1000)*100;
            if(pct>=0.0001&&totalLiq>=100) {
                const maxSize=calculateMaxTradeSize(edges);
                return {type:'bellman-ford', path:cycle, profitPercent:pct, profit, actualProfit:(maxSize/1000)*profit, maxTradeSize:maxSize, totalLiquidity:totalLiq, edges };
            }
            return null;
        }
        async function runFullScan() {
            if(!state.systemReady) return log('System not ready','error');
            log('🎲 SPINNING THE WHEEL...','info');
            updateStatus('🎰 SCANNING...');
            playSpinSound();
            state.opportunities={mega:[],triangular:[],bellman:[],micro:[]};
            const minProfit=parseFloat(document.getElementById('minProfit')?.value||0.0001);
            const maxPath=parseInt(document.getElementById('maxPath')?.value||5);
            const triOpps=scanTriangular(minProfit);
            const bfOpps=[];
            const topCur = {};
            state.allPairs.forEach(p=>{ if(!topCur[p.base]) topCur[p.base]=0; topCur[p.base]+=p.volume; });
            const sortedCur = Object.keys(topCur).sort((a,b)=>topCur[b]-topCur[a]).slice(0,30);
            for(const c of sortedCur) bfOpps.push(...bellmanFord(c,maxPath));
            const seen=new Set();
            triOpps.forEach(o=>{ const key=o.path.slice().sort().join('-'); if(!seen.has(key)){ seen.add(key); o.profitPercent>5?state.opportunities.mega.push(o):state.opportunities.triangular.push(o); } });
            bfOpps.forEach(o=>{ const key=o.path.slice().sort().join('-'); if(!seen.has(key)){ seen.add(key); o.profitPercent>5?state.opportunities.mega.push(o):state.opportunities.bellman.push(o); } });
            state.stats.oppCount = Object.values(state.opportunities).flat().length;
            updateStats(); displayAllOpps();
            updateStatus('✅ COMPLETE - '+state.stats.oppCount+' OPPORTUNITIES');
            if(state.opportunities.mega.length>0) { spawnConfetti(window.innerWidth/2,100,50); playJackpotSound(); }
            log('🎉 SCAN DONE','success');
        }
        async function scanMicroCaps() {
            if(!state.systemReady) return;
            const maxPrice = parseFloat(document.getElementById('maxPrice')?.value||0.001);
            const microPairs = state.allPairs.filter(p=>p.price<maxPrice&&p.price>0&&p.liquidity>=10);
            const tempGraph={};
            microPairs.forEach(p=>{
                if(!tempGraph[p.base]) tempGraph[p.base]={};
                if(!tempGraph[p.target]) tempGraph[p.target]={};
                tempGraph[p.base][p.target]={rate:1/p.askPrice, weight:-Math.log(1/p.askPrice), volume:p.volume, liquidity:p.liquidity, spread:p.spread, exchange:p.exchange};
                tempGraph[p.target][p.base]={rate:p.bidPrice, weight:-Math.log(p.bidPrice), volume:p.volume, liquidity:p.liquidity, spread:p.spread, exchange:p.exchange};
            });
            const orig=state.graph; state.graph=tempGraph;
            const currencies=Object.keys(tempGraph).slice(0,40);
            const opps=[];
            for(const c of currencies) opps.push(...bellmanFord(c,5));
            state.graph=orig;
            state.opportunities.micro=opps.sort((a,b)=>b.actualProfit-a.actualProfit);
            updateStats(); displayMicroOpps();
            log('💎 Micro-cap scan: '+opps.length,'success');
        }

        function displayAllOpps() {
            document.getElementById('megaOpps').innerHTML = state.opportunities.mega.slice(0,20).map(o=>renderOppCard(o,'mega')).join('');
            document.getElementById('triangularOpps').innerHTML = state.opportunities.triangular.slice(0,20).map(o=>renderOppCard(o,'')).join('');
            document.getElementById('bellmanOpps').innerHTML = state.opportunities.bellman.slice(0,20).map(o=>renderOppCard(o,'')).join('');
        }
        function displayMicroOpps() {
            document.getElementById('microOpps').innerHTML = state.opportunities.micro.slice(0,20).map(o=>renderOppCard(o,'micro')).join('');
        }
        function renderOppCard(opp,cls) {
            const pathHtml = opp.edges.map((e,i)=>`<div>${opp.path[i]} → ${opp.path[i+1]} <span class="chip">${e.exchange}</span> Rate:${e.rate.toFixed(6)} Liq:$${e.liquidity.toFixed(0)}</div>`).join('');
            return `<div class="opportunity ${cls}" onclick="openTradeModal('${encodeURIComponent(JSON.stringify(opp))}')">
                <div style="display:flex;justify-content:space-between;"><strong>${opp.type.toUpperCase()}</strong><strong style="color:${opp.profitPercent>5?'var(--gold)':'var(--neon-green)'}">+${opp.profitPercent.toFixed(4)}%</strong></div>
                <div class="path-visual">${pathHtml}</div>
                <div class="depth-info">Max Trade: $${opp.maxTradeSize.toFixed(2)} · Actual Profit: $${opp.actualProfit.toFixed(4)}</div>
            </div>`;
        }

        // ==================== TRADE MODAL & PAPER TRADING ====================
        function openTradeModal(oppStr) {
            const opp = JSON.parse(decodeURIComponent(oppStr));
            const bet = parseFloat(document.getElementById('betSlider').value);
            const tradeSize = Math.min(opp.maxTradeSize, bet);
            const profit = (tradeSize/opp.maxTradeSize)*opp.actualProfit;
            const gasEst = 20; // simplified gas cost
            const netProfit = profit - gasEst;
            document.getElementById('tradeDetails').innerHTML = `
                <p>🔄 <strong>${opp.path.join(' → ')}</strong></p>
                <p>💰 Trade Size: $${tradeSize.toFixed(2)}</p>
                <p>📈 Gross Profit: $${profit.toFixed(4)}</p>
                <p>⛽ Gas Estimate: $${gasEst.toFixed(2)}</p>
                <p style="color:${netProfit>0?'var(--neon-green)':'#ff4444'}">💵 Net Profit: $${netProfit.toFixed(4)}</p>
                <p style="color:var(--gold);">⚠️ MEV Risk: Medium</p>
            `;
            document.getElementById('executeTradeBtn').onclick = () => executeTrade(opp, tradeSize, netProfit);
            document.getElementById('tradeModal').style.display = 'flex';
        }
        function closeModal() { document.getElementById('tradeModal').style.display = 'none'; }
        function executeTrade(opp, size, netProfit) {
            state.bankroll += netProfit;
            state.trades.push({ opp, size, netProfit, time: new Date() });
            log(`🎰 TRADE EXECUTED: +$${netProfit.toFixed(2)} | Bankroll: $${state.bankroll.toFixed(2)}`, netProfit>0?'success':'error');
            updateStats();
            closeModal();
            if(netProfit>50) spawnConfetti(window.innerWidth/2, 200, 100);
            playWinSound();
        }

        // ==================== WEBSOCKET & LIVE UPDATES ====================
        function connectWebSockets() {
            log('📡 Connecting live streams...','info');
            try {
                const ws = new WebSocket('wss://ws.okx.com:8443/ws/v5/public');
                ws.onopen=()=>{
                    log('OKX Live Ticker ON','success');
                    ws.send(JSON.stringify({op:'subscribe',args:[{channel:'tickers',instType:'SPOT'}]}));
                };
                ws.onmessage=(e)=>{ state.exchanges.okx.bytesReceived+=e.data.length; state.stats.wsBytes+=e.data.length; };
                ws.onerror=()=>log('OKX WS error','error');
            } catch(e){ log('WebSocket failed: '+e.message,'error'); }
            setInterval(updateStats,2000);
        }

        // ==================== SHARING & THEME ====================
        function shareJackpot() {
            const mega = state.opportunities.mega[0];
            if(mega) {
                const text = `🎰 I just found a ${mega.profitPercent.toFixed(2)}% arbitrage on QuanTM FOAM! Path: ${mega.path.join('→')} #DeFi #ArbitrageCasino`;
                navigator.clipboard.writeText(text).then(()=>log('📤 Copied to clipboard!','success'));
            } else log('No mega jackpot to share','warning');
        }
        function toggleTheme() {
            document.body.style.filter = document.body.style.filter==='hue-rotate(180deg)'?'none':'hue-rotate(180deg)';
        }

        window.addEventListener('load', ()=>{
            log('🎰 QuanTM FOAM v10.0 - ARBITRAGE CASINO','success');
            setTimeout(initSystem, 500);
            updateBetDisplay();
        });
    </script>
</body>
</html>
