<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>🎰 QuanTM FOAM v22.3 – CORS Proxy + Real‑Time WS + Live Wallet</title>
    <style>
        :root { --pink: #ff00ff; --cyan: #00f0ff; --green: #00ffaa; --gold: #ffd700; --bg: #0a0a1a; --card: #1a1a2a; --border: #2a2a3a; }
        *{margin:0;padding:0;box-sizing:border-box}
        body{background:var(--bg);color:#a0a0ff;font-family:'Courier New',monospace;font-size:11px;overflow-x:hidden}
        canvas#particleCanvas{position:fixed;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:9999}
        .container{max-width:1500px;margin:0 auto;padding:10px;position:relative;z-index:1}
        h1{color:var(--gold);font-size:22px;text-shadow:0 0 15px var(--pink),0 0 25px var(--cyan);margin-bottom:8px;letter-spacing:2px}
        .status-bar{padding:10px 15px;margin:10px 0;background:linear-gradient(145deg,#0a0a1a,#1a1a2a);border-radius:10px;border-left:5px solid var(--cyan);font-weight:bold;display:flex;justify-content:space-between;align-items:center;box-shadow:0 0 20px rgba(0,240,255,0.3);flex-wrap:wrap}
        .controls{display:flex;flex-wrap:wrap;gap:8px;margin:12px 0}
        button{background:#111;border:2px solid var(--pink);color:var(--pink);padding:8px 15px;border-radius:25px;font-size:10px;font-weight:bold;cursor:pointer;font-family:'Courier New',monospace;transition:all 0.2s;text-transform:uppercase;letter-spacing:1px;box-shadow:0 0 10px var(--pink)}
        button:hover{background:var(--pink);color:#000;box-shadow:0 0 25px var(--pink)}
        button:active{transform:scale(0.95)}
        button.cyan{border-color:var(--cyan);color:var(--cyan);box-shadow:0 0 10px var(--cyan)}
        button.cyan:hover{background:var(--cyan);color:#000}
        button.live{border-color:#ff4444;color:#ff4444;animation:livePulse 1s infinite}
        @keyframes livePulse{0%,100%{box-shadow:0 0 8px #ff4444}50%{box-shadow:0 0 20px #ff4444}}
        button:disabled{opacity:0.4;cursor:not-allowed;animation:none}
        .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:12px;margin:12px 0}
        .card{background:var(--card);border-radius:12px;padding:14px;border:1px solid var(--border);box-shadow:0 0 15px rgba(255,0,255,0.15);transition:all 0.3s}
        .card:hover{border-color:var(--pink);box-shadow:0 0 30px rgba(255,0,255,0.4)}
        .card h3{color:var(--cyan);font-size:13px;margin-bottom:10px}
        .exchange-status{display:flex;align-items:center;gap:8px;padding:5px;background:#0a0a1a;border-radius:6px;margin:3px 0;font-size:10px;border:1px solid #2a2a3a}
        .indicator{width:8px;height:8px;border-radius:50%;background:#ff4444;box-shadow:0 0 8px #ff4444;flex-shrink:0}
        .indicator.online{background:var(--green);box-shadow:0 0 12px var(--green);animation:pulse 1.5s infinite}
        .indicator.info{background:#4488ff;box-shadow:0 0 12px #4488ff}
        .indicator.ws{background:#ff00ff;box-shadow:0 0 12px #ff00ff;animation:pulse 0.8s infinite}
        @keyframes pulse{0%,100%{opacity:1;box-shadow:0 0 8px var(--green)}50%{opacity:0.4;box-shadow:0 0 22px var(--green)}}
        .stat{display:flex;justify-content:space-between;padding:4px 0;font-size:11px}
        .stat-value{color:var(--gold);font-weight:bold}
        .rolling-number{font-size:16px;color:var(--gold);font-weight:bold}
        .opp-section{margin:12px 0;padding:10px;background:#0f0f1f;border-radius:8px;border:1px solid #2a2a3a}
        .opp-header{display:flex;justify-content:space-between;align-items:center;padding:10px;background:#1a1a2a;border-radius:8px;cursor:pointer;font-weight:bold;color:var(--pink)}
        .opp-list{max-height:450px;overflow-y:auto}
        .opportunity{background:#111;padding:10px;margin:6px 0;border-radius:8px;border-left:5px solid var(--green);cursor:pointer;transition:all 0.2s}
        .opportunity:hover{border-left-color:var(--pink);background:#1a1a2a;box-shadow:0 0 15px rgba(255,0,255,0.4)}
        .opportunity.mega{border-left-color:var(--gold);animation:glow 1s infinite alternate}
        .opportunity.suspicious{border-left-color:#ff4444;background:#220000}
        @keyframes glow{from{box-shadow:0 0 5px var(--gold)}to{box-shadow:0 0 25px var(--gold)}}
        .path-visual{font-size:9px;color:var(--cyan);margin:5px 0}
        .depth-chart{display:flex;align-items:flex-end;gap:2px;height:60px;margin:5px 0}
        .depth-bar{flex:1;background:var(--cyan);border-radius:2px 2px 0 0}
        .log-container{background:#000;padding:10px;border-radius:8px;max-height:200px;overflow-y:auto;font-size:9px;margin-top:10px}
        .modal{display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.85);z-index:10000;align-items:center;justify-content:center}
        .modal-content{background:#1a1a2a;border:2px solid var(--pink);border-radius:15px;padding:25px;max-width:800px;width:95%;color:white;max-height:85vh;overflow-y:auto}
        .math-breakdown{background:#000;padding:10px;border-radius:5px;border:1px dashed var(--gold);margin-top:10px;font-size:10px;color:var(--gold)}
        .chip{background:var(--pink);color:#000;padding:2px 8px;border-radius:12px;font-size:9px;font-weight:bold;display:inline-block}
        .flex-row{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
        .progress-bar{height:10px;background:#333;border-radius:5px;margin:5px 0}
        .progress-fill{height:100%;background:var(--gold);border-radius:5px;width:0%}
        input,select{background:#0a0a1a;border:1px solid var(--cyan);color:var(--cyan);padding:4px 8px;border-radius:5px;font-family:'Courier New',monospace;font-size:11px}
        .checkbox-group{display:flex;flex-wrap:wrap;gap:5px;align-items:center}
        .checkbox-group label{display:flex;align-items:center;gap:4px;font-size:9px;color:var(--cyan)}
        .tier-badge { display: inline-block; padding: 2px 6px; border-radius: 4px; font-size: 8px; color: #000; margin-left: 4px; }
        .tier-pico { background: #ffaa00; } .tier-femto { background: #ff00ff; } .tier-planck { background: #00f0ff; }
        @media(max-width:768px){.grid{grid-template-columns:1fr}.controls{justify-content:center}}
    </style>
</head>
<body>
<canvas id="particleCanvas"></canvas>
<div class="container">
    <h1>🎰 QUANTM FOAM <span style="font-size:13px;">v22.3 – CORS PROXY + LIVE WS + DYNAMIC FX</span></h1>
    <div class="status-bar">
        <span id="mainStatus">🟡 SYSTEM STANDBY</span>
        <div class="toggle-container">
            <span style="font-size:10px;color:var(--gold);">VIRTUAL</span>
            <label class="switch">
                <input type="checkbox" id="liveToggle" onchange="UI.toggleLiveMode()">
                <span class="slider"></span>
            </label>
            <span style="font-size:10px;color:var(--green);">LIVE EXECUTION</span>
        </div>
    </div>
    <div class="controls">
        <button class="cyan" onclick="initSystem()">🔄 INIT</button>
        <button id="scanBtn" onclick="runFullScan()" disabled>🎲 FULL SCAN</button>
        <button id="liveScanBtn" onclick="toggleLiveScan()">🔄 LIVE SCAN</button>
        <button onclick="connectAllWebSockets()">📡 LIVE WS</button>
        <button onclick="openCreateCoinModal()" title="Level 5+">🪙 CREATE COIN</button>
        <button onclick="UI.toggleSlot()">🎰 SLOT UI</button>
        <button onclick="toggleLogs()">📋 LOGS</button>
        <button onclick="shareJackpot()">📤 SHARE</button>
        <button onclick="toggleTheme()">🎨 THEME</button>
    </div>

    <!-- Proxy & wallet config -->
    <div class="card" style="margin-bottom:10px;">
        <div class="flex-row">
            <div><label style="font-size:10px;">🌐 CORS PROXY URL:</label><input type="text" id="corsProxyUrl" placeholder="https://your-worker.workers.dev/?url=" style="width:260px;"></div>
            <div><label style="font-size:10px;">🔐 WALLET PROXY URL:</label><input type="text" id="walletProxyUrl" placeholder="https://your-signer-api.com" style="width:220px;"></div>
            <button onclick="saveProxyConfig()" class="cyan" style="padding:5px 10px;">SAVE</button>
        </div>
    </div>

    <!-- Gas / fee card -->
    <div class="card" style="margin-bottom:10px;">
        <h3>⛽ TRANSACTION FEES (for live mode)</h3>
        <div class="flex-row">
            <label>ETH Gas (Gwei):</label><input type="number" id="ethGasPrice" value="25" style="width:70px;">
            <label>Avg ETH tx (ETH):</label><input type="number" id="ethTxCost" value="0.0015" step="0.0001" style="width:90px;">
            <label>SOL Fee (SOL):</label><input type="number" id="solFee" value="0.000005" step="0.000001" style="width:90px;">
            <label>BSC Fee (BNB):</label><input type="number" id="bscFee" value="0.0003" step="0.0001" style="width:90px;">
        </div>
    </div>

    <!-- Forex / fiat selection -->
    <div class="card" style="margin-bottom:10px;">
        <h3>💱 FIAT CONVERSION (CoinGecko forex)</h3>
        <div class="flex-row">
            <div class="checkbox-group" id="fiatCheckboxes"></div>
            <button onclick="fetchForexRates()" class="cyan">🔄 FETCH RATES</button>
            <span id="forexStatus" style="color:var(--cyan);font-size:9px;"></span>
        </div>
        <small style="color:#666;">Select target fiats to convert prices to USD. Pairs with these quote currencies will be converted using live forex.</small>
    </div>

    <div id="slotMachine">
        <div class="slot-reels">
            <div class="reel" id="reel1"><div>BTC</div></div>
            <div class="reel" id="reel2"><div>ETH</div></div>
            <div class="reel" id="reel3"><div>USDT</div></div>
        </div>
        <div style="margin:10px 0;display:flex;align-items:center;justify-content:center;gap:8px;">
            <label style="color:var(--cyan);font-size:11px;">🔄 Bellman-Ford (depth <span id="slotDepthLabel">5</span>)</label>
            <input type="checkbox" id="slotBFToggle" onchange="UI.updateSlotDepthLabel()">
        </div>
        <button onclick="Engine.pullSlotLever()" style="padding:15px 30px;font-size:14px;">🎰 PULL LEVER</button>
        <div id="slotResult" style="color:var(--gold);font-size:16px;margin-top:15px;font-weight:bold;">READY</div>
    </div>

    <div class="grid">
        <div class="card" style="grid-column: span 2;">
            <h3>👤 USER MATRIX (LVL <span id="userLevel">1</span>)</h3>
            <div class="flex-row">
                <span>Level: <strong id="userLevel2">1</strong></span>
                <span>Matrix Score: <span id="matrixScore">0</span></span>
                <span>Next Level: <span id="nextLevelScore">100</span></span>
            </div>
            <div class="progress-bar"><div class="progress-fill" id="levelProgress"></div></div>
            <div class="flex-row" style="margin-top:5px;">
                <span>💸 Royalties: <span id="royalties">$0.00</span></span>
                <span>🏦 Quantums Fund: <span id="quantumFundVisible">$0.00</span></span>
                <span>🔒 Locked Fund: <span id="quantumFundLocked">$0.00</span> (matures in <span id="lockMaturity">7d</span>)</span>
            </div>
            <div class="flex-row" style="margin-top:8px;">
                <div style="flex:1"><label style="font-size:9px;">SOLANA WALLET:</label><input type="text" id="solAddress" placeholder="SOL address..." style="width:100%;" onchange="State.saveWallet()"><div id="solBalance" style="font-size:9px;color:#666;">Balance: 0.00 SOL</div></div>
                <div style="flex:1"><label style="font-size:9px;">ETHEREUM WALLET:</label><input type="text" id="ethAddress" placeholder="ETH address..." style="width:100%;" onchange="State.saveWallet()"><div id="ethBalance" style="font-size:9px;color:#666;">Balance: 0.00 ETH</div></div>
            </div>
        </div>
        <div class="card">
            <h3>📊 STATISTICS</h3>
            <div class="stat"><span>Pairs:</span><span class="stat-value" id="totalPairs">0</span></div>
            <div class="stat"><span>Nodes:</span><span class="stat-value" id="graphNodes">0</span></div>
            <div class="stat"><span>Edges:</span><span class="stat-value" id="graphEdges">0</span></div>
            <div class="stat"><span>Triangles:</span><span class="stat-value" id="triangleCount">0</span></div>
            <div class="stat"><span>WS Bytes:</span><span class="stat-value" id="wsBytes">0 KB</span></div>
            <div class="stat"><span>Opps:</span><span class="stat-value rolling-number" id="oppCount">0</span></div>
        </div>
    </div>

    <div class="flex-row" style="margin:10px 0; background:#1a1a2a; padding:12px; border-radius:12px;">
        <span style="color:var(--gold);font-size:14px;">💰 BANKROLL:</span>
        <span class="rolling-number" id="bankroll">$10,000.00</span>
        <span style="margin-left:auto;color:var(--cyan);">📈 P/L:</span>
        <span id="pnl" style="color:var(--green);font-size:14px;">$0.00 (0.00%)</span>
    </div>

    <div class="flex-row" style="justify-content:space-between;margin:10px 0;">
        <div class="flex-row"><label>🎚️ BET:</label><input type="range" id="betSlider" min="100" max="10000" value="1000" step="100" oninput="syncBetInput()"><input type="number" id="betInput" value="1000" min="100" max="10000" style="width:80px;" onchange="syncBetSlider()"></div>
        <div class="flex-row"><label>📐 PATH DEPTH (HOPS):</label><input type="range" id="pathSlider" min="3" max="10" value="5" oninput="UI.syncPathInput()"><input type="number" id="pathInput" value="5" min="3" max="10" style="width:45px;" onchange="UI.syncPathSlider()"></div>
        <div class="flex-row"><label>🧺 BASKET:</label><input type="text" id="basketInput" value="USDT,BTC,ETH,DOGE,SHIB,SOL" style="width:220px;"><label style="font-size:10px;"><input type="checkbox" id="basketTriFilter"> Filter</label></div>
        <div class="flex-row"><label>🔁 MODE:</label><select id="arbMode"><option value="intra">Intra</option><option value="inter">Inter</option><option value="both" selected>Both</option></select></div>
        <div class="flex-row" style="flex-direction:column;align-items:flex-start;"><div id="intraExCheckboxes" class="checkbox-group"></div><div class="flex-row" style="gap:4px;"><button onclick="selectAllIntra()" class="cyan" style="padding:3px 8px;">ALL</button><button onclick="deselectAllIntra()" class="cyan" style="padding:3px 8px;">NONE</button></div></div>
        <div class="flex-row"><label>🔑 PUMP TOKEN:</label><input type="text" id="pumpToken" placeholder="Bearer token" style="width:180px;" onchange="savePumpToken()"><span id="tokenSaved" style="color:var(--green);display:none;">✓</span></div>
    </div>

    <h2>⚡ EXCHANGE STATUS</h2>
    <div class="grid" id="exchangeStatus"></div>

    <div class="grid">
        <div class="card"><h3>🔥 PICO (<$1e-9)</h3><div id="picoValue" style="max-height:180px;overflow-y:auto;"></div></div>
        <div class="card"><h3>⚡ FEMTO (<$1e-12)</h3><div id="femtoValue" style="max-height:180px;overflow-y:auto;"></div></div>
        <div class="card"><h3>💧 PLANCK (<$1e-15)</h3><div id="planckValue" style="max-height:180px;overflow-y:auto;"></div></div>
    </div>
    <div class="grid">
        <div class="card"><h3>🔥 ULTRA LOW (<$0.0001)</h3><div id="ultraLowValue" style="max-height:200px;overflow-y:auto;"></div></div>
        <div class="card"><h3>💧 MICRO CAP (<$0.001)</h3><div id="microCap" style="max-height:200px;overflow-y:auto;"></div></div>
    </div>

    <h2>🎯 OPPORTUNITIES</h2>
    <div class="opp-section"><div class="opp-header" onclick="toggleSection('megaOpps')">🌟 MEGA JACKPOTS (>5%) <span id="megaCount">0</span></div><div id="megaOpps" class="opp-list"></div></div>
    <div class="opp-section"><div class="opp-header" onclick="toggleSection('triangularOpps')">📐 TRIANGULAR <span id="triangularCount">0</span></div><div id="triangularOpps" class="opp-list"></div></div>
    <div class="opp-section"><div class="opp-header" onclick="toggleSection('bellmanOpps')">🔍 BELLMAN-FORD <span id="bellmanCount">0</span></div><div id="bellmanOpps" class="opp-list"></div></div>
    <div class="opp-section"><div class="opp-header" onclick="toggleSection('suspiciousOpps')" style="color:#ff4444;">⚠️ SUSPICIOUS / OUTLIERS <span id="suspiciousCount">0</span></div><div id="suspiciousOpps" class="opp-list"></div></div>

    <h2 style="cursor:pointer;" onclick="toggleLogs()">📜 LOGS (click to toggle)</h2>
    <div class="log-container" id="logs" style="display:block;"></div>
</div>

<!-- Trade Modal -->
<div id="tradeModal" class="modal">
    <div class="modal-content">
        <h3 style="color:var(--gold);">🎰 EXECUTE ARBITRAGE PATH</h3>
        <div id="tradeDetails"></div>
        <div class="math-breakdown" id="compoundingMath"></div>
        <div style="margin-top:15px;display:flex;gap:10px;justify-content:flex-end;">
            <button onclick="closeModal()">CANCEL</button>
            <button class="cyan" id="executeTradeBtn">💸 PULL LEVER</button>
        </div>
    </div>
</div>

<!-- Create Coin Modal -->
<div id="createCoinModal" class="modal">
    <div class="modal-content">
        <h3 style="color:var(--gold);">🪙 CREATE YOUR OWN TOKEN</h3>
        <div>
            <label>Token Symbol:</label><input type="text" id="newCoinSymbol" placeholder="e.g. MOON" style="width:100px;"><br>
            <label>Initial Price ($):</label><input type="number" id="newCoinPrice" value="0.000001" step="0.000001"><br>
            <label>Liquidity ($):</label><input type="number" id="newCoinLiq" value="500" step="100"><br>
            <p style="font-size:9px;color:var(--cyan);">Creates a pair against USDT on "QUANTM_DEX".</p>
        </div>
        <div style="margin-top:15px;display:flex;gap:10px;justify-content:flex-end;"><button onclick="closeCreateCoinModal()">CANCEL</button><button id="createCoinBtn" class="cyan">🪙 MINT TOKEN</button></div>
    </div>
</div>

<script>
// ==================== AUDIO & PARTICLES ====================
const audioCtx = new (window.AudioContext||window.webkitAudioContext)();
function playTone(f,d,t='square',v=0.08){const o=audioCtx.createOscillator(),g=audioCtx.createGain();o.type=t;o.frequency.value=f;g.gain.setValueAtTime(v,audioCtx.currentTime);g.gain.exponentialRampToValueAtTime(0.001,audioCtx.currentTime+d);o.connect(g);g.connect(audioCtx.destination);o.start();o.stop(audioCtx.currentTime+d);}
function playSpin(){playTone(800,0.1,'sawtooth',0.04);}
function playWin(){playTone(523,0.12);setTimeout(()=>playTone(659,0.12),120);setTimeout(()=>playTone(784,0.2),240);}
function playJackpot(){[523,659,784,1047].forEach((f,i)=>setTimeout(()=>playTone(f,0.25,'square',0.12),i*140));}

const canvas=document.getElementById('particleCanvas'),ctx=canvas.getContext('2d');
let particles=[];
function resize(){canvas.width=innerWidth;canvas.height=innerHeight;}
window.addEventListener('resize',resize);resize();
class Particle{constructor(x,y,vx,vy,c,l){this.x=x;this.y=y;this.vx=vx;this.vy=vy;this.color=c;this.life=l;}}
function anim(){ctx.clearRect(0,0,canvas.width,canvas.height);for(let i=particles.length-1;i>=0;i--){const p=particles[i];p.x+=p.vx;p.y+=p.vy;p.vy+=0.08;p.life-=0.015;ctx.fillStyle=p.color;ctx.globalAlpha=Math.max(0,p.life);ctx.fillRect(p.x,p.y,4,4);if(p.life<=0)particles.splice(i,1);}requestAnimationFrame(anim);}
anim();
function confetti(x,y,n=35){const cols=['#ff00ff','#00f0ff','#ffd700','#00ffaa'];for(let i=0;i<n;i++)particles.push(new Particle(x,y,(Math.random()-0.5)*9,(Math.random()-0.5)*8-4,cols[Math.floor(Math.random()*cols.length)],0.7+Math.random()*0.5));}

// ==================== STATE ====================
const State = {
    bankroll: 10000, matrix: 0, level: 1, qFund: 0, lFund: 0, liveMode: false,
    userCoins: [], exchanges: {}, allPairs: [], graph: {}, triangles: [],
    opportunities: {mega:[],triangular:[],bellman:[],suspicious:[]},
    stats: {totalPairs:0,graphNodes:0,graphEdges:0,triangleCount:0,wsBytes:0,oppCount:0},
    selectedIntraExchanges: new Set(),
    liveScanInterval: null, liveScanActive: false,
    forexRates: {},  // e.g. { RUR: 0.01, INR: 0.012 }
    wsTickers: {},   // cache: { exchangeKey: { symbol: { bid: price, ask: price } } }
    load(){
        try{
            const s=JSON.parse(localStorage.getItem('qfoam_v22final'));
            if(s){
                this.bankroll=s.bankroll||10000; this.matrix=s.matrix||0; this.level=s.level||1;
                this.qFund=s.qFund||0; this.lFund=s.lFund||0; this.liveMode=s.liveMode||false;
                this.userCoins=s.userCoins||[];
                if(s.selectedIntraExchanges) this.selectedIntraExchanges = new Set(s.selectedIntraExchanges);
                if(s.forexRates) this.forexRates = s.forexRates;
                if(s.selectedFiats) this.selectedFiats = new Set(s.selectedFiats);
            }
        }catch(e){}
        document.getElementById('solAddress').value = localStorage.getItem('wallet_sol') || '';
        document.getElementById('ethAddress').value = localStorage.getItem('wallet_eth') || '';
        document.getElementById('pumpToken').value = localStorage.getItem('pumpfun_token') || '';
        document.getElementById('basketInput').value = localStorage.getItem('basket') || 'USDT,BTC,ETH,DOGE,SHIB,SOL';
        document.getElementById('pathInput').value = localStorage.getItem('pathDepth') || 5;
        document.getElementById('pathSlider').value = document.getElementById('pathInput').value;
        document.getElementById('liveToggle').checked = this.liveMode;
        document.getElementById('corsProxyUrl').value = localStorage.getItem('corsProxyUrl') || '';
        document.getElementById('walletProxyUrl').value = localStorage.getItem('walletProxyUrl') || '';
        this.selectedFiats = new Set(JSON.parse(localStorage.getItem('selectedFiats') || '["RUR","INR","EUR","GBP","RUB"]'));
        UI.updateProfile();
        UI.updateSlotDepthLabel();
        UI.renderFiatCheckboxes();
    },
    save(){
        localStorage.setItem('qfoam_v22final', JSON.stringify({
            bankroll:this.bankroll, matrix:this.matrix, level:this.level,
            qFund:this.qFund, lFund:this.lFund, liveMode:this.liveMode,
            userCoins:this.userCoins,
            selectedIntraExchanges: [...this.selectedIntraExchanges],
            forexRates: this.forexRates,
            selectedFiats: [...this.selectedFiats]
        }));
        localStorage.setItem('wallet_sol', document.getElementById('solAddress').value);
        localStorage.setItem('wallet_eth', document.getElementById('ethAddress').value);
        localStorage.setItem('pumpfun_token', document.getElementById('pumpToken').value);
        localStorage.setItem('basket', document.getElementById('basketInput').value);
        localStorage.setItem('pathDepth', document.getElementById('pathInput').value);
        localStorage.setItem('corsProxyUrl', document.getElementById('corsProxyUrl').value);
        localStorage.setItem('walletProxyUrl', document.getElementById('walletProxyUrl').value);
        localStorage.setItem('selectedFiats', JSON.stringify([...this.selectedFiats]));
    },
    saveWallet(){ this.save(); },
    savePumpToken(){ document.getElementById('tokenSaved').style.display='inline'; this.save(); }
};

