// ==================== LOGGING ====================
function log(msg, type='info'){
    const t = new Date().toLocaleTimeString();
    const el = document.getElementById('logs');
    if(!el) return;
    el.innerHTML = `<div style="color:${type==='error'?'#ff4444':type==='success'?'var(--green)':'inherit'}">[${t}] ${msg}</div>` + el.innerHTML;
}
function toggleLogs(){ const el=document.getElementById('logs'); el.style.display = el.style.display==='none'?'block':'none'; }
function toggleSection(id){ const el=document.getElementById(id); el.style.display = el.style.display==='none'?'block':'none'; }

// ==================== UI CONTROLLER ====================
const UI = {
    toggleSlot(){ const s=document.getElementById('slotMachine'); s.style.display = s.style.display==='none'?'block':'none'; },
    syncPathInput(){ document.getElementById('pathInput').value = document.getElementById('pathSlider').value; State.save(); this.updateSlotDepthLabel(); },
    syncPathSlider(){ document.getElementById('pathSlider').value = document.getElementById('pathInput').value; State.save(); this.updateSlotDepthLabel(); },
    toggleLiveMode(){
        State.liveMode = document.getElementById('liveToggle').checked;
        document.getElementById('mainStatus').style.color = State.liveMode?'var(--green)':'var(--cyan)';
        log(`System switched to ${State.liveMode?'LIVE':'VIRTUAL'} mode.`);
        State.save();
    },
    updateProfile(){
        document.getElementById('userLevel').textContent = State.level;
        document.getElementById('userLevel2').textContent = State.level;
        document.getElementById('matrixScore').textContent = State.matrix;
        const next = Math.pow(State.level,2)*10;
        document.getElementById('nextLevelScore').textContent = next;
        document.getElementById('levelProgress').style.width = Math.min(100,(State.matrix/next)*100)+'%';
        document.getElementById('royalties').textContent = '$'+(State.royalties||0).toFixed(2);
        document.getElementById('quantumFundVisible').textContent = '$'+(State.qFund||0).toFixed(2);
        document.getElementById('quantumFundLocked').textContent = '$'+(State.lFund||0).toFixed(2);
        document.getElementById('bankroll').textContent = '$'+State.bankroll.toFixed(2);
        const pnl = State.bankroll-10000;
        document.getElementById('pnl').innerHTML = `$${pnl.toFixed(2)} (${((pnl/10000)*100).toFixed(2)}%)`;
        document.getElementById('pnl').style.color = pnl>=0?'var(--green)':'#ff4444';
    },
    renderOpp(opp, targetId, isMega=false){
        const container = document.getElementById(targetId);
        if(!container) return;
        const html = `<div class="opportunity ${isMega?'mega':''}" onclick="UI.openTradeModal('${encodeURIComponent(JSON.stringify(opp))}')">
            <strong>${opp.type.toUpperCase()} +${opp.profitPercent.toFixed(2)}%</strong>
            <div class="path-visual">${opp.path.join(' → ')}</div>
            <div>Max: $${opp.maxTradeSize.toFixed(2)} | Profit: $${opp.actualProfit.toFixed(2)}</div>
        </div>`;
        container.innerHTML = html + container.innerHTML;
    },
    openTradeModal(oppStr){
        const opp = JSON.parse(decodeURIComponent(oppStr));
        const bet = parseFloat(document.getElementById('betInput').value)||1000;
        const tradeSize = Math.min(opp.maxTradeSize, bet);
        let runningTotal = tradeSize;
        let mathString = `💰 Start: $${tradeSize.toFixed(2)}<br>`;
        const detailsHtml = opp.edges.map((edge,i)=>{
            const prev = runningTotal;
            runningTotal *= edge.rate;
            mathString += `Hop ${i+1}: $${prev.toFixed(2)} × ${edge.rate.toFixed(6)} → $${runningTotal.toFixed(2)}<br>`;
            const depthPct = Math.min(1, tradeSize/(edge.liquidity+1));
            const depthColor = depthPct>0.8?'#ff4444':depthPct>0.5?'#ffaa00':'var(--cyan)';
            return `<div style="margin:5px 0;padding:8px;background:#111;border-radius:5px;">
                <strong>${opp.path[i]} → ${opp.path[i+1]}</strong> <span class="chip">${edge.exchangeType.toUpperCase()}</span>
                <div class="depth-chart">${Array.from({length:10},(_,j)=>{
                    const level=(j+1)/10;
                    return `<div class="depth-bar" style="height:${level<=depthPct?25:5}px;background:${level<=depthPct?depthColor:'#333'};"></div>`;
                }).join('')}</div>
                <div style="font-size:9px;">Liq: $${edge.liquidity.toFixed(0)} | Depth: ${(depthPct*100).toFixed(1)}%</div>
            </div>`;
        }).join('');
        mathString += `<strong style="color:var(--green);">🏁 Final: $${runningTotal.toFixed(2)}</strong>`;
        document.getElementById('tradeDetails').innerHTML = `<p>🔄 ${opp.path.join(' → ')}</p><p>💰 Trade: $${tradeSize.toFixed(2)}</p>${detailsHtml}`;
        document.getElementById('compoundingMath').innerHTML = `<h4>📐 Compounding (${opp.edges.length} hops)</h4>${mathString}`;
        document.getElementById('executeTradeBtn').onclick = ()=>{
            closeModal();
            Engine.executeTrade(opp, tradeSize, runningTotal-tradeSize);
        };
        document.getElementById('tradeModal').style.display = 'flex';
    },
    closeModal(){ document.getElementById('tradeModal').style.display = 'none'; },
    updateSlotDepthLabel(){
        document.getElementById('slotDepthLabel').textContent = document.getElementById('pathInput').value;
    },
    renderFiatCheckboxes(){
        const container = document.getElementById('fiatCheckboxes');
        const allFiats = ['RUR','INR','EUR','GBP','RUB','JPY','CNY','KRW','AUD','CAD','CHF'];
        container.innerHTML = '';
        allFiats.forEach(f=>{
            const checked = State.selectedFiats.has(f) ? 'checked' : '';
            container.innerHTML += `<label><input type="checkbox" value="${f}" ${checked} onchange="UI.toggleFiat('${f}')"> ${f}</label>`;
        });
    },
    toggleFiat(fiat){
        State.selectedFiats.has(fiat) ? State.selectedFiats.delete(fiat) : State.selectedFiats.add(fiat);
        State.save();
    }
};
function closeModal(){ UI.closeModal(); }

// ==================== PROXY & FETCH HELPERS ====================
function getProxiedUrl(originalUrl) {
    const proxy = (document.getElementById('corsProxyUrl')?.value || '').trim();
    if (proxy) {
        return proxy + encodeURIComponent(originalUrl);
    }
    return originalUrl;
}
function saveProxyConfig() {
    State.save();
    log('Proxy & wallet URLs saved.');
}

// ==================== FOREX RATES ====================
async function fetchForexRates() {
    const fiats = [...State.selectedFiats];
    if (fiats.length === 0) {
        log('No fiat currencies selected.','warning');
        return;
    }
    const vs = fiats.join(',');
    const url = `https://api.coingecko.com/api/v3/simple/price?ids=bitcoin&vs_currencies=usd,${vs}`;
    try {
        const resp = await fetch(getProxiedUrl(url));
        const data = await resp.json();
        if (!data.bitcoin) throw new Error('Invalid response');
        const btcUsd = data.bitcoin.usd;
        State.forexRates = {};
        fiats.forEach(f => {
            if (data.bitcoin[f]) {
                State.forexRates[f] = btcUsd / data.bitcoin[f];
            }
        });
        State.save();
        document.getElementById('forexStatus').textContent = `Updated: ${fiats.length} rates`;
        log('Forex rates updated via CoinGecko.','success');
        // Re-categorize low value tokens
        displayLowValue();
    } catch(e) {
        log(`Forex fetch failed: ${e.message}`, 'error');
    }
}

// Utility: get USD price of a pair (handles fiat conversion)
function getUsdPrice(pair) {
    if (!pair) return 0;
    if (pair.target === 'USDT' || pair.target === 'USD' || pair.target === 'USDC') return pair.price;
    const rate = State.forexRates[pair.target];
    return rate ? pair.price * rate : pair.price;
}

// Convert a monetary amount from a currency to USD (used for opportunity conversion)
function toUsd(amount, currency) {
    if (!currency || currency === 'USDT' || currency === 'USD' || currency === 'USDC') return amount;
    const rate = State.forexRates[currency];
    return rate ? amount * rate : amount;
}

// ==================== API LOADERS (with CORS proxy) ====================
async function loadApi(defKey){
    const ex = State.exchanges[defKey];
    try{
        let headers = {};
        if(ex.auth){
            const token = document.getElementById('pumpToken').value.trim();
            if(token) headers = {'Authorization':'Bearer '+token};
        }
        const url = getProxiedUrl(ex.url);
        const resp = await fetch(url, {headers});
        if(!resp.ok) throw new Error('HTTP '+resp.status);
        const data = await resp.json();
        let pairs = [];
        switch(ex.parser){
            case 'okx':
                pairs = (data.data||[]).slice(0,600).map(t=>{
                    const parts = t.instId.split('-'); if(parts.length!==2) return null;
                    const price = parseFloat(t.last)||0, vol = (parseFloat(t.volCcy24h)||0)*price;
                    return {base:parts[0], target:parts[1], price, volume:vol, liquidity:vol, bidPrice:parseFloat(t.bidPx)||price*0.999, askPrice:parseFloat(t.askPx)||price*1.001, exchange:defKey, exchangeType:ex.type};
                }).filter(Boolean);
                break;
            case 'coinbase':
                pairs = (Array.isArray(data)?data:[]).slice(0,300).map(p=>{
                    const price = parseFloat(p.price)||1; const vol = (parseFloat(p.volume)||0)*price;
                    return {base:p.base_currency, target:p.quote_currency, price, volume:vol, liquidity:vol, bidPrice:price*0.998, askPrice:price*1.002, exchange:defKey, exchangeType:ex.type};
                }).filter(p=>p.price>0);
                break;
            case 'binance':
                pairs = (Array.isArray(data)?data:[]).slice(0,600).map(t=>{
                    const price = parseFloat(t.lastPrice)||0, vol = (parseFloat(t.quoteVolume)||0)*price;
                    const sym = t.symbol||''; let base = sym.replace(/USDT$/,'').replace(/BTC$/,'').replace(/ETH$/,'').replace(/BNB$/,'').replace(/USDC$/,'');
                    if(base===sym) base = sym.replace(/USD$/,'');
                    return {base, target:sym.includes('USDT')?'USDT':sym.includes('USDC')?'USDC':sym.includes('BTC')?'BTC':sym.includes('ETH')?'ETH':'USD', price, volume:vol, liquidity:vol, bidPrice:parseFloat(t.bidPrice)||price*0.999, askPrice:parseFloat(t.askPrice)||price*1.001, exchange:defKey, exchangeType:ex.type};
                }).filter(p=>p.price>0&&p.base);
                break;
            case 'kucoin':
                pairs = (data?.data?.ticker||[]).slice(0,500).map(t=>{
                    const price = parseFloat(t.last)||0, vol = (parseFloat(t.volValue)||0)*price;
                    const parts = (t.symbol||'').split('-');
                    return {base:parts[0]||'', target:parts[1]||'USDT', price, volume:vol, liquidity:vol, bidPrice:parseFloat(t.buy)||price*0.999, askPrice:parseFloat(t.sell)||price*1.001, exchange:defKey, exchangeType:ex.type};
                }).filter(p=>p.price>0&&p.base);
                break;
            case 'bybit':
                pairs = (data?.result?.list||[]).slice(0,400).map(t=>{
                    const price = parseFloat(t.lastPrice)||0, vol = (parseFloat(t.volume24h)||0)*price;
                    return {base:t.symbol.replace(/USDT$/,''), target:'USDT', price, volume:vol, liquidity:vol, bidPrice:parseFloat(t.bid1Price)||price*0.999, askPrice:parseFloat(t.ask1Price)||price*1.001, exchange:defKey, exchangeType:ex.type};
                }).filter(p=>p.price>0);
                break;
            case 'gate':
                pairs = (Array.isArray(data)?data:[]).slice(0,400).map(t=>{
                    const price = parseFloat(t.last)||0, vol = (parseFloat(t.quote_volume)||0)*price;
                    const parts = (t.currency_pair||'').split('_');
                    return {base:parts[0]||'', target:parts[1]||'USDT', price, volume:vol, liquidity:vol, bidPrice:parseFloat(t.highest_bid)||price*0.999, askPrice:parseFloat(t.lowest_ask)||price*1.001, exchange:defKey, exchangeType:ex.type};
                }).filter(p=>p.price>0&&p.base);
                break;
            case 'mexc':
                pairs = (Array.isArray(data)?data:[]).slice(0,400).map(t=>{
                    const price = parseFloat(t.lastPrice)||0, vol = (parseFloat(t.quoteVolume)||0)*price;
                    return {base:t.symbol.replace(/USDT$/,''), target:'USDT', price, volume:vol, liquidity:vol, bidPrice:parseFloat(t.bidPrice)||price*0.999, askPrice:parseFloat(t.askPrice)||price*1.001, exchange:defKey, exchangeType:ex.type};
                }).filter(p=>p.price>0);
                break;
            case 'kraken':{
                const result = data?.result||{};
                pairs = Object.keys(result).slice(0,300).map(k=>{
                    const t = result[k]; const price = parseFloat(t.c?.[0])||0, vol = (parseFloat(t.v?.[1])||0)*price;
                    const base = k.replace(/^X|Z/g,'').replace(/USD$|EUR$|BTC$/,'');
                    return {base, target:'USD', price, volume:vol, liquidity:vol, bidPrice:parseFloat(t.b?.[0])||price*0.999, askPrice:parseFloat(t.a?.[0])||price*1.001, exchange:defKey, exchangeType:ex.type};
                }).filter(p=>p.price>0);
                break;
            }
            case 'bitstamp':
                pairs = (Array.isArray(data)?data:[]).slice(0,250).map(t=>{
                    const price = parseFloat(t.last)||0, vol = (parseFloat(t.volume)||0)*price;
                    const parts = (t.pair||'').split('/');
                    return {base:parts[0]||'', target:parts[1]||'USD', price, volume:vol, liquidity:vol, bidPrice:parseFloat(t.bid)||price*0.999, askPrice:parseFloat(t.ask)||price*1.001, exchange:defKey, exchangeType:ex.type};
                }).filter(p=>p.price>0&&p.base);
                break;
            case 'indodax':{
                const tickers = data||{};
                pairs = Object.keys(tickers).slice(0,250).map(k=>{
                    const t = tickers[k]; const price = parseFloat(t.last)||0, vol = (parseFloat(t.vol_idr)||0)*price;
                    const parts = k.split('_');
                    return {base:parts[0]||'', target:(parts[1]||'IDR').toUpperCase(), price, volume:vol, liquidity:vol, bidPrice:parseFloat(t.buy)||price*0.999, askPrice:parseFloat(t.sell)||price*1.001, exchange:defKey, exchangeType:ex.type};
                }).filter(p=>p.price>0);
                break;
            }
            case 'yobit':{
                const info = data?.pairs||{};
                const allKeys = Object.keys(info).slice(0,200);
                if(allKeys.length===0) throw new Error('No pairs');
                const tickerUrl = getProxiedUrl(`https://yobit.net/api/3/ticker/${allKeys.join('-')}`);
                const tickerResp = await fetch(tickerUrl);
                const tickerData = await tickerResp.json();
                pairs = allKeys.map(k=>{
                    const t = tickerData[k]||{}; const price = parseFloat(t.last)||0, vol = (parseFloat(t.vol)||0)*price;
                    const parts = k.split('_');
                    return {base:(parts[0]||'').toUpperCase(), target:(parts[1]||'USD').toUpperCase(), price, volume:vol, liquidity:vol, bidPrice:parseFloat(t.buy)||price*0.999, askPrice:parseFloat(t.sell)||price*1.001, exchange:defKey, exchangeType:ex.type};
                }).filter(p=>p.price>0);
                break;
            }
            case 'pumpfun':
                pairs = (Array.isArray(data)?data:[]).map(t=>{
                    const price = parseFloat(t.usd_market_cap)/parseFloat(t.total_supply)||0;
                    const liq = parseFloat(t.usd_market_cap)*0.1||0;
                    return {base:t.symbol||'UNKNOWN', target:'SOL', price, volume:liq*0.5, liquidity:liq, bidPrice:price*0.95, askPrice:price*1.05, exchange:defKey, exchangeType:'cex'};
                }).filter(p=>p.base!=='UNKNOWN'&&p.price>0);
                if(pairs.length===0) throw new Error('Empty');
                break;
            case 'poloniex':
                pairs = (Array.isArray(data)?data:[]).slice(0,400).map(t=>{
                    const price = parseFloat(t.close)||0, vol = (parseFloat(t.quantity)||0)*price;
                    const parts = (t.symbol||'').split('_');
                    return {base:parts[0]||'', target:parts[1]||'USDT', price, volume:vol, liquidity:vol, bidPrice:parseFloat(t.bid)||price*0.999, askPrice:parseFloat(t.ask)||price*1.001, exchange:defKey, exchangeType:ex.type};
                }).filter(p=>p.price>0);
                break;
            case 'huobi':
                pairs = (data?.data||[]).slice(0,400).map(t=>{
                    const price = parseFloat(t.close)||0, vol = (parseFloat(t.vol)||0)*price;
                    const base = (t.symbol||'').toUpperCase().replace(/USDT$/,'');
                    return {base, target:'USDT', price, volume:vol, liquidity:vol, bidPrice:parseFloat(t.bid)||price*0.999, askPrice:parseFloat(t.ask)||price*1.001, exchange:defKey, exchangeType:ex.type};
                }).filter(p=>p.price>0);
                break;
            case 'gemini':
                pairs = (Array.isArray(data)?data:[]).slice(0,150).map(t=>{
                    const price = parseFloat(t.price)||0;
                    const parts = (t.symbol||t.pair||'').split('/');
                    return {base:parts[0]||'', target:parts[1]||'USD', price, volume:0, liquidity:0, bidPrice:price*0.999, askPrice:price*1.001, exchange:defKey, exchangeType:ex.type};
                }).filter(p=>p.price>0&&p.base);
                break;
            case 'ascendex':
                pairs = (data?.data||[]).slice(0,250).map(t=>{
                    const price = parseFloat(t.close)||0, vol = (parseFloat(t.volume)||0)*price;
                    const parts = (t.symbol||'').split('/');
                    return {base:parts[0]||'', target:parts[1]||'USDT', price, volume:vol, liquidity:vol, bidPrice:parseFloat(t.bid)||price*0.999, askPrice:parseFloat(t.ask)||price*1.001, exchange:defKey, exchangeType:ex.type};
                }).filter(p=>p.price>0);
                break;
            case 'digifinex':
                pairs = (data?.ticker||[]).slice(0,250).map(t=>{
                    const price = parseFloat(t.last)||0, vol = (parseFloat(t.base_volume)||0)*price;
                    const parts = (t.symbol||'').split('_');
                    return {base:parts[0]||'', target:parts[1]||'USDT', price, volume:vol, liquidity:vol, bidPrice:parseFloat(t.buy)||price*0.999, askPrice:parseFloat(t.sell)||price*1.001, exchange:defKey, exchangeType:ex.type};
                }).filter(p=>p.price>0);
                break;
            case 'bittrex':
                pairs = (Array.isArray(data)?data:[]).slice(0,250).map(t=>{
                    const price = parseFloat(t.lastTradeRate)||0;
                    const parts = (t.symbol||'').split('-');
                    return {base:parts[0]||'', target:parts[1]||'USD', price, volume:0, liquidity:0, bidPrice:price*0.999, askPrice:price*1.001, exchange:defKey, exchangeType:ex.type};
                }).filter(p=>p.price>0);
                break;
            case 'cryptocom':
                pairs = (data?.result?.data||[]).slice(0,250).map(t=>{
                    const price = parseFloat(t.a)||0, vol = (parseFloat(t.v)||0)*price;
                    const parts = (t.i||'').split('_');
                    return {base:parts[0]||'', target:parts[1]||'USD', price, volume:vol, liquidity:vol, bidPrice:parseFloat(t.b)||price*0.999, askPrice:parseFloat(t.k)||price*1.001, exchange:defKey, exchangeType:ex.type};
                }).filter(p=>p.price>0);
                break;
            case 'dexscreener':{
                const raw = data?.pairs||[];
                pairs = raw.slice(0,400).map(p=>{
                    const price = parseFloat(p.priceUsd)||0, liq = p.liquidity?.usd||0, vol = p.volume?.h24||0;
                    const spread = liq>0?Math.max(0.003,Math.min(0.05,5000/liq)):0.03;
                    return {base:p.baseToken?.symbol||'UNKNOWN', target:p.quoteToken?.symbol||'ETH', price, volume:vol, liquidity:liq, bidPrice:price*(1-spread/2), askPrice:price*(1+spread/2), exchange:defKey, exchangeType:'dex'};
                }).filter(p=>p.base!=='UNKNOWN'&&p.price>0);
                break;
            }
            case 'coingecko':{
                const cg = Array.isArray(data)?data:[];
                pairs = cg.slice(0,250).map(c=>({base:(c.symbol||'').toUpperCase(), target:'USD', price:c.current_price||0, volume:c.total_volume||0, liquidity:c.market_cap||0, bidPrice:(c.current_price||0)*0.999, askPrice:(c.current_price||0)*1.001, exchange:defKey, exchangeType:'info'})).filter(p=>p.price>0);
                break;
            }
            case 'coinlore':{
                const cl = data?.data||[];
                pairs = cl.slice(0,250).map(c=>({base:c.symbol||'', target:'USD', price:parseFloat(c.price_usd)||0, volume:parseFloat(c.volume24)||0, liquidity:parseFloat(c.market_cap_usd)||0, bidPrice:(parseFloat(c.price_usd)||0)*0.999, askPrice:(parseFloat(c.price_usd)||0)*1.001, exchange:defKey, exchangeType:'info'})).filter(p=>p.price>0);
                break;
            }
            case 'coinpaprika':{
                const cp = Array.isArray(data)?data:[];
                pairs = cp.slice(0,250).map(t=>({base:t.symbol||'', target:'USD', price:parseFloat(t.quotes?.USD?.price)||0, volume:parseFloat(t.quotes?.USD?.volume_24h)||0, liquidity:parseFloat(t.quotes?.USD?.market_cap)||0, bidPrice:(parseFloat(t.quotes?.USD?.price)||0)*0.999, askPrice:(parseFloat(t.quotes?.USD?.price)||0)*1.001, exchange:defKey, exchangeType:'info'})).filter(p=>p.price>0);
                break;
            }
            case 'coincap':{
                const assets = data?.data||[];
                pairs = assets.slice(0,100).map(a=>({base:a.symbol||a.id, target:'USD', price:parseFloat(a.priceUsd)||0, volume:parseFloat(a.volumeUsd24Hr)||0, liquidity:parseFloat(a.marketCapUsd)||0, bidPrice:(parseFloat(a.priceUsd)||0)*0.999, askPrice:(parseFloat(a.priceUsd)||0)*1.001, exchange:defKey, exchangeType:'info'})).filter(p=>p.price>0);
                break;
            }
            default: pairs = [];
        }
        ex.pairs = pairs;
        ex.status = 'online';
        log(`${ex.name}: ${ex.pairs.length} pairs`, 'success');
    }catch(e){
        if(defKey==='pumpfun'){
            log('Pump.fun direct failed, trying fallback...','warning');
            try{
                const fbResp = await fetch(getProxiedUrl('https://api.dexscreener.com/latest/dex/search?q=SOL'));
                const fbData = await fbResp.json();
                const fbPairs = (fbData?.pairs||[]).slice(0,400).map(p=>{
                    const price = parseFloat(p.priceUsd)||0, liq = p.liquidity?.usd||0;
                    const spread = liq>0?Math.max(0.003,Math.min(0.05,5000/liq)):0.03;
                    return {base:p.baseToken?.symbol||'UNKNOWN', target:p.quoteToken?.symbol||'ETH', price, volume:p.volume?.h24||0, liquidity:liq, bidPrice:price*(1-spread/2), askPrice:price*(1+spread/2), exchange:'pumpfun_fallback', exchangeType:'dex'};
                }).filter(p=>p.base!=='UNKNOWN'&&p.price>0);
                ex.pairs = fbPairs;
                ex.status = 'online';
                log(`Pump.fun fallback: ${ex.pairs.length} pairs`,'success');
                return;
            }catch(fbErr){ log(`Fallback also failed: ${fbErr.message}`,'error'); }
        }
        ex.status = 'offline'; ex.pairs = [];
        log(`${ex.name}: ${e.message}`,'error');
    }
}

// ==================== INIT ====================
async function initSystem(){
    log('🎰 Initializing all exchanges (with proxy)...');
    updateStatus('🔄 LOADING...'); playSpin();
    await Promise.allSettled(exchangeDefs.map(d=>loadApi(d.key)));
    State.allPairs = Object.values(State.exchanges).flatMap(e=>e.pairs);
    State.userCoins.forEach(c=>{
        State.allPairs.push({base:c.symbol, target:'USDT', price:c.price, volume:c.liq*0.3, liquidity:c.liq, bidPrice:c.price*0.95, askPrice:c.price*1.05, exchange:'QUANTM_DEX', exchangeType:'dex'});
    });
    State.stats.totalPairs = State.allPairs.length;
    updateIntraExCheckboxes();
    buildGraph();
    buildTriangles();
    displayLowValue();
    updateExchangeDisplay();
    updateStats();
    const online = Object.values(State.exchanges).filter(e=>e.status==='online').length;
    if(online>0){
        document.getElementById('scanBtn').disabled = false;
        updateStatus(`✅ READY · ${online}/${exchangeDefs.length} online · ${State.stats.totalPairs} pairs`);
        log('System ready.','success');
    }else{
        updateStatus('❌ NO EXCHANGES ONLINE');
    }
}

function updateStatus(msg){ document.getElementById('mainStatus').innerHTML = msg; }

// ==================== GRAPH & VISUAL (with WS cache) ====================
function getGraphPairs(){
    const mode = document.getElementById('arbMode').value;
    if(mode==='intra') return [...State.selectedIntraExchanges].flatMap(k=>State.exchanges[k]?.pairs||[]);
    return Object.values(State.exchanges).filter(e=>e.status==='online'&&e.type!=='info').flatMap(e=>e.pairs);
}

function applyWsCache(pair) {
    const cache = State.wsTickers[pair.exchange];
    if (cache) {
        const key = `${pair.base}${pair.target}`.toUpperCase();
        const tick = cache[key];
        if (tick) {
            return { ...pair, bidPrice: tick.bid || pair.bidPrice, askPrice: tick.ask || pair.askPrice };
        }
    }
    return pair;
}

function buildGraph(){
    State.graph = {};
    const pairs = getGraphPairs().map(applyWsCache);
    pairs.forEach(p=>{
        if(p.liquidity<50) return;
        if(!State.graph[p.base]) State.graph[p.base] = {};
        if(!State.graph[p.target]) State.graph[p.target] = {};
        State.graph[p.base][p.target] = {rate:1/p.askPrice, weight:-Math.log(1/p.askPrice), volume:p.volume, liquidity:p.liquidity, exchange:p.exchange, exchangeType:p.exchangeType};
        State.graph[p.target][p.base] = {rate:p.bidPrice, weight:-Math.log(p.bidPrice), volume:p.volume, liquidity:p.liquidity, exchange:p.exchange, exchangeType:p.exchangeType};
    });
    State.stats.graphNodes = Object.keys(State.graph).length;
    State.stats.graphEdges = Object.values(State.graph).reduce((s,o)=>s+Object.keys(o).length,0);
}

function buildTriangles(){
    State.triangles = [];
    const nodes = Object.keys(State.graph);
    for(let i=0;i<Math.min(nodes.length,120);i++){
        const A = nodes[i]; const nA = Object.keys(State.graph[A]||{});
        for(const B of nA){
            const nB = Object.keys(State.graph[B]||{});
            for(const C of nB) if(State.graph[C]?.[A]) State.triangles.push([A,B,C]);
        }
    }
    State.stats.triangleCount = State.triangles.length;
}

function displayLowValue(){
    const all = State.allPairs.filter(p=>p.price>0);
    const fmt = p=>{
        const usd = getUsdPrice(p).toExponential(4);
        let tier = '';
        if (usd < 1e-15) tier = '<span class="tier-badge tier-planck">PLANCK</span>';
        else if (usd < 1e-12) tier = '<span class="tier-badge tier-femto">FEMTO</span>';
        else if (usd < 1e-9) tier = '<span class="tier-badge tier-pico">PICO</span>';
        return `<div>${p.base} <span class="chip">${p.exchange||'?'}</span> $${usd} ${tier}</div>`;
    };
    document.getElementById('picoValue').innerHTML = all.filter(p=>getUsdPrice(p)<1e-9&&getUsdPrice(p)>=1e-12).slice(0,25).map(fmt).join('')||'None';
    document.getElementById('femtoValue').innerHTML = all.filter(p=>getUsdPrice(p)<1e-12&&getUsdPrice(p)>=1e-15).slice(0,25).map(fmt).join('')||'None';
    document.getElementById('planckValue').innerHTML = all.filter(p=>getUsdPrice(p)<1e-15).slice(0,25).map(fmt).join('')||'None';
    document.getElementById('ultraLowValue').innerHTML = all.filter(p=>getUsdPrice(p)<0.0001&&getUsdPrice(p)>=1e-9).slice(0,25).map(fmt).join('')||'None';
    document.getElementById('microCap').innerHTML = all.filter(p=>getUsdPrice(p)<0.001&&getUsdPrice(p)>=0.0001).slice(0,25).map(fmt).join('')||'None';
}

// ==================== ARBITRAGE (with forex conversion) ====================
function scanTriangular(minProfit=0.0001){
    const opps = []; const inv = 1000;
    const basket = document.getElementById('basketInput').value.split(',').map(s=>s.trim().toUpperCase());
    const filter = document.getElementById('basketTriFilter').checked;
    const mode = document.getElementById('arbMode').value;
    State.triangles.forEach(([A,B,C])=>{
        if(filter&&!basket.includes(A)) return;
        const e1 = State.graph[A]?.[B], e2 = State.graph[B]?.[C], e3 = State.graph[C]?.[A];
        if(!e1||!e2||!e3) return;
        if(mode==='intra'){
            const exchanges = new Set([e1.exchange,e2.exchange,e3.exchange]);
            if(exchanges.size!==1||!State.selectedIntraExchanges.has(e1.exchange)) return;
        }
        const final = inv*e1.rate*e2.rate*e3.rate;
        const profit = final-inv, pct = (profit/inv)*100;
        if(pct>=minProfit){
            const maxSize = Math.min(e1.liquidity,e2.liquidity,e3.liquidity)*0.05;
            opps.push({type:'triangular', path:[A,B,C,A], profitPercent:pct, actualProfit:toUsd((maxSize/inv)*profit, A), maxTradeSize:toUsd(maxSize, A), edges:[e1,e2,e3]});
        }
    });
    return opps;
}

function bellmanFord(startCur, maxPath=5){
    const currencies = Object.keys(State.graph);
    if(!currencies.includes(startCur)) return [];
    const mode = document.getElementById('arbMode').value;
    const dist={}, pred={};
    currencies.forEach(c=>{ dist[c]=Infinity; pred[c]=null; });
    dist[startCur]=0;
    for(let i=0;i<Math.min(maxPath-1,currencies.length-1);i++){
        let updated=false;
        for(const u of currencies){
            const nb = State.graph[u]; if(!nb) continue;
            for(const v in nb){
                const w = nb[v].weight;
                if(dist[u]!==Infinity&&dist[u]+w<dist[v]){
                    if(mode==='intra'&&!State.selectedIntraExchanges.has(nb[v].exchange)) continue;
                    dist[v]=dist[u]+w; pred[v]=u; updated=true;
                }
            }
        }
        if(!updated) break;
    }
    const opps=[];
    for(const u of currencies){
        const nb = State.graph[u]; if(!nb) continue;
        for(const v in nb){
            if(dist[u]!==Infinity&&dist[u]+nb[v].weight<dist[v]){
                const cycle = reconstructCycle(v, pred, maxPath);
                if(cycle&&cycle[0]===startCur){
                    const opp = calcCycleOpp(cycle);
                    if(opp) opps.push(opp);
                }
            }
        }
    }
    return opps;
}

function reconstructCycle(start, pred, maxLen){
    const cycle=[start]; let curr=pred[start]; const visited=new Set([start]);
    while(curr&&!visited.has(curr)&&cycle.length<maxLen){ cycle.unshift(curr); visited.add(curr); curr=pred[curr]; }
    if(cycle.length<3) return null;
    for(let i=0;i<cycle.length-1;i++) if(!State.graph[cycle[i]]||!State.graph[cycle[i]][cycle[i+1]]) return null;
    if(!State.graph[cycle[cycle.length-1]]||!State.graph[cycle[cycle.length-1]][cycle[0]]) return null;
    const mode = document.getElementById('arbMode').value;
    if(mode==='intra'){
        const exchanges = new Set();
        for(let i=0;i<cycle.length-1;i++) exchanges.add(State.graph[cycle[i]][cycle[i+1]].exchange);
        exchanges.add(State.graph[cycle[cycle.length-1]][cycle[0]].exchange);
        if(exchanges.size!==1||!State.selectedIntraExchanges.has([...exchanges][0])) return null;
    }
    return cycle;
}

function calcCycleOpp(cycle){
    let amount=1000; const edges=[]; let totalLiq=Infinity;
    for(let i=0;i<cycle.length-1;i++){
        const edge = State.graph[cycle[i]]?.[cycle[i+1]]; if(!edge) return null;
        amount*=edge.rate; edges.push(edge); totalLiq=Math.min(totalLiq,edge.liquidity);
    }
    const lastEdge = State.graph[cycle[cycle.length-1]]?.[cycle[0]]; if(!lastEdge) return null;
    amount*=lastEdge.rate; edges.push(lastEdge); totalLiq=Math.min(totalLiq,lastEdge.liquidity);
    const profit=amount-1000, pct=(profit/1000)*100;
    if(pct>=0.0001&&totalLiq>=50){
        const maxSize=Math.min(...edges.map(e=>e.liquidity))*0.05;
        const startCur = cycle[0];
        return {type:'bellman-ford', path:[...cycle,cycle[0]], profitPercent:pct, actualProfit:toUsd((maxSize/1000)*profit, startCur), maxTradeSize:toUsd(maxSize, startCur), edges};
    }
    return null;
}

// ==================== WEBSOCKET HANDLERS (real‑time tickers) ====================
function handleBinanceWS(e) {
    try {
        const data = JSON.parse(e.data);
        if (!Array.isArray(data)) return;
        data.forEach(t => {
            const sym = t.s;
            const base = sym.replace(/USDT$|BUSD$|USDC$|BTC$|ETH$/,'');
            const target = sym.includes('USDT') ? 'USDT' : sym.includes('BUSD') ? 'BUSD' : 'USD';
            const key = `${base}${target}`.toUpperCase();
            if (!State.wsTickers.binance) State.wsTickers.binance = {};
            State.wsTickers.binance[key] = { bid: parseFloat(t.b), ask: parseFloat(t.a) };
        });
        State.stats.wsBytes += e.data.length;
    } catch(err) {}
}

function handleOKXWS(e) {
    try {
        const msg = JSON.parse(e.data);
        if (!msg.data) return;
        msg.data.forEach(t => {
            const parts = t.instId.split('-');
            if (parts.length !== 2) return;
            const base = parts[0], target = parts[1];
            const key = `${base}${target}`.toUpperCase();
            if (!State.wsTickers.okx) State.wsTickers.okx = {};
            State.wsTickers.okx[key] = { bid: parseFloat(t.bidPx), ask: parseFloat(t.askPx) };
        });
        State.stats.wsBytes += e.data.length;
    } catch(err) {}
}

function handleBybitWS(e) {
    try {
        const msg = JSON.parse(e.data);
        if (!msg.data) return;
        const t = msg.data;
        const parts = (t.symbol || '').replace('USDT','').split('');
        const base = t.symbol.replace('USDT','');
        const key = `${base}USDT`.toUpperCase();
        if (!State.wsTickers.bybit) State.wsTickers.bybit = {};
        State.wsTickers.bybit[key] = { bid: parseFloat(t.bid1Price), ask: parseFloat(t.ask1Price) };
        State.stats.wsBytes += e.data.length;
    } catch(err) {}
}

function handleKrakenWS(e) {
    try {
        const msg = JSON.parse(e.data);
        if (!Array.isArray(msg) || msg.length < 2) return;
        const ticker = msg[1];
        if (ticker && ticker.b && ticker.a) {
            const pair = msg[3]; // like "XBT/USD"
            const parts = pair.split('/');
            const base = parts[0].replace('X','').replace('Z','');
            const key = `${base}${parts[1]}`.toUpperCase();
            if (!State.wsTickers.kraken) State.wsTickers.kraken = {};
            State.wsTickers.kraken[key] = { bid: parseFloat(ticker.b[0]), ask: parseFloat(ticker.a[0]) };
        }
        State.stats.wsBytes += e.data.length;
    } catch(err) {}
}

function handleCoinbaseWS(e) {
    try {
        const msg = JSON.parse(e.data);
        if (msg.type !== 'ticker') return;
        const product = msg.product_id; // "BTC-USD"
        const parts = product.split('-');
        const key = `${parts[0]}${parts[1]}`.toUpperCase();
        if (!State.wsTickers.coinbase) State.wsTickers.coinbase = {};
        State.wsTickers.coinbase[key] = { bid: parseFloat(msg.best_bid), ask: parseFloat(msg.best_ask) };
        State.stats.wsBytes += e.data.length;
    } catch(err) {}
}

function connectAllWebSockets(){
    log('📡 Connecting WebSockets with live ticker cache...');
    try{
        const wsOkx = new WebSocket('wss://ws.okx.com:8443/ws/v5/public');
        wsOkx.onopen = () => wsOkx.send(JSON.stringify({op:'subscribe',args:[{channel:'tickers',instType:'SPOT'}]}));
        wsOkx.onmessage = handleOKXWS;
        State.exchanges.okx.wsStatus = 'live';
    }catch(e){}
    try{
        const wsBin = new WebSocket('wss://stream.binance.com:9443/ws/!ticker@arr');
        wsBin.onmessage = handleBinanceWS;
        State.exchanges.binance.wsStatus = 'live';
    }catch(e){}
    try{
        const wsBybit = new WebSocket('wss://stream.bybit.com/v5/public/spot');
        wsBybit.onopen = () => wsBybit.send(JSON.stringify({op:'subscribe',args:['tickers.BTCUSDT']}));
        wsBybit.onmessage = handleBybitWS;
        State.exchanges.bybit.wsStatus = 'live';
    }catch(e){}
    try{
        const wsKraken = new WebSocket('wss://ws.kraken.com');
        wsKraken.onopen = () => wsKraken.send(JSON.stringify({event:'subscribe',pair:['XBT/USD','ETH/USD'],subscription:{name:'ticker'}}));
        wsKraken.onmessage = handleKrakenWS;
        State.exchanges.kraken.wsStatus = 'live';
    }catch(e){}
    try{
        const wsCoinbase = new WebSocket('wss://ws-feed.exchange.coinbase.com');
        wsCoinbase.onopen = () => wsCoinbase.send(JSON.stringify({type:'subscribe',product_ids:['BTC-USD','ETH-USD'],channels:['ticker']}));
        wsCoinbase.onmessage = handleCoinbaseWS;
        State.exchanges.coinbase.wsStatus = 'live';
    }catch(e){}
    updateExchangeDisplay();
    setInterval(updateStats, 2000);
}

// ==================== SLOT ENGINE ====================
const Engine = {
    async pullSlotLever(){
        if(document.getElementById('scanBtn').disabled){
            log('System not ready. Click INIT first.','error');
            return;
        }
        document.getElementById('slotResult').innerHTML = 'SPINNING...';
        playSpin();
        await runFullScan(true);
        const allOpps = [...State.opportunities.mega, ...State.opportunities.triangular, ...State.opportunities.bellman, ...State.opportunities.suspicious];
        if(allOpps.length>0){
            allOpps.sort((a,b)=>b.profitPercent-a.profitPercent);
            const best = allOpps[0];
            this.animateSlots(best.path.slice(0,3), best);
        }else{
            document.getElementById('slotResult').innerHTML = 'NO PATH FOUND';
        }
    },
    animateSlots(symbols, opp){
        const reels = ['reel1','reel2','reel3'];
        let count=0;
        const interval = setInterval(()=>{
            reels.forEach(r=>document.getElementById(r).innerHTML=`<div>${['SOL','BTC','ETH','DOGE','USDT','BNB','RAY','STRK'][Math.floor(Math.random()*8)]}</div>`);
            if(++count>25){
                clearInterval(interval);
                reels.forEach((r,i)=>document.getElementById(r).innerHTML=`<div>${symbols[i]||'?'}</div>`);
                document.getElementById('slotResult').innerHTML = `WIN! +${opp.profitPercent.toFixed(2)}%`;
                setTimeout(()=>UI.openTradeModal(encodeURIComponent(JSON.stringify(opp))),500);
            }
        },40);
    },
    executeTrade(opp, size, netProfit){
        const isLive = State.liveMode;
        const walletProxy = document.getElementById('walletProxyUrl').value.trim();
        // Estimate gas fee deduction (very rough)
        const ethGas = parseFloat(document.getElementById('ethGasPrice').value) || 25;
        const avgEthTx = parseFloat(document.getElementById('ethTxCost').value) || 0.0015;
        const solFee = parseFloat(document.getElementById('solFee').value) || 0.000005;
        // Simple fee deduction: assume 5 USD per trade in live mode
        let feeDeduction = isLive ? 5 : 0;
        if (isLive) {
            log(`Live mode: deducting estimated $5 fee.`, 'warning');
        }
        const finalProfit = netProfit - feeDeduction;

        if (isLive && walletProxy) {
            // Attempt to sign and broadcast via wallet proxy
            const payload = {
                paths: opp.path,
                amount: size,
                wallet_sol: document.getElementById('solAddress').value,
                wallet_eth: document.getElementById('ethAddress').value,
                fees: {
                    eth_gas_gwei: ethGas,
                    eth_tx_eth: avgEthTx,
                    sol_fee_sol: solFee
                }
            };
            fetch(`${walletProxy}/execute`, {
                method: 'POST',
                headers: {'Content-Type':'application/json'},
                body: JSON.stringify(payload)
            }).then(r=>r.json()).then(res=>{
                log(`🌐 Wallet proxy response: ${JSON.stringify(res)}`, 'success');
                if (res.success) {
                    State.bankroll += finalProfit * 0.9;
                    State.qFund += finalProfit * 0.05;
                    State.lFund += finalProfit * 0.05;
                }
            }).catch(err=>{
                log('Wallet proxy error: '+err.message,'error');
                // Fallback to virtual execution
                State.bankroll += finalProfit * 0.9;
                State.qFund += finalProfit * 0.05;
                State.lFund += finalProfit * 0.05;
            });
        } else {
            // Virtual or live without proxy
            State.bankroll += finalProfit * 0.9;
            State.qFund += finalProfit * 0.05;
            State.lFund += finalProfit * 0.05;
        }
        State.matrix += 10 + Math.floor(size / 100);
        State.level = Math.floor(Math.sqrt(State.matrix / 10)) + 1;
        State.save();
        UI.updateProfile();
        log(`💸 Trade executed: net $${finalProfit.toFixed(2)} profit (fee deducted).`);
        playWin();
        if (finalProfit > 30) confetti(window.innerWidth / 2, 200, 80);
    }
};

// ==================== LIVE SCAN ====================
function toggleLiveScan(){
    if(State.liveScanActive){
        clearInterval(State.liveScanInterval);
        State.liveScanActive = false;
        document.getElementById('liveScanBtn').classList.remove('live');
        document.getElementById('liveScanBtn').textContent = '🔄 LIVE SCAN';
        log('Live scan stopped');
    }else{
        State.liveScanActive = true;
        document.getElementById('liveScanBtn').classList.add('live');
        document.getElementById('liveScanBtn').textContent = '⏸️ STOP LIVE';
        log('Live scan started (30s)');
        runFullScan();
        State.liveScanInterval = setInterval(()=>{
            if(document.getElementById('scanBtn').disabled===false) runFullScan();
        },30000);
    }
}

async function runFullScan(silent=false){
    const depth = parseInt(document.getElementById('pathInput').value)||5;
    if(!silent){ log(`Scanning with depth ${depth}...`); playSpin(); }
    buildGraph(); buildTriangles();
    State.opportunities = {mega:[],triangular:[],bellman:[],suspicious:[]};
    const tri = scanTriangular();
    const bf = [];
    if(!silent || document.getElementById('slotBFToggle')?.checked){
        const basket = document.getElementById('basketInput').value.split(',').map(s=>s.trim().toUpperCase());
        for(const cur of basket) if(State.graph[cur]) bf.push(...bellmanFord(cur, depth));
    }
    const all = [...tri, ...bf];
    all.forEach(opp=>{
        if(opp.profitPercent>10000) State.opportunities.suspicious.push(opp);
        else if(opp.profitPercent>5) State.opportunities.mega.push(opp);
        else if(opp.type==='triangular') State.opportunities.triangular.push(opp);
        else State.opportunities.bellman.push(opp);
    });
    updateStats();
    if(!silent){
        ['megaOpps','triangularOpps','bellmanOpps','suspiciousOpps'].forEach(id=>document.getElementById(id).innerHTML='');
        State.opportunities.mega.forEach(o=>UI.renderOpp(o,'megaOpps',true));
        State.opportunities.triangular.forEach(o=>UI.renderOpp(o,'triangularOpps'));
        State.opportunities.bellman.forEach(o=>UI.renderOpp(o,'bellmanOpps'));
        State.opportunities.suspicious.forEach(o=>UI.renderOpp(o,'suspiciousOpps'));
        updateStatus(`✅ SCAN COMPLETE · ${all.length} opportunities`);
    }
    if(State.opportunities.mega.length>0) confetti(window.innerWidth/2,100,60);
}

function updateStats(){
    document.getElementById('totalPairs').textContent = State.stats.totalPairs;
    document.getElementById('graphNodes').textContent = State.stats.graphNodes;
    document.getElementById('graphEdges').textContent = State.stats.graphEdges;
    document.getElementById('triangleCount').textContent = State.stats.triangleCount;
    document.getElementById('wsBytes').textContent = (State.stats.wsBytes/1024).toFixed(2)+' KB';
    const oppCount = Object.values(State.opportunities).flat().length;
    document.getElementById('oppCount').textContent = oppCount;
    document.getElementById('megaCount').textContent = State.opportunities.mega.length;
    document.getElementById('triangularCount').textContent = State.opportunities.triangular.length;
    document.getElementById('bellmanCount').textContent = State.opportunities.bellman.length;
    document.getElementById('suspiciousCount').textContent = State.opportunities.suspicious.length;
    UI.updateProfile();
}

function updateExchangeDisplay(){
    const container = document.getElementById('exchangeStatus');
    if(!container) return;
    container.innerHTML = '';
    Object.values(State.exchanges).forEach(ex=>{
        let cls = (ex.wsStatus==='live')?'ws':(ex.status==='online')?'online':(ex.type==='info'?'info':'');
        container.innerHTML += `<div class="exchange-status"><div class="indicator ${cls}"></div><div><strong>${ex.name}</strong> ${ex.wsStatus==='live'?'<span style="color:#ff00ff;">LIVE WS</span>':''}<br><small>${ex.status.toUpperCase()} · ${ex.pairs.length} pairs</small></div></div>`;
    });
}

function updateIntraExCheckboxes(){
    const container = document.getElementById('intraExCheckboxes');
    if(!container) return;
    container.innerHTML = '';
    Object.keys(State.exchanges).forEach(key=>{
        const ex = State.exchanges[key];
        if(ex.status!=='online'||ex.type==='info') return;
        const checked = State.selectedIntraExchanges.has(key)?'checked':'';
        container.innerHTML += `<label><input type="checkbox" value="${key}" ${checked} onchange="toggleIntraEx('${key}')"> ${ex.name}</label>`;
    });
    if(State.selectedIntraExchanges.size===0){
        const largest = Object.keys(State.exchanges).filter(k=>State.exchanges[k].status==='online'&&State.exchanges[k].type!=='info').sort((a,b)=>State.exchanges[b].pairs.length-State.exchanges[a].pairs.length)[0];
        if(largest){ State.selectedIntraExchanges.add(largest); updateIntraExCheckboxes(); }
    }
}

function toggleIntraEx(key){ State.selectedIntraExchanges.has(key)?State.selectedIntraExchanges.delete(key):State.selectedIntraExchanges.add(key); }
function selectAllIntra(){ State.selectedIntraExchanges.clear(); Object.keys(State.exchanges).forEach(k=>{if(State.exchanges[k].status==='online'&&State.exchanges[k].type!=='info') State.selectedIntraExchanges.add(k);}); updateIntraExCheckboxes(); }
function deselectAllIntra(){ State.selectedIntraExchanges.clear(); updateIntraExCheckboxes(); }

function syncBetInput(){ document.getElementById('betInput').value = document.getElementById('betSlider').value; }
function syncBetSlider(){ document.getElementById('betSlider').value = document.getElementById('betInput').value; }
function shareJackpot(){ const mega = State.opportunities.mega[0]; if(mega){ navigator.clipboard.writeText(`🎰 ${mega.profitPercent.toFixed(2)}% arb on QuanTM FOAM!`); log('📤 Copied!','success'); } else log('No jackpot to share','warning'); }
function toggleTheme(){ document.body.style.filter = document.body.style.filter==='hue-rotate(180deg)'?'none':'hue-rotate(180deg)'; }

function openCreateCoinModal(){
    if(State.level<5){ alert('Need level 5 to create coins!'); return; }
    document.getElementById('createCoinModal').style.display = 'flex';
}
function closeCreateCoinModal(){ document.getElementById('createCoinModal').style.display = 'none'; }
document.getElementById('createCoinBtn').addEventListener('click',()=>{
    const symbol = document.getElementById('newCoinSymbol').value.trim().toUpperCase();
    const price = parseFloat(document.getElementById('newCoinPrice').value)||0.000001;
    const liq = parseFloat(document.getElementById('newCoinLiq').value)||500;
    if(!symbol) return;
    State.userCoins.push({symbol,price,liq});
    State.allPairs.push({base:symbol, target:'USDT', price, volume:liq*0.3, liquidity:liq, bidPrice:price*0.95, askPrice:price*1.05, exchange:'QUANTM_DEX', exchangeType:'dex'});
    State.stats.totalPairs++;
    State.save();
    closeCreateCoinModal();
    log(`🪙 Created ${symbol} on QUANTM_DEX!`,'success');
    State.matrix += 50;
    State.level = Math.floor(Math.sqrt(State.matrix/10))+1;
    UI.updateProfile();
    buildGraph(); buildTriangles(); displayLowValue(); updateStats();
});

window.addEventListener('load',()=>{
    State.load();
    log('🎰 QuanTM FOAM v22.3 loaded – proxy, live WS, dynamic forex. Click INIT.','success');
    document.getElementById('logs').style.display = 'block';
});
</script>
</body>
</html>
