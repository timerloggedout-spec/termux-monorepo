<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RegimenForge — Build. Track. Validate. Compete.</title>
    <script src="https://unpkg.com/react@18/umd/react.production.min.js" crossorigin>
    </script>
    <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js" crossorigin>
    </script>
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
    <style>
        :root {
            --bg: #06060d;
            --surface: #0e0e1a;
            --surface2: #141428;
            --surface3: #1a1a35;
            --border: rgba(255, 255, 255, 0.06);
            --text: #e0e0e8;
            --text2: #9898b0;
            --text3: #686880;
            --accent: #00c8ff;
            --accent2: #00ff88;
            --warn: #ffb347;
            --danger: #ff4757;
            --purple: #8b5cf6;
            --gradient1: linear-gradient(135deg, #00c8ff, #0068ff);
            --gradient2: linear-gradient(135deg, #00ff88, #00c8a0);
            --gradient3: linear-gradient(135deg, #8b5cf6, #6d28d9);
            --radius: 12px;
            --radius-sm: 8px;
            --transition: 0.2s ease;
        }
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            background: var(--bg);
            color: var(--text);
            font-family: 'Inter', 'Segoe UI', system-ui, -apple-system, sans-serif;
            line-height: 1.5;
            min-height: 100vh;
            -webkit-font-smoothing: antialiased;
        }
        #root {
            min-height: 100vh;
        }
        /* Scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: transparent;
        }
        ::-webkit-scrollbar-thumb {
            background: var(--surface3);
            border-radius: 3px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #2a2a45;
        }
        /* Animations */
        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(16px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        @keyframes pulse {
            0%,
            100% {
                box-shadow: 0 0 0 0 rgba(0, 200, 255, 0.4);
            }
            50% {
                box-shadow: 0 0 0 12px rgba(0, 200, 255, 0);
            }
        }
        @keyframes glowPulse {
            0%,
            100% {
                filter: brightness(1);
            }
            50% {
                filter: brightness(1.3);
            }
        }
        @keyframes shimmer {
            0% {
                background-position: -200% 0;
            }
            100% {
                background-position: 200% 0;
            }
        }
        @keyframes slideIn {
            from {
                opacity: 0;
                transform: translateX(-20px);
            }
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }
        @keyframes scaleIn {
            from {
                opacity: 0;
                transform: scale(0.9);
            }
            to {
                opacity: 1;
                transform: scale(1);
            }
        }
        .animate-in {
            animation: fadeInUp 0.4s ease forwards;
        }
        .animate-slide {
            animation: slideIn 0.3s ease forwards;
        }
        .animate-scale {
            animation: scaleIn 0.25s ease forwards;
        }
        .stagger-1 {
            animation-delay: 0.05s;
            opacity: 0;
        }
        .stagger-2 {
            animation-delay: 0.1s;
            opacity: 0;
        }
        .stagger-3 {
            animation-delay: 0.15s;
            opacity: 0;
        }
        .stagger-4 {
            animation-delay: 0.2s;
            opacity: 0;
        }
    </style>
</head>
<body>
    <div id="root"></div>

    <script type="text/babel">
        const { useState, useEffect, useRef, useCallback, useMemo } = React;

        // ────────────────────────────────────
        // UTILITIES
        // ────────────────────────────────────
        const uid = () => 'id_' + Math.random().toString(36).slice(2, 10) + '_' + Date.now().toString(36);
        const now = () => new Date().toISOString();
        const fmtDate = (iso) => new Date(iso).toLocaleDateString('en-US', { month: 'short', day: 'numeric',
            year: 'numeric' });
        const fmtDateTime = (iso) => new Date(iso).toLocaleString('en-US', { month: 'short', day: 'numeric',
            hour: '2-digit', minute: '2-digit' });

        const storage = {
            get(key, fallback) {
                try {
                    const v = localStorage.getItem('rf_' + key);
                    return v ? JSON.parse(v) : fallback;
                } catch { return fallback; }
            },
            set(key, val) {
                try { localStorage.setItem('rf_' + key, JSON.stringify(val)); } catch {}
            }
        };

        // ────────────────────────────────────
        // SEED DATA
        // ────────────────────────────────────
        const SEED_REGIMENS = [{
            id: 'reg_001',
            name: 'Hypertrophy Upper/Lower Split',
            author: 'CoachMarcus',
            version: 3,
            forkedFrom: null,
            forkCount: 247,
            rating: 4.8,
            category: 'Bodybuilding',
            tags: ['hypertrophy', 'intermediate', '4-day'],
            createdAt: '2025-11-15T08:00:00Z',
            updatedAt: '2026-04-20T12:00:00Z',
            modules: {
                training: {
                    schedule: 'Upper A / Lower A / Rest / Upper B / Lower B / Rest / Rest',
                    blocks: [
                        { name: 'Upper A - Strength Focus', exercises: [
                                { name: 'Barbell Bench Press', sets: 4, reps: '6-8', rpe: '8-9',
                                    notes: 'Pause at chest' },
                                { name: 'Weighted Pull-ups', sets: 4, reps: '6-8', rpe: '8-9',
                                    notes: 'Full ROM' },
                                { name: 'Standing OHP', sets: 3, reps: '8-10', rpe: '7-8',
                                notes: '' },
                            ] },
                        { name: 'Lower A - Squat Focus', exercises: [
                                { name: 'Barbell Back Squat', sets: 4, reps: '6-8', rpe: '8-9',
                                    notes: 'ATG depth' },
                                { name: 'Romanian Deadlift', sets: 3, reps: '8-10', rpe: '7-8',
                                    notes: '' },
                            ] },
                    ],
                },
                nutrition: {
                    targetCalories: 3200,
                    proteinG: 200,
                    carbsG: 380,
                    fatG: 89,
                    mealTiming: '4 meals + post-workout shake',
                },
                supplements: [
                    { name: 'Creatine Monohydrate', dosage: '5g', timing: 'Daily', brand: 'BulkSupplements' },
                    { name: 'Whey Protein Isolate', dosage: '30g', timing: 'Post-workout', brand: 'Optimum Nutrition' },
                ],
                therapeutics: [],
            },
            changelog: [
                { version: 3, date: '2026-04-20', summary: 'Adjusted upper body volume, added RPE targets' },
                { version: 2, date: '2026-01-10', summary: 'Switched from 3-day to 4-day split' },
                { version: 1, date: '2025-11-15', summary: 'Initial release' },
            ],
        }, {
            id: 'reg_002',
            name: 'Powerlifting Peak Block',
            author: 'IronScientist',
            version: 2,
            forkedFrom: null,
            forkCount: 89,
            rating: 4.9,
            category: 'Powerlifting',
            tags: ['strength', 'advanced', 'peaking', '3-day'],
            createdAt: '2026-01-05T10:00:00Z',
            updatedAt: '2026-03-15T14:00:00Z',
            modules: {
                training: {
                    schedule: 'Squat / Rest / Bench / Rest / Deadlift / Rest / Rest',
                    blocks: [
                        { name: 'Squat Day', exercises: [
                                { name: 'Competition Squat', sets: 5, reps: '1-3', rpe: '9-9.5',
                                    notes: 'Singles at 90%+' },
                                { name: 'Pause Squat', sets: 3, reps: '3-5', rpe: '7-8', notes: '3-sec pause' },
                            ] },
                    ],
                },
                nutrition: { targetCalories: 3800, proteinG: 220, carbsG: 450, fatG: 100,
                mealTiming: '5 meals' },
                supplements: [
                    { name: 'Creatine Monohydrate', dosage: '5g', timing: 'Daily', brand: 'BulkSupplements' },
                    { name: 'Beta-Alanine', dosage: '3.2g', timing: 'Pre-workout', brand: 'Now Foods' },
                ],
                therapeutics: [],
            },
            changelog: [
                { version: 2, date: '2026-03-15', summary: 'Increased intensity, reduced accessory volume' },
                { version: 1, date: '2026-01-05', summary: 'Initial peaking template' },
            ],
        }, {
            id: 'reg_003',
            name: 'Keto Cut + Fasted Cardio',
            author: 'ShredQueen',
            version: 1,
            forkedFrom: null,
            forkCount: 312,
            rating: 4.5,
            category: 'Fat Loss',
            tags: ['keto', 'cutting', 'fasted-cardio', 'beginner-friendly'],
            createdAt: '2026-02-20T09:00:00Z',
            updatedAt: '2026-02-20T09:00:00Z',
            modules: {
                training: { schedule: 'Full Body / Cardio / Full Body / Cardio / Full Body / Active Rest / Rest',
                    blocks: [] },
                nutrition: { targetCalories: 1800, proteinG: 150, carbsG: 25, fatG: 120,
                mealTiming: '2 meals + bone broth' },
                supplements: [
                    { name: 'Electrolyte Complex', dosage: '1 scoop', timing: 'Morning', brand: 'LMNT' },
                    { name: 'MCT Oil', dosage: '15ml', timing: 'Pre-cardio', brand: 'Bulletproof' },
                ],
                therapeutics: [],
            },
            changelog: [{ version: 1, date: '2026-02-20', summary: 'Initial release' }],
        }, ];

        const SEED_LEADERBOARD = [
            { id: 'lb_001', event: 'Bench Press 1RM', athlete: 'IronScientist', metric: 185, unit: 'kg',
                bodyweight: 93, date: '2026-04-15', verified: true, regimenRef: 'reg_002' },
            { id: 'lb_002', event: 'Bench Press 1RM', athlete: 'Atlas_Prime', metric: 177, unit: 'kg',
                bodyweight: 88, date: '2026-05-01', verified: true, regimenRef: 'reg_001' },
            { id: 'lb_003', event: 'Bench Press 1RM', athlete: 'LiftQueen99', metric: 142, unit: 'kg',
                bodyweight: 72, date: '2026-04-28', verified: true, regimenRef: 'reg_001_fork_12' },
            { id: 'lb_004', event: 'Squat 1RM', athlete: 'IronScientist', metric: 240, unit: 'kg', bodyweight: 93,
                date: '2026-03-20', verified: true, regimenRef: 'reg_002' },
            { id: 'lb_005', event: 'Squat 1RM', athlete: 'DeepSquatter', metric: 228, unit: 'kg', bodyweight: 85,
                date: '2026-04-10', verified: true, regimenRef: null },
            { id: 'lb_006', event: 'Deadlift 1RM', athlete: 'IronScientist', metric: 295, unit: 'kg', bodyweight: 93,
                date: '2026-02-14', verified: true, regimenRef: 'reg_002' },
            { id: 'lb_007', event: 'Deadlift 1RM', athlete: 'Atlas_Prime', metric: 272, unit: 'kg', bodyweight: 88,
                date: '2026-05-02', verified: false, regimenRef: 'reg_001' },
        ];

        const SEED_WORKOUTS = [
            { id: 'w_001', regimenVersionId: 'reg_001_v3', regimenName: 'Hypertrophy Upper/Lower Split',
                blockName: 'Upper A - Strength Focus', date: '2026-05-02T07:30:00Z', exercises: [
                    { name: 'Barbell Bench Press', sets: [{ reps: 8, weight: 100 }, { reps: 7, weight: 105 }, { reps: 6,
                            weight: 107.5 }, { reps: 6, weight: 107.5 }], completed: true },
                    { name: 'Weighted Pull-ups', sets: [{ reps: 8, weight: 25 }, { reps: 7, weight: 27.5 }, { reps: 6,
                            weight: 30 }, { reps: 5, weight: 30 }], completed: true },
                ], notes: 'Felt strong. Bench moved well.', adherence: 100 },
            { id: 'w_002', regimenVersionId: 'reg_001_v3', regimenName: 'Hypertrophy Upper/Lower Split',
                blockName: 'Lower A - Squat Focus', date: '2026-05-03T08:00:00Z', exercises: [
                    { name: 'Barbell Back Squat', sets: [{ reps: 8, weight: 130 }, { reps: 7, weight: 135 }, { reps: 6,
                            weight: 140 }, { reps: 5, weight: 142.5 }], completed: true },
                ], notes: 'PR on top set! Depth was solid.', adherence: 100 },
        ];

        const EVENTS_LIST = ['Bench Press 1RM', 'Squat 1RM', 'Deadlift 1RM', 'Overhead Press 1RM',
            'Weighted Pull-up 1RM', 'Total (S/B/D)', 'Wilks Score'
        ];

        // ────────────────────────────────────
        // APP COMPONENT
        // ────────────────────────────────────
        const App = () => {
            const [activeTab, setActiveTab] = useState('dashboard');
            const [regimens, setRegimens] = useState(() => storage.get('regimens', SEED_REGIMENS));
            const [workouts, setWorkouts] = useState(() => storage.get('workouts', SEED_WORKOUTS));
            const [leaderboard, setLeaderboard] = useState(() => storage.get('leaderboard', SEED_LEADERBOARD));
            const [therapeuticLog, setTherapeuticLog] = useState(() => storage.get('therapeutic_log', []));
            const [therapeuticOptIn, setTherapeuticOptIn] = useState(() => storage.get('therapeutic_optin',
            false));
            const [showSafetyGate, setShowSafetyGate] = useState(false);
            const [forkModalRegimen, setForkModalRegimen] = useState(null);
            const [forkName, setForkName] = useState('');
            const [forkNotes, setForkNotes] = useState('');
            const [userPRs, setUserPRs] = useState(() => storage.get('user_prs', {}));
            const [toast, setToast] = useState(null);

            // Persist
            useEffect(() => { storage.set('regimens', regimens); }, [regimens]);
            useEffect(() => { storage.set('workouts', workouts); }, [workouts]);
            useEffect(() => { storage.set('leaderboard', leaderboard); }, [leaderboard]);
            useEffect(() => { storage.set('therapeutic_log', therapeuticLog); }, [therapeuticLog]);
            useEffect(() => { storage.set('therapeutic_optin', therapeuticOptIn); }, [therapeuticOptIn]);
            useEffect(() => { storage.set('user_prs', userPRs); }, [userPRs]);

            const showToast = useCallback((msg, type = 'success') => {
                setToast({ msg, type, id: uid() });
                setTimeout(() => setToast(null), 3000);
            }, []);

            const handleFork = useCallback((regimen) => {
                setForkModalRegimen(regimen);
                setForkName(regimen.name + ' (Fork)');
                setForkNotes('My customized version of ' + regimen.name);
            }, []);

            const confirmFork = useCallback(() => {
                if (!forkModalRegimen || !forkName.trim()) return;
                const newRegimen = {
                    ...JSON.parse(JSON.stringify(forkModalRegimen)),
                    id: uid(),
                    name: forkName.trim(),
                    author: 'You',
                    version: 1,
                    forkedFrom: forkModalRegimen.id,
                    forkCount: 0,
                    rating: null,
                    createdAt: now(),
                    updatedAt: now(),
                    changelog: [{ version: 1, date: now(), summary: forkNotes.trim() ||
                            'Forked from ' + forkModalRegimen.name }],
                };
                setRegimens(prev => [newRegimen, ...prev]);
                setForkModalRegimen(null);
                setForkName('');
                setForkNotes('');
                showToast('🚀 Regimen forked successfully! It\'s now in your stack.', 'success');
            }, [forkModalRegimen, forkName, forkNotes, showToast]);

            const handleLogWorkout = useCallback((workoutData) => {
                const newWorkout = { id: uid(), ...workoutData, date: now() };
                setWorkouts(prev => [newWorkout, ...prev]);
                // Check for PRs
                workoutData.exercises.forEach(ex => {
                    ex.sets.forEach(s => {
                        const key = ex.name + '_' + (s.reps || 1) + 'RM';
                        const prevBest = userPRs[key];
                        if (!prevBest || s.weight > prevBest) {
                            setUserPRs(prev => ({ ...prev, [key]: s.weight }));
                            showToast(`🏆 New PR! ${ex.name}: ${s.weight}kg x${s.reps}`, 'pr');
                        }
                    });
                });
                showToast('✅ Workout logged! Fidelity: ' + (workoutData.adherence || 100) + '%', 'success');
            }, [userPRs, showToast]);

            const handleSubmitToLeaderboard = useCallback((entry) => {
                const newEntry = { id: uid(), ...entry, date: now(), verified: false };
                setLeaderboard(prev => [newEntry, ...prev]);
                showToast('📤 Performance submitted for verification!', 'info');
            }, [showToast]);

            const tabs = [
                { id: 'dashboard', label: '🏠 Dashboard', icon: '📊' },
                { id: 'regimens', label: '🧬 Regimens', icon: '📋' },
                { id: 'mylog', label: '📝 My Log', icon: '🏋️' },
                { id: 'verify', label: '✅ Verify', icon: '🎥' },
                { id: 'compete', label: '🏆 Compete', icon: '⚔️' },
                { id: 'therapeutics', label: '🔬 Therapeutics', icon: '💊' },
            ];

            return ( <
                    div style = {
                        { minHeight: '100vh', display: 'flex', flexDirection: 'column' } } >
                    { /* Toast */ } {
                        toast && ( <
                            div style = {
                                {
                                    position: 'fixed',
                                    top: 20,
                                    right: 20,
                                    zIndex: 1000,
                                    background: toast.type === 'pr' ? 'var(--gradient2)' :
                                        toast.type === 'info' ? 'var(--gradient1)' : 'var(--surface2)',
                                    color: toast.type === 'pr' ? '#000' : '#fff',
                                    padding: '14px 22px',
                                    borderRadius: 'var(--radius)',
                                    fontWeight: 600,
                                    boxShadow: '0 8px 32px rgba(0,0,0,0.5)',
                                    animation: 'scaleIn 0.25s ease',
                                    border: '1px solid var(--border)',
                                    fontSize: '0.9rem',
                                }
                            } > { toast.msg } < /div>
                        )
                    }

                    { /* Header */ } <
                    header style = {
                        {
                            background: 'var(--surface)',
                            borderBottom: '1px solid var(--border)',
                            padding: '0 24px',
                            display: 'flex',
                            alignItems: 'center',
                            justifyContent: 'space-between',
                            flexWrap: 'wrap',
                            gap: 12,
                            position: 'sticky',
                            top: 0,
                            zIndex: 100,
                            backdropFilter: 'blur(20px)',
                        }
                    } >
                    <
                    div style = {
                        { display: 'flex', alignItems: 'center', gap: 12 } } >
                    <
                    span style = {
                        {
                            fontSize: '1.8rem',
                            fontWeight: 800,
                            background: 'var(--gradient1)',
                            WebkitBackgroundClip: 'text',
                            WebkitTextFillColor: 'transparent',
                            letterSpacing: '-0.5px',
                        }
                    } > RegimenForge < /span> <
                    span style = {
                        {
                            fontSize: '0.65rem',
                            background: 'var(--surface3)',
                            padding: '3px 8px',
                            borderRadius: 20,
                            color: 'var(--accent)',
                            fontWeight: 600,
                            letterSpacing: '0.5px',
                        }
                    } > BETA < /span> <
                    /div> <
                    nav style = {
                        { display: 'flex', gap: 2, flexWrap: 'wrap' } } > {
                        tabs.map(t => ( <
                            button key = { t.id }
                            onClick = {
                                () => setActiveTab(t.id) }
                            style = {
                                {
                                    padding: '12px 16px',
                                    background: activeTab === t.id ? 'var(--surface3)' : 'transparent',
                                    border: 'none',
                                    borderRadius: 'var(--radius-sm)',
                                    color: activeTab === t.id ? '#fff' : 'var(--text2)',
                                    cursor: 'pointer',
                                    fontWeight: activeTab === t.id ? 600 : 400,
                                    fontSize: '0.85rem',
                                    transition: 'var(--transition)',
                                    whiteSpace: 'nowrap',
                                }
                            } >
                            { t.label } <
                            /button>
                        ))
                    } <
                    /nav> <
                    /header>

                    { /* Main Content */ } <
                    main style = {
                        { flex: 1, padding: '24px', maxWidth: 1400, margin: '0 auto', width: '100%' } } > {
                        activeTab === 'dashboard' && < Dashboard workouts = { workouts }
                        regimens = { regimens }
                        leaderboard = { leaderboard }
                        userPRs = { userPRs }
                        therapeuticLog = { therapeuticLog }
                        onTabChange = { setActiveTab }
                        />} {
                            activeTab === 'regimens' && < RegimensTab regimens = { regimens }
                            onFork = { handleFork }
                            forkModalRegimen = { forkModalRegimen }
                            forkName = { forkName }
                            setForkName = { setForkName }
                            forkNotes = { forkNotes }
                            setForkNotes = { setForkNotes }
                            onConfirmFork = { confirmFork }
                            onCloseModal = {
                                () => setForkModalRegimen(null) }
                            />} {
                                activeTab === 'mylog' && < MyLogTab workouts = { workouts }
                                regimens = { regimens }
                                onLogWorkout = { handleLogWorkout }
                                userPRs = { userPRs }
                                />} {
                                    activeTab === 'verify' && < VerifyTab leaderboard = { leaderboard }
                                    setLeaderboard = { setLeaderboard }
                                    showToast = { showToast }
                                    />} {
                                        activeTab === 'compete' && < CompeteTab leaderboard = { leaderboard }
                                        userPRs = { userPRs }
                                        onSubmitEntry = { handleSubmitToLeaderboard }
                                        />} {
                                            activeTab === 'therapeutics' && < TherapeuticsTab
                                            therapeuticOptIn = { therapeuticOptIn }
                                            setTherapeuticOptIn = { setTherapeuticOptIn }
                                            therapeuticLog = { therapeuticLog }
                                            setTherapeuticLog = { setTherapeuticLog }
                                            showSafetyGate = { showSafetyGate }
                                            setShowSafetyGate = { setShowSafetyGate }
                                            showToast = { showToast }
                                            />} <
                                            /main>

                                            { /* Footer */ } <
                                            footer style = {
                                                {
                                                    background: 'var(--surface)',
                                                    borderTop: '1px solid var(--border)',
                                                    padding: '16px 24px',
                                                    textAlign: 'center',
                                                    color: 'var(--text3)',
                                                    fontSize: '0.75rem',
                                                }
                                            } >
                                            RegimenForge v0.1 — Build. Track. Validate. Compete. ⚡ All data stored locally. <
                                            /footer> <
                                            /div>
                                        );
                                    };

                                    // ────────────────────────────────────
                                    // DASHBOARD
                                    // ────────────────────────────────────
                                    const Dashboard = ({ workouts, regimens, leaderboard, userPRs, therapeuticLog,
                                        onTabChange }) => {
                                            const totalWorkouts = workouts.length;
                                            const thisWeekWorkouts = workouts.filter(w => {
                                                const d = new Date(w.date);
                                                const now = new Date();
                                                const weekAgo = new Date(now - 7 * 24 * 60 * 60 * 1000);
                                                return d >= weekAgo;
                                            }).length;
                                            const prCount = Object.keys(userPRs).length;
                                            const verifiedEntries = leaderboard.filter(e => e.verified).length;
                                            const myRegimens = regimens.filter(r => r.author === 'You');
                                            const avgAdherence = workouts.length > 0 ?
                                                Math.round(workouts.reduce((a, w) => a + (w.adherence || 100), 0) / workouts.length) :
                                                0;

                                            const statCards = [
                                                { label: 'Total Workouts', value: totalWorkouts, icon: '🏋️',
                                                    color: 'var(--accent)' },
                                                { label: 'This Week', value: thisWeekWorkouts, icon: '📅',
                                                    color: 'var(--accent2)' },
                                                { label: 'Personal Records', value: prCount, icon: '🏆',
                                                color: 'var(--warn)' },
                                                { label: 'Avg Adherence', value: avgAdherence + '%', icon: '🎯',
                                                    color: 'var(--purple)' },
                                                { label: 'My Regimens', value: myRegimens.length, icon: '🧬',
                                                    color: '#ff6b9d' },
                                                { label: 'Verified Entries', value: verifiedEntries, icon: '✅',
                                                    color: 'var(--accent2)' },
                                            ];

                                            return ( <
                                                div style = {
                                                    { animation: 'fadeInUp 0.4s ease' } } >
                                                <
                                                h2 style = {
                                                    { fontSize: '1.5rem', marginBottom: 20, fontWeight: 700 } } > Performance
                                                Command Center < /h2>

                                                { /* Stat Cards */ } <
                                                div style = {
                                                    {
                                                        display: 'grid',
                                                        gridTemplateColumns: 'repeat(auto-fill, minmax(180px, 1fr))',
                                                        gap: 14,
                                                        marginBottom: 28,
                                                    }
                                                } > {
                                                    statCards.map((s, i) => ( <
                                                        div key = { i }
                                                        className = { `animate-in stagger-${i+1}` }
                                                        style = {
                                                            {
                                                                background: 'var(--surface2)',
                                                                border: '1px solid var(--border)',
                                                                borderRadius: 'var(--radius)',
                                                                padding: '18px 20px',
                                                                display: 'flex',
                                                                flexDirection: 'column',
                                                                gap: 6,
                                                                transition: 'var(--transition)',
                                                                cursor: 'default',
                                                            }
                                                        }
                                                        onMouseEnter = {
                                                            (e) => { e.currentTarget.style.borderColor = s
                                                                    .color;
                                                                e.currentTarget.style.transform =
                                                                    'translateY(-2px)';
                                                                e.currentTarget.style.boxShadow =
                                                                    '0 8px 24px rgba(0,0,0,0.3)'; } }
                                                        onMouseLeave = {
                                                            (e) => { e.currentTarget.style.borderColor =
                                                                    'var(--border)';
                                                                e.currentTarget.style.transform = '';
                                                                e.currentTarget.style.boxShadow = ''; } } >
                                                        <
                                                        span style = {
                                                            { fontSize: '1.8rem' } } > { s.icon } < /span> <
                                                        span style = {
                                                            { fontSize: '1.6rem', fontWeight: 700, color: s
                                                                    .color } } > { s.value } < /span> <
                                                        span style = {
                                                            { color: 'var(--text2)', fontSize: '0.8rem' } } > { s
                                                            .label } < /span> <
                                                        /div>
                                                    ))
                                                } <
                                                /div>

                                                { /* Quick Actions */ } <
                                                div style = {
                                                    {
                                                        display: 'grid',
                                                        gridTemplateColumns: 'repeat(auto-fill, minmax(280px, 1fr))',
                                                        gap: 14,
                                                    }
                                                } >
                                                <
                                                div className = "animate-in stagger-3"
                                                style = {
                                                    {
                                                        background: 'var(--surface2)',
                                                        border: '1px solid var(--border)',
                                                        borderRadius: 'var(--radius)',
                                                        padding: 20,
                                                    }
                                                } >
                                                <
                                                h4 style = {
                                                    { marginBottom: 12 } } > ⚡ Quick
                                                Actions < /h4> <
                                                div style = {
                                                    { display: 'flex', flexDirection: 'column', gap: 8 } } >
                                                <
                                                button onClick = {
                                                    () => onTabChange('regimens') }
                                                style = { quickBtnStyle } > 🧬 Browse & Fork
                                                Regimens < /button> <
                                                button onClick = {
                                                    () => onTabChange('mylog') }
                                                style = { quickBtnStyle } > 📝 Log
                                                Today 's Workout</button> <
                                                button onClick = {
                                                    () => onTabChange('compete') }
                                                style = { quickBtnStyle } > 🏆 Submit to
                                                Leaderboard < /button> <
                                                /div> <
                                                /div>

                                                <
                                                div className = "animate-in stagger-4"
                                                style = {
                                                    {
                                                        background: 'var(--surface2)',
                                                        border: '1px solid var(--border)',
                                                        borderRadius: 'var(--radius)',
                                                        padding: 20,
                                                    }
                                                } >
                                                <
                                                h4 style = {
                                                    { marginBottom: 12 } } > 🔥 Recent
                                                Activity < /h4> {
                                                    workouts.slice(0, 4).map((w, i) => ( <
                                                        div key = { i }
                                                        style = {
                                                            {
                                                                padding: '8px 0',
                                                                borderBottom: i < Math.min(3, workouts
                                                                        .length - 1) ?
                                                                    '1px solid var(--border)' : 'none',
                                                                fontSize: '0.85rem',
                                                                color: 'var(--text2)',
                                                            }
                                                        } >
                                                        < strong style = {
                                                            { color: 'var(--text)' } } > { w.blockName } <
                                                        /strong> — {fmtDate(w.date)} <
                                                        span style = {
                                                            { color: 'var(--accent2)', marginLeft: 8 } } >
                                                        { w.adherence || 100 } % adherence < /span> <
                                                        /div>
                                                    ))
                                                } {
                                                    workouts.length === 0 && < p style = {
                                                        { color: 'var(--text3)', fontSize: '0.85rem' } } > No
                                                    workouts logged yet.Start
                                                    logging! < /p>} <
                                                    /div> <
                                                    /div> <
                                                    /div>
                                                );
                                            };

                                            const quickBtnStyle = {
                                                padding: '10px 16px',
                                                background: 'var(--surface3)',
                                                border: '1px solid var(--border)',
                                                borderRadius: 'var(--radius-sm)',
                                                color: '#fff',
                                                cursor: 'pointer',
                                                fontWeight: 500,
                                                fontSize: '0.85rem',
                                                textAlign: 'left',
                                                transition: 'var(--transition)',
                                            };

                                            // ────────────────────────────────────
                                            // REGIMENS TAB
                                            // ────────────────────────────────────
                                            const RegimensTab = ({ regimens, onFork, forkModalRegimen, forkName, setForkName,
                                                forkNotes, setForkNotes, onConfirmFork, onCloseModal }) => {
                                                    const [expandedId, setExpandedId] = useState(null);
                                                    const [filter, setFilter] = useState('all');

                                                    const filtered = filter === 'all' ? regimens : filter === 'mine' ? regimens
                                                        .filter(r => r.author === 'You') : regimens.filter(r => r.category ===
                                                            filter);

                                                    return ( <
                                                        div style = {
                                                            { animation: 'fadeInUp 0.4s ease' } } >
                                                        <
                                                        div style = {
                                                            {
                                                                display: 'flex',
                                                                justifyContent: 'space-between',
                                                                alignItems: 'center',
                                                                flexWrap: 'wrap',
                                                                gap: 12,
                                                                marginBottom: 20,
                                                            }
                                                        } >
                                                        <
                                                        h2 style = {
                                                            { fontSize: '1.5rem', fontWeight: 700 } } > 🧬 Regimen
                                                        Library < /h2> <
                                                        div style = {
                                                            { display: 'flex', gap: 6, flexWrap: 'wrap' } } > {
                                                            ['all', 'Bodybuilding', 'Powerlifting', 'Fat Loss',
                                                                'mine'
                                                            ].map(f => ( <
                                                                button key = { f }
                                                                onClick = {
                                                                    () => setFilter(f) }
                                                                style = {
                                                                    {
                                                                        padding: '7px 14px',
                                                                        background: filter === f ?
                                                                            'var(--surface3)' : 'transparent',
                                                                        border: '1px solid var(--border)',
                                                                        borderRadius: 20,
                                                                        color: filter === f ? '#fff' :
                                                                            'var(--text2)',
                                                                        cursor: 'pointer',
                                                                        fontSize: '0.8rem',
                                                                        fontWeight: filter === f ? 600 : 400,
                                                                        transition: 'var(--transition)',
                                                                    }
                                                                } >
                                                                { f === 'all' ? 'All' : f === 'mine' ? '👤 My Forks' :
                                                                    f } <
                                                                /button>
                                                            ))
                                                        } <
                                                        /div> <
                                                        /div>

                                                        <
                                                        div style = {
                                                            {
                                                                display: 'grid',
                                                                gridTemplateColumns: 'repeat(auto-fill, minmax(340px, 1fr))',
                                                                gap: 14,
                                                            }
                                                        } > {
                                                            filtered.map((r, i) => ( <
                                                                div key = { r.id }
                                                                className = "animate-in"
                                                                style = {
                                                                    {
                                                                        animationDelay: `${i*0.06}s`,
                                                                        opacity: 0,
                                                                        background: 'var(--surface2)',
                                                                        border: '1px solid var(--border)',
                                                                        borderRadius: 'var(--radius)',
                                                                        padding: 20,
                                                                        transition: 'var(--transition)',
                                                                        cursor: 'pointer',
                                                                    }
                                                                }
                                                                onMouseEnter = {
                                                                    (e) => { e.currentTarget.style.borderColor =
                                                                            'var(--accent)';
                                                                        e.currentTarget.style.transform =
                                                                            'translateY(-2px)'; } }
                                                                onMouseLeave = {
                                                                    (e) => { e.currentTarget.style.borderColor =
                                                                            'var(--border)';
                                                                        e.currentTarget.style.transform = ''; } } >
                                                                <
                                                                div style = {
                                                                    { display: 'flex', justifyContent: 'space-between',
                                                                        alignItems: 'flex-start' } } >
                                                                <
                                                                div >
                                                                <
                                                                h3 style = {
                                                                    { fontSize: '1rem', fontWeight: 700,
                                                                        marginBottom: 4 } } > { r.name } <
                                                                /h3> <
                                                                p style = {
                                                                    { color: 'var(--text2)', fontSize: '0.8rem' } } >
                                                                by { r.author } · v { r.version } · { r
                                                                    .category } < /p> <
                                                                /div> {
                                                                    r.forkedFrom && ( <
                                                                        span style = {
                                                                            {
                                                                                fontSize: '0.65rem',
                                                                                background: 'var(--purple)',
                                                                                color: '#fff',
                                                                                padding: '2px 8px',
                                                                                borderRadius: 12,
                                                                                fontWeight: 600,
                                                                            }
                                                                        } > FORKED < /span>
                                                                    )
                                                                } <
                                                                /div>

                                                                <
                                                                div style = {
                                                                    {
                                                                        display: 'flex',
                                                                        gap: 8,
                                                                        marginTop: 12,
                                                                        flexWrap: 'wrap',
                                                                    }
                                                                } > {
                                                                    r.tags.map(t => ( <
                                                                        span key = { t }
                                                                        style = {
                                                                            {
                                                                                background: 'var(--surface3)',
                                                                                padding: '3px 10px',
                                                                                borderRadius: 12,
                                                                                fontSize: '0.7rem',
                                                                                color: 'var(--text2)',
                                                                            }
                                                                        } > { t } < /span>
                                                                    ))
                                                                } <
                                                                /div>

                                                                <
                                                                div style = {
                                                                    {
                                                                        display: 'flex',
                                                                        gap: 8,
                                                                        marginTop: 14,
                                                                        alignItems: 'center',
                                                                    }
                                                                } >
                                                                <
                                                                span style = {
                                                                    { color: 'var(--warn)', fontSize: '0.8rem' } } >
                                                                ⭐ { r.rating || '—' } < /span> <
                                                                span style = {
                                                                    { color: 'var(--text3)', fontSize: '0.8rem' } } >
                                                                🔀 { r.forkCount } forks < /span> <
                                                                /div>

                                                                <
                                                                div style = {
                                                                    {
                                                                        display: 'flex',
                                                                        gap: 8,
                                                                        marginTop: 14,
                                                                        flexWrap: 'wrap',
                                                                    }
                                                                } >
                                                                <
                                                                button onClick = {
                                                                    (e) => { e.stopPropagation();
                                                                        setExpandedId(expandedId === r.id ?
                                                                            null : r.id); } }
                                                                style = {
                                                                    {
                                                                        padding: '8px 14px',
                                                                        background: 'transparent',
                                                                        border: '1px solid var(--border)',
                                                                        borderRadius: 'var(--radius-sm)',
                                                                        color: '#fff',
                                                                        cursor: 'pointer',
                                                                        fontSize: '0.8rem',
                                                                        fontWeight: 500,
                                                                    }
                                                                } >
                                                                { expandedId === r.id ? '📂 Hide Details' :
                                                                    '📋 View Details' } <
                                                                /button> <
                                                                button onClick = {
                                                                    (e) => { e.stopPropagation();
                                                                        onFork(r); } }
                                                                style = {
                                                                    {
                                                                        padding: '8px 16px',
                                                                        background: 'var(--gradient1)',
                                                                        border: 'none',
                                                                        borderRadius: 'var(--radius-sm)',
                                                                        color: '#000',
                                                                        cursor: 'pointer',
                                                                        fontSize: '0.8rem',
                                                                        fontWeight: 700,
                                                                    }
                                                                } >
                                                                🔀 Fork This Regimen <
                                                                /button> <
                                                                /div>

                                                                {
                                                                    expandedId === r.id && ( <
                                                                        div style = {
                                                                            {
                                                                                marginTop: 16,
                                                                                paddingTop: 16,
                                                                                borderTop: '1px solid var(--border)',
                                                                                animation: 'slideIn 0.3s ease',
                                                                            }
                                                                        } >
                                                                        <
                                                                        p style = {
                                                                            { fontWeight: 600, marginBottom: 8,
                                                                                fontSize: '0.85rem' } } >
                                                                        📅 Schedule: < /p> <
                                                                        p style = {
                                                                            { color: 'var(--text2)',
                                                                                fontSize: '0.8rem',
                                                                                marginBottom: 10 } } > { r
                                                                            .modules.training.schedule } <
                                                                        /p> <
                                                                        p style = {
                                                                            { fontWeight: 600, marginBottom: 4,
                                                                                fontSize: '0.85rem' } } > 🍽
                                                                        Nutrition: < /p> <
                                                                        p style = {
                                                                            { color: 'var(--text2)',
                                                                                fontSize: '0.8rem' } } >
                                                                        { r.modules.nutrition.targetCalories }
                                                                        kcal · P: { r.modules.nutrition
                                                                            .proteinG } g C: { r.modules
                                                                            .nutrition.carbsG } g F: { r
                                                                            .modules.nutrition.fatG } g <
                                                                        /p> {
                                                                            r.changelog && ( <
                                                                                div style = {
                                                                                    { marginTop: 10 } } >
                                                                                <
                                                                                p style = {
                                                                                    { fontWeight: 600,
                                                                                        fontSize: '0.8rem',
                                                                                        marginBottom: 4 } } >
                                                                                📝 Changelog: < /p> {
                                                                                    r.changelog.map((c, ci) => ( <
                                                                                        div key = { ci }
                                                                                        style = {
                                                                                            { fontSize: '0.75rem',
                                                                                                color: 'var(--text3)',
                                                                                                padding: '2px 0' } } >
                                                                                        v { c.version }: { c
                                                                                            .summary } <
                                                                                        /div>
                                                                                    ))
                                                                                } <
                                                                                /div>
                                                                            )
                                                                        } <
                                                                        /div>
                                                                    )
                                                                } <
                                                                /div>
                                                            ))
                                                        } <
                                                        /div>

                                                        { /* Fork Modal */ } {
                                                            forkModalRegimen && ( <
                                                                div style = {
                                                                    {
                                                                        position: 'fixed',
                                                                        inset: 0,
                                                                        background: 'rgba(0,0,0,0.7)',
                                                                        display: 'flex',
                                                                        alignItems: 'center',
                                                                        justifyContent: 'center',
                                                                        zIndex: 500,
                                                                        animation: 'fadeInUp 0.2s ease',
                                                                    }
                                                                }
                                                                onClick = { onCloseModal } >
                                                                <
                                                                div style = {
                                                                    {
                                                                        background: 'var(--surface2)',
                                                                        border: '1px solid var(--border)',
                                                                        borderRadius: 'var(--radius)',
                                                                        padding: 28,
                                                                        maxWidth: 480,
                                                                        width: '90%',
                                                                        animation: 'scaleIn 0.25s ease',
                                                                    }
                                                                }
                                                                onClick = {
                                                                    (e) => e.stopPropagation() } >
                                                                <
                                                                h3 style = {
                                                                    { marginBottom: 6 } } > 🔀 Fork Regimen < /h3> <
                                                                p style = {
                                                                    { color: 'var(--text2)', fontSize: '0.85rem',
                                                                        marginBottom: 16 } } >
                                                                Forking "{ forkModalRegimen.name }"
                                                                by { forkModalRegimen.author } <
                                                                /p> <
                                                                label style = {
                                                                    { display: 'block', marginBottom: 4,
                                                                        fontWeight: 600,
                                                                        fontSize: '0.85rem' } } > New Regimen
                                                                Name < /label> <
                                                                input value = { forkName }
                                                                onChange = {
                                                                    (e) => setForkName(e.target.value) }
                                                                style = { inputStyle }
                                                                autoFocus / >
                                                                <
                                                                label style = {
                                                                    {
                                                                        display: 'block',
                                                                        marginBottom: 4,
                                                                        fontWeight: 600,
                                                                        fontSize: '0.85rem',
                                                                        marginTop: 12,
                                                                    }
                                                                } > Fork Notes < /label> <
                                                                textarea value = { forkNotes }
                                                                onChange = {
                                                                    (e) => setForkNotes(e.target.value) }
                                                                style = {
                                                                    { ...inputStyle, minHeight: 70,
                                                                        resize: 'vertical' } }
                                                                /> <
                                                                div style = {
                                                                    { display: 'flex', gap: 10, marginTop: 18,
                                                                        justifyContent: 'flex-end' } } >
                                                                <
                                                                button onClick = { onCloseModal }
                                                                style = {
                                                                    {
                                                                        padding: '10px 20px',
                                                                        background: 'transparent',
                                                                        border: '1px solid var(--border)',
                                                                        borderRadius: 'var(--radius-sm)',
                                                                        color: '#fff',
                                                                        cursor: 'pointer',
                                                                    }
                                                                } > Cancel < /button> <
                                                                button onClick = { onConfirmFork }
                                                                style = {
                                                                    {
                                                                        padding: '10px 22px',
                                                                        background: 'var(--gradient1)',
                                                                        border: 'none',
                                                                        borderRadius: 'var(--radius-sm)',
                                                                        color: '#000',
                                                                        cursor: 'pointer',
                                                                        fontWeight: 700,
                                                                    }
                                                                } > 🔀 Confirm Fork < /button> <
                                                                /div> <
                                                                /div> <
                                                                /div>
                                                            )
                                                        } <
                                                        /div>
                                                    );
                                                };

                                                const inputStyle = {
                                                    width: '100%',
                                                    padding: '10px 14px',
                                                    background: 'var(--surface3)',
                                                    border: '1px solid var(--border)',
                                                    borderRadius: 'var(--radius-sm)',
                                                    color: '#fff',
                                                    fontSize: '0.9rem',
                                                    outline: 'none',
                                                };

                                                // ────────────────────────────────────
                                                // MY LOG TAB
                                                // ────────────────────────────────────
                                                const MyLogTab = ({ workouts, regimens, onLogWorkout, userPRs }) => {
                                                    const [showForm, setShowForm] = useState(false);
                                                    const [selectedRegimen, setSelectedRegimen] = useState('');
                                                    const [selectedBlock, setSelectedBlock] = useState('');
                                                    const [exerciseRows, setExerciseRows] = useState([]);
                                                    const [notes, setNotes] = useState('');
                                                    const [adherence, setAdherence] = useState(100);

                                                    const myRegimens = regimens.filter(r => r.author === 'You');
                                                    const activeRegimen = regimens.find(r => r.id === selectedRegimen);

                                                    const handleRegimenSelect = (regId) => {
                                                        setSelectedRegimen(regId);
                                                        setSelectedBlock('');
                                                        setExerciseRows([]);
                                                        const reg = regimens.find(r => r.id === regId);
                                                        if (reg && reg.modules.training.blocks.length > 0) {
                                                            setSelectedBlock(reg.modules.training.blocks[0].name);
                                                            const exs = reg.modules.training.blocks[0].exercises.map(ex => ({
                                                                name: ex.name,
                                                                sets: [{ reps: parseInt(ex.reps.split('-')[0]) ||
                                                                        8, weight: 0 }],
                                                                targetReps: ex.reps,
                                                                targetRpe: ex.rpe,
                                                            }));
                                                            setExerciseRows(exs);
                                                        }
                                                    };

                                                    const handleBlockSelect = (blockName) => {
                                                        setSelectedBlock(blockName);
                                                        if (activeRegimen) {
                                                            const block = activeRegimen.modules.training.blocks.find(b => b
                                                                .name === blockName);
                                                            if (block) {
                                                                const exs = block.exercises.map(ex => ({
                                                                    name: ex.name,
                                                                    sets: [{ reps: parseInt(ex.reps.split('-')[
                                                                            0]) || 8, weight: 0 }],
                                                                    targetReps: ex.reps,
                                                                    targetRpe: ex.rpe,
                                                                }));
                                                                setExerciseRows(exs);
                                                            }
                                                        }
                                                    };

                                                    const addSet = (exIdx) => {
                                                        setExerciseRows(prev => prev.map((ex, i) => i === exIdx ? { ...ex,
                                                            sets: [...ex.sets, { reps: ex.sets[0]?.reps || 8,
                                                                weight: 0 }] } : ex));
                                                    };

                                                    const updateSet = (exIdx, setIdx, field, value) => {
                                                        setExerciseRows(prev => prev.map((ex, i) => i === exIdx ? { ...ex,
                                                            sets: ex.sets.map((s, j) => j === setIdx ? { ...s,
                                                                [field]: parseFloat(value) || 0 } : s) } :
                                                            ex));
                                                    };

                                                    const handleSubmitLog = () => {
                                                        if (!selectedRegimen || !selectedBlock) return;
                                                        const workoutData = {
                                                            regimenVersionId: selectedRegimen,
                                                            regimenName: activeRegimen?.name || '',
                                                            blockName: selectedBlock,
                                                            exercises: exerciseRows,
                                                            notes,
                                                            adherence,
                                                        };
                                                        onLogWorkout(workoutData);
                                                        setShowForm(false);
                                                        setNotes('');
                                                        setAdherence(100);
                                                    };

                                                    return ( <
                                                        div style = {
                                                            { animation: 'fadeInUp 0.4s ease' } } >
                                                        <
                                                        div style = {
                                                            {
                                                                display: 'flex',
                                                                justifyContent: 'space-between',
                                                                alignItems: 'center',
                                                                flexWrap: 'wrap',
                                                                gap: 12,
                                                                marginBottom: 20,
                                                            }
                                                        } >
                                                        <
                                                        h2 style = {
                                                            { fontSize: '1.5rem', fontWeight: 700 } } > 📝 Workout
                                                        Log < /h2> <
                                                        button onClick = {
                                                            () => setShowForm(!showForm) }
                                                        style = {
                                                            {
                                                                padding: '10px 20px',
                                                                background: 'var(--gradient2)',
                                                                border: 'none',
                                                                borderRadius: 'var(--radius-sm)',
                                                                color: '#000',
                                                                cursor: 'pointer',
                                                                fontWeight: 700,
                                                                fontSize: '0.9rem',
                                                            }
                                                        } >
                                                        { showForm ? '❌ Cancel' : '+ Log New Workout' } <
                                                        /button> <
                                                        /div>

                                                        {
                                                            showForm && ( <
                                                                div style = {
                                                                    {
                                                                        background: 'var(--surface2)',
                                                                        border: '1px solid var(--border)',
                                                                        borderRadius: 'var(--radius)',
                                                                        padding: 24,
                                                                        marginBottom: 24,
                                                                        animation: 'scaleIn 0.25s ease',
                                                                    }
                                                                } >
                                                                <
                                                                h3 style = {
                                                                    { marginBottom: 16 } } > New Workout
                                                                Entry < /h3>

                                                                { /* Regimen Select */ } <
                                                                label style = { labelStyle } > Active
                                                                Regimen < /label> <
                                                                select value = { selectedRegimen }
                                                                onChange = {
                                                                    (e) => handleRegimenSelect(e.target
                                                                        .value) }
                                                                style = { selectStyle } >
                                                                <
                                                                option value = "" > --Select a regimen-- <
                                                                /option> {
                                                                    myRegimens.map(r => ( < option key = { r
                                                                            .id } value = { r.id } > { r.name } (v { r
                                                                            .version }) < /option>))
                                                                } {
                                                                    regimens.filter(r => r.author !== 'You')
                                                                        .map(r => ( < option key = { r.id } value = { r
                                                                                .id } > { r.name } by { r.author } <
                                                                            /option>))
                                                                } <
                                                                /select>

                                                                {
                                                                    activeRegimen && activeRegimen.modules
                                                                    .training.blocks.length > 0 && ( <
                                                                        >
                                                                        <
                                                                        label style = {
                                                                            { ...labelStyle, marginTop: 12 } } >
                                                                        Training Block < /label> <
                                                                        select value = { selectedBlock }
                                                                        onChange = {
                                                                            (e) => handleBlockSelect(e
                                                                                .target.value) }
                                                                        style = { selectStyle } > {
                                                                            activeRegimen.modules.training
                                                                            .blocks.map(b => ( < option key = { b
                                                                                    .name } value = { b
                                                                                    .name } > { b.name } <
                                                                                /option>))
                                                                        } <
                                                                        /select> <
                                                                        />
                                                                    ) }

                                                                {
                                                                    exerciseRows.map((ex, exIdx) => ( <
                                                                        div key = { exIdx }
                                                                        style = {
                                                                            {
                                                                                marginTop: 16,
                                                                                padding: 14,
                                                                                background: 'var(--surface3)',
                                                                                borderRadius: 'var(--radius-sm)',
                                                                            }
                                                                        } >
                                                                        <
                                                                        strong style = {
                                                                            { fontSize: '0.9rem' } } > { ex
                                                                            .name } <
                                                                        /strong> {
                                                                            ex.targetReps && < span style = {
                                                                                { color: 'var(--text3)',
                                                                                    fontSize: '0.75rem',
                                                                                    marginLeft: 8 } } > Target: { ex
                                                                                .targetReps } reps @ RPE { ex
                                                                                .targetRpe } < /span>} <
                                                                        div style = {
                                                                            { marginTop: 8 } } > {
                                                                            ex.sets.map((s, sIdx) => ( <
                                                                                div key = { sIdx }
                                                                                style = {
                                                                                    {
                                                                                        display: 'flex',
                                                                                        gap: 8,
                                                                                        alignItems: 'center',
                                                                                        marginBottom: 6,
                                                                                    }
                                                                                } >
                                                                                <
                                                                                span style = {
                                                                                    { color: 'var(--text3)',
                                                                                        fontSize: '0.8rem',
                                                                                        minWidth: 50 } } > Set { sIdx +
                                                                                    1 } < /span> <
                                                                                input type = "number"
                                                                                placeholder = "Reps"
                                                                                value = { s.reps }
                                                                                onChange = {
                                                                                    (e) => updateSet(exIdx,
                                                                                        sIdx, 'reps', e
                                                                                        .target.value) }
                                                                                style = { smallInputStyle }
                                                                                /> <
                                                                                input type = "number"
                                                                                placeholder = "Weight (kg)"
                                                                                value = { s.weight }
                                                                                onChange = {
                                                                                    (e) => updateSet(exIdx,
                                                                                        sIdx, 'weight', e
                                                                                        .target.value) }
                                                                                style = { smallInputStyle }
                                                                                /> <
                                                                                /div>
                                                                            ))
                                                                        } <
                                                                        button onClick = {
                                                                            () => addSet(exIdx) }
                                                                        style = {
                                                                            {
                                                                                padding: '4px 12px',
                                                                                background: 'transparent',
                                                                                border: '1px dashed var(--border)',
                                                                                borderRadius: 'var(--radius-sm)',
                                                                                color: 'var(--text2)',
                                                                                cursor: 'pointer',
                                                                                fontSize: '0.75rem',
                                                                                marginTop: 4,
                                                                            }
                                                                        } > + Add Set < /button> <
                                                                        /div> <
                                                                        /div>
                                                                    ))
                                                                }

                                                                {
                                                                    exerciseRows.length > 0 && ( <
                                                                        >
                                                                        <
                                                                        label style = {
                                                                            { ...labelStyle, marginTop: 16 } } >
                                                                        Notes < /label> <
                                                                        textarea value = { notes }
                                                                        onChange = {
                                                                            (e) => setNotes(e.target
                                                                                .value) }
                                                                        style = {
                                                                            { ...inputStyle, minHeight: 50,
                                                                                resize: 'vertical' } }
                                                                        /> <
                                                                        label style = {
                                                                            { ...labelStyle, marginTop: 12 } } >
                                                                        Adherence % < /label> <
                                                                        input type = "range"
                                                                        min = "0"
                                                                        max = "100"
                                                                        value = { adherence }
                                                                        onChange = {
                                                                            (e) => setAdherence(parseInt(e
                                                                                .target.value)) }
                                                                        style = {
                                                                            { width: '100%', marginTop: 4 } }
                                                                        /> <
                                                                        span style = {
                                                                            { color: 'var(--accent2)',
                                                                                fontWeight: 700 } } > { adherence }
                                                                        % < /span> <
                                                                        button onClick = { handleSubmitLog }
                                                                        style = {
                                                                            {
                                                                                marginTop: 18,
                                                                                width: '100%',
                                                                                padding: '12px',
                                                                                background: 'var(--gradient2)',
                                                                                border: 'none',
                                                                                borderRadius: 'var(--radius-sm)',
                                                                                color: '#000',
                                                                                cursor: 'pointer',
                                                                                fontWeight: 700,
                                                                                fontSize: '0.95rem',
                                                                            }
                                                                        } >
                                                                        ✅ Log Workout < /button> <
                                                                        />
                                                                    ) } <
                                                                    /div>
                                                                ) }

                                                                { /* Workout History */ } <
                                                                div style = {
                                                                    {
                                                                        display: 'grid',
                                                                        gap: 12,
                                                                    }
                                                                } > {
                                                                    workouts.map((w, i) => ( <
                                                                        div key = { w.id }
                                                                        className = "animate-slide"
                                                                        style = {
                                                                            {
                                                                                animationDelay: `${i*0.04}s`,
                                                                                opacity: 0,
                                                                                background: 'var(--surface2)',
                                                                                border: '1px solid var(--border)',
                                                                                borderRadius: 'var(--radius)',
                                                                                padding: 16,
                                                                            }
                                                                        } >
                                                                        <
                                                                        div style = {
                                                                            {
                                                                                display: 'flex',
                                                                                justifyContent: 'space-between',
                                                                                flexWrap: 'wrap',
                                                                                gap: 8,
                                                                            }
                                                                        } >
                                                                        <
                                                                        strong > { w.blockName } < /strong> <
                                                                        span style = {
                                                                            { color: 'var(--text2)',
                                                                                fontSize: '0.8rem' } } > { fmtDateTime(w
                                                                                .date) } < /span> <
                                                                        /div> <
                                                                        p style = {
                                                                            { color: 'var(--text2)',
                                                                                fontSize: '0.8rem',
                                                                                marginTop: 2 } } > { w
                                                                            .regimenName } < /p> {
                                                                            w.exercises.slice(0, 3).map((ex,
                                                                                ei) => ( <
                                                                                span key = { ei }
                                                                                style = {
                                                                                    {
                                                                                        display: 'inline-block',
                                                                                        background: 'var(--surface3)',
                                                                                        padding: '2px 8px',
                                                                                        borderRadius: 10,
                                                                                        fontSize: '0.7rem',
                                                                                        marginRight: 6,
                                                                                        marginTop: 4,
                                                                                        color: 'var(--text2)',
                                                                                    }
                                                                                } > { ex.name }: { ex.sets
                                                                                    .length } sets < /span>
                                                                            ))
                                                                        } <
                                                                        span style = {
                                                                            {
                                                                                marginLeft: 8,
                                                                                fontSize: '0.75rem',
                                                                                color: 'var(--accent2)',
                                                                                fontWeight: 600,
                                                                            }
                                                                        } > { w.adherence || 100 } % <
                                                                        /span> <
                                                                        /div>
                                                                    ))
                                                                } <
                                                                /div>

                                                                { /* PRs */ } {
                                                                    Object.keys(userPRs).length > 0 && ( <
                                                                        div style = {
                                                                            {
                                                                                marginTop: 28,
                                                                                background: 'var(--surface2)',
                                                                                border: '1px solid var(--border)',
                                                                                borderRadius: 'var(--radius)',
                                                                                padding: 20,
                                                                            }
                                                                        } >
                                                                        <
                                                                        h4 style = {
                                                                            { marginBottom: 12 } } > 🏆 Personal
                                                                        Records < /h4> <
                                                                        div style = {
                                                                            { display: 'flex', flexWrap: 'wrap',
                                                                                gap: 8 } } > {
                                                                            Object.entries(userPRs).map(([key,
                                                                                val], i) => ( <
                                                                                span key = { i }
                                                                                style = {
                                                                                    {
                                                                                        background: 'var(--gradient2)',
                                                                                        padding: '6px 12px',
                                                                                        borderRadius: 20,
                                                                                        color: '#000',
                                                                                        fontWeight: 700,
                                                                                        fontSize: '0.8rem',
                                                                                    }
                                                                                } > { key.replace('_',
                                                                                    ' ×') }: { val } kg <
                                                                                /span>
                                                                            ))
                                                                        } <
                                                                        /div> <
                                                                        /div>
                                                                    )
                                                                } <
                                                                /div>
                                                            );
                                                        };

                                                        const labelStyle = { display: 'block', fontWeight: 600, fontSize: '0.85rem',
                                                            marginBottom: 4 };
                                                        const selectStyle = {
                                                            ...inputStyle,
                                                            appearance: 'none',
                                                            cursor: 'pointer'
                                                        };
                                                        const smallInputStyle = {
                                                            width: 80,
                                                            padding: '6px 10px',
                                                            background: 'var(--surface)',
                                                            border: '1px solid var(--border)',
                                                            borderRadius: 6,
                                                            color: '#fff',
                                                            fontSize: '0.8rem',
                                                            outline: 'none',
                                                        };

                                                        // ────────────────────────────────────
                                                        // VERIFY TAB
                                                        // ────────────────────────────────────
                                                        const VerifyTab = ({ leaderboard, setLeaderboard, showToast }) => {
                                                            const pendingVerifications = leaderboard.filter(e => !e.verified);

                                                            const handleVerify = (entryId) => {
                                                                setLeaderboard(prev => prev.map(e => e.id === entryId ? { ...e,
                                                                    verified: true } : e));
                                                                showToast('✅ Entry verified! Added to official leaderboard.',
                                                                    'success');
                                                            };

                                                            const handleReject = (entryId) => {
                                                                setLeaderboard(prev => prev.filter(e => e.id !== entryId));
                                                                showToast('❌ Entry rejected and removed.', 'info');
                                                            };

                                                            return ( <
                                                                div style = {
                                                                    { animation: 'fadeInUp 0.4s ease' } } >
                                                                <
                                                                h2 style = {
                                                                    { fontSize: '1.5rem', fontWeight: 700,
                                                                        marginBottom: 8 } } > ✅ Verification
                                                                Queue < /h2> <
                                                                p style = {
                                                                    { color: 'var(--text2)', fontSize: '0.85rem',
                                                                        marginBottom: 20 } } >
                                                                Peer-reviewed validation system.ML pose estimation +
                                                                    human review(inspired by speedrun verification). <
                                                                    /p>

                                                                    <
                                                                    div style = {
                                                                        {
                                                                            background: 'var(--surface2)',
                                                                            border: '1px solid var(--accent)',
                                                                            borderRadius: 'var(--radius)',
                                                                            padding: 20,
                                                                            marginBottom: 20,
                                                                        }
                                                                    } >
                                                                    <
                                                                    h4 style = {
                                                                        { marginBottom: 8 } } > 🎥 How It
                                                                    Works < /h4> <
                                                                    ol style = {
                                                                        { color: 'var(--text2)', fontSize: '0.85rem',
                                                                            paddingLeft: 20 } } >
                                                                    <
                                                                    li > Upload workout video to YouTube(
                                                                    unlisted) < /li> <
                                                                    li > Our ML analyzes bar path, ROM, and rep
                                                                    counting < /li> <
                                                                    li > Trusted peer reviewers validate the
                                                                    attempt < /li> <
                                                                    li > Verified entries appear on the official
                                                                    leaderboard < /li> <
                                                                    /ol> <
                                                                    /div>

                                                                    {
                                                                        pendingVerifications.length === 0 ? ( <
                                                                            p style = {
                                                                                { color: 'var(--text3)',
                                                                                    textAlign: 'center',
                                                                                    padding: 30 } } > ✅ All
                                                                            entries verified!Queue is
                                                                            clear. < /p>
                                                                        ) : ( <
                                                                            div style = {
                                                                                { display: 'grid', gap: 10 } } > {
                                                                                pendingVerifications.map(e => ( <
                                                                                    div key = { e.id }
                                                                                    style = {
                                                                                        {
                                                                                            background: 'var(--surface2)',
                                                                                            border: '1px solid var(--warn)',
                                                                                            borderRadius: 'var(--radius)',
                                                                                            padding: 16,
                                                                                            display: 'flex',
                                                                                            justifyContent: 'space-between',
                                                                                            alignItems: 'center',
                                                                                            flexWrap: 'wrap',
                                                                                            gap: 10,
                                                                                        }
                                                                                    } >
                                                                                    <
                                                                                    div >
                                                                                    <
                                                                                    strong > { e.event } <
                                                                                    /strong> — { e.athlete } <
                                                                                    br / >
                                                                                    <
                                                                                    span style = {
                                                                                        { color: 'var(--text2)',
                                                                                            fontSize: '0.8rem' } } > { e
                                                                                            .metric } { e.unit } @ { e
                                                                                            .bodyweight } kg BW · { fmtDate(e
                                                                                            .date) } < /span> <
                                                                                    /div> <
                                                                                    div style = {
                                                                                        { display: 'flex', gap: 8 } } >
                                                                                    <
                                                                                    button onClick = {
                                                                                        () => handleVerify(e
                                                                                            .id) }
                                                                                    style = {
                                                                                        {
                                                                                            padding: '8px 16px',
                                                                                            background: 'var(--gradient2)',
                                                                                            border: 'none',
                                                                                            borderRadius: 'var(--radius-sm)',
                                                                                            color: '#000',
                                                                                            cursor: 'pointer',
                                                                                            fontWeight: 700,
                                                                                            fontSize: '0.8rem',
                                                                                        }
                                                                                    } > ✅ Verify < /button> <
                                                                                    button onClick = {
                                                                                        () => handleReject(e
                                                                                            .id) }
                                                                                    style = {
                                                                                        {
                                                                                            padding: '8px 16px',
                                                                                            background: 'transparent',
                                                                                            border: '1px solid var(--danger)',
                                                                                            borderRadius: 'var(--radius-sm)',
                                                                                            color: 'var(--danger)',
                                                                                            cursor: 'pointer',
                                                                                            fontSize: '0.8rem',
                                                                                        }
                                                                                    } > ❌ Reject < /button> <
                                                                                    /div> <
                                                                                    /div>
                                                                                ))
                                                                            } <
                                                                            /div>
                                                                        ) } <
                                                                        /div>
                                                                    );
                                                                };

                                                                // ────────────────────────────────────
                                                                // COMPETE TAB
                                                                // ────────────────────────────────────
                                                                const CompeteTab = ({ leaderboard, userPRs, onSubmitEntry }) => {
                                                                    const [selectedEvent, setSelectedEvent] = useState('Bench Press 1RM');
                                                                    const [submissionMetric, setSubmissionMetric] = useState('');
                                                                    const [submissionBW, setSubmissionBW] = useState('');
                                                                    const [submissionAthlete, setSubmissionAthlete] = useState('You');

                                                                    const filteredLB = leaderboard
                                                                        .filter(e => e.event === selectedEvent && e.verified)
                                                                        .sort((a, b) => b.metric - a.metric);

                                                                    const handleSubmit = () => {
                                                                        if (!submissionMetric || !submissionBW) return;
                                                                        onSubmitEntry({
                                                                            event: selectedEvent,
                                                                            athlete: submissionAthlete || 'You',
                                                                            metric: parseFloat(submissionMetric),
                                                                            unit: 'kg',
                                                                            bodyweight: parseFloat(submissionBW),
                                                                        });
                                                                        setSubmissionMetric('');
                                                                        setSubmissionBW('');
                                                                    };

                                                                    return ( <
                                                                        div style = {
                                                                            { animation: 'fadeInUp 0.4s ease' } } >
                                                                        <
                                                                        h2 style = {
                                                                            { fontSize: '1.5rem', fontWeight: 700,
                                                                                marginBottom: 20 } } > ⚔️ Time - Agnostic
                                                                        Competition < /h2>

                                                                        <
                                                                        div style = {
                                                                            {
                                                                                display: 'grid',
                                                                                gridTemplateColumns: 'repeat(auto-fill, minmax(300px, 1fr))',
                                                                                gap: 16,
                                                                                marginBottom: 28,
                                                                            }
                                                                        } >
                                                                        { /* Submit */ } <
                                                                        div style = {
                                                                            {
                                                                                background: 'var(--surface2)',
                                                                                border: '1px solid var(--border)',
                                                                                borderRadius: 'var(--radius)',
                                                                                padding: 20,
                                                                            }
                                                                        } >
                                                                        <
                                                                        h4 style = {
                                                                            { marginBottom: 12 } } > 📤 Submit New
                                                                        Attempt < /h4> <
                                                                        select value = { selectedEvent }
                                                                        onChange = {
                                                                            (e) => setSelectedEvent(e.target
                                                                                .value) }
                                                                        style = { selectStyle } > {
                                                                            EVENTS_LIST.map(ev => ( < option key = { ev }
                                                                                    value = { ev } > { ev } <
                                                                                /option>))
                                                                        } <
                                                                        /select> <
                                                                        input type = "number"
                                                                        placeholder = "Metric (kg)"
                                                                        value = { submissionMetric }
                                                                        onChange = {
                                                                            (e) => setSubmissionMetric(e.target
                                                                                .value) }
                                                                        style = {
                                                                            { ...inputStyle, marginTop: 10 } }
                                                                        /> <
                                                                        input type = "number"
                                                                        placeholder = "Bodyweight (kg)"
                                                                        value = { submissionBW }
                                                                        onChange = {
                                                                            (e) => setSubmissionBW(e.target
                                                                                .value) }
                                                                        style = {
                                                                            { ...inputStyle, marginTop: 8 } }
                                                                        /> <
                                                                        button onClick = { handleSubmit }
                                                                        style = {
                                                                            {
                                                                                marginTop: 12,
                                                                                width: '100%',
                                                                                padding: '10px',
                                                                                background: 'var(--gradient1)',
                                                                                border: 'none',
                                                                                borderRadius: 'var(--radius-sm)',
                                                                                color: '#000',
                                                                                cursor: 'pointer',
                                                                                fontWeight: 700,
                                                                            }
                                                                        } >
                                                                        🚀 Submit for Verification < /button> <
                                                                        /div>

                                                                        { /* Leaderboard */ } <
                                                                        div style = {
                                                                            {
                                                                                background: 'var(--surface2)',
                                                                                border: '1px solid var(--border)',
                                                                                borderRadius: 'var(--radius)',
                                                                                padding: 20,
                                                                            }
                                                                        } >
                                                                        <
                                                                        h4 style = {
                                                                            { marginBottom: 12 } } > 🏆 { selectedEvent }
                                                                        Leaderboard < /h4> {
                                                                            filteredLB.length === 0 ? ( <
                                                                                p style = {
                                                                                    { color: 'var(--text3)',
                                                                                        fontSize: '0.85rem' } } > No
                                                                                verified entries yet. < /p>
                                                                            ) : (
                                                                                filteredLB.map((e, i) => ( <
                                                                                    div key = { e.id }
                                                                                    style = {
                                                                                        {
                                                                                            display: 'flex',
                                                                                            alignItems: 'center',
                                                                                            gap: 10,
                                                                                            padding: '10px 0',
                                                                                            borderBottom: i < filteredLB
                                                                                                .length - 1 ?
                                                                                                '1px solid var(--border)' :
                                                                                                'none',
                                                                                        }
                                                                                    } >
                                                                                    <
                                                                                    span style = {
                                                                                        {
                                                                                            fontWeight: 800,
                                                                                            fontSize: '1.1rem',
                                                                                            minWidth: 28,
                                                                                            color: i === 0 ?
                                                                                                '#FFD700' : i ===
                                                                                                1 ? '#C0C0C0' : i ===
                                                                                                2 ? '#CD7F32' :
                                                                                                'var(--text2)',
                                                                                        }
                                                                                    } > { i + 1 } <
                                                                                    /span> <
                                                                                    span style = {
                                                                                        { flex: 1,
                                                                                        fontWeight: 600 } } > { e
                                                                                        .athlete } < /span> <
                                                                                    span style = {
                                                                                        { color: 'var(--accent)',
                                                                                            fontWeight: 700 } } > { e
                                                                                            .metric } { e.unit } <
                                                                                    /span> <
                                                                                    span style = {
                                                                                        { color: 'var(--text3)',
                                                                                            fontSize: '0.75rem' } } > @{ e
                                                                                        .bodyweight } kg < /span> <
                                                                                    /div>
                                                                                ))
                                                                            ) } <
                                                                        /div> <
                                                                        /div>

                                                                        {
                                                                            Object.keys(userPRs).length > 0 && ( <
                                                                                div style = {
                                                                                    {
                                                                                        background: 'var(--surface2)',
                                                                                        border: '1px solid var(--accent2)',
                                                                                        borderRadius: 'var(--radius)',
                                                                                        padding: 20,
                                                                                    }
                                                                                } >
                                                                                <
                                                                                h4 style = {
                                                                                    { marginBottom: 8 } } > 🎯 Your PRs vs
                                                                                Leaderboard < /h4> {
                                                                                    Object.entries(userPRs).map(([key, val],
                                                                                        i) => {
                                                                                        const eventName = key.replace(
                                                                                            '_', ' ×') + 'RM';
                                                                                        const best = leaderboard
                                                                                            .filter(e => e.event
                                                                                                .includes(key.split(
                                                                                                    '_')[0]) && e
                                                                                                .verified)
                                                                                            .sort((a, b) => b.metric -
                                                                                                a.metric)[0];
                                                                                        return ( < div key = { i }
                                                                                            style = {
                                                                                                { padding: '6px 0',
                                                                                                    color: 'var(--text2)',
                                                                                                    fontSize: '0.85rem' } } >
                                                                                            { eventName }: < strong style = {
                                                                                                { color: 'var(--accent2)' } } > { val }
                                                                                            kg < /strong> {
                                                                                                best && < span style = {
                                                                                                    { color: 'var(--text3)' } } >
                                                                                                (Leader: { best.metric }
                                                                                                kg by { best.athlete }) <
                                                                                                /span>} <
                                                                                            /div>
                                                                                        );
                                                                                    })
                                                                                } <
                                                                                /div>
                                                                            )
                                                                        } <
                                                                        /div>
                                                                    );
                                                                };

                                                                // ────────────────────────────────────
                                                                // THERAPEUTICS TAB (SAFETY-GATED)
                                                                // ────────────────────────────────────
                                                                const TherapeuticsTab = ({ therapeuticOptIn, setTherapeuticOptIn,
                                                                    therapeuticLog, setTherapeuticLog, showSafetyGate,
                                                                    setShowSafetyGate, showToast }) => {
                                                                        const [substance, setSubstance] = useState('');
                                                                        const [dosage, setDosage] = useState('');
                                                                        const [route, setRoute] = useState('Subcutaneous');
                                                                        const [frequency, setFrequency] = useState('');
                                                                        const [bloodMarkers, setBloodMarkers] = useState(
                                                                            '');
                                                                        const [notes, setNotes] = useState('');

                                                                        const handleOptIn = () => {
                                                                            setTherapeuticOptIn(true);
                                                                            setShowSafetyGate(false);
                                                                            showToast(
                                                                                '⚠️ Therapeutics module unlocked. Harm-reduction resources are linked below.',
                                                                                'info');
                                                                        };

                                                                        const handleLogEntry = () => {
                                                                            if (!substance || !dosage) return;
                                                                            const entry = {
                                                                                id: uid(),
                                                                                substance,
                                                                                dosage,
                                                                                route,
                                                                                frequency,
                                                                                bloodMarkers,
                                                                                notes,
                                                                                date: now(),
                                                                            };
                                                                            setTherapeuticLog(prev => [entry, ...prev]);
                                                                            setSubstance('');
                                                                            setDosage('');
                                                                            setFrequency('');
                                                                            setBloodMarkers('');
                                                                            setNotes('');
                                                                            showToast('📋 Therapeutic entry logged. Monitor your biomarkers.',
                                                                                'info');
                                                                        };

                                                                        if (!therapeuticOptIn) {
                                                                            return ( <
                                                                                div style = {
                                                                                    {
                                                                                        animation: 'fadeInUp 0.4s ease',
                                                                                        textAlign: 'center',
                                                                                        paddingTop: 60,
                                                                                    }
                                                                                } >
                                                                                <
                                                                                div style = {
                                                                                    {
                                                                                        maxWidth: 560,
                                                                                        margin: '0 auto',
                                                                                        background: 'var(--surface2)',
                                                                                        border: '2px solid var(--warn)',
                                                                                        borderRadius: 'var(--radius)',
                                                                                        padding: 32,
                                                                                    }
                                                                                } >
                                                                                <
                                                                                span style = {
                                                                                    { fontSize: '3rem' } } > ⚠
                                                                                ️ < /span> <
                                                                                h2 style = {
                                                                                    { marginTop: 12,
                                                                                    marginBottom: 8 } } > Therapeutics
                                                                                Module < /h2> <
                                                                                p style = {
                                                                                    { color: 'var(--text2)',
                                                                                        fontSize: '0.9rem',
                                                                                        lineHeight: 1.6,
                                                                                        marginBottom: 16 } } >
                                                                                This module allows tracking of hormones,
                                                                                    peptides, and other therapeutic
                                                                                substances. < strong > No substances are
                                                                                    sold, prescribed, or endorsed. <
                                                                                /strong> <
                                                                                /p> <
                                                                                ul style = {
                                                                                    {
                                                                                        textAlign: 'left',
                                                                                        color: 'var(--text2)',
                                                                                        fontSize: '0.85rem',
                                                                                        lineHeight: 1.8,
                                                                                        paddingLeft: 20,
                                                                                        marginBottom: 20,
                                                                                    }
                                                                                } >
                                                                                <
                                                                                li > You must be 18 + to access this
                                                                                module. < /li> <
                                                                                li > All entries are encrypted and
                                                                                private. < /li> <
                                                                                li > Harm - reduction resources are
                                                                                mandatory reading. < /li> <
                                                                                li > Blood marker guardrails will
                                                                                flag out - of - range values. < /li> <
                                                                                /ul> <
                                                                                button onClick = {
                                                                                    () => setShowSafetyGate(true) }
                                                                                style = {
                                                                                    {
                                                                                        padding: '14px 28px',
                                                                                        background: 'var(--warn)',
                                                                                        border: 'none',
                                                                                        borderRadius: 'var(--radius)',
                                                                                        color: '#000',
                                                                                        cursor: 'pointer',
                                                                                        fontWeight: 700,
                                                                                        fontSize: '1rem',
                                                                                    }
                                                                                } >
                                                                                I Understand — Access Module <
                                                                                /button> <
                                                                                /div>

                                                                                {
                                                                                    showSafetyGate && ( <
                                                                                        div style = {
                                                                                            {
                                                                                                position: 'fixed',
                                                                                                inset: 0,
                                                                                                background: 'rgba(0,0,0,0.85)',
                                                                                                display: 'flex',
                                                                                                alignItems: 'center',
                                                                                                justifyContent: 'center',
                                                                                                zIndex: 500,
                                                                                            }
                                                                                        } >
                                                                                        <
                                                                                        div style = {
                                                                                            {
                                                                                                background: 'var(--surface2)',
                                                                                                border: '2px solid var(--warn)',
                                                                                                borderRadius: 'var(--radius)',
                                                                                                padding: 28,
                                                                                                maxWidth: 500,
                                                                                                width: '90%',
                                                                                                animation: 'scaleIn 0.25s ease',
                                                                                            }
                                                                                        } >
                                                                                        <
                                                                                        h3 style = {
                                                                                            { color: 'var(--warn)',
                                                                                                marginBottom: 12 } } >
                                                                                        ⚠️ Safety Acknowledgment <
                                                                                        /h3> <
                                                                                        p style = {
                                                                                            { color: 'var(--text2)',
                                                                                                fontSize: '0.85rem',
                                                                                                lineHeight: 1.6,
                                                                                                marginBottom: 16 } } >
                                                                                        I confirm I am 18 + , understand
                                                                                        this is for tracking purposes
                                                                                        only, and I will consult
                                                                                        medical professionals before
                                                                                        using any substance. <
                                                                                        /p> <
                                                                                        div style = {
                                                                                            { display: 'flex',
                                                                                                gap: 10,
                                                                                                justifyContent: 'flex-end' } } >
                                                                                        <
                                                                                        button onClick = {
                                                                                            () => setShowSafetyGate(
                                                                                                false) }
                                                                                        style = {
                                                                                            {
                                                                                                padding: '10px 20px',
                                                                                                background: 'transparent',
                                                                                                border: '1px solid var(--border)',
                                                                                                borderRadius: 'var(--radius-sm)',
                                                                                                color: '#fff',
                                                                                                cursor: 'pointer',
                                                                                            }
                                                                                        } > Cancel < /button> <
                                                                                        button onClick = { handleOptIn }
                                                                                        style = {
                                                                                            {
                                                                                                padding: '10px 22px',
                                                                                                background: 'var(--warn)',
                                                                                                border: 'none',
                                                                                                borderRadius: 'var(--radius-sm)',
                                                                                                color: '#000',
                                                                                                cursor: 'pointer',
                                                                                                fontWeight: 700,
                                                                                            }
                                                                                        } > ✅ I Acknowledge &
                                                                                        Proceed < /button> <
                                                                                        /div> <
                                                                                        /div> <
                                                                                        /div>
                                                                                    )
                                                                                } <
                                                                                /div>
                                                                            );
                                                                        }

                                                                        return ( <
                                                                            div style = {
                                                                                { animation: 'fadeInUp 0.4s ease' } } >
                                                                            <
                                                                            div style = {
                                                                                {
                                                                                    background: 'var(--warn)',
                                                                                    color: '#000',
                                                                                    padding: '10px 16px',
                                                                                    borderRadius: 'var(--radius-sm)',
                                                                                    fontWeight: 700,
                                                                                    fontSize: '0.85rem',
                                                                                    marginBottom: 20,
                                                                                    display: 'flex',
                                                                                    alignItems: 'center',
                                                                                    gap: 8,
                                                                                }
                                                                            } >
                                                                            ⚠️ Harm - Reduction Active: All data is
                                                                            private & encrypted.Nothing here is medical
                                                                            advice. <
                                                                            /div>

                                                                            <
                                                                            div style = {
                                                                                {
                                                                                    display: 'grid',
                                                                                    gridTemplateColumns: 'repeat(auto-fill, minmax(320px, 1fr))',
                                                                                    gap: 16,
                                                                                }
                                                                            } >
                                                                            <
                                                                            div style = {
                                                                                {
                                                                                    background: 'var(--surface2)',
                                                                                    border: '1px solid var(--border)',
                                                                                    borderRadius: 'var(--radius)',
                                                                                    padding: 20,
                                                                                }
                                                                            } >
                                                                            <
                                                                            h4 style = {
                                                                                { marginBottom: 14 } } > 📋 Log
                                                                            Substance < /h4> <
                                                                            input placeholder = "Substance name"
                                                                            value = { substance }
                                                                            onChange = {
                                                                                (e) => setSubstance(e.target
                                                                                    .value) }
                                                                            style = { inputStyle }
                                                                            /> <
                                                                            input placeholder = "Dosage (e.g., 5mg)"
                                                                            value = { dosage }
                                                                            onChange = {
                                                                                (e) => setDosage(e.target.value) }
                                                                            style = {
                                                                                { ...inputStyle, marginTop: 8 } }
                                                                            /> <
                                                                            select value = { route }
                                                                            onChange = {
                                                                                (e) => setRoute(e.target.value) }
                                                                            style = {
                                                                                { ...selectStyle, marginTop: 8 } } >
                                                                            <
                                                                            option > Subcutaneous < /option> <
                                                                            option > Intramuscular < /option> <
                                                                            option > Oral < /option> <
                                                                            option > Transdermal < /option> <
                                                                            option > Intravenous < /option> <
                                                                            /select> <
                                                                            input placeholder = "Frequency (e.g., EOD, 2x/week)"
                                                                            value = { frequency }
                                                                            onChange = {
                                                                                (e) => setFrequency(e.target
                                                                                    .value) }
                                                                            style = {
                                                                                { ...inputStyle, marginTop: 8 } }
                                                                            /> <
                                                                            input placeholder = "Blood markers to monitor (e.g., ALT, E2, HDL)"
                                                                            value = { bloodMarkers }
                                                                            onChange = {
                                                                                (e) => setBloodMarkers(e.target
                                                                                    .value) }
                                                                            style = {
                                                                                { ...inputStyle, marginTop: 8 } }
                                                                            /> <
                                                                            textarea placeholder = "Notes / side effects / observations"
                                                                            value = { notes }
                                                                            onChange = {
                                                                                (e) => setNotes(e.target.value) }
                                                                            style = {
                                                                                {
                                                                                    ...inputStyle,
                                                                                    marginTop: 8,
                                                                                    minHeight: 60,
                                                                                    resize: 'vertical',
                                                                                }
                                                                            }
                                                                            /> <
                                                                            button onClick = { handleLogEntry }
                                                                            style = {
                                                                                {
                                                                                    marginTop: 14,
                                                                                    width: '100%',
                                                                                    padding: '10px',
                                                                                    background: 'var(--surface3)',
                                                                                    border: '1px solid var(--warn)',
                                                                                    borderRadius: 'var(--radius-sm)',
                                                                                    color: '#fff',
                                                                                    cursor: 'pointer',
                                                                                    fontWeight: 600,
                                                                                }
                                                                            } >
                                                                            📋 Log Entry(Private) < /button> <
                                                                            /div>

                                                                            <
                                                                            div style = {
                                                                                {
                                                                                    background: 'var(--surface2)',
                                                                                    border: '1px solid var(--border)',
                                                                                    borderRadius: 'var(--radius)',
                                                                                    padding: 20,
                                                                                }
                                                                            } >
                                                                            <
                                                                            h4 style = {
                                                                                { marginBottom: 14 } } > 📊 Biomarker
                                                                            Guardrails < /h4> <
                                                                            div style = {
                                                                                {
                                                                                    background: 'var(--surface3)',
                                                                                    padding: 14,
                                                                                    borderRadius: 'var(--radius-sm)',
                                                                                    fontSize: '0.8rem',
                                                                                    color: 'var(--text2)',
                                                                                    lineHeight: 1.7,
                                                                                }
                                                                            } >
                                                                            <
                                                                            p > 🔴 < strong > Critical markers to
                                                                                monitor: < /strong></p >
                                                                            <
                                                                            p > • Liver: ALT, AST, GGT < br / >
                                                                            • Lipids: HDL, LDL, Triglycerides <
                                                                            br / >
                                                                            • Hormones: Total T, Free T, E2,
                                                                            SHBG < br / >
                                                                            • Kidney: Creatinine, eGFR < br / >
                                                                            • Inflammation: CRP, HS - CRP < /p> <
                                                                            /div> <
                                                                            p style = {
                                                                                {
                                                                                    marginTop: 12,
                                                                                    fontSize: '0.8rem',
                                                                                    color: 'var(--warn)',
                                                                                    fontWeight: 600,
                                                                                }
                                                                            } >
                                                                            ⚠️ Out - of - range values trigger
                                                                            automatic alerts. < /p> <
                                                                            /div> <
                                                                            /div>

                                                                            { /* Log History */ } {
                                                                                therapeuticLog.length > 0 && ( <
                                                                                    div style = {
                                                                                        { marginTop: 24 } } >
                                                                                    <
                                                                                    h4 style = {
                                                                                        { marginBottom: 12 } } > 📜
                                                                                    Private Log History < /h4> <
                                                                                    div style = {
                                                                                        { display: 'grid', gap: 8 } } > {
                                                                                        therapeuticLog.map(e => ( <
                                                                                            div key = { e.id }
                                                                                            style = {
                                                                                                {
                                                                                                    background: 'var(--surface2)',
                                                                                                    border: '1px solid var(--border)',
                                                                                                    borderRadius: 'var(--radius-sm)',
                                                                                                    padding: 14,
                                                                                                    fontSize: '0.85rem',
                                                                                                }
                                                                                            } >
                                                                                            <
                                                                                            strong > { e.substance } <
                                                                                            /strong> — { e.dosage } { e
                                                                                                .route } · { e.frequency } <
                                                                                            br / >
                                                                                            <
                                                                                            span style = {
                                                                                                { color: 'var(--text3)',
                                                                                                    fontSize: '0.75rem' } } >
                                                                                            { fmtDateTime(e.date) } {
                                                                                                e.bloodMarkers &&
                                                                                                '· Markers: ' + e
                                                                                                .bloodMarkers } {
                                                                                                e.notes && '· ' + e
                                                                                                .notes } < /span> <
                                                                                            /div>
                                                                                        ))
                                                                                    } <
                                                                                    /div> <
                                                                                    /div>
                                                                                ) } <
                                                                                /div>
                                                                            );
                                                                        };

                                                                        // ────────────────────────────────────
                                                                        // RENDER
                                                                        // ────────────────────────────────────
                                                                        const root = ReactDOM.createRoot(document.getElementById('root'));
                                                                        root.render( < App / > );
    </script>
</body>
</html>
