            'PEPE', 'FLOKI', 'WIN', 'SATS', 'NEIRO', 'CAT', 'DUCK', 'BOME', 'OMI', 'DEGEN', 'NOT', 'MEME', 'TOSHI',
            'MEW', 'HMSTR', 'XCHNG', 'WBNB', 'RNDR', 'LINK', 'JITOSOL', 'LINEA', 'HYPE', 'PNUT', 'POL', 'TRUMP',
            'POPCAT', 'CTX', 'JUP', 'GALA', 'FTM', 'FET', 'SAND', 'GRT', 'CRV', 'XRP', 'LTC', 'XTZ', 'SUI', 'XCH',
            'AVAX', 'WIF', 'UNI', 'FIL', 'STX', 'OP', 'TON', 'LINK', 'LPT', 'ENS', 'WLFI', 'ZEC', 'PENGU', 'APE',
            'GOAT', 'MOODENG', 'MANA', 'INJ', 'ATOM', 'AAVE', 'TRX', 'SKY', 'CHZ', 'SEI', 'ZETA', 'ARB', 'XDC', 'BONK',
            'PEPE', 'SHIB', 'FLR', 'VIRTUAL', 'NEAR', 'ADA', 'HBAR'
        ];
        KNOWN_QUOTES.sort((a, b) => b.length - a.length);

        function parsePairSymbol(rawSymbol) { const s = (rawSymbol || '').toUpperCase().replace(/[^A-Z0-9]/g, ''); if (
                !s) return null; for (const q of KNOWN_QUOTES) { if (s.endsWith(q) && s.length > q.length) { const b = s
                        .slice(0, s.length - q.length); if (b.length >= 1 && b !== q) return { base: b, target: q }; } }
            const p = s.split(/[_-]/); if (p.length >= 2) return { base: p[0], target: p.slice(1).join('_') }; return null; }
        const exchangeDefs = [{ key: 'okx', name: 'OKX', url: 'https://www.okx.com/api/v5/market/tickers?instType=SPOT',
                parser: 'okx' }, { key: 'coinbase', name: 'Coinbase', url: 'https://api.exchange.coinbase.com/products',
                parser: 'coinbase' }, { key: 'binance', name: 'Binance', url: 'https://api.binance.com/api/v3/ticker/24hr',
                parser: 'binance' }, { key: 'kucoin', name: 'KuCoin', url: 'https://api.kucoin.com/api/v1/market/allTickers',
                parser: 'kucoin' }, { key: 'bybit', name: 'Bybit', url: 'https://api.bybit.com/v5/market/tickers?category=spot',
                parser: 'bybit' }, { key: 'gate', name: 'Gate.io', url: 'https://api.gateio.ws/api/v4/spot/tickers',
            parser: 'gate' }, { key: 'mexc', name: 'MEXC', url: 'https://api.mexc.com/api/v3/ticker/24hr', parser: 'mexc' },
            { key: 'kraken', name: 'Kraken', url: 'https://api.kraken.com/0/public/Ticker?pair=ALL', parser: 'kraken' },
            { key: 'bitstamp', name: 'Bitstamp', url: 'https://www.bitstamp.net/api/v2/ticker/', parser: 'bitstamp' },
            { key: 'indodax', name: 'Indodax', url: 'https://indodax.com/api/tickers', parser: 'indodax' }, { key: 'yobit',
                name: 'Yobit', url: 'https://yobit.net/api/3/info', parser: 'yobit' }, { key: 'pumpfun', name: 'Pump.fun',
                url: 'https://frontend-api.pump.fun/coins?offset=0&limit=100&sort=created_timestamp&order=DESC',
                parser: 'pumpfun', auth: true }, { key: 'poloniex', name: 'Poloniex', url: 'https://api.poloniex.com/markets/ticker24h',
                parser: 'poloniex' }, { key: 'huobi', name: 'Huobi', url: 'https://api.huobi.pro/market/tickers',
            parser: 'huobi' }, { key: 'gemini', name: 'Gemini', url: 'https://api.gemini.com/v1/pricefeed', parser: 'gemini' },
            { key: 'ascendex', name: 'AscendEX', url: 'https://ascendex.com/api/pro/v1/ticker', parser: 'ascendex' },
            { key: 'digifinex', name: 'Digifinex', url: 'https://openapi.digifinex.com/v3/ticker', parser: 'digifinex' },
            { key: 'bittrex', name: 'Bittrex', url: 'https://api.bittrex.com/v3/markets/tickers', parser: 'bittrex' },
            { key: 'crypto.com', name: 'Crypto.com', url: 'https://api.crypto.com/v2/public/get-ticker', parser: 'cryptocom' },
            { key: 'dexscreener_eth', name: 'DexScreener ETH', url: 'https://api.dexscreener.com/latest/dex/search?q=ETH',
                parser: 'dexscreener' }, { key: 'dexscreener_bsc', name: 'DexScreener BSC',
                url: 'https://api.dexscreener.com/latest/dex/search?q=BNB', parser: 'dexscreener' },
            { key: 'dexscreener_polygon', name: 'DexScreener Polygon', url: 'https://api.dexscreener.com/latest/dex/search?q=MATIC',
                parser: 'dexscreener' }, { key: 'dexscreener_arb', name: 'DexScreener Arbitrum',
                url: 'https://api.dexscreener.com/latest/dex/search?q=ARB', parser: 'dexscreener' },
            { key: 'dexscreener_sol', name: 'DexScreener Solana', url: 'https://api.dexscreener.com/latest/dex/search?q=SOL',
                parser: 'dexscreener' }, { key: 'coingecko', name: 'CoinGecko',
                url: 'https://api.coingecko.com/api/v3/coins/markets?vs_currency=usd&order=market_cap_desc&per_page=250&page=1',
                parser: 'coingecko' }, { key: 'coinlore', name: 'CoinLore', url: 'https://api.coinlore.net/api/tickers/',
                parser: 'coinlore' }, { key: 'coinpaprika', name: 'CoinPaprika',
            url: 'https://api.coinpaprika.com/v1/tickers', parser: 'coinpaprika' }, { key: 'coincap', name: 'CoinCap',
            url: 'https://api.coincap.io/v2/assets?limit=100', parser: 'coincap' }];
        exchangeDefs.forEach(d => { State.exchanges[d.key] = { name: d.name, status: 'offline', pairs: [], url: d.url,
                parser: d.parser, auth: d.auth || false, wsStatus: 'off' }; });

        function log(msg, type = 'info') { const t = new Date().toLocaleTimeString(); const el = document.getElementById(
                'logs'); if (!el) return; const c = type === 'error' ? '#ff4444' : type === 'success' ? 'var(--green)' :
                'inherit';
            el.innerHTML = `<div style="color:${c}">[${t}] ${msg}</div>` + el.innerHTML; }

        function toggleLogs() { const e = document.getElementById('logs');
            e.style.display = e.style.display === 'none' ? 'block' : 'none'; }

        function toggleSection(id) { const e = document.getElementById(id);
            e.style.display = e.style.display === 'none' ? 'block' : 'none'; }
        // ==================== GRAPH RENDERER (with purchase power) ====================
        class GraphRenderer {
            constructor(canvasId) {
                this.canvas = document.getElementById(canvasId);
                this.ctx = this.canvas.getContext('2d');
                this.nodes = {};
                this.edges = [];
                this.highlightedPath = [];
                this.animPhase = 0;
                this.animRAF = null;
                this.purchasePower = {};
                this.maxPower = 1;
                this.resize();
                window.addEventListener('resize', () => this.resize());
            }
            resize() {
                const rect = this.canvas.parentElement.getBoundingClientRect();
                const w = Math.min(700, rect.width - 30);
                this.canvas.width = w;
                this.canvas.height = Math.min(420, w * 0.6);
            }
            buildFromGraph(graph, allPairs, opportunities, purchasePower) {
                this.nodes = {};
                this.edges = [];
                this.purchasePower = purchasePower || {};
                const seenEdges = new Set();
                const assetLiquidity = {};
                const assetOppCount = {};
                // Determine max purchase power for scaling
                this.maxPower = Math.max(1, ...Object.values(this.purchasePower));
                for (const [base, targets] of Object.entries(graph)) {
                    if (!this.nodes[base]) {
                        this.nodes[base] = { id: base, x: 0, y: 0, liquidity: 0, oppCount: 0, power: this.purchasePower[
                                base] || 0, color: this.getColor(base) };
                    }
                    for (const [target, edge] of Object.entries(targets)) {
                        const ek = [base, target].sort().join('|');
                        if (!seenEdges.has(ek)) {
                            seenEdges.add(ek);
                            this.edges.push({ from: base, to: target, volume: edge.volume || 0, liquidity: edge.liquidity ||
                                    0, rate: edge.rate });
                        }
                        this.nodes[base].liquidity += edge.liquidity || 0;
                        if (!this.nodes[target]) {
                            this.nodes[target] = { id: target, x: 0, y: 0, liquidity: 0, oppCount: 0, power: this
                                    .purchasePower[target] || 0, color: this.getColor(target) };
                        }
                        this.nodes[target].liquidity += edge.liquidity || 0;
                    }
                }
                if (opportunities) {
                    for (const opp of [...(opportunities.mega || []), ...(opportunities.triangular || []), ...(opportunities
                        .bellman || [])]) {
                        for (const node of opp.path) {
                            if (this.nodes[node]) this.nodes[node].oppCount++;
                        }
                    }
                }
                this.forceLayout();
                this.highlightedPath = [];
                if (opportunities) {
                    const all = [...(opportunities.mega || []), ...(opportunities.triangular || []), ...(opportunities
                        .bellman || [])];
                    if (all.length > 0) {
                        all.sort((a, b) => b.profitPercent - a.profitPercent);
                        this.highlightedPath = all[0].path || [];
                    }
                }
                this.startAnimation();
            }
            getColor(id) {
                const colors = ['#ffd700', '#00f0ff', '#ff00ff', '#00ffaa', '#ff8888', '#88ff88', '#ffaa00', '#aa88ff',
                    '#ff4488', '#44ff88'
                ];
                let hash = 0;
                for (let i = 0; i < id.length; i++) hash = ((hash << 5) - hash) + id.charCodeAt(i);
                return colors[Math.abs(hash) % colors.length];
            }
            forceLayout() {
                const nodeList = Object.values(this.nodes);
                const n = nodeList.length;
                if (n === 0) return;
                const cx = this.canvas.width / 2;
                const cy = this.canvas.height / 2;
                const radius = Math.min(cx, cy) * 0.7;
                nodeList.forEach((node, i) => {
                    const angle = (2 * Math.PI * i) / n - Math.PI / 2;
                    node.x = cx + radius * Math.cos(angle);
                    node.y = cy + radius * Math.sin(angle);
                });
                const iterations = Math.min(40, Math.max(15, n));
                for (let iter = 0; iter < iterations; iter++) {
                    for (let i = 0; i < n; i++) {
                        for (let j = i + 1; j < n; j++) {
                            const dx = nodeList[i].x - nodeList[j].x;
                            const dy = nodeList[i].y - nodeList[j].y;
                            const dist = Math.max(1, Math.sqrt(dx * dx + dy * dy));
                            const force = 800 / (dist * dist);
                            const fx = (dx / dist) * force;
                            const fy = (dy / dist) * force;
                            nodeList[i].x += fx;
                            nodeList[i].y += fy;
                            nodeList[j].x -= fx;
                            nodeList[j].y -= fy;
                        }
                    }
                    for (const edge of this.edges) {
                        const from = this.nodes[edge.from];
                        const to = this.nodes[edge.to];
                        if (!from || !to) continue;
                        const dx = to.x - from.x;
                        const dy = to.y - from.y;
                        const dist = Math.max(1, Math.sqrt(dx * dx + dy * dy));
                        const force = dist * 0.002;
                        const fx = (dx / dist) * force;
                        const fy = (dy / dist) * force;
                        from.x += fx;
                        from.y += fy;
                        to.x -= fx;
                        to.y -= fy;
                    }
                    for (const node of nodeList) {
                        node.x += (cx - node.x) * 0.02;
                        node.y += (cy - node.y) * 0.02;
                        node.x = Math.max(20, Math.min(this.canvas.width - 20, node.x));
                        node.y = Math.max(20, Math.min(this.canvas.height - 20, node.y));
                    }
                }
            }
            startAnimation() {
                if (this.animRAF) cancelAnimationFrame(this.animRAF);
                const animate = () => {
                    this.animPhase += 0.03;
                    this.render();
                    this.animRAF = requestAnimationFrame(animate);
                };
                animate();
            }
            render() {
                const ctx = this.ctx;
                const w = this.canvas.width;
                const h = this.canvas.height;
                ctx.clearRect(0, 0, w, h);
                ctx.strokeStyle = 'rgba(255,255,255,0.03)';
                ctx.lineWidth = 1;
                for (let x = 0; x < w; x += 40) { ctx.beginPath();
                    ctx.moveTo(x, 0);
                    ctx.lineTo(x, h);
                    ctx.stroke(); }
                for (let y = 0; y < h; y += 40) { ctx.beginPath();
                    ctx.moveTo(0, y);
                    ctx.lineTo(w, y);
                    ctx.stroke(); }
                const maxVol = Math.max(1, ...this.edges.map(e => e.volume || 0));
                const highlightedSet = new Set();
                if (this.highlightedPath.length > 1) {
                    for (let i = 0; i < this.highlightedPath.length - 1; i++) {
                        highlightedSet.add([this.highlightedPath[i], this.highlightedPath[i + 1]].sort().join('|'));
                    }
                }
                for (const edge of this.edges) {
                    const from = this.nodes[edge.from];
                    const to = this.nodes[edge.to];
                    if (!from || !to) continue;
                    const ek = [edge.from, edge.to].sort().join('|');
                    const isHighlighted = highlightedSet.has(ek);
                    const alpha = Math.max(0.08, Math.min(0.5, (edge.volume || 0) / maxVol));
                    if (isHighlighted) {
                        ctx.strokeStyle = `rgba(255,215,0,${0.6 + 0.4 * Math.sin(this.animPhase * 3)})`;
                        ctx.lineWidth = 2.5;
                        ctx.shadowColor = '#ffd700';
                        ctx.shadowBlur = 8;
                    } else {
                        ctx.strokeStyle = `rgba(0,240,255,${alpha})`;
                        ctx.lineWidth = 1;
                        ctx.shadowBlur = 0;
                    }
                    ctx.beginPath();
                    ctx.moveTo(from.x, from.y);
                    ctx.lineTo(to.x, to.y);
                    ctx.stroke();
                    ctx.shadowBlur = 0;
                }
                for (const node of Object.values(this.nodes)) {
                    const inPath = this.highlightedPath.includes(node.id);
                    // Node size based on purchase power (scaled)
                    const powerRatio = Math.min(1, (node.power || 0) / this.maxPower);
                    const size = 8 + powerRatio * 18;
                    const oppBoost = Math.min(8, (node.oppCount || 0) * 2);
                    const totalSize = size + oppBoost;
                    const glow = ctx.createRadialGradient(node.x, node.y, 0, node.x, node.y, totalSize * 1.8);
                    if (inPath) {
                        glow.addColorStop(0, 'rgba(255,215,0,0.7)');
                        glow.addColorStop(0.5, 'rgba(255,215,0,0.2)');
                        glow.addColorStop(1, 'rgba(255,215,0,0)');
                    } else {
                        glow.addColorStop(0, node.color.replace(')', ',0.5)').replace('rgb', 'rgba'));
                        glow.addColorStop(1, 'rgba(0,0,0,0)');
                    }
                    ctx.fillStyle = glow;
                    ctx.beginPath();
                    ctx.arc(node.x, node.y, totalSize * 1.8, 0, Math.PI * 2);
                    ctx.fill();
                    const bodyGrad = ctx.createRadialGradient(node.x - totalSize * 0.3, node.y - totalSize * 0.3,
                        totalSize * 0.1, node.x, node.y, totalSize);
                    bodyGrad.addColorStop(0, '#ffffff');
                    bodyGrad.addColorStop(0.3, node.color);
                    bodyGrad.addColorStop(1, '#000000');
                    ctx.fillStyle = bodyGrad;
                    ctx.beginPath();
                    ctx.arc(node.x, node.y, totalSize, 0, Math.PI * 2);
                    ctx.fill();
                    ctx.strokeStyle = inPath ? '#ffd700' : 'rgba(255,255,255,0.3)';
                    ctx.lineWidth = inPath ? 2 : 1;
                    ctx.stroke();
                    ctx.fillStyle = '#ffffff';
                    ctx.font = `${Math.max(8, totalSize * 0.55)}px 'Courier New'`;
                    ctx.textAlign = 'center';
                    ctx.fillText(node.id, node.x, node.y + totalSize + 12);
                }
                if (this.highlightedPath.length > 1) {
                    const t = (this.animPhase % 1);
                    const idx = Math.floor(t * (this.highlightedPath.length - 1));
                    const nextIdx = Math.min(idx + 1, this.highlightedPath.length - 1);
                    const from = this.nodes[this.highlightedPath[idx]];
                    const to = this.nodes[this.highlightedPath[nextIdx]];
                    if (from && to) {
                        const frac = (t * (this.highlightedPath.length - 1)) % 1;
                        const px = from.x + (to.x - from.x) * frac;
                        const py = from.y + (to.y - from.y) * frac;
                        ctx.fillStyle = 'rgba(255,255,255,0.9)';
                        ctx.shadowColor = '#ffffff';
                        ctx.shadowBlur = 10;
                        ctx.beginPath();
                        ctx.arc(px, py, 4, 0, Math.PI * 2);
                        ctx.fill();
                        ctx.shadowBlur = 0;
                    }
                }
            }
        }
        // ==================== UI ====================
        const UI = {
            logButton(label) { log(`🖱️ ${label}`); },
            toggleGraphSlot() { const s = document.getElementById('graphSlotContainer');
                s.style.display = s.style.display === 'none' ? 'block' : 'none'; if (s.style.display === 'block' && State
                    .graph && Object.keys(State.graph).length > 0) { if (!State.graphRenderer) { State.graphRenderer =
                            new GraphRenderer('graphNetwork'); }
                    State.computePurchasePower();
                    State.graphRenderer.buildFromGraph(State.graph, State.allPairs, State.opportunities, State
                        .purchasePower); } },
            syncPathInput() {
                const slider = document.getElementById('pathSlider');
                const input = document.getElementById('pathInput');
                input.value = slider.value;
                document.getElementById('slotDepthLabel2').textContent = slider.value;
                State.save();
            },
            syncPathSlider() {
                const slider = document.getElementById('pathSlider');
                const input = document.getElementById('pathInput');
                slider.value = input.value;
                document.getElementById('slotDepthLabel2').textContent = input.value;
                State.save();
            },
            toggleLiveMode() { State.liveMode = document.getElementById('liveToggle').checked;
                State.save();
                log(`🖱️ Live mode: ${State.liveMode?'ON':'OFF'}`); },
            updateProfile() {
                document.getElementById('userLevel').textContent = State.level;
                document.getElementById('matrixScore').textContent = State.matrix;
                const n = Math.pow(State.level, 2) * 10;
                document.getElementById('nextLevelScore').textContent = n;
                document.getElementById('levelProgress').style.width = Math.min(100, (State.matrix / n) * 100) + '%';
                document.getElementById('royalties').textContent = '$' + (State.royalties || 0).toFixed(2);
                document.getElementById('quantumFundVisible').textContent = '$' + (State.qFund || 0).toFixed(2);
                document.getElementById('quantumFundLocked').textContent = '$' + (State.lFund || 0).toFixed(2);
                document.getElementById('bankroll').textContent = '$' + State.bankroll.toFixed(2);
                const pnl = State.bankroll - 10000;
                document.getElementById('pnl').textContent =
                    `$${pnl.toFixed(2)} (${((pnl/10000)*100).toFixed(2)}%)`;
                this.applyLevelConstraints();
                this.renderPerks();
            },
            applyLevelConstraints() {
                // Bet max = level * 2000
                const maxBet = Math.max(100, State.level * 2000);
                document.getElementById('betSlider').max = maxBet;
                document.getElementById('betInput').max = maxBet;
                // Depth max = 3 for level 1-3, 5 for 4-6, 10 for 7+
                let maxDepth = 3;
                if (State.level >= 4 && State.level <= 6) maxDepth = 5;
                else if (State.level >= 7) maxDepth = 10;
                document.getElementById('pathSlider').max = maxDepth;
                document.getElementById('pathInput').max = maxDepth;
                // Bellman-Ford unlock at level 5
                const bellmanCheck = document.getElementById('bellmanToggle');
                if (State.level < 5) {
                    bellmanCheck.disabled = true;
                    bellmanCheck.checked = false;
                    bellmanCheck.parentElement.style.opacity = '0.5';
                } else {
                    bellmanCheck.disabled = false;
                    bellmanCheck.parentElement.style.opacity = '1';
                }
                // Intra exchange limit = level + 2
                // We'll check in toggleIntraEx and selectAllIntra
            },
            renderPerks() {
                const el = document.getElementById('perksList');
                let html = '';
                const perks = [
                    { desc: 'Max Bet', value: `$${Math.max(100, State.level * 2000)}` },
                    { desc: 'Max Depth', value: (State.level < 4 ? '3' : State.level < 7 ? '5' : '10') },
                    { desc: 'Bellman‑Ford', unlocked: State.level >= 5 },
                    { desc: 'Create Coin', unlocked: State.level >= 5 },
                    { desc: 'Intra Exchanges', value: `${State.level + 2}` }
                ];
                for (const p of perks) {
                    if (p.unlocked !== undefined) {
                        html +=
                            `<div class="${p.unlocked ? 'perk-unlocked' : 'perk-locked'}">🔹 ${p.desc}: ${p.unlocked ? '✅ Unlocked' : '🔒 Lvl 5'}</div>`;
                    } else {
                        html += `<div>🔹 ${p.desc}: ${p.value}</div>`;
                    }
                }
                el.innerHTML = html;
            },
            renderOpp(opp, targetId, mega = false) { const c = document.getElementById(targetId); if (!c) return;
                c.innerHTML =
                    `<div class="opportunity ${mega?'mega':''}" onclick="UI.openTradeModal('${encodeURIComponent(JSON.stringify(opp))}')"><strong>+${opp.profitPercent.toFixed(2)}%</strong> ${opp.path.join(' → ')}<br>Max: $${opp.maxTradeSize.toFixed(2)} | Profit: $${opp.actualProfit.toFixed(2)}</div>` +
                    c.innerHTML; },
            openTradeModal(oppStr) { const opp = JSON.parse(decodeURIComponent(oppStr)); const bet = Math.min(opp
                    .maxTradeSize, parseFloat(document.getElementById('betInput').value) || 1000); const sz = bet;
                let rt = sz;
                let ms = `Start: $${sz.toFixed(2)}<br>`;
                const dh = opp.edges.map((e, i) => { const p = rt;
                    rt *= e.rate;
                    ms += `Hop ${i+1}: $${p.toFixed(2)} × ${e.rate.toFixed(6)} → $${rt.toFixed(2)}<br>`; return `<div>${opp.path[i]} → ${opp.path[i+1]} | Liq: $${e.liquidity.toFixed(0)}</div>`; })
                    .join('');
                document.getElementById('tradeDetails').innerHTML =
                    `<p>🔄 ${opp.path.join(' → ')}</p><p>💵 $${sz.toFixed(2)}</p>${dh}`;
                document.getElementById('compoundingMath').innerHTML = ms +
                    `<strong>💰 Final: $${rt.toFixed(2)}</strong>`;
                document.getElementById('executeTradeBtn').onclick = () => { const now = Date.now(); if (now -
                        State.lastTradeExecTime < 4000) { log('⏳ Trade blocked - 4s cooldown', 'warning'); return; }
                    State.lastTradeExecTime = now;
                    UI.logButton('EXECUTE TRADE');
                    closeModal();
                    Engine.executeTrade(opp, sz, rt - sz); };
                document.getElementById('tradeModal').style.display = 'flex'; },
            closeModal() { document.getElementById('tradeModal').style.display = 'none'; },
            renderFiatCheckboxes() { const c = document.getElementById('fiatCheckboxes'); const f = ['RUB', 'INR',
                    'EUR', 'GBP', 'JPY', 'CNY', 'KRW', 'AUD', 'CAD', 'CHF', 'AED', 'TRY', 'BRL', 'SGD', 'PLN'
                ];
                c.innerHTML = f.map(x =>
                    `<label><input type="checkbox" value="${x}" ${State.selectedFiats.has(x)?'checked':''} onchange="UI.toggleFiat('${x}')"> ${x}</label>`
                    ).join(''); },
            toggleFiat(f) { State.selectedFiats.has(f) ? State.selectedFiats.delete(f) : State.selectedFiats.add(f);
                State.save();
                log(`🖱️ Fiat toggle: ${f}`);
                if (!Object.keys(State.forexRates).length && !document.getElementById('scanBtn').disabled)
                    fetchForexRates(); },
            onProxyChange() { const m = document.getElementById('proxySelect').value;
                State.proxyMode = m;
                document.getElementById('corsProxyUrl').style.display = m === 'custom' ? 'inline-block' : 'none';
                this.updateProxyStatus();
                State.save();
                log(`🖱️ Proxy mode: ${m}`); },
            updateProxyStatus() { const e = document.getElementById('proxyStatusMsg'); if (!e) return;
                e.textContent = State.proxyMode === 'direct' ? '⚡ Direct (CORS-safe) + fallback' : State.proxyMode ===
                    'builtin' ? `🔁 Rotating: ${BUILTIN_PROXIES[currentProxyIndex]}` : '📝 Custom proxy'; },
            renderTradeLedger() { const e = document.getElementById('tradeLedger'); if (!e) return; if (!State.tradeLedger
                    .length) { e.innerHTML = 'No trades yet.'; return; }
                e.innerHTML = State.tradeLedger.map(x =>
                    `<div>${x.time.slice(11,19)} ${x.type} ${x.path} <span style="color:${x.profit>=0?'var(--green)':'#ff4444'}">$${x.profit.toFixed(2)}</span></div>`
                    ).join(''); }
        };

        function closeModal() { UI.closeModal(); }

        function saveProxyConfig() { State.proxyMode = document.getElementById('proxySelect').value;
            State.customProxyUrl = document.getElementById('corsProxyUrl').value;
            State.save();
            UI.updateProxyStatus();
            log('🖱️ Proxy config saved'); }
        // ==================== FOREX ====================
        async function fetchForexRates() { const f = [...State.selectedFiats]; if (!f.length) { log(
                    'Forex: No fiats selected', 'warning'); return; }
            const url =
                `https://api.coingecko.com/api/v3/simple/price?ids=bitcoin&vs_currencies=usd,${f.join(',')}`;
            try { const r = await smartFetch(url, {}, true); const d = await r.json(); if (!d.bitcoin?.usd) throw new Error(
                    'Invalid response structure'); const bu = d.bitcoin.usd;
                State.forexRates = {};
                let count = 0;
                f.forEach(x => { if (d.bitcoin[x]) { State.forexRates[x] = bu / d.bitcoin[x];
                        count++; } });
                State.save();
                document.getElementById('forexStatus').textContent = `✅ ${count} rates`;
                log(`Forex: ${count} rates updated`, 'success');
                displayLowValue(); } catch (e) { log('Forex fetch failed: ' + e.message, 'error');
                document.getElementById('forexStatus').textContent = '❌ Failed'; } }

        function getUsdPrice(p) { if (!p) return 0; if (['USDT', 'USD', 'USDC', 'BUSD', 'GUSD'].includes(p.target))
            return p.price; const r = State.forexRates[p.target]; return r ? p.price * r : p.price; }

        function toUsd(a, c) { if (!c || ['USDT', 'USD', 'USDC', 'BUSD', 'GUSD'].includes(c)) return a; const r = State
                .forexRates[c]; return r ? a * r : a; }
        // ==================== API LOADERS ====================
        async function loadApi(defKey) { const ex = State.exchanges[defKey]; const isCors = CORS_OK_EXCHANGES.has(
                defKey); try { let h = {}; if (ex.auth) { const t = document.getElementById('pumpToken').value.trim(); if (
                    t) h = { 'Authorization': 'Bearer ' + t }; } const r = await smartFetch(ex.url, { headers: h },
                isCors); if (!r.ok) throw new Error('HTTP ' + r.status); const d = await r.json(); let pairs = [];
            switch (ex.parser) {
                case 'okx':
                    pairs = (d.data || []).slice(0, 600).map(t => { const p = t.instId.split('-'); if (p.length !==
                            2) return null; const pr = parseFloat(t.last) || 0,
                            v = (parseFloat(t.volCcy24h) || 0) * pr; return { base: p[0], target: p[1],
                            price: pr, volume: v, liquidity: v, bidPrice: parseFloat(t.bidPx) || pr * 0.999,
                            askPrice: parseFloat(t.askPx) || pr * 1.001, exchange: defKey, exchangeType: 'cex' }; })
                        .filter(Boolean);
                    break;
                case 'coinbase':
                    pairs = (Array.isArray(d) ? d : []).slice(0, 300).map(p => { const pr = parseFloat(p.price) ||
                            1,
                            v = (parseFloat(p.volume) || 0) * pr; return { base: p.base_currency,
                            target: p.quote_currency, price: pr, volume: v, liquidity: v,
                            bidPrice: pr * 0.998, askPrice: pr * 1.002, exchange: defKey,
                            exchangeType: 'cex' }; }).filter(p => p.price > 0);
                    break;
                case 'binance':
                    pairs = (Array.isArray(d) ? d : []).slice(0, 600).map(t => { const pr = parseFloat(t
                            .lastPrice) || 0,
                            v = (parseFloat(t.quoteVolume) || 0) * pr; const ps = parsePairSymbol(t.symbol ||
                                ''); if (!ps) return null; return { base: ps.base, target: ps.target,
                            price: pr, volume: v, liquidity: v, bidPrice: parseFloat(t.bidPrice) || pr *
                            0.999, askPrice: parseFloat(t.askPrice) || pr * 1.001, exchange: defKey,
                            exchangeType: 'cex' }; }).filter(p => p && p.price > 0 && p.base && p.base !== p
                        .target);
                    break;
                case 'kucoin':
                    pairs = (d?.data?.ticker || []).slice(0, 500).map(t => { const pr = parseFloat(t.last) || 0,
                            v = (parseFloat(t.volValue) || 0) * pr; const ps = parsePairSymbol(t.symbol ||
                                ''); if (!ps) return null; return { base: ps.base, target: ps.target,
                            price: pr, volume: v, liquidity: v, bidPrice: parseFloat(t.buy) || pr * 0.999,
                            askPrice: parseFloat(t.sell) || pr * 1.001, exchange: defKey,
                        exchangeType: 'cex' }; }).filter(p => p && p.price > 0 && p.base);
                    break;
                case 'kraken':
                    { const result = d?.result || {};
                        pairs = Object.keys(result).slice(0, 300).map(k => { const t = result[k]; const pr =
                                parseFloat(t.c?.[0]) || 0,
                                v = (parseFloat(t.v?.[1]) || 0) * pr; const ps = parsePairSymbol(k); if (!ps)
                                return null; return { base: ps.base, target: ps.target, price: pr,
                                volume: v, liquidity: v, bidPrice: parseFloat(t.b?.[0]) || pr * 0.999,
                                askPrice: parseFloat(t.a?.[0]) || pr * 1.001, exchange: defKey,
                                exchangeType: 'cex' }; }).filter(p => p && p.price > 0); }
                    break;
                case 'bitstamp':
                    pairs = (Array.isArray(d) ? d : []).slice(0, 250).map(t => { const pr = parseFloat(t.last) ||
                            0,
                            v = (parseFloat(t.volume) || 0) * pr; const ps = (t.pair || '').split(
                            '/'); return { base: ps[0] || '', target: ps[1] || 'USD', price: pr,
                            volume: v, liquidity: v, bidPrice: parseFloat(t.bid) || pr * 0.999,
                            askPrice: parseFloat(t.ask) || pr * 1.001, exchange: defKey,
                        exchangeType: 'cex' }; }).filter(p => p.price > 0 && p.base);
                    break;
                case 'gemini':
                    pairs = (Array.isArray(d) ? d : []).map(t => { const ps = parsePairSymbol(t.pair || t.symbol ||
                            ''); if (!ps) return null; const pr = parseFloat(t.price) || 0; return {
                            base: ps.base, target: ps.target, price: pr, volume: 0, liquidity: pr *
                            100000, bidPrice: pr * 0.998, askPrice: pr * 1.002, exchange: defKey,
                            exchangeType: 'cex' }; }).filter(p => p && p.price > 0 && p.base !== p.target && p
                        .liquidity >= 50);
                    break;
                case 'dexscreener':
                    { const raw = d?.pairs || [];
                        pairs = raw.slice(0, 400).map(p => { const pr = parseFloat(p.priceUsd) || 0,
                                liq = p.liquidity?.usd || 0; const sp = liq > 0 ? Math.max(0.003, Math.min(
                                    0.05, 5000 / liq)) : 0.03; return { base: p.baseToken?.symbol ||
                                    '?', target: p.quoteToken?.symbol || 'ETH', price: pr, volume: p
                                    .volume?.h24 || 0, liquidity: liq, bidPrice: pr * (1 - sp / 2),
                                    askPrice: pr * (1 + sp / 2), exchange: defKey,
                            exchangeType: 'dex' }; }).filter(p => p.base !== '?' && p.price > 0); }
                    break;
                case 'coingecko':
                    pairs = (Array.isArray(d) ? d : []).slice(0, 250).map(c => ({ base: (c.symbol || '')
                        .toUpperCase(), target: 'USD', price: c.current_price || 0, volume: c
                        .total_volume || 0, liquidity: c.market_cap || 0, bidPrice: (c.current_price || 0) *
                        0.999, askPrice: (c.current_price || 0) * 1.001, exchange: defKey,
                        exchangeType: 'info' })).filter(p => p.price > 0);
                    break;
                default:
                    pairs = [];
            }
            pairs = pairs.filter(p => p && p.base && p.target && p.base !== p.target && p.price > 0 && p.price < 1e15);
            ex.pairs = pairs;
            ex.status = 'online';
            log(`${ex.name}: ${pairs.length} pairs`, 'success'); } catch (e) { if (defKey === 'pumpfun') { try { const
                    fr = await smartFetch('https://api.dexscreener.com/latest/dex/search?q=SOL', {}, true); const fd =
                    await fr.json();
                    ex.pairs = (fd?.pairs || []).slice(0, 400).map(p => { const pr = parseFloat(p.priceUsd) ||
                            0,
                            liq = p.liquidity?.usd || 0; const sp = liq > 0 ? Math.max(0.003, Math.min(0.05,
                                5000 / liq)) : 0.03; return { base: p.baseToken?.symbol || '?',
                            target: p.quoteToken?.symbol || 'ETH', price: pr, volume: p.volume?.h24 || 0,
                            liquidity: liq, bidPrice: pr * (1 - sp / 2), askPrice: pr * (1 + sp / 2),
                            exchange: 'pumpfun_fallback', exchangeType: 'dex' }; }).filter(p => p.base !== '?' &&
                        p.price > 0);
                    ex.status = 'online';
                    log(`Pump fallback: ${ex.pairs.length}`, 'success'); return; } catch (fb) {} }
            ex.status = 'offline';
            ex.pairs = [];
            log(`${ex.name}: ${e.message}`, 'error'); if (State.proxyMode === 'builtin') rotateProxy(); } }
        async function initSystem() { log('🎰 Initializing exchanges...');
            updateStatus('🔄 LOADING...');
            UI.updateProxyStatus(); await Promise.allSettled(exchangeDefs.map(d => loadApi(d.key)));
            State.allPairs = Object.values(State.exchanges).flatMap(e => e.pairs);
            State.userCoins.forEach(c => State.allPairs.push({ base: c.symbol, target: 'USDT', price: c.price, volume: c
                    .liq * 0.3, liquidity: c.liq, bidPrice: c.price * 0.95, askPrice: c.price * 1.05,
                exchange: 'QUANTM_DEX', exchangeType: 'dex' }));
            State.stats.totalPairs = State.allPairs.length;
            State.computePurchasePower();
            updateIntraExCheckboxes();
            buildGraph();
            buildTriangles();
            displayLowValue();
            updateExchangeDisplay();
            updateStats(); const on = Object.values(State.exchanges).filter(e => e.status === 'online').length; if (
                on > 0) { document.getElementById('scanBtn').disabled = false;
                updateStatus(`✅ READY · ${on} online · ${State.stats.totalPairs} pairs`); } else updateStatus(
                '❌ NO EXCHANGES ONLINE'); if (!Object.keys(State.forexRates).length && State.selectedFiats.size) { log(
                    'Auto‑fetching forex…'); await fetchForexRates(); } if (document.getElementById('graphSlotContainer')
                .style.display === 'block') { if (!State.graphRenderer) State.graphRenderer = new GraphRenderer(
                    'graphNetwork');
                State.graphRenderer.buildFromGraph(State.graph, State.allPairs, State.opportunities, State.purchasePower); }
            UI.applyLevelConstraints(); }

        function updateStatus(m) { document.getElementById('mainStatus').textContent = m; }

        function getGraphPairs() { const m = document.getElementById('arbMode').value; if (m === 'intra') return [...State
                .selectedIntraExchanges].flatMap(k => State.exchanges[k]?.pairs || []); return Object.values(State
                .exchanges).filter(e => e.status === 'online' && e.parser !== 'coingecko' && e.parser !== 'coinlore' &&
                e.parser !== 'coinpaprika').flatMap(e => e.pairs); }

        function applyWsCache(p) { const c = State.wsTickers[p.exchange]; if (c) { const k =
                `${p.base}${p.target}`.toUpperCase(); const t = c[k]; if (t) return { ...p, bidPrice: t.bid || p
                    .bidPrice, askPrice: t.ask || p.askPrice }; } return p; }

        function sanitizeRate(r) { if (!isFinite(r) || r <= 0) return 0; if (r > 1e12) return 1e12; if (r < 1e-15) return
            1e-15; return r; }

        function buildGraph() { State.graph = {}; const pairs = getGraphPairs().map(applyWsCache);
            pairs.forEach(p => { if (p.liquidity < 50) return; if (!p.base || !p.target || p.base === p.target)
                return; if (!State.graph[p.base]) State.graph[p.base] = {}; if (!State.graph[p.target]) State.graph[p
                    .target] = {}; const r1 = sanitizeRate(p.bidPrice),
                    r2 = sanitizeRate(1 / p.askPrice); if (r1 > 0) State.graph[p.base][p.target] = { rate: r1,
                        weight: -Math.log(r1), volume: p.volume, liquidity: p.liquidity, exchange: p.exchange,
                        exchangeType: p.exchangeType }; if (r2 > 0) State.graph[p.target][p.base] = { rate: r2,
                        weight: -Math.log(r2), volume: p.volume, liquidity: p.liquidity, exchange: p.exchange,
                        exchangeType: p.exchangeType }; });
            State.stats.graphNodes = Object.keys(State.graph).length;
            State.stats.graphEdges = Object.values(State.graph).reduce((s, o) => s + Object.keys(o).length, 0); }

        function buildTriangles() { State.triangles = []; const ns = Object.keys(State.graph); const seen = new Set(); for (
                let i = 0; i < Math.min(ns.length, 150); i++) { const A = ns[i]; const nA = Object.keys(State.graph[A] ||
                    {}); for (const B of nA) { const nB = Object.keys(State.graph[B] || {}); for (const C of nB) { if (
                        State.graph[C]?.[A]) { const canon = [A, B, C].sort().join('|'); if (!seen.has(canon)) {
                        seen.add(canon);
                        State.triangles.push([A, B, C]); } } } } }
            State.stats.triangleCount = State.triangles.length; }

        function displayLowValue() { const all = State.allPairs.filter(p => p.price > 0); const fmt = p => { const u =
                getUsdPrice(p).toExponential(4); let t = ''; if (getUsdPrice(p) < 1e-15) t = 'PLANCK'; else if (
                    getUsdPrice(p) < 1e-12) t = 'FEMTO'; else if (getUsdPrice(p) < 1e-9) t = 'PICO'; return `<div>${p.base} $${u} <span class="tier-badge tier-${t.toLowerCase()}">${t}</span></div>`; };
            document.getElementById('picoValue').innerHTML = all.filter(p => getUsdPrice(p) < 1e-9 && getUsdPrice(p) >=
                1e-12).slice(0, 25).map(fmt).join('') || 'None';
            document.getElementById('femtoValue').innerHTML = all.filter(p => getUsdPrice(p) < 1e-12 && getUsdPrice(p) >=
                1e-15).slice(0, 25).map(fmt).join('') || 'None';
            document.getElementById('planckValue').innerHTML = all.filter(p => getUsdPrice(p) < 1e-15).slice(0, 25).map(
                fmt).join('') || 'None'; }

        function scanTriangular(minP = 0.0001) { const opps = [],
                inv = 1000; const mode = document.getElementById('arbMode').value;
            State.triangles.forEach(([A, B, C]) => { const e1 = State.graph[A]?.[B],
                    e2 = State.graph[B]?.[C],
                    e3 = State.graph[C]?.[A]; if (!e1 || !e2 || !e3) return; if (mode === 'intra') { const exs =
                    new Set([e1.exchange, e2.exchange, e3.exchange]); if (exs.size !== 1 || !State
                        .selectedIntraExchanges.has(e1.exchange)) return; } const final = inv * e1.rate * e2.rate *
                    e3.rate,
                    profit = final - inv,
                    pct = (profit / inv) * 100; if (pct >= minP && pct < 50) { const ms = Math.min(e1.liquidity, e2
                        .liquidity, e3.liquidity) * 0.05;
                    opps.push({ type: 'triangular', path: [A, B, C, A], profitPercent: pct, actualProfit: toUsd((
                        ms / inv) * profit, A), maxTradeSize: toUsd(ms, A), edges: [e1, e2, e3] }); } }); return opps; }

        function bellmanFord(start, depth = 5) { const cs = Object.keys(State.graph); if (!cs.includes(start)) return
            []; const mode = document.getElementById('arbMode').value; const dist = {},
                pred = {};
            cs.forEach(c => { dist[c] = Infinity;
                pred[c] = null; });
            dist[start] = 0; for (let i = 0; i < Math.min(depth - 1, cs.length - 1); i++) { let upd = false; for (const u of
                cs) { const nb = State.graph[u]; if (!nb) continue; for (const v in nb) { const w = nb[v].weight; if (
                    dist[u] !== Infinity && dist[u] + w < dist[v]) { if (mode === 'intra' && !State
                    .selectedIntraExchanges.has(nb[v].exchange)) continue;
                    dist[v] = dist[u] + w;
                    pred[v] = u;
                    upd = true; } } } if (!upd) break; } const opps = []; for (const u of cs) { const nb = State.graph[
                u]; if (!nb) continue; for (const v in nb) { if (dist[u] !== Infinity && dist[u] + nb[v].weight < dist[
                    v]) { const cyc = (() => { const c = [v]; let cur = v; const vis = new Set();
                    vis.add(v); for (let i = 0; i < depth; i++) { cur = pred[cur]; if (!cur)
                        return null;
                        c.push(cur); if (cur === start) return c; if (vis.has(cur)) return null;
                        vis.add(cur); } return null; })(); if (cyc && cyc[0] === start) { let amt = 1000; const
                        edges = []; let tl = Infinity; for (let i = 0; i < cyc.length - 1; i++) { const e = State
                            .graph[cyc[i]]?.[cyc[i + 1]]; if (!e) break;
                        amt *= e.rate;
                        edges.push(e);
                        tl = Math.min(tl, e.liquidity); } const le = State.graph[cyc[cyc.length - 1]]?.[cyc[
                        0]]; if (le && tl >= 50) { amt *= le.rate;
                        edges.push(le);
                        tl = Math.min(tl, le.liquidity); const p = amt - 1000,
                            pc = (p / 1000) * 100; if (pc >= 0.0001 && pc < 50) { const ms = Math.min(
                                ...edges.map(e => e.liquidity)) * 0.05;
                            opps.push({ type: 'bellman-ford', path: [...cyc, cyc[0]],
                                profitPercent: pc, actualProfit: toUsd((ms / 1000) * p,
                                    start), maxTradeSize: toUsd(ms, start), edges }); } } } } } } return opps; }

        function connectAllWebSockets() { log('📡 WS...'); try { const w = new WebSocket(
                'wss://ws.okx.com:8443/ws/v5/public');
                w.onopen = () => w.send(JSON.stringify({ op: 'subscribe', args: [{ channel: 'tickers', instType: 'SPOT' }]
                }));
                w.onmessage = e => { try { const d = JSON.parse(e.data); if (d.data) d.data.forEach(t => { const p = t
                            .instId.split('-'); if (p.length === 2) { const k =
                            `${p[0]}${p[1]}`.toUpperCase(); if (!State.wsTickers.okx) State.wsTickers
                                .okx = {};
                            State.wsTickers.okx[k] = { bid: parseFloat(t.bidPx), ask: parseFloat(
                                t.askPx) }; } });
                        State.stats.wsBytes += e.data.length; } catch {} };
                State.exchanges.okx.wsStatus = 'live'; } catch {} try { const w = new WebSocket(
                'wss://stream.binance.com:9443/ws/!ticker@arr');
                w.onmessage = e => { try { const d = JSON.parse(e.data); if (Array.isArray(d)) d.forEach(t => { const
                            ps = parsePairSymbol(t.s); if (!ps) return; const k =
                            `${ps.base}${ps.target}`.toUpperCase(); if (!State.wsTickers.binance) State
                                .wsTickers.binance = {};
                        State.wsTickers.binance[k] = { bid: parseFloat(t.b), ask: parseFloat(t.a) }; });
                    State.stats.wsBytes += e.data.length; } catch {} };
                State.exchanges.binance.wsStatus = 'live'; } catch {} updateExchangeDisplay();
            setInterval(updateStats, 2000); }
        const Engine = {
            async pullGraphLever() {
                const now = Date.now();
                if (now - State.lastPullTime < 15000) {
                    const r = Math.ceil((15000 - (now - State.lastPullTime)) / 1000);
                    log(`⏳ ${r}s cooldown`, 'warning');
                    return;
                }
                State.lastPullTime = now;
                const btn = document.getElementById('pullLeverBtn2');
                btn.disabled = true;
                btn.innerHTML = '🎰 SPINNING…';
                document.getElementById('slotResult2').textContent = '';
                playSpin();
                await initSystem();
                const useBellman = document.getElementById('bellmanToggle').checked && State.level >= 5;
                await runFullScan(true, useBellman);
                State.computePurchasePower();
                if (State.graphRenderer) {
                    State.graphRenderer.buildFromGraph(State.graph, State.allPairs, State.opportunities, State
                        .purchasePower);
                }
                const all = [...State.opportunities.mega, ...State.opportunities.triangular, ...State.opportunities
                    .bellman
                ];
                if (all.length) {
                    all.sort((a, b) => b.profitPercent - a.profitPercent);
                    const best = all[0];
                    document.getElementById('slotResult2').textContent =
                        `🎉 WIN! +${best.profitPercent.toFixed(2)}% — ${best.path.slice(0,4).join(' → ')}`;
                    document.getElementById('slotResult2').style.color = best.profitPercent > 5 ? '#ff00ff' :
                        'var(--gold)';
                    confetti(window.innerWidth / 2, 150, 50);
                    if (document.getElementById('autoOpenTrade').checked)
                        setTimeout(() => UI.openTradeModal(encodeURIComponent(JSON.stringify(best))), 500);
                } else {
                    document.getElementById('slotResult2').textContent = '❌ NO PATH FOUND';
                }
                const cd = setInterval(() => {
                    const e = Date.now() - State.lastPullTime;
                    const r = Math.max(0, 15000 - e);
                    if (r <= 0) {
                        btn.disabled = false;
                        btn.innerHTML = '🎰 PULL LEVER';
                        clearInterval(cd);
                    } else {
                        btn.innerHTML = `⏳ ${Math.ceil(r/1000)}s`;
                    }
                }, 500);
            },
            executeTrade(opp, size, netProfit) {
                const live = State.liveMode;
                const fee = live ? 5 : 0;
                const fp = netProfit - fee;
                if (live && document.getElementById('walletProxyUrl').value.trim()) {
                    fetch(`${document.getElementById('walletProxyUrl').value.trim()}/execute`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ paths: opp.path, amount: size })
                    }).catch(() => {});
                }
                State.bankroll += fp * 0.9;
                State.qFund += fp * 0.05;
                State.lFund += fp * 0.05;
                State.matrix += 10 + Math.floor(size / 100);
                State.level = Math.floor(Math.sqrt(State.matrix / 10)) + 1;
                State.addTradeToLedger(opp, size, fp);
                State.save();
                UI.updateProfile();
                log(`💸 Trade: $${fp.toFixed(2)}`, 'success');
                playWin();
            }
        };

        function toggleLiveScan() { if (State.liveScanActive) { clearInterval(State.liveScanInterval);
                State.liveScanActive = false;
                document.getElementById('liveScanBtn').classList.remove('live');
                document.getElementById('liveScanBtn').textContent = '🔄 LIVE';
                log('🖱️ Live scan stopped'); } else { State.liveScanActive = true;
                document.getElementById('liveScanBtn').classList.add('live');
                document.getElementById('liveScanBtn').textContent = '⏹️ STOP';
                log('🖱️ Live scan started (30s)');
                runFullScan();
                State.liveScanInterval = setInterval(() => { if (!document.getElementById('scanBtn').disabled)
                        runFullScan(); }, 30000); } }
        async function runFullScan(sil = false, useBellman = false) {
            const depth = parseInt(document.getElementById('pathInput').value) || 5;
            if (!sil) log(`Scan depth ${depth}…`);
            buildGraph();
            buildTriangles();
            State.opportunities = { mega: [], triangular: [], bellman: [], suspicious: [] };
            const tri = scanTriangular();
            const bf = [];
            if (useBellman || (!sil && document.getElementById('bellmanToggle')?.checked && State.level >= 5)) {
                const basket = document.getElementById('basketInput').value.split(',').map(s => s.trim().toUpperCase());
                for (const c of basket) {
                    if (State.graph[c]) bf.push(...bellmanFord(c, depth));
                }
            }
            const all = [...tri, ...bf];
            all.forEach(o => {
                if (o.profitPercent > 5) State.opportunities.mega.push(o);
                else if (o.type === 'triangular') State.opportunities.triangular.push(o);
                else State.opportunities.bellman.push(o);
            });
            updateStats();
            if (!sil) {
                ['megaOpps', 'triangularOpps', 'bellmanOpps', 'suspiciousOpps'].forEach(id => {
                    document.getElementById(id).innerHTML = '';
                });
                State.opportunities.mega.forEach(o => UI.renderOpp(o, 'megaOpps', true));
                State.opportunities.triangular.forEach(o => UI.renderOpp(o, 'triangularOpps'));
                State.opportunities.bellman.forEach(o => UI.renderOpp(o, 'bellmanOpps'));
                updateStatus(`✅ ${all.length} opportunities`);
            }
            if (State.graphRenderer && document.getElementById('graphSlotContainer').style.display === 'block') {
                State.computePurchasePower();
                State.graphRenderer.buildFromGraph(State.graph, State.allPairs, State.opportunities, State.purchasePower);
            }
        }

        function updateStats() { document.getElementById('totalPairs').textContent = State.stats.totalPairs;
            document.getElementById('graphNodes').textContent = State.stats.graphNodes;
            document.getElementById('graphEdges').textContent = State.stats.graphEdges;
            document.getElementById('triangleCount').textContent = State.stats.triangleCount; const oc = Object.values(
                State.opportunities).flat().length;
            document.getElementById('oppCount').textContent = oc;
            document.getElementById('megaCount').textContent = State.opportunities.mega.length;
            document.getElementById('triangularCount').textContent = State.opportunities.triangular.length;
            document.getElementById('bellmanCount').textContent = State.opportunities.bellman.length;
            UI.updateProfile(); }

        function updateExchangeDisplay() { const c = document.getElementById('exchangeStatus'); if (!c) return;
            c.innerHTML = Object.values(State.exchanges).map(e => { let cls = e.wsStatus === 'live' ? 'ws' : e.status ===
                    'online' ? 'online' : ''; return `<div class="exchange-status"><div class="indicator ${cls}"></div><strong>${e.name}</strong> ${e.pairs.length}p</div>`; })
                .join(''); }

        function updateIntraExCheckboxes() {
            const c = document.getElementById('intraExCheckboxes');
            if (!c) return;
            const onlineExs = Object.keys(State.exchanges).filter(k => State.exchanges[k].status === 'online' && State
                .exchanges[k].parser !== 'coingecko' && State.exchanges[k].parser !== 'coinlore');
            // Limit selection to level+2
            const maxSelect = State.level + 2;
            c.innerHTML = onlineExs.map(k => {
                const checked = State.selectedIntraExchanges.has(k) ? 'checked' : '';
                return `<label><input type="checkbox" value="${k}" ${checked} onchange="toggleIntraEx('${k}')"> ${State.exchanges[k].name}</label>`;
            }).join('');
            if (!State.selectedIntraExchanges.size && onlineExs.length) {
                // Select largest one by pairs
                const largest = onlineExs.sort((a, b) => State.exchanges[b].pairs.length - State.exchanges[a].pairs
                    .length)[0];
                State.selectedIntraExchanges.add(largest);
                updateIntraExCheckboxes();
            }
        }

        function toggleIntraEx(k) {
            if (State.selectedIntraExchanges.has(k)) {
                State.selectedIntraExchanges.delete(k);
            } else {
                const maxSelect = State.level + 2;
                if (State.selectedIntraExchanges.size >= maxSelect) {
                    log(`🖱️ Intra limit reached: max ${maxSelect} exchanges`, 'warning');
                    return;
                }
                State.selectedIntraExchanges.add(k);
            }
            log(`🖱️ Intra toggle: ${k}`);
            updateIntraExCheckboxes();
        }

        function selectAllIntra() {
            const maxSelect = State.level + 2;
            State.selectedIntraExchanges.clear();
            const onlineExs = Object.keys(State.exchanges).filter(k => State.exchanges[k].status === 'online' && State
                .exchanges[k].parser !== 'coingecko');
            onlineExs.slice(0, maxSelect).forEach(k => State.selectedIntraExchanges.add(k));
            updateIntraExCheckboxes();
            log(`🖱️ ALL INTRA (max ${maxSelect})`);
        }

        function deselectAllIntra() { State.selectedIntraExchanges.clear();
            updateIntraExCheckboxes();
            log('🖱️ NONE INTRA'); }

        function syncBetInput() { document.getElementById('betInput').value = document.getElementById('betSlider').value; }

        function syncBetSlider() { document.getElementById('betSlider').value = document.getElementById('betInput').value; }

        function shareJackpot() { const m = State.opportunities.mega[0]; if (m) { navigator.clipboard.writeText(
                `🎰 ${m.profitPercent.toFixed(2)}% arb on QuanTM FOAM!`);
            log('📤 Copied!', 'success'); } }

        function toggleTheme() { document.body.style.filter = document.body.style.filter === 'hue-rotate(180deg)' ?
                'none' : 'hue-rotate(180deg)';
            log('🖱️ Theme toggled'); }

        function openCreateCoinModal() { if (State.level < 5) { alert('Need level 5!'); return; }
            document.getElementById('createCoinModal').style.display = 'flex'; }

        function closeCreateCoinModal() { document.getElementById('createCoinModal').style.display = 'none'; }
        document.getElementById('createCoinBtn').addEventListener('click', () => { const s = document.getElementById(
                'newCoinSymbol').value.trim().toUpperCase(); const pr = parseFloat(document.getElementById(
                'newCoinPrice').value) || 0.000001; const liq = parseFloat(document.getElementById('newCoinLiq')
            .value) || 500; if (!s) return;
            State.userCoins.push({ symbol: s, price: pr, liq });
            State.allPairs.push({ base: s, target: 'USDT', price: pr, volume: liq * 0.3, liquidity: liq, bidPrice: pr *
                    0.95, askPrice: pr * 1.05, exchange: 'QUANTM_DEX', exchangeType: 'dex' });
            State.stats.totalPairs++;
            State.save();
            closeCreateCoinModal();
            log(`🪙 ${s} created!`, 'success');
            State.matrix += 50;
            State.level = Math.floor(Math.sqrt(State.matrix / 10)) + 1;
            UI.updateProfile(); });
        window.addEventListener('load', () => { State.load();
            log('🎰 v22.11 loaded – Holdings Graph + Level Perks. Click INIT.', 'success');
            document.getElementById('logs').style.display = 'block';
            UI.updateProxyStatus();
            UI.renderFiatCheckboxes();
            document.getElementById('slotDepthLabel2').textContent = document.getElementById('pathInput').value;
            UI.applyLevelConstraints();
            updateIntraExCheckboxes(); // ensure checkboxes render on load
        });
    </script>
</body>
</html>
