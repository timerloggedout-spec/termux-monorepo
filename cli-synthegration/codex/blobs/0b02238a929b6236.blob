<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>🎰 QuanTM FOAM v22.11 – Holdings Graph + Level Perks + Bellman Unlock</title>
    <style>
        :root {
            --pink: #ff00ff;
            --cyan: #00f0ff;
            --green: #00ffaa;
            --gold: #ffd700;
            --bg: #0a0a1a;
            --card: #1a1a2a;
            --border: #2a2a3a;
        }
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            background: var(--bg);
            color: #a0a0ff;
            font-family: 'Courier New', monospace;
            font-size: 11px;
            overflow-x: hidden;
        }
        canvas#particleCanvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 9999;
        }
        .container {
            max-width: 1500px;
            margin: 0 auto;
            padding: 10px;
            position: relative;
            z-index: 1;
        }
        h1 {
            color: var(--gold);
            font-size: 20px;
            text-shadow: 0 0 15px var(--pink), 0 0 25px var(--cyan);
            margin-bottom: 6px;
            letter-spacing: 2px;
        }
        .status-bar {
            padding: 8px 15px;
            margin: 8px 0;
            background: linear-gradient(145deg, #0a0a1a, #1a1a2a);
            border-radius: 10px;
            border-left: 5px solid var(--cyan);
            font-weight: bold;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 0 20px rgba(0, 240, 255, 0.3);
            flex-wrap: wrap;
        }
        .controls {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            margin: 8px 0;
        }
        button {
            background: #111;
            border: 2px solid var(--pink);
            color: var(--pink);
            padding: 7px 12px;
            border-radius: 20px;
            font-size: 10px;
            font-weight: bold;
            cursor: pointer;
            font-family: 'Courier New', monospace;
            transition: all 0.2s;
            text-transform: uppercase;
            letter-spacing: 1px;
            box-shadow: 0 0 8px var(--pink);
        }
        button:hover {
            background: var(--pink);
            color: #000;
            box-shadow: 0 0 20px var(--pink);
        }
        button:active {
            transform: scale(0.95);
        }
        button.cyan {
            border-color: var(--cyan);
            color: var(--cyan);
            box-shadow: 0 0 8px var(--cyan);
        }
        button.cyan:hover {
            background: var(--cyan);
            color: #000;
        }
        button.live {
            border-color: #ff4444;
            color: #ff4444;
            animation: livePulse 1s infinite;
        }
        button.gold {
            border-color: var(--gold);
            color: var(--gold);
            box-shadow: 0 0 12px var(--gold);
            font-size: 12px;
            padding: 9px 20px;
            min-width: 160px;
        }
        button.gold:hover {
            background: var(--gold);
            color: #000;
            box-shadow: 0 0 30px var(--gold);
        }
        @keyframes livePulse {
            0%,
            100% {
                box-shadow: 0 0 8px #ff4444;
            }
            50% {
                box-shadow: 0 0 20px #ff4444;
            }
        }
        button:disabled {
            opacity: 0.4;
            cursor: not-allowed;
            animation: none;
        }
        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 10px;
            margin: 10px 0;
        }
        .card {
            background: var(--card);
            border-radius: 10px;
            padding: 12px;
            border: 1px solid var(--border);
            box-shadow: 0 0 12px rgba(255, 0, 255, 0.1);
            transition: all 0.3s;
        }
        .card:hover {
            border-color: var(--pink);
            box-shadow: 0 0 25px rgba(255, 0, 255, 0.3);
        }
        .card h3 {
            color: var(--cyan);
            font-size: 12px;
            margin-bottom: 8px;
        }
        .exchange-status {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 4px;
            background: #0a0a1a;
            border-radius: 4px;
            margin: 2px 0;
            font-size: 9px;
            border: 1px solid #2a2a3a;
        }
        .indicator {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #ff4444;
            box-shadow: 0 0 6px #ff4444;
            flex-shrink: 0;
        }
        .indicator.online {
            background: var(--green);
            box-shadow: 0 0 10px var(--green);
            animation: pulse 1.5s infinite;
        }
        .indicator.ws {
            background: #ff00ff;
            box-shadow: 0 0 10px #ff00ff;
            animation: pulse 0.8s infinite;
        }
        @keyframes pulse {
            0%,
            100% {
                opacity: 1;
                box-shadow: 0 0 8px var(--green);
            }
            50% {
                opacity: 0.4;
                box-shadow: 0 0 18px var(--green);
            }
        }
        .stat {
            display: flex;
            justify-content: space-between;
            padding: 3px 0;
            font-size: 10px;
        }
        .stat-value {
            color: var(--gold);
            font-weight: bold;
        }
        .rolling-number {
            font-size: 15px;
            color: var(--gold);
            font-weight: bold;
        }
        .opp-section {
            margin: 8px 0;
            padding: 8px;
            background: #0f0f1f;
            border-radius: 6px;
            border: 1px solid #2a2a3a;
        }
        .opp-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 8px;
            background: #1a1a2a;
            border-radius: 6px;
            cursor: pointer;
            font-weight: bold;
            color: var(--pink);
            font-size: 10px;
        }
        .opp-list {
            max-height: 350px;
            overflow-y: auto;
        }
        .opportunity {
            background: #111;
            padding: 8px;
            margin: 4px 0;
            border-radius: 6px;
            border-left: 4px solid var(--green);
            cursor: pointer;
            transition: all 0.2s;
            font-size: 10px;
        }
        .opportunity:hover {
            border-left-color: var(--pink);
            background: #1a1a2a;
            box-shadow: 0 0 12px rgba(255, 0, 255, 0.3);
        }
        .opportunity.mega {
            border-left-color: var(--gold);
            animation: glow 1s infinite alternate;
        }
        @keyframes glow {
            from {
                box-shadow: 0 0 4px var(--gold);
            }
            to {
                box-shadow: 0 0 20px var(--gold);
            }
        }
        .log-container {
            background: #000;
            padding: 8px;
            border-radius: 6px;
            max-height: 180px;
            overflow-y: auto;
            font-size: 8px;
            margin-top: 8px;
        }
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.85);
            z-index: 10000;
            align-items: center;
            justify-content: center;
        }
        .modal-content {
            background: #1a1a2a;
            border: 2px solid var(--pink);
            border-radius: 12px;
            padding: 20px;
            max-width: 750px;
            width: 95%;
            color: white;
            max-height: 85vh;
            overflow-y: auto;
        }
        .flex-row {
            display: flex;
            gap: 8px;
            align-items: center;
            flex-wrap: wrap;
        }
        input,
        select {
            background: #0a0a1a;
            border: 1px solid var(--cyan);
            color: var(--cyan);
            padding: 3px 6px;
            border-radius: 4px;
            font-family: 'Courier New', monospace;
            font-size: 10px;
        }
        .checkbox-group {
            display: flex;
            flex-wrap: wrap;
            gap: 4px;
            align-items: center;
        }
        .checkbox-group label {
            display: flex;
            align-items: center;
            gap: 3px;
            font-size: 8px;
            color: var(--cyan);
        }
        .tier-badge {
            display: inline-block;
            padding: 1px 5px;
            border-radius: 3px;
            font-size: 7px;
            color: #000;
            margin-left: 3px;
        }
        .tier-pico {
            background: #ffaa00;
        }
        .tier-femto {
            background: #ff00ff;
        }
        .tier-planck {
            background: #00f0ff;
        }
        .progress-bar {
            height: 8px;
            background: #333;
            border-radius: 4px;
            margin: 4px 0;
        }
        .progress-fill {
            height: 100%;
            background: var(--gold);
            border-radius: 4px;
            width: 0%;
        }
        /* ====== GRAPH NETWORK ====== */
        #graphSlotContainer {
            display: none;
            background: linear-gradient(180deg, #0a0a1a 0%, #1a0a2a 100%);
            border: 3px solid var(--gold);
            border-radius: 16px;
            padding: 15px;
            margin: 12px 0;
            text-align: center;
            box-shadow: 0 0 35px rgba(255, 215, 0, 0.3), inset 0 0 50px rgba(255, 0, 255, 0.08);
            position: relative;
            overflow: hidden;
        }
        #graphSlotContainer::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: conic-gradient(from 0deg, transparent, rgba(255, 215, 0, 0.02), transparent, rgba(255, 0, 255, 0.02), transparent);
            animation: slotBgRotate 25s linear infinite;
            pointer-events: none;
            z-index: 0;
        }
        @keyframes slotBgRotate {
            to {
                transform: rotate(360deg);
            }
        }
        #graphNetwork {
            display: block;
            margin: 0 auto;
            position: relative;
            z-index: 2;
            border-radius: 8px;
            cursor: pointer;
        }
        #graphLegend {
            position: relative;
            z-index: 2;
            font-size: 8px;
            color: #888;
            margin-top: 4px;
        }
        .perk-unlocked {
            color: var(--green);
        }
        .perk-locked {
            color: #ff4444;
            text-decoration: line-through;
        }
        @media(max-width:768px) {
            .grid {
                grid-template-columns: 1fr;
            }
            .controls {
                justify-content: center;
            }
            #graphNetwork {
                width: 100% !important;
                height: auto !important;
            }
        }
    </style>
</head>
<body>
    <canvas id="particleCanvas"></canvas>
    <div class="container">
        <h1>🎰 QUANTM FOAM <span style="font-size:12px;">v22.11 – Holdings Graph + Level Perks</span></h1>
        <div class="status-bar">
            <span id="mainStatus">🟡 SYSTEM STANDBY</span>
            <div class="flex-row">
                <span style="font-size:9px;color:var(--gold);">VIRTUAL</span>
                <label class="switch"><input type="checkbox" id="liveToggle" onchange="UI.toggleLiveMode()"><span class="slider"></span></label>
                <span style="font-size:9px;color:var(--green);">LIVE</span>
            </div>
        </div>
        <div class="controls">
            <button class="cyan" onclick="UI.logButton('INIT');initSystem()">🔄 INIT</button>
            <button id="scanBtn" onclick="UI.logButton('FULL SCAN');runFullScan()" disabled>🎲 SCAN</button>
            <button id="liveScanBtn" onclick="UI.logButton('LIVE SCAN');toggleLiveScan()">🔄 LIVE</button>
            <button onclick="UI.logButton('LIVE WS');connectAllWebSockets()">📡 WS</button>
            <button onclick="UI.logButton('CREATE COIN');openCreateCoinModal()">🪙 COIN</button>
            <button onclick="UI.logButton('GRAPH UI');UI.toggleGraphSlot()">🌐 GRAPH</button>
            <button onclick="UI.logButton('LOGS');toggleLogs()">📋 LOGS</button>
            <button onclick="UI.logButton('SHARE');shareJackpot()">📤 SHARE</button>
            <button onclick="UI.logButton('THEME');toggleTheme()">🎨</button>
        </div>
        <div class="card" style="margin-bottom:8px;">
            <div class="flex-row">
                <div><label style="font-size:9px;">🌐 FETCH:</label>
                    <select id="proxySelect" onchange="UI.onProxyChange()" style="width:140px;">
                        <option value="direct">⚡ Direct</option>
                        <option value="builtin">🔁 Proxy</option>
                        <option value="custom">📝 Custom</option>
                    </select>
                    <input type="text" id="corsProxyUrl" placeholder="https://your-proxy.com/api?url=" style="width:200px;display:none;">
                </div>
                <div><label style="font-size:9px;">🔐 WALLET:</label><input type="text" id="walletProxyUrl" style="width:170px;"></div>
                <button onclick="UI.logButton('SAVE PROXY');saveProxyConfig()" class="cyan" style="padding:4px 8px;">SAVE</button>
            </div>
            <div id="proxyStatusMsg" style="margin-top:4px;font-size:9px;"></div>
        </div>
        <!-- ====== GRAPH NETWORK SLOT ====== -->
        <div id="graphSlotContainer">
            <h3 style="color:var(--gold);font-size:14px;position:relative;z-index:2;">🌐 HOLDINGS GRAPH NETWORK</h3>
            <canvas id="graphNetwork" width="700" height="420"></canvas>
            <div id="graphLegend">🟢 Node size = Your purchase power | 🔆 Glow = Profit potential | 📈 Arrows = Trade paths</div>
            <div style="position:relative;z-index:2;margin:8px 0;">
                <label style="color:var(--cyan);font-size:10px;">🔗 Depth: <span id="slotDepthLabel2">5</span></label>
                <label style="margin-left:10px;"><input type="checkbox" id="autoOpenTrade" checked> Auto‑open trade</label>
                <label style="margin-left:10px;"><input type="checkbox" id="bellmanToggle" onchange="UI.logButton('Bellman toggle')"> Bellman‑Ford scan</label>
            </div>
            <button onclick="UI.logButton('PULL LEVER');Engine.pullGraphLever()" class="gold" id="pullLeverBtn2">🎰 PULL LEVER <span id="pullCountdown2"></span></button>
            <div id="slotResult2" style="color:var(--gold);font-size:16px;margin-top:10px;position:relative;z-index:2;"></div>
            <div style="font-size:8px;color:#888;position:relative;z-index:2;">Rate limited (15s). Full refresh + graph layout.</div>
        </div>
        <!-- Stats & Matrix -->
        <div class="grid">
            <div class="card">
                <h3>👤 MATRIX LVL <span id="userLevel">1</span></h3>
                <div>Score: <span id="matrixScore">0</span> / <span id="nextLevelScore">100</span></div>
                <div class="progress-bar"><div class="progress-fill" id="levelProgress"></div></div>
                <div>💰 Royalties: <span id="royalties">$0.00</span></div>
                <div>🏦 Quantum: <span id="quantumFundVisible">$0.00</span> | 🔒<span id="quantumFundLocked">$0.00</span></div>
                <div><label>SOL:</label><input type="text" id="solAddress" onchange="State.saveWallet()" style="width:85%;"><span id="solBalance">0.00</span></div>
                <div><label>ETH:</label><input type="text" id="ethAddress" onchange="State.saveWallet()" style="width:85%;"><span id="ethBalance">0.00</span></div>
            </div>
            <div class="card">
                <h3>⭐ LEVEL PERKS</h3>
                <div id="perksList" style="font-size:9px;"></div>
            </div>
            <div class="card">
                <h3>📊 STATISTICS</h3>
                <div class="stat"><span>Pairs:</span><span class="stat-value" id="totalPairs">0</span></div>
                <div class="stat"><span>Nodes:</span><span class="stat-value" id="graphNodes">0</span></div>
                <div class="stat"><span>Edges:</span><span class="stat-value" id="graphEdges">0</span></div>
                <div class="stat"><span>Triangles:</span><span class="stat-value" id="triangleCount">0</span></div>
                <div class="stat"><span>Opps:</span><span class="stat-value" id="oppCount">0</span></div>
            </div>
        </div>
        <div class="flex-row" style="margin:8px 0;background:#1a1a2a;padding:10px;border-radius:10px;">
            <span style="color:var(--gold);font-size:13px;">💰 BANKROLL:</span>
            <span class="rolling-number" id="bankroll">$10,000.00</span>
            <span style="margin-left:auto;color:var(--cyan);">📈 P/L:</span>
            <span id="pnl" style="color:var(--green);">$0.00</span>
        </div>
        <div class="flex-row" style="gap:8px;flex-wrap:wrap;margin:6px 0;">
            <div><label>🎚️ BET:</label><input type="range" id="betSlider" min="100" max="10000" value="1000" oninput="syncBetInput()"><input type="number" id="betInput" value="1000" style="width:70px;" onchange="syncBetSlider()"></div>
            <div><label>📐 DEPTH:</label><input type="range" id="pathSlider" min="3" max="10" value="5" oninput="UI.syncPathInput()"><input type="number" id="pathInput" value="5" style="width:40px;" onchange="UI.syncPathSlider()"></div>
            <div><label>🧺 BASKET:</label><input type="text" id="basketInput" value="USDT,BTC,ETH,DOGE,SHIB,SOL" style="width:160px;"></div>
            <div><label>🔁 MODE:</label><select id="arbMode"><option value="both">Both</option><option value="intra">Intra</option><option value="inter">Inter</option></select></div>
            <div><label>🔑 PUMP:</label><input type="text" id="pumpToken" style="width:120px;" onchange="savePumpToken()"></div>
        </div>
        <div style="margin:4px 0;"><div id="intraExCheckboxes" class="checkbox-group"></div>
            <button onclick="selectAllIntra()" class="cyan" style="padding:2px 6px;">ALL</button>
            <button onclick="deselectAllIntra()" class="cyan" style="padding:2px 6px;">NONE</button>
        </div>
        <div class="card" style="margin-bottom:8px;">
            <h3>💱 FIAT CONVERSION (CoinGecko)</h3>
            <div class="flex-row">
                <div class="checkbox-group" id="fiatCheckboxes"></div>
                <button onclick="UI.logButton('FETCH RATES');fetchForexRates()" class="cyan">🔄 FETCH</button>
                <span id="forexStatus" style="color:var(--cyan);font-size:9px;"></span>
            </div>
        </div>
        <h2>⚡ EXCHANGE STATUS</h2>
        <div class="grid" id="exchangeStatus"></div>
        <div class="grid">
            <div class="card"><h3>🔥 PICO (<$1e-9)</h3><div id="picoValue" style="max-height:150px;overflow-y:auto;font-size:9px;"></div></div>
            <div class="card"><h3>⚡ FEMTO (<$1e-12)</h3><div id="femtoValue" style="max-height:150px;overflow-y:auto;font-size:9px;"></div></div>
            <div class="card"><h3>💧 PLANCK (<$1e-15)</h3><div id="planckValue" style="max-height:150px;overflow-y:auto;font-size:9px;"></div></div>
        </div>
        <h2>🎯 OPPORTUNITIES</h2>
        <div class="opp-section"><div class="opp-header" onclick="toggleSection('megaOpps')">🌟 MEGA >5% <span id="megaCount">0</span></div><div id="megaOpps" class="opp-list"></div></div>
        <div class="opp-section"><div class="opp-header" onclick="toggleSection('triangularOpps')">📐 TRIANGULAR <span id="triangularCount">0</span></div><div id="triangularOpps" class="opp-list"></div></div>
        <div class="opp-section"><div class="opp-header" onclick="toggleSection('bellmanOpps')">🔗 BELLMAN-FORD <span id="bellmanCount">0</span></div><div id="bellmanOpps" class="opp-list"></div></div>
        <div class="opp-section"><div class="opp-header" onclick="toggleSection('suspiciousOpps')">⚠️ SUSPICIOUS <span id="suspiciousCount">0</span></div><div id="suspiciousOpps" class="opp-list"></div></div>
        <div class="card"><h3>📒 TRADE LEDGER</h3><div id="tradeLedger" style="max-height:120px;overflow-y:auto;font-size:8px;"></div></div>
        <h2 onclick="toggleLogs()">📋 LOGS</h2>
        <div class="log-container" id="logs"></div>
    </div>
    <div id="tradeModal" class="modal"><div class="modal-content"><h3>🎰 EXECUTE ARBITRAGE</h3><div id="tradeDetails"></div><div class="math-breakdown" id="compoundingMath"></div><button onclick="closeModal()">CANCEL</button><button class="cyan" id="executeTradeBtn">💸 PULL LEVER</button></div></div>
    <div id="createCoinModal" class="modal"><div class="modal-content"><h3>🪙 CREATE TOKEN</h3><input type="text" id="newCoinSymbol" placeholder="SYMBOL"><input type="number" id="newCoinPrice" value="0.000001"><input type="number" id="newCoinLiq" value="500"><button onclick="closeCreateCoinModal()">CANCEL</button><button id="createCoinBtn" class="cyan">MINT</button></div></div>
    <script>
        const audioCtx = new(window.AudioContext || window.webkitAudioContext)();

        function playTone(f, d, t = 'square', v = 0.06) { const o = audioCtx.createOscillator(),
                g = audioCtx.createGain(); o.type = t;
            o.frequency.value = f;
            g.gain.setValueAtTime(v, audioCtx.currentTime);
            g.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + d);
            o.connect(g);
            g.connect(audioCtx.destination);
            o.start();
            o.stop(audioCtx.currentTime + d); }

        function playSpin() { playTone(800, 0.1, 'sawtooth', 0.04); }

        function playWin() { playTone(523, 0.1);
            setTimeout(() => playTone(659, 0.1), 100);
            setTimeout(() => playTone(784, 0.18), 200); }
        const canvas = document.getElementById('particleCanvas'),
            ctx = canvas.getContext('2d');
        let particles = [];

        function resize() { canvas.width = innerWidth;
            canvas.height = innerHeight; }
        window.addEventListener('resize', resize);
        resize();
        class Particle { constructor(x, y, vx, vy, c, l) { this.x = x;
                this.y = y;
                this.vx = vx;
                this.vy = vy;
                this.color = c;
                this.life = l; } }

        function anim() { ctx.clearRect(0, 0, canvas.width, canvas.height); for (let i = particles.length - 1; i >=
                0; i--) { const p = particles[i];
                p.x += p.vx;
                p.y += p.vy;
                p.vy += 0.06;
                p.life -= 0.014;
                ctx.fillStyle = p.color;
                ctx.globalAlpha = Math.max(0, p.life);
                ctx.fillRect(p.x, p.y, 3, 3); if (p.life <= 0) particles.splice(i, 1); } requestAnimationFrame(anim); }
        anim();

        function confetti(x, y, n = 30) { const cols = ['#ff00ff', '#00ff00', '#ffd700', '#00f0ff']; for (let i = 0; i <
                n; i++) particles.push(new Particle(x, y, (Math.random() - 0.5) * 8, (Math.random() - 0.5) * 7 - 3,
                cols[Math.floor(Math.random() * cols.length)], 0.6 + Math.random() * 0.4)); }
        // ==================== STATE ====================
        const State = {
            bankroll: 10000,
            matrix: 0,
            level: 1,
            qFund: 0,
            lFund: 0,
            liveMode: false,
            userCoins: [],
            exchanges: {},
            allPairs: [],
            graph: {},
            triangles: [],
            opportunities: { mega: [], triangular: [], bellman: [], suspicious: [] },
            stats: { totalPairs: 0, graphNodes: 0, graphEdges: 0, triangleCount: 0, wsBytes: 0, oppCount: 0 },
            selectedIntraExchanges: new Set(),
            selectedFiats: new Set(['RUB', 'INR', 'EUR', 'GBP']),
            liveScanInterval: null,
            liveScanActive: false,
            forexRates: {},
            wsTickers: {},
            tradeLedger: [],
            proxyMode: 'direct',
            customProxyUrl: '',
            lastTradeExecTime: 0,
            lastPullTime: 0,
            graphRenderer: null,
            purchasePower: {}, // asset -> amount buyable with bankroll
            load() {
                try { const s = JSON.parse(localStorage.getItem('qfoam_v22final')); if (s) { this.bankroll = s
                            .bankroll || 10000;
                        this.matrix = s.matrix || 0;
                        this.level = s.level || 1;
                        this.qFund = s.qFund || 0;
                        this.lFund = s.lFund || 0;
                        this.liveMode = s.liveMode || false;
                        this.userCoins = s.userCoins || []; if (s.selectedIntraExchanges) this.selectedIntraExchanges =
                            new Set(s.selectedIntraExchanges); if (s.forexRates) this.forexRates = s.forexRates; if (s
                            .selectedFiats) this.selectedFiats = new Set(s.selectedFiats); if (s.tradeLedger) this
                            .tradeLedger = s.tradeLedger.slice(-15); if (s.proxyMode) this.proxyMode = s.proxyMode; if (
                            s.customProxyUrl) this.customProxyUrl = s.customProxyUrl; } } catch (e) {}
                document.getElementById('solAddress').value = localStorage.getItem('wallet_sol') || '';
                document.getElementById('ethAddress').value = localStorage.getItem('wallet_eth') || '';
                document.getElementById('pumpToken').value = localStorage.getItem('pumpfun_token') || '';
                document.getElementById('basketInput').value = localStorage.getItem('basket') ||
                    'USDT,BTC,ETH,DOGE,SHIB,SOL';
                document.getElementById('pathInput').value = localStorage.getItem('pathDepth') || 5;
                document.getElementById('pathSlider').value = document.getElementById('pathInput').value;
                document.getElementById('liveToggle').checked = this.liveMode;
                document.getElementById('proxySelect').value = this.proxyMode;
                document.getElementById('corsProxyUrl').value = this.customProxyUrl;
                document.getElementById('walletProxyUrl').value = localStorage.getItem('walletProxyUrl') || '';
                UI.updateProfile();
                UI.renderFiatCheckboxes();
                UI.onProxyChange();
                UI.renderTradeLedger();
                UI.applyLevelConstraints();
                updateIntraExCheckboxes(); // render immediately on load
            },
            save() {
                localStorage.setItem('qfoam_v22final', JSON.stringify({
                    bankroll: this.bankroll,
                    matrix: this.matrix,
                    level: this.level,
                    qFund: this.qFund,
                    lFund: this.lFund,
                    liveMode: this.liveMode,
                    userCoins: this.userCoins,
                    selectedIntraExchanges: [...this.selectedIntraExchanges],
                    forexRates: this.forexRates,
                    selectedFiats: [...this.selectedFiats],
                    tradeLedger: this.tradeLedger.slice(-15),
                    proxyMode: this.proxyMode,
                    customProxyUrl: this.customProxyUrl
                }));
                localStorage.setItem('wallet_sol', document.getElementById('solAddress').value);
                localStorage.setItem('wallet_eth', document.getElementById('ethAddress').value);
                localStorage.setItem('pumpfun_token', document.getElementById('pumpToken').value);
                localStorage.setItem('basket', document.getElementById('basketInput').value);
                localStorage.setItem('pathDepth', document.getElementById('pathInput').value);
                localStorage.setItem('walletProxyUrl', document.getElementById('walletProxyUrl').value);
            },
            saveWallet() { this.save(); },
            savePumpToken() { this.save(); },
            addTradeToLedger(opp, size, netProfit) { this.tradeLedger.unshift({ time: new Date().toISOString(),
                    path: opp.path.join(' → '), size, profit: netProfit, type: opp.type }); if (this.tradeLedger
                    .length > 15) this.tradeLedger.length = 15;
                this.save();
                UI.renderTradeLedger(); },
            computePurchasePower() {
                this.purchasePower = {};
                if (this.bankroll <= 0) return;
                const prices = {};
                for (const pair of this.allPairs) {
                    if (!pair.base || !pair.target) continue;
                    const base = pair.base;
                    // use askPrice (price to buy)
                    const ask = pair.askPrice || pair.price * 1.001;
                    if (!prices[base] || ask < prices[base]) prices[base] = ask;
                }
                for (const [asset, price] of Object.entries(prices)) {
                    if (price > 0) this.purchasePower[asset] = this.bankroll / price;
                }
                // also add USDT/USD as base with purchase power = bankroll
                for (const stable of ['USDT', 'USD', 'USDC', 'GUSD', 'BUSD']) {
                    if (!this.purchasePower[stable]) this.purchasePower[stable] = this.bankroll;
                }
            }
        };
        const CORS_OK_EXCHANGES = new Set(['okx', 'coinbase', 'binance', 'kucoin', 'gemini', 'bitstamp', 'kraken',
            'dexscreener_eth', 'dexscreener_bsc', 'dexscreener_polygon', 'dexscreener_arb', 'dexscreener_sol',
            'coingecko', 'coinpaprika', 'coinlore'
        ]);
        const BUILTIN_PROXIES = ['https://corsproxy.io/?', 'https://api.allorigins.win/raw?url='];
        let currentProxyIndex = 0;

        function getEffectiveProxyUrl() { if (State.proxyMode === 'custom') { const c = (document.getElementById(
                    'corsProxyUrl').value || '').trim(); if (c && !c.includes('placeholder')) return c; return null; } if (
                State.proxyMode === 'builtin') return BUILTIN_PROXIES[currentProxyIndex]; return null; }

        function rotateProxy() { currentProxyIndex = (currentProxyIndex + 1) % BUILTIN_PROXIES.length;
            UI.updateProxyStatus(); }
        async function smartFetch(url, options = {}, isCorsSafe = false) { if (isCorsSafe || State.proxyMode ===
                'direct') { try { const r = await fetch(url, options); if (r.ok) return r; if (r.status >= 400) throw new
                    Error('HTTP ' + r.status); } catch (e) {} } const proxy = getEffectiveProxyUrl(); if (proxy) { try { const
                    r = await fetch(proxy + encodeURIComponent(url), options); if (!r.ok) throw new Error(
                'Proxy HTTP ' + r.status); const text = await r.text(); if (text.startsWith('<') || text.includes(
                    'corsdemo')) throw new Error('Non-JSON'); try { return new Response(JSON.stringify(JSON.parse(
                    text)), { status: 200, headers: { 'Content-Type': 'application/json' } }); } catch { return new
                Response(text, { status: 200, headers: { 'Content-Type': 'text/plain' } }); } } catch (e) { rotateProxy
            (); } } throw new Error('All fetch attempts exhausted'); }
        const KNOWN_QUOTES = ['USDT', 'USDC', 'BUSD', 'GUSD', 'USD', 'BTC', 'ETH', 'BNB', 'SOL', 'EUR', 'GBP', 'JPY',
            'KRW', 'AUD', 'CAD', 'CHF', 'RUB', 'INR', 'TRY', 'BRL', 'IDR', 'DAI', 'SGD', 'PLN', 'UAH', 'AED', 'BETH',
