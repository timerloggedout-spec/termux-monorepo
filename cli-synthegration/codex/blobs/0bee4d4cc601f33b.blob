CREATE TABLE import_export_restriction (
    restriction_id      UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    entity_id           UUID REFERENCES entity(entity_id) ON DELETE CASCADE,
    jurisdiction_code   CHAR(2) REFERENCES country(jurisdiction_code),
    restriction_type    TEXT CHECK (restriction_type IN (
        'import_ban', 'export_ban', 'import_license_required',
        'export_license_required', 'quota', 'controlled_substance',
        'precursor_chemical', 'sanitary_permit'
    )),
    applies_to_formulation TEXT,  -- e.g., "injectable", "oral"
    legal_basis         TEXT,     -- statute citation
    exemptions          TEXT,     -- e.g., "research use only"
    permit_issuing_authority TEXT,
    application_process_url TEXT,
    notes               TEXT,
    effective_date      DATE,
    source_url          TEXT,
    last_verified_at    TIMESTAMP WITH TIME ZONE
);
