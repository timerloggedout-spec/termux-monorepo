    // ── TESTNET FAUCET ─────────────────────────────────────
    // Generates a real Sepolia wallet, stores it, and opens the official faucet with address pre-filled.
    async function openTestnetFaucet() {
        try {
            // Generate wallet only if none exists
            if (!State.testnetWallet) {
                const wallet = ethers.Wallet.createRandom();
                State.testnetWallet = {
                    address: wallet.address,
                    privateKey: wallet.privateKey
                };
                State.save();
                document.getElementById('ethAddress').value = wallet.address;
                localStorage.setItem('wallet_eth', wallet.address);
                log(`🔑 Testnet wallet generated: ${wallet.address.slice(0,8)}...`, 'success');
            }
            // Open Sepolia faucet (official) with address
            const addr = State.testnetWallet.address;
            window.open(`https://faucet.sepolia.dev/?address=${addr}`, '_blank');
            log('🚰 Opening Sepolia faucet...', 'success');
        } catch(e) {
            log('❌ Faucet error: ' + e.message, 'error');
        }
    }

    // ── BOOTSTRAP ───────────────────────────────────────────
    window.addEventListener('load', async () => {
        const savedScale = localStorage.getItem('uiScale') || 10;
        document.getElementById('uiScaleSlider').value = savedScale;
        setUIScale(savedScale);

        State.load();
        document.getElementById('playerHandle').value = playerHandle;
        log('🎰 v23.5 ready – Unified P2P Swarm + Testnet Faucet', 'success');
        document.getElementById('logs').style.display = 'block';
        UI.updateProxyStatus();
        UI.renderFiatCheckboxes();
        document.getElementById('slotDepthLabel2').textContent = document.getElementById('pathInput').value;
        UI.applyLevelConstraints();
        updateIntraExCheckboxes();
        UI.renderBasketTracker();
        UI.renderBatchHistory();
        UI.renderLiveTrades();
        UI.renderCoinLevels();
        document.getElementById('modeLabel').textContent = State.liveMode ? (State.liveTestMode ? 'TESTNET' : 'LIVE') : 'PAPER';
        rebuildExchangeDefinitions();

        // Show/hide faucet button based on testnet mode
        function updateFaucetVisibility() {
            const btn = document.getElementById('faucetBtn');
            btn.style.display = (State.liveMode && State.liveTestMode) ? 'inline-block' : 'none';
        }
        updateFaucetVisibility();
        document.getElementById('liveToggle').addEventListener('change', updateFaucetVisibility);
        document.getElementById('liveTestnetToggle').addEventListener('change', updateFaucetVisibility);

        await initDuckDB();
        await initYjs();
        initDEX();
        UI.updateManaDisplay();
        UI.updateProfile();
        UI.renderPlayerList();

        // Global event hooks for mana
        window.addEventListener('qfm-trade', () => addMana('trade', 5));
        window.addEventListener('qfm-scan', () => addMana('compute', 1));
        const origFetch = window.fetch;
        window.fetch = function(...args) { addMana('data', 1); return origFetch.apply(this, args); };

        setTimeout(generateQRCode, 1000);
    });

    window.addEventListener('beforeunload', () => {
        State.save();
        if (State.graphRenderer && State.graphRenderer.animRAF) cancelAnimationFrame(State.graphRenderer.animRAF);
    });

    // Expose global functions
    window.initSystem = initSystem;
    window.runFullScan = runFullScan;
    window.toggleLiveScan = toggleLiveScan;
    window.connectAllWebSockets = connectAllWebSockets;
    window.openCreateCoinModal = openCreateCoinModal;
    window.closeCreateCoinModal = closeCreateCoinModal;
    window.toggleLogs = toggleLogs;
    window.shareJackpot = shareJackpot;
    window.toggleTheme = toggleTheme;
    window.syncBetInput = syncBetInput;
    window.syncBetSlider = syncBetSlider;
    window.selectAllIntra = selectAllIntra;
    window.deselectAllIntra = deselectAllIntra;
    window.fetchForexRates = fetchForexRates;
    window.closeModal = closeModal;
    window.saveProxyConfig = saveProxyConfig;
    window.setTargetPreset = setTargetPreset;
    window.toggleSection = toggleSection;
    window.setPlayerHandle = setPlayerHandle;
    window.copyShareURL = copyShareURL;
    window.addTorrentFromInput = addTorrentFromInput;
    window.executeDBQuery = executeDBQuery;
    window.checkIPNSUpdate = checkIPNSUpdate;
    window.placeDEXOrder = placeDEXOrder;
    window.createPrivateRoom = createPrivateRoom;
    window.toggleIntraEx = toggleIntraEx;
    window.startP2PShare = startP2PShare;
    window.stopP2PShare = stopP2PShare;
    window.saveDeploymentUrl = saveDeploymentUrl;
    window.openTestnetFaucet = openTestnetFaucet;
    window.toggleTestnets = toggleTestnets;
    window.togglePauseLogs = togglePauseLogs;
    window.toggleCoinEx = toggleCoinEx;
    window.openApiKeysModal = openApiKeysModal;
    window.closeApiKeysModal = closeApiKeysModal;
    window.saveApiKeysFromModal = saveApiKeysFromModal;
    window.openPumpLaunchModal = openPumpLaunchModal;
    window.closePumpLaunchModal = closePumpLaunchModal;

    log('🎭 QuanTM FOAM v23.5 – All systems initialized. The swarm awaits.', 'success');
