    <!-- The previous response ended with the <style> and the start of <script>. 
         This continuation completes the entire file. -->

    <script>
    // =============================================================================
    //  QUAN™ FOAM v23.5 – UNIFIED P2P SWARM + v22.29 FEATURES
    //  Full synthesis: every capability preserved & harmonised.
    // =============================================================================

    // ── UI CONTROLLER (combines methods from both versions) ─────
    const UI = {
        logButton(label){ log(`🖱️ ${label}`); },
        copyLogsRobust(){
            const el = document.getElementById('logs'); if (!el || !el.textContent.trim()) return;
            const textarea = document.createElement('textarea'); textarea.value = el.textContent;
            textarea.style.position = 'fixed'; textarea.style.opacity = '0';
            document.body.appendChild(textarea); textarea.select();
            try { document.execCommand('copy'); log('📋 Logs copied!', 'success'); } catch(e) { log('❌ Copy failed', 'error'); }
            document.body.removeChild(textarea);
        },
        toggleGraphSlot(){
            const s = document.getElementById('graphSlotContainer');
            s.style.display = s.style.display === 'none' ? 'block' : 'none';
            if (s.style.display === 'block' && State.graph && Object.keys(State.graph).length) {
                if (!State.graphRenderer) State.graphRenderer = new GraphRenderer('graphNetwork');
                State.computePurchasePower();
                State.graphRenderer.buildFromGraph(State.graph, State.opportunities, State.purchasePower, State.highlightedPaths, State.conflictEdges || new Set());
            }
        },
        syncPathInput(){
            document.getElementById('pathInput').value = document.getElementById('pathSlider').value;
            document.getElementById('slotDepthLabel2').textContent = document.getElementById('pathSlider').value;
            State.save();
        },
        syncPathSlider(){
            document.getElementById('pathSlider').value = document.getElementById('pathInput').value;
            document.getElementById('slotDepthLabel2').textContent = document.getElementById('pathInput').value;
            State.save();
        },
        toggleLiveMode(){
            State.liveMode = document.getElementById('liveToggle').checked;
            document.getElementById('modeLabel').textContent = State.liveMode ? (State.liveTestMode ? 'TESTNET' : 'LIVE') : 'PAPER';
            document.getElementById('liveTestnetToggle').style.display = State.liveMode ? 'inline-block' : 'none';
            document.getElementById('testnetLabel').style.display = State.liveMode ? 'inline' : 'none';
            if (!State.liveMode) { State.liveTestMode = false; document.getElementById('liveTestnetToggle').checked = false; }
            State.save();
            this.updateProfile();
            log(`🖱️ Live: ${State.liveMode}`);
        },
        toggleLiveTestnet(){
            State.liveTestMode = document.getElementById('liveTestnetToggle').checked;
            State.save();
            log(`🖱️ Testnet: ${State.liveTestMode?'ON':'OFF'}`);
        },
        updateProfile(){
            document.getElementById('userLevel').textContent = State.level;
            document.getElementById('matrixScore').textContent = State.matrix;
            const n = Math.pow(State.level, 2) * 10;
            document.getElementById('nextLevelScore').textContent = n;
            document.getElementById('levelProgress').style.width = Math.min(100, (State.matrix / n) * 100) + '%';
            document.getElementById('royalties').textContent = '$' + (State.royalties || 0).toFixed(2);
            document.getElementById('quantumFundVisible').textContent = '$' + (State.qFund || 0).toFixed(2);
            document.getElementById('quantumFundLocked').textContent = '$' + (State.lFund || 0).toFixed(2);
            document.getElementById('bankroll').textContent = '$' + State.bankroll.toFixed(2);
            const pnl = State.bankroll - 10000;
            document.getElementById('pnl').textContent = `$${pnl.toFixed(2)} (${((pnl/10000)*100).toFixed(2)}%)`;
            document.getElementById('modeLabel').textContent = State.liveMode ? (State.liveTestMode ? 'TESTNET' : 'LIVE') : 'PAPER';
            document.getElementById('wsReconnects').textContent = State.stats.wsReconnects;
            document.getElementById('myHandle') && (document.getElementById('myHandle').textContent = playerHandle);
            this.applyLevelConstraints();
            this.renderPerks();
            this.updateDashboard();
            this.renderPlayerList();
        },
        updateDashboard(){
            const trades = State.tradeLedger; const total = trades.length;
            document.getElementById('totalTrades').textContent = total;
            if (total === 0) {
                document.getElementById('winRate').textContent = '0%';
                document.getElementById('bestTrade').textContent = '$0.00';
                document.getElementById('worstTrade').textContent = '$0.00';
                document.getElementById('avgProfit').textContent = '$0.00';
                document.getElementById('totalPL').textContent = '$0.00';
                return;
            }
            const wins = trades.filter(t => t.profit > 0).length;
            const profits = trades.map(t => t.profit);
            const best = Math.max(...profits);
            const worst = Math.min(...profits);
            const avg = profits.reduce((a, b) => a + b, 0) / total;
            const totalPL = profits.reduce((a, b) => a + b, 0);
            document.getElementById('winRate').textContent = ((wins / total) * 100).toFixed(1) + '%';
            document.getElementById('bestTrade').textContent = '$' + best.toFixed(2);
            document.getElementById('worstTrade').textContent = '$' + worst.toFixed(2);
            document.getElementById('avgProfit').textContent = '$' + avg.toFixed(2);
            document.getElementById('totalPL').textContent = '$' + totalPL.toFixed(2);
            document.getElementById('totalPL').style.color = totalPL >= 0 ? 'var(--green)' : '#ff4444';
        },
        renderLiveTrades(){
            const el = document.getElementById('liveTrades');
            if (!el) return;
            if (!State.liveTradeHistory.length) { el.innerHTML = 'No live trades yet'; return; }
            el.innerHTML = State.liveTradeHistory.map(t =>
                `<div style="margin:2px 0;padding:2px;background:#0a0a1a;border-radius:3px;"><span style="color:var(--green);">✔</span> ${t.time.slice(11,19)} ${t.path} $${t.profit.toFixed(2)} ${t.testnet?'🧪':''}<br><small style="color:#888;">tx: ${t.txHash.slice(0,12)}...</small></div>`
            ).join('');
        },
        renderLatency(){
            const el = document.getElementById('latencyDisplay');
            if (!el) return;
            if (!State.operationLatency.length) { el.innerHTML = 'No operations yet'; return; }
            el.innerHTML = State.operationLatency.slice(-8).map(l => `<div>${l.op}: ${l.duration}ms</div>`).join('');
        },
        renderCoinLevels(){
            const el = document.getElementById('coinLevels'); if (!el) return;
            if (!State.userCoins.length) { el.innerHTML = 'No coins yet'; return; }
            el.innerHTML = State.userCoins.map(c => {
                const lvl = State.coinLevels[c.symbol] || 1;
                const maxEx = State.getMaxCoinExchanges();
                const unlocked = Math.min(lvl, maxEx);
                return `<div>🪙 ${c.symbol} Lv.${lvl} (${unlocked}/${maxEx} exchanges)</div>`;
            }).join('');
        },
        applyLevelConstraints(){
            const maxBet = Math.max(100, State.level * 2000);
            document.getElementById('betSlider').max = maxBet;
            document.getElementById('betInput').max = maxBet;
            let maxDepth = 3; if (State.level >= 4 && State.level <= 6) maxDepth = 5; else if (State.level >= 7) maxDepth = 10;
            document.getElementById('pathSlider').max = maxDepth;
            document.getElementById('pathInput').max = maxDepth;
            const bellmanCheck = document.getElementById('bellmanToggle');
            if (State.level < 5) { bellmanCheck.disabled = true; bellmanCheck.checked = false; bellmanCheck.parentElement.style.opacity = '0.5'; }
            else { bellmanCheck.disabled = false; bellmanCheck.parentElement.style.opacity = '1'; }
            document.getElementById('strategyBtn').disabled = State.level < 10;
            State.startAutoForex();
            this.updateCoinCooldown();
        },
        renderPerks(){
            const el = document.getElementById('perksList');
            const perks = [
                { desc: 'Max Bet', value: `$${Math.max(100,State.level*2000)}` },
                { desc: 'Max Depth', value: (State.level < 4 ? '3' : State.level < 7 ? '5' : '10') },
                { desc: 'Auto‑Forex (5m)', unlocked: State.level >= 3 },
                { desc: 'Live Scan Interval', value: `${(State.getLiveScanInterval()/1000).toFixed(0)}s` },
                { desc: 'Pull Cooldown', value: `${(State.getPullCooldown()/1000).toFixed(0)}s` },
                { desc: 'Bellman‑Ford', unlocked: State.level >= 5 },
                { desc: 'Create Coin', unlocked: State.level >= 5, extra: State.level >= 5 ? `Cooldown: ${State.getCoinCooldown()}s` : '' },
                { desc: '2nd Coin', unlocked: State.level >= 15, extra: '🔒 Lv.15' },
                { desc: 'Pump Launch', unlocked: State.level >= 7 },
                { desc: 'Live Testnet', unlocked: true },
                { desc: 'Smart Batch', unlocked: State.level >= 5 },
                { desc: 'WS Reconnect', unlocked: State.level >= 8 },
                { desc: 'Intra Exch', value: `${State.level+2}` },
                { desc: 'Coin Exchanges', value: `${State.getMaxCoinExchanges()}` }
            ];
            el.innerHTML = perks.map(p => p.unlocked !== undefined ?
                `<div class="${p.unlocked?'perk-unlocked':'perk-locked'}">🔹 ${p.desc}: ${p.unlocked?'✅ Unlocked':p.value}${p.extra?' · '+p.extra:''}</div>` :
                `<div>🔹 ${p.desc}: ${p.value}</div>`).join('');
        },
        renderOpp(opp, targetId, mega){ const c = document.getElementById(targetId); if (!c) return; c.innerHTML += `<div class="opportunity ${mega?'mega':''}" onclick="UI.openTradeModal('${encodeURIComponent(JSON.stringify(opp))}')"><strong>+${opp.profitPercent.toFixed(2)}%</strong> ${opp.path.join(' → ')}<br>Max: $${opp.maxTradeSize.toFixed(2)} | Profit: $${opp.actualProfit.toFixed(2)}</div>`; },
        openTradeModal(oppStr){ /* ... full implementation ... */ },
        closeModal(){ document.getElementById('tradeModal').style.display = 'none'; },
        renderFiatCheckboxes(){ /* ... */ },
        toggleFiat(f){ /* ... */ },
        onProxyChange(){ /* ... */ },
        updateProxyStatus(){ /* ... */ },
        renderTradeLedger(){ /* ... */ },
        renderBasketTracker(){ /* ... */ },
        renderBatchHistory(){ /* ... */ },
        renderCoinExCheckboxes(){ /* ... */ },
        updateCoinCooldown(){ /* ... */ },
        renderPlayerList(){ /* ... */ },
        showPlayerDetail(id){ /* ... */ },
        togglePanel(id){ const p=document.getElementById(id); p.style.display=p.style.display==='block'?'none':'block'; if(id==='ipnsPanel'&&p.style.display==='block') generateQRCode(); },
        closePanel(id){ document.getElementById(id).style.display='none'; },
        updateManaDisplay(){ /* ... */ }
    };
    // Complete the missing UI methods with full logic:
    (function completeUI() {
        UI.openTradeModal = function(oppStr) {
            const opp = JSON.parse(decodeURIComponent(oppStr));
            const bet = Math.min(opp.maxTradeSize, parseFloat(document.getElementById('betInput').value) || 1000);
            const sz = bet; let rt = sz; let ms = `Start: $${sz.toFixed(2)}<br>`; let valid = true;
            const dh = opp.edges.map((e,i) => {
                const p = rt; rt *= e.rate;
                const suspicious = (e.rate > 1e4 || e.rate < 1e-4 || !isFinite(e.rate));
                if (suspicious) valid = false;
                ms += `Hop ${i+1}: $${p.toFixed(2)} × ${e.rate.toFixed(6)} → $${rt.toFixed(2)}${suspicious?' ⚠️':''}<br>`;
                return `<div>${opp.path[i]} → ${opp.path[i+1]} | Liq: $${e.liquidity.toFixed(0)}${suspicious?' ⚠️ SUSPECT RATE':''}</div>`;
            }).join('');
            document.getElementById('tradeDetails').innerHTML = `<p>🔄 ${opp.path.join(' → ')}</p><p>💵 $${sz.toFixed(2)}</p>${dh}`;
            document.getElementById('compoundingMath').innerHTML = ms + `<strong>💰 Final: $${rt.toFixed(2)}</strong>`;
            const rateWarn = document.getElementById('rateWarning');
            rateWarn.innerHTML = !valid ? '<span style="color:#ffaa00;">⚠️ Anomalous rates detected.</span>' : '';
            const conflictWarn = document.getElementById('conflictWarning');
            const conflicts = State.highlightedPaths.filter(p => p !== opp.path && p.some(n => opp.path.includes(n)));
            conflictWarn.innerHTML = conflicts.length ? `<span style="color:#ff4444;">⚠️ Shares nodes with ${conflicts.length} other payline(s).</span>` : '';
            document.getElementById('executeTradeBtn').onclick = async () => {
                const now = Date.now();
                if (now - State.lastTradeExecTime < 4000) { log('⏳ Trade blocked', 'warning'); return; }
                if (State.bankroll <= 0) { log('❌ Bankroll exhausted', 'error'); return; }
                State.lastTradeExecTime = now;
                UI.logButton('EXECUTE TRADE');
                closeModal();
                await Engine.executeTrade(opp, sz, rt - sz);
            };
            document.getElementById('tradeModal').style.display = 'flex';
        };
        UI.renderFiatCheckboxes = function() {
            const c = document.getElementById('fiatCheckboxes');
            const f = ['RUB','INR','EUR','GBP','JPY','CNY','KRW','AUD','CAD','CHF','AED','TRY','BRL','SGD','PLN'];
            c.innerHTML = f.map(x => `<label><input type="checkbox" value="${x}" ${State.selectedFiats.has(x)?'checked':''} onchange="UI.toggleFiat('${x}')"> ${x}</label>`).join('');
        };
        UI.toggleFiat = function(f) {
            State.selectedFiats.has(f) ? State.selectedFiats.delete(f) : State.selectedFiats.add(f);
            State.save(); log(`🖱️ Fiat: ${f}`);
            State.startAutoForex();
            if (!Object.keys(State.forexRates).length) fetchForexRates();
        };
        UI.onProxyChange = function() {
            const m = document.getElementById('proxySelect').value;
            State.proxyMode = m;
            document.getElementById('corsProxyUrl').style.display = m === 'custom' ? 'inline-block' : 'none';
            this.updateProxyStatus();
            State.save();
            log(`🖱️ Proxy: ${m}`);
        };
        UI.updateProxyStatus = function() {
            const e = document.getElementById('proxyStatusMsg');
            if (!e) return;
            e.textContent = State.proxyMode === 'direct' ? '⚡ Direct + fallback' : State.proxyMode === 'builtin' ? `🔁 Rotating: ${BUILTIN_PROXIES[currentProxyIndex]}` : '📝 Custom proxy';
        };
        UI.renderTradeLedger = function() {
            const e = document.getElementById('tradeLedger');
            if (!e) return;
            if (!State.tradeLedger.length) { e.innerHTML = 'No trades yet.'; return; }
            e.innerHTML = State.tradeLedger.slice(0,15).map(x =>
                `<div>${x.time.slice(11,19)} ${x.type} ${x.path} <span style="color:${x.profit>=0?'var(--green)':'#ff4444'}">$${x.profit.toFixed(2)}</span> ${x.testnet?'🧪':x.live?'🔴':''}</div>`
            ).join('');
        };
        UI.renderBasketTracker = function() {
            const e = document.getElementById('basketTracker'), v = document.getElementById('basketValue');
            if (!e || !v) return;
            const h = State.basketHoldings;
            if (!Object.keys(h).length) { e.innerHTML = 'No purchases yet'; v.innerHTML = ''; return; }
            let totalValue = 0;
            e.innerHTML = Object.entries(h).map(([k, amt]) => {
                const price = State.getAssetPrice(k); const value = amt * price; totalValue += value;
                const acq = State.acquisitionPaths[k]?.slice(-1)[0]?.path || 'unknown';
                return `<div>📦 ${k}: ${amt.toFixed(6)} ($${value.toFixed(2)})<br><small>via ${acq}</small></div>`;
            }).join('');
            v.innerHTML = `💰 Total value: $${totalValue.toFixed(2)}`;
        };
        UI.renderBatchHistory = function() {
            const e = document.getElementById('batchHistory');
            if (!e) return;
            if (!State.batchHistory.length) { e.innerHTML = 'No batch executions yet.'; return; }
            e.innerHTML = State.batchHistory.map(h =>
                `<div style="margin:3px 0;padding:3px;background:#0a0a1a;border-radius:3px;"><strong>${h.time}</strong> — ${h.lines} lines — Profit: <span style="color:${h.profit>=0?'var(--green)':'#ff4444'}">$${h.profit.toFixed(2)}</span> — Targets: ${h.targets||'none'}</div>`
            ).join('');
        };
        UI.renderCoinExCheckboxes = function() {
            const c = document.getElementById('coinExCheckboxes'); if (!c) return;
            const allExs = Object.keys(State.exchanges).filter(k => State.exchanges[k].parser !== 'coingecko' && State.exchanges[k].parser !== 'coinlore');
            c.innerHTML = allExs.map(k => {
                const checked = State.coinExchangeList.includes(k) ? 'checked' : '';
                return `<label><input type="checkbox" value="${k}" ${checked} onchange="toggleCoinEx('${k}')"> ${State.exchanges[k].name}</label>`;
            }).join('');
        };
        UI.updateCoinCooldown = function() {
            const cdEl = document.getElementById('coinCooldown'); if (!cdEl) return;
            const btn = document.getElementById('createCoinBtn');
            const cooldown = State.getCoinCooldown();
            if (State.level < 5) { cdEl.textContent = '🔒 Unlock at Level 5'; btn.disabled = true; return; }
            if (State.userCoins.length >= 1 && State.level < 15) { cdEl.textContent = '🔒 2nd coin at Lv.15'; btn.disabled = true; return; }
            const elapsed = (Date.now() - State.lastCoinCreateTime) / 1000;
            const remaining = Math.max(0, cooldown - elapsed);
            if (remaining > 0) { cdEl.textContent = `⏳ Cooldown: ${Math.ceil(remaining)}s`; btn.disabled = true; }
            else { cdEl.textContent = ''; btn.disabled = false; }
        };
        UI.renderPlayerList = function() {
            const el = document.getElementById('playerList'); if (!el) return;
            let html = '';
            for (const [id, p] of Object.entries(State.otherPlayers)) {
                const handle = p.handle || id.slice(0,6);
                html += `<div class="player-row" onclick="UI.showPlayerDetail('${id}')">${handle} (LVL ${p.level||1}) | Bankroll: $${(p.bankroll||0).toFixed(2)} | Mana: C${p.mana?.compute||0} D${p.mana?.data||0} T${p.mana?.trade||0}</div>`;
            }
            el.innerHTML = html || 'No peers yet';
        };
        UI.showPlayerDetail = function(id) {
            const p = State.otherPlayers[id]; if (!p) return;
            alert(`Player: ${p.handle||id.slice(0,6)}\nLevel: ${p.level}\nBankroll: $${(p.bankroll||0).toFixed(2)}\nMatrix: ${p.matrix}\nBasket: ${JSON.stringify(p.basketHoldings||{})}\nRecent trades: ${(p.tradeLedger||[]).slice(0,3).map(t=>t.path).join(', ')}`);
        };
        UI.updateManaDisplay = function() {
            document.getElementById('nodeIdDisplay').textContent = NODE_ID;
            document.getElementById('computeMana').textContent = State.mana.compute;
            document.getElementById('dataMana').textContent = State.mana.data;
            document.getElementById('tradeMana').textContent = State.mana.trade;
        };
    })();

    // ── PROXY & FETCH ──────────────────────────────────────────
    const CORS_OK_EXCHANGES = new Set(['okx','coinbase','binance','kucoin','gemini','bitstamp','kraken','dexscreener_eth','dexscreener_bsc','dexscreener_polygon','dexscreener_arb','dexscreener_sol','coingecko','coinpaprika','coinlore']);
    const BUILTIN_PROXIES = ['https://corsproxy.io/?','https://api.allorigins.win/raw?url='];
    let currentProxyIndex = 0;
    function getEffectiveProxyUrl(){ if(State.proxyMode==='custom'){ const c=(document.getElementById('corsProxyUrl').value||'').trim(); if(c&&!c.includes('placeholder'))return c; return null; } if(State.proxyMode==='builtin')return BUILTIN_PROXIES[currentProxyIndex]; return null; }
    function rotateProxy(){ currentProxyIndex=(currentProxyIndex+1)%BUILTIN_PROXIES.length; UI.updateProxyStatus(); }
    async function smartFetch(url,options={},isCorsSafe=false){
        if(isCorsSafe||State.proxyMode==='direct'){ try{ const r=await fetch(url,options); if(r.ok)return r; if(r.status>=400)throw new Error('HTTP '+r.status); }catch(e){} }
        const proxy=getEffectiveProxyUrl(); if(proxy){ try{ const r=await fetch(proxy+encodeURIComponent(url),options); if(!r.ok)throw new Error('Proxy HTTP '+r.status); const text=await r.text(); if(text.startsWith('<')||text.includes('corsdemo'))throw new Error('Non-JSON'); try{ return new Response(JSON.stringify(JSON.parse(text)),{status:200,headers:{'Content-Type':'application/json'}}); }catch{ return new Response(text,{status:200,headers:{'Content-Type':'text/plain'}}); } }catch(e){ rotateProxy(); } }
        throw new Error('All fetch attempts exhausted');
    }

    // ── EXCHANGE DEFINITIONS (merged from both versions) ───────
    const KNOWN_QUOTES = ['USDT','USDC','BUSD','GUSD','USD','BTC','ETH','BNB','SOL','EUR','GBP','JPY','KRW','AUD','CAD','CHF','RUB','INR','TRY','BRL','IDR','DAI','SGD','PLN','UAH','AED','BETH','ZEC','ZRX','RAY','STRK','MATIC','DOT','TRB','TON','PI','LTC','XRP','SHIB','DOGE','BONK','PEPE','FLOKI','WIN','SATS','NEIRO','CAT','DUCK','BOME','OMI','DEGEN','NOT','MEME','TOSHI','MEW','HMSTR','XCHNG','WBNB','RNDR','LINK','JITOSOL','LINEA','HYPE','PNUT','POL','TRUMP','POPCAT','CTX','JUP','GALA','FTM','FET','SAND','GRT','CRV','LTC','XTZ','SUI','XCH','AVAX','WIF','UNI','FIL','STX','OP','TON','LINK','LPT','ENS','WLFI','ZEC','PENGU','APE','GOAT','MOODENG','MANA','INJ','ATOM','AAVE','TRX','SKY','CHZ','SEI','ZETA','ARB','XDC','BONK','PEPE','SHIB','FLR','VIRTUAL','NEAR','ADA','HBAR','API3','STORJ','IMX','LDO','MON','BCH','PUMP','MASK','OFC','COMP','JUP','DOT','USDG','BAT','BABYDOGE','ALGO','RLUSD','TRAC','SKL','CTSI','MEW','CXT','PYTH','KITE','DIRT','WOW','ARRR','TRON','MEME'];
    KNOWN_QUOTES.sort((a,b)=>b.length-a.length);
    function parsePairSymbol(rawSymbol){ const s=(rawSymbol||'').toUpperCase().replace(/[^A-Z0-9]/g,''); if(!s)return null; for(const q of KNOWN_QUOTES){ if(s.endsWith(q)&&s.length>q.length){ const b=s.slice(0,s.length-q.length); if(b.length>=1&&b!==q)return{base:b,target:q}; } } const p=s.split(/[_-]/); if(p.length>=2)return{base:p[0],target:p.slice(1).join('_')}; return null; }

    const exchangeDefs = [
        {key:'okx',name:'OKX',url:'https://www.okx.com/api/v5/market/tickers?instType=SPOT',parser:'okx'},
        {key:'coinbase',name:'Coinbase',url:'https://api.exchange.coinbase.com/products',parser:'coinbase'},
        {key:'binance',name:'Binance',url:'https://api.binance.com/api/v3/ticker/24hr',parser:'binance'},
        {key:'kucoin',name:'KuCoin',url:'https://api.kucoin.com/api/v1/market/allTickers',parser:'kucoin'},
        {key:'bybit',name:'Bybit',url:'https://api.bybit.com/v5/market/tickers?category=spot',parser:'bybit'},
        {key:'gate',name:'Gate.io',url:'https://api.gateio.ws/api/v4/spot/tickers',parser:'gate'},
        {key:'mexc',name:'MEXC',url:'https://api.mexc.com/api/v3/ticker/24hr',parser:'mexc'},
        {key:'kraken',name:'Kraken',url:'https://api.kraken.com/0/public/Ticker?pair=ALL',parser:'kraken'},
        {key:'bitstamp',name:'Bitstamp',url:'https://www.bitstamp.net/api/v2/ticker/',parser:'bitstamp'},
        {key:'indodax',name:'Indodax',url:'https://indodax.com/api/tickers',parser:'indodax'},
        {key:'yobit',name:'Yobit',url:'https://yobit.net/api/3/info',parser:'yobit'},
        {key:'pumpfun',name:'Pump.fun',url:'https://frontend-api.pump.fun/coins?offset=0&limit=100&sort=created_timestamp&order=DESC',parser:'pumpfun',auth:true},
        {key:'poloniex',name:'Poloniex',url:'https://api.poloniex.com/markets/ticker24h',parser:'poloniex'},
        {key:'huobi',name:'Huobi',url:'https://api.huobi.pro/market/tickers',parser:'huobi'},
        {key:'gemini',name:'Gemini',url:'https://api.gemini.com/v1/pricefeed',parser:'gemini'},
        {key:'ascendex',name:'AscendEX',url:'https://ascendex.com/api/pro/v1/ticker',parser:'ascendex'},
        {key:'digifinex',name:'Digifinex',url:'https://openapi.digifinex.com/v3/ticker',parser:'digifinex'},
        {key:'bittrex',name:'Bittrex',url:'https://api.bittrex.com/v3/markets/tickers',parser:'bittrex'},
        {key:'crypto.com',name:'Crypto.com',url:'https://api.crypto.com/v2/public/get-ticker',parser:'cryptocom'},
        {key:'dexscreener_eth',name:'DexScreener ETH',url:'https://api.dexscreener.com/latest/dex/search?q=ETH',parser:'dexscreener'},
        {key:'dexscreener_bsc',name:'DexScreener BSC',url:'https://api.dexscreener.com/latest/dex/search?q=BNB',parser:'dexscreener'},
