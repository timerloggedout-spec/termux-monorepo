graph TD
    subgraph "User Devices (Browsers)"
        U1["Device 1: Full Node<br/>(Market Relay + Executor)"]
        U2["Device 2: Full Node<br/>(Market Relay + Executor)"]
        UN["Device N..."]
    end

    subgraph "P2P Data Layers"
        Gossip["GossipSub Market Feed<br/>(real-time ticks)"]
        Torrent["WebTorrent Swarm<br/>(historical OHLCV)"]
        YjsRoom["Yjs CRDT<br/>(game state, mana, orders)"]
        WebRTC["WebRTC Data Channels<br/>(private strategies, compute)"]
    end

    U1 <--> Gossip
    U2 <--> Gossip
    UN <--> Gossip
    U1 <--> Torrent
    U2 <--> Torrent
    UN <--> Torrent
    U1 <--> YjsRoom
    U2 <--> YjsRoom
    UN <--> YjsRoom
    U1 <-.->|private strategy room| WebRTC
    U2 <-.->|private strategy room| WebRTC

    subgraph "Internal DEX"
        OB["Order Book (Yjs)"]
        U1 --> OB
        U2 --> OB
        UN --> OB
    end

    subgraph "Mana Accounting"
        Mana["Mana Ledger (Yjs)"]
        U1 --> Mana
        U2 --> Mana
        UN --> Mana
    end
