<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@TheAGVibe1 | Gregory Gordon & Apryl - Kung Fu Cinema</title>
    <style>
        :root {
            --bg: #0a0a0a;
            --surface: #141414;
            --surface2: #1c1c1c;
            --gold: #c9a84c;
            --gold-light: #e0c878;
            --gold-dark: #8b6914;
            --text: #e0ddd5;
            --text-muted: #a09b8c;
            --text-bright: #f5f0e8;
            --accent-red: #8b1a1a;
            --accent-red-light: #c0392b;
            --border: #2a2820;
            --border-gold: #3d3520;
            --font-heading: 'Cinzel', 'Georgia', 'Times New Roman', serif;
            --font-body: 'Inter', 'Segoe UI', 'Helvetica Neue', sans-serif;
            --font-accent: 'Cormorant Garamond', 'Garamond', serif;
            --shadow-gold: 0 4px 20px rgba(201, 168, 76, 0.15);
            --shadow-lg: 0 20px 60px rgba(0, 0, 0, 0.6);
            --radius: 12px;
            --radius-sm: 8px;
            --transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            background-color: var(--bg);
            color: var(--text);
            font-family: var(--font-body);
            line-height: 1.7;
            overflow-x: hidden;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        /* Subtle background texture */
        body::before {
            content: '';
            position: fixed;
            inset: 0;
            background:
                radial-gradient(ellipse at 30% 20%, rgba(201, 168, 76, 0.03) 0%, transparent 60%),
                radial-gradient(ellipse at 70% 60%, rgba(139, 26, 26, 0.04) 0%, transparent 60%),
                radial-gradient(ellipse at 50% 80%, rgba(201, 168, 76, 0.02) 0%, transparent 50%);
            pointer-events: none;
            z-index: 0;
        }

        body::after {
            content: '';
            position: fixed;
            inset: 0;
            background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M30 5 L55 55 L5 55 Z' fill='none' stroke='rgba(201,168,76,0.03)' stroke-width='1'/%3E%3C/svg%3E");
            background-size: 80px 80px;
            pointer-events: none;
            z-index: 0;
            opacity: 0.5;
        }

        .container {
            position: relative;
            z-index: 1;
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 24px;
        }

        /* ─── NAVIGATION ─────────────────────── */
        .nav {
            position: sticky;
            top: 0;
            z-index: 100;
            background: rgba(10, 10, 10, 0.85);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-bottom: 1px solid var(--border);
            padding: 14px 0;
            transition: var(--transition);
        }

        .nav-inner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 16px;
        }

        .nav-brand {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
            color: var(--text-bright);
        }

        .nav-logo-icon {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--gold-dark), var(--gold));
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: var(--font-heading);
            font-weight: 900;
            font-size: 1.1rem;
            color: #0a0a0a;
            letter-spacing: -0.5px;
            flex-shrink: 0;
            box-shadow: 0 0 20px rgba(201, 168, 76, 0.3);
        }

        .nav-brand-text {
            font-family: var(--font-heading);
            font-weight: 700;
            font-size: 1rem;
            letter-spacing: 0.04em;
            color: var(--gold-light);
            line-height: 1.2;
        }
        .nav-brand-text small {
            display: block;
            font-family: var(--font-body);
            font-weight: 400;
            font-size: 0.7rem;
            letter-spacing: 0.06em;
            color: var(--text-muted);
        }

        .nav-links {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        .nav-links a {
            color: var(--text-muted);
            text-decoration: none;
            padding: 8px 16px;
            border-radius: 6px;
            font-size: 0.85rem;
            font-weight: 500;
            letter-spacing: 0.03em;
            transition: var(--transition);
            white-space: nowrap;
            border: 1px solid transparent;
        }

        .nav-links a:hover,
        .nav-links a.active {
            color: var(--gold-light);
            background: rgba(201, 168, 76, 0.08);
            border-color: var(--border-gold);
        }

        .nav-yt-btn {
            background: var(--accent-red);
            color: #fff !important;
            padding: 8px 18px !important;
            border-radius: 6px !important;
            font-weight: 600 !important;
            transition: var(--transition);
            border: none !important;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .nav-yt-btn:hover {
            background: var(--accent-red-light) !important;
            color: #fff !important;
            box-shadow: 0 0 20px rgba(192, 57, 43, 0.4);
        }
        .nav-yt-btn .yt-icon {
            width: 18px;
            height: 18px;
            fill: #fff;
        }

        /* ─── HERO ──────────────────────────── */
        .hero {
            text-align: center;
            padding: 80px 20px 60px;
            position: relative;
        }

        .hero-badge {
            display: inline-block;
            background: rgba(201, 168, 76, 0.1);
            border: 1px solid var(--border-gold);
            color: var(--gold-light);
            padding: 6px 18px;
            border-radius: 50px;
            font-size: 0.8rem;
            letter-spacing: 0.08em;
            font-weight: 600;
            margin-bottom: 24px;
            text-transform: uppercase;
        }

        .hero h1 {
            font-family: var(--font-heading);
            font-size: clamp(2.2rem, 5vw, 3.8rem);
            font-weight: 900;
            letter-spacing: 0.03em;
            color: var(--text-bright);
            margin-bottom: 8px;
            line-height: 1.15;
        }

        .hero h1 .gold {
            color: var(--gold-light);
            position: relative;
        }
        .hero h1 .gold::after {
            content: '';
            position: absolute;
            bottom: 2px;
            left: 0;
            right: 0;
            height: 3px;
            background: var(--gold);
            opacity: 0.5;
            border-radius: 6px;
        }

        .hero .tagline {
            font-family: var(--font-accent);
            font-size: 1.3rem;
            color: var(--text-muted);
            font-style: italic;
            letter-spacing: 0.04em;
            margin-bottom: 16px;
        }

        .hero .channel-link {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: var(--gold-light);
            text-decoration: none;
            font-weight: 600;
            font-size: 1rem;
            padding: 10px 22px;
            border: 2px solid var(--border-gold);
            border-radius: 50px;
            transition: var(--transition);
            margin-top: 8px;
        }
        .hero .channel-link:hover {
            background: rgba(201, 168, 76, 0.08);
            box-shadow: var(--shadow-gold);
            border-color: var(--gold);
        }
        .hero .channel-link svg {
            width: 20px;
            height: 20px;
            fill: var(--gold-light);
        }

        .hero-divider {
            width: 80px;
            height: 3px;
            background: linear-gradient(90deg, transparent, var(--gold), transparent);
            margin: 24px auto;
            border-radius: 6px;
        }

        /* ─── SECTION TITLES ────────────────── */
        .section-title {
            font-family: var(--font-heading);
            font-size: 1.6rem;
            font-weight: 700;
            letter-spacing: 0.04em;
            color: var(--text-bright);
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .section-title .icon {
            width: 36px;
            height: 36px;
            border-radius: 8px;
            background: rgba(201, 168, 76, 0.12);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
            flex-shrink: 0;
        }
        .section-subtitle {
            color: var(--text-muted);
            font-family: var(--font-accent);
            font-style: italic;
            font-size: 1rem;
            margin-bottom: 32px;
            letter-spacing: 0.03em;
        }

        /* ─── BIO CARDS ─────────────────────── */
        .bio-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 28px;
            margin-bottom: 60px;
        }

        .bio-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 32px 28px;
            position: relative;
            overflow: hidden;
            transition: var(--transition);
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
        }
        .bio-card:hover {
            border-color: var(--border-gold);
            box-shadow: var(--shadow-gold), 0 4px 16px rgba(0, 0, 0, 0.4);
            transform: translateY(-2px);
        }
        .bio-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, var(--gold-dark), var(--gold-light), var(--gold-dark));
            opacity: 0.7;
        }
        .bio-card.gregory::before {
            background: linear-gradient(90deg, #8b6914, #e0c878, #c9a84c);
        }
        .bio-card.apryl::before {
            background: linear-gradient(90deg, #c9a84c, #f0d890, #c9a84c);
        }

        .bio-avatar-row {
            display: flex;
            align-items: center;
            gap: 16px;
            margin-bottom: 20px;
        }
        .bio-avatar {
            width: 64px;
            height: 64px;
            border-radius: 50%;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: var(--font-heading);
            font-weight: 900;
            font-size: 1.5rem;
            color: #0a0a0a;
        }
        .bio-avatar.gregory-av {
            background: linear-gradient(135deg, #5a4a1a, #c9a84c);
        }
        .bio-avatar.apryl-av {
            background: linear-gradient(135deg, #c9a84c, #f5e0a0);
        }

        .bio-name {
            font-family: var(--font-heading);
            font-size: 1.3rem;
            font-weight: 700;
            letter-spacing: 0.03em;
            color: var(--text-bright);
            margin: 0;
        }
        .bio-role {
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--gold-light);
            font-weight: 600;
        }
        .bio-imdb {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: #e5b81b;
            color: #000;
            font-weight: 700;
            font-size: 0.75rem;
            padding: 4px 10px;
            border-radius: 4px;
            text-decoration: none;
            letter-spacing: 0.04em;
            transition: var(--transition);
            margin-top: 6px;
        }
        .bio-imdb:hover {
            background: #f5c930;
            box-shadow: 0 0 12px rgba(229, 184, 27, 0.5);
        }
        .bio-text {
            color: var(--text);
            font-size: 0.9rem;
            line-height: 1.6;
        }
        .bio-text p {
            margin-bottom: 10px;
        }
        .bio-highlights {
            list-style: none;
            padding: 0;
            margin-top: 12px;
        }
        .bio-highlights li {
            padding: 5px 0 5px 20px;
            position: relative;
            font-size: 0.85rem;
            color: var(--text-muted);
        }
        .bio-highlights li::before {
            content: '◆';
            position: absolute;
            left: 0;
            color: var(--gold);
            font-size: 0.5rem;
            top: 10px;
        }

        /* ─── CATEGORY TABS ────────────────── */
        .tabs-wrapper {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            margin-bottom: 32px;
            padding-bottom: 8px;
            border-bottom: 1px solid var(--border);
        }
        .tab-btn {
            padding: 10px 22px;
            border-radius: 50px;
            border: 1px solid var(--border);
            background: transparent;
            color: var(--text-muted);
            cursor: pointer;
            font-family: var(--font-body);
            font-weight: 500;
            font-size: 0.85rem;
            letter-spacing: 0.03em;
            transition: var(--transition);
            white-space: nowrap;
        }
        .tab-btn:hover {
            border-color: var(--border-gold);
            color: var(--gold-light);
            background: rgba(201, 168, 76, 0.05);
        }
        .tab-btn.active {
            background: var(--gold);
            color: #0a0a0a;
            border-color: var(--gold);
            font-weight: 700;
            box-shadow: var(--shadow-gold);
        }
        .tab-count {
            font-size: 0.7rem;
            opacity: 0.7;
            margin-left: 4px;
        }

        /* ─── VIDEO GRID ────────────────────── */
        .video-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 24px;
            margin-bottom: 60px;
        }

        .video-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            overflow: hidden;
            transition: var(--transition);
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
            display: flex;
            flex-direction: column;
        }
        .video-card:hover {
            border-color: var(--border-gold);
            box-shadow: var(--shadow-gold), 0 8px 32px rgba(0, 0, 0, 0.5);
            transform: translateY(-4px);
        }
        .video-thumb {
            position: relative;
            aspect-ratio: 16/9;
            background: var(--surface2);
            overflow: hidden;
            cursor: pointer;
        }
        .video-thumb img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.4s ease;
        }
        .video-card:hover .video-thumb img {
            transform: scale(1.04);
        }
        .video-thumb .play-overlay {
            position: absolute;
            inset: 0;
            background: rgba(0, 0, 0, 0.5);
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            transition: var(--transition);
        }
        .video-card:hover .play-overlay {
            opacity: 1;
        }
        .play-overlay .play-btn {
            width: 56px;
            height: 56px;
            border-radius: 50%;
            background: rgba(201, 168, 76, 0.9);
            display: flex;
            align-items: center;
            justify-content: center;
            transition: var(--transition);
        }
        .play-overlay .play-btn::after {
            content: '';
            width: 0;
            height: 0;
            border-left: 18px solid #0a0a0a;
            border-top: 10px solid transparent;
            border-bottom: 10px solid transparent;
            margin-left: 4px;
        }
        .video-card:hover .play-btn {
            transform: scale(1.1);
            box-shadow: 0 0 30px rgba(201, 168, 76, 0.6);
        }
        .video-duration {
            position: absolute;
            bottom: 10px;
            right: 10px;
            background: rgba(0, 0, 0, 0.8);
            color: #fff;
            padding: 2px 8px;
            border-radius: 4px;
            font-size: 0.7rem;
            font-weight: 600;
            letter-spacing: 0.03em;
        }
        .video-category-tag {
            position: absolute;
            top: 10px;
            left: 10px;
            padding: 4px 10px;
            border-radius: 4px;
            font-size: 0.7rem;
            font-weight: 700;
            letter-spacing: 0.04em;
            text-transform: uppercase;
        }
        .tag-movie {
            background: #8b1a1a;
            color: #fff;
        }
        .tag-style {
            background: #1a5c2a;
            color: #e0f0e0;
        }
        .tag-training {
            background: #1a3a5c;
            color: #d0e0f0;
        }

        .video-info {
            padding: 16px 18px;
            flex: 1;
            display: flex;
            flex-direction: column;
        }
        .video-title {
            font-weight: 600;
            font-size: 1rem;
            color: var(--text-bright);
            margin-bottom: 4px;
            line-height: 1.3;
            letter-spacing: 0.01em;
        }
        .video-meta {
            font-size: 0.75rem;
            color: var(--text-muted);
            margin-bottom: 6px;
        }
        .video-desc {
            font-size: 0.8rem;
            color: var(--text-muted);
            flex: 1;
            line-height: 1.4;
        }
        .video-stats {
            display: flex;
            gap: 14px;
            margin-top: 10px;
            font-size: 0.7rem;
            color: var(--text-muted);
            align-items: center;
        }
        .video-stats span {
            display: flex;
            align-items: center;
            gap: 4px;
        }

        /* ─── YOUTUBE EMBED SECTION ────────── */
        .embed-section {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 28px;
            margin-bottom: 60px;
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
        }
        .embed-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
            gap: 24px;
        }
        .embed-item {
            border-radius: var(--radius-sm);
            overflow: hidden;
            background: #000;
            aspect-ratio: 16/9;
            position: relative;
        }
        .embed-item iframe {
            width: 100%;
            height: 100%;
            border: none;
        }
        .embed-placeholder {
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--surface2);
            color: var(--text-muted);
            font-size: 0.9rem;
            text-align: center;
            padding: 20px;
            cursor: pointer;
            transition: var(--transition);
        }
        .embed-placeholder:hover {
            color: var(--gold-light);
            background: #1a1a1a;
        }
        .embed-label {
            text-align: center;
            font-weight: 600;
            font-size: 0.85rem;
            color: var(--gold-light);
            margin-top: 8px;
            letter-spacing: 0.03em;
        }

        /* ─── FOOTER ────────────────────────── */
        .footer {
            text-align: center;
            padding: 40px 20px;
            border-top: 1px solid var(--border);
            color: var(--text-muted);
            font-size: 0.8rem;
            letter-spacing: 0.03em;
        }
        .footer a {
            color: var(--gold-light);
            text-decoration: none;
            font-weight: 600;
        }
        .footer a:hover {
            text-decoration: underline;
        }
        .footer-social {
            display: flex;
            justify-content: center;
            gap: 16px;
            margin-bottom: 16px;
            flex-wrap: wrap;
        }
        .footer-social a {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 8px 16px;
            border-radius: 50px;
            border: 1px solid var(--border);
            transition: var(--transition);
            font-size: 0.8rem;
        }
        .footer-social a:hover {
            border-color: var(--gold);
            background: rgba(201, 168, 76, 0.06);
            text-decoration: none;
        }

        /* ─── RESPONSIVE ────────────────────── */
        @media (max-width: 768px) {
            .bio-grid {
                grid-template-columns: 1fr;
            }
            .nav-inner {
                flex-direction: column;
                gap: 10px;
            }
            .nav-links {
                justify-content: center;
            }
            .hero {
                padding: 50px 16px 40px;
            }
            .hero h1 {
                font-size: 1.8rem;
            }
            .video-grid {
                grid-template-columns: 1fr;
            }
            .embed-grid {
                grid-template-columns: 1fr;
            }
            .tabs-wrapper {
                justify-content: center;
            }
        }

        @media (max-width: 480px) {
            .section-title {
                font-size: 1.2rem;
            }
            .bio-card {
                padding: 20px 16px;
            }
            .tab-btn {
                padding: 8px 14px;
                font-size: 0.75rem;
            }
        }

        /* ─── ANIMATIONS ────────────────────── */
        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(24px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        .video-card {
            animation: fadeInUp 0.5s ease forwards;
        }
        .video-card:nth-child(1) {
            animation-delay: 0s;
        }
        .video-card:nth-child(2) {
            animation-delay: 0.08s;
        }
        .video-card:nth-child(3) {
            animation-delay: 0.16s;
        }
        .video-card:nth-child(4) {
            animation-delay: 0.24s;
        }
        .video-card:nth-child(5) {
            animation-delay: 0.32s;
        }
        .video-card:nth-child(6) {
            animation-delay: 0.4s;
        }
        .video-card:nth-child(7) {
            animation-delay: 0.48s;
        }
        .video-card:nth-child(8) {
            animation-delay: 0.56s;
        }
        .video-card:nth-child(9) {
            animation-delay: 0.64s;
        }
        .video-card.hidden-card {
            display: none;
        }
    </style>
</head>
<body>

    <!-- ─── NAVIGATION ─────────────────────── -->
    <nav class="nav">
        <div class="container nav-inner">
            <a href="#" class="nav-brand">
                <div class="nav-logo-icon">AG</div>
                <span class="nav-brand-text">The AG Vibe<small>@TheAGVibe1</small></span>
            </a>
            <div class="nav-links">
                <a href="#bios" class="active">Biographies</a>
                <a href="#videos">Kung Fu Shorts</a>
                <a href="#featured">Featured</a>
                <a href="https://www.youtube.com/@TheAGVibe1" target="_blank" rel="noopener" class="nav-yt-btn">
