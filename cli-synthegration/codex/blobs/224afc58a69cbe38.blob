// WorldMap.jsx
import React, { memo } from 'react';
import { ComposableMap, Geographies, Geography, ZoomableGroup } from 'react-simple-maps';

// Load the complete mapping from a separate file
import { countryToJurisdiction, getRegulatoryBodyInfo } from '../data/globalJurisdictionMap';

// Status color scale
const statusColors = {
  approved: '#22c55e',
  investigational: '#3b82f6',
  unapproved: '#ef4444',
  withdrawn: '#f59e0b',
  under_review: '#a78bfa', // For WLA/ICH members without direct data
  harmonised: '#818cf8',   // For countries with regulatory reliance
  unknown: '#94a3b8',
};

const WorldMap = ({ compound, onCountryClick }) => {
  const getStatusForCountry = (geo) => {
    const isoCode = geo.properties.ISO_A3;
    const jurisdictionKey = countryToJurisdiction[isoCode];
    
    // 1. Direct approval data for this jurisdiction (from compound prop)
    if (jurisdictionKey && compound[jurisdictionKey]?.status) {
      return compound[jurisdictionKey].status;
    }
    
    // 2. Proxy: Regulatory Maturity (WHO WLA, ICH Member)
    const regulatoryBody = getRegulatoryBodyInfo(isoCode);
    if (regulatoryBody?.isWLA) {
      return 'under_review'; // A WLA country is a strong proxy for having an advanced review process
    }
    if (regulatoryBody?.isICHMember) {
      return 'under_review'; // ICH membership also indicates a high level of regulatory maturity
    }
    
    // 3. Proxy: Regional Reliance (e.g., CARICOM, Gulf Health Council)
    // This would require an additional lookup table for regional blocs.
    // For this example, we default to 'unknown'.
    
    // 4. Default
    return 'unknown';
  };

  return (
    <div className="bg-gray-100 dark:bg-gray-800 rounded-xl p-4">
      <ComposableMap projection="geoMercator" width={800} height={500}>
        <ZoomableGroup center={[0, 20]} zoom={1.2}>
          <Geographies geography="/world-110m.json">
            {({ geographies }) =>
              geographies.map(geo => {
                const status = getStatusForCountry(geo);
                return (
                  <Geography
                    key={geo.rsmKey}
                    geography={geo}
                    fill={statusColors[status] || statusColors.unknown}
                    stroke="#FFFFFF"
                    strokeWidth={0.5}
                    style={{
                      default: { outline: 'none' },
                      hover: { fill: '#a855f7', outline: 'none', cursor: 'pointer' },
                      pressed: { outline: 'none' },
                    }}
                    onClick={() => onCountryClick(geo.properties.ISO_A3, status)}
                  />
                );
              })
            }
          </Geographies>
        </ZoomableGroup>
      </ComposableMap>
      {/* Legend */}
      <div className="flex justify-center gap-4 mt-4">
        {Object.entries(statusColors).map(([key, color]) => (
          <div key={key} className="flex items-center gap-1">
            <span className="w-4 h-4 rounded" style={{ backgroundColor: color }}></span>
            <span className="text-xs capitalize">{key.replace('_', ' ')}</span>
          </div>
        ))}
      </div>
    </div>
  );
};

export default memo(WorldMap);
