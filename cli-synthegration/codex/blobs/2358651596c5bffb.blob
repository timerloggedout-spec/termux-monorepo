// Example: Polling YouTube Live Chat and processing
const FilterEngine = require('./modules/filter-engine');
const filterRules = require('./modules/filter-engine/filter-rules');
const { execute } = require('./modules/command-handler/command-registry');
const YouTubeClient = require('./modules/api-clients/youtube-client');

const filter = new FilterEngine(filterRules);

async function pollLiveChat(user, liveChatId) {
    const yt = new YouTubeClient(user.tokens.accessToken);
    let pageToken = null;

    setInterval(async () => {
        const data = await yt.getLiveChatMessages(liveChatId, pageToken);
        pageToken = data.nextPageToken;

        for (const msg of data.items) {
            const message = {
                id: msg.id,
                text: msg.snippet.displayMessage,
                author: msg.authorDetails.displayName,
                platform: 'youtube',
                channelId: msg.snippet.liveChatId
            };

            // Step 1: Apply filters
            const filterResult = await filter.apply(message);
            if (!filterResult.allowed) {
                console.log(`Message filtered: ${filterResult.reason}`);
                continue;
            }

            // Step 2: Check for commands
            const response = await execute(message);
            if (response) {
                await yt.sendLiveChatMessage(liveChatId, response);
                console.log(`Responded to command: ${message.text}`);
            }
        }
    }, 5000); // Poll interval (respect quota limits)
}
