    def score_opportunity(self, opp, slippage, cpu, mem, latency, vol, exec_time):
        profit_score = float(opp['profit_percent'].strip('%')) / 100
        return profit_score - (slippage*10) - ((cpu+mem)/200) - (latency*5) - (vol*2) - (exec_time*10)
