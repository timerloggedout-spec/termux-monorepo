    <!-- ================= ODDS MAP ================= -->
    <h2>🎰 Slot Simulator: odds_map-n.py</h2>
    <details open>
        <summary>🎲 odds_map-n.py – payline odds calculator</summary>
        <pre><code class="language-python">import random

symbols = ['⚡️'] * 7 + ['🌌', '🔮', '💎', '🪐', '⭐', '🌟', '🚀']
paylines = [  # 28 predefined row patterns (0-6)
    [3,3,3,3,3], [2,2,2,2,2], [4,4,4,4,4], [1,1,1,1,1], [5,5,5,5,5],
    [0,1,2,3,4], [6,5,4,3,2], [2,3,4,3,2], [4,3,2,3,4], [0,0,0,0,0],
    [6,6,6,6,6], [1,2,3,4,5], [5,4,3,2,1], [0,1,0,1,0], [6,5,6,5,6],
    [1,0,1,0,1], [5,6,5,6,5], [0,2,4,6,5], [6,4,2,0,1], [3,2,1,2,3],
    [3,4,5,4,3], [2,1,0,1,2], [4,5,6,5,4], [1,3,5,3,1], [5,3,1,3,5],
    [5,4,4,4,5], [1,2,2,2,1], [7,7,7,7,7]
]

def simulate_spins(num_paylines, num_simulations=1000):
    wins = 0
    for _ in range(num_simulations):
        grid = [[random.choice(symbols) for _ in range(7)] for _ in range(5)]
        for i in range(num_paylines):
            pl = paylines[i]
            line = [grid[j][pl[j]] for j in range(5)]
            if all(s == line[0] for s in line):
                wins += 1
                break
    win_rate = wins / num_simulations
    odds = round(1 / win_rate) if win_rate > 0 else float('inf')
    return odds

payline_options = [1, 3, 6, 10, 15, 21, 28]
odds_map = {n: simulate_spins(n) for n in payline_options}
print(odds_map)  # e.g., {1: 245, 3: 82, 6: 41, ...}
</code></pre>
    </details>

