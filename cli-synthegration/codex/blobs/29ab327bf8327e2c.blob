<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>🎰 QuanTM FOAM v22.21 – XP Separation + FX Fix + Target Lists</title>
    <style>
        :root {
            --pink: #ff00ff;
            --cyan: #00f0ff;
            --green: #00ffaa;
            --gold: #ffd700;
            --bg: #0a0a1a;
            --card: #1a1a2a;
            --border: #2a2a3a;
        }
        * { margin:0; padding:0; box-sizing:border-box; }
        body { background:var(--bg); color:#a0a0ff; font-family:'Courier New',monospace; font-size:10px; overflow-x:hidden; }
        canvas#particleCanvas { position:fixed; top:0; left:0; width:100%; height:100%; pointer-events:none; z-index:9999; }
        .container { max-width:1500px; margin:0 auto; padding:8px; position:relative; z-index:1; }
        h1 { color:var(--gold); font-size:18px; text-shadow:0 0 12px var(--pink),0 0 20px var(--cyan); margin-bottom:4px; }
        .status-bar { padding:6px 12px; margin:6px 0; background:linear-gradient(145deg,#0a0a1a,#1a1a2a); border-radius:8px; border-left:4px solid var(--cyan); font-weight:bold; display:flex; justify-content:space-between; align-items:center; box-shadow:0 0 15px rgba(0,240,255,0.25); flex-wrap:wrap; }
        .controls { display:flex; flex-wrap:wrap; gap:5px; margin:6px 0; }
        button { background:#111; border:2px solid var(--pink); color:var(--pink); padding:6px 10px; border-radius:18px; font-size:9px; font-weight:bold; cursor:pointer; font-family:'Courier New',monospace; transition:all 0.2s; text-transform:uppercase; letter-spacing:1px; box-shadow:0 0 6px var(--pink); }
        button:hover { background:var(--pink); color:#000; box-shadow:0 0 18px var(--pink); }
        button:active { transform:scale(0.95); }
        button.cyan { border-color:var(--cyan); color:var(--cyan); box-shadow:0 0 6px var(--cyan); }
        button.cyan:hover { background:var(--cyan); color:#000; }
        button.live { border-color:#ff4444; color:#ff4444; animation:livePulse 1s infinite; }
        button.gold { border-color:var(--gold); color:var(--gold); box-shadow:0 0 10px var(--gold); font-size:11px; padding:8px 18px; }
        button.gold:hover { background:var(--gold); color:#000; box-shadow:0 0 25px var(--gold); }
        button.allin { border-color:#ff4444; color:#ff4444; box-shadow:0 0 10px #ff4444; font-size:11px; padding:8px 18px; }
        button.allin:hover { background:#ff4444; color:#000; box-shadow:0 0 25px #ff4444; }
        button.reset { border-color:#ffaa00; color:#ffaa00; box-shadow:0 0 8px #ffaa00; }
        button.reset:hover { background:#ffaa00; color:#000; box-shadow:0 0 20px #ffaa00; }
        @keyframes livePulse { 0%,100%{box-shadow:0 0 6px #ff4444;} 50%{box-shadow:0 0 16px #ff4444;} }
        button:disabled { opacity:0.4; cursor:not-allowed; }
        .grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(280px,1fr)); gap:8px; margin:8px 0; }
        .card { background:var(--card); border-radius:8px; padding:10px; border:1px solid var(--border); box-shadow:0 0 10px rgba(255,0,255,0.08); }
        .card h3 { color:var(--cyan); font-size:11px; margin-bottom:6px; }
        .exchange-status { display:flex; align-items:center; gap:5px; padding:3px; background:#0a0a1a; border-radius:4px; margin:2px 0; font-size:8px; border:1px solid #2a2a3a; }
        .indicator { width:6px; height:6px; border-radius:50%; background:#ff4444; box-shadow:0 0 5px #ff4444; }
        .indicator.online { background:var(--green); box-shadow:0 0 8px var(--green); animation:pulse 1.5s infinite; }
        .indicator.ws { background:#ff00ff; box-shadow:0 0 8px #ff00ff; animation:pulse 0.8s infinite; }
        @keyframes pulse { 0%,100%{opacity:1;box-shadow:0 0 6px var(--green);} 50%{opacity:0.4;box-shadow:0 0 14px var(--green);} }
        .stat { display:flex; justify-content:space-between; padding:2px 0; font-size:9px; }
        .stat-value { color:var(--gold); font-weight:bold; }
        .rolling-number { font-size:13px; color:var(--gold); font-weight:bold; }
        .opp-section { margin:6px 0; padding:6px; background:#0f0f1f; border-radius:5px; border:1px solid #2a2a3a; }
        .opp-header { display:flex; justify-content:space-between; padding:6px; background:#1a1a2a; border-radius:5px; cursor:pointer; font-weight:bold; color:var(--pink); font-size:9px; }
        .opp-list { max-height:280px; overflow-y:auto; }
        .opportunity { background:#111; padding:6px; margin:3px 0; border-radius:5px; border-left:3px solid var(--green); cursor:pointer; font-size:9px; }
        .opportunity:hover { border-left-color:var(--pink); background:#1a1a2a; }
        .opportunity.mega { border-left-color:var(--gold); animation:glow 1s infinite alternate; }
        @keyframes glow { from{box-shadow:0 0 3px var(--gold);} to{box-shadow:0 0 16px var(--gold);} }
        .log-container { background:#000; padding:6px; border-radius:5px; max-height:150px; overflow-y:auto; font-size:7px; margin-top:6px; }
        .modal { display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.85); z-index:10000; align-items:center; justify-content:center; }
        .modal-content { background:#1a1a2a; border:2px solid var(--pink); border-radius:10px; padding:16px; max-width:700px; width:95%; color:white; max-height:85vh; overflow-y:auto; }
        .flex-row { display:flex; gap:6px; align-items:center; flex-wrap:wrap; }
        input,select { background:#0a0a1a; border:1px solid var(--cyan); color:var(--cyan); padding:2px 5px; border-radius:3px; font-family:'Courier New',monospace; font-size:9px; }
        .checkbox-group { display:flex; flex-wrap:wrap; gap:3px; align-items:center; }
        .checkbox-group label { display:flex; align-items:center; gap:2px; font-size:7px; color:var(--cyan); }
        .tier-badge { display:inline-block; padding:1px 4px; border-radius:2px; font-size:6px; color:#000; margin-left:2px; }
        .tier-pico { background:#ffaa00; }
        .tier-femto { background:#ff00ff; }
        .tier-planck { background:#00f0ff; }
        .progress-bar { height:6px; background:#333; border-radius:3px; margin:3px 0; }
        .progress-fill { height:100%; background:var(--gold); border-radius:3px; width:0%; }
        .perk-unlocked { color:var(--green); }
        .perk-locked { color:#ff4444; text-decoration:line-through; }
        #graphSlotContainer { display:none; background:linear-gradient(180deg,#0a0a1a,#1a0a2a); border:3px solid var(--gold); border-radius:14px; padding:12px; margin:10px 0; text-align:center; box-shadow:0 0 30px rgba(255,215,0,0.3); position:relative; overflow:hidden; }
        #graphNetwork { display:block; margin:0 auto; position:relative; z-index:2; }
        #batchResult { background:#0a0a1a; border:1px solid var(--gold); border-radius:6px; padding:8px; margin-top:8px; font-size:8px; max-height:200px; overflow-y:auto; text-align:left; position:relative; z-index:2; }
        .target-preset { border:1px solid var(--cyan); padding:2px 6px; border-radius:10px; cursor:pointer; font-size:7px; color:var(--cyan); background:transparent; }
        .target-preset:hover { background:var(--cyan); color:#000; }
    </style>
</head>
<body>
    <canvas id="particleCanvas"></canvas>
    <div class="container">
        <h1>🎰 QUANTM FOAM <span style="font-size:11px;">v22.21 – XP Separation + FX Fix + Target Lists</span></h1>
        <div class="status-bar"><span id="mainStatus">🟡 STANDBY — Click INIT</span><div class="flex-row"><span style="font-size:8px;">VIRTUAL</span><input type="checkbox" id="liveToggle" onchange="UI.toggleLiveMode()"><span style="font-size:8px;">LIVE</span></div></div>
        <div class="controls">
            <button class="cyan" onclick="UI.logButton('INIT');initSystem()">🔄 INIT</button>
            <button id="scanBtn" onclick="UI.logButton('FULL SCAN');runFullScan()" disabled>🎲 SCAN</button>
            <button id="liveScanBtn" onclick="UI.logButton('LIVE SCAN');toggleLiveScan()">🔄 LIVE</button>
            <button onclick="UI.logButton('LIVE WS');connectAllWebSockets()">📡 WS</button>
            <button onclick="UI.logButton('CREATE COIN');openCreateCoinModal()">🪙 COIN</button>
            <button onclick="UI.logButton('GRAPH UI');UI.toggleGraphSlot()">🌐 GRAPH</button>
            <button onclick="UI.logButton('LOGS');toggleLogs()">📋 LOGS</button>
            <button onclick="UI.logButton('SHARE');shareJackpot()">📤 SHARE</button>
            <button onclick="UI.logButton('THEME');toggleTheme()">🎨</button>
            <button class="reset" onclick="Engine.resetPaperAccount()">🧹 RESET</button>
        </div>
        <div class="card" style="margin-bottom:6px;">
            <div class="flex-row"><label>🌐 FETCH:</label><select id="proxySelect" onchange="UI.onProxyChange()"><option value="direct">⚡ Direct</option><option value="builtin">🔁 Proxy</option><option value="custom">📝 Custom</option></select><input type="text" id="corsProxyUrl" placeholder="Proxy URL" style="display:none;width:180px;"><label>🔐 WALLET:</label><input type="text" id="walletProxyUrl" style="width:140px;"><label>🔗 Exec Path:</label><input type="text" id="execPath" value="/execute" style="width:70px;"><button onclick="UI.logButton('SAVE PROXY');saveProxyConfig()" class="cyan">SAVE</button></div>
            <div id="proxyStatusMsg"></div>
        </div>
        <div id="graphSlotContainer">
            <h3 style="color:var(--gold);">🌐 MULTI‑LINE GRAPH</h3>
            <canvas id="graphNetwork" width="700" height="380"></canvas>
            <div id="graphLegend">🟢 Size = purchase power | 🔆 Glow = profit | ⚠️ Dashed red = shared edge</div>
            <div>
                <label>🔗 Depth: <span id="slotDepthLabel2">5</span></label>
                <label><input type="checkbox" id="autoOpenTrade" checked> Auto‑open</label>
                <label><input type="checkbox" id="bellmanToggle" onchange="UI.logButton('Bellman toggle')"> Bellman‑Ford</label>
                <label>🎯 Target: <input type="text" id="targetAssetsInput" placeholder="e.g. BABYDOGE,USDT" style="width:140px;"></label>
                <div class="flex-row" style="display:inline-flex; gap:3px;">
                    <span class="target-preset" onclick="setTargetPreset('BABYDOGE,MEME,PEPE,WOW,TRON')">🕹️ Meme</span>
                    <span class="target-preset" onclick="setTargetPreset('USDT,USDC,USD,GUSD')">💵 Stables</span>
                    <span class="target-preset" onclick="setTargetPreset('BTC,ETH,SOL,LINK')">🏦 Blue Chips</span>
                </div>
                <label>📉 Short: <input type="checkbox" id="shortToggle" onchange="UI.logButton('Short toggle')"></label>
                <label>📊 Min Profit%: <input type="number" id="minProfitInput" value="0.0001" step="0.0001" style="width:65px;"></label>
                <label>🔄 Fallback: <input type="checkbox" id="fallbackCheck" checked></label>
                <label>🌈 Lines: <input type="number" id="multiLineCount" value="7" min="1" max="8" style="width:40px;"></label>
                <label>💰 Reinvest%: <input type="number" id="reinvestPercent" value="50" min="0" max="100" style="width:45px;">%</label>
            </div>
            <button onclick="UI.logButton('PULL LEVER');Engine.pullGraphLever()" class="gold" id="pullLeverBtn2">🎰 PULL LEVER <span id="pullCountdown2"></span></button>
            <button onclick="UI.logButton('EXECUTE ALL');Engine.executeAllLines()" class="allin" id="executeAllBtn">🚀 EXECUTE ALL LINES</button>
            <div id="slotResult2"></div>
            <div id="accumulationInfo" style="font-size:8px;color:var(--cyan);"></div>
            <div id="batchResult"></div>
        </div>
        <div class="grid">
            <div class="card"><h3>👤 MATRIX LVL <span id="userLevel">1</span> (<span id="modeLabel">PAPER</span>)</h3><div>Score: <span id="matrixScore">0</span> / <span id="nextLevelScore">100</span></div><div class="progress-bar"><div class="progress-fill" id="levelProgress"></div></div><div>💰 Royalties: <span id="royalties">$0.00</span></div><div>🏦 Quantum: <span id="quantumFundVisible">$0.00</span> | 🔒<span id="quantumFundLocked">$0.00</span></div><div><label>SOL:</label><input type="text" id="solAddress" onchange="State.saveWallet()"><span id="solBalance">0.00</span></div><div><label>ETH:</label><input type="text" id="ethAddress" onchange="State.saveWallet()"><span id="ethBalance">0.00</span></div></div>
            <div class="card"><h3>⭐ LEVEL PERKS</h3><div id="perksList"></div></div>
            <div class="card"><h3>🏦 BASKET TRACKER</h3><div id="basketTracker" style="font-size:8px;">No purchases yet</div><div id="basketValue" style="font-size:8px;color:var(--gold);"></div></div>
            <div class="card"><h3>📊 STATISTICS</h3><div class="stat"><span>Pairs:</span><span class="stat-value" id="totalPairs">0</span></div><div class="stat"><span>Nodes:</span><span class="stat-value" id="graphNodes">0</span></div><div class="stat"><span>Edges:</span><span class="stat-value" id="graphEdges">0</span></div><div class="stat"><span>Triangles:</span><span class="stat-value" id="triangleCount">0</span></div><div class="stat"><span>Opps:</span><span class="stat-value" id="oppCount">0</span></div></div>
        </div>
        <div class="flex-row" style="background:#1a1a2a;padding:8px;border-radius:8px;margin:6px 0;"><span>💰 BANKROLL:</span><span class="rolling-number" id="bankroll">$10,000.00</span><span>📈 P/L:</span><span id="pnl">$0.00</span></div>
        <div class="flex-row" style="gap:6px;margin:4px 0;">
            <div><label>🎚️ BET:</label><input type="range" id="betSlider" min="100" max="10000" value="1000" oninput="syncBetInput()"><input type="number" id="betInput" value="1000" style="width:60px;" onchange="syncBetSlider()"></div>
            <div><label>📐 DEPTH:</label><input type="range" id="pathSlider" min="3" max="10" value="5" oninput="UI.syncPathInput()"><input type="number" id="pathInput" value="5" style="width:35px;" onchange="UI.syncPathSlider()"></div>
            <div><label>🧺 BASKET:</label><input type="text" id="basketInput" value="USDT,BTC,ETH,DOGE,SHIB,SOL"></div>
            <div><label>🔁 MODE:</label><select id="arbMode"><option value="both">Both</option><option value="intra">Intra</option><option value="inter">Inter</option></select></div>
            <div><label>🔑 PUMP:</label><input type="text" id="pumpToken"></div>
        </div>
        <div style="margin:4px 0;"><div id="intraExCheckboxes" class="checkbox-group"></div><button onclick="selectAllIntra()" class="cyan">ALL</button><button onclick="deselectAllIntra()" class="cyan">NONE</button></div>
        <div class="card"><h3>💱 FIAT (Frankfurter + CoinGecko)</h3><div class="flex-row"><div class="checkbox-group" id="fiatCheckboxes"></div><button onclick="UI.logButton('FETCH RATES');fetchForexRates()" class="cyan">🔄 FETCH</button><span id="forexStatus"></span></div></div>
        <h2>⚡ EXCHANGES</h2><div class="grid" id="exchangeStatus"></div>
        <div class="grid"><div class="card"><h3>🔥 PICO</h3><div id="picoValue"></div></div><div class="card"><h3>⚡ FEMTO</h3><div id="femtoValue"></div></div><div class="card"><h3>💧 PLANCK</h3><div id="planckValue"></div></div></div>
        <h2>🎯 OPPORTUNITIES</h2>
        <div class="opp-section"><div class="opp-header" onclick="toggleSection('megaOpps')">🌟 MEGA >5% <span id="megaCount">0</span></div><div id="megaOpps" class="opp-list"></div></div>
        <div class="opp-section"><div class="opp-header" onclick="toggleSection('triangularOpps')">📐 TRIANGULAR <span id="triangularCount">0</span></div><div id="triangularOpps" class="opp-list"></div></div>
        <div class="opp-section"><div class="opp-header" onclick="toggleSection('bellmanOpps')">🔗 BELLMAN-FORD <span id="bellmanCount">0</span></div><div id="bellmanOpps" class="opp-list"></div></div>
        <div class="opp-section"><div class="opp-header" onclick="toggleSection('suspiciousOpps')">⚠️ SUSPICIOUS <span id="suspiciousCount">0</span></div><div id="suspiciousOpps" class="opp-list"></div></div>
        <div class="card"><h3>📒 TRADE LEDGER</h3><div id="tradeLedger"></div></div>
        <h2 onclick="toggleLogs()">📋 LOGS</h2><div class="log-container" id="logs"></div>
    </div>
    <div id="tradeModal" class="modal"><div class="modal-content"><h3>🎰 EXECUTE</h3><div id="tradeDetails"></div><div class="math-breakdown" id="compoundingMath"></div><div id="rateWarning"></div><div id="conflictWarning"></div><button onclick="closeModal()">CANCEL</button><button class="cyan" id="executeTradeBtn">💸 PULL LEVER</button></div></div>
    <div id="createCoinModal" class="modal"><div class="modal-content"><h3>🪙 CREATE TOKEN</h3><input type="text" id="newCoinSymbol" placeholder="SYMBOL"><input type="number" id="newCoinPrice" value="0.000001"><input type="number" id="newCoinLiq" value="500"><button onclick="closeCreateCoinModal()">CANCEL</button><button id="createCoinBtn" class="cyan">MINT</button></div></div>
    <script>
        // ── AUDIO & PARTICLES ────────────────────────────
        const audioCtx = new(window.AudioContext || window.webkitAudioContext)();
        function playTone(f,d,t='square',v=0.05){const o=audioCtx.createOscillator(),g=audioCtx.createGain();o.type=t;o.frequency.value=f;g.gain.setValueAtTime(v,audioCtx.currentTime);g.gain.exponentialRampToValueAtTime(0.001,audioCtx.currentTime+d);o.connect(g);g.connect(audioCtx.destination);o.start();o.stop(audioCtx.currentTime+d);}
        function playSpin(){playTone(800,0.08,'sawtooth',0.04);}
        function playWin(){playTone(523,0.08);setTimeout(()=>playTone(659,0.08),80);setTimeout(()=>playTone(784,0.15),160);}
        const canvas=document.getElementById('particleCanvas'),ctx=canvas.getContext('2d');let particles=[];
        function resize(){canvas.width=innerWidth;canvas.height=innerHeight;}
        window.addEventListener('resize',resize);resize();
        class Particle{constructor(x,y,vx,vy,c,l){this.x=x;this.y=y;this.vx=vx;this.vy=vy;this.color=c;this.life=l;}}
        function anim(){ctx.clearRect(0,0,canvas.width,canvas.height);for(let i=particles.length-1;i>=0;i--){const p=particles[i];p.x+=p.vx;p.y+=p.vy;p.vy+=0.05;p.life-=0.012;ctx.fillStyle=p.color;ctx.globalAlpha=Math.max(0,p.life);ctx.fillRect(p.x,p.y,3,3);if(p.life<=0)particles.splice(i,1);}requestAnimationFrame(anim);}
        anim();
        function confetti(x,y,n=25){const cols=['#ff00ff','#00ff00','#ffd700','#00f0ff'];for(let i=0;i<n;i++)particles.push(new Particle(x,y,(Math.random()-0.5)*7,(Math.random()-0.5)*6-3,cols[Math.floor(Math.random()*cols.length)],0.5+Math.random()*0.4));}

        // ── STATE ────────────────────────────────────────
        const State = {
            bankroll: 10000,
            paperMatrix: 0, liveMatrix: 0, paperLevel: 1, liveLevel: 1,
            get matrix(){ return this.liveMode ? this.liveMatrix : this.paperMatrix; },
            set matrix(v){ if(this.liveMode) this.liveMatrix=v; else this.paperMatrix=v; },
            get level(){ return this.liveMode ? this.liveLevel : this.paperLevel; },
            set level(v){ if(this.liveMode) this.liveLevel=v; else this.paperLevel=v; },
            qFund:0, lFund:0, liveMode:false, userCoins:[], exchanges:{}, allPairs:[], graph:{}, triangles:[],
            opportunities:{mega:[],triangular:[],bellman:[],suspicious:[]},
            stats:{totalPairs:0,graphNodes:0,graphEdges:0,triangleCount:0,wsBytes:0,oppCount:0},
            selectedIntraExchanges:new Set(), selectedFiats:new Set(['RUB','INR','EUR','GBP']),
            liveScanInterval:null, liveScanActive:false, forexRates:{}, wsTickers:{}, tradeLedger:[],
            proxyMode:'direct', customProxyUrl:'', execPath:'/execute',
            lastTradeExecTime:0, lastPullTime:0, graphRenderer:null, purchasePower:{},
            highlightedPaths:[], conflictEdges:new Set(), basketHoldings:{}, acquisitionPaths:{},
            load(){
                try{const s=JSON.parse(localStorage.getItem('qfoam_v22final'));if(s){
                    this.bankroll=s.bankroll||10000;
                    this.paperMatrix=s.paperMatrix||0; this.liveMatrix=s.liveMatrix||0;
                    this.paperLevel=s.paperLevel||1; this.liveLevel=s.liveLevel||1;
                    this.liveMode=s.liveMode||false;
                    this.userCoins=s.userCoins||[];
                    this.selectedIntraExchanges=s.selectedIntraExchanges?new Set(s.selectedIntraExchanges):new Set();
                    this.forexRates=s.forexRates||{};
                    this.selectedFiats=s.selectedFiats?new Set(s.selectedFiats):new Set();
                    this.tradeLedger=s.tradeLedger?s.tradeLedger.slice(-15):[];
                    this.proxyMode=s.proxyMode||'direct'; this.customProxyUrl=s.customProxyUrl||'';
                    this.execPath=s.execPath||'/execute';
                    this.basketHoldings=s.basketHoldings||{}; this.acquisitionPaths=s.acquisitionPaths||{};
                }}catch(e){}
                document.getElementById('solAddress').value=localStorage.getItem('wallet_sol')||'';
                document.getElementById('ethAddress').value=localStorage.getItem('wallet_eth')||'';
                document.getElementById('pumpToken').value=localStorage.getItem('pumpfun_token')||'';
                document.getElementById('basketInput').value=localStorage.getItem('basket')||'USDT,BTC,ETH,DOGE,SHIB,SOL';
                document.getElementById('pathInput').value=localStorage.getItem('pathDepth')||5;
                document.getElementById('pathSlider').value=document.getElementById('pathInput').value;
                document.getElementById('liveToggle').checked=this.liveMode;
                document.getElementById('proxySelect').value=this.proxyMode;
                document.getElementById('corsProxyUrl').value=this.customProxyUrl;
                document.getElementById('execPath').value=this.execPath;
                document.getElementById('walletProxyUrl').value=localStorage.getItem('walletProxyUrl')||'';
                document.getElementById('targetAssetsInput').value=localStorage.getItem('targetAssets')||'';
                UI.updateProfile(); UI.renderFiatCheckboxes(); UI.onProxyChange(); UI.renderTradeLedger();
                UI.applyLevelConstraints(); updateIntraExCheckboxes(); UI.renderBasketTracker();
            },
            save(){
                localStorage.setItem('qfoam_v22final',JSON.stringify({
                    bankroll:this.bankroll,
                    paperMatrix:this.paperMatrix, liveMatrix:this.liveMatrix,
                    paperLevel:this.paperLevel, liveLevel:this.liveLevel,
                    liveMode:this.liveMode,
                    userCoins:this.userCoins,
                    selectedIntraExchanges:[...this.selectedIntraExchanges],
                    forexRates:this.forexRates, selectedFiats:[...this.selectedFiats],
                    tradeLedger:this.tradeLedger.slice(-15),
                    proxyMode:this.proxyMode, customProxyUrl:this.customProxyUrl,
                    execPath:this.execPath,
                    basketHoldings:this.basketHoldings, acquisitionPaths:this.acquisitionPaths
                }));
                localStorage.setItem('wallet_sol',document.getElementById('solAddress').value);
                localStorage.setItem('wallet_eth',document.getElementById('ethAddress').value);
                localStorage.setItem('pumpfun_token',document.getElementById('pumpToken').value);
                localStorage.setItem('basket',document.getElementById('basketInput').value);
                localStorage.setItem('pathDepth',document.getElementById('pathInput').value);
                localStorage.setItem('walletProxyUrl',document.getElementById('walletProxyUrl').value);
                localStorage.setItem('targetAssets',document.getElementById('targetAssetsInput').value);
            },
            saveWallet(){this.save();}, savePumpToken(){this.save();},
            addTradeToLedger(opp,size,netProfit){
                this.tradeLedger.unshift({time:new Date().toISOString(),path:opp.path.join(' → '),size,profit:netProfit,type:opp.type});
                if(this.tradeLedger.length>15)this.tradeLedger.length=15; this.save(); UI.renderTradeLedger();
            },
            recordBasketPurchase(asset,amount,pathDescription){
                if(!this.basketHoldings[asset])this.basketHoldings[asset]=0;
                this.basketHoldings[asset]+=amount;
                if(!this.acquisitionPaths[asset])this.acquisitionPaths[asset]=[];
                this.acquisitionPaths[asset].push({amount,path:pathDescription||'unknown',time:new Date().toISOString()});
                this.save(); UI.renderBasketTracker();
            },
            getAssetPrice(asset){
                const stableTargets=['USDT','USD','USDC','GUSD','BUSD'];
                for(const t of stableTargets){const pair=this.allPairs.find(p=>p.base===asset&&p.target===t);if(pair)return pair.bidPrice||pair.price*0.999;}
                const anyPair=this.allPairs.find(p=>p.base===asset);
                if(anyPair){const price=anyPair.bidPrice||anyPair.price*0.999;if(!stableTargets.includes(anyPair.target)){const tp=this.getAssetPrice(anyPair.target);if(tp>0)return price*tp;}return price;}
                return 0;
            },
            computePurchasePower(){this.purchasePower={};if(this.bankroll<=0)return;const prices={};for(const pair of this.allPairs){if(!pair.base||!pair.target)continue;const ask=pair.askPrice||pair.price*1.001;if(!prices[pair.base]||ask<prices[pair.base])prices[pair.base]=ask;}for(const[asset,price]of Object.entries(prices)){if(price>0)this.purchasePower[asset]=this.bankroll/price;}for(const stable of['USDT','USD','USDC','GUSD','BUSD']){if(!this.purchasePower[stable])this.purchasePower[stable]=this.bankroll;}},
            getTargetAssets(){const raw=document.getElementById('targetAssetsInput')?.value.trim();if(raw)return raw.split(',').map(s=>s.trim().toUpperCase()).filter(Boolean);return document.getElementById('basketInput').value.split(',').map(s=>s.trim().toUpperCase()).filter(Boolean);},
            validateEdge(edge){return edge&&edge.rate>0&&edge.rate<1e6&&isFinite(edge.rate);},
            validateCycle(edges){let p=1;for(const e of edges){if(!this.validateEdge(e))return false;p*=e.rate;}return p>0.5&&p<100;}
        };
        const CORS_OK_EXCHANGES=new Set(['okx','coinbase','binance','kucoin','gemini','bitstamp','kraken','dexscreener_eth','dexscreener_bsc','dexscreener_polygon','dexscreener_arb','dexscreener_sol','coingecko','coinpaprika','coinlore']);
        const BUILTIN_PROXIES=['https://corsproxy.io/?','https://api.allorigins.win/raw?url=']; let currentProxyIndex=0;
        function getEffectiveProxyUrl(){if(State.proxyMode==='custom'){const c=(document.getElementById('corsProxyUrl').value||'').trim();if(c&&!c.includes('placeholder'))return c;return null;}if(State.proxyMode==='builtin')return BUILTIN_PROXIES[currentProxyIndex];return null;}
        function rotateProxy(){currentProxyIndex=(currentProxyIndex+1)%BUILTIN_PROXIES.length;UI.updateProxyStatus();}
        async function smartFetch(url,options={},isCorsSafe=false){if(isCorsSafe||State.proxyMode==='direct'){try{const r=await fetch(url,options);if(r.ok)return r;if(r.status>=400)throw new Error('HTTP '+r.status);}catch(e){}}const proxy=getEffectiveProxyUrl();if(proxy){try{const r=await fetch(proxy+encodeURIComponent(url),options);if(!r.ok)throw new Error('Proxy HTTP '+r.status);const text=await r.text();if(text.startsWith('<')||text.includes('corsdemo'))throw new Error('Non-JSON');try{return new Response(JSON.stringify(JSON.parse(text)),{status:200,headers:{'Content-Type':'application/json'}});}catch{return new Response(text,{status:200,headers:{'Content-Type':'text/plain'}});}}catch(e){rotateProxy();}}throw new Error('All fetch attempts exhausted');}
        const KNOWN_QUOTES=['USDT','USDC','BUSD','GUSD','USD','BTC','ETH','BNB','SOL','EUR','GBP','JPY','KRW','AUD','CAD','CHF','RUB','INR','TRY','BRL','IDR','DAI','SGD','PLN','UAH','AED','BETH','ZEC','ZRX','RAY','STRK','MATIC','DOT','TRB','TON','PI','LTC','XRP','SHIB','DOGE','BONK','PEPE','FLOKI','WIN','SATS','NEIRO','CAT','DUCK','BOME','OMI','DEGEN','NOT','MEME','TOSHI','MEW','HMSTR','XCHNG','WBNB','RNDR','LINK','JITOSOL','LINEA','HYPE','PNUT','POL','TRUMP','POPCAT','CTX','JUP','GALA','FTM','FET','SAND','GRT','CRV','LTC','XTZ','SUI','XCH','AVAX','WIF','UNI','FIL','STX','OP','TON','LINK','LPT','ENS','WLFI','ZEC','PENGU','APE','GOAT','MOODENG','MANA','INJ','ATOM','AAVE','TRX','SKY','CHZ','SEI','ZETA','ARB','XDC','BONK','PEPE','SHIB','FLR','VIRTUAL','NEAR','ADA','HBAR','API3','STORJ','IMX','LDO','MON','BCH','PUMP','MASK','OFC','COMP','JUP','DOT','USDG','BAT','BABYDOGE','ALGO','RLUSD','TRAC','SKL','CTSI','MEW','CXT','PYTH','KITE','DIRT','WOW','ARRR','TRON','MEME'];
        KNOWN_QUOTES.sort((a,b)=>b.length-a.length);
        function parsePairSymbol(rawSymbol){const s=(rawSymbol||'').toUpperCase().replace(/[^A-Z0-9]/g,'');if(!s)return null;for(const q of KNOWN_QUOTES){if(s.endsWith(q)&&s.length>q.length){const b=s.slice(0,s.length-q.length);if(b.length>=1&&b!==q)return{base:b,target:q};}}const p=s.split(/[_-]/);if(p.length>=2)return{base:p[0],target:p.slice(1).join('_')};return null;}
        const exchangeDefs=[{key:'okx',name:'OKX',url:'https://www.okx.com/api/v5/market/tickers?instType=SPOT',parser:'okx'},{key:'coinbase',name:'Coinbase',url:'https://api.exchange.coinbase.com/products',parser:'coinbase'},{key:'binance',name:'Binance',url:'https://api.binance.com/api/v3/ticker/24hr',parser:'binance'},{key:'kucoin',name:'KuCoin',url:'https://api.kucoin.com/api/v1/market/allTickers',parser:'kucoin'},{key:'bybit',name:'Bybit',url:'https://api.bybit.com/v5/market/tickers?category=spot',parser:'bybit'},{key:'gate',name:'Gate.io',url:'https://api.gateio.ws/api/v4/spot/tickers',parser:'gate'},{key:'mexc',name:'MEXC',url:'https://api.mexc.com/api/v3/ticker/24hr',parser:'mexc'},{key:'kraken',name:'Kraken',url:'https://api.kraken.com/0/public/Ticker?pair=ALL',parser:'kraken'},{key:'bitstamp',name:'Bitstamp',url:'https://www.bitstamp.net/api/v2/ticker/',parser:'bitstamp'},{key:'indodax',name:'Indodax',url:'https://indodax.com/api/tickers',parser:'indodax'},{key:'yobit',name:'Yobit',url:'https://yobit.net/api/3/info',parser:'yobit'},{key:'pumpfun',name:'Pump.fun',url:'https://frontend-api.pump.fun/coins?offset=0&limit=100&sort=created_timestamp&order=DESC',parser:'pumpfun',auth:true},{key:'poloniex',name:'Poloniex',url:'https://api.poloniex.com/markets/ticker24h',parser:'poloniex'},{key:'huobi',name:'Huobi',url:'https://api.huobi.pro/market/tickers',parser:'huobi'},{key:'gemini',name:'Gemini',url:'https://api.gemini.com/v1/pricefeed',parser:'gemini'},{key:'ascendex',name:'AscendEX',url:'https://ascendex.com/api/pro/v1/ticker',parser:'ascendex'},{key:'digifinex',name:'Digifinex',url:'https://openapi.digifinex.com/v3/ticker',parser:'digifinex'},{key:'bittrex',name:'Bittrex',url:'https://api.bittrex.com/v3/markets/tickers',parser:'bittrex'},{key:'crypto.com',name:'Crypto.com',url:'https://api.crypto.com/v2/public/get-ticker',parser:'cryptocom'},{key:'dexscreener_eth',name:'DexScreener ETH',url:'https://api.dexscreener.com/latest/dex/search?q=ETH',parser:'dexscreener'},{key:'dexscreener_bsc',name:'DexScreener BSC',url:'https://api.dexscreener.com/latest/dex/search?q=BNB',parser:'dexscreener'},{key:'dexscreener_polygon',name:'DexScreener Polygon',url:'https://api.dexscreener.com/latest/dex/search?q=MATIC',parser:'dexscreener'},{key:'dexscreener_arb',name:'DexScreener Arbitrum',url:'https://api.dexscreener.com/latest/dex/search?q=ARB',parser:'dexscreener'},{key:'dexscreener_sol',name:'DexScreener Solana',url:'https://api.dexscreener.com/latest/dex/search?q=SOL',parser:'dexscreener'},{key:'coingecko',name:'CoinGecko',url:'https://api.coingecko.com/api/v3/coins/markets?vs_currency=usd&order=market_cap_desc&per_page=250&page=1',parser:'coingecko'},{key:'coinlore',name:'CoinLore',url:'https://api.coinlore.net/api/tickers/',parser:'coinlore'},{key:'coinpaprika',name:'CoinPaprika',url:'https://api.coinpaprika.com/v1/tickers',parser:'coinpaprika'},{key:'coincap',name:'CoinCap',url:'https://api.coincap.io/v2/assets?limit=100',parser:'coincap'}];
        exchangeDefs.forEach(d=>{State.exchanges[d.key]={name:d.name,status:'offline',pairs:[],url:d.url,parser:d.parser,auth:d.auth||false,wsStatus:'off'};});

        function log(msg,type='info'){const t=new Date().toLocaleTimeString();const el=document.getElementById('logs');if(!el)return;const c=type==='error'?'#ff4444':type==='success'?'var(--green)':'inherit';el.innerHTML=`<div style="color:${c}">[${t}] ${msg}</div>`+el.innerHTML;}
        function toggleLogs(){const e=document.getElementById('logs');e.style.display=e.style.display==='none'?'block':'none';}
        function toggleSection(id){const e=document.getElementById(id);e.style.display=e.style.display==='none'?'block':'none';}

        // ── GRAPH RENDERER ─────────────────────────────
        class GraphRenderer{
            constructor(canvasId){this.canvas=document.getElementById(canvasId);this.ctx=this.canvas.getContext('2d');this.nodes={};this.edges=[];this.highlightedPaths=[];this.conflictEdges=new Set();this.animPhase=0;this.purchasePower={};this.maxPower=1;this.pathColors=['#ffd700','#ff00ff','#00ffaa','#ff4444','#4488ff','#ffaa00','#88ff88','#ff88ff'];this.resize();window.addEventListener('resize',()=>this.resize());}
            resize(){const r=this.canvas.parentElement.getBoundingClientRect();const w=Math.min(700,r.width-20);this.canvas.width=w;this.canvas.height=Math.min(380,w*0.55);}
            buildFromGraph(graph,opps,power,paths,conflictEdges){this.nodes={};this.edges=[];this.purchasePower=power||{};this.highlightedPaths=paths||[];this.conflictEdges=conflictEdges||new Set();const seen=new Set();this.maxPower=Math.max(1,...Object.values(this.purchasePower));for(const[b,tgts]of Object.entries(graph)){if(!this.nodes[b])this.nodes[b]={id:b,x:0,y:0,power:this.purchasePower[b]||0,color:this.getColor(b),oppCount:0};for(const[t,e]of Object.entries(tgts)){const k=[b,t].sort().join('|');if(!seen.has(k)){seen.add(k);this.edges.push({from:b,to:t,vol:e.volume||0,liq:e.liquidity||0,rate:e.rate});}if(!this.nodes[t])this.nodes[t]={id:t,x:0,y:0,power:this.purchasePower[t]||0,color:this.getColor(t),oppCount:0};}}if(opps){for(const o of[...(opps.mega||[]),...(opps.triangular||[]),...(opps.bellman||[])]){for(const n of o.path){if(this.nodes[n])this.nodes[n].oppCount++;}}}this.forceLayout();this.startAnim();}
            getColor(id){const c=['#ffd700','#00f0ff','#ff00ff','#00ffaa','#ff8888','#88ff88','#ffaa00','#aa88ff','#ff4488','#44ff88'];let h=0;for(let i=0;i<id.length;i++)h=((h<<5)-h)+id.charCodeAt(i);return c[Math.abs(h)%c.length];}
            forceLayout(){const nl=Object.values(this.nodes);const n=nl.length;if(!n)return;const cx=this.canvas.width/2,cy=this.canvas.height/2;const rad=Math.min(cx,cy)*0.65;nl.forEach((nd,i)=>{const a=(2*Math.PI*i)/n-Math.PI/2;nd.x=cx+rad*Math.cos(a);nd.y=cy+rad*Math.sin(a);});const iters=Math.min(35,Math.max(12,n));for(let iter=0;iter<iters;iter++){for(let i=0;i<n;i++){for(let j=i+1;j<n;j++){const dx=nl[i].x-nl[j].x,dy=nl[i].y-nl[j].y;const d=Math.max(1,Math.sqrt(dx*dx+dy*dy));const f=700/(d*d);const fx=(dx/d)*f,fy=(dy/d)*f;nl[i].x+=fx;nl[i].y+=fy;nl[j].x-=fx;nl[j].y-=fy;}}for(const e of this.edges){const from=this.nodes[e.from],to=this.nodes[e.to];if(!from||!to)continue;const dx=to.x-from.x,dy=to.y-from.y;const d=Math.max(1,Math.sqrt(dx*dx+dy*dy));const f=d*0.0018;const fx=(dx/d)*f,fy=(dy/d)*f;from.x+=fx;from.y+=fy;to.x-=fx;to.y-=fy;}for(const nd of nl){nd.x+=(cx-nd.x)*0.018;nd.y+=(cy-nd.y)*0.018;nd.x=Math.max(15,Math.min(this.canvas.width-15,nd.x));nd.y=Math.max(15,Math.min(this.canvas.height-15,nd.y));}}}
            startAnim(){if(this.animRAF)cancelAnimationFrame(this.animRAF);const anim=()=>{this.animPhase+=0.025;this.render();this.animRAF=requestAnimationFrame(anim);};anim();}
            render(){const ctx=this.ctx,w=this.canvas.width,h=this.canvas.height;ctx.clearRect(0,0,w,h);ctx.strokeStyle='rgba(255,255,255,0.03)';ctx.lineWidth=1;for(let x=0;x<w;x+=35){ctx.beginPath();ctx.moveTo(x,0);ctx.lineTo(x,h);ctx.stroke();}for(let y=0;y<h;y+=35){ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(w,y);ctx.stroke();}const maxVol=Math.max(1,...this.edges.map(e=>e.vol||0));const hlEdgesByPath=this.highlightedPaths.map(path=>{const set=new Set();for(let i=0;i<path.length-1;i++){set.add([path[i],path[i+1]].sort().join('|'));}return set;});for(const e of this.edges){const from=this.nodes[e.from],to=this.nodes[e.to];if(!from||!to)continue;const ek=[e.from,e.to].sort().join('|');let highlighted=false;let color=null;let isConflict=false;for(let p=0;p<hlEdgesByPath.length;p++){if(hlEdgesByPath[p].has(ek)){if(highlighted){isConflict=true;break;}highlighted=true;color=this.pathColors[p%this.pathColors.length];}}if(highlighted&&isConflict){ctx.strokeStyle='rgba(255,68,68,0.8)';ctx.lineWidth=2;ctx.setLineDash([5,3]);ctx.shadowColor='#ff4444';ctx.shadowBlur=6;}else if(highlighted&&color){ctx.strokeStyle=color.replace(')',`,${0.7+0.3*Math.sin(this.animPhase*3)})`).replace('rgb','rgba');ctx.lineWidth=2.5;ctx.setLineDash([]);ctx.shadowColor=color;ctx.shadowBlur=8;}else{const alpha=Math.max(0.06,Math.min(0.45,(e.vol||0)/maxVol));ctx.strokeStyle=`rgba(0,240,255,${alpha})`;ctx.lineWidth=1;ctx.setLineDash([]);ctx.shadowBlur=0;}ctx.beginPath();ctx.moveTo(from.x,from.y);ctx.lineTo(to.x,to.y);ctx.stroke();ctx.setLineDash([]);ctx.shadowBlur=0;}for(const nd of Object.values(this.nodes)){const inPaths=this.highlightedPaths.some(p=>p.includes(nd.id));const pr=Math.min(1,(nd.power||0)/this.maxPower);const sz=7+pr*16;const ob=Math.min(7,(nd.oppCount||0)*1.8);const ts=sz+ob;const glow=ctx.createRadialGradient(nd.x,nd.y,0,nd.x,nd.y,ts*1.7);if(inPaths){glow.addColorStop(0,'rgba(255,215,0,0.65)');glow.addColorStop(0.5,'rgba(255,215,0,0.15)');glow.addColorStop(1,'rgba(255,215,0,0)');}else{glow.addColorStop(0,nd.color.replace(')',',0.45)').replace('rgb','rgba'));glow.addColorStop(1,'rgba(0,0,0,0)');}ctx.fillStyle=glow;ctx.beginPath();ctx.arc(nd.x,nd.y,ts*1.7,0,Math.PI*2);ctx.fill();const bg=ctx.createRadialGradient(nd.x-ts*0.25,nd.y-ts*0.25,ts*0.08,nd.x,nd.y,ts);bg.addColorStop(0,'#ffffff');bg.addColorStop(0.3,nd.color);bg.addColorStop(1,'#000000');ctx.fillStyle=bg;ctx.beginPath();ctx.arc(nd.x,nd.y,ts,0,Math.PI*2);ctx.fill();ctx.strokeStyle=inPaths?'#ffd700':'rgba(255,255,255,0.25)';ctx.lineWidth=inPaths?1.8:1;ctx.stroke();ctx.fillStyle='#fff';ctx.font=`${Math.max(7,ts*0.5)}px 'Courier New'`;ctx.textAlign='center';ctx.fillText(nd.id,nd.x,nd.y+ts+10);}for(let p=0;p<this.highlightedPaths.length;p++){const path=this.highlightedPaths[p];if(path.length<2)continue;const t=(this.animPhase+p*0.3)%1;const idx=Math.floor(t*(path.length-1));const nxt=Math.min(idx+1,path.length-1);const from=this.nodes[path[idx]],to=this.nodes[path[nxt]];if(from&&to){const fr=(t*(path.length-1))%1;const px=from.x+(to.x-from.x)*fr,py=from.y+(to.y-from.y)*fr;const color=this.pathColors[p%this.pathColors.length];ctx.fillStyle=color;ctx.shadowColor=color;ctx.shadowBlur=10;ctx.beginPath();ctx.arc(px,py,4,0,Math.PI*2);ctx.fill();ctx.shadowBlur=0;}}}
        }

        // ── UI ──────────────────────────────────────────
        const UI={
            logButton(label){log(`🖱️ ${label}`);},
            toggleGraphSlot(){const s=document.getElementById('graphSlotContainer');s.style.display=s.style.display==='none'?'block':'none';if(s.style.display==='block'&&State.graph&&Object.keys(State.graph).length){if(!State.graphRenderer)State.graphRenderer=new GraphRenderer('graphNetwork');State.computePurchasePower();State.graphRenderer.buildFromGraph(State.graph,State.opportunities,State.purchasePower,State.highlightedPaths,State.conflictEdges||new Set());}},
            syncPathInput(){document.getElementById('pathInput').value=document.getElementById('pathSlider').value;document.getElementById('slotDepthLabel2').textContent=document.getElementById('pathSlider').value;State.save();},
            syncPathSlider(){document.getElementById('pathSlider').value=document.getElementById('pathInput').value;document.getElementById('slotDepthLabel2').textContent=document.getElementById('pathInput').value;State.save();},
            toggleLiveMode(){
                State.liveMode=document.getElementById('liveToggle').checked;
                document.getElementById('modeLabel').textContent=State.liveMode?'LIVE':'PAPER';
                State.save(); this.updateProfile(); log(`🖱️ Live: ${State.liveMode}`);
            },
            updateProfile(){
                document.getElementById('userLevel').textContent=State.level;
                document.getElementById('matrixScore').textContent=State.matrix;
                const n=Math.pow(State.level,2)*10;
                document.getElementById('nextLevelScore').textContent=n;
                document.getElementById('levelProgress').style.width=Math.min(100,(State.matrix/n)*100)+'%';
                document.getElementById('royalties').textContent='$'+(State.royalties||0).toFixed(2);
                document.getElementById('quantumFundVisible').textContent='$'+(State.qFund||0).toFixed(2);
                document.getElementById('quantumFundLocked').textContent='$'+(State.lFund||0).toFixed(2);
                document.getElementById('bankroll').textContent='$'+State.bankroll.toFixed(2);
                const pnl=State.bankroll-10000;
                document.getElementById('pnl').textContent=`$${pnl.toFixed(2)} (${((pnl/10000)*100).toFixed(2)}%)`;
                document.getElementById('modeLabel').textContent=State.liveMode?'LIVE':'PAPER';
                this.applyLevelConstraints(); this.renderPerks();
            },
            applyLevelConstraints(){
                const maxBet=Math.max(100,State.level*2000);
                document.getElementById('betSlider').max=maxBet; document.getElementById('betInput').max=maxBet;
                let maxDepth=3;if(State.level>=4&&State.level<=6)maxDepth=5;else if(State.level>=7)maxDepth=10;
                document.getElementById('pathSlider').max=maxDepth; document.getElementById('pathInput').max=maxDepth;
                const bellmanCheck=document.getElementById('bellmanToggle');if(State.level<5){bellmanCheck.disabled=true;bellmanCheck.checked=false;bellmanCheck.parentElement.style.opacity='0.5';}else{bellmanCheck.disabled=false;bellmanCheck.parentElement.style.opacity='1';}
            },
            renderPerks(){
                const el=document.getElementById('perksList');
                const perks=[{desc:'Max Bet',value:`$${Math.max(100,State.level*2000)}`},{desc:'Max Depth',value:(State.level<4?'3':State.level<7?'5':'10')},{desc:'Bellman‑Ford',unlocked:State.level>=5},{desc:'Create Coin',unlocked:State.level>=5},{desc:'Intra Exch',value:`${State.level+2}`},{desc:'Multi‑Lines',unlocked:State.level>=3,value:State.level>=3?'✅':'🔒 Lvl 3'}];
                el.innerHTML=perks.map(p=>p.unlocked!==undefined?`<div class="${p.unlocked?'perk-unlocked':'perk-locked'}">🔹 ${p.desc}: ${p.unlocked?'✅ Unlocked':p.value}</div>`:`<div>🔹 ${p.desc}: ${p.value}</div>`).join('');
            },
            renderOpp(opp,targetId,mega){const c=document.getElementById(targetId);if(!c)return;c.innerHTML+=`<div class="opportunity ${mega?'mega':''}" onclick="UI.openTradeModal('${encodeURIComponent(JSON.stringify(opp))}')"><strong>+${opp.profitPercent.toFixed(2)}%</strong> ${opp.path.join(' → ')}<br>Max: $${opp.maxTradeSize.toFixed(2)} | Profit: $${opp.actualProfit.toFixed(2)}</div>`;},
            openTradeModal(oppStr){const opp=JSON.parse(decodeURIComponent(oppStr));const bet=Math.min(opp.maxTradeSize,parseFloat(document.getElementById('betInput').value)||1000);const sz=bet;let rt=sz;let ms=`Start: $${sz.toFixed(2)}<br>`;let valid=true;const dh=opp.edges.map((e,i)=>{const p=rt;rt*=e.rate;const suspicious=(e.rate>1e4||e.rate<1e-4||!isFinite(e.rate));if(suspicious)valid=false;ms+=`Hop ${i+1}: $${p.toFixed(2)} × ${e.rate.toFixed(6)} → $${rt.toFixed(2)}${suspicious?' ⚠️':''}<br>`;return `<div>${opp.path[i]} → ${opp.path[i+1]} | Liq: $${e.liquidity.toFixed(0)}${suspicious?' ⚠️ SUSPECT RATE':''}</div>`;}).join('');document.getElementById('tradeDetails').innerHTML=`<p>🔄 ${opp.path.join(' → ')}</p><p>💵 $${sz.toFixed(2)}</p>${dh}`;document.getElementById('compoundingMath').innerHTML=ms+`<strong>💰 Final: $${rt.toFixed(2)}</strong>`;const rateWarn=document.getElementById('rateWarning');if(!valid){rateWarn.innerHTML='<span style="color:#ffaa00;">⚠️ One or more edge rates appear anomalous. Verify before executing.</span>';}else{rateWarn.innerHTML='';}const conflictWarn=document.getElementById('conflictWarning');const allPaths=[...State.highlightedPaths];const conflicts=allPaths.filter(p=>p!==opp.path&&p.some(n=>opp.path.includes(n)));if(conflicts.length>0){conflictWarn.innerHTML=`<span style="color:#ff4444;">⚠️ Shares nodes with ${conflicts.length} other payline(s).</span>`;}else{conflictWarn.innerHTML='';}document.getElementById('executeTradeBtn').onclick=async()=>{const now=Date.now();if(now-State.lastTradeExecTime<4000){log('⏳ Trade blocked','warning');return;}if(State.bankroll<=0){log('❌ Bankroll exhausted','error');return;}if(State.liveMode){const walletUrl=document.getElementById('walletProxyUrl').value.trim();if(!walletUrl||!walletUrl.startsWith('http')){log('❌ Live mode requires a valid Wallet Proxy URL','error');return;}}State.lastTradeExecTime=now;UI.logButton('EXECUTE TRADE');closeModal();await Engine.executeTrade(opp,sz,rt-sz);};document.getElementById('tradeModal').style.display='flex';},
            closeModal(){document.getElementById('tradeModal').style.display='none';},
            renderFiatCheckboxes(){const c=document.getElementById('fiatCheckboxes');const f=['RUB','INR','EUR','GBP','JPY','CNY','KRW','AUD','CAD','CHF','AED','TRY','BRL','SGD','PLN'];c.innerHTML=f.map(x=>`<label><input type="checkbox" value="${x}" ${State.selectedFiats.has(x)?'checked':''} onchange="UI.toggleFiat('${x}')"> ${x}</label>`).join('');},
            toggleFiat(f){State.selectedFiats.has(f)?State.selectedFiats.delete(f):State.selectedFiats.add(f);State.save();log(`🖱️ Fiat: ${f}`);if(!Object.keys(State.forexRates).length&&!document.getElementById('scanBtn').disabled)fetchForexRates();},
            onProxyChange(){const m=document.getElementById('proxySelect').value;State.proxyMode=m;document.getElementById('corsProxyUrl').style.display=m==='custom'?'inline-block':'none';this.updateProxyStatus();State.save();log(`🖱️ Proxy: ${m}`);},
            updateProxyStatus(){const e=document.getElementById('proxyStatusMsg');if(!e)return;e.textContent=State.proxyMode==='direct'?'⚡ Direct + fallback':State.proxyMode==='builtin'?`🔁 Rotating: ${BUILTIN_PROXIES[currentProxyIndex]}`:'📝 Custom proxy';},
            renderTradeLedger(){const e=document.getElementById('tradeLedger');if(!e)return;if(!State.tradeLedger.length){e.innerHTML='No trades yet.';return;}e.innerHTML=State.tradeLedger.map(x=>`<div>${x.time.slice(11,19)} ${x.type} ${x.path} <span style="color:${x.profit>=0?'var(--green)':'#ff4444'}">$${x.profit.toFixed(2)}</span></div>`).join('');},
            renderBasketTracker(){const e=document.getElementById('basketTracker');const v=document.getElementById('basketValue');if(!e||!v)return;const h=State.basketHoldings;if(!Object.keys(h).length){e.innerHTML='No purchases yet';v.innerHTML='';return;}let totalValue=0;e.innerHTML=Object.entries(h).map(([k,amt])=>{const price=State.getAssetPrice(k);const value=amt*price;totalValue+=value;const acqInfo=State.acquisitionPaths[k]?State.acquisitionPaths[k].slice(-1)[0]?.path||'unknown':'unknown';return`<div>📦 ${k}: ${amt.toFixed(6)} ($${value.toFixed(2)})<br><small>via ${acqInfo}</small></div>`;}).join('');v.innerHTML=`💰 Total value: $${totalValue.toFixed(2)}`;}
        };
        function closeModal(){UI.closeModal();}
        function saveProxyConfig(){State.proxyMode=document.getElementById('proxySelect').value;State.customProxyUrl=document.getElementById('corsProxyUrl').value;State.execPath=document.getElementById('execPath').value.trim()||'/execute';State.save();UI.updateProxyStatus();log('🖱️ Proxy saved');}
        function setTargetPreset(list){document.getElementById('targetAssetsInput').value=list;State.save();log(`🎯 Target preset: ${list}`);}

        // ── FOREX (Frankfurter primary, CoinGecko fallback) ──
        async function fetchForexRates(){
            const f=[...State.selectedFiats];if(!f.length){log('No fiats selected','warning');return;}
            let success=false;
            // Try Frankfurter (CORS-friendly)
            try{
                const r=await smartFetch('https://api.frankfurter.app/latest?from=USD',{},true);
                const d=await r.json();if(!d.rates)throw new Error('Invalid');
                State.forexRates={};
                for(const cur of f){if(d.rates[cur])State.forexRates[cur]=1/d.rates[cur];}
                success=true;
                document.getElementById('forexStatus').textContent=`✅ ${Object.keys(State.forexRates).length} rates (Frankfurter)`;
                log(`Forex: ${Object.keys(State.forexRates).length} rates from Frankfurter`,'success');
            }catch(e){log('Frankfurter failed, trying CoinGecko…','warning');}
            // Fallback CoinGecko
            if(!success){
                try{
                    const url=`https://api.coingecko.com/api/v3/simple/price?ids=bitcoin&vs_currencies=usd,${f.join(',')}`;
                    const r=await smartFetch(url,{},true);const d=await r.json();
                    if(!d.bitcoin?.usd)throw new Error('Invalid');
                    const bu=d.bitcoin.usd;State.forexRates={};
                    for(const cur of f){if(d.bitcoin[cur])State.forexRates[cur]=bu/d.bitcoin[cur];}
                    success=true;
                    document.getElementById('forexStatus').textContent=`✅ ${Object.keys(State.forexRates).length} rates (CoinGecko)`;
                    log(`Forex: ${Object.keys(State.forexRates).length} rates from CoinGecko`,'success');
                }catch(e){log('CoinGecko failed, using cache','error');}
            }
            // Hardcoded fallback
            if(!success){
                const fb={RUB:0.012,INR:0.012,EUR:1.08,GBP:1.26,JPY:0.0067,CNY:0.14,KRW:0.00076,AUD:0.64,CAD:0.73,CHF:1.12,AED:0.27,TRY:0.032,BRL:0.18,SGD:0.74,PLN:0.23};
                State.forexRates={};for(const cur of f){if(fb[cur])State.forexRates[cur]=fb[cur];}
                document.getElementById('forexStatus').textContent=`✅ ${Object.keys(State.forexRates).length} (cached)`;
            }
            State.save();displayLowValue();
        }
        function getUsdPrice(p){if(!p)return 0;if(['USDT','USD','USDC','BUSD','GUSD'].includes(p.target))return p.price;const r=State.forexRates[p.target];return r?p.price*r:p.price;}
        function toUsd(a,c){if(!c||['USDT','USD','USDC','BUSD','GUSD'].includes(c))return a;const r=State.forexRates[c];return r?a*r:a;}

        // ── API LOADER ─────────────────────────────────
        async function loadApi(defKey){const ex=State.exchanges[defKey];const isCors=CORS_OK_EXCHANGES.has(defKey);try{let h={};if(ex.auth){const t=document.getElementById('pumpToken').value.trim();if(t)h={'Authorization':'Bearer '+t};}const r=await smartFetch(ex.url,{headers:h},isCors);if(!r.ok)throw new Error('HTTP '+r.status);const d=await r.json();let pairs=[];switch(ex.parser){case'okx':pairs=(d.data||[]).slice(0,600).map(t=>{const p=t.instId.split('-');if(p.length!==2)return null;const pr=parseFloat(t.last)||0,v=(parseFloat(t.volCcy24h)||0)*pr;return{base:p[0],target:p[1],price:pr,volume:v,liquidity:v,bidPrice:parseFloat(t.bidPx)||pr*0.999,askPrice:parseFloat(t.askPx)||pr*1.001,exchange:defKey,exchangeType:'cex'};}).filter(Boolean);break;case'coinbase':pairs=(Array.isArray(d)?d:[]).slice(0,300).map(p=>{const pr=parseFloat(p.price)||1,v=(parseFloat(p.volume)||0)*pr;return{base:p.base_currency,target:p.quote_currency,price:pr,volume:v,liquidity:v,bidPrice:pr*0.998,askPrice:pr*1.002,exchange:defKey,exchangeType:'cex'};}).filter(p=>p.price>0);break;case'binance':pairs=(Array.isArray(d)?d:[]).slice(0,600).map(t=>{const pr=parseFloat(t.lastPrice)||0,v=(parseFloat(t.quoteVolume)||0)*pr;const ps=parsePairSymbol(t.symbol||'');if(!ps)return null;return{base:ps.base,target:ps.target,price:pr,volume:v,liquidity:v,bidPrice:parseFloat(t.bidPrice)||pr*0.999,askPrice:parseFloat(t.askPrice)||pr*1.001,exchange:defKey,exchangeType:'cex'};}).filter(p=>p&&p.price>0&&p.base&&p.base!==p.target);break;case'kucoin':pairs=(d?.data?.ticker||[]).slice(0,500).map(t=>{const pr=parseFloat(t.last)||0,v=(parseFloat(t.volValue)||0)*pr;const ps=parsePairSymbol(t.symbol||'');if(!ps)return null;return{base:ps.base,target:ps.target,price:pr,volume:v,liquidity:v,bidPrice:parseFloat(t.buy)||pr*0.999,askPrice:parseFloat(t.sell)||pr*1.001,exchange:defKey,exchangeType:'cex'};}).filter(p=>p&&p.price>0&&p.base);break;case'kraken':{const result=d?.result||{};pairs=Object.keys(result).slice(0,300).map(k=>{const t=result[k];const pr=parseFloat(t.c?.[0])||0,v=(parseFloat(t.v?.[1])||0)*pr;const ps=parsePairSymbol(k);if(!ps)return null;return{base:ps.base,target:ps.target,price:pr,volume:v,liquidity:v,bidPrice:parseFloat(t.b?.[0])||pr*0.999,askPrice:parseFloat(t.a?.[0])||pr*1.001,exchange:defKey,exchangeType:'cex'};}).filter(p=>p&&p.price>0);}break;case'bitstamp':pairs=(Array.isArray(d)?d:[]).slice(0,250).map(t=>{const pr=parseFloat(t.last)||0,v=(parseFloat(t.volume)||0)*pr;const ps=(t.pair||'').split('/');return{base:ps[0]||'',target:ps[1]||'USD',price:pr,volume:v,liquidity:v,bidPrice:parseFloat(t.bid)||pr*0.999,askPrice:parseFloat(t.ask)||pr*1.001,exchange:defKey,exchangeType:'cex'};}).filter(p=>p.price>0&&p.base);break;case'gemini':pairs=(Array.isArray(d)?d:[]).map(t=>{const ps=parsePairSymbol(t.pair||t.symbol||'');if(!ps)return null;const pr=parseFloat(t.price)||0;return{base:ps.base,target:ps.target,price:pr,volume:0,liquidity:pr*100000,bidPrice:pr*0.998,askPrice:pr*1.002,exchange:defKey,exchangeType:'cex'};}).filter(p=>p&&p.price>0&&p.base!==p.target&&p.liquidity>=50);break;case'dexscreener':{const raw=d?.pairs||[];pairs=raw.slice(0,400).map(p=>{const pr=parseFloat(p.priceUsd)||0,liq=p.liquidity?.usd||0;const sp=liq>0?Math.max(0.003,Math.min(0.05,5000/liq)):0.03;return{base:p.baseToken?.symbol||'?',target:p.quoteToken?.symbol||'ETH',price:pr,volume:p.volume?.h24||0,liquidity:liq,bidPrice:pr*(1-sp/2),askPrice:pr*(1+sp/2),exchange:defKey,exchangeType:'dex'};}).filter(p=>p.base!=='?'&&p.price>0);}break;case'coingecko':pairs=(Array.isArray(d)?d:[]).slice(0,250).map(c=>({base:(c.symbol||'').toUpperCase(),target:'USD',price:c.current_price||0,volume:c.total_volume||0,liquidity:c.market_cap||0,bidPrice:(c.current_price||0)*0.999,askPrice:(c.current_price||0)*1.001,exchange:defKey,exchangeType:'info'})).filter(p=>p.price>0);break;default:pairs=[];}pairs=pairs.filter(p=>p&&p.base&&p.target&&p.base!==p.target&&p.price>0&&p.price<1e15);ex.pairs=pairs;ex.status='online';log(`${ex.name}: ${pairs.length}p`,'success');}catch(e){if(defKey==='pumpfun'){try{const fr=await smartFetch('https://api.dexscreener.com/latest/dex/search?q=SOL',{},true);const fd=await fr.json();ex.pairs=(fd?.pairs||[]).slice(0,400).map(p=>{const pr=parseFloat(p.priceUsd)||0,liq=p.liquidity?.usd||0;const sp=liq>0?Math.max(0.003,Math.min(0.05,5000/liq)):0.03;return{base:p.baseToken?.symbol||'?',target:p.quoteToken?.symbol||'ETH',price:pr,volume:p.volume?.h24||0,liquidity:liq,bidPrice:pr*(1-sp/2),askPrice:pr*(1+sp/2),exchange:'pumpfun_fallback',exchangeType:'dex'};}).filter(p=>p.base!=='?'&&p.price>0);ex.status='online';log(`Pump fb: ${ex.pairs.length}p`,'success');return;}catch(fb){}}ex.status='offline';ex.pairs=[];log(`${ex.name}: ${e.message}`,'error');if(State.proxyMode==='builtin')rotateProxy();}}
        async function initSystem(){log('🎰 Initializing...');updateStatus('🔄 LOADING...');UI.updateProxyStatus();await Promise.allSettled(exchangeDefs.map(d=>loadApi(d.key)));State.allPairs=Object.values(State.exchanges).flatMap(e=>e.pairs);State.userCoins.forEach(c=>State.allPairs.push({base:c.symbol,target:'USDT',price:c.price,volume:c.liq*0.3,liquidity:c.liq,bidPrice:c.price*0.95,askPrice:c.price*1.05,exchange:'QUANTM_DEX',exchangeType:'dex'}));State.stats.totalPairs=State.allPairs.length;State.computePurchasePower();updateIntraExCheckboxes();buildGraph();buildTriangles();displayLowValue();updateExchangeDisplay();updateStats();const on=Object.values(State.exchanges).filter(e=>e.status==='online').length;if(on>0){document.getElementById('scanBtn').disabled=false;updateStatus(`✅ READY · ${on}/${exchangeDefs.length} online`);}else updateStatus('❌ NO EXCHANGES ONLINE');if(!Object.keys(State.forexRates).length&&State.selectedFiats.size){log('Auto‑fetching forex…');await fetchForexRates();}if(document.getElementById('graphSlotContainer').style.display==='block'){if(!State.graphRenderer)State.graphRenderer=new GraphRenderer('graphNetwork');State.graphRenderer.buildFromGraph(State.graph,State.opportunities,State.purchasePower,State.highlightedPaths,State.conflictEdges||new Set());}UI.applyLevelConstraints();}
        function updateStatus(m){document.getElementById('mainStatus').textContent=m;}
        function getGraphPairs(){const m=document.getElementById('arbMode').value;if(m==='intra')return[...State.selectedIntraExchanges].flatMap(k=>State.exchanges[k]?.pairs||[]);return Object.values(State.exchanges).filter(e=>e.status==='online'&&e.parser!=='coingecko'&&e.parser!=='coinlore').flatMap(e=>e.pairs);}
        function applyWsCache(p){const c=State.wsTickers[p.exchange];if(c){const k=`${p.base}${p.target}`.toUpperCase();const t=c[k];if(t)return{...p,bidPrice:t.bid||p.bidPrice,askPrice:t.ask||p.askPrice};}return p;}
        function sanitizeRate(r){if(!isFinite(r)||r<=0)return 0;if(r>1e12)return 1e12;if(r<1e-15)return 1e-15;return r;}
        function buildGraph(){State.graph={};const pairs=getGraphPairs().map(applyWsCache);pairs.forEach(p=>{if(p.liquidity<50)return;if(!p.base||!p.target||p.base===p.target)return;if(!State.graph[p.base])State.graph[p.base]={};if(!State.graph[p.target])State.graph[p.target]={};const r1=sanitizeRate(p.bidPrice),r2=sanitizeRate(1/p.askPrice);if(r1>0)State.graph[p.base][p.target]={rate:r1,weight:-Math.log(r1),volume:p.volume,liquidity:p.liquidity,exchange:p.exchange,exchangeType:p.exchangeType,short:false};if(r2>0)State.graph[p.target][p.base]={rate:r2,weight:-Math.log(r2),volume:p.volume,liquidity:p.liquidity,exchange:p.exchange,exchangeType:p.exchangeType,short:true};});State.stats.graphNodes=Object.keys(State.graph).length;State.stats.graphEdges=Object.values(State.graph).reduce((s,o)=>s+Object.keys(o).length,0);}
        function buildTriangles(){State.triangles=[];const ns=Object.keys(State.graph);const seen=new Set();for(let i=0;i<Math.min(ns.length,150);i++){const A=ns[i];const nA=Object.keys(State.graph[A]||{});for(const B of nA){const nB=Object.keys(State.graph[B]||{});for(const C of nB){if(State.graph[C]?.[A]){const canon=[A,B,C].sort().join('|');if(!seen.has(canon)){seen.add(canon);State.triangles.push([A,B,C]);}}}}}State.stats.triangleCount=State.triangles.length;}
        function displayLowValue(){const all=State.allPairs.filter(p=>p.price>0);const fmt=p=>{const u=getUsdPrice(p).toExponential(4);let t='';if(getUsdPrice(p)<1e-15)t='PLANCK';else if(getUsdPrice(p)<1e-12)t='FEMTO';else if(getUsdPrice(p)<1e-9)t='PICO';return`<div>${p.base} $${u} <span class="tier-badge tier-${t.toLowerCase()}">${t}</span></div>`;};document.getElementById('picoValue').innerHTML=all.filter(p=>getUsdPrice(p)<1e-9&&getUsdPrice(p)>=1e-12).slice(0,25).map(fmt).join('')||'None';document.getElementById('femtoValue').innerHTML=all.filter(p=>getUsdPrice(p)<1e-12&&getUsdPrice(p)>=1e-15).slice(0,25).map(fmt).join('')||'None';document.getElementById('planckValue').innerHTML=all.filter(p=>getUsdPrice(p)<1e-15).slice(0,25).map(fmt).join('')||'None';}
        function scanTriangular(minP=0.0001){const opps=[],inv=1000;const mode=document.getElementById('arbMode').value;State.triangles.forEach(([A,B,C])=>{const orders=[[A,B,C,A],[B,C,A,B],[C,A,B,C]];for(const[s,m1,m2,e]of orders){const e1=State.graph[s]?.[m1],e2=State.graph[m1]?.[m2],e3=State.graph[m2]?.[e];if(!e1||!e2||!e3)continue;if(!State.validateCycle([e1,e2,e3]))continue;if(mode==='intra'){const exs=new Set([e1.exchange,e2.exchange,e3.exchange]);if(exs.size!==1||!State.selectedIntraExchanges.has(e1.exchange))continue;}const final=inv*e1.rate*e2.rate*e3.rate,profit=final-inv,pct=(profit/inv)*100;if(pct>=minP&&pct<50){const ms=Math.min(e1.liquidity,e2.liquidity,e3.liquidity)*0.05;opps.push({type:'triangular',path:[s,m1,m2,e],profitPercent:pct,actualProfit:toUsd((ms/inv)*profit,s),maxTradeSize:toUsd(ms,s),edges:[e1,e2,e3]});}}});return opps;}
        function bellmanFord(start,depth=5){const cs=Object.keys(State.graph);if(!cs.includes(start))return[];const mode=document.getElementById('arbMode').value;const dist={},pred={};cs.forEach(c=>{dist[c]=Infinity;pred[c]=null;});dist[start]=0;for(let i=0;i<Math.min(depth-1,cs.length-1);i++){let upd=false;for(const u of cs){const nb=State.graph[u];if(!nb)continue;for(const v in nb){const w=nb[v].weight;if(dist[u]!==Infinity&&dist[u]+w<dist[v]){if(mode==='intra'&&!State.selectedIntraExchanges.has(nb[v].exchange))continue;dist[v]=dist[u]+w;pred[v]=u;upd=true;}}}if(!upd)break;}const opps=[];const target=State.getTargetAssets();for(const u of cs){const nb=State.graph[u];if(!nb)continue;for(const v in nb){if(dist[u]!==Infinity&&dist[u]+nb[v].weight<dist[v]){const cyc=(()=>{const c=[v];let cur=v;const vis=new Set();vis.add(v);for(let i=0;i<depth;i++){cur=pred[cur];if(!cur)return null;c.push(cur);if(cur===start)return c;if(vis.has(cur))return null;vis.add(cur);}return null;})();if(cyc&&cyc[0]===start&&target.includes(start)){let amt=1000;const edges=[];let tl=Infinity;for(let i=0;i<cyc.length-1;i++){const e=State.graph[cyc[i]]?.[cyc[i+1]];if(!e)break;amt*=e.rate;edges.push(e);tl=Math.min(tl,e.liquidity);}const le=State.graph[cyc[cyc.length-1]]?.[cyc[0]];if(le&&tl>=50&&State.validateCycle([...edges,le])){amt*=le.rate;edges.push(le);tl=Math.min(tl,le.liquidity);const p=amt-1000,pc=(p/1000)*100;if(pc>=0.0001&&pc<50){const ms=Math.min(...edges.map(e=>e.liquidity))*0.05;opps.push({type:'bellman-ford',path:[...cyc,cyc[0]],profitPercent:pc,actualProfit:toUsd((ms/1000)*p,start),maxTradeSize:toUsd(ms,start),edges});}}}}}}return opps;}
        function connectAllWebSockets(){log('📡 WS...');try{const w=new WebSocket('wss://ws.okx.com:8443/ws/v5/public');w.onopen=()=>w.send(JSON.stringify({op:'subscribe',args:[{channel:'tickers',instType:'SPOT'}]}));w.onmessage=e=>{try{const d=JSON.parse(e.data);if(d.data)d.data.forEach(t=>{const p=t.instId.split('-');if(p.length===2){const k=`${p[0]}${p[1]}`.toUpperCase();if(!State.wsTickers.okx)State.wsTickers.okx={};State.wsTickers.okx[k]={bid:parseFloat(t.bidPx),ask:parseFloat(t.askPx)};}});State.stats.wsBytes+=e.data.length;}catch{}};State.exchanges.okx.wsStatus='live';}catch{}try{const w=new WebSocket('wss://stream.binance.com:9443/ws/!ticker@arr');w.onmessage=e=>{try{const d=JSON.parse(e.data);if(Array.isArray(d))d.forEach(t=>{const ps=parsePairSymbol(t.s);if(!ps)return;const k=`${ps.base}${ps.target}`.toUpperCase();if(!State.wsTickers.binance)State.wsTickers.binance={};State.wsTickers.binance[k]={bid:parseFloat(t.b),ask:parseFloat(t.a)};});State.stats.wsBytes+=e.data.length;}catch{}};State.exchanges.binance.wsStatus='live';}catch{}updateExchangeDisplay();setInterval(updateStats,2000);}
        const Engine={
            resetPaperAccount(){if(confirm('Reset all paper trading data to $10,000? This cannot be undone.')){['qfoam_v22final','wallet_sol','wallet_eth','pumpfun_token','basket','pathDepth','walletProxyUrl'].forEach(k=>localStorage.removeItem(k));location.reload();}},
            async pullGraphLever(){const now=Date.now();if(now-State.lastPullTime<15000){const r=Math.ceil((15000-(now-State.lastPullTime))/1000);log(`⏳ ${r}s`,'warning');return;}State.lastPullTime=now;const btn=document.getElementById('pullLeverBtn2');btn.disabled=true;btn.innerHTML='🎰 SPINNING…';document.getElementById('slotResult2').textContent='';document.getElementById('accumulationInfo').textContent='';playSpin();await initSystem();const useBellman=document.getElementById('bellmanToggle').checked&&State.level>=5;await runFullScan(true,useBellman);State.computePurchasePower();const multiLineCount=parseInt(document.getElementById('multiLineCount')?.value||7);const all=[...State.opportunities.mega,...State.opportunities.triangular,...State.opportunities.bellman];State.highlightedPaths=[];State.conflictEdges=new Set();if(all.length){all.sort((a,b)=>b.profitPercent-a.profitPercent);const top=all.slice(0,multiLineCount);State.highlightedPaths=top.map(o=>o.path);const edgeCount=new Map();for(const path of State.highlightedPaths){for(let i=0;i<path.length-1;i++){const ek=[path[i],path[i+1]].sort().join('|');edgeCount.set(ek,(edgeCount.get(ek)||0)+1);}}for(const[ek,count]of edgeCount){if(count>1)State.conflictEdges.add(ek);}const best=top[0];document.getElementById('slotResult2').textContent=`🎉 WIN! +${best.profitPercent.toFixed(2)}% — ${best.path.slice(0,4).join(' → ')}`;document.getElementById('slotResult2').style.color=best.profitPercent>5?'#ff00ff':'var(--gold)';confetti(window.innerWidth/2,130,45);const accInfo=[];const targets=State.getTargetAssets();for(const t of targets){const price=State.getAssetPrice(t);if(price>0&&State.bankroll>0){const directAmount=State.bankroll/price;const bestPathForT=all.find(o=>o.path[0]===t&&o.path[o.path.length-1]===t);if(bestPathForT){const pathAmount=State.bankroll*(1+bestPathForT.profitPercent/100)/price;const improvement=((pathAmount-directAmount)/directAmount*100).toFixed(2);accInfo.push(`${t}: direct ${directAmount.toFixed(4)} → path ${pathAmount.toFixed(4)} (${improvement}% more)`);}}}if(accInfo.length)document.getElementById('accumulationInfo').textContent=accInfo.join(' | ');if(document.getElementById('autoOpenTrade').checked)setTimeout(()=>UI.openTradeModal(encodeURIComponent(JSON.stringify(best))),500);}else{document.getElementById('slotResult2').textContent='❌ NO PATH FOUND';}if(State.graphRenderer){State.graphRenderer.buildFromGraph(State.graph,State.opportunities,State.purchasePower,State.highlightedPaths,State.conflictEdges);}const cd=setInterval(()=>{const e=Date.now()-State.lastPullTime;const r=Math.max(0,15000-e);if(r<=0){btn.disabled=false;btn.innerHTML='🎰 PULL LEVER';clearInterval(cd);}else btn.innerHTML=`⏳ ${Math.ceil(r/1000)}s`;},500);},
            async executeAllLines(){
                if(State.bankroll<=0){log('❌ Cannot execute: bankroll exhausted','error');document.getElementById('batchResult').innerHTML='<span style="color:#ff4444;">❌ Bankroll exhausted. Reset or add funds.</span>';return;}
                if(State.liveMode){const walletUrl=document.getElementById('walletProxyUrl').value.trim();if(!walletUrl||!walletUrl.startsWith('http')){log('❌ Live mode requires a valid Wallet Proxy URL','error');return;}}
                if(!State.highlightedPaths.length){log('No paylines yet, auto‑pulling data…');await Engine.pullGraphLever();if(State.bankroll<=0){log('❌ Bankroll still exhausted after pull','error');return;}if(!State.highlightedPaths.length){log('Still no paylines after auto‑pull.','warning');return;}}
                const paths=State.highlightedPaths;const totalPaths=paths.length;const perPath=Math.abs(State.bankroll*0.8/totalPaths);let reinvestPercent=Math.min(100,Math.max(0,parseFloat(document.getElementById('reinvestPercent')?.value||50)))/100;
                log(`🚀 Executing ${totalPaths} paylines with $${perPath.toFixed(2)} each...`);
                const batchEl=document.getElementById('batchResult');batchEl.innerHTML='<strong>🚀 BATCH EXECUTION</strong><br>';
                let totalProfit=0;const targets=State.getTargetAssets();const acquired={};const pathDescriptions={};
                const execUrlBase=document.getElementById('walletProxyUrl').value.trim();
                const execPath=document.getElementById('execPath').value.trim()||'/execute';
                for(let i=0;i<paths.length;i++){
                    const path=paths[i];const opp=[...State.opportunities.mega,...State.opportunities.triangular,...State.opportunities.bellman].find(o=>o.path.join('|')===path.join('|'));
                    if(!opp){batchEl.innerHTML+=`<div>Line ${i+1}: ${path.join(' → ')} — ❌ opportunity not found</div>`;continue;}
                    const sz=Math.min(opp.maxTradeSize,perPath);let rt=sz;let valid=true;
                    for(const e of opp.edges){if(!State.validateEdge(e)){valid=false;break;}rt*=e.rate;}
                    if(!valid||!State.validateCycle(opp.edges)){batchEl.innerHTML+=`<div>Line ${i+1}: ${path.join(' → ')} — ⚠️ skipped (suspicious rates)</div>`;log(`⚠️ Line ${i+1} skipped: suspicious rates`,'warning');continue;}
                    const profit=rt-sz;if(profit<0&&Math.abs(profit)>sz*0.5){batchEl.innerHTML+=`<div>Line ${i+1}: ${path.join(' → ')} — ⚠️ skipped (rate stale, large loss)</div>`;log(`⚠️ Line ${i+1} skipped: stale rates`,'warning');continue;}
                    if(State.liveMode){
                        try{
                            const resp=await fetch(execUrlBase+execPath,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({paths:opp.path,amount:sz})});
                            if(!resp.ok)throw new Error('Proxy returned '+resp.status);
                            const data=await resp.json();
                            if(!data.success)throw new Error(data.error||'Trade rejected by proxy');
                            log(`✅ Line ${i+1} confirmed by proxy`,'success');
                        }catch(err){batchEl.innerHTML+=`<div style="color:#ff4444;">Line ${i+1}: ${path.join(' → ')} — ❌ proxy failed: ${err.message}</div>`;log(`❌ Line ${i+1} proxy error: ${err.message}`,'error');continue;}
                    }
                    State.bankroll+=profit*0.9;State.qFund+=profit*0.05;State.lFund+=profit*0.05;
                    State.matrix+=10+Math.floor(sz/100);totalProfit+=profit;State.addTradeToLedger(opp,sz,profit);
                    const startAsset=path[0];if(targets.includes(startAsset)){const endAmount=sz*(1+opp.profitPercent/100);const price=State.getAssetPrice(startAsset);if(price>0){const acquiredAmount=endAmount/price;State.recordBasketPurchase(startAsset,acquiredAmount,path.join(' → '));if(!acquired[startAsset])acquired[startAsset]=0;acquired[startAsset]+=acquiredAmount;if(!pathDescriptions[startAsset])pathDescriptions[startAsset]=new Set();pathDescriptions[startAsset].add(path.join(' → '));}}
                    batchEl.innerHTML+=`<div style="color:${profit>=0?'var(--green)':'#ff4444'}">Line ${i+1}: ${path.join(' → ')} — $${sz.toFixed(2)} → $${rt.toFixed(2)} (${profit>=0?'+':''}$${profit.toFixed(2)})</div>`;
                    log(`💸 Line ${i+1}: ${path.join(' → ')} profit $${profit.toFixed(2)}`,'success');playWin();
                }
                if(reinvestPercent>0&&totalProfit>0&&targets.length&&State.bankroll>0){let reinvestAmount=Math.min(totalProfit*reinvestPercent,State.bankroll);if(reinvestAmount>0){State.bankroll-=reinvestAmount;batchEl.innerHTML+=`<br><strong>💰 Reinvesting $${reinvestAmount.toFixed(2)} into targets...</strong><br>`;for(const t of targets){const price=State.getAssetPrice(t);if(price>0){const amount=reinvestAmount/targets.length/price;State.recordBasketPurchase(t,amount,'Reinvestment');if(!acquired[t])acquired[t]=0;acquired[t]+=amount;if(!pathDescriptions[t])pathDescriptions[t]=new Set();pathDescriptions[t].add('Reinvestment');batchEl.innerHTML+=`<div>📦 ${t}: +${amount.toFixed(6)} @ $${price.toExponential(4)}</div>`;log(`📦 Bought ${amount.toFixed(6)} ${t}`,'success');}}}}
                State.level=Math.floor(Math.sqrt(State.matrix/10))+1;State.save();UI.updateProfile();
                batchEl.innerHTML+=`<br><strong>Total profit: $${totalProfit.toFixed(2)}</strong>`;
                if(Object.keys(acquired).length){batchEl.innerHTML+='<br><strong>🎯 Acquired:</strong><br>';for(const[asset,amount]of Object.entries(acquired)){const paths=pathDescriptions[asset]?[...pathDescriptions[asset]].join(', '):'unknown';batchEl.innerHTML+=`<div>📦 ${asset}: ${amount.toFixed(6)} <small>(via ${paths})</small></div>`;}}
                confetti(window.innerWidth/2,200,80);
            },
            async executeTrade(opp,size,netProfit){
                if(State.bankroll<=0){log('❌ Bankroll exhausted','error');return;}
                if(State.liveMode){
                    const execUrlBase=document.getElementById('walletProxyUrl').value.trim();
                    const execPath=document.getElementById('execPath').value.trim()||'/execute';
                    if(!execUrlBase||!execUrlBase.startsWith('http')){log('❌ Live mode requires a valid Wallet Proxy URL','error');return;}
                    try{
                        const resp=await fetch(execUrlBase+execPath,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({paths:opp.path,amount:size})});
                        if(!resp.ok)throw new Error('Proxy HTTP '+resp.status);
                        const data=await resp.json();
                        if(!data.success)throw new Error(data.error||'Trade rejected');
                        log('✅ Trade confirmed by proxy','success');
                    }catch(err){log(`❌ Proxy error: ${err.message}`,'error');return;}
                }
                const live=State.liveMode;const fee=live?5:0;const fp=netProfit-fee;
                State.bankroll+=fp*0.9;State.qFund+=fp*0.05;State.lFund+=fp*0.05;
                State.matrix+=10+Math.floor(size/100);
                State.level=Math.floor(Math.sqrt(State.matrix/10))+1;
                State.addTradeToLedger(opp,size,fp);State.save();UI.updateProfile();
                log(`💸 Trade: $${fp.toFixed(2)}`,'success');playWin();
            }
        };
        function toggleLiveScan(){if(State.liveScanActive){clearInterval(State.liveScanInterval);State.liveScanActive=false;document.getElementById('liveScanBtn').classList.remove('live');document.getElementById('liveScanBtn').textContent='🔄 LIVE';log('🖱️ Live off');}else{State.liveScanActive=true;document.getElementById('liveScanBtn').classList.add('live');document.getElementById('liveScanBtn').textContent='⏹️ STOP';log('🖱️ Live on');runFullScan();State.liveScanInterval=setInterval(()=>{if(!document.getElementById('scanBtn').disabled)runFullScan();},30000);}}
        async function runFullScan(sil=false,useBellman=false){const depth=parseInt(document.getElementById('pathInput').value)||5;if(!sil)log(`Scan depth ${depth}…`);buildGraph();buildTriangles();State.opportunities={mega:[],triangular:[],bellman:[],suspicious:[]};const tri=scanTriangular();const bf=[];if(useBellman||(!sil&&document.getElementById('bellmanToggle')?.checked&&State.level>=5)){const minProfit=parseFloat(document.getElementById('minProfitInput')?.value)||0.0001;const targets=State.getTargetAssets();let found=false;const fallback=document.getElementById('fallbackCheck')?.checked;for(const t of targets){if(State.graph[t]){const res=bellmanFord(t,depth);if(res.length&&res.some(o=>o.profitPercent>=minProfit)){bf.push(...res.filter(o=>o.profitPercent>=minProfit));found=true;if(!fallback)break;}}}if(!found&&fallback){for(const t of targets){if(State.graph[t])bf.push(...bellmanFord(t,depth));}}}const all=[...tri,...bf];all.forEach(o=>{if(o.profitPercent>5)State.opportunities.mega.push(o);else if(o.type==='triangular')State.opportunities.triangular.push(o);else State.opportunities.bellman.push(o);});updateStats();if(!sil){['megaOpps','triangularOpps','bellmanOpps','suspiciousOpps'].forEach(id=>{document.getElementById(id).innerHTML='';});State.opportunities.mega.forEach(o=>UI.renderOpp(o,'megaOpps',true));State.opportunities.triangular.forEach(o=>UI.renderOpp(o,'triangularOpps'));State.opportunities.bellman.forEach(o=>UI.renderOpp(o,'bellmanOpps'));updateStatus(`✅ ${all.length} opps`);}if(State.graphRenderer&&document.getElementById('graphSlotContainer').style.display==='block'){State.computePurchasePower();State.graphRenderer.buildFromGraph(State.graph,State.opportunities,State.purchasePower,State.highlightedPaths,State.conflictEdges||new Set());}}
        function updateStats(){document.getElementById('totalPairs').textContent=State.stats.totalPairs;document.getElementById('graphNodes').textContent=State.stats.graphNodes;document.getElementById('graphEdges').textContent=State.stats.graphEdges;document.getElementById('triangleCount').textContent=State.stats.triangleCount;const oc=Object.values(State.opportunities).flat().length;document.getElementById('oppCount').textContent=oc;document.getElementById('megaCount').textContent=State.opportunities.mega.length;document.getElementById('triangularCount').textContent=State.opportunities.triangular.length;document.getElementById('bellmanCount').textContent=State.opportunities.bellman.length;UI.updateProfile();}
        function updateExchangeDisplay(){const c=document.getElementById('exchangeStatus');if(!c)return;c.innerHTML=Object.values(State.exchanges).map(e=>{let cls=e.wsStatus==='live'?'ws':e.status==='online'?'online':'';return`<div class="exchange-status"><div class="indicator ${cls}"></div><strong>${e.name}</strong> ${e.pairs.length}p</div>`;}).join('');}
        function updateIntraExCheckboxes(){const c=document.getElementById('intraExCheckboxes');if(!c)return;const allExs=Object.keys(State.exchanges).filter(k=>State.exchanges[k].parser!=='coingecko'&&State.exchanges[k].parser!=='coinlore');const maxSelect=State.level+2;c.innerHTML=allExs.map(k=>{const online=State.exchanges[k].status==='online';const checked=State.selectedIntraExchanges.has(k)?'checked':'';const disabled=online?'':'disabled';return`<label style="opacity:${online?1:0.5}"><input type="checkbox" value="${k}" ${checked} ${disabled} onchange="toggleIntraEx('${k}')"> ${State.exchanges[k].name}</label>`;}).join('');if(!State.selectedIntraExchanges.size&&allExs.length){const onlineExs=allExs.filter(k=>State.exchanges[k].status==='online');if(onlineExs.length){const largest=onlineExs.sort((a,b)=>State.exchanges[b].pairs.length-State.exchanges[a].pairs.length)[0];State.selectedIntraExchanges.add(largest);updateIntraExCheckboxes();}}}
        function toggleIntraEx(k){if(State.exchanges[k].status!=='online'){log('Offline','warning');return;}if(State.selectedIntraExchanges.has(k)){State.selectedIntraExchanges.delete(k);}else{const max=State.level+2;if(State.selectedIntraExchanges.size>=max){log(`Max ${max}`,'warning');return;}State.selectedIntraExchanges.add(k);}log(`🖱️ Intra: ${k}`);updateIntraExCheckboxes();}
        function selectAllIntra(){const max=State.level+2;State.selectedIntraExchanges.clear();const online=Object.keys(State.exchanges).filter(k=>State.exchanges[k].status==='online'&&State.exchanges[k].parser!=='coingecko');online.slice(0,max).forEach(k=>State.selectedIntraExchanges.add(k));updateIntraExCheckboxes();log(`🖱️ ALL (max ${max})`);}
        function deselectAllIntra(){State.selectedIntraExchanges.clear();updateIntraExCheckboxes();log('🖱️ NONE');}
        function syncBetInput(){document.getElementById('betInput').value=document.getElementById('betSlider').value;}
        function syncBetSlider(){document.getElementById('betSlider').value=document.getElementById('betInput').value;}
        function shareJackpot(){const m=State.opportunities.mega[0];if(m){navigator.clipboard.writeText(`🎰 ${m.profitPercent.toFixed(2)}% arb on QuanTM FOAM!`);log('📤 Copied!','success');}}
        function toggleTheme(){document.body.style.filter=document.body.style.filter==='hue-rotate(180deg)'?'none':'hue-rotate(180deg)';log('🖱️ Theme');}
        function openCreateCoinModal(){if(State.level<5){alert('Need level 5!');return;}document.getElementById('createCoinModal').style.display='flex';}
        function closeCreateCoinModal(){document.getElementById('createCoinModal').style.display='none';}
        document.getElementById('createCoinBtn').addEventListener('click',()=>{const s=document.getElementById('newCoinSymbol').value.trim().toUpperCase();const pr=parseFloat(document.getElementById('newCoinPrice').value)||0.000001;const liq=parseFloat(document.getElementById('newCoinLiq').value)||500;if(!s)return;State.userCoins.push({symbol:s,price:pr,liq});State.allPairs.push({base:s,target:'USDT',price:pr,volume:liq*0.3,liquidity:liq,bidPrice:pr*0.95,askPrice:pr*1.05,exchange:'QUANTM_DEX',exchangeType:'dex'});State.stats.totalPairs++;State.save();closeCreateCoinModal();log(`🪙 ${s} created!`,'success');State.matrix+=50;State.level=Math.floor(Math.sqrt(State.matrix/10))+1;UI.updateProfile();});
        window.addEventListener('load',()=>{State.load();log('🎰 v22.21 ready – XP Separation + FX Fix + Target Lists.','success');document.getElementById('logs').style.display='block';UI.updateProxyStatus();UI.renderFiatCheckboxes();document.getElementById('slotDepthLabel2').textContent=document.getElementById('pathInput').value;UI.applyLevelConstraints();updateIntraExCheckboxes();UI.renderBasketTracker();document.getElementById('modeLabel').textContent=State.liveMode?'LIVE':'PAPER';});
    </script>
</body>
</html>
