async executeTriangularArbitrage(pairs, exchange, investmentAmount, minProfitPercent) {
    this.logger.log('TRIANGULAR', `Executing triangular arbitrage on ${exchange}`, 'info');
    const opportunities = [];

    // Check all combinations of three pairs
    for (let i = 0; i < Math.min(pairs.length, 100); i++) {
        if (this.currentScanId === null) break;

        for (let j = i + 1; j < Math.min(pairs.length, 100); j++) {
            for (let k = j + 1; k < Math.min(pairs.length, 100); k++) {
                const opportunity = this.checkTriangleArbitrage(
                    [pairs[i], pairs[j], pairs[k]], 
                    investmentAmount,
                    minProfitPercent
                );
                if (opportunity) {
                    opportunity.exchange = exchange;
                    opportunities.push(opportunity);
                }
            }
        }
    }

    return opportunities;
}
