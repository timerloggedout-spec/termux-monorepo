from fastapi import FastAPI, HTTPException
from fastapi.middleware.cors import CORSMiddleware
import asyncio
from yobitrageswap.main import run_analysis

app = FastAPI()

app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

@app.post("/initialize")
async def initialize_engine():
    # TODO: Initialize the engine (load config, etc.)
    return {"status": "initialized"}

@app.get("/exchanges")
async def get_exchanges():
    # TODO: Return the list of supported exchanges
    return ["binance", "kraken", "kucoin", "coinbase"]

@app.get("/exchange/{exchange}/pairs")
async def get_exchange_pairs(exchange: str):
    # TODO: Return the pairs for the given exchange
    return []

@app.post("/scan")
async def scan_arbitrage(exchange: str, method: str, investment: float, batch_size: int):
    # TODO: Run the arbitrage scan
    opportunities = await run_analysis(exchange, method, live=False, ui=False)
    return opportunities

