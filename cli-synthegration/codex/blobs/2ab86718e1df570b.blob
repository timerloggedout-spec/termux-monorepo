<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tallah/Goldie Case: Interactive Investigation Timeline</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        @import url('https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Cinzel:wght@400;600;700&display=swap');

        :root {
            --gold: #D4AF37;
            --platinum: #E5E4E2;
            --burgundy: #800020;
            --lavender: #9B7CB6;
            --cream: #F8F4F0;
            --bronze: #B8966C;
            --silver: #C0C0C0;
            --shadow: rgba(128,0,32,0.3);
        }

        body {
            font-family: 'Cinzel', serif;
            background: var(--cream);
            color: var(--burgundy);
            line-height: 1.6;
            position: relative;
            overflow-x: hidden;
        }

        /* Royal ornate pattern background with enhanced filigree */
        body::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-image: 
                radial-gradient(circle at 20% 30%, rgba(212, 175, 55, 0.05) 0%, transparent 20%),
                radial-gradient(circle at 80% 70%, rgba(212, 175, 55, 0.05) 0%, transparent 20%),
                linear-gradient(45deg, rgba(229, 228, 226, 0.03) 25%, transparent 25%, transparent 75%, rgba(229, 228, 226, 0.03) 75%),
                linear-gradient(-45deg, rgba(212, 175, 55, 0.03) 25%, transparent 25%, transparent 75%, rgba(212, 175, 55, 0.03) 75%);
            background-size: 100px 100px, 100px 100px, 20px 20px, 20px 20px;
            z-index: -2;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 20px;
            position: relative;
            z-index: 1;
        }

        /* Enhanced Royal Header with shimmer effect */
        .header {
            text-align: center;
            margin-bottom: 50px;
            padding: 40px 30px;
            background: var(--cream);
            border: 3px solid var(--gold);
            border-radius: 15px;
            position: relative;
            overflow: hidden;
            box-shadow: 0 10px 30px var(--shadow);
            transition: all 0.5s ease;
        }

        .header::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: linear-gradient(
                45deg,
                transparent 30%,
                rgba(212, 175, 55, 0.1) 50%,
                transparent 70%
            );
            transform: rotate(45deg);
            transition: all 0.8s ease;
            opacity: 0;
        }

        .header:hover::before {
            animation: royalShimmer 2s ease;
        }

        @keyframes royalShimmer {
            0% { opacity: 0; transform: rotate(45deg) translateX(-100%); }
            50% { opacity: 1; }
            100% { opacity: 0; transform: rotate(45deg) translateX(100%); }
        }

        .header h1 {
            font-size: 2.8em;
            margin-bottom: 15px;
            color: var(--burgundy);
            font-weight: 700;
            font-family: 'Amiri', serif;
            text-shadow: 2px 2px 4px rgba(128, 0, 32, 0.1);
            position: relative;
        }

        .header h1::after {
            content: '';
            position: absolute;
            bottom: -10px;
            left: 50%;
            transform: translateX(-50%);
            width: 100px;
            height: 3px;
            background: linear-gradient(to right, transparent, var(--gold), transparent);
        }

        .header .subtitle {
            font-size: 1.3em;
            color: var(--lavender);
            margin-bottom: 10px;
            font-style: italic;
        }

        .header .case-details {
            font-size: 1.1em;
            color: var(--bronze);
            font-style: italic;
        }

        /* Navigation Menu */
        .nav-menu {
            background: rgba(248,244,240,0.95);
            border: 2px solid var(--gold);
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 40px;
            text-align: center;
            box-shadow: 0 5px 15px var(--shadow);
        }

        .nav-menu h3 {
            color: var(--burgundy);
            margin-bottom: 15px;
            font-family: 'Amiri', serif;
        }

        .nav-links {
            display: flex;
            justify-content: center;
            gap: 30px;
            flex-wrap: wrap;
        }

        .nav-link {
            color: var(--lavender);
            text-decoration: none;
            padding: 8px 15px;
            border: 1px solid var(--gold);
            border-radius: 8px;
            transition: all 0.3s ease;
            font-weight: 500;
            position: relative;
            overflow: hidden;
        }

        .nav-link::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(212, 175, 55, 0.3), transparent);
            transition: left 0.5s;
        }

        .nav-link:hover::before {
            left: 100%;
        }

        .nav-link:hover {
            background: var(--gold);
            color: var(--burgundy);
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(212, 175, 55, 0.3);
        }

        /* Section Organization */
        .section {
            margin: 60px 0;
            padding: 40px;
            background: rgba(248,244,240,0.98);
            border: 2px solid var(--gold);
            border-radius: 20px;
            position: relative;
            box-shadow: 0 8px 25px var(--shadow);
            transition: transform 0.3s ease;
        }

        .section:hover {
            transform: translateY(-5px);
        }

        .section-header {
            text-align: center;
            margin-bottom: 40px;
            padding-bottom: 20px;
            border-bottom: 2px solid var(--gold);
            position: relative;
        }

        .section-header::after {
            content: '';
            position: absolute;
            bottom: -2px;
            left: 50%;
            transform: translateX(-50%);
            width: 100px;
            height: 4px;
            background: linear-gradient(to right, var(--gold), var(--platinum), var(--gold));
            border-radius: 2px;
        }

        .section-title {
            font-size: 2.4em;
            color: var(--burgundy);
            font-family: 'Amiri', serif;
            margin-bottom: 10px;
        }

        .section-description {
            font-size: 1.2em;
            color: var(--lavender);
            font-style: italic;
        }

        /* Timeline Styles */
        .timeline {
            position: relative;
            margin: 0 auto;
            padding: 30px 0;
        }

        .timeline::before {
            content: '';
            position: absolute;
            left: 50%;
            top: 0;
            bottom: 0;
            width: 6px;
            background: linear-gradient(to bottom, var(--gold), var(--platinum), var(--gold));
            transform: translateX(-50%);
            box-shadow: 0 0 15px rgba(212, 175, 55, 0.4);
            border-radius: 3px;
        }

        .day-section {
            margin-bottom: 80px;
        }

        .day-header {
            text-align: center;
            font-size: 1.8em;
            color: var(--burgundy);
            margin-bottom: 40px;
            padding: 20px;
            background: var(--cream);
            border: 2px solid var(--gold);
            border-radius: 15px;
            font-family: 'Amiri', serif;
            position: relative;
            overflow: hidden;
        }

        .day-header::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(45deg, transparent 30%, rgba(212, 175, 55, 0.1) 50%, transparent 70%);
            opacity: 0;
            transition: opacity 0.5s ease;
        }

        .day-header:hover::before {
            opacity: 1;
        }

        /* Event Styles */
        .event {
            position: relative;
            width: 45%;
            padding: 25px;
            margin: 25px 0;
            background: var(--cream);
            border-radius: 15px;
            border: 2px solid rgba(232,180,160,0.6);
            box-shadow: 0 8px 20px var(--shadow);
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            cursor: pointer;
            overflow: visible;
        }

        .event:hover {
            transform: translateY(-8px) scale(1.02);
            box-shadow: 0 15px 30px var(--shadow);
            border-color: var(--gold);
        }

        .event.left {
            left: 0;
        }

        .event.right {
            left: 55%;
        }

        /* Enhanced Hexagonal Interaction System */
        .hex-button {
            position: absolute;
            top: 30px;
            width: 50px;
            height: 50px;
            cursor: pointer;
            transition: all 0.3s ease;
            filter: drop-shadow(0 0 5px rgba(212, 175, 55, 0.5));
        }

        .hex-main {
            width: 50px;
            height: 50px;
            background: var(--gold);
            clip-path: polygon(25% 6.7%, 75% 6.7%, 100% 50%, 75% 93.3%, 25% 93.3%, 0% 50%);
            position: relative;
            z-index: 10;
            transition: all 0.3s ease;
            background: linear-gradient(135deg, var(--gold) 0%, var(--platinum) 100%);
        }

        .event.left .hex-button {
            right: -75px;
        }

        .event.right .hex-button {
            left: -75px;
        }

        .hex-satellites {
            position: absolute;
            top: 0;
            left: 0;
            width: 50px;
            height: 50px;
            opacity: 0;
            transition: opacity 0.3s ease;
            pointer-events: none;
        }

        .hex-satellite {
            position: absolute;
            width: 20px;
            height: 20px;
            background: rgba(155,124,182,0.7);
            clip-path: polygon(25% 6.7%, 75% 6.7%, 100% 50%, 75% 93.3%, 25% 93.3%, 0% 50%);
            animation: satellitePulse 2s ease-in-out infinite;
            background: linear-gradient(135deg, var(--lavender) 0%, var(--silver) 100%);
        }

        .event:hover .hex-satellites {
            opacity: 1;
        }

        .event:hover .hex-main {
            transform: scale(1.3);
            box-shadow: 0 0 25px var(--gold);
            animation: hexPulse 1.5s ease-in-out infinite;
        }

        /* Satellite positioning - 6 points around main hex */
        .hex-satellite:nth-child(1) { top: -25px; left: 15px; animation-delay: 0s; }
        .hex-satellite:nth-child(2) { top: -12px; left: 35px; animation-delay: 0.2s; }
        .hex-satellite:nth-child(3) { top: 12px; left: 35px; animation-delay: 0.4s; }
        .hex-satellite:nth-child(4) { top: 25px; left: 15px; animation-delay: 0.6s; }
        .hex-satellite:nth-child(5) { top: 12px; left: -5px; animation-delay: 0.8s; }
        .hex-satellite:nth-child(6) { top: -12px; left: -5px; animation-delay: 1s; }

        @keyframes hexPulse {
            0%, 100% { transform: scale(1.3); opacity: 1; }
            50% { transform: scale(1.5); opacity: 0.8; }
        }

        @keyframes satellitePulse {
            0%, 100% { transform: scale(0.8); opacity: 0.6; }
            50% { transform: scale(1.2); opacity: 1; }
        }

        /* Event Type Classifications */
        .event.critical .hex-main {
            background: linear-gradient(135deg, var(--burgundy) 0%, #600018 100%);
            animation: criticalAlert 1s ease-in-out infinite alternate;
        }

        .event.legal .hex-main {
            background: linear-gradient(135deg, var(--lavender) 0%, #7B5F9B 100%);
        }

        .event.communication .hex-main {
            background: linear-gradient(135deg, #B8D4F1 0%, #9BB9E1 100%);
        }

        .event.medical .hex-main {
            background: linear-gradient(135deg, var(--bronze) 0%, #9A7A54 100%);
        }

        @keyframes criticalAlert {
            0% { box-shadow: 0 0 15px rgba(128,0,32,0.6); }
            100% { box-shadow: 0 0 25px rgba(128,0,32,1); }
        }

        .event-time {
            font-size: 1em;
            color: var(--gold);
            font-weight: bold;
            margin-bottom: 12px;
            text-shadow: 1px 1px 2px rgba(128,0,32,0.2);
        }

        .event-title {
            font-size: 1.4em;
            color: var(--burgundy);
            margin-bottom: 12px;
            font-weight: 600;
            font-family: 'Amiri', serif;
        }

        .event-description {
            color: var(--lavender);
            font-size: 1em;
            line-height: 1.6;
        }

        .source-citation {
            font-size: 0.85em;
            color: var(--bronze);
            font-style: italic;
            margin-top: 10px;
            padding-top: 8px;
            border-top: 1px solid rgba(232,180,160,0.4);
        }

        .response-indicator {
            position: absolute;
            top: 12px;
            right: 12px;
            width: 20px;
            height: 20px;
            border-radius: 50%;
            border: 2px solid var(--cream);
            box-shadow: 0 0 5px rgba(0,0,0,0.2);
        }

        .response-positive { background: var(--lavender); }
        .response-negative { background: var(--burgundy); }
        .response-none { background: var(--bronze); }

        /* Interactive Network Visualization */
        .network-container {
            position: relative;
            width: 100%;
            height: 600px;
            border: 2px solid rgba(212, 175, 55, 0.4);
            border-radius: 10px;
            overflow: hidden;
            background: rgba(248,244,240,0.8);
            margin: 30px 0;
        }

        #network-graph {
            width: 100%;
            height: 100%;
        }

        .controls {
            position: absolute;
            top: 15px;
            right: 15px;
            background: rgba(128,0,32,0.8);
            border-radius: 10px;
            padding: 10px;
            display: flex;
            gap: 10px;
            z-index: 100;
        }

        .control-btn {
            background: var(--gold);
            color: var(--burgundy);
            border: none;
            border-radius: 6px;
            padding: 8px 12px;
            cursor: pointer;
            font-weight: bold;
            font-family: 'Cinzel', serif;
            transition: all 0.3s ease;
        }

        .control-btn:hover {
            background: var(--burgundy);
            color: var(--cream);
        }

        .timeline-filter {
            display: flex;
            justify-content: center;
            gap: 10px;
            margin-bottom: 20px;
            flex-wrap: wrap;
        }

        .filter-btn {
            background: var(--gold);
            color: var(--burgundy);
            border: 1px solid var(--gold);
            border-radius: 20px;
            padding: 8px 15px;
            cursor: pointer;
            transition: all 0.3s ease;
            font-family: 'Cinzel', serif;
            position: relative;
            overflow: hidden;
        }

        .filter-btn::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
            transition: left 0.5s;
        }

        .filter-btn:hover::before {
            left: 100%;
        }

        .filter-btn.active {
            background: var(--burgundy);
            color: var(--cream);
            box-shadow: 0 0 10px rgba(128,0,32,0.3);
        }

        .legend {
            position: absolute;
            bottom: 15px;
            left: 15px;
            background: rgba(248,244,240,0.95);
            border: 1px solid var(--gold);
            border-radius: 8px;
            padding: 15px;
            z-index: 100;
            max-width: 250px;
            box-shadow: 0 5px 15px var(--shadow);
        }

        .legend-item {
            display: flex;
            align-items: center;
            margin-bottom: 8px;
        }

        .legend-color {
            width: 20px;
            height: 20px;
            border-radius: 50%;
            margin-right: 10px;
            border: 1px solid var(--burgundy);
        }

        .legend-text {
            font-size: 0.9em;
            color: var(--burgundy);
        }

        .node-info {
            position: absolute;
            top: 15px;
            left: 15px;
            background: rgba(248,244,240,0.95);
            border: 1px solid var(--gold);
            border-radius: 8px;
            padding: 15px;
            z-index: 100;
            max-width: 300px;
            display: none;
            box-shadow: 0 5px 15px var(--shadow);
        }

        .node-info h3 {
            color: var(--burgundy);
            margin-bottom: 10px;
            font-family: 'Amiri', serif;
        }

        .node-info p {
            color: var(--lavender);
            margin-bottom: 5px;
            font-size: 0.9em;
        }

        /* Escalation Timeline */
        .escalation-timeline {
            margin: 40px 0;
        }

        .escalation-flow {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        .escalation-item {
            background: rgba(248,244,240,0.9);
            padding: 20px;
            border-radius: 10px;
            border-left: 5px solid var(--gold);
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .escalation-item::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(212, 175, 55, 0.1), transparent);
            transition: left 0.5s;
        }

        .escalation-item:hover::before {
            left: 100%;
        }

        .escalation-item:hover {
            transform: translateX(8px);
            box-shadow: 0 5px 15px var(--shadow);
        }

        .escalation-date {
            color: var(--burgundy);
            font-weight: bold;
            font-family: 'Amiri', serif;
            margin-right: 15px;
        }

        .escalation-critical {
            border-left-color: var(--burgundy);
            background: rgba(128,0,32,0.05);
        }

        /* Mobile Responsiveness */
        @media (max-width: 768px) {
            .timeline::before { left: 30px; }
            .event { width: calc(100% - 80px); left: 80px !important; }
            .event.left .hex-button, .event.right .hex-button { left: -75px !important; }
            .header h1 { font-size: 2.2em; }
            .nav-links { flex-direction: column; gap: 15px; }
            .section { padding: 20px; }
            .section-title { font-size: 1.8em; }
            .network-container { height: 400px; }
            .controls { top: 10px; right: 10px; flex-direction: column; }
            .legend { bottom: 10px; left: 10px; max-width: 200px; padding: 10px; }
            .node-info { max-width: 250px; }
        }

        @media (max-width: 480px) {
            .container { padding: 10px; }
            .header { padding: 20px 15px; }
            .header h1 { font-size: 1.8em; }
            .section { margin: 30px 0; padding: 15px; }
            .section-title { font-size: 1.5em; }
            .event { padding: 15px; }
            .event-title { font-size: 1.2em; }
            .network-container { height: 300px; }
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Header Section -->
        <header class="header" id="header">
            <h1>Tallah/Goldie Case Analysis</h1>
            <div class="subtitle">Interactive Investigation Timeline & Communication Network</div>
            <div class="case-details">September 3-18, 2025 | Service Doberman Suspicious Death Investigation</div>
        </header>

        <!-- Navigation Menu -->
        <nav class="nav-menu">
            <h3>Document Sections</h3>
            <div class="nav-links" id="nav-links">
                <!-- Navigation will be generated by JavaScript -->
            </div>
        </nav>

        <!-- Main content sections will be generated by JavaScript -->
        <main id="main-content">
            <!-- Content will be dynamically generated -->
        </main>
    </div>

    <script>
        // Comprehensive data structure for the entire page
        const pageData = {
            header: {
                title: "Tallah/Goldie Case Analysis",
                subtitle: "Interactive Investigation Timeline & Communication Network",
                details: "September 3-18, 2025 | Service Doberman Suspicious Death Investigation"
            },
            navigation: [
                { id: "timeline", label: "Incident Timeline" },
                { id: "network", label: "Communication Network" },
                { id: "escalation", label: "Escalation Analysis" },
                { id: "participants", label: "Key Participants" },
                { id: "documents", label: "Case Documents" }
            ],
            sections: {
                timeline: {
                    title: "Chronological Timeline of Events",
                    description: "Detailed sequence of communications and actions from initial incident through legal escalation",
                    days: [
                        {
                            date: "September 3, 2025 - Initial Incident",
                            events: [
                                {
                                    time: "19:30-20:00 PDT",
                                    title: "Dinner & Medication Administration",
                                    description: "Extended-release Guaifenesin (1200mg) and Dextromethorphan (60mg) administered. Suspicious food drop documented near known intimidation incidents.",
                                    type: "critical",
                                    response: "none",
                                    contacts: ["dumas"],
                                    source: "2025-09-06_Timeline_to_NSG.eml, Page 3"
                                },
                                {
                                    time: "22:30 PDT",
                                    title: "Death Confirmed",
                                    description: "Death confirmed despite immediate CPR intervention. Suspected poisoning/homicide based on rapid deterioration pattern.",
                                    type: "critical",
                                    response: "negative",
                                    contacts: ["dumas"],
                                    source: "2025-09-06_Timeline_to_NSG.eml, Page 3"
                                },
                                {
                                    time: "~23:30 PDT",
                                    title: "Emergency Preservation Initiated",
                                    description: "Emergency calls to UC Davis (530-752-1393) within one hour of death, citing service animal status and suspected foul play. Urgent preservation protocols requested.",
                                    type: "communication",
                                    response: "positive",
                                    contacts: ["dumas", "ucdavis"],
                                    source: "2025-09-06_Timeline_to_NSG.eml, Page 3"
                                }
                            ]
                        },
                        {
                            date: "September 12, 2025 - VMTH Sample Rejection",
                            events: [
                                {
                                    time: "Sep 12, 15:01 PDT",
                                    title: "VMTH Rejection of ViaGen Submission",
                                    description: "VMTH Anatomic Pathology formally rejects ViaGen cloning submission, citing expired 5-day window and alleged 'improper storage,' contradicting documented ice application timeline.",
                                    type: "critical",
                                    response: "negative",
                                    contacts: ["vmth"],
                                    source: "2025-09-12_Viagen_Rejection.eml"
                                }
                            ]
                        },
                        {
                            date: "September 18, 2025 - Final Escalation to Authorities",
                            events: [
                                {
                                    time: "09:47 PDT",
                                    title: "Cremation Deadline Imposed",
                                    description: "Amanda Storms issues cremation deadline for September 26, 2025, despite active legal holds—constituting potential evidence spoliation.",
                                    type: "critical",
                                    response: "negative",
                                    contacts: ["storms"],
                                    source: "2025-09-18_Escalation_to_DA.eml"
                                },
                                {
                                    time: "16:57 PDT",
                                    title: "Multi-Agency Investigation Request",
                                    description: "Formal request submitted to El Dorado County District Attorney and Sheriff's Office requesting criminal investigation into suspected homicide and potential evidence tampering.",
                                    type: "legal",
                                    response: "none",
                                    contacts: ["da", "edso"],
                                    source: "2025-09-18_Escalation_to_DA.eml"
                                }
                            ]
                        }
                    ]
                },
                network: {
                    title: "Communication Network Analysis",
                    description: "Interactive visualization showing communication patterns and institutional relationships throughout the investigation",
                    filters: [
                        { id: "all", label: "All Dates" },
                        { id: "sep3", label: "Sep 3" },
                        { id: "sep4", label: "Sep 4" },
                        { id: "sep6", label: "Sep 6" },
                        { id: "sep8-9", label: "Sep 8-9" },
                        { id: "sep10", label: "Sep 10" },
                        { id: "sep12", label: "Sep 12" },
                        { id: "sep15", label: "Sep 15" },
                        { id: "sep18", label: "Sep 18" }
                    ],
                    nodes: [
                        { id: "dumas", name: "Nicholas Dumas", type: "primary", date: "all", x: 600, y: 400, role: "Case Initiator, Service Dog Owner", details: "Primary point of contact for all communications" },
