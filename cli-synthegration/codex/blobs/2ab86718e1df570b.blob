        // Function to generate navigation
        function generateNavigation() {
            const navContainer = document.getElementById('nav-links');
            let navHTML = '';
            
            pageData.navigation.forEach(item => {
                navHTML += `<a href="#${item.id}" class="nav-link">${item.label}</a>`;
            });
            
            navContainer.innerHTML = navHTML;
        }

        // Function to generate timeline section
        function generateTimeline() {
            const timelineData = pageData.sections.timeline;
            let timelineHTML = `
                <section class="section" id="timeline">
                    <div class="section-header">
                        <div class="section-title">${timelineData.title}</div>
                        <div class="section-description">${timelineData.description}</div>
                    </div>
                    <div class="timeline">
            `;
            
            timelineData.days.forEach(day => {
                timelineHTML += `
                    <div class="day-section">
                        <div class="day-header">${day.date}</div>
                `;
                
                day.events.forEach((event, index) => {
                    const positionClass = index % 2 === 0 ? 'left' : 'right';
                    timelineHTML += `
                        <div class="event ${positionClass} ${event.type}" onclick="showContactDetails('${event.contacts.join(',')}', '${event.title}')">
                            <div class="response-indicator response-${event.response}"></div>
                            <div class="hex-button">
                                <div class="hex-main"></div>
                                <div class="hex-satellites">
                                    <div class="hex-satellite"></div>
                                    <div class="hex-satellite"></div>
                                    <div class="hex-satellite"></div>
                                    <div class="hex-satellite"></div>
                                    <div class="hex-satellite"></div>
                                    <div class="hex-satellite"></div>
                                </div>
                            </div>
                            <div class="event-time">${event.time}</div>
                            <div class="event-title">${event.title}</div>
                            <div class="event-description">${event.description}
                                <div class="source-citation">Source: ${event.source}</div>
                            </div>
                        </div>
                    `;
                });
                
                timelineHTML += `</div>`;
            });
            
            timelineHTML += `</div></section>`;
            return timelineHTML;
        }

        // Function to generate network section
        function generateNetwork() {
            const networkData = pageData.sections.network;
            let networkHTML = `
                <section class="section" id="network">
                    <div class="section-header">
                        <div class="section-title">${networkData.title}</div>
                        <div class="section-description">${networkData.description}</div>
                    </div>
                    <div class="timeline-filter" id="network-filters">
            `;
            
            networkData.filters.forEach(filter => {
                networkHTML += `<button class="filter-btn ${filter.id === 'all' ? 'active' : ''}" data-date="${filter.id}">${filter.label}</button>`;
            });
            
            networkHTML += `
                    </div>
                    <div class="network-container">
                        <svg id="network-graph" viewBox="0 0 1200 800"></svg>
                        <div class="controls">
                            <button class="control-btn" id="zoom-in">Zoom In</button>
                            <button class="control-btn" id="zoom-out">Zoom Out</button>
                            <button class="control-btn" id="reset-view">Reset</button>
                        </div>
                        <div class="legend">
                            <h3>Node Types</h3>
                            <div class="legend-item">
                                <div class="legend-color" style="background: #800020;"></div>
                                <div class="legend-text">Primary Actor (Dumas)</div>
                            </div>
                            <div class="legend-item">
                                <div class="legend-color" style="background: #9B7CB6;"></div>
                                <div class="legend-text">Institutional Contact</div>
                            </div>
                            <div class="legend-item">
                                <div class="legend-color" style="background: #B8D4F1;"></div>
                                <div class="legend-text">Legal/Regulatory Entity</div>
                            </div>
                            <div class="legend-item">
                                <div class="legend-color" style="background: #E8B4A0;"></div>
                                <div class="legend-text">External Service</div>
                            </div>
                        </div>
                        <div class="node-info" id="node-info">
                            <h3 id="node-title">Node Title</h3>
                            <p id="node-role">Role information</p>
                            <p id="node-date">Date of interaction</p>
                            <p id="node-details">Additional details about this node</p>
                        </div>
                    </div>
                </section>
            `;
            
            return networkHTML;
        }

        // Function to generate escalation section
        function generateEscalation() {
            const escalationData = pageData.sections.escalation;
            let escalationHTML = `
                <section class="section" id="escalation">
                    <div class="section-header">
                        <div class="section-title">${escalationData.title}</div>
                        <div class="section-description">${escalationData.description}</div>
                    </div>
                    <div class="escalation-timeline">
                        <div class="escalation-flow">
            `;
            
            escalationData.items.forEach(item => {
                escalationHTML += `
                    <div class="escalation-item ${item.critical ? 'escalation-critical' : ''}">
                        <span class="escalation-date">${item.date}:</span> ${item.text}
                    </div>
                `;
            });
            
            escalationHTML += `</div></div></section>`;
            return escalationHTML;
        }

        // Function to generate participants section
        function generateParticipants() {
            const participantsData = pageData.sections.participants;
            let participantsHTML = `
                <section class="section" id="participants">
                    <div class="section-header">
                        <div class="section-title">${participantsData.title}</div>
                        <div class="section-description">${participantsData.description}</div>
                    </div>
                    <div class="participants-grid">
            `;
            
            participantsData.people.forEach(person => {
                participantsHTML += `
                    <div class="participant-card">
                        <div class="participant-name">${person.name}</div>
                        <div class="participant-role">${person.role}</div>
                        <div class="participant-email">${person.email}</div>
                    </div>
                `;
            });
            
            participantsHTML += `</div></section>`;
            return participantsHTML;
        }

        // Function to generate documents section
        function generateDocuments() {
            const documentsData = pageData.sections.documents;
            let documentsHTML = `
                <section class="section" id="documents">
                    <div class="section-header">
                        <div class="section-title">${documentsData.title}</div>
                        <div class="section-description">${documentsData.description}</div>
                    </div>
                    <div class="documents-list">
            `;
            
            documentsData.files.forEach(file => {
                documentsHTML += `
                    <div class="document-item">
                        <div class="document-name">${file.name}</div>
                        <div class="document-description">${file.description}</div>
                    </div>
                `;
            });
            
            documentsHTML += `</div></section>`;
            return documentsHTML;
        }

        // Function to generate all sections
        function generateAllSections() {
            const mainContainer = document.getElementById('main-content');
            let sectionsHTML = '';
            
            sectionsHTML += generateTimeline();
            sectionsHTML += generateNetwork();
            sectionsHTML += generateEscalation();
            sectionsHTML += generateParticipants();
            sectionsHTML += generateDocuments();
            
            mainContainer.innerHTML = sectionsHTML;
        }

        // Function to show contact details (placeholder)
        function showContactDetails(contactIds, eventTitle) {
            alert(`Contact details for: ${eventTitle}\nContacts: ${contactIds}`);
            // In a real implementation, this would show a modal with detailed contact information
        }

        // Initialize the page
        function initPage() {
            generateNavigation();
            generateAllSections();
            initNetworkVisualization();
            setupEventListeners();
        }

        // Initialize network visualization
        function initNetworkVisualization() {
            const networkData = pageData.sections.network;
            const svg = document.getElementById('network-graph');
            
            // Clear previous content
            svg.innerHTML = '';
            
            // Create links
            networkData.links.forEach(link => {
                const sourceNode = networkData.nodes.find(n => n.id === link.source);
                const targetNode = networkData.nodes.find(n => n.id === link.target);
                
                if (sourceNode && targetNode) {
                    const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
                    line.setAttribute('x1', sourceNode.x);
                    line.setAttribute('y1', sourceNode.y);
                    line.setAttribute('x2', targetNode.x);
                    line.setAttribute('y2', targetNode.y);
                    line.setAttribute('stroke', getLinkColor(link.type));
                    line.setAttribute('stroke-width', link.strength * 4);
                    line.setAttribute('stroke-dasharray', link.type === 'rejection' || link.type === 'hostile' ? '5,5' : '0');
                    line.setAttribute('data-date', link.date);
                    line.setAttribute('class', 'link');
                    svg.appendChild(line);
                }
            });
            
            // Create nodes
            networkData.nodes.forEach(node => {
                const group = document.createElementNS('http://www.w3.org/2000/svg', 'g');
                group.setAttribute('transform', `translate(${node.x}, ${node.y})`);
                group.setAttribute('data-id', node.id);
                group.setAttribute('data-date', node.date);
                group.setAttribute('class', 'node');
                
                const circle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
                circle.setAttribute('r', 20);
                circle.setAttribute('fill', getNodeColor(node.type));
                circle.setAttribute('stroke', '#800020');
                circle.setAttribute('stroke-width', 2);
                circle.setAttribute('class', 'node-circle');
                group.appendChild(circle);
                
                const text = document.createElementNS('http://www.w3.org/2000/svg', 'text');
                text.setAttribute('text-anchor', 'middle');
                text.setAttribute('dy', 5);
                text.setAttribute('fill', node.type === 'primary' ? '#F8F4F0' : '#800020');
                text.setAttribute('font-size', '12px');
                text.setAttribute('font-weight', 'bold');
                text.setAttribute('font-family', 'Amiri');
                text.textContent = node.name.length > 12 ? node.name.substring(0, 10) + '...' : node.name;
                group.appendChild(text);
                
                // Add hover effects
                group.addEventListener('mouseover', function() {
                    circle.setAttribute('r', 25);
                    showNodeInfo(node);
                });
                
                group.addEventListener('mouseout', function() {
                    circle.setAttribute('r', 20);
                    hideNodeInfo();
                });
                
                svg.appendChild(group);
            });
        }

        function getNodeColor(type) {
            switch(type) {
                case 'primary': return '#800020';
                case 'institution': return '#9B7CB6';
                case 'legal': return '#B8D4F1';
                case 'external': return '#E8B4A0';
                default: return '#9B7CB6';
            }
        }
        
        function getLinkColor(type) {
            switch(type) {
                case 'emergency': return '#800020';
                case 'cooperative': return '#9B7CB6';
                case 'followup': return '#B8D4F1';
                case 'referral': return '#E8B4A0';
                case 'inquiry': return '#B8966C';
                case 'engagement': return '#9B7CB6';
                case 'notification': return '#B8D4F1';
                case 'rejection': return '#800020';
                case 'legal': return '#B8D4F1';
                case 'request': return '#E8B4A0';
                case 'escalation': return '#800020';
                case 'hostile': return '#800020';
                default: return '#9B7CB6';
            }
        }
        
        function showNodeInfo(node) {
            const nodeInfo = document.getElementById('node-info');
            document.getElementById('node-title').textContent = node.name;
            document.getElementById('node-role').textContent = node.role;
            document.getElementById('node-date').textContent = `First interaction: ${node.date === 'all' ? 'Multiple dates' : node.date}`;
            document.getElementById('node-details').textContent = node.details;
            nodeInfo.style.display = 'block';
        }
        
        function hideNodeInfo() {
            document.getElementById('node-info').style.display = 'none';
        }

        // Setup event listeners
        function setupEventListeners() {
            // Filter buttons for network visualization
            document.addEventListener('click', function(e) {
                if (e.target.classList.contains('filter-btn')) {
                    document.querySelectorAll('.filter-btn').forEach(btn => btn.classList.remove('active'));
                    e.target.classList.add('active');
                    
                    const date = e.target.getAttribute('data-date');
                    filterNetworkByDate(date);
                }
            });
            
            // Zoom controls for network visualization
            document.getElementById('zoom-in')?.addEventListener('click', function() {
                zoomNetwork(1.2);
            });
            
            document.getElementById('zoom-out')?.addEventListener('click', function() {
                zoomNetwork(0.8);
            });
            
            document.getElementById('reset-view')?.addEventListener('click', function() {
                resetNetworkZoom();
            });
            
            // Smooth scrolling for navigation links
            document.querySelectorAll('.nav-link').forEach(link => {
                link.addEventListener('click', function(e) {
                    e.preventDefault();
                    const targetId = this.getAttribute('href').substring(1);
                    const targetElement = document.getElementById(targetId);
                    if (targetElement) {
                        targetElement.scrollIntoView({
                            behavior: 'smooth',
                            block: 'start'
                        });
                    }
                });
            });
            
            // Enhanced header shimmer effect
            const header = document.getElementById('header');
            header.addEventListener('mousemove', function(e) {
                const rect = header.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;
                
                header.style.background = `radial-gradient(circle at ${x}px ${y}px, rgba(212, 175, 55, 0.1) 0%, transparent 50%)`;
            });
            
            header.addEventListener('mouseleave', function() {
                header.style.background = '';
            });
        }

        // Network filtering function
        function filterNetworkByDate(date) {
            const nodes = document.querySelectorAll('.node');
            const links = document.querySelectorAll('.link');
            
            if (date === 'all') {
                nodes.forEach(node => node.style.display = 'block');
                links.forEach(link => link.style.display = 'block');
            } else {
                nodes.forEach(node => {
                    if (node.getAttribute('data-date') === date || node.getAttribute('data-date') === 'all') {
                        node.style.display = 'block';
                    } else {
                        node.style.display = 'none';
                    }
                });
                
                links.forEach(link => {
                    if (link.getAttribute('data-date') === date) {
                        link.style.display = 'block';
                    } else {
                        link.style.display = 'none';
                    }
                });
            }
        }

        // Network zoom functions
        let networkScale = 1;
        
        function zoomNetwork(factor) {
            networkScale *= factor;
            networkScale = Math.max(0.5, Math.min(networkScale, 3));
            updateNetworkScale();
        }
        
        function resetNetworkZoom() {
            networkScale = 1;
            updateNetworkScale();
        }
        
        function updateNetworkScale() {
            const svg = document.getElementById('network-graph');
            if (svg) {
                svg.style.transform = `scale(${networkScale})`;
                svg.style.transformOrigin = 'center center';
            }
        }

        // Initialize the page when DOM is loaded
        document.addEventListener('DOMContentLoaded', initPage);
    </script>
</body>
</html>
