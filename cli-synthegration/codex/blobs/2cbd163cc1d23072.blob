from omni_client import OmniClient
from omni_client.core.accounts import UserAccount, ExchangeCredentials

# Initialize client
client = OmniClient()

# Register user
user = UserAccount(
    user_id="user_001",
    wallets={
        "solana": Wallet(
            chain="solana",
            address="...",
            private_key_encrypted="..."
        )
    },
    exchanges={
        "binance": ExchangeCredentials(
            api_key="...",
            api_secret="..."
        )
    }
)

client.register_user(user)

# Execute trade
result = await client.spot_order(
    user_id="user_001",
    venue="binance",
    symbol="SOL/USDT",
    side="buy",
    type_="market",
    amount=1.0
)
