import Papa from 'papaparse';

// Use the published CSV URL from Google Sheets as a fallback read-only source
// (optional, can be used if backend is unavailable)
const PUBLISHED_CSV_URL = 'https://docs.google.com/spreadsheets/d/e/YOUR_SHEET_ID/pub?output=csv';

export async function fetchCompoundsFromPublishedCSV() {
  const response = await fetch(PUBLISHED_CSV_URL);
  const csvText = await response.text();
  return new Promise((resolve, reject) => {
    Papa.parse(csvText, {
      header: true,
      skipEmptyLines: true,
      complete: (result) => resolve(result.data),
      error: reject,
    });
  });
}
