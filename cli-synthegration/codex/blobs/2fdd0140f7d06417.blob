// modules/command-handler/command-registry.js
const CommandParser = require('./command-parser');

const commands = new Map();

function register(name, handler, options = {}) {
    commands.set(name.toLowerCase(), { handler, options });
}

function initCommandRegistry() {
    // Example built-in commands
    register('ping', (msg, args) => 'Pong! 🏓', { description: 'Check bot latency' });
    register('hello', (msg, args) => `Hey @${msg.author}! Welcome to the stream 👋`);
    register('socials', (msg, args) => 'Follow us: Twitter/X: @handle | Discord: discord.gg/link');
    register('uptime', (msg, args) => `Stream running for ${process.uptime()} seconds`);
}

async function execute(message) {
    const parser = new CommandParser();
    const parsed = parser.parse(message.text);
    if (!parsed) return null;

    const cmd = commands.get(parsed.command);
    if (!cmd) return `Unknown command: !${parsed.command}`;

    try {
        return await cmd.handler(message, parsed.args);
    } catch (err) {
        console.error(`Command error: ${err}`);
        return '⚠️ An error occurred processing your command.';
    }
}

module.exports = { register, initCommandRegistry, execute };
