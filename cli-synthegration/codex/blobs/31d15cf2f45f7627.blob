# omni_client/providers/pumpfun.py
from typing import Dict, Any, Optional
from ..core.accounts import CustodialAccountStore
from .pumpfun_original import PumpPortalClient  # This is the original client from the early part of the document

class PumpfunClient:
    def __init__(self, accounts: CustodialAccountStore) -> None:
        self.accounts = accounts
        self._user_clients: Dict[str, PumpPortalClient] = {}

    def _get_client(self, user_id: str) -> PumpPortalClient:
        if user_id not in self._user_clients:
            # Get the user's wallet for Solana
            wallet = self.accounts.get_wallet(user_id, "solana")
            # The original PumpPortalClient uses an API key, which we store in the user's exchange credentials for "pumpfun"
            creds = self.accounts.get_exchange_creds(user_id, "pumpfun")
            client = PumpPortalClient(api_key=creds.api_key)
            self._user_clients[user_id] = client
        return self._user_clients[user_id]

    async def lightning_trade(
        self,
        user_id: str,
        action: str,
        mint: str,
        amount: float,
        denominated_in_sol: bool = True,
        **kwargs
    ) -> Dict[str, Any]:
        client = self._get_client(user_id)
        return client.lightning_trade(
            action=action,
            mint=mint,
            amount=amount,
            denominated_in_sol=denominated_in_sol,
            **kwargs
        )

    # ... other methods as needed
