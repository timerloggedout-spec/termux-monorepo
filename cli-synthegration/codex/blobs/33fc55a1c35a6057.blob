// server/routes/compounds.js
const express = require('express');
const router = express.Router();
const { fetchCompounds, batchUpdateCompounds, updateCompound } = require('../services/googleSheets');

router.get('/', async (req, res) => {
  try {
    const data = await fetchCompounds();
    res.json(data);
  } catch (err) {
    res.status(500).json({ error: err.message });
  }
});

router.post('/batch', async (req, res) => {
  try {
    const result = await batchUpdateCompounds(req.body.compounds);
    res.json(result);
  } catch (err) {
    res.status(500).json({ error: err.message });
  }
});

router.patch('/:id', async (req, res) => {
  try {
    const result = await updateCompound(req.params.id, req.body);
    res.json(result);
  } catch (err) {
    res.status(500).json({ error: err.message });
  }
});

module.exports = router;
