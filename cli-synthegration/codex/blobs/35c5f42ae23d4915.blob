<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BioForge — Total Human Optimization Platform</title>
    <style>
        :root {
            --bg-primary: #0a0e14;
            --bg-secondary: #12171f;
            --bg-card: #181f2a;
            --bg-input: #1a2230;
            --border: #1e2a38;
            --border-active: #2a3d54;
            --text-primary: #e2e8f0;
            --text-secondary: #94a3b8;
            --text-muted: #64748b;
            --accent: #00d4aa;
            --accent-glow: #00d4aa40;
            --accent2: #7c5cfc;
            --accent2-glow: #7c5cfc40;
            --danger: #f43f5e;
            --danger-glow: #f43f5e30;
            --warning: #f59e0b;
            --success: #10b981;
            --info: #3b82f6;
            --radius-sm: 6px;
            --radius: 10px;
            --radius-lg: 16px;
            --shadow: 0 4px 24px rgba(0, 0, 0, 0.4);
            --transition: 0.2s cubic-bezier(0.4, 0, 0.2, 1);
            --font-mono: 'SF Mono', 'Cascadia Code', 'Consolas', 'Monaco', monospace;
            --font-sans: 'Inter', 'Segoe UI', system-ui, -apple-system, sans-serif;
            --sidebar-w: 220px;
        }
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        html {
            font-size: 15px;
            scroll-behavior: smooth;
        }
        body {
            font-family: var(--font-sans);
            background: var(--bg-primary);
            color: var(--text-primary);
            display: flex;
            min-height: 100vh;
            line-height: 1.5;
            -webkit-font-smoothing: antialiased;
        }
        ::selection {
            background: var(--accent);
            color: #000;
        }
        ::-webkit-scrollbar {
            width: 5px;
            height: 5px;
        }
        ::-webkit-scrollbar-track {
            background: transparent;
        }
        ::-webkit-scrollbar-thumb {
            background: var(--border-active);
            border-radius: 10px;
        }

        /* ── SIDEBAR ─────────────────────── */
        .sidebar {
            width: var(--sidebar-w);
            background: var(--bg-secondary);
            border-right: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            z-index: 100;
            padding: 1.25rem 0;
            gap: 0.25rem;
            overflow-y: auto;
        }
        .sidebar-logo {
            padding: 0 1.25rem 1.25rem;
            font-size: 1.3rem;
            font-weight: 800;
            letter-spacing: -0.02em;
            color: var(--accent);
            display: flex;
            align-items: center;
            gap: 0.5rem;
            border-bottom: 1px solid var(--border);
            margin-bottom: 0.5rem;
        }
        .sidebar-logo .icon {
            font-size: 1.6rem;
        }
        .nav-item {
            display: flex;
            align-items: center;
            gap: 0.7rem;
            padding: 0.65rem 1.25rem;
            cursor: pointer;
            color: var(--text-secondary);
            transition: var(--transition);
            border-left: 3px solid transparent;
            font-weight: 500;
            font-size: 0.9rem;
            user-select: none;
            white-space: nowrap;
        }
        .nav-item:hover {
            color: var(--text-primary);
            background: rgba(255, 255, 255, 0.02);
        }
        .nav-item.active {
            color: var(--accent);
            border-left-color: var(--accent);
            background: rgba(0, 212, 170, 0.05);
        }
        .nav-item .nav-icon {
            font-size: 1.2rem;
            width: 1.5rem;
            text-align: center;
            flex-shrink: 0;
        }
        .nav-section {
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--text-muted);
            padding: 1rem 1.25rem 0.35rem;
            font-weight: 700;
        }

        /* ── MAIN ────────────────────────── */
        .main {
            margin-left: var(--sidebar-w);
            flex: 1;
            padding: 1.75rem 2rem;
            max-width: 1100px;
            width: 100%;
        }
        .page {
            display: none;
        }
        .page.active {
            display: block;
            animation: fadeSlideIn 0.3s ease;
        }
        @keyframes fadeSlideIn {
            from {
                opacity: 0;
                transform: translateY(8px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* ── TYPOGRAPHY ──────────────────── */
        h1 {
            font-size: 1.7rem;
            font-weight: 700;
            letter-spacing: -0.02em;
            margin-bottom: 0.25rem;
        }
        h2 {
            font-size: 1.25rem;
            font-weight: 600;
            margin-bottom: 1rem;
            color: var(--text-primary);
        }
        h3 {
            font-size: 1rem;
            font-weight: 600;
            color: var(--text-secondary);
            margin-bottom: 0.5rem;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }
        .page-subtitle {
            color: var(--text-muted);
            margin-bottom: 1.5rem;
            font-size: 0.9rem;
        }
        .highlight {
            color: var(--accent);
            font-weight: 700;
        }
        .accent2 {
            color: var(--accent2);
        }

        /* ── CARDS ───────────────────────── */
        .card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            padding: 1.25rem 1.5rem;
            box-shadow: var(--shadow);
            transition: var(--transition);
        }
        .card:hover {
            border-color: var(--border-active);
        }
        .card-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
            gap: 1rem;
            margin-bottom: 1.5rem;
        }
        .stat-card {
            text-align: center;
            padding: 1.25rem 1rem;
        }
        .stat-value {
            font-size: 2.2rem;
            font-weight: 800;
            letter-spacing: -0.03em;
            color: var(--accent);
            font-family: var(--font-mono);
        }
        .stat-label {
            font-size: 0.8rem;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-top: 0.25rem;
        }
        .stat-sub {
            font-size: 0.75rem;
            color: var(--text-secondary);
            margin-top: 0.15rem;
        }

        /* ── FORMS ───────────────────────── */
        .form-row {
            display: flex;
            gap: 0.75rem;
            flex-wrap: wrap;
            margin-bottom: 0.75rem;
        }
        .form-group {
            display: flex;
            flex-direction: column;
            gap: 0.3rem;
            flex: 1;
            min-width: 120px;
        }
        .form-group label {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--text-muted);
            font-weight: 600;
        }
        input,
        select,
        textarea {
            background: var(--bg-input);
            border: 1px solid var(--border);
            color: var(--text-primary);
            padding: 0.6rem 0.75rem;
            border-radius: var(--radius-sm);
            font-family: var(--font-sans);
            font-size: 0.9rem;
            transition: var(--transition);
            outline: none;
            width: 100%;
        }
        input:focus,
        select:focus,
        textarea:focus {
            border-color: var(--accent);
            box-shadow: 0 0 0 3px var(--accent-glow);
        }
        textarea {
            resize: vertical;
            min-height: 60px;
        }
        .btn {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            padding: 0.6rem 1.2rem;
            border-radius: var(--radius-sm);
            font-weight: 600;
            font-size: 0.85rem;
            cursor: pointer;
            border: none;
            transition: var(--transition);
            font-family: var(--font-sans);
            letter-spacing: 0.01em;
            white-space: nowrap;
        }
        .btn-primary {
            background: var(--accent);
            color: #000;
            box-shadow: 0 0 20px var(--accent-glow);
        }
        .btn-primary:hover {
            box-shadow: 0 0 30px var(--accent-glow);
            transform: translateY(-1px);
        }
        .btn-secondary {
            background: transparent;
            border: 1px solid var(--border-active);
            color: var(--text-primary);
        }
        .btn-secondary:hover {
            border-color: var(--accent);
            color: var(--accent);
        }
        .btn-danger {
            background: transparent;
            border: 1px solid var(--danger);
            color: var(--danger);
        }
        .btn-danger:hover {
            background: var(--danger-glow);
        }
        .btn-sm {
            padding: 0.35rem 0.7rem;
            font-size: 0.75rem;
        }
        .btn-xs {
            padding: 0.2rem 0.5rem;
            font-size: 0.7rem;
            border-radius: 4px;
        }

        /* ── TABLES / LISTS ──────────────── */
        .data-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.85rem;
        }
        .data-table th {
            text-align: left;
            color: var(--text-muted);
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            padding: 0.6rem 0.5rem;
            border-bottom: 1px solid var(--border);
            font-weight: 700;
        }
        .data-table td {
            padding: 0.55rem 0.5rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.03);
            vertical-align: middle;
        }
        .data-table tr:hover td {
            background: rgba(255, 255, 255, 0.015);
        }
        .badge {
            display: inline-block;
            padding: 0.2rem 0.55rem;
            border-radius: 20px;
            font-size: 0.7rem;
            font-weight: 700;
            letter-spacing: 0.03em;
            text-transform: uppercase;
        }
        .badge-peptide {
            background: #7c5cfc20;
            color: #a78bfa;
            border: 1px solid #7c5cfc40;
        }
        .badge-hormone {
            background: #f59e0b20;
            color: #fbbf24;
            border: 1px solid #f59e0b40;
        }
        .badge-ped {
            background: #f43f5e20;
            color: #fb7185;
            border: 1px solid #f43f5e40;
        }
        .badge-nootropic {
            background: #3b82f620;
            color: #60a5fa;
            border: 1px solid #3b82f640;
        }
        .badge-genetherapy {
            background: #10b98120;
            color: #34d399;
            border: 1px solid #10b98140;
        }
        .empty-state {
            text-align: center;
            padding: 3rem 1rem;
            color: var(--text-muted);
        }
        .empty-state .icon {
            font-size: 3rem;
            display: block;
            margin-bottom: 0.75rem;
            opacity: 0.5;
        }

        /* ── CHARTS ──────────────────────── */
        .chart-container {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            padding: 1.25rem;
            box-shadow: var(--shadow);
        }
        canvas {
            width: 100%;
            height: 220px;
            display: block;
        }

        /* ── TOASTS ──────────────────────── */
        .toast-container {
            position: fixed;
            bottom: 1.5rem;
            right: 1.5rem;
            z-index: 9999;
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }
        .toast {
            background: var(--bg-card);
            border: 1px solid var(--accent);
            color: var(--text-primary);
            padding: 0.75rem 1.25rem;
            border-radius: var(--radius);
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.6);
            animation: slideInRight 0.3s ease;
            font-size: 0.85rem;
            font-weight: 500;
        }
        @keyframes slideInRight {
            from {
                opacity: 0;
                transform: translateX(60px);
            }
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        /* ── RESPONSIVE ──────────────────── */
        @media (max-width: 768px) {
            .sidebar {
                width: 60px;
                padding: 0.75rem 0;
            }
            .sidebar-logo {
                padding: 0 0.5rem 0.75rem;
                font-size: 0;
                justify-content: center;
            }
            .sidebar-logo .icon {
                font-size: 1.5rem;
            }
            .nav-item {
                padding: 0.6rem 0.5rem;
                justify-content: center;
                font-size: 0;
                gap: 0;
            }
            .nav-item .nav-icon {
                font-size: 1.3rem;
            }
            .nav-section {
                display: none;
            }
            .main {
                margin-left: 60px;
                padding: 1rem;
            }
            h1 {
                font-size: 1.3rem;
            }
            .card-grid {
                grid-template-columns: 1fr 1fr;
                gap: 0.5rem;
            }
            .stat-value {
                font-size: 1.5rem;
            }
            .form-row {
                flex-direction: column;
            }
            .data-table {
                font-size: 0.7rem;
            }
            .data-table th,
            .data-table td {
                padding: 0.35rem 0.3rem;
            }
        }
    </style>
</head>
<body>

    <!-- ═══════════════ SIDEBAR ═══════════════ -->
    <nav class="sidebar" id="sidebar">
        <div class="sidebar-logo"><span class="icon">🧬</span>BioForge</div>
        <div class="nav-section">Core</div>
        <div class="nav-item active" data-page="dashboard"><span class="nav-icon">📊</span> Dashboard</div>
        <div class="nav-item" data-page="nutrition"><span class="nav-icon">🍎</span> Nutrition</div>
        <div class="nav-item" data-page="workouts"><span class="nav-icon">🏋️</span> Workouts</div>
        <div class="nav-item" data-page="sleep"><span class="nav-icon">🌙</span> Sleep</div>
        <div class="nav-item" data-page="metrics"><span class="nav-icon">📏</span> Body Metrics</div>
        <div class="nav-section">Advanced</div>
        <div class="nav-item" data-page="therapeutics"><span class="nav-icon">💉</span> Therapeutics</div>
        <div class="nav-item" data-page="analytics"><span class="nav-icon">📈</span> Analytics</div>
        <div class="nav-section">System</div>
        <div class="nav-item" data-page="settings"><span class="nav-icon">⚙️</span> Settings</div>
    </nav>

    <!-- ═══════════════ MAIN CONTENT ═══════════════ -->
    <main class="main" id="main-content">

        <!-- ── DASHBOARD ────────────────────── -->
        <section class="page active" id="page-dashboard">
            <h1>Dashboard</h1>
            <p class="page-subtitle">Real-time overview · <span id="dash-date">—</span></p>
            <div class="card-grid" id="dash-stats"></div>
            <div class="card" style="margin-top:0.5rem;">
                <h3>⚡ Quick Log</h3>
                <div class="form-row">
                    <div class="form-group"><label>Quick Calories</label><input type="number" id="quick-cals" placeholder="e.g. 450"></div>
                    <div class="form-group"><label>Protein (g)</label><input type="number" id="quick-protein" placeholder="e.g. 35"></div>
                    <div class="form-group"><label>Weight (lbs)</label><input type="number" id="quick-weight" placeholder="e.g. 185" step="0.1"></div>
                    <div class="form-group" style="justify-content:flex-end;"><label>&nbsp;</label><button class="btn btn-primary" onclick="quickLog()">⚡ Log All</button></div>
                </div>
            </div>
            <div class="card" style="margin-top:1rem;" id="dash-recent">
                <h3>🕐 Recent Therapeutic Doses</h3>
                <div id="dash-recent-doses" class="empty-state"><span class="icon">💉</span>No doses logged yet</div>
            </div>
        </section>

        <!-- ── NUTRITION ────────────────────── -->
        <section class="page" id="page-nutrition">
            <h1>🍎 Nutrition</h1>
            <p class="page-subtitle">Log meals · Track macros · <span id="nutrition-total-day">0 kcal today</span></p>
            <div class="card" style="margin-bottom:1rem;">
                <h3>Log Food</h3>
                <div class="form-row">
                    <div class="form-group"><label>Food / Meal</label><input type="text" id="food-name" placeholder="e.g. Chicken & Rice"></div>
                    <div class="form-group"><label>Calories</label><input type="number" id="food-cals" placeholder="kcal"></div>
                    <div class="form-group"><label>Protein (g)</label><input type="number" id="food-protein" placeholder="g"></div>
                    <div class="form-group"><label>Carbs (g)</label><input type="number" id="food-carbs" placeholder="g"></div>
                    <div class="form-group"><label>Fats (g)</label><input type="number" id="food-fats" placeholder="g"></div>
                    <div class="form-group" style="justify-content:flex-end;"><label>&nbsp;</label><button class="btn btn-primary" onclick="logFood()">+ Log</button></div>
                </div>
            </div>
            <div class="card">
                <h3>Today's Log</h3>
                <table class="data-table"><thead><tr><th>Time</th><th>Food</th><th>Cal</th><th>P</th><th>C</th><th>F</th><th></th></tr></thead><tbody id="food-table-body"><tr><td colspan="7" class="empty-state">No entries today</td></tr></tbody></table>
            </div>
        </section>

        <!-- ── WORKOUTS ─────────────────────── -->
        <section class="page" id="page-workouts">
            <h1>🏋️ Workouts</h1>
            <p class="page-subtitle">Log sets · Track progress</p>
            <div class="card" style="margin-bottom:1rem;">
                <h3>Log Set</h3>
                <div class="form-row">
                    <div class="form-group"><label>Exercise</label><input type="text" id="wo-exercise" placeholder="e.g. Bench Press"></div>
                    <div class="form-group"><label>Weight (lbs)</label><input type="number" id="wo-weight" placeholder="lbs"></div>
                    <div class="form-group"><label>Reps</label><input type="number" id="wo-reps" placeholder="reps"></div>
                    <div class="form-group"><label>Sets</label><input type="number" id="wo-sets" placeholder="sets" value="1"></div>
                    <div class="form-group"><label>RPE (1-10)</label><input type="number" id="wo-rpe" placeholder="RPE" min="1" max="10"></div>
                    <div class="form-group" style="justify-content:flex-end;"><label>&nbsp;</label><button class="btn btn-primary" onclick="logWorkout()">+ Log</button></div>
                </div>
            </div>
            <div class="card">
                <h3>Recent Workouts</h3>
                <table class="data-table"><thead><tr><th>Date</th><th>Exercise</th><th>Weight</th><th>Reps</th><th>Sets</th><th>RPE</th><th>Volume</th><th></th></tr></thead><tbody id="wo-table-body"><tr><td colspan="8" class="empty-state">No workouts logged</td></tr></tbody></table>
            </div>
        </section>

        <!-- ── SLEEP ────────────────────────── -->
        <section class="page" id="page-sleep">
            <h1>🌙 Sleep</h1>
            <p class="page-subtitle">Track duration & quality</p>
            <div class="card" style="margin-bottom:1rem;">
                <h3>Log Sleep</h3>
                <div class="form-row">
                    <div class="form-group"><label>Bed Time</label><input type="datetime-local" id="sleep-start"></div>
                    <div class="form-group"><label>Wake Time</label><input type="datetime-local" id="sleep-end"></div>
                    <div class="form-group"><label>Quality (1-5)</label><select id="sleep-quality"><option value="3">3 — Okay</option><option value="4">4 — Good</option><option value="5">5 — Excellent</option><option value="2">2 — Poor</option><option value="1">1 — Terrible</option></select></div>
                    <div class="form-group"><label>Deep Sleep (hrs)</label><input type="number" id="sleep-deep" placeholder="est." step="0.1"></div>
                    <div class="form-group"><label>HRV (ms)</label><input type="number" id="sleep-hrv" placeholder="optional"></div>
                    <div class="form-group" style="justify-content:flex-end;"><label>&nbsp;</label><button class="btn btn-primary" onclick="logSleep()">+ Log</button></div>
                </div>
            </div>
            <div class="card">
                <h3>Sleep History</h3>
                <table class="data-table"><thead><tr><th>Night</th><th>Duration</th><th>Quality</th><th>Deep Sleep</th><th>HRV</th><th></th></tr></thead><tbody id="sleep-table-body"><tr><td colspan="6" class="empty-state">No sleep data</td></tr></tbody></table>
            </div>
        </section>

        <!-- ── BODY METRICS ──────────────────── -->
        <section class="page" id="page-metrics">
            <h1>📏 Body Metrics</h1>
            <p class="page-subtitle">Weight · BF% · Measurements</p>
            <div class="card" style="margin-bottom:1rem;">
                <h3>Log Measurement</h3>
                <div class="form-row">
                    <div class="form-group"><label>Weight (lbs)</label><input type="number" id="metric-weight" placeholder="lbs" step="0.1"></div>
                    <div class="form-group"><label>Body Fat %</label><input type="number" id="metric-bf" placeholder="%" step="0.1"></div>
                    <div class="form-group"><label>Waist (in)</label><input type="number" id="metric-waist" placeholder="inches" step="0.1"></div>
                    <div class="form-group"><label>Chest (in)</label><input type="number" id="metric-chest" placeholder="inches" step="0.1"></div>
                    <div class="form-group"><label>Arms (in)</label><input type="number" id="metric-arms" placeholder="inches" step="0.1"></div>
                    <div class="form-group" style="justify-content:flex-end;"><label>&nbsp;</label><button class="btn btn-primary" onclick="logMetric()">+ Log</button></div>
                </div>
            </div>
            <div class="card">
                <h3>History</h3>
                <table class="data-table"><thead><tr><th>Date</th><th>Weight</th><th>BF%</th><th>Waist</th><th>Chest</th><th>Arms</th><th></th></tr></thead><tbody id="metric-table-body"><tr><td colspan="7" class="empty-state">No measurements</td></tr></tbody></table>
            </div>
        </section>

        <!-- ── THERAPEUTICS ──────────────────── -->
        <section class="page" id="page-therapeutics">
            <h1>💉 Advanced Therapeutics</h1>
            <p class="page-subtitle">Peptides · Hormones · PEDs · Gene Therapy · Nootropics</p>
            <div class="card" style="margin-bottom:1rem;">
                <h3>Log Dose</h3>
                <div class="form-row">
                    <div class="form-group"><label>Compound</label><input type="text" id="ther-compound" placeholder="e.g. BPC-157, Testosterone, NAD+"></div>
                    <div class="form-group"><label>Category</label><select id="ther-category"><option value="peptide">Peptide</option><option value="hormone">Hormone</option><option value="ped">PED / SARM</option><option value="nootropic">Nootropic</option><option value="genetherapy">Gene Therapy</option><option value="other">Other</option></select></div>
                    <div class="form-group"><label>Dosage</label><input type="text" id="ther-dosage" placeholder="e.g. 250mcg, 100mg"></div>
                    <div class="form-group"><label>Route</label><select id="ther-route"><option value="subq">Subcutaneous</option><option value="im">Intramuscular</option><option value="oral">Oral</option><option value="iv">IV</option><option value="topical">Topical</option><option value="other">Other</option></select></div>
                    <div class="form-group"><label>Frequency</label><input type="text" id="ther-frequency" placeholder="e.g. Daily, EOD, 2x/week"></div>
                </div>
                <div class="form-row">
                    <div class="form-group"><label>Cycle / Protocol</label><input type="text" id="ther-cycle" placeholder="e.g. 8-week cycle, Ongoing"></div>
                    <div class="form-group"><label>Site</label><input type="text" id="ther-site" placeholder="e.g. Left delt, abdomen"></div>
                    <div class="form-group"><label>Notes</label><input type="text" id="ther-notes" placeholder="Any observations..."></div>
                    <div class="form-group" style="justify-content:flex-end;"><label>&nbsp;</label><button class="btn btn-primary" onclick="logTherapeutic()">💉 Log Dose</button></div>
                </div>
            </div>
            <div class="card">
                <h3>Dose History</h3>
                <table class="data-table"><thead><tr><th>Date</th><th>Compound</th><th>Category</th><th>Dosage</th><th>Route</th><th>Frequency</th><th>Cycle</th><th></th></tr></thead><tbody id="ther-table-body"><tr><td colspan="8" class="empty-state">No therapeutic doses logged</td></tr></tbody></table>
            </div>
        </section>

        <!-- ── ANALYTICS ─────────────────────── -->
        <section class="page" id="page-analytics">
            <h1>📈 Analytics</h1>
            <p class="page-subtitle">Trends & correlations</p>
            <div class="chart-container" style="margin-bottom:1rem;">
                <h3>Weight Trend (7 days)</h3><canvas id="chart-weight"></canvas>
            </div>
            <div class="chart-container" style="margin-bottom:1rem;">
                <h3>Calorie Intake (7 days)</h3><canvas id="chart-calories"></canvas>
            </div>
            <div class="card">
                <h3>📋 Summary Stats</h3>
                <div id="analytics-summary" class="empty-state"><span class="icon">📊</span>Collect more data to see trends</div>
            </div>
        </section>

        <!-- ── SETTINGS ──────────────────────── -->
        <section class="page" id="page-settings">
            <h1>⚙️ Settings</h1>
            <p class="page-subtitle">Data management & preferences</p>
            <div class="card" style="margin-bottom:1rem;">
                <h3>Export Data</h3>
                <p style="color:var(--text-muted);margin-bottom:0.75rem;">Download all your data as a JSON file for backup or analysis.</p>
                <button class="btn btn-secondary" onclick="exportData()">📥 Export All Data (JSON)</button>
            </div>
            <div class="card" style="margin-bottom:1rem;border-color:var(--danger);">
                <h3 style="color:var(--danger);">Danger Zone</h3>
                <p style="color:var(--text-muted);margin-bottom:0.75rem;">Permanently delete all stored data. This cannot be undone.</p>
                <button class="btn btn-danger" onclick="clearAllData()">🗑️ Clear All Data</button>
            </div>
            <div class="card">
                <h3>About BioForge</h3>
                <p style="color:var(--text-muted);">Version 1.0 · Fully client-side · No server · No tracking · Your data stays on your device. Built for the quantified self revolution. 🧬💪</p>
            </div>
        </section>
    </main>

    <!-- ═══════════════ TOAST CONTAINER ═══════════════ -->
    <div class="toast-container" id="toast-container"></div>

    <script>
        // ╔══════════════════════════════════════════════════════════╗
        // ║  BioForge — Total Human Optimization Platform          ║
        // ║  Modular · Client-Side · Serverless · FOSS Spirit      ║
        // ╚══════════════════════════════════════════════════════════╝

        // ── DataStore Module ──────────────────
        const DataStore = (() => {
            const PREFIX = 'bioforge_';
            const get = (key) => {
                try { const v = localStorage.getItem(PREFIX + key); return v ? JSON.parse(v) : null; } catch (
                e) { return null; }
            };
            const set = (key, val) => { localStorage.setItem(PREFIX + key, JSON.stringify(val)); };
            const remove = (key) => { localStorage.removeItem(PREFIX + key); };
            const getAll = () => {
                const data = {};
                for (let i = 0; i < localStorage.length; i++) {
                    const k = localStorage.key(i);
                    if (k.startsWith(PREFIX)) data[k.replace(PREFIX, '')] = JSON.parse(localStorage.getItem(k));
                }
                return data;
            };
            const clearAll = () => {
                const keys = [];
                for (let i = 0; i < localStorage.length; i++) { const k = localStorage.key(i); if (k.startsWith(
                        PREFIX)) keys.push(k); }
                keys.forEach(k => localStorage.removeItem(k));
            };
            // Collections
            const getCollection = (name) => get(name) || [];
            const addToCollection = (name, item) => {
                const col = getCollection(name);
                item.id = Date.now().toString(36) + Math.random().toString(36).slice(2, 7);
                item.createdAt = new Date().toISOString();
                col.unshift(item);
                if (col.length > 500) col.length = 500;
                set(name, col);
                return item;
            };
            const updateCollection = (name, id, updates) => {
                const col = getCollection(name);
                const idx = col.findIndex(i => i.id === id);
                if (idx >= 0) { col[idx] = { ...col[idx], ...updates, updatedAt: new Date().toISOString() };
                    set(name, col); return true; }
                return false;
            };
            const deleteFromCollection = (name, id) => {
                const col = getCollection(name);
                const filtered = col.filter(i => i.id !== id);
                if (filtered.length !== col.length) { set(name, filtered); return true; }
                return false;
            };
            return { get, set, remove, getAll, clearAll, getCollection, addToCollection, updateCollection,
                deleteFromCollection };
        })();

        // ── Toast Module ─────────────────────
        const Toast = (() => {
            const container = document.getElementById('toast-container');
            const show = (msg, duration = 2500) => {
                const el = document.createElement('div');
                el.className = 'toast';
                el.textContent = msg;
                container.appendChild(el);
                setTimeout(() => { el.style.opacity = '0';
                    el.style.transition = 'opacity 0.3s';
                    setTimeout(() => el.remove(), 300); }, duration);
            };
            return { show };
        })();

        // ── Helpers ──────────────────────────
        const todayStr = () => new Date().toISOString().split('T')[0];
        const formatDate = (iso) => {
            const d = new Date(iso);
            return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
        };
        const formatTime = (iso) => {
            const d = new Date(iso);
            return d.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' });
        };
        const formatDateTime = (iso) => {
            return formatDate(iso) + ' ' + formatTime(iso);
        };
        const daysAgo = (n) => {
            const d = new Date();
            d.setDate(d.getDate() - n);
            return d.toISOString().split('T')[0];
        };

        // ── Navigation ───────────────────────
        const navItems = document.querySelectorAll('.nav-item');
        const pages = document.querySelectorAll('.page');
        navItems.forEach(item => {
            item.addEventListener('click', () => {
                const pageName = item.dataset.page;
                navItems.forEach(n => n.classList.remove('active'));
                item.classList.add('active');
                pages.forEach(p => p.classList.remove('active'));
                const target = document.getElementById('page-' + pageName);
                if (target) target.classList.add('active');
                if (pageName === 'dashboard') renderDashboard();
                if (pageName === 'nutrition') renderNutrition();
                if (pageName === 'workouts') renderWorkouts();
                if (pageName === 'sleep') renderSleep();
                if (pageName === 'metrics') renderMetrics();
                if (pageName === 'therapeutics') renderTherapeutics();
                if (pageName === 'analytics') renderAnalytics();
                if (pageName === 'settings') renderSettings();
            });
        });

        // ── Quick Log ────────────────────────
        function quickLog() {
            const cals = document.getElementById('quick-cals').value;
            const protein = document.getElementById('quick-protein').value;
            const weight = document.getElementById('quick-weight').value;
            let logged = 0;
            if (cals || protein) {
                DataStore.addToCollection('nutrition', {
                    food: 'Quick Log',
                    calories: parseFloat(cals) || 0,
                    protein: parseFloat(protein) || 0,
                    carbs: 0,
                    fats: 0,
                    date: todayStr()
                });
                logged++;
                document.getElementById('quick-cals').value = '';
                document.getElementById('quick-protein').value = '';
            }
            if (weight) {
                DataStore.addToCollection('metrics', {
                    weight: parseFloat(weight),
                    bf: null,
                    waist: null,
                    chest: null,
                    arms: null,
                    date: todayStr()
                });
                logged++;
                document.getElementById('quick-weight').value = '';
            }
            if (logged > 0) {
                Toast.show('✅ Quick-logged ' + logged + ' item(s)');
                renderDashboard();
            } else {
                Toast.show('⚠️ Enter at least one value');
            }
        }
        document.getElementById('quick-cals').addEventListener('keydown', e => { if (e.key === 'Enter') quickLog(); });
        document.getElementById('quick-protein').addEventListener('keydown', e => { if (e.key === 'Enter') quickLog(); });
        document.getElementById('quick-weight').addEventListener('keydown', e => { if (e.key === 'Enter') quickLog(); });

        // ── Dashboard Render ─────────────────
        function renderDashboard() {
            document.getElementById('dash-date').textContent = new Date().toLocaleDateString('en-US', {
                weekday: 'long',
                year: 'numeric',
                month: 'long',
                day: 'numeric'
            });
            const today = todayStr();
            const nutrition = DataStore.getCollection('nutrition').filter(n => n.date === today);
            const totalCals = nutrition.reduce((s, n) => s + (n.calories || 0), 0);
            const totalProtein = nutrition.reduce((s, n) => s + (n.protein || 0), 0);
            const workouts = DataStore.getCollection('workouts').filter(w => w.date === today);
            const sleepData = DataStore.getCollection('sleep');
            const lastSleep = sleepData[0] || null;
            const metrics = DataStore.getCollection('metrics');
            const lastWeight = metrics[0]?.weight || '—';
            const therapeutics = DataStore.getCollection('therapeutics');
            const todayDoses = therapeutics.filter(t => t.date === today);

            const statsHTML = [
                { value: totalCals, label: 'Calories Today', sub: totalProtein + 'g protein',
                icon: '🔥' },
                { value: workouts.length, label: 'Workouts Today', sub: workouts.reduce((s, w) => s + (w.sets || 1),
                        0) + ' sets logged', icon: '🏋️' },
                { value: lastSleep ? lastSleep.durationHours?.toFixed(1) + 'h' : '—', label: 'Last Sleep',
                    sub: lastSleep ? 'Quality: ' + lastSleep.quality + '/5' : 'No data', icon: '🌙' },
                { value: lastWeight + ' lbs', label: 'Latest Weight', sub: metrics[0]?.bf ? metrics[0].bf +
                        '% BF' : '—', icon: '⚖️' },
                { value: todayDoses.length, label: 'Doses Today', sub: todayDoses.map(d => d.compound).join(', ') ||
                        'None', icon: '💉' },
                { value: therapeutics.length, label: 'Total Compounds', sub: [...new Set(therapeutics.map(t => t
                        .compound))].length + ' unique', icon: '🧪' },
            ].map(s => `
            <div class="card stat-card">
              <div style="font-size:1.5rem;margin-bottom:0.3rem;">${s.icon}</div>
              <div class="stat-value">${s.value}</div>
              <div class="stat-label">${s.label}</div>
              <div class="stat-sub">${s.sub}</div>
            </div>`).join('');
            document.getElementById('dash-stats').innerHTML = statsHTML;

            // Recent doses
            const recentDoses = therapeutics.slice(0, 5);
            const dosesHTML = recentDoses.length > 0 ?
                '<table class="data-table"><thead><tr><th>Date</th><th>Compound</th><th>Dosage</th><th>Route</th><th>Category</th></tr></thead><tbody>' +
                recentDoses.map(d => `
              <tr>
                <td>${formatDateTime(d.createdAt)}</td>
                <td><strong>${d.compound}</strong></td>
                <td>${d.dosage}</td>
                <td>${d.route}</td>
                <td><span class="badge badge-${d.category}">${d.category}</span></td>
              </tr>`).join('') + '</tbody></table>' :
                '<div class="empty-state"><span class="icon">💉</span>No doses logged yet</div>';
            document.getElementById('dash-recent-doses').innerHTML = dosesHTML;
        }

        // ── Nutrition ────────────────────────
        function logFood() {
            const name = document.getElementById('food-name').value.trim();
            const cals = parseFloat(document.getElementById('food-cals').value);
            if (!name || isNaN(cals)) { Toast.show('⚠️ Enter food name and calories'); return; }
            DataStore.addToCollection('nutrition', {
                food: name,
                calories: cals,
                protein: parseFloat(document.getElementById('food-protein').value) || 0,
                carbs: parseFloat(document.getElementById('food-carbs').value) || 0,
                fats: parseFloat(document.getElementById('food-fats').value) || 0,
                date: todayStr()
            });
            ['food-name', 'food-cals', 'food-protein', 'food-carbs', 'food-fats'].forEach(id => document.getElementById(
                id).value = '');
            Toast.show('🍎 Food logged!');
            renderNutrition();
            renderDashboard();
        }

        function renderNutrition() {
            const today = todayStr();
            const entries = DataStore.getCollection('nutrition').filter(n => n.date === today);
            const totalCals = entries.reduce((s, n) => s + n.calories, 0);
            document.getElementById('nutrition-total-day').textContent = totalCals + ' kcal today · ' + entries.length +
                ' entries';
            const tbody = document.getElementById('food-table-body');
            if (entries.length === 0) {
                tbody.innerHTML = '<tr><td colspan="7" class="empty-state">No entries today</td></tr>';
            } else {
                tbody.innerHTML = entries.map(f => `
              <tr>
                <td>${formatTime(f.createdAt)}</td>
                <td>${f.food}</td>
                <td>${f.calories}</td>
                <td>${f.protein}g</td>
                <td>${f.carbs}g</td>
                <td>${f.fats}g</td>
                <td><button class="btn btn-xs btn-danger" onclick="deleteEntry('nutrition','${f.id}');renderNutrition();renderDashboard();">✕</button></td>
              </tr>`).join('');
            }
            document.getElementById('food-name').addEventListener('keydown', e => { if (e.key === 'Enter') logFood(); });
        }

        // ── Workouts ─────────────────────────
        function logWorkout() {
            const exercise = document.getElementById('wo-exercise').value.trim();
            const weight = parseFloat(document.getElementById('wo-weight').value);
            if (!exercise || isNaN(weight)) { Toast.show('⚠️ Enter exercise and weight'); return; }
            const reps = parseInt(document.getElementById('wo-reps').value) || 0;
            const sets = parseInt(document.getElementById('wo-sets').value) || 1;
            DataStore.addToCollection('workouts', {
                exercise,
                weight,
                reps,
                sets,
                rpe: parseInt(document.getElementById('wo-rpe').value) || null,
                volume: weight * reps * sets,
                date: todayStr()
            });
            ['wo-exercise', 'wo-weight', 'wo-reps', 'wo-sets', 'wo-rpe'].forEach(id => document.getElementById(id)
            .value = '');
            document.getElementById('wo-sets').value = '1';
            Toast.show('🏋️ Set logged!');
            renderWorkouts();
            renderDashboard();
        }

        function renderWorkouts() {
            const entries = DataStore.getCollection('workouts').slice(0, 50);
            const tbody = document.getElementById('wo-table-body');
            if (entries.length === 0) {
                tbody.innerHTML = '<tr><td colspan="8" class="empty-state">No workouts logged</td></tr>';
            } else {
                tbody.innerHTML = entries.map(w => `
              <tr>
                <td>${formatDate(w.createdAt)}</td>
                <td><strong>${w.exercise}</strong></td>
                <td>${w.weight} lbs</td>
                <td>${w.reps}</td>
                <td>${w.sets}</td>
                <td>${w.rpe || '—'}</td>
                <td>${w.volume?.toLocaleString() || '—'} lbs</td>
                <td><button class="btn btn-xs btn-danger" onclick="deleteEntry('workouts','${w.id}');renderWorkouts();renderDashboard();">✕</button></td>
              </tr>`).join('');
            }
            document.getElementById('wo-exercise').addEventListener('keydown', e => { if (e.key === 'Enter') logWorkout
            (); });
        }

        // ── Sleep ────────────────────────────
        function logSleep() {
            const start = document.getElementById('sleep-start').value;
            const end = document.getElementById('sleep-end').value;
            if (!start || !end) { Toast.show('⚠️ Enter both bed and wake times'); return; }
            const startD = new Date(start);
            const endD = new Date(end);
            if (endD <= startD) { Toast.show('⚠️ Wake time must be after bed time'); return; }
            const durationHours = (endD - startD) / (1000 * 60 * 60);
            DataStore.addToCollection('sleep', {
                start,
                end,
                durationHours: Math.round(durationHours * 10) / 10,
                quality: parseInt(document.getElementById('sleep-quality').value),
                deepSleep: parseFloat(document.getElementById('sleep-deep').value) || null,
                hrv: parseFloat(document.getElementById('sleep-hrv').value) || null,
                date: startD.toISOString().split('T')[0]
            });
            ['sleep-start', 'sleep-end', 'sleep-deep', 'sleep-hrv'].forEach(id => document.getElementById(id).value =
                '');
            document.getElementById('sleep-quality').value = '3';
            Toast.show('🌙 Sleep logged!');
            renderSleep();
            renderDashboard();
        }

        function renderSleep() {
            const entries = DataStore.getCollection('sleep').slice(0, 50);
            const tbody = document.getElementById('sleep-table-body');
            if (entries.length === 0) {
                tbody.innerHTML = '<tr><td colspan="6" class="empty-state">No sleep data</td></tr>';
            } else {
                tbody.innerHTML = entries.map(s => `
              <tr>
                <td>${formatDate(s.date)}</td>
                <td><strong>${s.durationHours?.toFixed(1)}h</strong></td>
                <td>${'⭐'.repeat(s.quality)}</td>
                <td>${s.deepSleep ? s.deepSleep + 'h' : '—'}</td>
                <td>${s.hrv ? s.hrv + 'ms' : '—'}</td>
                <td><button class="btn btn-xs btn-danger" onclick="deleteEntry('sleep','${s.id}');renderSleep();renderDashboard();">✕</button></td>
              </tr>`).join('');
            }
        }

        // ── Body Metrics ─────────────────────
        function logMetric() {
            const weight = parseFloat(document.getElementById('metric-weight').value);
            if (isNaN(weight)) { Toast.show('⚠️ Enter at least weight'); return; }
            DataStore.addToCollection('metrics', {
                weight,
                bf: parseFloat(document.getElementById('metric-bf').value) || null,
                waist: parseFloat(document.getElementById('metric-waist').value) || null,
                chest: parseFloat(document.getElementById('metric-chest').value) || null,
                arms: parseFloat(document.getElementById('metric-arms').value) || null,
                date: todayStr()
            });
            ['metric-weight', 'metric-bf', 'metric-waist', 'metric-chest', 'metric-arms'].forEach(id => document
                .getElementById(id).value = '');
            Toast.show('📏 Metrics logged!');
            renderMetrics();
            renderDashboard();
        }

        function renderMetrics() {
            const entries = DataStore.getCollection('metrics').slice(0, 50);
            const tbody = document.getElementById('metric-table-body');
            if (entries.length === 0) {
                tbody.innerHTML = '<tr><td colspan="7" class="empty-state">No measurements</td></tr>';
            } else {
                tbody.innerHTML = entries.map(m => `
              <tr>
                <td>${formatDate(m.date || m.createdAt)}</td>
                <td><strong>${m.weight} lbs</strong></td>
                <td>${m.bf ?? '—'}%</td>
                <td>${m.waist ?? '—'}"</td>
                <td>${m.chest ?? '—'}"</td>
                <td>${m.arms ?? '—'}"</td>
                <td><button class="btn btn-xs btn-danger" onclick="deleteEntry('metrics','${m.id}');renderMetrics();renderDashboard();">✕</button></td>
              </tr>`).join('');
            }
        }

        // ── Therapeutics ─────────────────────
        function logTherapeutic() {
            const compound = document.getElementById('ther-compound').value.trim();
            const dosage = document.getElementById('ther-dosage').value.trim();
            if (!compound || !dosage) { Toast.show('⚠️ Enter compound and dosage'); return; }
            DataStore.addToCollection('therapeutics', {
                compound,
                category: document.getElementById('ther-category').value,
                dosage,
                route: document.getElementById('ther-route').value,
                frequency: document.getElementById('ther-frequency').value.trim() || 'Once',
                cycle: document.getElementById('ther-cycle').value.trim() || '—',
                site: document.getElementById('ther-site').value.trim() || '—',
                notes: document.getElementById('ther-notes').value.trim() || '',
                date: todayStr()
            });
            ['ther-compound', 'ther-dosage', 'ther-frequency', 'ther-cycle', 'ther-site', 'ther-notes'].forEach(id =>
                document.getElementById(id).value = '');
            Toast.show('💉 Dose logged!');
            renderTherapeutics();
            renderDashboard();
        }

        function renderTherapeutics() {
            const entries = DataStore.getCollection('therapeutics').slice(0, 100);
            const tbody = document.getElementById('ther-table-body');
            if (entries.length === 0) {
                tbody.innerHTML = '<tr><td colspan="8" class="empty-state">No therapeutic doses logged</td></tr>';
            } else {
                tbody.innerHTML = entries.map(t => `
              <tr>
                <td>${formatDateTime(t.createdAt)}</td>
                <td><strong>${t.compound}</strong></td>
                <td><span class="badge badge-${t.category}">${t.category}</span></td>
                <td>${t.dosage}</td>
                <td>${t.route}</td>
                <td>${t.frequency}</td>
                <td>${t.cycle}</td>
                <td><button class="btn btn-xs btn-danger" onclick="deleteEntry('therapeutics','${t.id}');renderTherapeutics();renderDashboard();">✕</button></td>
              </tr>`).join('');
            }
            document.getElementById('ther-compound').addEventListener('keydown', e => { if (e.key === 'Enter')
                logTherapeutic(); });
        }

        // ── Analytics ────────────────────────
        function renderAnalytics() {
            drawWeightChart();
            drawCalorieChart();
            const metrics = DataStore.getCollection('metrics');
            const nutrition = DataStore.getCollection('nutrition');
            const therapeutics = DataStore.getCollection('therapeutics');
            const workouts = DataStore.getCollection('workouts');
            const sleepData = DataStore.getCollection('sleep');
            const summaryHTML = `
            <div class="card-grid" style="margin-top:0.5rem;">
              <div class="card stat-card"><div class="stat-value">${metrics.length}</div><div class="stat-label">Body Metrics Entries</div></div>
              <div class="card stat-card"><div class="stat-value">${nutrition.length}</div><div class="stat-label">Food Entries</div></div>
              <div class="card stat-card"><div class="stat-value">${workouts.length}</div><div class="stat-label">Workout Sets</div></div>
              <div class="card stat-card"><div class="stat-value">${therapeutics.length}</div><div class="stat-label">Therapeutic Doses</div></div>
              <div class="card stat-card"><div class="stat-value">${sleepData.length}</div><div class="stat-label">Sleep Records</div></div>
              <div class="card stat-card"><div class="stat-value">${[...new Set(therapeutics.map(t=>t.compound))].length}</div><div class="stat-label">Unique Compounds</div></div>
            </div>`;
            document.getElementById('analytics-summary').innerHTML = summaryHTML;
        }

        function drawWeightChart() {
            const canvas = document.getElementById('chart-weight');
            const ctx = canvas.getContext('2d');
            const metrics = DataStore.getCollection('metrics').slice(0, 7).reverse();
            canvas.width = canvas.parentElement.clientWidth - 40;
            canvas.height = 220;
            if (metrics.length < 2) {
                ctx.fillStyle = '#64748b';
                ctx.font = '14px sans-serif';
                ctx.textAlign = 'center';
                ctx.fillText('Need at least 2 data points for a chart', canvas.width / 2, canvas.height / 2);
                return;
            }
            const weights = metrics.map(m => m.weight);
            const maxW = Math.max(...weights) + 5;
            const minW = Math.min(...weights) - 5;
            const range = maxW - minW || 1;
            const stepX = canvas.width / (metrics.length - 1 || 1);
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            // Grid lines
            ctx.strokeStyle = '#1e2a38';
            ctx.lineWidth = 1;
            for (let i = 0; i <= 4; i++) {
                const y = 20 + (canvas.height - 40) * (i / 4);
                ctx.beginPath();
                ctx.moveTo(0, y);
                ctx.lineTo(canvas.width, y);
                ctx.stroke();
                ctx.fillStyle = '#64748b';
                ctx.font = '10px monospace';
                ctx.fillText((maxW - (range * i / 4)).toFixed(1), 4, y - 4);
            }
            // Line
            ctx.beginPath();
            ctx.strokeStyle = '#00d4aa';
            ctx.lineWidth = 2.5;
            ctx.shadowColor = '#00d4aa60';
            ctx.shadowBlur = 8;
            metrics.forEach((m, i) => {
                const x = i * stepX;
                const y = 20 + (canvas.height - 40) * (1 - (m.weight - minW) / range);
                if (i === 0) ctx.moveTo(x, y);
                else ctx.lineTo(x, y);
            });
            ctx.stroke();
            ctx.shadowBlur = 0;
            // Dots
            metrics.forEach((m, i) => {
                const x = i * stepX;
                const y = 20 + (canvas.height - 40) * (1 - (m.weight - minW) / range);
                ctx.beginPath();
                ctx.arc(x, y, 5, 0, Math.PI * 2);
                ctx.fillStyle = '#00d4aa';
                ctx.fill();
                ctx.fillStyle = '#e2e8f0';
                ctx.font = '11px monospace';
                ctx.textAlign = 'center';
                ctx.fillText(m.weight + '', x, y - 12);
            });
        }

        function drawCalorieChart() {
            const canvas = document.getElementById('chart-calories');
            const ctx = canvas.getContext('2d');
            canvas.width = canvas.parentElement.clientWidth - 40;
            canvas.height = 220;
            const last7 = [];
            for (let i = 6; i >= 0; i--) {
                const d = daysAgo(i);
                const cals = DataStore.getCollection('nutrition').filter(n => n.date === d).reduce((s, n) => s + n
                    .calories, 0);
                last7.push({ date: d, calories: cals });
            }
            if (last7.every(d => d.calories === 0)) {
                ctx.fillStyle = '#64748b';
                ctx.font = '14px sans-serif';
                ctx.textAlign = 'center';
                ctx.fillText('No calorie data for the last 7 days', canvas.width / 2, canvas.height / 2);
                return;
            }
            const maxC = Math.max(...last7.map(d => d.calories), 500);
            const stepX = canvas.width / 6;
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            ctx.strokeStyle = '#1e2a38';
            ctx.lineWidth = 1;
            for (let i = 0; i <= 4; i++) {
                const y = 20 + (canvas.height - 40) * (i / 4);
                ctx.beginPath();
                ctx.moveTo(0, y);
                ctx.lineTo(canvas.width, y);
                ctx.stroke();
                ctx.fillStyle = '#64748b';
                ctx.font = '10px monospace';
                ctx.fillText(Math.round(maxC * (1 - i / 4)) + '', 4, y - 4);
            }
            // Bars
            const barW = stepX * 0.55;
            last7.forEach((d, i) => {
                const x = i * stepX - barW / 2;
                const barH = Math.max(2, (d.calories / maxC) * (canvas.height - 40));
                const y = 20 + (canvas.height - 40) - barH;
                const grad = ctx.createLinearGradient(x, y, x, y + barH);
                grad.addColorStop(0, '#7c5cfc');
                grad.addColorStop(1, '#7c5cfc30');
                ctx.fillStyle = grad;
                ctx.beginPath();
                ctx.roundRect(x, y, barW, barH, [4, 4, 0, 0]);
                ctx.fill();
                ctx.fillStyle = '#e2e8f0';
                ctx.font = '10px monospace';
                ctx.textAlign = 'center';
                ctx.fillText(d.calories, x + barW / 2, y - 6);
                ctx.fillText(d.date.slice(5), x + barW / 2, canvas.height - 4);
            });
        }

        // ── Generic Delete ───────────────────
        function deleteEntry(collection, id) {
            if (DataStore.deleteFromCollection(collection, id)) {
                Toast.show('🗑️ Entry deleted');
            }
        }

        // ── Settings ─────────────────────────
        function renderSettings() { /* static */ }

        function exportData() {
            const data = DataStore.getAll();
            const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = 'bioforge-export-' + todayStr() + '.json';
            a.click();
            URL.revokeObjectURL(url);
            Toast.show('📥 Data exported!');
        }

        function clearAllData() {
            if (confirm('⚠️ This will permanently delete ALL your data. Are you absolutely sure?')) {
                if (confirm('Final confirmation: Delete everything?')) {
                    DataStore.clearAll();
                    Toast.show('🗑️ All data cleared');
                    renderDashboard();
                    renderNutrition();
                    renderWorkouts();
                    renderSleep();
                    renderMetrics();
                    renderTherapeutics();
                    renderAnalytics();
                }
            }
        }

        // ── Set default datetime-local values ──
        function setDefaultSleepTimes() {
            const now = new Date();
            const bedTime = new Date(now);
            bedTime.setHours(22, 0, 0, 0);
            if (now.getHours() < 12) bedTime.setDate(bedTime.getDate() - 1);
            const wakeTime = new Date(bedTime);
            wakeTime.setDate(wakeTime.getDate() + 1);
            wakeTime.setHours(6, 30, 0, 0);
            document.getElementById('sleep-start').value = bedTime.toISOString().slice(0, 16);
            document.getElementById('sleep-end').value = wakeTime.toISOString().slice(0, 16);
        }

        // ── Init ─────────────────────────────
        function init() {
            setDefaultSleepTimes();
            renderDashboard();
            // Pre-fill today's date context
            console.log('%c🧬 BioForge v1.0 %cReady — All data stored locally in your browser.',
                'color:#00d4aa;font-size:1.2em;', 'color:#94a3b8;');
            console.log('%cModular · Serverless · Client-Side · FOSS Spirit', 'color:#7c5cfc;');
        }
        init();

        // ── Handle window resize for charts ──
        let resizeTimeout;
        window.addEventListener('resize', () => {
            clearTimeout(resizeTimeout);
            resizeTimeout = setTimeout(() => {
                if (document.getElementById('page-analytics').classList.contains('active')) renderAnalytics();
            }, 250);
        });

        // ── Keyboard shortcuts ───────────────
        document.addEventListener('keydown', (e) => {
            if (e.ctrlKey || e.metaKey) {
                switch (e.key.toLowerCase()) {
                    case '1':
                        e.preventDefault();
                        document.querySelector('[data-page="dashboard"]').click();
                        break;
                    case '2':
                        e.preventDefault();
                        document.querySelector('[data-page="nutrition"]').click();
                        break;
                    case '3':
                        e.preventDefault();
                        document.querySelector('[data-page="workouts"]').click();
                        break;
                    case '4':
                        e.preventDefault();
                        document.querySelector('[data-page="sleep"]').click();
                        break;
                    case '5':
                        e.preventDefault();
                        document.querySelector('[data-page="metrics"]').click();
                        break;
                    case '6':
                        e.preventDefault();
                        document.querySelector('[data-page="therapeutics"]').click();
                        break;
                    case '7':
                        e.preventDefault();
                        document.querySelector('[data-page="analytics"]').click();
                        break;
                }
            }
        });
    </script>
</body>
</html>
