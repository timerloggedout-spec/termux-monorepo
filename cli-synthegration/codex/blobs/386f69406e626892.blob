social-dashboard/
├── package.json
├── .env.example
├── server.js                    # Main entry point
├── config/
│   ├── index.js                 # Environment configuration
│   └── database.js              # MongoDB/Redis connection
├── modules/
│   ├── auth/
│   │   ├── passport-setup.js    # Passport strategies (YouTube, Instagram)
│   │   ├── auth-routes.js       # OAuth callback endpoints
│   │   └── token-manager.js     # Encrypted token storage & refresh logic
│   ├── api-clients/
│   │   ├── youtube-client.js    # YouTube Data & Live Streaming API wrapper
│   │   └── instagram-client.js  # Instagram Graph API wrapper
│   ├── filter-engine/
│   │   ├── filter-rules.js      # Configurable blacklist/whitelist
│   │   └── spam-detector.js     # Rate-limiting & duplicate detection
│   ├── command-handler/
│   │   ├── command-parser.js    # Extracts !command or /command triggers
│   │   └── command-registry.js  # Map of commands → handler functions
│   └── response-dispatcher/
│       ├── youtube-responder.js # Posts replies to YT comments/chat
│       └── instagram-responder.js # Posts replies to IG comments
├── models/
│   ├── User.js
│   └── MessageLog.js
├── middleware/
│   ├── auth.js                  # Session/JWT verification
│   └── rate-limiter.js
└── frontend/
    └── (React/Vue dashboard)
