{children.length > 0 && (
  <div className="mb-4 p-3 bg-[#0f1724] border border-[#1e3a5f] rounded-lg">
    <div className="text-xs text-gray-400 mb-2">Contains (auto‑selected for comparison):</div>
    <div className="flex flex-wrap gap-2">
      {children.map(childId => {
        const child = compounds.find(c => c.Entity_ID === childId);
        return child ? <Badge key={childId} color="#4ade80">{child.Canonical_Name}</Badge> : null;
      })}
    </div>
  </div>
)}
