        // =============================================
        // ARBITRAGE ALGORITHMS
        // =============================================
        function buildArbitrageGraph() {
            state.arbitrageGraph.nodes.clear();
            state.arbitrageGraph.edges = [];
            
            // Add all currencies as nodes
            Object.values(state.exchanges).forEach(exchange => {
                exchange.pairs.forEach(pair => {
                    if (!state.arbitrageGraph.nodes.has(pair.base)) {
                        state.arbitrageGraph.nodes.set(pair.base, {
                            symbol: pair.base,
                            exchanges: new Set(),
                            isStablecoin: state.stablecoins.has(pair.base)
                        });
                    }
                    state.arbitrageGraph.nodes.get(pair.base).exchanges.add(exchange.name);
                    
                    if (!state.arbitrageGraph.nodes.has(pair.target)) {
                        state.arbitrageGraph.nodes.set(pair.target, {
                            symbol: pair.target,
                            exchanges: new Set(),
                            isStablecoin: state.stablecoins.has(pair.target)
                        });
                    }
                    state.arbitrageGraph.nodes.get(pair.target).exchanges.add(exchange.name);
                    
                    // Add edges in both directions
                    if (pair.price > 0) {
                        // Forward edge: base -> target
                        state.arbitrageGraph.edges.push({
                            from: pair.base,
                            to: pair.target,
                            rate: pair.price,
                            fee: state.config.tradingFee,
                            exchange: exchange.name,
                            volume: pair.volume,
                            liquidity: pair.liquidity || pair.volume
                        });
                        
                        // Reverse edge: target -> base
                        state.arbitrageGraph.edges.push({
                            from: pair.target,
                            to: pair.base,
                            rate: 1 / pair.price,
                            fee: state.config.tradingFee,
                            exchange: exchange.name,
                            volume: pair.volume,
                            liquidity: pair.liquidity || pair.volume
                        });
                    }
                });
            });
            
            log(`Built arbitrage graph: ${state.arbitrageGraph.nodes.size} nodes, ${state.arbitrageGraph.edges.length} edges`, 'info', 'GRAPH');
        }

        function scanTriangularArbitrage(pairs, exchangeName, investment = state.config.investmentAmount) {
            const opportunities = [];
            const minProfit = state.config.minProfitPercent;
            const maxPairs = Math.min(pairs.length, 50);
            
            log(`Starting triangular scan on ${exchangeName} with ${maxPairs} pairs`, 'debug', 'TRIANGULAR');
            
            for (let i = 0; i < maxPairs; i++) {
                const coin1 = pairs[i];
                if (!coin1 || coin1.price <= 0) continue;
                
                for (let j = i + 1; j < maxPairs; j++) {
                    const coin2 = pairs[j];
                    if (!coin2 || coin2.price <= 0) continue;
                    
                    for (let k = j + 1; k < maxPairs; k++) {
                        const coin3 = pairs[k];
                        if (!coin3 || coin3.price <= 0) continue;
                        
                        // Check if we should filter by portfolio
                        if (state.portfolio.enabled && state.portfolio.currencies.size > 0) {
                            if (!state.portfolio.currencies.has(coin1.base) && 
                                !state.portfolio.currencies.has(coin2.base) && 
                                !state.portfolio.currencies.has(coin3.base)) {
                                continue;
                            }
                        }
                        
                        // Calculate triangular arbitrage with fees
                        let amount = investment;
                        
                        // Trade 1: Base -> Coin1
                        amount = applyTradingFee(amount / coin1.price);
                        
                        // Trade 2: Coin1 -> Coin2  
                        // Find exchange rate between coin1 and coin2
                        const rate1to2 = findExchangeRate(coin1.base, coin2.base, exchangeName);
                        if (!rate1to2) continue;
                        amount = applyTradingFee(amount * rate1to2);
                        
                        // Trade 3: Coin2 -> Coin3
                        const rate2to3 = findExchangeRate(coin2.base, coin3.base, exchangeName);
                        if (!rate2to3) continue;
                        amount = applyTradingFee(amount * rate2to3);
                        
                        // Trade 4: Coin3 -> Base (back to original)
                        const rate3toBase = findExchangeRate(coin3.base, coin1.base, exchangeName);
                        if (!rate3toBase) continue;
                        amount = applyTradingFee(amount * rate3toBase);
                        
                        const profit = amount - investment;
                        const profitPercent = (profit / investment) * 100;
                        
                        if (profitPercent >= minProfit) {
                            opportunities.push({
                                exchange: exchangeName,
                                path: `${coin1.base} → ${coin2.base} → ${coin3.base} → ${coin1.base}`,
                                profitPercent: profitPercent,
                                profit: profit,
                                investment: investment,
                                finalAmount: amount,
                                type: 'triangular',
                                pathLength: 3,
                                timestamp: Date.now()
                            });
                        }
                    }
                }
            }
            
            state.stats.triangularScans++;
            return opportunities;
        }

        function findExchangeRate(fromCurrency, toCurrency, exchangeName) {
            const exchange = state.exchanges[exchangeName.toLowerCase().replace(' ', '')];
            if (!exchange) return null;
            
            // Look for direct pair
            for (const pair of exchange.pairs) {
                if (pair.base === fromCurrency && pair.target === toCurrency) {
                    return pair.price;
                }
                if (pair.base === toCurrency && pair.target === fromCurrency) {
                    return 1 / pair.price;
                }
            }
            
            return null;
        }

        function runBellmanFordScan() {
            if (!state.systemReady || state.isScanning) {
                log('System not ready or already scanning', 'warning', 'BELLMAN-FORD');
                return [];
            }
            
            state.isScanning = true;
            log('Starting Bellman-Ford arbitrage detection...', 'info', 'BELLMAN-FORD');
            
            buildArbitrageGraph();
            const opportunities = [];
            const investment = state.config.investmentAmount;
            const minProfit = state.config.minProfitPercent;
            
            // Run Bellman-Ford from each node
            state.arbitrageGraph.nodes.forEach((node, startCurrency) => {
                // Skip if portfolio filtering is enabled and currency not in portfolio
                if (state.portfolio.enabled && state.portfolio.currencies.size > 0) {
                    if (!state.portfolio.currencies.has(startCurrency)) return;
                }
                
                // Skip stablecoins if not included
                if (!state.portfolio.includeStablecoins && node.isStablecoin) return;
                
                const distances = new Map();
                const predecessors = new Map();
                
                // Initialize distances
                state.arbitrageGraph.nodes.forEach((_, currency) => {
                    distances.set(currency, currency === startCurrency ? 0 : Infinity);
                    predecessors.set(currency, null);
                });
                
                // Relax edges |V| - 1 times
                for (let i = 0; i < state.arbitrageGraph.nodes.size - 1; i++) {
                    let updated = false;
                    
                    for (const edge of state.arbitrageGraph.edges) {
                        const u = edge.from;
                        const v = edge.to;
                        const weight = -Math.log(edge.rate * (1 - edge.fee)); // Negative log for arbitrage detection
                        
                        if (distances.get(u) + weight < distances.get(v)) {
                            distances.set(v, distances.get(u) + weight);
                            predecessors.set(v, { node: u, edge: edge });
                            updated = true;
                        }
                    }
                    
                    if (!updated) break;
                }
                
                // Check for negative cycles (arbitrage opportunities)
                for (const edge of state.arbitrageGraph.edges) {
                    const u = edge.from;
                    const v = edge.to;
                    const weight = -Math.log(edge.rate * (1 - edge.fee));
                    
                    if (distances.get(u) + weight < distances.get(v)) {
                        // Negative cycle found - reconstruct path
                        const cycle = reconstructCycle(u, v, predecessors);
                        if (cycle && cycle.length >= 2 && cycle.length <= state.config.maxPathLength) {
                            const opportunity = calculateCycleProfit(cycle, investment);
                            if (opportunity && opportunity.profitPercent >= minProfit) {
                                opportunities.push(opportunity);
                                
                                // Store Bellman-Ford path for display
                                state.bellmanPaths.push({
                                    path: cycle,
                                    profitPercent: opportunity.profitPercent,
                                    exchange: opportunity.exchange
                                });
                            }
                        }
                    }
                }
            });
            
            state.stats.bellmanScans++;
            state.isScanning = false;
            
            log(`Bellman-Ford completed: ${opportunities.length} opportunities found`, 'success', 'BELLMAN-FORD');
            
            // Update Bellman-Ford paths display
            updateBellmanPathsDisplay();
            
            return opportunities;
        }

        function reconstructCycle(u, v, predecessors) {
            const cycle = [v, u];
            let current = predecessors.get(u);
            const visited = new Set([u, v]);
            
            while (current && !visited.has(current.node)) {
                cycle.unshift(current.node);
                visited.add(current.node);
                current = predecessors.get(current.node);
                
                if (cycle.length > state.config.maxPathLength + 2) break; // Prevent infinite loops
            }
            
            return cycle.length >= 3 ? cycle : null;
        }

        function calculateCycleProfit(cycle, investment) {
            try {
                let amount = investment;
                const pathDescription = [];
                
                for (let i = 0; i < cycle.length - 1; i++) {
                    const from = cycle[i];
                    const to = cycle[i + 1];
                    
                    // Find the edge between from and to
                    const edge = state.arbitrageGraph.edges.find(e => 
                        e.from === from && e.to === to
                    );
                    
                    if (!edge) {
                        log(`Missing edge from ${from} to ${to}`, 'warning', 'PROFIT-CALC');
                        return null;
                    }
                    
                    amount = applyTradingFee(amount * edge.rate, edge.fee);
                    pathDescription.push(`${from}→${to}(${edge.exchange})`);
                }
                
                // Close the cycle
                const from = cycle[cycle.length - 1];
                const to = cycle[0];
                const edge = state.arbitrageGraph.edges.find(e => 
                    e.from === from && e.to === to
                );
                
                if (!edge) {
                    log(`Missing closing edge from ${from} to ${to}`, 'warning', 'PROFIT-CALC');
                    return null;
                }
                
                amount = applyTradingFee(amount * edge.rate, edge.fee);
                pathDescription.push(`${from}→${to}(${edge.exchange})`);
                
                const profit = amount - investment;
                const profitPercent = (profit / investment) * 100;
                
                if (profitPercent >= state.config.minProfitPercent) {
                    return {
                        exchange: 'Multi-Exchange',
                        path: pathDescription.join(' → '),
                        profitPercent: profitPercent,
                        profit: profit,
                        investment: investment,
                        finalAmount: amount,
                        type: 'bellman-ford',
                        pathLength: cycle.length,
                        timestamp: Date.now()
                    };
                }
            } catch (error) {
                log(`Error calculating cycle profit: ${error.message}`, 'error', 'PROFIT-CALC');
            }
            
            return null;
        }

        function updateBellmanPathsDisplay() {
            const container = document.getElementById('bellmanPaths');
            container.innerHTML = '';
            
            if (state.bellmanPaths.length === 0) {
                container.innerHTML = '<div style="text-align: center; padding: 20px; color: #6666ff;">No Bellman-Ford paths found</div>';
                return;
            }
            
            state.bellmanPaths.forEach((pathObj, index) => {
                const pathDiv = document.createElement('div');
                pathDiv.className = 'bellman-path';
                
                let pathHTML = `<div style="margin-bottom: 6px;"><strong>Path ${index + 1}</strong> - Profit: <span style="color: #00ff00">${pathObj.profitPercent.toFixed(4)}%</span></div>`;
                pathHTML += '<div>';
                
                pathObj.path.forEach((node, i) => {
                    pathHTML += `<span class="path-segment">${node}</span>`;
                    if (i < pathObj.path.length - 1) {
                        pathHTML += '<span class="path-arrow">→</span>';
                    }
                });
                
                pathHTML += '</div>';
                pathDiv.innerHTML = pathHTML;
                container.appendChild(pathDiv);
            });
        }

        function scanLowValueArbitrage(pairs, exchangeName) {
            log(`💎 Scanning ${exchangeName} for low-value opportunities...`, 'scan');
            const opportunities = [];
            const lowValuePairs = pairs.filter(p => p.lowValue).slice(0, 30);
            
            // Simple momentum-based strategy for low-value coins
            lowValuePairs.forEach(pair => {
                if (pair.volume > 10000) { // Minimum volume threshold
                    const volatilityScore = Math.abs(pair.change24h) / 10;
                    const volumeScore = Math.min(pair.volume / 1000000, 1);
                    const potentialProfit = volatilityScore * volumeScore * 5; // 0-5% estimated profit
                    
                    if (potentialProfit > state.config.minProfitPercent) {
                        opportunities.push({
                            exchange: exchangeName,
                            path: `${pair.base} momentum play`,
                            profitPercent: potentialProfit,
                            profit: (state.config.investmentAmount * potentialProfit) / 100,
                            investment: state.config.investmentAmount,
                            finalAmount: state.config.investmentAmount * (1 + potentialProfit / 100),
                            type: 'low-value',
                            algorithm: 'LowValueFocus',
                            coinPrice: pair.price
                        });
                    }
                }
            });
            
            log(`💎 ${exchangeName} low-value: ${opportunities.length} opportunities`, opportunities.length > 0 ? 'arbitrage' : 'info');
            return opportunities;
        }

        function runAdvancedArbitrageScan() {
            if (!state.systemReady || state.isScanning) {
                log('System not ready or already scanning', 'warning', 'SCAN');
                return;
            }
            
            state.isScanning = true;
            log('========== ADVANCED ARBITRAGE SCAN START ==========', 'info', 'SCAN');
            state.stats.scanCount++;
            updateStatus('🔄 Advanced arbitrage scan running...');
            
            const opportunities = [];
            let scansPerformed = 0;
            
            // Run selected algorithms
            const algorithm = document.getElementById('algorithm').value;
            
            // Run triangular arbitrage on each exchange
            if (algorithm === 'triangular' || algorithm === 'all') {
                Object.values(state.exchanges).forEach(exchange => {
                    if (exchange.status === 'online' && exchange.pairs.length > 2) {
                        log(`Scanning ${exchange.name} for triangular arbitrage...`, 'info', 'SCAN');
                        const opps = scanTriangularArbitrage(exchange.pairs, exchange.name);
                        opportunities.push(...opps);
                        scansPerformed++;
                        log(`${exchange.name}: ${opps.length} triangular opportunities`, 
                             opps.length > 0 ? 'success' : 'warning', 'SCAN');
                    }
                });
            }
            
            // Run Bellman-Ford for cross-exchange opportunities
            if (algorithm === 'bellman-ford' || algorithm === 'all') {
                log('Running Bellman-Ford for cross-exchange opportunities...', 'info', 'SCAN');
                const bfOpps = runBellmanFordScan();
                opportunities.push(...bfOpps);
            }
            
            // Run low-value arbitrage
            if (algorithm === 'low-value' || algorithm === 'all') {
                Object.values(state.exchanges).forEach(exchange => {
                    if (exchange.status === 'online') {
                        log(`Scanning ${exchange.name} for low-value opportunities...`, 'info', 'SCAN');
                        const opps = scanLowValueArbitrage(exchange.pairs, exchange.name);
                        opportunities.push(...opps);
                        log(`${exchange.name}: ${opps.length} low-value opportunities`, 
                             opps.length > 0 ? 'success' : 'warning', 'SCAN');
                    }
                });
            }
            
            // Sort by profit percentage
            opportunities.sort((a, b) => b.profitPercent - a.profitPercent);
            
            // Update best profit
            if (opportunities.length > 0 && opportunities[0].profitPercent > state.stats.bestProfit) {
                state.stats.bestProfit = opportunities[0].profitPercent;
            }
            
            state.stats.oppCount = opportunities.length;
            updateStats();
            updateLowestCoin();
            
            displayOpportunities(opportunities);
            
            state.isScanning = false;
            updateStatus(`✅ Scan complete: ${opportunities.length} opportunities across ${scansPerformed} exchanges + cross-exchange`);
            log(`========== SCAN COMPLETE: ${opportunities.length} OPPORTUNITIES ==========`, 'success', 'SCAN');
        }

        function displayOpportunities(opportunities) {
            const container = document.getElementById('opportunities');
            
            if (opportunities.length === 0) {
                container.innerHTML = '<div class="card">No profitable arbitrage opportunities found. Try adjusting parameters or wait for market conditions to change.</div>';
                return;
            }
            
            container.innerHTML = '';
            
            opportunities.slice(0, 25).forEach(opp => {
                const oppClass = opp.profitPercent > 5 ? 'opportunity high-profit' : 
                               opp.profitPercent > 0 ? 'opportunity' : 'opportunity negative';
                
                // Add specific class for Bellman-Ford opportunities
                const typeClass = opp.type === 'bellman-ford' ? 'bellman-ford' : '';
                
                container.innerHTML += 
                    `<div class="${oppClass} ${typeClass}">
                        <div style="display: flex; justify-content: space-between; margin-bottom: 4px;">
                            <strong>${opp.exchange}</strong>
                            <strong style="color: ${opp.profitPercent > 0 ? '#00ff00' : '#ff4444'}">
                                +${opp.profitPercent.toFixed(4)}%
                            </strong>
                        </div>
                        <div class="path-visual">${opp.path}</div>
                        <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 6px; font-size: 10px; margin-top: 4px;">
                            <div>Investment: $${opp.investment.toFixed(2)}</div>
                            <div>Profit: $${opp.profit.toFixed(4)}</div>
                            <div>Final: $${opp.finalAmount.toFixed(4)}</div>
                        </div>
                        <div style="font-size: 9px; color: #6666ff; margin-top: 2px;">
                            Type: ${opp.type} | Path: ${opp.pathLength} | ${new Date(opp.timestamp).toLocaleTimeString()}
                        </div>
                    </div>`;
            });
        }

        // =============================================
        // INITIALIZATION & EVENT HANDLERS
        // =============================================
        async function initSystem() {
            log('========== SYSTEM INITIALIZATION ==========', 'info', 'INIT');
            updateStatus('Connecting to exchanges...');
            
            // Update config from UI
            updateConfigFromUI();
            
            const results = await Promise.allSettled([
                loadCoinGecko(),
                loadDEXScreener(),
                loadCryptoCompare()
            ]);
            
            const successCount = results.filter(r => r.status === 'fulfilled' && r.value).length;
            
            // Calculate total pairs
            state.stats.totalPairs = Object.values(state.exchanges)
                .reduce((sum, exchange) => sum + exchange.pairs.length, 0);
            
            updateExchangeStatus();
            updateStats();
            updateLowestCoin();
            
            if (successCount > 0) {
                state.systemReady = true;
                document.getElementById('scanBtn').disabled = false;
                document.getElementById('bellmanBtn').disabled = false;
                
                // Build initial graph
                buildArbitrageGraph();
                
                updateStatus(`✅ System ready - ${successCount}/3 exchanges - ${state.stats.totalPairs} pairs - ${state.arbitrageGraph.nodes.size} currencies`);
                log('========== INITIALIZATION COMPLETE ==========', 'success', 'INIT');
                
                // Start auto features if enabled
                if (state.config.autoRefresh) {
                    startAutoRefresh();
                }
                if (state.config.autoScan) {
                    startAutoScan();
                }
            } else {
                updateStatus('❌ Initialization failed - No exchanges available');
                log('========== INITIALIZATION FAILED ==========', 'error', 'INIT');
            }
        }

        function updateConfigFromUI() {
            state.config.investmentAmount = parseFloat(document.getElementById('investmentAmount').value) || 100;
            state.config.minProfitPercent = parseFloat(document.getElementById('minProfitPercent').value) || 0.5;
            state.config.tradingFee = parseFloat(document.getElementById('tradingFee').value) / 100 || 0.002;
            state.config.maxPathLength = parseInt(document.getElementById('maxPathLength').value) || 4;
            state.config.lowValueThreshold = parseFloat(document.getElementById('lowValueThreshold').value) || 0.01;
            state.config.algorithm = document.getElementById('algorithm').value;
            state.config.autoRefresh = document.getElementById('autoRefreshToggle').checked;
            state.config.autoScan = document.getElementById('autoScanToggle').checked;
            state.config.lowCapFocus = document.getElementById('lowCapFocus').checked;
            
            // Update portfolio
            state.portfolio.enabled = document.getElementById('portfolioFilterToggle').checked;
            state.portfolio.includeStablecoins = document.getElementById('includeStablecoins').checked;
            
            const portfolioInput = document.getElementById('portfolioInput').value;
            if (portfolioInput.trim()) {
                state.portfolio.currencies = new Set(
                    portfolioInput.toUpperCase().split(',').map(s => s.trim()).filter(s => s)
                );
                document.getElementById('portfolioStatus').textContent = 
                    `Filtering for: ${Array.from(state.portfolio.currencies).join(', ')}`;
            } else {
                state.portfolio.currencies.clear();
                document.getElementById('portfolioStatus').textContent = 'No portfolio set - scanning all currencies';
            }
        }

        async function refreshMarketData() {
            log('Refreshing market data...', 'info', 'REFRESH');
            await initSystem();
        }

        function clearOpportunities() {
            document.getElementById('opportunities').innerHTML = '';
            document.getElementById('bellmanPaths').innerHTML = '';
            state.stats.oppCount = 0;
            state.bellmanPaths = [];
            updateStats();
            log('Opportunities cleared', 'info', 'CLEANUP');
        }

        function exportData() {
            const data = {
                timestamp: new Date().toISOString(),
                stats: state.stats,
                exchanges: state.exchanges,
                bellmanPaths: state.bellmanPaths,
                opportunities: Array.from(document.querySelectorAll('.opportunity')).map(el => ({
                    exchange: el.querySelector('strong').textContent,
                    profit: el.querySelector('.path-visual').textContent,
                    details: Array.from(el.querySelectorAll('div')).map(d => d.textContent)
                }))
            };
            
            const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `arbitrage-data-${new Date().toISOString().slice(0, 10)}.json`;
            a.click();
            URL.revokeObjectURL(url);
            
            log('Data exported successfully', 'success', 'EXPORT');
        }

        function startAutoRefresh() {
            if (state.config.autoRefresh) {
                setInterval(() => {
                    if (!state.isScanning) {
                        refreshMarketData();
                    }
                }, 60000); // Every minute
                log('Auto-refresh enabled (60s intervals)', 'info', 'AUTO');
            }
        }

        function startAutoScan() {
            if (state.config.autoScan) {
                setInterval(() => {
                    if (!state.isScanning && state.systemReady) {
                        runAdvancedArbitrageScan();
                    }
                }, 120000); // Every 2 minutes
                log('Auto-scan enabled (120s intervals)', 'info', 'AUTO');
            }
        }

        // Update system time and memory usage
        function updateSystemInfo() {
            const now = new Date();
            document.getElementById('systemTime').textContent = 
                `${now.getHours().toString().padStart(2, '0')}:${now.getMinutes().toString().padStart(2, '0')}:${now.getSeconds().toString().padStart(2, '0')}`;
            
            // Simulate memory usage for demo
            const memoryUsage = 50 + Math.random() * 50;
            document.getElementById('memoryUsage').textContent = `RAM: ${Math.round(memoryUsage)} MB`;
        }

        // Auto-initialize on load
        window.addEventListener('load', function() {
            log('⚡ QuanTM FOAM v7.0 - Advanced Arbitrage System Loaded', 'success', 'BOOT');
            setInterval(updateSystemInfo, 1000);
            setTimeout(initSystem, 1000);
        });

        // Add event listeners for config changes
        document.getElementById('portfolioInput').addEventListener('input', function() {
            updateConfigFromUI();
        });

        document.querySelectorAll('input, select').forEach(el => {
            el.addEventListener('change', updateConfigFromUI);
        });
    </script>
</body>
</html>
