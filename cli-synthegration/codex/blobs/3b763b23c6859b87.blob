<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
    <title>Jesse Pawlak | Calisthenics & Fitness</title>
    <!-- Font Awesome 6 for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: #0a0a0a;
            font-family: 'Segoe UI', Roboto, system-ui, sans-serif;
            color: #e0e0e0;
            line-height: 1.5;
            overflow-x: hidden;
        }

        /* energetic gradient background */
        .bg-glow {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: radial-gradient(circle at 30% 40%, rgba(255, 140, 0, 0.12), transparent 60%),
                        radial-gradient(circle at 80% 70%, rgba(220, 20, 60, 0.15), transparent 70%),
                        radial-gradient(circle at 50% 10%, rgba(255, 215, 0, 0.08), transparent 50%);
            z-index: -2;
            pointer-events: none;
        }

        .container {
            max-width: 1100px;
            margin: 0 auto;
            padding: 0 1.5rem;
        }

        /* header / navigation */
        .navbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1.2rem 0;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 1.6rem;
            font-weight: 700;
            letter-spacing: -0.5px;
            background: linear-gradient(135deg, #ff8c00, #ff4d4d);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .logo i {
            background: none;
            -webkit-text-fill-color: #ff8c00;
            font-size: 2rem;
        }

        .nav-links {
            display: flex;
            gap: 1.8rem;
            align-items: center;
            flex-wrap: wrap;
        }

        .nav-links a {
            color: #ccc;
            text-decoration: none;
            font-weight: 500;
            transition: 0.2s;
            font-size: 0.95rem;
        }

        .nav-links a:hover {
            color: #ff8c00;
        }

        .yt-sub-btn {
            background: #ff0000;
            color: white !important;
            padding: 0.5rem 1.4rem;
            border-radius: 30px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 0.4rem;
            transition: 0.2s;
        }

        .yt-sub-btn:hover {
            background: #cc0000;
            transform: scale(1.03);
        }

        /* hero section */
        .hero {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 2rem;
            padding: 5rem 0 4rem;
        }

        .hero-content {
            flex: 1 1 400px;
        }

        .hero-badge {
            display: inline-block;
            background: rgba(255, 140, 0, 0.15);
            border: 1px solid rgba(255, 140, 0, 0.4);
            color: #ffa500;
            padding: 0.3rem 1.2rem;
            border-radius: 20px;
            font-weight: 600;
            font-size: 0.85rem;
            letter-spacing: 0.5px;
            margin-bottom: 1.2rem;
        }

        .hero h1 {
            font-size: 3.8rem;
            font-weight: 800;
            line-height: 1.1;
            letter-spacing: -1px;
            margin-bottom: 1rem;
        }

        .hero .highlight {
            background: linear-gradient(135deg, #ff8c00, #ff4d4d);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .hero p {
            font-size: 1.15rem;
            color: #b0b0b0;
            max-width: 500px;
            margin-bottom: 2rem;
        }

        .hero-buttons {
            display: flex;
            gap: 1rem;
            flex-wrap: wrap;
        }

        .btn {
            padding: 0.8rem 2rem;
            border-radius: 40px;
            font-weight: 600;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            transition: 0.2s;
            border: none;
            cursor: pointer;
            font-size: 0.95rem;
        }

        .btn-primary {
            background: #ff8c00;
            color: #0a0a0a;
        }

        .btn-primary:hover {
            background: #ffa500;
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(255, 140, 0, 0.3);
        }

        .btn-outline {
            background: transparent;
            color: white;
            border: 2px solid #555;
        }

        .btn-outline:hover {
            border-color: #ff8c00;
            color: #ff8c00;
        }

        .hero-visual {
            flex: 1 1 350px;
            display: flex;
            justify-content: center;
            position: relative;
        }

        .avatar-frame {
            width: 250px;
            height: 250px;
            border-radius: 50%;
            background: linear-gradient(135deg, #ff8c00, #ff4d4d);
            padding: 5px;
            box-shadow: 0 0 60px rgba(255, 140, 0, 0.5);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .avatar-frame i {
            font-size: 7rem;
            color: #0a0a0a;
        }

        /* stats bar */
        .stats-grid {
            display: flex;
            flex-wrap: wrap;
            gap: 2rem;
            justify-content: center;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 20px;
            padding: 2rem 3rem;
            margin: 1rem 0 4rem;
            backdrop-filter: blur(10px);
        }

        .stat-item {
            text-align: center;
            flex: 1 1 120px;
        }

        .stat-number {
            font-size: 2.3rem;
            font-weight: 700;
            background: linear-gradient(135deg, #ff8c00, #ff4d4d);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .stat-label {
            font-size: 0.9rem;
            color: #999;
            margin-top: 0.2rem;
        }

        /* section titles */
        .section-title {
            font-size: 2.2rem;
            font-weight: 700;
            margin-bottom: 2rem;
            text-align: center;
        }

        .section-title span {
            background: linear-gradient(135deg, #ff8c00, #ff4d4d);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        /* about section */
        .about-section {
            padding: 3rem 0;
        }

        .about-grid {
            display: flex;
            flex-wrap: wrap;
            gap: 2rem;
            align-items: center;
            background: rgba(255, 255, 255, 0.02);
            border-radius: 24px;
            padding: 2.5rem;
            border: 1px solid rgba(255, 255, 255, 0.06);
        }

        .about-text {
            flex: 1 1 300px;
        }

        .about-text h3 {
            font-size: 1.8rem;
            margin-bottom: 1rem;
            color: #ff8c00;
        }

        .about-text p {
            color: #c0c0c0;
            margin-bottom: 1rem;
        }

        .about-details {
            flex: 1 1 250px;
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .detail-chip {
            background: rgba(255, 140, 0, 0.08);
            border-left: 4px solid #ff8c00;
            padding: 0.8rem 1rem;
            border-radius: 8px;
            color: #ddd;
            font-weight: 500;
        }

        .detail-chip i {
            color: #ff8c00;
            margin-right: 0.5rem;
            width: 20px;
            text-align: center;
        }

        /* training philosophy cards */
        .philosophy-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
            gap: 1.8rem;
            margin: 3rem 0;
        }

        .phil-card {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: 20px;
            padding: 2rem 1.5rem;
            text-align: center;
            transition: 0.25s;
        }

        .phil-card:hover {
            border-color: rgba(255, 140, 0, 0.4);
            transform: translateY(-5px);
            box-shadow: 0 15px 30px rgba(0,0,0,0.5);
        }

        .phil-card i {
            font-size: 2.8rem;
            color: #ff8c00;
            margin-bottom: 1rem;
        }

        .phil-card h4 {
            font-size: 1.3rem;
            margin-bottom: 0.5rem;
        }

        .phil-card p {
            color: #a0a0a0;
            font-size: 0.9rem;
        }

        /* featured channels */
        .featured-section {
            padding: 3rem 0;
        }

        .featured-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1.5rem;
            margin-top: 2rem;
        }

        .featured-channel {
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(255, 255, 255, 0.06);
            border-radius: 20px;
            padding: 1.8rem 1.2rem;
            text-align: center;
            transition: 0.25s;
            text-decoration: none;
            color: inherit;
            display: block;
        }

        .featured-channel:hover {
            border-color: #ff8c00;
            transform: translateY(-4px);
            box-shadow: 0 12px 24px rgba(0,0,0,0.4);
        }

        .featured-channel i {
            font-size: 2.5rem;
            color: #ff0000;
            margin-bottom: 0.8rem;
        }

        .featured-channel h5 {
            font-size: 1.1rem;
            margin-bottom: 0.3rem;
        }

        .featured-channel p {
            font-size: 0.8rem;
            color: #999;
        }

        .coming-soon {
            opacity: 0.6;
            pointer-events: none;
        }

        /* newsletter / cta */
        .cta-section {
            background: linear-gradient(135deg, rgba(255, 140, 0, 0.15), rgba(220, 20, 60, 0.1));
            border-radius: 28px;
            padding: 3rem 2.5rem;
            text-align: center;
            margin: 3rem 0;
            border: 1px solid rgba(255, 140, 0, 0.2);
        }

        .cta-section h3 {
            font-size: 2rem;
            margin-bottom: 1rem;
        }

        .cta-section p {
            color: #b0b0b0;
            margin-bottom: 2rem;
        }

        .newsletter-form {
            display: flex;
            gap: 0.5rem;
            justify-content: center;
            flex-wrap: wrap;
        }

        .newsletter-form input {
            padding: 0.8rem 1.5rem;
            border-radius: 40px;
            border: 1px solid #444;
            background: #1a1a1a;
            color: white;
            min-width: 250px;
            outline: none;
        }

        .newsletter-form input:focus {
            border-color: #ff8c00;
        }

        /* footer */
        .footer {
            border-top: 1px solid rgba(255, 255, 255, 0.08);
            padding: 2rem 0;
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            align-items: center;
            color: #777;
            font-size: 0.9rem;
            gap: 1rem;
        }

        .social-links {
            display: flex;
            gap: 1.2rem;
        }

        .social-links a {
            color: #aaa;
            font-size: 1.3rem;
            transition: 0.2s;
        }

        .social-links a:hover {
            color: #ff8c00;
        }

        /* responsive */
        @media (max-width: 700px) {
            .hero h1 {
                font-size: 2.5rem;
            }
            .navbar {
                flex-direction: column;
                align-items: flex-start;
            }
        }
    </style>
</head>
<body>
    <div class="bg-glow"></div>

    <div class="container">
        <!-- Header -->
        <nav class="navbar">
            <div class="logo">
                <i class="fas fa-dumbbell"></i> JESSE PAWLAK
            </div>
            <div class="nav-links">
                <a href="#">Home</a>
                <a href="#">Videos</a>
                <a href="#">Programs</a>
                <a href="#">About</a>
                <a href="https://www.youtube.com/@JessePawlak" target="_blank" class="yt-sub-btn">
                    <i class="fab fa-youtube"></i> Subscribe 266K
                </a>
            </div>
        </nav>

        <!-- Hero -->
        <section class="hero">
            <div class="hero-content">
                <span class="hero-badge"><i class="fas fa-fire"></i> CALISTHENICS · BODYBUILDING</span>
                <h1>Built <span class="highlight">with grit.</span><br>Forged <span class="highlight">in discipline.</span></h1>
                <p>From prison yard to YouTube powerhouse — Jesse Pawlak brings you raw, high-rep calisthenics that build a 200lb muscular physique without weights. Real training. Real results.</p>
                <div class="hero-buttons">
                    <a href="https://www.youtube.com/@JessePawlak" target="_blank" class="btn btn-primary">
                        <i class="fab fa-youtube"></i> Watch on YouTube
                    </a>
                    <a href="#" class="btn btn-outline">
                        <i class="fas fa-envelope"></i> Join Newsletter
                    </a>
                </div>
            </div>
            <div class="hero-visual">
                <div class="avatar-frame">
                    <i class="fas fa-user-ninja"></i>
                </div>
            </div>
        </section>

        <!-- Stats -->
        <div class="stats-grid">
            <div class="stat-item">
                <div class="stat-number">266K</div>
                <div class="stat-label">Subscribers</div>
            </div>
            <div class="stat-item">
                <div class="stat-number">1,083</div>
                <div class="stat-label">Videos</div>
            </div>
            <div class="stat-item">
                <div class="stat-number">63M+</div>
                <div class="stat-label">Total Views</div>
            </div>
            <div class="stat-item">
                <div class="stat-number">200lb</div>
                <div class="stat-label">Physique</div>
            </div>
            <div class="stat-item">
                <div class="stat-number">5'11"</div>
                <div class="stat-label">Height</div>
            </div>
        </div>

        <!-- About -->
        <section class="about-section" id="about">
            <h2 class="section-title">Meet <span>Jesse Pawlak</span></h2>
            <div class="about-grid">
                <div class="about-text">
                    <h3>The Man Behind the Muscle</h3>
                    <p>Jesse Pawlak is a 44-year-old fitness coach, entrepreneur, and YouTuber from Cleveland, Ohio. Of Polish and European-American heritage, he built his impressive 200lb physique through nothing but high-rep calisthenics — during 6½ years inside the U.S. prison system.</p>
                    <p>His channel focuses on short-range-of-motion, high-repetition bodyweight training that delivers serious size and strength. No gimmicks, just old-school prison grit combined with modern fitness knowledge.</p>
                </div>
                <div class="about-details">
                    <div class="detail-chip"><i class="fas fa-map-marker-alt"></i> Cleveland, Ohio</div>
                    <div class="detail-chip"><i class="fas fa-calendar-alt"></i> Born January 6, 1982</div>
                    <div class="detail-chip"><i class="fas fa-weight-hanging"></i> 200lb Muscular Build</div>
                    <div class="detail-chip"><i class="fas fa-clock"></i> 6½ Years Prison Training</div>
                    <div class="detail-chip"><i class="fas fa-tree"></i> Arborist & Entrepreneur</div>
                </div>
            </div>
        </section>

        <!-- Training Philosophy -->
        <h2 class="section-title" style="margin-top: 4rem;">The <span>Pawlak Method</span></h2>
        <div class="philosophy-grid">
            <div class="phil-card">
                <i class="fas fa-redo-alt"></i>
                <h4>High Rep Calisthenics</h4>
                <p>Short range of motion, massive volume. The exact method that built a 200lb physique behind bars.</p>
            </div>
            <div class="phil-card">
                <i class="fas fa-fist-raised"></i>
                <h4>Prison-Style Grit</h4>
                <p>No equipment, no excuses. Training forged in the toughest environment — the U.S. prison system.</p>
            </div>
            <div class="phil-card">
                <i class="fas fa-brain"></i>
                <h4>Mind-Muscle Focus</h4>
                <p>Every rep counts. Jesse teaches you to connect with your body and push past mental barriers.</p>
            </div>
            <div class="phil-card">
                <i class="fas fa-users"></i>
                <h4>Real Community</h4>
                <p>Join 266K subscribers who are transforming their bodies with honest, no-BS training advice.</p>
            </div>
        </div>

        <!-- Featured Channels Section -->
        <section class="featured-section" id="featured">
            <h2 class="section-title">Featured <span>Channels</span></h2>
            <p style="text-align: center; color: #aaa; margin-bottom: 1rem;">
                Channels Jesse trusts and recommends for calisthenics, fitness, and mindset.
            </p>
            <div class="featured-grid">
                <!-- These are placeholder featured channels – real data could not be retrieved directly -->
                <a href="https://www.youtube.com/@ChrisHeria" target="_blank" class="featured-channel">
                    <i class="fab fa-youtube"></i>
                    <h5>Chris Heria</h5>
                    <p>Calisthenics & Street Workout</p>
                </a>
                <a href="https://www.youtube.com/@FitnessFAQs" target="_blank" class="featured-channel">
                    <i class="fab fa-youtube"></i>
                    <h5>FitnessFAQs</h5>
                    <p>Bodyweight Mastery</p>
                </a>
                <a href="https://www.youtube.com/@Calisthenicmovement" target="_blank" class="featured-channel">
                    <i class="fab fa-youtube"></i>
                    <h5>Calisthenicmovement</h5>
                    <p>Technique & Progression</p>
                </a>
                <a href="https://www.youtube.com/@TomMerrick" target="_blank" class="featured-channel">
                    <i class="fab fa-youtube"></i>
                    <h5>Tom Merrick</h5>
                    <p>Bodyweight Warrior</p>
                </a>
                <a href="#" class="featured-channel coming-soon">
                    <i class="fab fa-youtube"></i>
                    <h5>Jailhouse Strong</h5>
                    <p>Prison Workout Tactics</p>
                </a>
                <a href="#" class="featured-channel coming-soon">
                    <i class="fab fa-youtube"></i>
                    <h5>More Coming Soon</h5>
                    <p>Stay tuned</p>
                </a>
            </div>
            <p style="text-align: center; margin-top: 1.5rem; color: #777; font-size: 0.85rem;">
                ⚡ Note: Featured channels are being updated. Check back for Jesse's official recommendations.
            </p>
        </section>

        <!-- CTA / Newsletter -->
        <section class="cta-section">
            <h3>Get the <span style="color: #ff8c00;">Pawlak Pump</span> newsletter</h3>
            <p>Weekly calisthenics tips, workout breakdowns, and exclusive content straight to your inbox.</p>
            <form class="newsletter-form" onsubmit="event.preventDefault(); alert('Thanks! Newsletter feature coming soon.');">
                <input type="email" placeholder="Your email address" required>
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-paper-plane"></i> Subscribe
                </button>
            </form>
        </section>

        <!-- Footer -->
        <footer class="footer">
            <div>
                <p>© 2026 Jesse Pawlak. All rights reserved. | P.O. Box #43, Avon Lake, OH 44012</p>
            </div>
            <div class="social-links">
                <a href="https://www.youtube.com/@JessePawlak" target="_blank"><i class="fab fa-youtube"></i></a>
                <a href="#"><i class="fab fa-instagram"></i></a>
                <a href="#"><i class="fab fa-twitter"></i></a>
                <a href="#"><i class="fab fa-tiktok"></i></a>
            </div>
        </footer>
    </div>

    <!-- smooth scroll for anchor links -->
    <script>
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function(e) {
                const href = this.getAttribute('href');
                if (href === "#") return;
                const target = document.querySelector(href);
                if (target) {
                    e.preventDefault();
                    target.scrollIntoView({ behavior: 'smooth' });
                }
            });
        });
    </script>
</body>
</html>
