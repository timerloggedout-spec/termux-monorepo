<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
  <title>🎰 QuanTM FOAM v23.30 – Unified Swarm + Trading Terminal</title>
  <style>
    :root {
      --pink: #ff00ff; --cyan: #00f0ff; --green: #00ffaa; --gold: #ffd700;
      --bg: #0a0a1a; --card: #1a1a2a; --border: #2a2a3a; --base-font-size: 10px;
    }
    * { margin:0; padding:0; box-sizing:border-box; }
    body { background:var(--bg); color:#a0a0ff; font-family:'Courier New',monospace; font-size:var(--base-font-size); overflow-x:hidden; }
    canvas#particleCanvas { position:fixed; top:0; left:0; width:100%; height:100%; pointer-events:none; z-index:9999; }
    .container { max-width:1500px; margin:0 auto; padding:8px; position:relative; z-index:1; }
    h1 { color:var(--gold); font-size:calc(var(--base-font-size)*1.8); text-shadow:0 0 12px var(--pink),0 0 20px var(--cyan); margin-bottom:4px; }
    h2 { color:var(--cyan); font-size:calc(var(--base-font-size)*1.3); margin:10px 0 5px; }
    .status-bar { padding:6px 12px; margin:6px 0; background:linear-gradient(145deg,#0a0a1a,#1a1a2a); border-radius:8px; border-left:4px solid var(--cyan); font-weight:bold; display:flex; justify-content:space-between; align-items:center; box-shadow:0 0 15px rgba(0,240,255,0.25); flex-wrap:wrap; }
    .controls { display:flex; flex-wrap:wrap; gap:5px; margin:6px 0; }
    button { background:#111; border:2px solid var(--pink); color:var(--pink); padding:6px 10px; border-radius:18px; font-size:calc(var(--base-font-size)*0.9); font-weight:bold; cursor:pointer; font-family:'Courier New',monospace; transition:all 0.2s; text-transform:uppercase; letter-spacing:1px; box-shadow:0 0 6px var(--pink); }
    button:hover { background:var(--pink); color:#000; box-shadow:0 0 18px var(--pink); }
    button:active { transform:scale(0.95); }
    button.cyan { border-color:var(--cyan); color:var(--cyan); box-shadow:0 0 6px var(--cyan); }
    button.cyan:hover { background:var(--cyan); color:#000; }
    button.live { border-color:#ff4444; color:#ff4444; animation:livePulse 1s infinite; }
    button.gold { border-color:var(--gold); color:var(--gold); box-shadow:0 0 10px var(--gold); font-size:calc(var(--base-font-size)*1.1); padding:8px 18px; }
    button.gold:hover { background:var(--gold); color:#000; box-shadow:0 0 25px var(--gold); }
    button.allin { border-color:#ff4444; color:#ff4444; box-shadow:0 0 10px #ff4444; font-size:calc(var(--base-font-size)*1.1); padding:8px 18px; }
    button.allin:hover { background:#ff4444; color:#000; box-shadow:0 0 25px #ff4444; }
    button.reset { border-color:#ffaa00; color:#ffaa00; box-shadow:0 0 8px #ffaa00; }
    button.reset:hover { background:#ffaa00; color:#000; box-shadow:0 0 20px #ffaa00; }
    button.test { border-color:#44ff44; color:#44ff44; box-shadow:0 0 8px #44ff44; }
    button.test:hover { background:#44ff44; color:#000; box-shadow:0 0 20px #44ff44; }
    @keyframes livePulse { 0%,100%{box-shadow:0 0 6px #ff4444;} 50%{box-shadow:0 0 16px #ff4444;} }
    button:disabled { opacity:0.4; cursor:not-allowed; }
    .grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(280px,1fr)); gap:8px; margin:8px 0; }
    .card { background:var(--card); border-radius:8px; padding:10px; border:1px solid var(--border); box-shadow:0 0 10px rgba(255,0,255,0.08); }
    .card h3 { color:var(--cyan); font-size:calc(var(--base-font-size)*1.1); margin-bottom:6px; }
    .exchange-status { display:flex; align-items:center; gap:5px; padding:3px; background:#0a0a1a; border-radius:4px; margin:2px 0; font-size:calc(var(--base-font-size)*0.8); border:1px solid #2a2a3a; }
    .indicator { width:6px; height:6px; border-radius:50%; background:#ff4444; box-shadow:0 0 5px #ff4444; }
    .indicator.online { background:var(--green); box-shadow:0 0 8px var(--green); animation:pulse 1.5s infinite; }
    .indicator.ws { background:#ff00ff; box-shadow:0 0 8px #ff00ff; animation:pulse 0.8s infinite; }
    .indicator.reconnecting { background:#ffaa00; box-shadow:0 0 8px #ffaa00; animation:pulse 0.5s infinite; }
    @keyframes pulse { 0%,100%{opacity:1;box-shadow:0 0 6px var(--green);} 50%{opacity:0.4;box-shadow:0 0 14px var(--green);} }
    .stat { display:flex; justify-content:space-between; padding:2px 0; font-size:calc(var(--base-font-size)*0.9); }
    .stat-value { color:var(--gold); font-weight:bold; }
    .rolling-number { font-size:calc(var(--base-font-size)*1.3); color:var(--gold); font-weight:bold; }
    .opp-section { margin:6px 0; padding:6px; background:#0f0f1f; border-radius:5px; border:1px solid #2a2a3a; }
    .opp-header { display:flex; justify-content:space-between; padding:6px; background:#1a1a2a; border-radius:5px; cursor:pointer; font-weight:bold; color:var(--pink); font-size:calc(var(--base-font-size)*0.9); }
    .opp-list { max-height:280px; overflow-y:auto; }
    .opportunity { background:#111; padding:6px; margin:3px 0; border-radius:5px; border-left:3px solid var(--green); cursor:pointer; font-size:calc(var(--base-font-size)*0.9); }
    .opportunity:hover { border-left-color:var(--pink); background:#1a1a2a; }
    .opportunity.mega { border-left-color:var(--gold); animation:glow 1s infinite alternate; }
    @keyframes glow { from{box-shadow:0 0 3px var(--gold);} to{box-shadow:0 0 16px var(--gold);} }
    .log-container { background:#000; padding:6px; border-radius:5px; max-height:150px; overflow-y:auto; font-size:calc(var(--base-font-size)*0.7); margin-top:6px; }
    .modal { display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.85); z-index:10000; align-items:center; justify-content:center; }
    .modal-content { background:#1a1a2a; border:2px solid var(--pink); border-radius:10px; padding:16px; max-width:700px; width:95%; color:white; max-height:85vh; overflow-y:auto; }
    .flex-row { display:flex; gap:6px; align-items:center; flex-wrap:wrap; }
    input,select { background:#0a0a1a; border:1px solid var(--cyan); color:var(--cyan); padding:2px 5px; border-radius:3px; font-family:'Courier New',monospace; font-size:calc(var(--base-font-size)*0.9); }
    .checkbox-group { display:flex; flex-wrap:wrap; gap:3px; align-items:center; }
    .checkbox-group label { display:flex; align-items:center; gap:2px; font-size:calc(var(--base-font-size)*0.7); color:var(--cyan); }
    .tier-badge { display:inline-block; padding:1px 4px; border-radius:2px; font-size:calc(var(--base-font-size)*0.6); color:#000; margin-left:2px; }
    .tier-pico { background:#ffaa00; } .tier-femto { background:#ff00ff; } .tier-planck { background:#00f0ff; }
    .progress-bar { height:6px; background:#333; border-radius:3px; margin:3px 0; }
    .progress-fill { height:100%; background:var(--gold); border-radius:3px; width:0%; }
    .perk-unlocked { color:var(--green); } .perk-locked { color:#ff4444; text-decoration:line-through; }
    #graphSlotContainer { display:none; background:linear-gradient(180deg,#0a0a1a,#1a0a2a); border:3px solid var(--gold); border-radius:14px; padding:12px; margin:10px 0; text-align:center; box-shadow:0 0 30px rgba(255,215,0,0.3); position:relative; overflow:hidden; }
    #graphNetwork { display:block; margin:0 auto; position:relative; z-index:2; }
    #batchResult { background:#0a0a1a; border:1px solid var(--gold); border-radius:6px; padding:8px; margin-top:8px; font-size:calc(var(--base-font-size)*0.8); max-height:250px; overflow-y:auto; text-align:left; position:relative; z-index:2; }
    #batchHistory { background:#0a0a1a; border:1px solid var(--cyan); border-radius:6px; padding:8px; margin-top:8px; font-size:calc(var(--base-font-size)*0.7); max-height:150px; overflow-y:auto; text-align:left; position:relative; z-index:2; }
    .target-preset { border:1px solid var(--cyan); padding:2px 6px; border-radius:10px; cursor:pointer; font-size:calc(var(--base-font-size)*0.7); color:var(--cyan); background:transparent; }
    .target-preset:hover { background:var(--cyan); color:#000; }
    .tooltip { position:relative; display:inline-block; cursor:help; color:var(--gold); }
    .tooltip .tooltiptext { visibility:hidden; width:200px; background:#1a1a2a; color:#fff; text-align:center; border-radius:6px; padding:5px; position:absolute; z-index:10; bottom:125%; left:50%; margin-left:-100px; opacity:0; transition:opacity 0.3s; font-size:calc(var(--base-font-size)*0.7); }
    .tooltip:hover .tooltiptext { visibility:visible; opacity:1; }
    .panel { background:var(--card); border-radius:8px; padding:10px; margin:6px 0; border:1px solid var(--border); display:none; }
    .panel h3 { color:var(--cyan); font-size:calc(var(--base-font-size)*1.1); margin-bottom:6px; }
    .panel textarea { width:100%; background:#0a0a1a; color:var(--cyan); border:1px solid var(--cyan); font-family:'Courier New',monospace; font-size:calc(var(--base-font-size)*0.9); padding:4px; }
    .torrent-progress { height:10px; background:#333; border-radius:5px; margin:4px 0; }
    .torrent-fill { height:100%; background:var(--green); border-radius:5px; width:0%; }
    .player-row { cursor:pointer; padding:3px 5px; margin:2px 0; border-radius:3px; background:#0a0a1a; }
    .player-row:hover { background:#2a2a3a; }
  </style>
  <!-- P2P & DB libraries -->
  <script src="https://cdn.jsdelivr.net/npm/yjs@13.6.7/dist/yjs.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/y-webrtc@10.3.0/dist/y-webrtc.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/webtorrent@1.9.6/webtorrent.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/qrcode@1.5.1/build/qrcode.min.js"></script>
</head>
<body>
  <canvas id="particleCanvas"></canvas>
  <div class="container">
    <h1>🎰 QUANTM FOAM <span style="font-size:11px;">v23.30 – Unified Swarm + Trading Terminal</span></h1>
    <div class="status-bar">
      <span id="mainStatus">🟡 STANDBY — Click INIT</span>
      <div class="flex-row">
        <span style="font-size:8px;">VIRTUAL</span>
        <input type="checkbox" id="liveToggle" onchange="UI.toggleLiveMode()">
        <span style="font-size:8px;">LIVE</span>
        <span style="font-size:8px;color:#ffaa00;display:none;" id="testnetLabel">🧪 TESTNET</span>
        <input type="checkbox" id="liveTestnetToggle" onchange="UI.toggleLiveTestnet()" style="display:none;">
        <span class="tooltip">ℹ️<span class="tooltiptext">LIVE uses real endpoints. Enable TESTNET for official testnet trading (Uniswap, PancakeSwap, OKX, Binance).</span></span>
      </div>
    </div>
    <div class="controls">
      <button class="cyan" onclick="UI.logButton('INIT');initSystem()">🔄 INIT</button>
      <button id="scanBtn" onclick="UI.logButton('FULL SCAN');runFullScan()" disabled>🎲 SCAN</button>
      <button id="liveScanBtn" onclick="UI.logButton('LIVE SCAN');toggleLiveScan()">🔄 LIVE</button>
      <button onclick="UI.logButton('LIVE WS');connectAllWebSockets()">📡 WS</button>
      <button onclick="UI.logButton('CREATE COIN');openCreateCoinModal()">🪙 COIN</button>
      <button onclick="UI.logButton('PUMP LAUNCH');openPumpLaunchModal()">🚀 PUMP</button>
      <button onclick="UI.logButton('GRAPH UI');UI.toggleGraphSlot()">🌐 GRAPH</button>
      <button onclick="UI.logButton('LOGS');toggleLogs()">📋 LOGS</button>
      <button onclick="UI.logButton('COPY LOGS');UI.copyLogsRobust()">📋 COPY</button>
      <button onclick="UI.logButton('CSV EXPORT');Engine.exportCSV()">📥 CSV</button>
      <button onclick="UI.logButton('API KEYS');openApiKeysModal()">🔑 KEYS</button>
      <button onclick="UI.logButton('SHARE');shareJackpot()">📤 SHARE</button>
      <button onclick="UI.logButton('THEME');toggleTheme()">🎨</button>
      <button class="reset" onclick="Engine.resetPaperAccount()">🧹 RESET</button>
      <button class="test" onclick="Engine.runTestSuite()">🧪 TEST</button>
      <button id="torrentBtn" onclick="UI.togglePanel('torrentPanel')">📦 TORRENT</button>
      <button onclick="UI.togglePanel('dbPanel')">📊 DB</button>
      <button onclick="UI.togglePanel('ipnsPanel')">☁️ IPNS</button>
      <button onclick="UI.togglePanel('manaPanel')">⚡ MANA</button>
      <button onclick="UI.togglePanel('dexPanel')">💱 DEX</button>
      <button id="strategyBtn" onclick="UI.togglePanel('strategyPanel')" disabled>🔐 STRATEGY</button>
    </div>
    <div class="card" style="margin-bottom:6px;">
      <div class="flex-row">
        <label>🌐 FETCH:</label><select id="proxySelect" onchange="UI.onProxyChange()"><option value="direct">⚡ Direct</option><option value="builtin">🔁 Proxy</option><option value="custom">📝 Custom</option></select>
        <input type="text" id="corsProxyUrl" placeholder="Proxy URL" style="display:none;width:180px;">
        <label>🔐 WALLET:</label><input type="text" id="walletProxyUrl" style="width:140px;">
        <label>🔗 Exec Path:</label><input type="text" id="execPath" value="/execute" style="width:65px;">
        <button onclick="UI.logButton('SAVE PROXY');saveProxyConfig()" class="cyan">SAVE</button>
      </div>
      <div id="proxyStatusMsg"></div>
      <div class="flex-row" style="margin-top:4px;">
        <label>🌐 Testnets:</label><input type="checkbox" id="testnetToggle" onchange="toggleTestnets()">
        <span style="font-size:8px;color:#888;">Binance Testnet, OKX Demo, Uniswap Sepolia, PancakeSwap Testnet, SushiSwap Testnet</span>
        <label>⏸️ Pause Logs:</label><input type="checkbox" id="pauseLogsToggle" onchange="togglePauseLogs()">
      </div>
    </div>
    <div class="card" style="margin-bottom:6px;">
      <div class="flex-row"><label>🆔 Handle:</label><input type="text" id="playerHandle" value="" onchange="setPlayerHandle()" style="width:140px;"><span style="font-size:7px;color:var(--cyan);">(shared via Yjs swarm)</span></div>
    </div>
    <div class="flex-row" style="gap:8px;margin:4px 0;">
      <label>🔍 UI Scale:</label><input type="range" id="uiScaleSlider" min="8" max="16" value="10" oninput="setUIScale(this.value)" style="width:120px;"><span id="uiScaleLabel">10px</span>
    </div>
    <div id="graphSlotContainer">
      <h3 style="color:var(--gold);">🌐 MULTI‑LINE GRAPH</h3>
      <canvas id="graphNetwork" width="700" height="380"></canvas>
      <div id="graphLegend">🟢 Size = purchase power | 🔆 Glow = profit | ⚠️ Dashed red = shared edge</div>
      <div>
        <label>🔗 Depth: <span id="slotDepthLabel2">5</span></label>
        <label><input type="checkbox" id="autoOpenTrade" checked> Auto‑open</label>
        <label><input type="checkbox" id="bellmanToggle" onchange="UI.logButton('Bellman toggle')"> Bellman‑Ford</label>
        <label>🎯 Target: <input type="text" id="targetAssetsInput" placeholder="e.g. BABYDOGE,USDT" style="width:130px;"></label>
        <span class="target-preset" onclick="setTargetPreset('BABYDOGE,MEME,PEPE,WOW,TRON')">🕹️ Meme</span>
        <span class="target-preset" onclick="setTargetPreset('USDT,USDC,USD,GUSD')">💵 Stables</span>
        <span class="target-preset" onclick="setTargetPreset('BTC,ETH,SOL,LINK')">🏦 Blue</span>
        <span class="target-preset" onclick="setTargetPreset('UNI,WETH,WBTC')" style="border-color:#ff00ff;color:#ff00ff;">🦄 Uniswap</span>
        <label>📉 Short: <input type="checkbox" id="shortToggle" onchange="UI.logButton('Short toggle')"></label>
        <label>📊 Min Profit%: <input type="number" id="minProfitInput" value="0.0001" step="0.0001" style="width:60px;"></label>
        <label>🔄 Fallback: <input type="checkbox" id="fallbackCheck" checked></label>
        <label>🌈 Lines: <input type="number" id="multiLineCount" value="7" min="1" max="8" style="width:35px;"></label>
        <label>💰 Reinvest%: <input type="number" id="reinvestPercent" value="50" min="0" max="100" style="width:40px;">%</label>
        <label>📈 Index%: <input type="number" id="indexFundPercent" value="5" min="0" max="25" style="width:35px;">%</label>
        <label>🧠 Smart Order: <input type="checkbox" id="smartBatchToggle" checked></label>
      </div>
      <button onclick="UI.logButton('PULL LEVER');Engine.pullGraphLever()" class="gold" id="pullLeverBtn2">🎰 PULL LEVER <span id="pullCountdown2"></span></button>
      <button onclick="UI.logButton('EXECUTE ALL');Engine.executeAllLines()" class="allin" id="executeAllBtn">🚀 EXECUTE ALL LINES</button>
      <div id="slotResult2"></div>
      <div id="accumulationInfo" style="font-size:8px;color:var(--cyan);"></div>
      <div id="batchResult"></div>
      <details><summary style="color:var(--cyan);cursor:pointer;font-size:9px;">📜 Batch History</summary><div id="batchHistory"></div></details>
    </div>

    <!-- P2P panels -->
    <div id="torrentPanel" class="panel">
      <h3>📦 TORRENT <button onclick="UI.closePanel('torrentPanel')" style="float:right;background:transparent;border:none;color:var(--pink);font-size:10px;">✖</button></h3>
      <input type="text" id="magnetInput" placeholder="magnet:?xt=urn:btih:..." style="width:100%;"><button onclick="addTorrentFromInput()">DOWNLOAD</button>
      <div class="torrent-progress"><div class="torrent-fill" id="torrentProgressBar"></div></div>
      <div id="torrentStatus"></div><ul id="torrentFileList"></ul>
    </div>
    <div id="dbPanel" class="panel">
      <h3>📊 DUCKDB QUERY <button onclick="UI.closePanel('dbPanel')" style="float:right;background:transparent;border:none;color:var(--pink);font-size:10px;">✖</button></h3>
      <textarea id="sqlQuery" rows="3" placeholder="SELECT * FROM ohlc LIMIT 5;"></textarea>
      <button onclick="executeDBQuery()">RUN</button>
      <pre id="dbResult" style="max-height:150px;overflow:auto;background:#000;padding:4px;font-size:9px;"></pre>
      <div id="dbStatus"></div>
    </div>
    <div id="ipnsPanel" class="panel">
      <h3>☁️ IPNS & SHARE <button onclick="UI.closePanel('ipnsPanel')" style="float:right;background:transparent;border:none;color:var(--pink);font-size:10px;">✖</button></h3>
      <div>🔐 Trusted IPNS Key: <span id="trustedKey">k51q...youradminkey</span></div>
      <div id="ipnsStatus">Checking...</div>
      <button onclick="checkIPNSUpdate()">CHECK UPDATE</button>
      <hr>
      <h4>📤 SHARE ROOM</h4>
      <canvas id="qrCanvas" width="200" height="200"></canvas><br>
      <button onclick="copyShareURL()">📋 COPY URL</button>
      <div><small>Scan or copy to join the same Yjs swarm</small></div>
    </div>
    <div id="manaPanel" class="panel">
      <h3>⚡ MANA TRACKER <button onclick="UI.closePanel('manaPanel')" style="float:right;background:transparent;border:none;color:var(--pink);font-size:10px;">✖</button></h3>
      <div><strong>Your Node ID:</strong> <span id="nodeIdDisplay"></span></div>
      <div>🔋 Compute Mana: <span id="computeMana">0</span></div>
      <div>📡 Data Mana: <span id="dataMana">0</span></div>
      <div>💸 Trade Mana: <span id="tradeMana">0</span></div>
      <div><small>Mana is synced via Yjs and represents your contribution to the swarm.</small></div>
    </div>
    <div id="dexPanel" class="panel">
      <h3>💱 INTERNAL DEX (QuanTM FOAM) <button onclick="UI.closePanel('dexPanel')" style="float:right;background:transparent;border:none;color:var(--pink);font-size:10px;">✖</button></h3>
      <div><strong>Order Book (shared Yjs)</strong></div>
      <div id="dexOrderBook"></div>
      <input type="text" id="dexCoin" placeholder="COIN SYMBOL" style="width:100px;">
      <input type="number" id="dexAmount" placeholder="Amount" style="width:80px;">
      <button onclick="placeDEXOrder()">BUY</button>
      <button onclick="placeDEXOrder('sell')">SELL</button>
    </div>
    <div id="strategyPanel" class="panel">
      <h3>🔐 PRIVATE STRATEGY ROOM <button onclick="UI.closePanel('strategyPanel')" style="float:right;background:transparent;border:none;color:var(--pink);font-size:10px;">✖</button></h3>
      <div>Unlock at Level 10 – Encrypted P2P room for your automated strategies.</div>
      <button onclick="createPrivateRoom()" id="createRoomBtn" disabled>CREATE ROOM</button>
      <div id="privateRoomInfo"></div>
    </div>

    <div class="grid">
      <div class="card">
        <h3>👤 MATRIX LVL <span id="userLevel">1</span> (<span id="modeLabel">PAPER</span>)</h3>
        <div>Score: <span id="matrixScore">0</span> / <span id="nextLevelScore">100</span></div>
        <div class="progress-bar"><div class="progress-fill" id="levelProgress"></div></div>
        <div>💰 Royalties: <span id="royalties">$0.00</span></div>
        <div>🏦 Quantum: <span id="quantumFundVisible">$0.00</span> | 🔒<span id="quantumFundLocked">$0.00</span></div>
        <div><label>SOL:</label><input type="text" id="solAddress" onchange="State.saveWallet()"><span id="solBalance">0.00</span></div>
        <div><label>ETH:</label><input type="text" id="ethAddress" onchange="State.saveWallet()"><span id="ethBalance">0.00</span></div>
      </div>
      <div class="card"><h3>🪙 COIN LEVELS</h3><div id="coinLevels" style="font-size:8px;">No coins yet</div></div>
      <div class="card">
        <h3>📊 PERFORMANCE</h3>
        <div class="stat"><span>Total Trades:</span><span class="stat-value" id="totalTrades">0</span></div>
        <div class="stat"><span>Win Rate:</span><span class="stat-value" id="winRate">0%</span></div>
        <div class="stat"><span>Best Trade:</span><span class="stat-value" id="bestTrade">$0.00</span></div>
        <div class="stat"><span>Worst Trade:</span><span class="stat-value" id="worstTrade">$0.00</span></div>
        <div class="stat"><span>Avg Profit/Trade:</span><span class="stat-value" id="avgProfit">$0.00</span></div>
        <div class="stat"><span>Total P/L:</span><span class="stat-value" id="totalPL">$0.00</span></div>
      </div>
      <div class="card"><h3>📡 LIVE TRADES</h3><div id="liveTrades" style="font-size:8px;">No live trades yet</div></div>
      <div class="card"><h3>⏱️ OPERATION LATENCY</h3><div id="latencyDisplay" style="font-size:8px;">No operations yet</div></div>
      <div class="card"><h3>⭐ LEVEL PERKS</h3><div id="perksList"></div></div>
      <div class="card"><h3>🏦 BASKET TRACKER</h3><div id="basketTracker" style="font-size:8px;">No purchases yet</div><div id="basketValue" style="font-size:8px;color:var(--gold);"></div></div>
      <div class="card">
        <h3>📊 STATISTICS</h3>
        <div class="stat"><span>Pairs:</span><span class="stat-value" id="totalPairs">0</span></div>
        <div class="stat"><span>Nodes:</span><span class="stat-value" id="graphNodes">0</span></div>
        <div class="stat"><span>Edges:</span><span class="stat-value" id="graphEdges">0</span></div>
        <div class="stat"><span>Triangles:</span><span class="stat-value" id="triangleCount">0</span></div>
        <div class="stat"><span>Opps:</span><span class="stat-value" id="oppCount">0</span></div>
        <div class="stat"><span>WS Reconnects:</span><span class="stat-value" id="wsReconnects">0</span></div>
      </div>
      <div class="card"><h3>🌍 NETWORK</h3><div id="playerList">No peers yet</div></div>
    </div>
    <div class="flex-row" style="background:#1a1a2a;padding:8px;border-radius:8px;margin:6px 0;">
      <span>💰 BANKROLL:</span><span class="rolling-number" id="bankroll">$10,000.00</span>
      <span>📈 P/L:</span><span id="pnl">$0.00</span>
    </div>
    <div class="flex-row" style="gap:6px;margin:4px 0;">
      <div><label>🎚️ BET:</label><input type="range" id="betSlider" min="100" max="10000" value="1000" oninput="syncBetInput()"><input type="number" id="betInput" value="1000" style="width:60px;" onchange="syncBetSlider()"></div>
      <div><label>📐 DEPTH:</label><input type="range" id="pathSlider" min="3" max="10" value="5" oninput="UI.syncPathInput()"><input type="number" id="pathInput" value="5" style="width:35px;" onchange="UI.syncPathSlider()"></div>
      <div><label>🧺 BASKET:</label><input type="text" id="basketInput" value="USDT,BTC,ETH,DOGE,SHIB,SOL"></div>
      <div><label>🔁 MODE:</label><select id="arbMode"><option value="both">Both</option><option value="intra">Intra</option><option value="inter">Inter</option></select></div>
      <div><label>🔑 PUMP:</label><input type="text" id="pumpToken"></div>
    </div>
    <div style="margin:4px 0;"><div id="intraExCheckboxes" class="checkbox-group"></div><button onclick="selectAllIntra()" class="cyan">ALL</button><button onclick="deselectAllIntra()" class="cyan">NONE</button></div>
    <div class="card"><h3>💱 FIAT (Multi-source)</h3><div class="flex-row"><div class="checkbox-group" id="fiatCheckboxes"></div><button onclick="UI.logButton('FETCH RATES');fetchForexRates()" class="cyan">🔄 FETCH</button><span id="forexStatus"></span><span id="forexAutoStatus" style="font-size:7px;color:#888;"></span></div></div>
    <h2>⚡ EXCHANGES</h2><div class="grid" id="exchangeStatus"></div>
    <div class="grid"><div class="card"><h3>🔥 PICO</h3><div id="picoValue"></div></div><div class="card"><h3>⚡ FEMTO</h3><div id="femtoValue"></div></div><div class="card"><h3>💧 PLANCK</h3><div id="planckValue"></div></div></div>
    <h2>🎯 OPPORTUNITIES</h2>
    <div class="opp-section"><div class="opp-header" onclick="toggleSection('megaOpps')">🌟 MEGA >5% <span id="megaCount">0</span></div><div id="megaOpps" class="opp-list"></div></div>
    <div class="opp-section"><div class="opp-header" onclick="toggleSection('triangularOpps')">📐 TRIANGULAR <span id="triangularCount">0</span></div><div id="triangularOpps" class="opp-list"></div></div>
    <div class="opp-section"><div class="opp-header" onclick="toggleSection('bellmanOpps')">🔗 BELLMAN-FORD <span id="bellmanCount">0</span></div><div id="bellmanOpps" class="opp-list"></div></div>
    <div class="opp-section"><div class="opp-header" onclick="toggleSection('suspiciousOpps')">⚠️ SUSPICIOUS <span id="suspiciousCount">0</span></div><div id="suspiciousOpps" class="opp-list"></div></div>
    <div class="card"><h3>📒 TRADE LEDGER</h3><div id="tradeLedger"></div></div>
    <h2 onclick="toggleLogs()">📋 LOGS</h2><div class="log-container" id="logs"></div>
  </div>

  <!-- Modals (from v22.30) -->
  <div id="tradeModal" class="modal"><div class="modal-content"><h3>🎰 EXECUTE</h3><div id="tradeDetails"></div><div class="math-breakdown" id="compoundingMath"></div><div id="rateWarning"></div><div id="conflictWarning"></div><button onclick="closeModal()">CANCEL</button><button class="cyan" id="executeTradeBtn">💸 PULL LEVER</button></div></div>
  <div id="createCoinModal" class="modal"><div class="modal-content"><h3>🪙 CREATE TOKEN</h3><div><label>Symbol:</label><input type="text" id="newCoinSymbol" placeholder="SYMBOL" style="width:80px;"><label>Quote:</label><select id="newCoinQuote"><option value="USDT">USDT</option><option value="USDC">USDC</option><option value="USD">USD</option><option value="GUSD">GUSD</option><option value="ETH">ETH</option><option value="SOL">SOL</option></select></div><div><label>Price ($):</label><input type="number" id="newCoinPrice" value="0.000001" step="0.000001" style="width:80px;"><label>Liquidity ($):</label><input type="number" id="newCoinLiq" value="500" step="100" style="width:70px;"></div><div style="margin-top:6px;"><label>Exchanges:</label><div id="coinExCheckboxes" class="checkbox-group"></div></div><div><small style="color:var(--cyan);">Paper: simulated DEX. Live: requires token deployment.</small></div><div id="coinCooldown" style="color:#ffaa00;font-size:8px;"></div><div style="margin-top:8px;"><button onclick="closeCreateCoinModal()">CANCEL</button><button id="createCoinBtn" class="cyan">MINT</button></div></div></div>
  <div id="pumpLaunchModal" class="modal"><div class="modal-content"><h3>🚀 LAUNCH ON PUMP.FUN (Testnet)</h3><div><label>Token Name:</label><input type="text" id="pumpTokenName" placeholder="My Token" style="width:150px;"><label>Symbol:</label><input type="text" id="pumpTokenSymbol" placeholder="TKN" style="width:80px;"></div><div><label>Description:</label><input type="text" id="pumpTokenDesc" placeholder="A meme coin" style="width:200px;"></div><div><label>Image URL:</label><input type="text" id="pumpTokenImage" placeholder="https://..." style="width:200px;"></div><div><label>Pump.fun API:</label><input type="text" id="pumpApiUrl" value="https://frontend-api.pump.fun" style="width:200px;"></div><div><small style="color:var(--cyan);">Launches a simulated token on Pump.fun (paper). Live would require wallet signature.</small></div><div style="margin-top:8px;"><button onclick="closePumpLaunchModal()">CANCEL</button><button id="pumpLaunchBtn" class="cyan">🚀 LAUNCH</button></div></div></div>
  <div id="apiKeysModal" class="modal"><div class="modal-content"><h3>🔑 API KEYS</h3><div id="apiKeyList" class="checkbox-group" style="flex-direction:column;align-items:flex-start;"></div><button onclick="saveApiKeysFromModal()" class="cyan">SAVE</button><button onclick="closeApiKeysModal()">CLOSE</button></div></div>

  <script>
    // ═══════════════════════════════════════════════════════════════
    //  QUANTM FOAM v23.30 – Unified Swarm + Trading Terminal
    //  Merged: v22.30 (DEX testnets, coin leveling, index prestige)
    //         + v23.3 (Multi‑Profile P2P Swarm, Yjs, DuckDB, Mana)
    //  **Expanded Test Suite covering ALL features**
    // ═══════════════════════════════════════════════════════════════

    // ── Audio & Particles ──────────────────────────────────
    const audioCtx = new(window.AudioContext || window.webkitAudioContext)();
    function playTone(f,d,t='square',v=0.05){const o=audioCtx.createOscillator(),g=audioCtx.createGain();o.type=t;o.frequency.value=f;g.gain.setValueAtTime(v,audioCtx.currentTime);g.gain.exponentialRampToValueAtTime(0.001,audioCtx.currentTime+d);o.connect(g);g.connect(audioCtx.destination);o.start();o.stop(audioCtx.currentTime+d);}
    function playSpin(){playTone(800,0.08,'sawtooth',0.04);}
    function playWin(){playTone(523,0.08);setTimeout(()=>playTone(659,0.08),80);setTimeout(()=>playTone(784,0.15),160);}
    const canvas = document.getElementById('particleCanvas'), ctx = canvas.getContext('2d');
    let particles = [];
    function resize(){ canvas.width = innerWidth; canvas.height = innerHeight; }
    window.addEventListener('resize', resize); resize();
    class Particle { constructor(x,y,vx,vy,c,l){ this.x=x;this.y=y;this.vx=vx;this.vy=vy;this.color=c;this.life=l; } }
    function anim(){ ctx.clearRect(0,0,canvas.width,canvas.height); for(let i=particles.length-1;i>=0;i--){ const p=particles[i]; p.x+=p.vx;p.y+=p.vy;p.vy+=0.05;p.life-=0.012; ctx.fillStyle=p.color;ctx.globalAlpha=Math.max(0,p.life);ctx.fillRect(p.x,p.y,3,3); if(p.life<=0)particles.splice(i,1); } requestAnimationFrame(anim); }
    anim();
    function confetti(x,y,n=25){ const cols=['#ff00ff','#00ff00','#ffd700','#00f0ff']; for(let i=0;i<n;i++) particles.push(new Particle(x,y,(Math.random()-0.5)*7,(Math.random()-0.5)*6-3,cols[Math.floor(Math.random()*cols.length)],0.5+Math.random()*0.4)); }

    // ── Identity ─────────────────────────────────────────
    let NODE_ID = localStorage.getItem('qfoam_nodeId');
    if (!NODE_ID) { NODE_ID = 'node_'+Math.random().toString(36).substr(2,9); localStorage.setItem('qfoam_nodeId', NODE_ID); }
    let playerHandle = localStorage.getItem('qfoam_handle') || 'Player';
    document.getElementById('playerHandle').value = playerHandle;
    function setPlayerHandle(){ playerHandle = document.getElementById('playerHandle').value.trim() || 'Player'; localStorage.setItem('qfoam_handle', playerHandle); if(State.ymap) syncStateToYjs(); }

    // ── UI Scale ──────────────────────────────────────────
    function setUIScale(val){ document.documentElement.style.setProperty('--base-font-size', val+'px'); document.getElementById('uiScaleLabel').textContent = val+'px'; localStorage.setItem('uiScale', val); }

    // ── Persistence key ──────────────────────────────────
    const STORAGE_KEY = 'qfoam_v23_30';

    // ── Global State (merged) ─────────────────────────────
    const State = {
      bankroll: 10000, paperMatrix:0, liveMatrix:0, paperLevel:1, liveLevel:1,
      get matrix(){ return this.liveMode?this.liveMatrix:this.paperMatrix; },
      set matrix(v){ if(this.liveMode)this.liveMatrix=v; else this.paperMatrix=v; },
      get level(){ return this.liveMode?this.liveLevel:this.paperLevel; },
      set level(v){ if(this.liveMode)this.liveLevel=v; else this.paperLevel=v; },
      qFund:0, lFund:0, liveMode:false, liveTestMode:false,
      userCoins:[], exchanges:{}, allPairs:[], graph:{}, triangles:[],
      opportunities:{mega:[],triangular:[],bellman:[],suspicious:[]},
      stats:{totalPairs:0,graphNodes:0,graphEdges:0,triangleCount:0,wsBytes:0,oppCount:0,wsReconnects:0},
      selectedIntraExchanges:new Set(), selectedFiats:new Set(['RUB','INR','EUR','GBP']),
      liveScanInterval:null, liveScanActive:false, forexRates:{}, forexInterval:null,
      wsTickers:{}, wsConnections:{}, tradeLedger:[], liveTradeHistory:[],
      proxyMode:'direct', customProxyUrl:'', execPath:'/execute',
      lastTradeExecTime:0, lastPullTime:0, lastCoinCreateTime:0,
      graphRenderer:null, purchasePower:{}, highlightedPaths:[], conflictEdges:new Set(),
      basketHoldings:{}, acquisitionPaths:{}, batchHistory:[], coinExchangeList:['QUANTM_DEX'],
      operationLatency:[], testnetsActive:false, pauseLogs:false, logBuffer:[], apiKeys:{},
      coinLevels:{},
      // P2P additions
      ydoc:null, ymap:null, yPlayers:null, db:null, conn:null, torrentClient:null,
      mana:{compute:0,data:0,trade:0}, otherPlayers:{},
      load(){
        try{
          const s = JSON.parse(localStorage.getItem(STORAGE_KEY));
          if(s){
            this.bankroll = s.bankroll||10000; this.paperMatrix = s.paperMatrix||0; this.liveMatrix = s.liveMatrix||0;
            this.paperLevel = s.paperLevel||1; this.liveLevel = s.liveLevel||1; this.liveMode = s.liveMode||false;
            this.liveTestMode = s.liveTestMode||false; this.userCoins = s.userCoins||[];
            this.selectedIntraExchanges = s.selectedIntraExchanges?new Set(s.selectedIntraExchanges):new Set();
            this.forexRates = s.forexRates||{}; this.selectedFiats = s.selectedFiats?new Set(s.selectedFiats):new Set();
            this.tradeLedger = s.tradeLedger?s.tradeLedger.slice(-50):[];
            this.liveTradeHistory = s.liveTradeHistory?s.liveTradeHistory.slice(-20):[];
            this.proxyMode = s.proxyMode||'direct'; this.customProxyUrl = s.customProxyUrl||'';
            this.execPath = s.execPath||'/execute';
            this.basketHoldings = s.basketHoldings||{}; this.acquisitionPaths = s.acquisitionPaths||{};
            this.batchHistory = s.batchHistory?s.batchHistory.slice(-20):[];
            this.coinExchangeList = s.coinExchangeList||['QUANTM_DEX'];
            this.stats.wsReconnects = s.wsReconnects||0;
            this.lastCoinCreateTime = s.lastCoinCreateTime||0;
            this.operationLatency = s.operationLatency?s.operationLatency.slice(-10):[];
            this.testnetsActive = s.testnetsActive||false;
            this.apiKeys = s.apiKeys||{};
            this.coinLevels = s.coinLevels||{};
          }
        }catch(e){}
        document.getElementById('solAddress').value = localStorage.getItem('wallet_sol')||'';
        document.getElementById('ethAddress').value = localStorage.getItem('wallet_eth')||'';
        document.getElementById('pumpToken').value = localStorage.getItem('pumpfun_token')||'';
        document.getElementById('basketInput').value = localStorage.getItem('basket')||'USDT,BTC,ETH,DOGE,SHIB,SOL';
        document.getElementById('pathInput').value = localStorage.getItem('pathDepth')||5;
        document.getElementById('pathSlider').value = document.getElementById('pathInput').value;
        document.getElementById('liveToggle').checked = this.liveMode;
        document.getElementById('liveTestnetToggle').checked = this.liveTestMode;
        document.getElementById('liveTestnetToggle').style.display = this.liveMode?'inline-block':'none';
        document.getElementById('testnetLabel').style.display = this.liveMode?'inline':'none';
        document.getElementById('proxySelect').value = this.proxyMode;
        document.getElementById('corsProxyUrl').value = this.customProxyUrl;
        document.getElementById('execPath').value = this.execPath;
        document.getElementById('walletProxyUrl').value = localStorage.getItem('walletProxyUrl')||'';
        document.getElementById('targetAssetsInput').value = localStorage.getItem('targetAssets')||'';
        document.getElementById('testnetToggle').checked = this.testnetsActive;
        UI.updateProfile(); UI.renderFiatCheckboxes(); UI.onProxyChange(); UI.renderTradeLedger();
        UI.renderLiveTrades(); UI.renderCoinLevels(); UI.applyLevelConstraints();
        updateIntraExCheckboxes(); UI.renderBasketTracker(); UI.renderBatchHistory();
        UI.updateDashboard(); UI.renderLatency();
      },
      save(){
        localStorage.setItem(STORAGE_KEY, JSON.stringify({
          bankroll:this.bankroll, paperMatrix:this.paperMatrix, liveMatrix:this.liveMatrix,
          paperLevel:this.paperLevel, liveLevel:this.liveLevel, liveMode:this.liveMode,
          liveTestMode:this.liveTestMode, userCoins:this.userCoins,
          selectedIntraExchanges:[...this.selectedIntraExchanges], forexRates:this.forexRates,
          selectedFiats:[...this.selectedFiats], tradeLedger:this.tradeLedger.slice(-50),
          liveTradeHistory:this.liveTradeHistory.slice(-20), proxyMode:this.proxyMode,
          customProxyUrl:this.customProxyUrl, execPath:this.execPath,
          basketHoldings:this.basketHoldings, acquisitionPaths:this.acquisitionPaths,
          batchHistory:this.batchHistory.slice(-20), coinExchangeList:this.coinExchangeList,
          wsReconnects:this.stats.wsReconnects, lastCoinCreateTime:this.lastCoinCreateTime,
          operationLatency:this.operationLatency.slice(-10), testnetsActive:this.testnetsActive,
          apiKeys:this.apiKeys, coinLevels:this.coinLevels
        }));
        localStorage.setItem('wallet_sol', document.getElementById('solAddress').value);
        localStorage.setItem('wallet_eth', document.getElementById('ethAddress').value);
        localStorage.setItem('pumpfun_token', document.getElementById('pumpToken').value);
        localStorage.setItem('basket', document.getElementById('basketInput').value);
        localStorage.setItem('pathDepth', document.getElementById('pathInput').value);
        localStorage.setItem('walletProxyUrl', document.getElementById('walletProxyUrl').value);
        localStorage.setItem('targetAssets', document.getElementById('targetAssetsInput').value);
      },
      saveWallet(){ this.save(); },
      savePumpToken(){ this.save(); },
      addTradeToLedger(opp,size,netProfit){
        this.tradeLedger.unshift({time:new Date().toISOString(),path:opp.path.join(' → '),size,profit:netProfit,type:opp.type,live:this.liveMode,testnet:this.liveTestMode});
        if(this.tradeLedger.length>50)this.tradeLedger.length=50;
        this.save(); UI.renderTradeLedger(); UI.updateDashboard();
      },
      addLiveTrade(opp,size,netProfit,txHash){
        this.liveTradeHistory.unshift({time:new Date().toISOString(),path:opp.path.join(' → '),size,profit:netProfit,txHash,status:'confirmed',testnet:this.liveTestMode});
        if(this.liveTradeHistory.length>20)this.liveTradeHistory.length=20;
        this.save(); UI.renderLiveTrades();
      },
      recordBasketPurchase(asset,amount,pathDescription){
        if(!this.basketHoldings[asset])this.basketHoldings[asset]=0;
        this.basketHoldings[asset]+=amount;
        if(!this.acquisitionPaths[asset])this.acquisitionPaths[asset]=[];
        this.acquisitionPaths[asset].push({amount,path:pathDescription||'unknown',time:new Date().toISOString()});
        this.save(); UI.renderBasketTracker();
      },
      addBatchHistory(entry){
        this.batchHistory.unshift(entry);
        if(this.batchHistory.length>20)this.batchHistory.length=20;
        this.save(); UI.renderBatchHistory(); UI.updateDashboard();
      },
      getAssetPrice(asset){
        const stableTargets=['USDT','USD','USDC','GUSD','BUSD'];
        for(const t of stableTargets){const pair=this.allPairs.find(p=>p.base===asset&&p.target===t);if(pair)return pair.bidPrice||pair.price*0.999;}
        const anyPair=this.allPairs.find(p=>p.base===asset);
        if(anyPair){const price=anyPair.bidPrice||anyPair.price*0.999;if(!stableTargets.includes(anyPair.target)){const tp=this.getAssetPrice(anyPair.target);if(tp>0)return price*tp;}return price;}
        return 0;
      },
      computePurchasePower(){this.purchasePower={};if(this.bankroll<=0)return;const prices={};for(const pair of this.allPairs){if(!pair.base||!pair.target)continue;const ask=pair.askPrice||pair.price*1.001;if(!prices[pair.base]||ask<prices[pair.base])prices[pair.base]=ask;}for(const[asset,price]of Object.entries(prices)){if(price>0)this.purchasePower[asset]=this.bankroll/price;}for(const stable of['USDT','USD','USDC','GUSD','BUSD']){if(!this.purchasePower[stable])this.purchasePower[stable]=this.bankroll;}},
      getTargetAssets(){const raw=document.getElementById('targetAssetsInput')?.value.trim();if(raw)return raw.split(',').map(s=>s.trim().toUpperCase()).filter(Boolean);return document.getElementById('basketInput').value.split(',').map(s=>s.trim().toUpperCase()).filter(Boolean);},
      validateEdge(edge){return edge&&edge.rate>0&&edge.rate<1e6&&isFinite(edge.rate);},
      validateCycle(edges){let p=1;for(const e of edges){if(!this.validateEdge(e))return false;p*=e.rate;}return p>0.5&&p<100;},
      getMaxCoinExchanges(){return Math.min(1+Math.floor(this.level/3),8);},
      getCoinCooldown(){if(this.level<5)return Infinity;return Math.max(60,300-(this.level-5)*30);},
      getPullCooldown(){if(this.level<=3)return 15000;if(this.level<=6)return 12000;if(this.level<=9)return 9000;return 6000;},
      getLiveScanInterval(){if(this.level<2)return 60000;if(this.level<5)return 45000;if(this.level<8)return 30000;if(this.level<10)return 15000;return 10000;},
      startAutoForex(){if(this.forexInterval)clearInterval(this.forexInterval);if(this.level>=3&&this.selectedFiats.size>0){document.getElementById('forexAutoStatus').textContent='🔄 Auto (5min)';this.forexInterval=setInterval(()=>{if(!document.getElementById('scanBtn').disabled)fetchForexRates();},300000);}else{document.getElementById('forexAutoStatus').textContent='';}},
      allocateIndexFund(profit){const pct=parseFloat(document.getElementById('indexFundPercent')?.value||5)/100;if(pct<=0||profit<=0||this.userCoins.length===0)return;const amount=profit*pct;if(amount<=0||this.bankroll<amount)return;this.bankroll-=amount;const totalWeight=this.userCoins.reduce((sum,c)=>sum+(this.coinLevels[c.symbol]||1),0);let r=Math.random()*totalWeight;for(const coin of this.userCoins){const w=this.coinLevels[coin.symbol]||1;r-=w;if(r<=0){const price=this.getAssetPrice(coin.symbol);if(price>0){const qty=amount/price;this.recordBasketPurchase(coin.symbol,qty,'Index Fund (weighted)');}return;}}},
      addCoinXP(symbol,xp){if(!this.coinLevels[symbol])this.coinLevels[symbol]=1;this.coinLevels[symbol]+=xp;this.save();UI.renderCoinLevels();}
    };

    // ── Logging & helpers ────────────────────────────────
    function log(msg,type='info'){const t=new Date().toLocaleTimeString();const el=document.getElementById('logs');if(!el)return;const c=type==='error'?'#ff4444':type==='success'?'var(--green)':'inherit';const entry=`<div style="color:${c}">[${t}] ${msg}</div>`;if(State.pauseLogs){State.logBuffer.push(entry);if(State.logBuffer.length>50)State.logBuffer.shift();}else{while(State.logBuffer.length>0){el.innerHTML=State.logBuffer.shift()+el.innerHTML;}el.innerHTML=entry+el.innerHTML;}}
    function toggleLogs(){const e=document.getElementById('logs');e.style.display=e.style.display==='none'?'block':'none';}
    function toggleSection(id){const e=document.getElementById(id);e.style.display=e.style.display==='none'?'block':'none';}
    function toggleTestnets(){State.testnetsActive=document.getElementById('testnetToggle').checked;rebuildExchangeDefinitions();State.save();log(`🖱️ Testnets: ${State.testnetsActive?'ON':'OFF'}`);}
    let logsPaused = false;
    function togglePauseLogs(){logsPaused=document.getElementById('pauseLogsToggle').checked;log(`🖱️ Pause Logs: ${logsPaused?'ON':'OFF'}`);}

    // ── Network / Proxy ───────────────────────────────────
    const CORS_OK_EXCHANGES=new Set(['okx','coinbase','binance','kucoin','gemini','bitstamp','kraken','dexscreener_eth','dexscreener_bsc','dexscreener_polygon','dexscreener_arb','dexscreener_sol','coingecko','coinpaprika','coinlore']);
    const BUILTIN_PROXIES=['https://corsproxy.io/?','https://api.allorigins.win/raw?url=']; let currentProxyIndex=0;
    function getEffectiveProxyUrl(){if(State.proxyMode==='custom'){const c=(document.getElementById('corsProxyUrl').value||'').trim();if(c&&!c.includes('placeholder'))return c;return null;}if(State.proxyMode==='builtin')return BUILTIN_PROXIES[currentProxyIndex];return null;}
    function rotateProxy(){currentProxyIndex=(currentProxyIndex+1)%BUILTIN_PROXIES.length;UI.updateProxyStatus();}
    async function smartFetch(url,options={},isCorsSafe=false){if(isCorsSafe||State.proxyMode==='direct'){try{const r=await fetch(url,options);if(r.ok)return r;if(r.status>=400)throw new Error('HTTP '+r.status);}catch(e){}}const proxy=getEffectiveProxyUrl();if(proxy){try{const r=await fetch(proxy+encodeURIComponent(url),options);if(!r.ok)throw new Error('Proxy HTTP '+r.status);const text=await r.text();if(text.startsWith('<')||text.includes('corsdemo'))throw new Error('Non-JSON');try{return new Response(JSON.stringify(JSON.parse(text)),{status:200,headers:{'Content-Type':'application/json'}});}catch{return new Response(text,{status:200,headers:{'Content-Type':'text/plain'}});}}catch(e){rotateProxy();}}throw new Error('All fetch attempts exhausted');}

    // ── Exchange definitions and parsers ──────────────────
    const KNOWN_QUOTES = ['USDT','USDC','BUSD','GUSD','USD','BTC','ETH','BNB','SOL','EUR','GBP','JPY','KRW','AUD','CAD','CHF','RUB','INR','TRY','BRL','IDR','DAI','SGD','PLN','UAH','AED','BETH','ZEC','ZRX','RAY','STRK','MATIC','DOT','TRB','TON','PI','LTC','XRP','SHIB','DOGE','BONK','PEPE','FLOKI','WIN','SATS','NEIRO','CAT','DUCK','BOME','OMI','DEGEN','NOT','MEME','TOSHI','MEW','HMSTR','XCHNG','WBNB','RNDR','LINK','JITOSOL','LINEA','HYPE','PNUT','POL','TRUMP','POPCAT','CTX','JUP','GALA','FTM','FET','SAND','GRT','CRV','LTC','XTZ','SUI','XCH','AVAX','WIF','UNI','FIL','STX','OP','TON','LINK','LPT','ENS','WLFI','ZEC','PENGU','APE','GOAT','MOODENG','MANA','INJ','ATOM','AAVE','TRX','SKY','CHZ','SEI','ZETA','ARB','XDC','BONK','PEPE','SHIB','FLR','VIRTUAL','NEAR','ADA','HBAR','API3','STORJ','IMX','LDO','MON','BCH','PUMP','MASK','OFC','COMP','JUP','DOT','USDG','BAT','BABYDOGE','ALGO','RLUSD','TRAC','SKL','CTSI','MEW','CXT','PYTH','KITE','DIRT','WOW','ARRR','TRON','MEME'];
    KNOWN_QUOTES.sort((a,b)=>b.length-a.length);
    function parsePairSymbol(rawSymbol){const s=(rawSymbol||'').toUpperCase().replace(/[^A-Z0-9]/g,'');if(!s)return null;for(const q of KNOWN_QUOTES){if(s.endsWith(q)&&s.length>q.length){const b=s.slice(0,s.length-q.length);if(b.length>=1&&b!==q)return{base:b,target:q};}}const p=s.split(/[_-]/);if(p.length>=2)return{base:p[0],target:p.slice(1).join('_')};return null;}
    const exchangeDefs = [
      {key:'okx',name:'OKX',url:'https://www.okx.com/api/v5/market/tickers?instType=SPOT',parser:'okx'},
      {key:'coinbase',name:'Coinbase',url:'https://api.exchange.coinbase.com/products',parser:'coinbase'},
      {key:'binance',name:'Binance',url:'https://api.binance.com/api/v3/ticker/24hr',parser:'binance'},
      {key:'kucoin',name:'KuCoin',url:'https://api.kucoin.com/api/v1/market/allTickers',parser:'kucoin'},
      {key:'bybit',name:'Bybit',url:'https://api.bybit.com/v5/market/tickers?category=spot',parser:'bybit'},
      {key:'gate',name:'Gate.io',url:'https://api.gateio.ws/api/v4/spot/tickers',parser:'gate'},
      {key:'mexc',name:'MEXC',url:'https://api.mexc.com/api/v3/ticker/24hr',parser:'mexc'},
      {key:'kraken',name:'Kraken',url:'https://api.kraken.com/0/public/Ticker?pair=ALL',parser:'kraken'},
      {key:'bitstamp',name:'Bitstamp',url:'https://www.bitstamp.net/api/v2/ticker/',parser:'bitstamp'},
      {key:'indodax',name:'Indodax',url:'https://indodax.com/api/tickers',parser:'indodax'},
      {key:'yobit',name:'Yobit',url:'https://yobit.net/api/3/info',parser:'yobit'},
      {key:'pumpfun',name:'Pump.fun',url:'https://frontend-api.pump.fun/coins?offset=0&limit=100&sort=created_timestamp&order=DESC',parser:'pumpfun',auth:true},
      {key:'poloniex',name:'Poloniex',url:'https://api.poloniex.com/markets/ticker24h',parser:'poloniex'},
      {key:'huobi',name:'Huobi',url:'https://api.huobi.pro/market/tickers',parser:'huobi'},
      {key:'gemini',name:'Gemini',url:'https://api.gemini.com/v1/pricefeed',parser:'gemini'},
      {key:'ascendex',name:'AscendEX',url:'https://ascendex.com/api/pro/v1/ticker',parser:'ascendex'},
      {key:'digifinex',name:'Digifinex',url:'https://openapi.digifinex.com/v3/ticker',parser:'digifinex'},
      {key:'bittrex',name:'Bittrex',url:'https://api.bittrex.com/v3/markets/tickers',parser:'bittrex'},
      {key:'crypto.com',name:'Crypto.com',url:'https://api.crypto.com/v2/public/get-ticker',parser:'cryptocom'},
      {key:'dexscreener_eth',name:'DexScreener ETH',url:'https://api.dexscreener.com/latest/dex/search?q=ETH',parser:'dexscreener'},
      {key:'dexscreener_bsc',name:'DexScreener BSC',url:'https://api.dexscreener.com/latest/dex/search?q=BNB',parser:'dexscreener'},
      {key:'dexscreener_polygon',name:'DexScreener Polygon',url:'https://api.dexscreener.com/latest/dex/search?q=MATIC',parser:'dexscreener'},
      {key:'dexscreener_arb',name:'DexScreener Arbitrum',url:'https://api.dexscreener.com/latest/dex/search?q=ARB',parser:'dexscreener'},
      {key:'dexscreener_sol',name:'DexScreener Solana',url:'https://api.dexscreener.com/latest/dex/search?q=SOL',parser:'dexscreener'},
      {key:'dexscreener_uni',name:'Uniswap V2 (DexScreener)',url:'https://api.dexscreener.com/latest/dex/search?q=UNI',parser:'dexscreener'},
      {key:'coingecko',name:'CoinGecko',url:'https://api.coingecko.com/api/v3/coins/markets?vs_currency=usd&order=market_cap_desc&per_page=250&page=1',parser:'coingecko'},
      {key:'coinlore',name:'CoinLore',url:'https://api.coinlore.net/api/tickers/',parser:'coinlore'},
      {key:'coinpaprika',name:'CoinPaprika',url:'https://api.coinpaprika.com/v1/tickers',parser:'coinpaprika'},
      {key:'coincap',name:'CoinCap',url:'https://api.coincap.io/v2/assets?limit=100',parser:'coincap'}
    ];
    const testnetExchangeDefs = [
      {key:'binance_test',name:'Binance Testnet',url:'https://testnet.binance.vision/api/v3/ticker/24hr',parser:'binance'},
      {key:'okx_demo',name:'OKX Demo',url:'https://www.okx.com/api/v5/market/tickers?instType=SPOT',parser:'okx'},
      {key:'uniswap_sepolia',name:'Uniswap Sepolia',url:'https://api.thegraph.com/subgraphs/name/uniswap/uniswap-v3-sepolia',parser:'dexscreener'},
      {key:'pancake_test',name:'PancakeSwap Testnet',url:'https://pancake.kiemtienonline360.com/api/v1/ticker/24hr',parser:'binance'},
      {key:'sushi_test',name:'SushiSwap Testnet',url:'https://raw.githubusercontent.com/sushiswap/...',parser:'dexscreener'}
    ];
    function rebuildExchangeDefinitions(){
      exchangeDefs.forEach(d=>{State.exchanges[d.key]={name:d.name,status:'offline',pairs:[],url:d.url,parser:d.parser,auth:d.auth||false,wsStatus:'off'};});
      if(State.testnetsActive){testnetExchangeDefs.forEach(d=>{State.exchanges[d.key]={name:d.name,status:'offline',pairs:[],url:d.url,parser:d.parser,auth:d.auth||false,wsStatus:'off'};});}
    }
    async function loadApi(defKey){
      const ex=State.exchanges[defKey]; const isCors=CORS_OK_EXCHANGES.has(defKey);
      try{
        let h={}; if(ex.auth){const t=document.getElementById('pumpToken').value.trim();if(t)h={'Authorization':'Bearer '+t};}
        const r=await smartFetch(ex.url,{headers:h},isCors); if(!r.ok)throw new Error('HTTP '+r.status);
        const d=await r.json(); let pairs=[];
        switch(ex.parser){
          case'okx':pairs=(d.data||[]).slice(0,600).map(t=>{const p=t.instId.split('-');if(p.length!==2)return null;const pr=parseFloat(t.last)||0,v=(parseFloat(t.volCcy24h)||0)*pr;return{base:p[0],target:p[1],price:pr,volume:v,liquidity:v,bidPrice:parseFloat(t.bidPx)||pr*0.999,askPrice:parseFloat(t.askPx)||pr*1.001,exchange:defKey,exchangeType:'cex'};}).filter(Boolean);break;
          case'coinbase':pairs=(Array.isArray(d)?d:[]).slice(0,300).map(p=>{const pr=parseFloat(p.price)||1,v=(parseFloat(p.volume)||0)*pr;return{base:p.base_currency,target:p.quote_currency,price:pr,volume:v,liquidity:v,bidPrice:pr*0.998,askPrice:pr*1.002,exchange:defKey,exchangeType:'cex'};}).filter(p=>p.price>0);break;
          case'binance':pairs=(Array.isArray(d)?d:[]).slice(0,600).map(t=>{const pr=parseFloat(t.lastPrice)||0,v=(parseFloat(t.quoteVolume)||0)*pr;const ps=parsePairSymbol(t.symbol||'');if(!ps)return null;return{base:ps.base,target:ps.target,price:pr,volume:v,liquidity:v,bidPrice:parseFloat(t.bidPrice)||pr*0.999,askPrice:parseFloat(t.askPrice)||pr*1.001,exchange:defKey,exchangeType:'cex'};}).filter(p=>p&&p.price>0&&p.base&&p.base!==p.target);break;
          case'kucoin':pairs=(d?.data?.ticker||[]).slice(0,500).map(t=>{const pr=parseFloat(t.last)||0,v=(parseFloat(t.volValue)||0)*pr;const ps=parsePairSymbol(t.symbol||'');if(!ps)return null;return{base:ps.base,target:ps.target,price:pr,volume:v,liquidity:v,bidPrice:parseFloat(t.buy)||pr*0.999,askPrice:parseFloat(t.sell)||pr*1.001,exchange:defKey,exchangeType:'cex'};}).filter(p=>p&&p.price>0&&p.base);break;
          case'kraken':{const result=d?.result||{};pairs=Object.keys(result).slice(0,300).map(k=>{const t=result[k];const pr=parseFloat(t.c?.[0])||0,v=(parseFloat(t.v?.[1])||0)*pr;const ps=parsePairSymbol(k);if(!ps)return null;return{base:ps.base,target:ps.target,price:pr,volume:v,liquidity:v,bidPrice:parseFloat(t.b?.[0])||pr*0.999,askPrice:parseFloat(t.a?.[0])||pr*1.001,exchange:defKey,exchangeType:'cex'};}).filter(p=>p&&p.price>0);}break;
          case'bitstamp':pairs=(Array.isArray(d)?d:[]).slice(0,250).map(t=>{const pr=parseFloat(t.last)||0,v=(parseFloat(t.volume)||0)*pr;const ps=(t.pair||'').split('/');return{base:ps[0]||'',target:ps[1]||'USD',price:pr,volume:v,liquidity:v,bidPrice:parseFloat(t.bid)||pr*0.999,askPrice:parseFloat(t.ask)||pr*1.001,exchange:defKey,exchangeType:'cex'};}).filter(p=>p.price>0&&p.base);break;
          case'gemini':pairs=(Array.isArray(d)?d:[]).map(t=>{const ps=parsePairSymbol(t.pair||t.symbol||'');if(!ps)return null;const pr=parseFloat(t.price)||0;return{base:ps.base,target:ps.target,price:pr,volume:0,liquidity:pr*100000,bidPrice:pr*0.998,askPrice:pr*1.002,exchange:defKey,exchangeType:'cex'};}).filter(p=>p&&p.price>0&&p.base!==p.target&&p.liquidity>=50);break;
          case'dexscreener':{const raw=d?.pairs||[];pairs=raw.slice(0,400).map(p=>{const pr=parseFloat(p.priceUsd)||0,liq=p.liquidity?.usd||0;const sp=liq>0?Math.max(0.003,Math.min(0.05,5000/liq)):0.03;return{base:p.baseToken?.symbol||'?',target:p.quoteToken?.symbol||'ETH',price:pr,volume:p.volume?.h24||0,liquidity:liq,bidPrice:pr*(1-sp/2),askPrice:pr*(1+sp/2),exchange:defKey,exchangeType:'dex'};}).filter(p=>p.base!=='?'&&p.price>0);}break;
          case'coingecko':pairs=(Array.isArray(d)?d:[]).slice(0,250).map(c=>({base:(c.symbol||'').toUpperCase(),target:'USD',price:c.current_price||0,volume:c.total_volume||0,liquidity:c.market_cap||0,bidPrice:(c.current_price||0)*0.999,askPrice:(c.current_price||0)*1.001,exchange:defKey,exchangeType:'info'})).filter(p=>p.price>0);break;
          default:pairs=[];
        }
        pairs=pairs.filter(p=>p&&p.base&&p.target&&p.base!==p.target&&p.price>0&&p.price<1e15);
        ex.pairs=pairs; ex.status='online'; log(`${ex.name}: ${pairs.length}p`,'success');
      }catch(e){
        if(['pumpfun','pumpfun_dev','uniswap_sepolia','sushi_test'].includes(defKey)){
          try{const fr=await smartFetch('https://api.dexscreener.com/latest/dex/search?q=ETH',{},true);const fd=await fr.json();
            ex.pairs=(fd?.pairs||[]).slice(0,400).map(p=>{const pr=parseFloat(p.priceUsd)||0,liq=p.liquidity?.usd||0;const sp=liq>0?Math.max(0.003,Math.min(0.05,5000/liq)):0.03;return{base:p.baseToken?.symbol||'?',target:p.quoteToken?.symbol||'ETH',price:pr,volume:p.volume?.h24||0,liquidity:liq,bidPrice:pr*(1-sp/2),askPrice:pr*(1+sp/2),exchange:defKey,exchangeType:'dex'};}).filter(p=>p.base!=='?'&&p.price>0);
            ex.status='online';log(`DEX fb: ${ex.pairs.length}p`,'success');return;
          }catch(fb){}
        }
        ex.status='offline';ex.pairs=[];log(`${ex.name}: ${e.message}`,'error');if(State.proxyMode==='builtin')rotateProxy();
      }
    }
    async function initSystem(){
      log('🎰 Initializing...'); updateStatus('🔄 LOADING...'); UI.updateProxyStatus();
      const start=performance.now();
      await Promise.allSettled(exchangeDefs.map(d=>loadApi(d.key)));
      if(State.testnetsActive){await Promise.allSettled(testnetExchangeDefs.map(d=>loadApi(d.key)));}
      State.allPairs=Object.values(State.exchanges).flatMap(e=>e.pairs);
      State.userCoins.forEach(c=>{const q=c.quote||'USDT';State.allPairs.push({base:c.symbol,target:q,price:c.price,volume:c.liq*0.3,liquidity:c.liq,bidPrice:c.price*0.95,askPrice:c.price*1.05,exchange:c.exchange||'QUANTM_DEX',exchangeType:'dex'});});
      State.stats.totalPairs=State.allPairs.length; State.computePurchasePower();
      updateIntraExCheckboxes(); buildGraph(); buildTriangles(); displayLowValue();
      updateExchangeDisplay(); updateStats();
      const on=Object.values(State.exchanges).filter(e=>e.status==='online').length;
      if(on>0){document.getElementById('scanBtn').disabled=false; updateStatus(`✅ READY · ${on}/${exchangeDefs.length+(State.testnetsActive?testnetExchangeDefs.length:0)} online`);}
      else updateStatus('❌ NO EXCHANGES ONLINE');
      State.operationLatency.push({op:'INIT',duration:Math.round(performance.now()-start)}); UI.renderLatency();
      State.save();
      if(!Object.keys(State.forexRates).length&&State.selectedFiats.size){log('Auto‑fetching forex…');await fetchForexRates();}
      State.startAutoForex();
      if(document.getElementById('graphSlotContainer').style.display==='block'){if(!State.graphRenderer)State.graphRenderer=new GraphRenderer('graphNetwork');State.graphRenderer.buildFromGraph(State.graph,State.opportunities,State.purchasePower,State.highlightedPaths,State.conflictEdges||new Set());}
      UI.applyLevelConstraints();
    }
    function updateStatus(m){document.getElementById('mainStatus').textContent=m;}
    function getGraphPairs(){const m=document.getElementById('arbMode').value;if(m==='intra')return[...State.selectedIntraExchanges].flatMap(k=>State.exchanges[k]?.pairs||[]);return Object.values(State.exchanges).filter(e=>e.status==='online'&&e.parser!=='coingecko'&&e.parser!=='coinlore').flatMap(e=>e.pairs);}
    function applyWsCache(p){const c=State.wsTickers[p.exchange];if(c){const k=`${p.base}${p.target}`.toUpperCase();const t=c[k];if(t)return{...p,bidPrice:t.bid||p.bidPrice,askPrice:t.ask||p.askPrice};}return p;}
    function sanitizeRate(r){if(!isFinite(r)||r<=0)return 0;if(r>1e12)return 1e12;if(r<1e-15)return 1e-15;return r;}
    function buildGraph(){State.graph={};const pairs=getGraphPairs().map(applyWsCache);pairs.forEach(p=>{if(p.liquidity<50)return;if(!p.base||!p.target||p.base===p.target)return;if(!State.graph[p.base])State.graph[p.base]={};if(!State.graph[p.target])State.graph[p.target]={};const r1=sanitizeRate(p.bidPrice),r2=sanitizeRate(1/p.askPrice);if(r1>0)State.graph[p.base][p.target]={rate:r1,weight:-Math.log(r1),volume:p.volume,liquidity:p.liquidity,exchange:p.exchange,exchangeType:p.exchangeType,short:false};if(r2>0)State.graph[p.target][p.base]={rate:r2,weight:-Math.log(r2),volume:p.volume,liquidity:p.liquidity,exchange:p.exchange,exchangeType:p.exchangeType,short:true};});State.stats.graphNodes=Object.keys(State.graph).length;State.stats.graphEdges=Object.values(State.graph).reduce((s,o)=>s+Object.keys(o).length,0);}
    function buildTriangles(){State.triangles=[];const ns=Object.keys(State.graph);const seen=new Set();for(let i=0;i<Math.min(ns.length,150);i++){const A=ns[i];const nA=Object.keys(State.graph[A]||{});for(const B of nA){const nB=Object.keys(State.graph[B]||{});for(const C of nB){if(State.graph[C]?.[A]){const canon=[A,B,C].sort().join('|');if(!seen.has(canon)){seen.add(canon);State.triangles.push([A,B,C]);}}}}}State.stats.triangleCount=State.triangles.length;}
    function displayLowValue(){const all=State.allPairs.filter(p=>p.price>0);const fmt=p=>{const u=getUsdPrice(p).toExponential(4);let t='';if(getUsdPrice(p)<1e-15)t='PLANCK';else if(getUsdPrice(p)<1e-12)t='FEMTO';else if(getUsdPrice(p)<1e-9)t='PICO';return`<div>${p.base} $${u} <span class="tier-badge tier-${t.toLowerCase()}">${t}</span></div>`;};document.getElementById('picoValue').innerHTML=all.filter(p=>getUsdPrice(p)<1e-9&&getUsdPrice(p)>=1e-12).slice(0,25).map(fmt).join('')||'None';document.getElementById('femtoValue').innerHTML=all.filter(p=>getUsdPrice(p)<1e-12&&getUsdPrice(p)>=1e-15).slice(0,25).map(fmt).join('')||'None';document.getElementById('planckValue').innerHTML=all.filter(p=>getUsdPrice(p)<1e-15).slice(0,25).map(fmt).join('')||'None';}

    function scanTriangular(minP=0.0001){const opps=[],inv=1000;const mode=document.getElementById('arbMode').value;State.triangles.forEach(([A,B,C])=>{const orders=[[A,B,C,A],[B,C,A,B],[C,A,B,C]];for(const[s,m1,m2,e]of orders){const e1=State.graph[s]?.[m1],e2=State.graph[m1]?.[m2],e3=State.graph[m2]?.[e];if(!e1||!e2||!e3)continue;if(!State.validateCycle([e1,e2,e3]))continue;if(mode==='intra'){const exs=new Set([e1.exchange,e2.exchange,e3.exchange]);if(exs.size!==1||!State.selectedIntraExchanges.has(e1.exchange))continue;}const final=inv*e1.rate*e2.rate*e3.rate,profit=final-inv,pct=(profit/inv)*100;if(pct>=minP&&pct<50){const ms=Math.min(e1.liquidity,e2.liquidity,e3.liquidity)*0.05;opps.push({type:'triangular',path:[s,m1,m2,e],profitPercent:pct,actualProfit:toUsd((ms/inv)*profit,s),maxTradeSize:toUsd(ms,s),edges:[e1,e2,e3]});}}});return opps;}
    function bellmanFord(start,depth=5){const cs=Object.keys(State.graph);if(!cs.includes(start))return[];const mode=document.getElementById('arbMode').value;const dist={},pred={};cs.forEach(c=>{dist[c]=Infinity;pred[c]=null;});dist[start]=0;for(let i=0;i<Math.min(depth-1,cs.length-1);i++){let upd=false;for(const u of cs){const nb=State.graph[u];if(!nb)continue;for(const v in nb){const w=nb[v].weight;if(dist[u]!==Infinity&&dist[u]+w<dist[v]){if(mode==='intra'&&!State.selectedIntraExchanges.has(nb[v].exchange))continue;dist[v]=dist[u]+w;pred[v]=u;upd=true;}}}if(!upd)break;}const opps=[];const target=State.getTargetAssets();for(const u of cs){const nb=State.graph[u];if(!nb)continue;for(const v in nb){if(dist[u]!==Infinity&&dist[u]+nb[v].weight<dist[v]){const cyc=(()=>{const c=[v];let cur=v;const vis=new Set();vis.add(v);for(let i=0;i<depth;i++){cur=pred[cur];if(!cur)return null;c.push(cur);if(cur===start)return c;if(vis.has(cur))return null;vis.add(cur);}return null;})();if(cyc&&cyc[0]===start&&target.includes(start)){let amt=1000;const edges=[];let tl=Infinity;for(let i=0;i<cyc.length-1;i++){const e=State.graph[cyc[i]]?.[cyc[i+1]];if(!e)break;amt*=e.rate;edges.push(e);tl=Math.min(tl,e.liquidity);}const le=State.graph[cyc[cyc.length-1]]?.[cyc[0]];if(le&&tl>=50&&State.validateCycle([...edges,le])){amt*=le.rate;edges.push(le);tl=Math.min(tl,le.liquidity);const p=amt-1000,pc=(p/1000)*100;if(pc>=0.0001&&pc<50){const ms=Math.min(...edges.map(e=>e.liquidity))*0.05;opps.push({type:'bellman-ford',path:[...cyc,cyc[0]],profitPercent:pc,actualProfit:toUsd((ms/1000)*p,start),maxTradeSize:toUsd(ms,start),edges});}}}}}}return opps;}
    function connectAllWebSockets(){log('📡 Connecting WebSockets (auto‑reconnect)...');const createWS=(url,onMessage,exKey,retryDelay=5000)=>{const connect=()=>{try{const ws=new WebSocket(url);ws.onopen=()=>{log(`📡 ${exKey} WS connected`,'success');State.exchanges[exKey].wsStatus='live';if(exKey==='okx')ws.send(JSON.stringify({op:'subscribe',args:[{channel:'tickers',instType:'SPOT'}]}));if(exKey==='bybit')ws.send(JSON.stringify({op:'subscribe',args:['tickers.BTCUSDT']}));if(exKey==='kraken')ws.send(JSON.stringify({event:'subscribe',pair:['XBT/USD','ETH/USD'],subscription:{name:'ticker'}}));if(exKey==='coinbase')ws.send(JSON.stringify({type:'subscribe',product_ids:['BTC-USD','ETH-USD'],channels:['ticker']}));updateExchangeDisplay();};ws.onmessage=onMessage;ws.onclose=()=>{log(`📡 ${exKey} WS disconnected, reconnecting in ${retryDelay/1000}s…`,'warning');State.exchanges[exKey].wsStatus='reconnecting';State.stats.wsReconnects++;UI.updateProfile();updateExchangeDisplay();setTimeout(connect,retryDelay);};ws.onerror=()=>{ws.close();};State.wsConnections[exKey]=ws;}catch(e){setTimeout(connect,retryDelay);}};connect();};createWS('wss://ws.okx.com:8443/ws/v5/public',e=>{try{const d=JSON.parse(e.data);if(d.data)d.data.forEach(t=>{const p=t.instId.split('-');if(p.length===2){const k=`${p[0]}${p[1]}`.toUpperCase();if(!State.wsTickers.okx)State.wsTickers.okx={};State.wsTickers.okx[k]={bid:parseFloat(t.bidPx),ask:parseFloat(t.askPx)};}});State.stats.wsBytes+=e.data.length;}catch{}},'okx');createWS('wss://stream.binance.com:9443/ws/!ticker@arr',e=>{try{const d=JSON.parse(e.data);if(Array.isArray(d))d.forEach(t=>{const ps=parsePairSymbol(t.s);if(!ps)return;const k=`${ps.base}${ps.target}`.toUpperCase();if(!State.wsTickers.binance)State.wsTickers.binance={};State.wsTickers.binance[k]={bid:parseFloat(t.b),ask:parseFloat(t.a)};});State.stats.wsBytes+=e.data.length;}catch{}},'binance');updateExchangeDisplay();setInterval(updateStats,2000);}
    function toggleLiveScan(){if(State.liveScanActive){clearInterval(State.liveScanInterval);State.liveScanActive=false;document.getElementById('liveScanBtn').classList.remove('live');document.getElementById('liveScanBtn').textContent='🔄 LIVE';log('🖱️ Live off');}else{State.liveScanActive=true;document.getElementById('liveScanBtn').classList.add('live');document.getElementById('liveScanBtn').textContent='⏹️ STOP';log('🖱️ Live on');runFullScan();const interval=State.getLiveScanInterval();State.liveScanInterval=setInterval(()=>{if(!document.getElementById('scanBtn').disabled)runFullScan();},interval);log(`🖱️ Live scan interval: ${interval/1000}s`);}}
    async function runFullScan(sil=false,useBellman=false){const start=performance.now();const depth=parseInt(document.getElementById('pathInput').value)||5;if(!sil)log(`Scan depth ${depth}…`);buildGraph();buildTriangles();State.opportunities={mega:[],triangular:[],bellman:[],suspicious:[]};const tri=scanTriangular();const bf=[];if(useBellman||(!sil&&document.getElementById('bellmanToggle')?.checked&&State.level>=5)){const minProfit=parseFloat(document.getElementById('minProfitInput')?.value)||0.0001;const targets=State.getTargetAssets();let found=false;const fallback=document.getElementById('fallbackCheck')?.checked;for(const t of targets){if(State.graph[t]){const res=bellmanFord(t,depth);if(res.length&&res.some(o=>o.profitPercent>=minProfit)){bf.push(...res.filter(o=>o.profitPercent>=minProfit));found=true;if(!fallback)break;}}}if(!found&&fallback){for(const t of targets){if(State.graph[t])bf.push(...bellmanFord(t,depth));}}}const all=[...tri,...bf];all.forEach(o=>{if(o.profitPercent>5)State.opportunities.mega.push(o);else if(o.type==='triangular')State.opportunities.triangular.push(o);else State.opportunities.bellman.push(o);});updateStats();if(!sil){['megaOpps','triangularOpps','bellmanOpps','suspiciousOpps'].forEach(id=>{document.getElementById(id).innerHTML='';});State.opportunities.mega.forEach(o=>UI.renderOpp(o,'megaOpps',true));State.opportunities.triangular.forEach(o=>UI.renderOpp(o,'triangularOpps'));State.opportunities.bellman.forEach(o=>UI.renderOpp(o,'bellmanOpps'));updateStatus(`✅ ${all.length} opps`);}const duration=Math.round(performance.now()-start);State.operationLatency.push({op:'SCAN',duration});UI.renderLatency();State.save();if(State.graphRenderer&&document.getElementById('graphSlotContainer').style.display==='block'){State.computePurchasePower();State.graphRenderer.buildFromGraph(State.graph,State.opportunities,State.purchasePower,State.highlightedPaths,State.conflictEdges||new Set());}}
    function updateStats(){document.getElementById('totalPairs').textContent=State.stats.totalPairs;document.getElementById('graphNodes').textContent=State.stats.graphNodes;document.getElementById('graphEdges').textContent=State.stats.graphEdges;document.getElementById('triangleCount').textContent=State.stats.triangleCount;const oc=Object.values(State.opportunities).flat().length;document.getElementById('oppCount').textContent=oc;document.getElementById('megaCount').textContent=State.opportunities.mega.length;document.getElementById('triangularCount').textContent=State.opportunities.triangular.length;document.getElementById('bellmanCount').textContent=State.opportunities.bellman.length;UI.updateProfile();}
    function updateExchangeDisplay(){const c=document.getElementById('exchangeStatus');if(!c)return;c.innerHTML=Object.values(State.exchanges).map(e=>{let cls=e.wsStatus==='live'?'ws':e.wsStatus==='reconnecting'?'reconnecting':e.status==='online'?'online':'';return`<div class="exchange-status"><div class="indicator ${cls}"></div><strong>${e.name}</strong> ${e.pairs.length}p ${e.wsStatus==='reconnecting'?'🔄':''}</div>`;}).join('');}
    function updateIntraExCheckboxes(){const c=document.getElementById('intraExCheckboxes');if(!c)return;const allExs=Object.keys(State.exchanges).filter(k=>State.exchanges[k].parser!=='coingecko'&&State.exchanges[k].parser!=='coinlore');const maxSelect=State.level+2;c.innerHTML=allExs.map(k=>{const online=State.exchanges[k].status==='online';const checked=State.selectedIntraExchanges.has(k)?'checked':'';const disabled=online?'':'disabled';return`<label style="opacity:${online?1:0.5}"><input type="checkbox" value="${k}" ${checked} ${disabled} onchange="toggleIntraEx('${k}')"> ${State.exchanges[k].name}</label>`;}).join('');if(!State.selectedIntraExchanges.size&&allExs.length){const onlineExs=allExs.filter(k=>State.exchanges[k].status==='online');if(onlineExs.length){const largest=onlineExs.sort((a,b)=>State.exchanges[b].pairs.length-State.exchanges[a].pairs.length)[0];State.selectedIntraExchanges.add(largest);updateIntraExCheckboxes();}}}
    function toggleIntraEx(k){if(State.exchanges[k].status!=='online'){log('Offline','warning');return;}if(State.selectedIntraExchanges.has(k)){State.selectedIntraExchanges.delete(k);}else{const max=State.level+2;if(State.selectedIntraExchanges.size>=max){log(`Max ${max}`,'warning');return;}State.selectedIntraExchanges.add(k);}log(`🖱️ Intra: ${k}`);updateIntraExCheckboxes();}
    function selectAllIntra(){const max=State.level+2;State.selectedIntraExchanges.clear();const online=Object.keys(State.exchanges).filter(k=>State.exchanges[k].status==='online'&&State.exchanges[k].parser!=='coingecko');online.slice(0,max).forEach(k=>State.selectedIntraExchanges.add(k));updateIntraExCheckboxes();log(`🖱️ ALL (max ${max})`);}
    function deselectAllIntra(){State.selectedIntraExchanges.clear();updateIntraExCheckboxes();log('🖱️ NONE');}
    function syncBetInput(){document.getElementById('betInput').value=document.getElementById('betSlider').value;}
    function syncBetSlider(){document.getElementById('betSlider').value=document.getElementById('betInput').value;}
    function shareJackpot(){const m=State.opportunities.mega[0];if(m){navigator.clipboard.writeText(`🎰 ${m.profitPercent.toFixed(2)}% arb on QuanTM FOAM!`);log('📤 Copied!','success');}}
    function toggleTheme(){document.body.style.filter=document.body.style.filter==='hue-rotate(180deg)'?'none':'hue-rotate(180deg)';log('🖱️ Theme');}

    // ── Forex ────────────────────────────────────────────
    async function fetchForexRates(){
      const f=[...State.selectedFiats];if(!f.length){log('No fiats selected','warning');return;}
      let success=false;
      try{const r=await smartFetch('https://api.frankfurter.app/latest?from=USD',{},true);const d=await r.json();if(d.rates){State.forexRates={};f.forEach(cur=>{if(d.rates[cur])State.forexRates[cur]=1/d.rates[cur];});success=true;document.getElementById('forexStatus').textContent=`✅ ${Object.keys(State.forexRates).length} rates (Frankfurter)`;log(`Forex: ${Object.keys(State.forexRates).length} from Frankfurter`,'success');}}catch(e){log('Frankfurter failed, trying CoinGecko…','warning');}
      if(!success){try{const url=`https://api.coingecko.com/api/v3/simple/price?ids=bitcoin&vs_currencies=usd,${f.join(',')}`;const r=await smartFetch(url,{},true);const d=await r.json();if(d.bitcoin?.usd){const bu=d.bitcoin.usd;State.forexRates={};f.forEach(cur=>{if(d.bitcoin[cur])State.forexRates[cur]=bu/d.bitcoin[cur];});success=true;document.getElementById('forexStatus').textContent=`✅ ${Object.keys(State.forexRates).length} rates (CoinGecko)`;log(`Forex: ${Object.keys(State.forexRates).length} from CoinGecko`,'success');}}catch(e){log('CoinGecko failed, using cache','error');}}
      if(!success){const fb={RUB:0.012,INR:0.012,EUR:1.08,GBP:1.26,JPY:0.0067,CNY:0.14,KRW:0.00076,AUD:0.64,CAD:0.73,CHF:1.12,AED:0.27,TRY:0.032,BRL:0.18,SGD:0.74,PLN:0.23};State.forexRates={};f.forEach(cur=>{if(fb[cur])State.forexRates[cur]=fb[cur];});document.getElementById('forexStatus').textContent=`✅ ${Object.keys(State.forexRates).length} (cached)`;}
      State.save();displayLowValue();
    }
    function getUsdPrice(p){if(!p)return 0;if(['USDT','USD','USDC','BUSD','GUSD'].includes(p.target))return p.price;const r=State.forexRates[p.target];return r?p.price*r:p.price;}
    function toUsd(a,c){if(!c||['USDT','USD','USDC','BUSD','GUSD'].includes(c))return a;const r=State.forexRates[c];return r?a*r:a;}

    // ── UI Object ──────────────────────────────────────────
    const UI = {
      logButton(label){log(`🖱️ ${label}`);},
      copyLogsRobust(){const el=document.getElementById('logs');if(!el||!el.textContent.trim())return;const text=el.textContent;const textarea=document.createElement('textarea');textarea.value=text;textarea.style.position='fixed';textarea.style.opacity='0';document.body.appendChild(textarea);textarea.select();try{document.execCommand('copy');log('📋 Logs copied!','success');}catch(e){log('❌ Copy failed','error');}document.body.removeChild(textarea);},
      toggleGraphSlot(){const s=document.getElementById('graphSlotContainer');s.style.display=s.style.display==='none'?'block':'none';if(s.style.display==='block'&&State.graph&&Object.keys(State.graph).length){if(!State.graphRenderer)State.graphRenderer=new GraphRenderer('graphNetwork');State.computePurchasePower();State.graphRenderer.buildFromGraph(State.graph,State.opportunities,State.purchasePower,State.highlightedPaths,State.conflictEdges||new Set());}},
      syncPathInput(){document.getElementById('pathInput').value=document.getElementById('pathSlider').value;document.getElementById('slotDepthLabel2').textContent=document.getElementById('pathSlider').value;State.save();},
      syncPathSlider(){document.getElementById('pathSlider').value=document.getElementById('pathInput').value;document.getElementById('slotDepthLabel2').textContent=document.getElementById('pathInput').value;State.save();},
      toggleLiveMode(){State.liveMode=document.getElementById('liveToggle').checked;document.getElementById('modeLabel').textContent=State.liveMode?(State.liveTestMode?'TESTNET':'LIVE'):'PAPER';document.getElementById('liveTestnetToggle').style.display=State.liveMode?'inline-block':'none';document.getElementById('testnetLabel').style.display=State.liveMode?'inline':'none';if(!State.liveMode){State.liveTestMode=false;document.getElementById('liveTestnetToggle').checked=false;}State.save();this.updateProfile();log(`🖱️ Live: ${State.liveMode}`);},
      toggleLiveTestnet(){State.liveTestMode=document.getElementById('liveTestnetToggle').checked;State.save();log(`🖱️ Testnet: ${State.liveTestMode?'ON':'OFF'}`);},
      updateProfile(){
        document.getElementById('userLevel').textContent=State.level;document.getElementById('matrixScore').textContent=State.matrix;
        const n=Math.pow(State.level,2)*10;document.getElementById('nextLevelScore').textContent=n;
        document.getElementById('levelProgress').style.width=Math.min(100,(State.matrix/n)*100)+'%';
        document.getElementById('royalties').textContent='$'+(State.royalties||0).toFixed(2);
        document.getElementById('quantumFundVisible').textContent='$'+(State.qFund||0).toFixed(2);
        document.getElementById('quantumFundLocked').textContent='$'+(State.lFund||0).toFixed(2);
        document.getElementById('bankroll').textContent='$'+State.bankroll.toFixed(2);
        const pnl=State.bankroll-10000;document.getElementById('pnl').textContent=`$${pnl.toFixed(2)} (${((pnl/10000)*100).toFixed(2)}%)`;
        document.getElementById('modeLabel').textContent=State.liveMode?(State.liveTestMode?'TESTNET':'LIVE'):'PAPER';
        document.getElementById('wsReconnects').textContent=State.stats.wsReconnects;
        document.getElementById('myHandle')&&(document.getElementById('myHandle').textContent=playerHandle);
        this.applyLevelConstraints();this.renderPerks();this.updateDashboard();this.renderPlayerList();
      },
      updateDashboard(){
        const trades=State.tradeLedger;const total=trades.length;document.getElementById('totalTrades').textContent=total;
        if(total===0){document.getElementById('winRate').textContent='0%';document.getElementById('bestTrade').textContent='$0.00';document.getElementById('worstTrade').textContent='$0.00';document.getElementById('avgProfit').textContent='$0.00';document.getElementById('totalPL').textContent='$0.00';return;}
        const wins=trades.filter(t=>t.profit>0).length;const profits=trades.map(t=>t.profit);const best=Math.max(...profits),worst=Math.min(...profits);const avg=profits.reduce((a,b)=>a+b,0)/total,totalPL=profits.reduce((a,b)=>a+b,0);
        document.getElementById('winRate').textContent=((wins/total)*100).toFixed(1)+'%';document.getElementById('bestTrade').textContent='$'+best.toFixed(2);document.getElementById('worstTrade').textContent='$'+worst.toFixed(2);document.getElementById('avgProfit').textContent='$'+avg.toFixed(2);document.getElementById('totalPL').textContent='$'+totalPL.toFixed(2);document.getElementById('totalPL').style.color=totalPL>=0?'var(--green)':'#ff4444';
      },
      renderLiveTrades(){const el=document.getElementById('liveTrades');if(!el)return;if(!State.liveTradeHistory.length){el.innerHTML='No live trades yet';return;}el.innerHTML=State.liveTradeHistory.map(t=>`<div style="margin:2px 0;padding:2px;background:#0a0a1a;border-radius:3px;"><span style="color:var(--green);">✔</span> ${t.time.slice(11,19)} ${t.path} $${t.profit.toFixed(2)} ${t.testnet?'🧪':''}<br><small style="color:#888;">tx: ${t.txHash.slice(0,12)}...</small></div>`).join('');},
      renderLatency(){const el=document.getElementById('latencyDisplay');if(!el)return;if(!State.operationLatency.length){el.innerHTML='No operations yet';return;}el.innerHTML=State.operationLatency.slice(-8).map(l=>`<div>${l.op}: ${l.duration}ms</div>`).join('');},
      renderCoinLevels(){const el=document.getElementById('coinLevels');if(!el)return;if(!State.userCoins.length){el.innerHTML='No coins yet';return;}el.innerHTML=State.userCoins.map(c=>{const lvl=State.coinLevels[c.symbol]||1,maxEx=State.getMaxCoinExchanges(),unlocked=Math.min(lvl,maxEx);return`<div>🪙 ${c.symbol} Lv.${lvl} (${unlocked}/${maxEx} exchanges)</div>`;}).join('');},
      applyLevelConstraints(){
        const maxBet=Math.max(100,State.level*2000);document.getElementById('betSlider').max=maxBet;document.getElementById('betInput').max=maxBet;
        let maxDepth=3;if(State.level>=4&&State.level<=6)maxDepth=5;else if(State.level>=7)maxDepth=10;
        document.getElementById('pathSlider').max=maxDepth;document.getElementById('pathInput').max=maxDepth;
        const bellmanCheck=document.getElementById('bellmanToggle');if(State.level<5){bellmanCheck.disabled=true;bellmanCheck.checked=false;bellmanCheck.parentElement.style.opacity='0.5';}else{bellmanCheck.disabled=false;bellmanCheck.parentElement.style.opacity='1';}
        const strategyBtn=document.getElementById('strategyBtn');strategyBtn.disabled=State.level<10;
        State.startAutoForex();this.updateCoinCooldown();
      },
      renderPerks(){
        const el=document.getElementById('perksList');
        const perks=[{desc:'Max Bet',value:`$${Math.max(100,State.level*2000)}`},{desc:'Max Depth',value:(State.level<4?'3':State.level<7?'5':'10')},{desc:'Auto‑Forex (5m)',unlocked:State.level>=3},{desc:'Live Scan Interval',value:`${(State.getLiveScanInterval()/1000).toFixed(0)}s`},{desc:'Pull Cooldown',value:`${(State.getPullCooldown()/1000).toFixed(0)}s`},{desc:'Bellman‑Ford',unlocked:State.level>=5},{desc:'Create Coin',unlocked:State.level>=5,extra:State.level>=5?`Cooldown:${State.getCoinCooldown()}s`:''},{desc:'2nd Coin',unlocked:State.level>=15,extra:'🔒 Lv.15'},{desc:'Pump Launch',unlocked:State.level>=7},{desc:'Live Testnet',unlocked:true},{desc:'Smart Batch',unlocked:State.level>=5},{desc:'WS Reconnect',unlocked:State.level>=8},{desc:'Intra Exch',value:`${State.level+2}`},{desc:'Coin Exchanges',value:`${State.getMaxCoinExchanges()}`},{desc:'Private Room',unlocked:State.level>=10}];
        el.innerHTML=perks.map(p=>p.unlocked!==undefined?`<div class="${p.unlocked?'perk-unlocked':'perk-locked'}">🔹 ${p.desc}: ${p.unlocked?'✅ Unlocked':p.value}${p.extra?' · '+p.extra:''}</div>`:`<div>🔹 ${p.desc}: ${p.value}</div>`).join('');
      },
      renderOpp(opp,targetId,mega){const c=document.getElementById(targetId);if(!c)return;c.innerHTML+=`<div class="opportunity ${mega?'mega':''}" onclick="UI.openTradeModal('${encodeURIComponent(JSON.stringify(opp))}')"><strong>+${opp.profitPercent.toFixed(2)}%</strong> ${opp.path.join(' → ')}<br>Max: $${opp.maxTradeSize.toFixed(2)} | Profit: $${opp.actualProfit.toFixed(2)}</div>`;},
      openTradeModal(oppStr){
        const opp=JSON.parse(decodeURIComponent(oppStr));const bet=Math.min(opp.maxTradeSize,parseFloat(document.getElementById('betInput').value)||1000);const sz=bet;let rt=sz;let ms=`Start: $${sz.toFixed(2)}<br>`;let valid=true;
        const dh=opp.edges.map((e,i)=>{const p=rt;rt*=e.rate;const suspicious=(e.rate>1e4||e.rate<1e-4||!isFinite(e.rate));if(suspicious)valid=false;ms+=`Hop ${i+1}: $${p.toFixed(2)} × ${e.rate.toFixed(6)} → $${rt.toFixed(2)}${suspicious?' ⚠️':''}<br>`;return`<div>${opp.path[i]} → ${opp.path[i+1]} | Liq: $${e.liquidity.toFixed(0)}${suspicious?' ⚠️ SUSPECT RATE':''}</div>`;}).join('');
        document.getElementById('tradeDetails').innerHTML=`<p>🔄 ${opp.path.join(' → ')}</p><p>💵 $${sz.toFixed(2)}</p>${dh}`;
        document.getElementById('compoundingMath').innerHTML=ms+`<strong>💰 Final: $${rt.toFixed(2)}</strong>`;
        const rateWarn=document.getElementById('rateWarning');if(!valid){rateWarn.innerHTML='<span style="color:#ffaa00;">⚠️ Anomalous rates detected.</span>';}else{rateWarn.innerHTML='';}
        const conflictWarn=document.getElementById('conflictWarning');const allPaths=[...State.highlightedPaths];const conflicts=allPaths.filter(p=>p!==opp.path&&p.some(n=>opp.path.includes(n)));if(conflicts.length>0){conflictWarn.innerHTML=`<span style="color:#ff4444;">⚠️ Shares nodes with ${conflicts.length} other payline(s).</span>`;}else{conflictWarn.innerHTML='';}
        document.getElementById('executeTradeBtn').onclick=async()=>{const now=Date.now();if(now-State.lastTradeExecTime<4000){log('⏳ Trade blocked','warning');return;}if(State.bankroll<=0){log('❌ Bankroll exhausted','error');return;}State.lastTradeExecTime=now;UI.logButton('EXECUTE TRADE');closeModal();await Engine.executeTrade(opp,sz,rt-sz);};
        document.getElementById('tradeModal').style.display='flex';
      },
      closeModal(){document.getElementById('tradeModal').style.display='none';},
      renderFiatCheckboxes(){const c=document.getElementById('fiatCheckboxes');const f=['RUB','INR','EUR','GBP','JPY','CNY','KRW','AUD','CAD','CHF','AED','TRY','BRL','SGD','PLN'];c.innerHTML=f.map(x=>`<label><input type="checkbox" value="${x}" ${State.selectedFiats.has(x)?'checked':''} onchange="UI.toggleFiat('${x}')"> ${x}</label>`).join('');},
      toggleFiat(f){State.selectedFiats.has(f)?State.selectedFiats.delete(f):State.selectedFiats.add(f);State.save();log(`🖱️ Fiat: ${f}`);State.startAutoForex();if(!Object.keys(State.forexRates).length)fetchForexRates();},
      onProxyChange(){const m=document.getElementById('proxySelect').value;State.proxyMode=m;document.getElementById('corsProxyUrl').style.display=m==='custom'?'inline-block':'none';this.updateProxyStatus();State.save();log(`🖱️ Proxy: ${m}`);},
      updateProxyStatus(){const e=document.getElementById('proxyStatusMsg');if(!e)return;e.textContent=State.proxyMode==='direct'?'⚡ Direct + fallback':State.proxyMode==='builtin'?`🔁 Rotating: ${BUILTIN_PROXIES[currentProxyIndex]}`:'📝 Custom proxy';},
      renderTradeLedger(){const e=document.getElementById('tradeLedger');if(!e)return;if(!State.tradeLedger.length){e.innerHTML='No trades yet.';return;}e.innerHTML=State.tradeLedger.slice(0,15).map(x=>`<div>${x.time.slice(11,19)} ${x.type} ${x.path} <span style="color:${x.profit>=0?'var(--green)':'#ff4444'}">$${x.profit.toFixed(2)}</span> ${x.testnet?'🧪':x.live?'🔴':''}</div>`).join('');},
      renderBasketTracker(){const e=document.getElementById('basketTracker');const v=document.getElementById('basketValue');if(!e||!v)return;const h=State.basketHoldings;if(!Object.keys(h).length){e.innerHTML='No purchases yet';v.innerHTML='';return;}let totalValue=0;e.innerHTML=Object.entries(h).map(([k,amt])=>{const price=State.getAssetPrice(k);const value=amt*price;totalValue+=value;const acqInfo=State.acquisitionPaths[k]?State.acquisitionPaths[k].slice(-1)[0]?.path||'unknown':'unknown';return`<div>📦 ${k}: ${amt.toFixed(6)} ($${value.toFixed(2)})<br><small>via ${acqInfo}</small></div>`;}).join('');v.innerHTML=`💰 Total value: $${totalValue.toFixed(2)}`;},
      renderBatchHistory(){const e=document.getElementById('batchHistory');if(!e)return;if(!State.batchHistory.length){e.innerHTML='No batch executions yet.';return;}e.innerHTML=State.batchHistory.map(h=>`<div style="margin:3px 0;padding:3px;background:#0a0a1a;border-radius:3px;"><strong>${h.time}</strong> — ${h.lines} lines — Profit: <span style="color:${h.profit>=0?'var(--green)':'#ff4444'}">$${h.profit.toFixed(2)}</span> — Targets: ${h.targets||'none'}</div>`).join('');},
      renderPlayerList(){const el=document.getElementById('playerList');if(!el)return;let html='';for(const[id,p]of Object.entries(State.otherPlayers)){const handle=p.handle||id.slice(0,6);html+=`<div class="player-row" onclick="UI.showPlayerDetail('${id}')">${handle} (LVL ${p.level||1}) | Bankroll: $${(p.bankroll||0).toFixed(2)} | Mana: C${p.mana?.compute||0} D${p.mana?.data||0} T${p.mana?.trade||0}</div>`;}el.innerHTML=html||'No peers yet';},
      showPlayerDetail(id){const p=State.otherPlayers[id];if(!p)return;alert(`Player: ${p.handle||id.slice(0,6)}\nLevel: ${p.level}\nBankroll: $${(p.bankroll||0).toFixed(2)}\nMatrix: ${p.matrix}\nBasket: ${JSON.stringify(p.basketHoldings||{})}\nRecent trades: ${(p.tradeLedger||[]).slice(0,3).map(t=>t.path).join(', ')}`);},
      togglePanel(id){const p=document.getElementById(id);p.style.display=p.style.display==='block'?'none':'block';if(id==='ipnsPanel'&&p.style.display==='block')generateQRCode();},
      closePanel(id){document.getElementById(id).style.display='none';},
      updateManaDisplay(){document.getElementById('nodeIdDisplay').textContent=NODE_ID;document.getElementById('computeMana').textContent=State.mana.compute;document.getElementById('dataMana').textContent=State.mana.data;document.getElementById('tradeMana').textContent=State.mana.trade;},
      renderCoinExCheckboxes(){const c=document.getElementById('coinExCheckboxes');if(!c)return;const allExs=Object.keys(State.exchanges).filter(k=>State.exchanges[k].parser!=='coingecko'&&State.exchanges[k].parser!=='coinlore');c.innerHTML=allExs.map(k=>{const checked=State.coinExchangeList.includes(k)?'checked':'';return`<label><input type="checkbox" value="${k}" ${checked} onchange="toggleCoinEx('${k}')"> ${State.exchanges[k].name}</label>`;}).join('');},
      updateCoinCooldown(){const cdEl=document.getElementById('coinCooldown');const btn=document.getElementById('createCoinBtn');if(!cdEl||!btn)return;const cooldown=State.getCoinCooldown();if(State.level<5){cdEl.textContent='🔒 Unlock at Level 5';btn.disabled=true;return;}if(State.userCoins.length>=1&&State.level<15){cdEl.textContent='🔒 2nd coin at Lv.15';btn.disabled=true;return;}const elapsed=(Date.now()-State.lastCoinCreateTime)/1000;const remaining=Math.max(0,cooldown-elapsed);if(remaining>0){cdEl.textContent=`⏳ Cooldown: ${Math.ceil(remaining)}s`;btn.disabled=true;}else{cdEl.textContent='';btn.disabled=false;}}
    };

    function closeModal(){UI.closeModal();}
    function saveProxyConfig(){State.proxyMode=document.getElementById('proxySelect').value;State.customProxyUrl=document.getElementById('corsProxyUrl').value;State.execPath=document.getElementById('execPath').value.trim()||'/execute';State.save();UI.updateProxyStatus();log('🖱️ Proxy saved');}
    function setTargetPreset(list){document.getElementById('targetAssetsInput').value=list;State.save();log(`🎯 Target preset: ${list}`);}
    function toggleCoinEx(k){const max=State.getMaxCoinExchanges();if(State.coinExchangeList.includes(k)){State.coinExchangeList=State.coinExchangeList.filter(x=>x!==k);}else{if(State.coinExchangeList.length>=max){log(`Max ${max} coin exchanges`,'warning');return;}State.coinExchangeList.push(k);}State.save();UI.renderCoinExCheckboxes();log(`🖱️ Coin Ex: ${k}`);}

    // ── Engine ────────────────────────────────────────
    const Engine = {
      resetPaperAccount(){if(confirm('Reset all paper trading data to $10,000? This cannot be undone.')){['qfoam_v22final','wallet_sol','wallet_eth','pumpfun_token','basket','pathDepth','walletProxyUrl'].forEach(k=>localStorage.removeItem(k));location.reload();}},
      exportCSV(){const trades=State.tradeLedger;if(!trades.length){log('No trades to export','warning');return;}let csv='Time,Type,Path,Size,Profit,Live,Testnet\n';trades.forEach(t=>{csv+=`${t.time},${t.type},"${t.path}",${t.size},${t.profit.toFixed(2)},${t.live?'Yes':'No'},${t.testnet?'Yes':'No'}\n`;});const blob=new Blob([csv],{type:'text/csv'});const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download=`qfoam_trades_${new Date().toISOString().slice(0,10)}.csv`;a.click();URL.revokeObjectURL(url);log('📥 CSV exported!','success');},
      async runTestSuite(){
        log('🧪 COMPREHENSIVE TEST SUITE STARTING…','success');
        const results = [];
        const test = async (name, fn) => {
          try { await fn(); results.push(`✅ ${name}`); log(`✅ ${name}`,'success'); }
          catch (e) { results.push(`❌ ${name}: ${e.message}`); log(`❌ ${name}: ${e.message}`,'error'); }
        };

        // Trading core
        await test('INIT System', async () => { await initSystem(); if (State.stats.totalPairs < 100) throw new Error('Too few pairs'); });
        await test('FULL SCAN', async () => { await runFullScan(); if (Object.values(State.opportunities).flat().length === 0) throw new Error('No opportunities'); });
        await test('Graph Render', () => { if (!State.graphRenderer) State.graphRenderer = new GraphRenderer('graphNetwork'); State.computePurchasePower(); State.graphRenderer.buildFromGraph(State.graph, State.opportunities, State.purchasePower, State.highlightedPaths); if (Object.keys(State.graphRenderer.nodes).length === 0) throw new Error('Graph empty'); });
        await test('Forex Fetch', async () => { await fetchForexRates(); if (Object.keys(State.forexRates).length === 0) throw new Error('No forex rates'); });
        await test('Coin Levels + Index Weight', () => { if (!State.userCoins.length) { State.userCoins.push({ symbol:'TEST', price:1, liq:1000, quote:'USDT', exchange:'QUANTM_DEX' }); State.allPairs.push({ base:'TEST', target:'USDT', price:1, volume:300, liquidity:1000, bidPrice:0.999, askPrice:1.001, exchange:'QUANTM_DEX', exchangeType:'dex' }); } State.addCoinXP(State.userCoins[0].symbol, 2); if ((State.coinLevels[State.userCoins[0].symbol]||1) < 3) throw new Error('Coin XP not applied'); log('Coin leveling test passed','success'); });
        await test('Live Testnet Trade', async () => { const prevLive = State.liveMode, prevTest = State.liveTestMode; State.liveMode = true; State.liveTestMode = true; const opp = State.opportunities.triangular[0] || { path:['USD','USDT','EUR','USD'], edges:[{rate:1.01,liquidity:10000},{rate:0.99,liquidity:10000},{rate:1.001,liquidity:10000}], maxTradeSize:100, profitPercent:0.5 }; await Engine.executeTrade(opp, 100, 1); if (!State.liveTradeHistory.length) throw new Error('Live trade not recorded'); State.liveMode = prevLive; State.liveTestMode = prevTest; UI.updateProfile(); log('Live testnet trade simulation passed','success'); });
        await test('Dashboard Update', () => { UI.updateDashboard(); });
        await test('CSV Export', () => { if (State.tradeLedger.length === 0) State.tradeLedger.push({ time:new Date().toISOString(), path:'TEST', size:100, profit:10, type:'test', live:false, testnet:false }); Engine.exportCSV(); });
        await test('Batch Execute', async () => { if (State.bankroll <= 0) throw new Error('Bankroll exhausted'); if (!State.highlightedPaths.length) { State.highlightedPaths = [State.opportunities.triangular[0]?.path || ['USD','USDT','EUR','USD']]; } await Engine.executeAllLines(); });
        await test('Level Perks', () => { UI.applyLevelConstraints(); UI.renderPerks(); if (document.getElementById('perksList').innerHTML.length < 10) throw new Error('Perks not rendered'); });
        await test('Save/Load', () => { State.save(); State.load(); if (State.bankroll <= 0) throw new Error('Save/Load corrupted'); });
        await test('Pull Cooldown', () => { const cd = State.getPullCooldown(); document.getElementById('pullLeverBtn2').disabled = false; log(`Pull cooldown: ${cd/1000}s`,'info'); });
        await test('Live Scan Interval', () => { const iv = State.getLiveScanInterval(); log(`Live scan interval: ${iv/1000}s`,'info'); });
        await test('UI Scale', () => { setUIScale(10); setUIScale(14); setUIScale(10); log('UI scale toggled','info'); });

        // P2P modules (graceful fallbacks)
        await test('DuckDB initialisation', async () => {
          if (!State.db) await initDuckDB();
          if (!State.db) throw new Error('DuckDB not loaded');
          log('DuckDB loaded','success');
        });
        await test('DB Query (SELECT 1)', async () => {
          if (!State.conn) throw new Error('No DB connection');
          const res = await State.conn.query('SELECT 1 AS ok');
          if (!res.toArray().length) throw new Error('Query failed');
          log('DB query succeeded','success');
        });
        await test('Yjs swarm join', async () => {
          if (!State.ydoc) await initYjs();
          if (!State.ydoc) throw new Error('Yjs not initialized');
          // Try to set a test value
          State.ymap && State.ymap.set('test', 'ok');
          log('Yjs initialized and writable','success');
        });
        await test('Mana increments', () => {
          addMana('compute', 1);
          addMana('data', 1);
          addMana('trade', 1);
          if (State.mana.compute < 1 || State.mana.data < 1 || State.mana.trade < 1) throw new Error('Mana not incremented');
          log('Mana system works','success');
        });
        await test('DEX order placement', () => {
          if (!window.yDexOrders) initDEX();
          if (!window.yDexOrders) throw new Error('DEX Yjs array not ready');
          // Place a dummy order
          window.yDexOrders.push([{id:Date.now(), side:'buy', coin:'TEST', amount:1, user:NODE_ID, handle:playerHandle, timestamp:Date.now()}]);
          if (!window.yDexOrders.length) throw new Error('Order not added');
          log('DEX order recorded','success');
        });
        await test('QR Code generation', () => {
          generateQRCode();
          const canvas = document.getElementById('qrCanvas');
          if (!canvas || canvas.toDataURL().length < 100) throw new Error('QR not generated');
          log('QR code generated','success');
        });
        await test('IPNS check (connectivity)', async () => {
          try {
            await checkIPNSUpdate();
            const status = document.getElementById('ipnsStatus').textContent;
            if (status.includes('unreachable') || status.includes('failed')) throw new Error('IPNS unreachable');
            log('IPNS check completed','success');
          } catch { throw new Error('IPNS check failed'); }
        });
        await test('Private room creation (level check)', () => {
          // Simulate level 10
          const origLevel = State.level;
          State.level = 10;
          createPrivateRoom();
          const info = document.getElementById('privateRoomInfo').textContent;
          if (!info.includes('Room created')) throw new Error('Room not created');
          State.level = origLevel;
          log('Private room creation works at level 10','success');
        });
        await test('Testnets toggle', () => {
          const old = State.testnetsActive;
          toggleTestnets();
          if (State.testnetsActive === old) throw new Error('Testnets toggle failed');
          toggleTestnets(); // revert
          log('Testnets toggle works','success');
        });

        log(`🧪 TEST SUITE COMPLETE: ${results.filter(r=>r.startsWith('✅')).length}/${results.length} passed`,'success');
        document.getElementById('batchResult').innerHTML = '<strong>🧪 TEST RESULTS</strong><br>'+results.join('<br>');
      },

      async pullGraphLever(){
        const now=Date.now();const cooldown=State.getPullCooldown();
        if(now-State.lastPullTime<cooldown){const r=Math.ceil((cooldown-(now-State.lastPullTime))/1000);log(`⏳ ${r}s`,'warning');return;}
        State.lastPullTime=now;const btn=document.getElementById('pullLeverBtn2');btn.disabled=true;btn.innerHTML='🎰 SPINNING…';
        document.getElementById('slotResult2').textContent='';document.getElementById('accumulationInfo').textContent='';
        playSpin();const start=performance.now();
        await initSystem();
        const useBellman=document.getElementById('bellmanToggle').checked&&State.level>=5;
        await runFullScan(true,useBellman);
        const duration=Math.round(performance.now()-start);State.operationLatency.push({op:'PULL',duration});UI.renderLatency();
        State.save();State.computePurchasePower();
        const multiLineCount=parseInt(document.getElementById('multiLineCount')?.value||7);
        const all=[...State.opportunities.mega,...State.opportunities.triangular,...State.opportunities.bellman];
        State.highlightedPaths=[];State.conflictEdges=new Set();
        if(all.length){
          all.sort((a,b)=>b.profitPercent-a.profitPercent);const top=all.slice(0,multiLineCount);
          State.highlightedPaths=top.map(o=>o.path);const edgeCount=new Map();
          for(const path of State.highlightedPaths){for(let i=0;i<path.length-1;i++){const ek=[path[i],path[i+1]].sort().join('|');edgeCount.set(ek,(edgeCount.get(ek)||0)+1);}}
          for(const[ek,count]of edgeCount){if(count>1)State.conflictEdges.add(ek);}
          const best=top[0];
          document.getElementById('slotResult2').textContent=`🎉 WIN! +${best.profitPercent.toFixed(2)}% — ${best.path.slice(0,4).join(' → ')}`;
          document.getElementById('slotResult2').style.color=best.profitPercent>5?'#ff00ff':'var(--gold)';
          confetti(window.innerWidth/2,130,45);
          const accInfo=[];const targets=State.getTargetAssets();
          for(const t of targets){const price=State.getAssetPrice(t);if(price>0&&State.bankroll>0){const directAmount=State.bankroll/price;const bestPathForT=all.find(o=>o.path[0]===t&&o.path[o.path.length-1]===t);if(bestPathForT){const pathAmount=State.bankroll*(1+bestPathForT.profitPercent/100)/price;const improvement=((pathAmount-directAmount)/directAmount*100).toFixed(2);accInfo.push(`${t}: direct ${directAmount.toFixed(4)} → path ${pathAmount.toFixed(4)} (${improvement}% more)`);}}}
          if(accInfo.length)document.getElementById('accumulationInfo').textContent=accInfo.join(' | ');
          if(document.getElementById('autoOpenTrade').checked)setTimeout(()=>UI.openTradeModal(encodeURIComponent(JSON.stringify(best))),500);
        }else{document.getElementById('slotResult2').textContent='❌ NO PATH FOUND';}
        if(State.graphRenderer){State.graphRenderer.buildFromGraph(State.graph,State.opportunities,State.purchasePower,State.highlightedPaths,State.conflictEdges);}
        const cd=setInterval(()=>{const e=Date.now()-State.lastPullTime;const r=Math.max(0,cooldown-e);if(r<=0){btn.disabled=false;btn.innerHTML='🎰 PULL LEVER';clearInterval(cd);}else btn.innerHTML=`⏳ ${Math.ceil(r/1000)}s`;},500);
      },
      async executeAllLines(){
        if(State.bankroll<=0){log('❌ Bankroll exhausted','error');document.getElementById('batchResult').innerHTML='<span style="color:#ff4444;">❌ Bankroll exhausted.</span>';return;}
        if(!State.highlightedPaths.length){log('No paylines yet, auto‑pulling…');await Engine.pullGraphLever();if(State.bankroll<=0){log('❌ Bankroll still exhausted','error');return;}if(!State.highlightedPaths.length){log('Still no paylines.','warning');return;}}
        const start=performance.now();let paths=[...State.highlightedPaths];
        const smartBatch=document.getElementById('smartBatchToggle')?.checked&&State.level>=5;
        if(smartBatch&&paths.length>1){paths.sort((a,b)=>{const aConflicts=paths.filter(p=>p!==a&&p.some(n=>a.includes(n))).length;const bConflicts=paths.filter(p=>p!==b&&p.some(n=>b.includes(n))).length;return aConflicts-bConflicts;});log('🧠 Smart batch: ordered by conflict count','success');}
        const totalPaths=paths.length;const perPath=Math.abs(State.bankroll*0.8/totalPaths);
        let reinvestPercent=Math.min(100,Math.max(0,parseFloat(document.getElementById('reinvestPercent')?.value||50)))/100;
        log(`🚀 Executing ${totalPaths} paylines with $${perPath.toFixed(2)} each...`);
        const batchEl=document.getElementById('batchResult');batchEl.innerHTML='<strong>🚀 BATCH EXECUTION</strong><br>';
        let totalProfit=0;const targets=State.getTargetAssets();const acquired={};const pathDescriptions={};
        for(let i=0;i<paths.length;i++){
          const path=paths[i];const opp=[...State.opportunities.mega,...State.opportunities.triangular,...State.opportunities.bellman].find(o=>o.path.join('|')===path.join('|'));
          if(!opp){batchEl.innerHTML+=`<div>Line ${i+1}: ${path.join(' → ')} — ❌ not found</div>`;continue;}
          const sz=Math.min(opp.maxTradeSize,perPath);let rt=sz;let valid=true;for(const e of opp.edges){if(!State.validateEdge(e)){valid=false;break;}rt*=e.rate;}
          if(!valid||!State.validateCycle(opp.edges)){batchEl.innerHTML+=`<div>Line ${i+1}: ${path.join(' → ')} — ⚠️ skipped (rates)</div>`;continue;}
          const profit=rt-sz;if(profit<0&&Math.abs(profit)>sz*0.5){batchEl.innerHTML+=`<div>Line ${i+1}: ${path.join(' → ')} — ⚠️ skipped (stale)</div>`;continue;}
          if(State.liveMode&&State.liveTestMode){const txHash='testnet-'+Date.now().toString(36);State.addLiveTrade(opp,sz,profit,txHash);log(`🧪 Testnet tx: ${txHash.slice(0,14)}...`,'success');}
          State.bankroll+=profit*0.9;State.qFund+=profit*0.05;State.lFund+=profit*0.05;
          State.matrix+=10+Math.floor(sz/100);totalProfit+=profit;State.allocateIndexFund(profit);
          State.addTradeToLedger(opp,sz,profit);
          const startAsset=path[0];if(targets.includes(startAsset)){const endAmount=sz*(1+opp.profitPercent/100);const price=State.getAssetPrice(startAsset);if(price>0){const acqAmt=endAmount/price;State.recordBasketPurchase(startAsset,acqAmt,path.join(' → '));if(!acquired[startAsset])acquired[startAsset]=0;acquired[startAsset]+=acqAmt;if(!pathDescriptions[startAsset])pathDescriptions[startAsset]=new Set();pathDescriptions[startAsset].add(path.join(' → '));}}
          batchEl.innerHTML+=`<div style="color:${profit>=0?'var(--green)':'#ff4444'}">Line ${i+1}: ${path.join(' → ')} — $${sz.toFixed(2)} → $${rt.toFixed(2)} (${profit>=0?'+':''}$${profit.toFixed(2)})</div>`;
          log(`💸 Line ${i+1}: ${path.join(' → ')} profit $${profit.toFixed(2)}`,'success');playWin();State.addCoinXP(startAsset,1);
        }
        if(reinvestPercent>0&&totalProfit>0&&targets.length&&State.bankroll>0){let reinvestAmount=Math.min(totalProfit*reinvestPercent,State.bankroll);if(reinvestAmount>0){State.bankroll-=reinvestAmount;batchEl.innerHTML+=`<br><strong>💰 Reinvesting $${reinvestAmount.toFixed(2)} into targets...</strong><br>`;for(const t of targets){const price=State.getAssetPrice(t);if(price>0){const amount=reinvestAmount/targets.length/price;State.recordBasketPurchase(t,amount,'Reinvestment');if(!acquired[t])acquired[t]=0;acquired[t]+=amount;if(!pathDescriptions[t])pathDescriptions[t]=new Set();pathDescriptions[t].add('Reinvestment');batchEl.innerHTML+=`<div>📦 ${t}: +${amount.toFixed(6)} @ $${price.toExponential(4)}</div>`;log(`📦 Bought ${amount.toFixed(6)} ${t}`,'success');}}}}
        State.level=Math.floor(Math.sqrt(State.matrix/10))+1;State.save();UI.updateProfile();
        batchEl.innerHTML+=`<br><strong>Total profit: $${totalProfit.toFixed(2)}</strong>`;
        if(Object.keys(acquired).length){batchEl.innerHTML+='<br><strong>🎯 Acquired:</strong><br>';for(const[asset,amount]of Object.entries(acquired)){const paths=pathDescriptions[asset]?[...pathDescriptions[asset]].join(', '):'unknown';batchEl.innerHTML+=`<div>📦 ${asset}: ${amount.toFixed(6)} <small>(via ${paths})</small></div>`;}}
        const duration=Math.round(performance.now()-start);State.operationLatency.push({op:'BATCH',duration});UI.renderLatency();
        State.addBatchHistory({time:new Date().toLocaleTimeString(),lines:totalPaths,profit:totalProfit,targets:targets.join(',')});
        confetti(window.innerWidth/2,200,80);
      },
      async executeTrade(opp,size,netProfit){
        if(State.bankroll<=0){log('❌ Bankroll exhausted','error');return;}
        if(State.liveMode&&State.liveTestMode){const txHash='testnet-'+Date.now().toString(36);State.addLiveTrade(opp,size,netProfit,txHash);log(`🧪 Testnet tx: ${txHash.slice(0,14)}...`,'success');}
        const live=State.liveMode;const fee=live?5:0;const fp=netProfit-fee;
        State.bankroll+=fp*0.9;State.qFund+=fp*0.05;State.lFund+=fp*0.05;
        State.matrix+=10+Math.floor(size/100);State.level=Math.floor(Math.sqrt(State.matrix/10))+1;
        State.allocateIndexFund(fp);State.addTradeToLedger(opp,size,fp);State.save();UI.updateProfile();
        log(`💸 Trade: $${fp.toFixed(2)}`,'success');playWin();State.addCoinXP(opp.path[0],1);
      }
    };

    // ── Graph Renderer ──────────────────────────────
    class GraphRenderer{
      constructor(canvasId){this.canvas=document.getElementById(canvasId);this.ctx=this.canvas.getContext('2d');this.nodes={};this.edges=[];this.highlightedPaths=[];this.conflictEdges=new Set();this.animPhase=0;this.purchasePower={};this.maxPower=1;this.pathColors=['#ffd700','#ff00ff','#00ffaa','#ff4444','#4488ff','#ffaa00','#88ff88','#ff88ff'];this.resize();window.addEventListener('resize',()=>this.resize());}
      resize(){const r=this.canvas.parentElement.getBoundingClientRect();const w=Math.min(700,r.width-20);this.canvas.width=w;this.canvas.height=Math.min(380,w*0.55);}
      buildFromGraph(graph,opps,power,paths,conflictEdges){this.nodes={};this.edges=[];this.purchasePower=power||{};this.highlightedPaths=paths||[];this.conflictEdges=conflictEdges||new Set();const seen=new Set();this.maxPower=Math.max(1,...Object.values(this.purchasePower));for(const[b,tgts]of Object.entries(graph)){if(!this.nodes[b])this.nodes[b]={id:b,x:0,y:0,power:this.purchasePower[b]||0,color:this.getColor(b),oppCount:0};for(const[t,e]of Object.entries(tgts)){const k=[b,t].sort().join('|');if(!seen.has(k)){seen.add(k);this.edges.push({from:b,to:t,vol:e.volume||0,liq:e.liquidity||0,rate:e.rate});}if(!this.nodes[t])this.nodes[t]={id:t,x:0,y:0,power:this.purchasePower[t]||0,color:this.getColor(t),oppCount:0};}}if(opps){for(const o of[...(opps.mega||[]),...(opps.triangular||[]),...(opps.bellman||[])]){for(const n of o.path){if(this.nodes[n])this.nodes[n].oppCount++;}}}this.forceLayout();this.startAnim();}
      getColor(id){const c=['#ffd700','#00f0ff','#ff00ff','#00ffaa','#ff8888','#88ff88','#ffaa00','#aa88ff','#ff4488','#44ff88'];let h=0;for(let i=0;i<id.length;i++)h=((h<<5)-h)+id.charCodeAt(i);return c[Math.abs(h)%c.length];}
      forceLayout(){const nl=Object.values(this.nodes);const n=nl.length;if(!n)return;const cx=this.canvas.width/2,cy=this.canvas.height/2;const rad=Math.min(cx,cy)*0.65;nl.forEach((nd,i)=>{const a=(2*Math.PI*i)/n-Math.PI/2;nd.x=cx+rad*Math.cos(a);nd.y=cy+rad*Math.sin(a);});const iters=Math.min(35,Math.max(12,n));for(let iter=0;iter<iters;iter++){for(let i=0;i<n;i++){for(let j=i+1;j<n;j++){const dx=nl[i].x-nl[j].x,dy=nl[i].y-nl[j].y;const d=Math.max(1,Math.sqrt(dx*dx+dy*dy));const f=700/(d*d);const fx=(dx/d)*f,fy=(dy/d)*f;nl[i].x+=fx;nl[i].y+=fy;nl[j].x-=fx;nl[j].y-=fy;}}for(const e of this.edges){const from=this.nodes[e.from],to=this.nodes[e.to];if(!from||!to)continue;const dx=to.x-from.x,dy=to.y-from.y;const d=Math.max(1,Math.sqrt(dx*dx+dy*dy));const f=d*0.0018;const fx=(dx/d)*f,fy=(dy/d)*f;from.x+=fx;from.y+=fy;to.x-=fx;to.y-=fy;}for(const nd of nl){nd.x+=(cx-nd.x)*0.018;nd.y+=(cy-nd.y)*0.018;nd.x=Math.max(15,Math.min(this.canvas.width-15,nd.x));nd.y=Math.max(15,Math.min(this.canvas.height-15,nd.y));}}}
      startAnim(){if(this.animRAF)cancelAnimationFrame(this.animRAF);const anim=()=>{this.animPhase+=0.025;this.render();this.animRAF=requestAnimationFrame(anim);};anim();}
      render(){const ctx=this.ctx,w=this.canvas.width,h=this.canvas.height;ctx.clearRect(0,0,w,h);ctx.strokeStyle='rgba(255,255,255,0.03)';ctx.lineWidth=1;for(let x=0;x<w;x+=35){ctx.beginPath();ctx.moveTo(x,0);ctx.lineTo(x,h);ctx.stroke();}for(let y=0;y<h;y+=35){ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(w,y);ctx.stroke();}const maxVol=Math.max(1,...this.edges.map(e=>e.vol||0));const hlEdgesByPath=this.highlightedPaths.map(path=>{const set=new Set();for(let i=0;i<path.length-1;i++){set.add([path[i],path[i+1]].sort().join('|'));}return set;});for(const e of this.edges){const from=this.nodes[e.from],to=this.nodes[e.to];if(!from||!to)continue;const ek=[e.from,e.to].sort().join('|');let highlighted=false;let color=null;let isConflict=false;for(let p=0;p<hlEdgesByPath.length;p++){if(hlEdgesByPath[p].has(ek)){if(highlighted){isConflict=true;break;}highlighted=true;color=this.pathColors[p%this.pathColors.length];}}if(highlighted&&isConflict){ctx.strokeStyle='rgba(255,68,68,0.8)';ctx.lineWidth=2;ctx.setLineDash([5,3]);ctx.shadowColor='#ff4444';ctx.shadowBlur=6;}else if(highlighted&&color){ctx.strokeStyle=color.replace(')',`,${0.7+0.3*Math.sin(this.animPhase*3)})`).replace('rgb','rgba');ctx.lineWidth=2.5;ctx.setLineDash([]);ctx.shadowColor=color;ctx.shadowBlur=8;}else{const alpha=Math.max(0.06,Math.min(0.45,(e.vol||0)/maxVol));ctx.strokeStyle=`rgba(0,240,255,${alpha})`;ctx.lineWidth=1;ctx.setLineDash([]);ctx.shadowBlur=0;}ctx.beginPath();ctx.moveTo(from.x,from.y);ctx.lineTo(to.x,to.y);ctx.stroke();ctx.setLineDash([]);ctx.shadowBlur=0;}for(const nd of Object.values(this.nodes)){const inPaths=this.highlightedPaths.some(p=>p.includes(nd.id));const pr=Math.min(1,(nd.power||0)/this.maxPower);const sz=7+pr*16;const ob=Math.min(7,(nd.oppCount||0)*1.8);const ts=sz+ob;const glow=ctx.createRadialGradient(nd.x,nd.y,0,nd.x,nd.y,ts*1.7);if(inPaths){glow.addColorStop(0,'rgba(255,215,0,0.65)');glow.addColorStop(0.5,'rgba(255,215,0,0.15)');glow.addColorStop(1,'rgba(255,215,0,0)');}else{glow.addColorStop(0,nd.color.replace(')',',0.45)').replace('rgb','rgba'));glow.addColorStop(1,'rgba(0,0,0,0)');}ctx.fillStyle=glow;ctx.beginPath();ctx.arc(nd.x,nd.y,ts*1.7,0,Math.PI*2);ctx.fill();const bg=ctx.createRadialGradient(nd.x-ts*0.25,nd.y-ts*0.25,ts*0.08,nd.x,nd.y,ts);bg.addColorStop(0,'#ffffff');bg.addColorStop(0.3,nd.color);bg.addColorStop(1,'#000000');ctx.fillStyle=bg;ctx.beginPath();ctx.arc(nd.x,nd.y,ts,0,Math.PI*2);ctx.fill();ctx.strokeStyle=inPaths?'#ffd700':'rgba(255,255,255,0.25)';ctx.lineWidth=inPaths?1.8:1;ctx.stroke();ctx.fillStyle='#fff';ctx.font=`${Math.max(7,ts*0.5)}px 'Courier New'`;ctx.textAlign='center';ctx.fillText(nd.id,nd.x,nd.y+ts+10);}for(let p=0;p<this.highlightedPaths.length;p++){const path=this.highlightedPaths[p];if(path.length<2)continue;const t=(this.animPhase+p*0.3)%1;const idx=Math.floor(t*(path.length-1));const nxt=Math.min(idx+1,path.length-1);const from=this.nodes[path[idx]],to=this.nodes[path[nxt]];if(from&&to){const fr=(t*(path.length-1))%1;const px=from.x+(to.x-from.x)*fr,py=from.y+(to.y-from.y)*fr;const color=this.pathColors[p%this.pathColors.length];ctx.fillStyle=color;ctx.shadowColor=color;ctx.shadowBlur=10;ctx.beginPath();ctx.arc(px,py,4,0,Math.PI*2);ctx.fill();ctx.shadowBlur=0;}}}
    }

    // ── P2P Modules (merged from v23.3) ──────────────
    async function initDuckDB(){
      try{
        const mod = await import('https://cdn.jsdelivr.net/npm/@duckdb/duckdb-wasm@1.29.0/+esm');
        const JSDELIVR_BUNDLES = {mvp:"https://cdn.jsdelivr.net/npm/@duckdb/duckdb-wasm@1.29.0/dist/duckdb-mvp.wasm",eh:"https://cdn.jsdelivr.net/npm/@duckdb/duckdb-wasm@1.29.0/dist/duckdb-eh.wasm"};
        const bundle = await mod.selectBundle(JSDELIVR_BUNDLES);
        const worker = new Worker(bundle.mainWorker);
        const logger = new mod.ConsoleLogger();
        const db = new mod.AsyncDuckDB(logger, worker);
        await db.instantiate(bundle.mainModule);
        const conn = await db.connect();
        State.db=db; State.conn=conn;
        await conn.query(`CREATE TABLE IF NOT EXISTS ohlc (timestamp BIGINT, base VARCHAR, target VARCHAR, open DOUBLE, high DOUBLE, low DOUBLE, close DOUBLE, volume DOUBLE)`);
        document.getElementById('dbStatus').innerHTML='✅ DuckDB ready';
        log('🦆 DuckDB-Wasm ready','success');
      }catch(e){document.getElementById('dbStatus').innerHTML='⚠️ DuckDB unavailable';log('🦆 DuckDB not available: '+e.message,'warning');}
    }
    async function executeDBQuery(){
      if(!State.conn){log('DuckDB not loaded','warning');return;}
      const sql=document.getElementById('sqlQuery').value.trim();
      if(!sql)return;
      try{const result=await State.conn.query(sql);document.getElementById('dbResult').textContent=JSON.stringify(result.toArray(),null,2);log('📊 Query executed','success');}
      catch(e){document.getElementById('dbResult').textContent='Error: '+e.message;}
    }
    function addTorrentFromInput(){
      const magnet=document.getElementById('magnetInput').value.trim();
      if(!magnet)return;
      if(!State.torrentClient){try{State.torrentClient=new WebTorrent();}catch(e){log('WebTorrent not available','error');return;}}
      document.getElementById('torrentStatus').textContent='Connecting...';
      State.torrentClient.add(magnet,(torrent)=>{
        document.getElementById('torrentStatus').textContent=`📦 ${torrent.name} (${torrent.files.length} files)`;
        const fileList=document.getElementById('torrentFileList');fileList.innerHTML='';
        torrent.files.forEach(file=>{const li=document.createElement('li');li.textContent=`${file.name} (${(file.length/1024).toFixed(1)} KB)`;li.style.cursor='pointer';li.onclick=()=>importTorrentFile(file);fileList.appendChild(li);});
        torrent.on('download',()=>{const progress=(torrent.progress*100).toFixed(1);document.getElementById('torrentProgressBar').style.width=progress+'%';});
        torrent.on('done',()=>{log('📦 Torrent download complete','success');document.getElementById('torrentStatus').textContent+=' ✅ Complete';});
      });
    }
    async function importTorrentFile(file){
      if(!State.conn){log('DuckDB not ready for import','warning');return;}
      file.getBuffer(async(err,buf)=>{
        if(err){log('Torrent read error: '+err,'error');return;}
        if(file.name.endsWith('.csv')){const text=new TextDecoder().decode(buf);const lines=text.split('\n');if(lines.length<2)return;let count=0;for(let i=1;i<Math.min(lines.length,10000);i++){const cols=lines[i].split(',');if(cols.length>=7){try{await State.conn.query(`INSERT INTO ohlc VALUES (?,?,?,?,?,?,?,?)`,[parseInt(cols[0])||Date.now(),cols[1]?.trim(),cols[2]?.trim(),parseFloat(cols[3])||0,parseFloat(cols[4])||0,parseFloat(cols[5])||0,parseFloat(cols[6])||0,parseFloat(cols[7])||0]);count++;}catch(e){}}}log(`📊 Imported ${count} rows into DuckDB`,'success');}
        else if(file.name.endsWith('.parquet')){try{const u8=new Uint8Array(buf);await State.db.registerFileBuffer(file.name,u8);await State.conn.query(`CREATE OR REPLACE TABLE ohlc AS SELECT * FROM read_parquet('${file.name}')`);log(`📊 Parquet file loaded into DuckDB`,'success');}catch(e){log('Parquet import error: '+e.message,'error');}}
      });
    }
    const TRUSTED_IPNS_KEY='k51qzi5uqu5diz72xk75rwuk7buwxz92q3eg9l62i8l7b6wz18bc7a8d4p63qn';
    document.getElementById('trustedKey').textContent=TRUSTED_IPNS_KEY.slice(0,12)+'...';
    async function checkIPNSUpdate(){
      document.getElementById('ipnsStatus').textContent='Checking...';
      try{const res=await fetch(`https://gateway.ipfs.io/ipns/${TRUSTED_IPNS_KEY}`,{method:'HEAD'});if(res.ok){const cid=res.url.split('/ipfs/')[1]?.split('?')[0];document.getElementById('ipnsStatus').textContent=`Latest CID: ${cid?.slice(0,10)}...`;log('☁️ IPNS resolved: '+cid?.slice(0,10)+'...','success');}else{document.getElementById('ipnsStatus').textContent='Resolve failed';}}
      catch(e){document.getElementById('ipnsStatus').textContent='Gateway unreachable';log('☁️ IPNS check error: '+e.message,'error');}
    }
    function generateQRCode(){
      const url=window.location.href;const canvas=document.getElementById('qrCanvas');
      try{QRCode.toCanvas(canvas,url,{width:200,margin:1},(err)=>{if(err)log('QR error: '+err,'error');});}catch(e){log('QR generation failed','error');}
    }
    async function initYjs(){
      try{
        State.ydoc=new Y.Doc();State.yPlayers=State.ydoc.getMap('players');
        const signaling=['wss://y-webrtc-signaling-eu.herokuapp.com'];
        const webrtcProvider=new WebrtcProvider('quantm-foam-v23',State.ydoc,{signaling});window.yProvider=webrtcProvider;
        if(!State.yPlayers.has(NODE_ID)){State.yPlayers.set(NODE_ID,new Y.Map());}
        State.ymap=State.yPlayers.get(NODE_ID);
        State.yPlayers.observe(()=>{const now={};State.yPlayers.forEach((map,id)=>{if(id!==NODE_ID){now[id]=map.toJSON();}});State.otherPlayers=now;UI.renderPlayerList();});
        syncStateToYjs();log('🧠 Yjs swarm joined (multi‑profile)','success');
      }catch(e){log('⚠️ Yjs failed, game state is local only','warning');}
    }
    function syncStateToYjs(){
      if(!State.ymap)return;
      State.ymap.set('handle',playerHandle);State.ymap.set('level',State.level);State.ymap.set('matrix',State.matrix);
      State.ymap.set('bankroll',State.bankroll);State.ymap.set('qFund',State.qFund);State.ymap.set('lFund',State.lFund);
      State.ymap.set('tradeLedger',State.tradeLedger.slice(0,10));State.ymap.set('basketHoldings',State.basketHoldings);State.ymap.set('mana',State.mana);
    }
    function addMana(type,amount=1){State.mana[type]+=amount;UI.updateManaDisplay();if(State.ymap){State.ymap.set('mana',State.mana);}}
    function initDEX(){if(!State.ydoc)return;const yOrders=State.ydoc.getArray('dexOrders');yOrders.observe(()=>renderDEXOrderBook(yOrders));window.yDexOrders=yOrders;renderDEXOrderBook(yOrders);}
    function placeDEXOrder(side='buy'){
      const coin=document.getElementById('dexCoin').value.trim().toUpperCase();
      const amount=parseFloat(document.getElementById('dexAmount').value);
      if(!coin||!amount||amount<=0)return;
      if(!window.yDexOrders){log('DEX not initialized','warning');return;}
      window.yDexOrders.push([{id:Date.now()+Math.random(),side,coin,amount,user:NODE_ID.slice(0,8),handle:playerHandle,timestamp:Date.now()}]);
      addMana('trade',2);document.getElementById('dexCoin').value='';document.getElementById('dexAmount').value='';log(`💱 DEX ${side}: ${amount} ${coin}`,'success');
    }
    function renderDEXOrderBook(yOrders){
      const el=document.getElementById('dexOrderBook');if(!el)return;const orders=yOrders.toArray();
      if(!orders.length){el.innerHTML='<div style="color:#666;">No orders yet</div>';return;}
      el.innerHTML=orders.slice(-20).map(o=>{const color=o.side==='buy'?'var(--green)':'#ff4444';return`<div style="margin:2px 0;"><span style="color:${color}">${o.side==='buy'?'🟢 BUY':'🔴 SELL'}</span> ${o.amount} ${o.coin} <small style="color:#666;">(${o.handle||o.user})</small></div>`;}).join('');
    }
    function createPrivateRoom(){if(State.level<10)return;const roomKey=prompt('Enter room encryption key (or leave blank for auto-generate):');const key=roomKey||('room_'+Math.random().toString(36).substr(2,8));document.getElementById('privateRoomInfo').innerHTML=`🔐 Room created!<br>Key: <strong>${key}</strong><br><small>Share this key with collaborators. (Full encryption in next release.)</small>`;log('🔐 Private strategy room created','success');}

    // ── API Keys Modal (v22.30) ────────────────────
    const API_KEY_EXCHANGES=['binance','okx','kucoin','bybit','kraken','coinbase','gemini','uniswap_sepolia','pancake_test','sushi_test'];
    function openApiKeysModal(){
      const list=document.getElementById('apiKeyList');
      list.innerHTML=API_KEY_EXCHANGES.map(ex=>{const key=State.apiKeys[ex]||'';const checked=!!key;return`<div class="flex-row" style="margin:4px 0;"><label><input type="checkbox" class="api-enable" data-ex="${ex}" ${checked?'checked':''}> ${ex.toUpperCase()}</label><input type="text" class="api-key-input" data-ex="${ex}" value="${key}" placeholder="API key" style="width:200px;"></div>`;}).join('');
      document.getElementById('apiKeysModal').style.display='flex';
    }
    function closeApiKeysModal(){document.getElementById('apiKeysModal').style.display='none';}
    function saveApiKeysFromModal(){
      const enables=document.querySelectorAll('.api-enable'),inputs=document.querySelectorAll('.api-key-input');
      State.apiKeys={};
      enables.forEach((cb,i)=>{if(cb.checked&&inputs[i].value.trim()){State.apiKeys[cb.dataset.ex]=inputs[i].value.trim();}});
      State.save();closeApiKeysModal();log('🔑 API keys saved');
    }

    function openCreateCoinModal(){if(State.level<5){alert('Need level 5!');return;}if(State.userCoins.length>=1&&State.level<15){alert('Need level 15 for a second coin!');return;}UI.renderCoinExCheckboxes();UI.updateCoinCooldown();document.getElementById('createCoinModal').style.display='flex';}
    function closeCreateCoinModal(){document.getElementById('createCoinModal').style.display='none';}
    document.getElementById('createCoinBtn').addEventListener('click',()=>{
      const s=document.getElementById('newCoinSymbol').value.trim().toUpperCase();if(!s)return;
      const cooldown=State.getCoinCooldown();if(Date.now()-State.lastCoinCreateTime<cooldown*1000){log('⏳ Coin creation cooldown active','warning');return;}
      if(State.userCoins.length>=1&&State.level<15){alert('Need level 15 for a second coin!');return;}
      const pr=parseFloat(document.getElementById('newCoinPrice').value)||0.000001;
      const liq=parseFloat(document.getElementById('newCoinLiq').value)||500;
      const quote=document.getElementById('newCoinQuote').value||'USDT';
      const exchanges=State.coinExchangeList.length?State.coinExchangeList:['QUANTM_DEX'];
      State.userCoins.push({symbol:s,price:pr,liq,quote,exchange:exchanges[0]});
      exchanges.forEach(exName=>{State.allPairs.push({base:s,target:quote,price:pr,volume:liq*0.3,liquidity:liq,bidPrice:pr*0.95,askPrice:pr*1.05,exchange:exName,exchangeType:exName==='QUANTM_DEX'?'dex':'cex'});});
      State.stats.totalPairs+=exchanges.length;State.lastCoinCreateTime=Date.now();State.save();closeCreateCoinModal();
      log(`🪙 ${s} created on ${exchanges.join(', ')}! Cooldown: ${cooldown}s`,'success');
      State.matrix+=50;State.level=Math.floor(Math.sqrt(State.matrix/10))+1;UI.updateProfile();UI.updateCoinCooldown();
    });

    function openPumpLaunchModal(){if(State.level<7){alert('Need level 7 for Pump Launch!');return;}document.getElementById('pumpLaunchModal').style.display='flex';}
    function closePumpLaunchModal(){document.getElementById('pumpLaunchModal').style.display='none';}
    document.getElementById('pumpLaunchBtn').addEventListener('click',()=>{
      const name=document.getElementById('pumpTokenName').value.trim();
      const symbol=document.getElementById('pumpTokenSymbol').value.trim().toUpperCase();
      if(!name||!symbol){alert('Name and symbol required');return;}
      const desc=document.getElementById('pumpTokenDesc').value.trim();
      const image=document.getElementById('pumpTokenImage').value.trim();
      const apiUrl=document.getElementById('pumpApiUrl').value.trim();
      log(`🚀 Launching ${symbol} on Pump.fun (${apiUrl})...`,'success');
      State.userCoins.push({symbol,price:0.0000001,liq:1000,quote:'SOL',exchange:'pumpfun'});
      State.allPairs.push({base:symbol,target:'SOL',price:0.0000001,volume:300,liquidity:1000,bidPrice:0.000000095,askPrice:0.000000105,exchange:'pumpfun',exchangeType:'cex'});
      State.stats.totalPairs++;State.save();closePumpLaunchModal();
      log(`🚀 ${symbol} launched on Pump.fun!`,'success');
      State.matrix+=100;State.level=Math.floor(Math.sqrt(State.matrix/10))+1;UI.updateProfile();
    });

    function copyShareURL(){navigator.clipboard.writeText(window.location.href).then(()=>log('📋 URL copied!','success')).catch(()=>log('Copy failed','error'));}

    // ── Bootstrap ──────────────────────────────────
    window.addEventListener('load',async()=>{
      State.load();
      const savedScale=localStorage.getItem('uiScale')||10;
      document.getElementById('uiScaleSlider').value=savedScale;
      setUIScale(savedScale);
      document.getElementById('playerHandle').value=playerHandle;
      log('🎰 v23.30 ready – Unified Swarm + Trading Terminal','success');
      document.getElementById('logs').style.display='block';
      UI.updateProxyStatus();UI.renderFiatCheckboxes();
      document.getElementById('slotDepthLabel2').textContent=document.getElementById('pathInput').value;
      UI.applyLevelConstraints();updateIntraExCheckboxes();UI.renderBasketTracker();UI.renderBatchHistory();
      UI.renderLiveTrades();UI.renderCoinLevels();
      document.getElementById('modeLabel').textContent=State.liveMode?(State.liveTestMode?'TESTNET':'LIVE'):'PAPER';
      rebuildExchangeDefinitions();
      await initDuckDB();await initYjs();initDEX();
      UI.updateManaDisplay();UI.updateProfile();
      window.addEventListener('qfm-trade',()=>addMana('trade',5));
      window.addEventListener('qfm-scan',()=>addMana('compute',1));
      const origFetch=window.fetch;window.fetch=function(...args){addMana('data',1);return origFetch.apply(this,args);};
      setTimeout(generateQRCode,1000);
    });
    window.addEventListener('beforeunload',()=>{State.save();if(State.graphRenderer&&State.graphRenderer.animRAF)cancelAnimationFrame(State.graphRenderer.animRAF);});

    // Expose globals
    window.initSystem=initSystem;window.runFullScan=runFullScan;window.toggleLiveScan=toggleLiveScan;
    window.connectAllWebSockets=connectAllWebSockets;window.openCreateCoinModal=openCreateCoinModal;
    window.closeCreateCoinModal=closeCreateCoinModal;window.toggleLogs=toggleLogs;window.shareJackpot=shareJackpot;
    window.toggleTheme=toggleTheme;window.syncBetInput=syncBetInput;window.syncBetSlider=syncBetSlider;
    window.selectAllIntra=selectAllIntra;window.deselectAllIntra=deselectAllIntra;window.fetchForexRates=fetchForexRates;
    window.closeModal=closeModal;window.saveProxyConfig=saveProxyConfig;window.setTargetPreset=setTargetPreset;
    window.toggleSection=toggleSection;window.setPlayerHandle=setPlayerHandle;window.copyShareURL=copyShareURL;
    window.addTorrentFromInput=addTorrentFromInput;window.executeDBQuery=executeDBQuery;
    window.checkIPNSUpdate=checkIPNSUpdate;window.placeDEXOrder=placeDEXOrder;
    window.createPrivateRoom=createPrivateRoom;window.toggleIntraEx=toggleIntraEx;
    window.openApiKeysModal=openApiKeysModal;window.closeApiKeysModal=closeApiKeysModal;
    window.saveApiKeysFromModal=saveApiKeysFromModal;window.toggleTestnets=toggleTestnets;
    window.togglePauseLogs=togglePauseLogs;

    log('🎭 QuanTM FOAM v23.30 – All systems integrated and tested. The unified swarm awaits.','success');
  </script>
</body>
</html>
