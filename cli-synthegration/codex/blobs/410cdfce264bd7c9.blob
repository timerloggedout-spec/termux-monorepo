graph TD
    subgraph DevOps["Admin Updates via IPFS/IPNS"]
        Dev["Developer"] -->|ipfs.name.publish| IPNS["IPNS Pointer"]
        IPNS --> Browsers["All Browser Peers"]
    end

    subgraph DataIngestion["Data Ingestion Layer (Current → Future)"]
        CEX["CEXs<br/>OKX,Binance,Coinbase,..."] -->|REST + WS via Proxy| Proxy["CORS Proxy / Wallet Proxy"]
        DEX["DEXs (DexScreener → Uniswap v3, Sushi)"]
        DEX -->|REST via Proxy| Proxy
        DEX -->|"Future: The Graph / RPC"| Validator["P2P Validator Node"]
        Proxy --> Client["Browser Client (Current)"]
        Validator -->|"GossipSub publish"| Mesh["GossipSub Mesh (P2P)"]
    end

    subgraph P2PLayer["P2P Data Distribution (Evolved)"]
        Seed["Admin Seeds"] -->|Magnet Link| TorrentSwarm["WebTorrent Swarm"]
        Mesh --> Peers["Browser Peers"]
        Peers <-->|WebTorrent| TorrentSwarm
        Peers <-->|"y-webrtc (game state)"| Peers
    end

    subgraph ClientInternals["Inside Each Browser (v22.21 + P2P)"]
        Fetcher["smartFetch + Proxy Rotation"] --> AllPairs["State.allPairs"]
        WS["WebSocket Tickers"] --> RingBuf["Ring Buffer / μts"]
        AllPairs --> GraphBuilder["buildGraph()"]
        GraphBuilder --> DuckDB["DuckDB-Wasm (future)"]
        RingBuf --> DuckDB
        GraphBuilder --> inMemGraph["In-Memory Graph"]
        inMemGraph --> ArbiScan["Triangular & Bellman‑Ford"]
        ArbiScan --> OppsUI["Opportunities UI"]
        DuckDB --> Backtest["Backtest Engine (Web Worker)"]
        Yjs["Yjs CRDT Doc"] --> IndexedDB["IndexedDB Persistence"]
        IndexedDB --> GameState["Level, XP, Perks, Ledger"]
        GameState --> UI["React/Vue UI"]
        GraphRenderer["GraphRenderer (canvas)"] --> UI
        ComputeWorkers["Web Workers"] --> Backtest & ArbiScan
        WebRTC["WebRTC DataChannel"] -.-> ComputeWorkers
    end

    Browsers -.->|Future: pull from IPFS swarm| IPNS
    Browsers --> Proxy
