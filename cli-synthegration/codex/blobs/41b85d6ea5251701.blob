<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>Global Regulatory Intelligence – All Data Fields</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        .sidebar-mobile { transform: translateX(-100%); transition: transform 0.3s ease; }
        .sidebar-mobile.open { transform: translateX(0); }
        .detail-panel { transform: translateX(100%); transition: transform 0.3s ease; }
        .detail-panel.open { transform: translateX(0); }
    </style>
</head>
<body class="bg-gray-50 dark:bg-gray-900 text-gray-900 dark:text-gray-100">

<div id="app" class="flex flex-col md:flex-row min-h-screen">
    <!-- Mobile header -->
    <div class="md:hidden bg-gray-900 text-white p-4 flex justify-between items-center sticky top-0 z-20">
        <div class="flex items-center gap-2 font-bold text-lg"><i data-lucide="activity" class="w-5 h-5 text-indigo-400"></i><span>RegIntel</span></div>
        <button id="menuBtn" class="p-2"><i data-lucide="menu" class="w-6 h-6"></i></button>
    </div>

    <!-- Sidebar -->
    <nav id="sidebar" class="sidebar-mobile fixed md:static top-0 left-0 h-full w-64 bg-gray-900 text-gray-300 z-30 flex-shrink-0 overflow-y-auto">
        <div class="p-6 hidden md:flex items-center text-white font-bold text-xl gap-2"><i data-lucide="activity" class="w-6 h-6 text-indigo-400"></i><span>RegIntel</span></div>
        <div class="px-4 pb-6 space-y-2">
            <button data-tab="matrix" class="tab-btn w-full flex items-center px-4 py-3 rounded-lg hover:bg-gray-800 hover:text-white"><i data-lucide="database" class="w-5 h-5 mr-3"></i> Regulatory Matrix</button>
            <button data-tab="map" class="tab-btn w-full flex items-center px-4 py-3 rounded-lg hover:bg-gray-800 hover:text-white"><i data-lucide="map" class="w-5 h-5 mr-3"></i> World Map</button>
            <button data-tab="trials" class="tab-btn w-full flex items-center px-4 py-3 rounded-lg hover:bg-gray-800 hover:text-white"><i data-lucide="flask-conical" class="w-5 h-5 mr-3"></i> Clinical Trials</button>
            <button data-tab="ror" class="tab-btn w-full flex items-center px-4 py-3 rounded-lg hover:bg-gray-800 hover:text-white"><i data-lucide="building-2" class="w-5 h-5 mr-3"></i> Research Orgs</button>
        </div>
    </nav>

    <!-- Main content -->
    <main class="flex-1 p-4 md:p-6 overflow-y-auto">
        <div id="matrixView" class="tab-content"></div>
        <div id="mapView" class="tab-content hidden"></div>
        <div id="trialsView" class="tab-content hidden"></div>
        <div id="rorView" class="tab-content hidden"></div>
        <div id="loading" class="flex justify-center items-center h-64">Loading data from Google Sheets...</div>
    </main>

    <!-- Detail panel -->
    <div id="detailPanel" class="detail-panel fixed inset-y-0 right-0 w-full md:w-[600px] bg-white dark:bg-gray-800 shadow-xl z-50 overflow-y-auto"></div>
</div>

<script>
// ================= CONFIG =================
const API_URL = "YOUR_APPS_SCRIPT_WEB_APP_URL"; // Replace with your deployed URL
const GEO_URL = "https://cdn.jsdelivr.net/npm/world-atlas@2/countries-110m.json";

// Country -> jurisdiction key mapping (full list from previous code – abbreviated here)
const countryMap = {
    USA: "us", CAN: "ca", GBR: "uk", AUS: "au", JPN: "jp", RUS: "ru",
    FRA: "eu", DEU: "eu", ITA: "eu", ESP: "eu", NLD: "eu", BEL: "eu",
    // ... add all 190+ countries (use the complete mapping from the earlier project)
};
const regulatoryTiers = { USA: "wla", CAN: "wla", GBR: "wla", JPN: "wla", AUS: "wla", SGP: "wla", ZAF: "wla", CHE: "wla" };
const statusColors = { approved: "#22c55e", investigational: "#3b82f6", unapproved: "#ef4444", withdraw: "#f59e0b", under_review: "#a78bfa", harmonised: "#818cf8", unknown: "#94a3b8" };

let compounds = [];
let selectedCompound = null;
let activeTab = "matrix";

// ================= FETCH DATA =================
async function fetchCompounds() {
    const res = await fetch(API_URL);
    return await res.json();
}

// ================= MATRIX VIEW (all columns) =================
function renderMatrixView() {
    const container = document.getElementById("matrixView");
    let search = "", filterType = "all", filterWADA = "all";
    const types = ["all", ...new Set(compounds.map(c => c.Entity_Type).filter(Boolean))];
    const wadaOptions = ["all", "prohibited", "permitted", "unknown"];

    function filtered() {
        return compounds.filter(c => {
            const matchSearch = !search || c.Canonical_Name?.toLowerCase().includes(search) || (c.Synonyms || "").toLowerCase().includes(search);
            const matchType = filterType === "all" || c.Entity_Type === filterType;
            const matchWADA = filterWADA === "all" || (c.WADA_Status || "unknown").toLowerCase() === filterWADA;
            return matchSearch && matchType && matchWADA;
        });
    }

    function render() {
        const data = filtered();
        container.innerHTML = `
            <div class="max-w-7xl mx-auto">
                <div class="mb-6 flex flex-col md:flex-row md:items-center justify-between gap-4">
                    <div><h1 class="text-3xl font-bold">Global Regulatory Matrix</h1><p class="text-gray-500">Peptides, hormones, gene therapies, anabolics, genetics – all fields</p></div>
                    <button id="exportBtn" class="inline-flex items-center px-4 py-2 bg-white dark:bg-gray-800 border rounded-lg"><i data-lucide="download" class="w-4 h-4 mr-2"></i> Export CSV</button>
                </div>
                <div class="bg-white dark:bg-gray-800 rounded-xl shadow p-4 mb-6 flex flex-wrap gap-4">
                    <div class="relative flex-1"><i data-lucide="search" class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 w-5 h-5"></i><input id="searchInput" placeholder="Search..." class="w-full pl-10 pr-4 py-2 rounded-lg border dark:bg-gray-900"></div>
                    <select id="typeFilter" class="px-4 py-2 rounded-lg border dark:bg-gray-900">${types.map(t => `<option value="${t}">${t === "all" ? "All Types" : t}</option>`).join("")}</select>
                    <select id="wadaFilter" class="px-4 py-2 rounded-lg border dark:bg-gray-900">${wadaOptions.map(o => `<option value="${o}">${o === "all" ? "All WADA" : o}</option>`).join("")}</select>
                    <div class="ml-auto text-sm self-center">${data.length} of ${compounds.length}</div>
                </div>
                <div class="bg-white dark:bg-gray-800 rounded-xl shadow overflow-x-auto">
                    <table class="w-full text-sm">
                        <thead class="bg-gray-50 dark:bg-gray-700"><tr><th class="px-4 py-3 text-left">Compound</th><th class="px-4 py-3 text-left">Type</th><th class="px-4 py-3 text-center">US</th><th class="px-4 py-3 text-center">EU</th><th class="px-4 py-3 text-center">WADA</th></tr></thead>
                        <tbody>${data.map(c => `<tr class="border-t hover:bg-gray-50 cursor-pointer" data-id="${c.Entity_ID}"><td class="px-4 py-3"><div class="font-medium">${c.Canonical_Name}</div><div class="text-xs text-gray-500">${c.Entity_ID}</div></td><td class="px-4 py-3">${c.Entity_Type || "—"}</td><td class="px-4 py-3 text-center"><span class="px-2 py-1 rounded-full text-xs ${getStatusClass(c.US_FDA_Status)}">${c.US_FDA_Status || "unknown"}</span></td><td class="px-4 py-3 text-center"><span class="px-2 py-1 rounded-full text-xs ${getStatusClass(c.EU_EMA_Status)}">${c.EU_EMA_Status || "unknown"}</span></td><td class="px-4 py-3 text-center"><span class="px-2 py-1 rounded-full text-xs ${getWadaClass(c.WADA_Status)}">${c.WADA_Status || "unknown"}</span></td></tr>`).join("")}</tbody>
                    </table>
                </div>
            </div>
        `;
        lucide.createIcons();
        document.querySelectorAll("#matrixView tbody tr").forEach(tr => tr.addEventListener("click", () => showDetail(compounds.find(c => c.Entity_ID === tr.dataset.id))));
        document.getElementById("searchInput").addEventListener("input", (e) => { search = e.target.value.toLowerCase(); render(); });
        document.getElementById("typeFilter").addEventListener("change", (e) => { filterType = e.target.value; render(); });
        document.getElementById("wadaFilter").addEventListener("change", (e) => { filterWADA = e.target.value; render(); });
        document.getElementById("exportBtn").addEventListener("click", () => exportToCSV(data));
    }
    render();
}

function getStatusClass(s) { return { approved: "bg-green-100 text-green-800", investigational: "bg-blue-100 text-blue-800", unapproved: "bg-red-100 text-red-800" }[s] || "bg-gray-100 text-gray-800"; }
function getWadaClass(s) { return s === "prohibited" ? "bg-red-100 text-red-800" : s === "permitted" ? "bg-green-100 text-green-800" : "bg-gray-100 text-gray-800"; }
function exportToCSV(data) { /* same as before */ }

// ================= DETAIL PANEL (ALL FIELDS) =================
function showDetail(c) {
    selectedCompound = c;
    const panel = document.getElementById("detailPanel");
    panel.innerHTML = `
        <div class="p-6">
            <div class="flex justify-between items-start"><div><h2 class="text-2xl font-bold">${c.Canonical_Name}</h2><p class="text-sm text-gray-500">${c.Entity_ID} · ${c.Entity_Type} · ${c.Modality || ""}</p></div><button id="closeDetail" class="p-2 hover:bg-gray-100 rounded-lg"><i data-lucide="x" class="w-5 h-5"></i></button></div>
            ${c.Synonyms ? `<div class="mb-4 p-3 bg-gray-50 dark:bg-gray-700 rounded-lg"><span class="font-medium">Synonyms:</span> ${c.Synonyms}</div>` : ""}
            <div class="grid grid-cols-2 gap-4 mb-4"><div><h3 class="text-xs font-semibold uppercase">Mechanism</h3><p class="text-sm">${c.Mechanism_Summary || "—"}</p></div><div><h3 class="text-xs font-semibold uppercase">Development Stage</h3><p class="text-sm">${c.Development_Stage_Global || "—"}</p></div></div>
            <div class="mb-4"><h3 class="text-xs font-semibold uppercase mb-2">Jurisdiction Status</h3><div class="grid grid-cols-2 md:grid-cols-3 gap-2">${["US","EU","CA","AU","UK","JP","RU"].map(j => `<div class="border rounded-lg p-2"><div class="text-xs text-gray-500">${j}</div><div class="font-medium text-sm">${c[`${j}_FDA_Status`] || c[`${j}_EMA_Status`] || "unknown"}</div><div class="text-xs text-gray-500">${c[`${j}_Legal_Access`] || ""}</div><div class="text-xs">${c[`${j}_Notes`] || ""}</div></div>`).join("")}</div></div>
            <div class="mb-4 p-4 bg-red-50 dark:bg-red-900/20 border rounded-lg"><h3 class="text-sm font-semibold text-red-800">WADA Anti-Doping</h3><div class="grid grid-cols-2 gap-2 text-sm mt-2"><div>Status: <span class="font-medium">${c.WADA_Status || "unknown"}</span></div><div>Category: ${c.WADA_Category || "—"}</div><div>In-Competition: ${c.WADA_In_Competition === "TRUE" ? "Prohibited" : "Permitted"}</div><div>Out-of-Competition: ${c.WADA_Out_Competition === "TRUE" ? "Prohibited" : "Permitted"}</div></div></div>
            <div class="mb-4"><h3 class="text-xs font-semibold uppercase">Key Risks</h3><p class="text-sm">${c.Key_Regulatory_Risks || "—"}</p></div>
            <div class="text-xs text-gray-500">Last verified: ${c.Last_Verified || "unknown"}<br>Source: <a href="${c.Source_URL || "#"}" target="_blank" class="text-indigo-600">${c.Source_URL ? "View source" : "—"}</a></div>
        </div>
    `;
    panel.classList.add("open");
    lucide.createIcons();
    document.getElementById("closeDetail").onclick = () => { panel.classList.remove("open"); selectedCompound = null; };
}

// ================= MAP, TRIALS, ROR (same as before, with map using selectedCompound) =================
async function renderMapView() { /* same as previous – uses selectedCompound for coloring */ }
function searchClinicalTrials(query, country) { /* same */ }
function searchROR(query, country) { /* same */ }

// ================= TAB HANDLING =================
function setActiveTab(tab) {
    activeTab = tab;
    document.querySelectorAll(".tab-content").forEach(el => el.classList.add("hidden"));
    document.getElementById(`${tab}View`).classList.remove("hidden");
    if (tab === "map") renderMapView();
    document.querySelectorAll(".tab-btn").forEach(btn => {
        if (btn.dataset.tab === tab) btn.classList.add("bg-indigo-600", "text-white");
        else btn.classList.remove("bg-indigo-600", "text-white");
    });
}

// ================= INIT =================
window.onload = async () => {
    compounds = await fetchCompounds();
    document.getElementById("loading").style.display = "none";
    renderMatrixView();
    setActiveTab("matrix");
    lucide.createIcons();

    // Setup trial and ROR search UI (same as before)
    document.getElementById("trialsView").innerHTML = `<div class="bg-white dark:bg-gray-800 p-6 rounded-xl shadow mb-6"><div class="flex flex-col md:flex-row gap-4"><input id="trialQuery" placeholder="Condition / Intervention" class="flex-1 px-4 py-2 rounded-lg border dark:bg-gray-900"><input id="trialCountry" placeholder="Country" class="flex-1 px-4 py-2 rounded-lg border dark:bg-gray-900"><button id="searchTrialsBtn" class="px-6 py-2 bg-indigo-600 text-white rounded-lg">Search</button></div></div><div id="trialsResults"></div>`;
    document.getElementById("rorView").innerHTML = `<div class="bg-white dark:bg-gray-800 p-6 rounded-xl shadow mb-6"><div class="flex flex-col md:flex-row gap-4"><input id="rorQuery" placeholder="Organization name" class="flex-1 px-4 py-2 rounded-lg border dark:bg-gray-900"><input id="rorCountry" placeholder="Country" class="flex-1 px-4 py-2 rounded-lg border dark:bg-gray-900"><button id="searchRorBtn" class="px-6 py-2 bg-indigo-600 text-white rounded-lg">Search</button></div></div><div id="rorResults"></div>`;
    document.getElementById("searchTrialsBtn").onclick = () => searchClinicalTrials(document.getElementById("trialQuery").value, document.getElementById("trialCountry").value);
    document.getElementById("searchRorBtn").onclick = () => searchROR(document.getElementById("rorQuery").value, document.getElementById("rorCountry").value);

    document.getElementById("menuBtn").onclick = () => document.getElementById("sidebar").classList.toggle("open");
    document.querySelectorAll(".tab-btn").forEach(btn => btn.onclick = () => setActiveTab(btn.dataset.tab));
};
</script>
</body>
</html>
