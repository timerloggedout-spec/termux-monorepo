findRate(fromCurrency, toCurrency, pairs) {
    for (const pair of pairs) {
        // Check direct pair: fromCurrency base, toCurrency in target as quote
        if (pair.base === fromCurrency) {
            const quoteCurrency = pair.target.split('/')[1];
            if (quoteCurrency === toCurrency) {
                return pair.last;
            }
        }
        // Check inverse pair: toCurrency base, fromCurrency in target as quote
        if (pair.base === toCurrency) {
            const quoteCurrency = pair.target.split('/')[1];
            if (quoteCurrency === fromCurrency) {
                return 1 / pair.last;
            }
        }
    }
    return null;
}
