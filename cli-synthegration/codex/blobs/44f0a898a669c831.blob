// --- UI Controller additions ---
const UI = {
    log(msg,type='info'){ /* ... same as v21 */ },
    toggleSlot(){ document.getElementById('slotMachine').style.display = (document.getElementById('slotMachine').style.display==='none')?'block':'none'; },
    syncPathInput(){ document.getElementById('pathInput').value = document.getElementById('pathSlider').value; saveAll(); },
    syncPathSlider(){ document.getElementById('pathSlider').value = document.getElementById('pathInput').value; saveAll(); },
    syncBetInput(){ document.getElementById('betInput').value = document.getElementById('betSlider').value; },
    syncBetSlider(){ document.getElementById('betSlider').value = document.getElementById('betInput').value; },
    toggleLiveMode(){
        state.liveMode = document.getElementById('liveToggle').checked;
        document.getElementById('mainStatus').style.color = state.liveMode ? 'var(--green)' : 'var(--cyan)';
        log(`System switched to ${state.liveMode ? 'LIVE' : 'VIRTUAL'} mode.`);
        saveAll();
    },
    // trade modal modified to include compounding math
    openTradeModal(oppStr){
        const opp=JSON.parse(decodeURIComponent(oppStr));
        const bet=parseFloat(document.getElementById('betInput').value)||1000;
        const tradeSize=Math.min(opp.maxTradeSize,bet);
        let runningTotal = tradeSize;
        let mathString = `💰 Starting Balance: $${tradeSize.toFixed(2)}<br>`;
        const detailsHtml = opp.edges.map((edge,i)=>{
            const prevTotal = runningTotal;
            runningTotal *= edge.rate;
            mathString += ` Hop ${i+1}: $${prevTotal.toFixed(2)} × ${edge.rate.toFixed(6)} → $${runningTotal.toFixed(2)}<br>`;
            const depthPct = Math.min(1, tradeSize/(edge.liquidity+1));
            const depthColor = depthPct>0.8?'#ff4444':depthPct>0.5?'#ffaa00':'var(--cyan)';
            return `<div style="margin:5px 0;padding:8px;background:#111;border-radius:5px;">
                <strong>${opp.path[i]} → ${opp.path[i+1]}</strong> <span class="chip">${edge.exchangeType.toUpperCase()}</span>
                <div class="depth-chart">${Array.from({length:10}).map((_,j)=>{
                    const level=(j+1)/10;
                    const active=level<=depthPct;
                    return `<div class="depth-bar" style="height:${active?25:5}px;background:${active?depthColor:'#333'};" title="Depth ${(level*100).toFixed(0)}%"></div>`;
                }).join('')}</div>
                <div style="font-size:9px;">Price: ${edge.rate.toFixed(6)} | Liq: $${edge.liquidity.toFixed(0)} | Depth: ${(depthPct*100).toFixed(1)}%</div>
            </div>`;
        }).join('');
        mathString += `<strong style="color:var(--green);">🏁 Final Amount: $${runningTotal.toFixed(2)}</strong>`;
        document.getElementById('tradeDetails').innerHTML = `<p>🔄 ${opp.path.join(' → ')}</p><p>💰 Trade: $${tradeSize.toFixed(2)}</p>${detailsHtml}
            <p style="color:var(--gold);">5% to Quantums Fund (visible) · 5% to Locked Fund</p>`;
        document.getElementById('compoundingMath').innerHTML = `<h4>📐 Compounding Logic (${opp.edges.length} hops)</h4>` + mathString;
        document.getElementById('executeTradeBtn').onclick = () => executeTrade(opp, tradeSize, runningTotal - tradeSize);
        document.getElementById('tradeModal').style.display = 'flex';
    },
    closeModal(){ document.getElementById('tradeModal').style.display='none'; }
};

// --- Engine additions ---
const Engine = {
    pullSlotLever(){
        if(!state.systemReady) return log('System not ready','error');
        UI.toggleSlot(); // ensure visible
        document.getElementById('slotResult').innerHTML = 'SPINNING...';
        // run scan and animate
        runFullScan().then(() => {
            const allOpps = Object.values(state.opportunities).flat();
            if(allOpps.length>0){
                const opp = allOpps[0];
                this.animateSlots(opp.path.slice(0,3), opp);
            } else {
                document.getElementById('slotResult').innerHTML = 'NO PATH FOUND';
            }
        });
    },
    animateSlots(symbols, opp){
        const reels = ['reel1','reel2','reel3'];
        let count = 0;
        const interval = setInterval(() => {
            reels.forEach(r => document.getElementById(r).innerHTML = `<div>${['SOL','BTC','ETH','DOGE','USDT'][Math.floor(Math.random()*5)]}</div>`);
            if(++count > 20){
                clearInterval(interval);
                reels.forEach((r,i) => document.getElementById(r).innerHTML = `<div>${symbols[i] || '?'}</div>`);
                document.getElementById('slotResult').innerHTML = `WIN! +${opp.profitPercent.toFixed(2)}% PATH`;
                UI.openTradeModal(encodeURIComponent(JSON.stringify(opp)));
            }
        }, 50);
    }
};

