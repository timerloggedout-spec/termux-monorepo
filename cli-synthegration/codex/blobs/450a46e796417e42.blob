// utils/export.js
import Papa from 'papaparse';
import { batchUpdateCompounds } from '../services/api';

export function exportToCSV(compounds) {
  const headers = ['Entity_ID', 'Canonical_Name', 'Entity_Type', 'Modality', 'US_FDA_Status', 'EU_EMA_Status', 'WADA_Status'];
  const rows = compounds.map(c => [
    c.id, c.name, c.type, c.modality, c.usStatus, c.euStatus, c.wadaStatus
  ]);
  const csvContent = [headers, ...rows].map(row => row.join(',')).join('\n');
  const blob = new Blob([csvContent], { type: 'text/csv' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = 'regulatory_matrix.csv';
  a.click();
  URL.revokeObjectURL(url);
}

export async function importFromCSV(file, onSuccess) {
  Papa.parse(file, {
    header: true,
    complete: async (results) => {
      const compounds = results.data.map(transformRawCompound);
      await batchUpdateCompounds(compounds);
      onSuccess(compounds.length);
    },
  });
}
