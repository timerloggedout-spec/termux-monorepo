import { useState, useCallback, useRef, useEffect } from "react";

// ─── Configuration (light‑client constants) ────────────────────────────────
const DATA_URL = process.env.REACT_APP_DATA_URL || "https://example.com/compounds.json";
// Replace with your IPFS gateway / OrbitDB endpoint
const CACHE_KEY = "compounds_cache";
const CACHE_TTL = 604800;         // 7 days (seconds)
const ANTHROPIC_KEY = process.env.REACT_APP_ANTHROPIC_KEY || "";
const ENRICH_FALLBACK = !ANTHROPIC_KEY;   // show mock enrichment if no key

// ─── Inline styles identical to original ────────────────────────────────────
const css = `...`;  // same CSS string as original (omitted for brevity)
// ─── Color helpers, Badge, JurisCell, SectionBlock, RiskChip – all unchanged

// ─── Fetch & freshness logic ────────────────────────────────────────────────
async function fetchFromNetwork() {
  const res = await fetch(DATA_URL);
  if (!res.ok) throw new Error(`Network response ${res.status}`);
  return res.json();   // expects an array of compounds following the original schema
}

function loadCache() {
  try {
    const raw = localStorage.getItem(CACHE_KEY);
    if (!raw) return null;
    const { data, timestamp } = JSON.parse(raw);
    if (Date.now() - timestamp < CACHE_TTL * 1000) {
      return data;
    }
  } catch (e) { /* ignore */}
  return null; // stale or missing
}

function saveCache(data) {
  localStorage.setItem(CACHE_KEY, JSON.stringify({ data, timestamp: Date.now() }));
}

