<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Streamer Dashboard – Watch &amp; Broadcast with Chat</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: system-ui, sans-serif;
      background: #0b0b0b;
      color: #fff;
      height: 100vh;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    /* Top toolbar */
    .toolbar {
      display: flex;
      gap: 10px;
      padding: 10px;
      background: #1a1a1a;
      align-items: center;
      flex-wrap: wrap;
    }
    .toolbar input {
      padding: 6px 10px;
      border-radius: 4px;
      border: 1px solid #333;
      background: #2a2a2a;
      color: #fff;
      width: 180px;
    }
    .toolbar button {
      padding: 6px 14px;
      border: none;
      border-radius: 4px;
      font-weight: bold;
      cursor: pointer;
    }
    .btn-go-live {
      background: #ff4d4d;
      color: white;
    }
    .btn-stop {
      background: #333;
      color: #ccc;
      display: none;
    }
    .status {
      margin-left: auto;
      font-size: 0.9rem;
    }
    .status span { color: #ff4d4d; }

    /* Main grid */
    .main-grid {
      flex: 1;
      display: flex;
      min-height: 0;
      overflow: hidden;
    }

    /* Left side – watched stream */
    .watch-panel {
      flex: 1 1 60%;
      display: flex;
      flex-direction: column;
      border-right: 1px solid #333;
      min-width: 300px;
    }
    .youtube-player {
      flex: 3;
      background: #000;
      position: relative;
    }
    .youtube-player iframe {
      width: 100%;
      height: 100%;
      border: none;
    }
    .watched-chat {
      flex: 1;
      border-top: 1px solid #333;
      min-height: 150px;
    }
    .watched-chat iframe {
      width: 100%;
      height: 100%;
      border: none;
      background: #181818;
    }

    /* Right side – your broadcast */
    .broadcast-panel {
      flex: 1 1 40%;
      display: flex;
      flex-direction: column;
      min-width: 280px;
    }
    .broadcast-preview {
      flex: 1;
      background: #111;
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 150px;
    }
    #localVideo {
      width: 100%;
      height: 100%;
      object-fit: contain;
      display: none;
    }
    .preview-placeholder {
      color: #555;
      font-size: 2rem;
    }
    .your-chat {
      flex: 1;
      border-top: 1px solid #333;
      display: flex;
      flex-direction: column;
      min-height: 150px;
    }
    .chat-header {
      padding: 6px 10px;
      background: #1f1f1f;
      font-weight: bold;
      font-size: 0.9rem;
      display: flex;
      justify-content: space-between;
    }
    .chat-messages {
      flex: 1;
      overflow-y: auto;
      padding: 8px;
      background: #0f0f0f;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .chat-message {
      word-break: break-word;
      font-size: 0.85rem;
    }
    .chat-message .author {
      font-weight: bold;
      color: #3ea6ff;
      margin-right: 6px;
    }
    .chat-input-area {
      display: flex;
      padding: 6px;
      border-top: 1px solid #333;
      background: #1a1a1a;
    }
    .chat-input-area input {
      flex: 1;
      padding: 6px;
      border-radius: 4px;
      border: none;
      background: #2a2a2a;
      color: white;
    }
    .chat-input-area button {
      margin-left: 6px;
      padding: 6px 12px;
      background: #3ea6ff;
      border: none;
      border-radius: 4px;
      font-weight: bold;
      cursor: pointer;
    }

    /* Resize handle (simple drag) */
    .resize-handle {
      width: 4px;
      background: #333;
      cursor: col-resize;
    }
  </style>
</head>
<body>
  <div class="toolbar">
    <input id="watchVideoId" placeholder="YouTube Video ID (to watch)" value="jfKfPfyJRdk">
    <button id="loadWatchBtn">Load</button>
    <input id="ownVideoId" placeholder="Your live video ID (for chat)" value="">
    <button id="loadOwnChatBtn">Load Your Chat</button>
    <button id="goLiveBtn" class="btn-go-live">🔴 Go Live</button>
    <button id="stopLiveBtn" class="btn-stop">Stop Broadcast</button>
    <div class="status">Your stream: <span id="streamStatus">off</span></div>
  </div>

  <div class="main-grid">
    <!-- WATCH PANEL -->
    <div class="watch-panel" id="watchPanel">
      <div class="youtube-player" id="player"></div>
      <div class="watched-chat" id="watchedChatContainer">
        <iframe id="watchedChatIframe" style="display:none;" allow="autoplay; encrypted-media"></iframe>
        <div style="color:#666; padding:20px; text-align:center;">Enter a video ID and press "Load" to show live chat</div>
      </div>
    </div>
    <!-- RESIZE HANDLE -->
    <div class="resize-handle" id="resizeHandle"></div>
    <!-- BROADCAST PANEL -->
    <div class="broadcast-panel" id="broadcastPanel">
      <div class="broadcast-preview">
        <video id="localVideo" autoplay muted playsinline></video>
        <div id="previewPlaceholder" class="preview-placeholder">📷 Your camera preview</div>
      </div>
      <div class="your-chat" id="yourChatPanel">
        <div class="chat-header">
          <span>💬 Your broadcast chat</span>
          <span id="viewerCount">0 viewers</span>
        </div>
        <div class="chat-messages" id="yourChatMessages"></div>
        <div class="chat-input-area" id="viewerChatInputArea" style="display:none;">
          <input id="viewerChatInput" placeholder="Send a message as a viewer...">
          <button id="sendViewerMsgBtn">Send</button>
        </div>
        <div id="broadcasterNotice" style="padding:10px;color:#888;text-align:center;">
          Open another tab as a <b>viewer</b> and send messages here.
        </div>
      </div>
    </div>
  </div>

  <!-- YouTube IFrame API -->
  <script>
    // Load YouTube API
    const tag = document.createElement('script');
    tag.src = "https://www.youtube.com/iframe_api";
    const firstScriptTag = document.getElementsByTagName('script')[0];
    firstScriptTag.parentNode.insertBefore(tag, firstScriptTag);

    // ---------- YouTube Player ----------
    let player;
    window.onYouTubeIframeAPIReady = () => {
      player = new YT.Player('player', {
        videoId: '',
        playerVars: {
          autoplay: 1,
          controls: 1,
          modestbranding: 1,
        },
        events: {
          'onReady': () => loadWatchVideo(),
        }
      });
    };

    function loadWatchVideo() {
      const videoId = document.getElementById('watchVideoId').value.trim() || 'jfKfPfyJRdk';
      if (player && player.loadVideoById) {
        player.loadVideoById(videoId);
        // Also update watched chat iframe
        updateWatchedChat(videoId);
      }
    }

    document.getElementById('loadWatchBtn').addEventListener('click', loadWatchVideo);

    // ---------- Watched stream chat ----------
    function updateWatchedChat(videoId) {
      const iframe = document.getElementById('watchedChatIframe');
      const container = document.getElementById('watchedChatContainer');
      const placeholder = container.querySelector('div:not(#watchedChatIframe)');
      if (!videoId) {
        iframe.style.display = 'none';
        if (placeholder) placeholder.style.display = 'block';
        return;
      }
      // YouTube live chat embed (only works if live & chat enabled)
      iframe.src = `https://www.youtube.com/live_chat?v=${videoId}&embed_domain=${window.location.hostname}`;
      iframe.style.display = 'block';
      if (placeholder) placeholder.style.display = 'none';
    }

    // Optional: Load your own live chat (if you are actually live)
    document.getElementById('loadOwnChatBtn').addEventListener('click', () => {
      const ownVideoId = document.getElementById('ownVideoId').value.trim();
      // In a real setup, you'd embed your own chat. Here we just alert.
      if (ownVideoId) {
        alert(`To see your own live chat, embed: https://www.youtube.com/live_chat?v=${ownVideoId}`);
        // You could create a second iframe, but space is limited. This is just for demo.
      }
    });

    // ---------- Simulated Broadcast & Viewer Chat (BroadcastChannel) ----------
    const CHANNEL_NAME = 'streamer-dashboard';
    const bc = new BroadcastChannel(CHANNEL_NAME);
    const myId = Date.now().toString(36) + Math.random().toString(36).substr(2,5);
    const USER_TYPE = 'broadcaster'; // fixed in this tab; viewer tabs will be set differently

    // Broadcast state
    let localStream = null;
    let isLive = false;
    const localVideo = document.getElementById('localVideo');
    const goLiveBtn = document.getElementById('goLiveBtn');
    const stopLiveBtn = document.getElementById('stopLiveBtn');
    const streamStatus = document.getElementById('streamStatus');
    const placeholder = document.getElementById('previewPlaceholder');

    // Your chat elements
    const yourChatMessages = document.getElementById('yourChatMessages');
    const viewerCountSpan = document.getElementById('viewerCount');
    let viewerCount = 0;
    const viewerChatInputArea = document.getElementById('viewerChatInputArea');
    const viewerChatInput = document.getElementById('viewerChatInput');
    const sendViewerMsgBtn = document.getElementById('sendViewerMsgBtn');
    const broadcasterNotice = document.getElementById('broadcasterNotice');

    // Go Live (simulate broadcast)
    goLiveBtn.addEventListener('click', async () => {
      try {
        localStream = await navigator.mediaDevices.getUserMedia({ video: true, audio: true });
        localVideo.srcObject = localStream;
        localVideo.style.display = 'block';
        placeholder.style.display = 'none';
        isLive = true;
        goLiveBtn.style.display = 'none';
        stopLiveBtn.style.display = 'inline-block';
        streamStatus.textContent = 'live 🔴';
        streamStatus.style.color = '#ff4d4d';
        // Announce broadcast start
        bc.postMessage({ type: 'broadcast-start', broadcasterId: myId });
      } catch (err) {
        alert('Camera/mic access denied: ' + err.message);
      }
    });

    // Stop broadcast
    stopLiveBtn.addEventListener('click', () => {
      stopBroadcast();
    });

    function stopBroadcast() {
      if (localStream) {
        localStream.getTracks().forEach(track => track.stop());
        localStream = null;
      }
      localVideo.srcObject = null;
      localVideo.style.display = 'none';
      placeholder.style.display = 'flex';
      isLive = false;
      goLiveBtn.style.display = 'inline-block';
      stopLiveBtn.style.display = 'none';
      streamStatus.textContent = 'off';
      streamStatus.style.color = '';
      bc.postMessage({ type: 'broadcast-stop', broadcasterId: myId });
      // Reset viewers
      viewerCount = 0;
      updateViewerCount();
      yourChatMessages.innerHTML = '';
      broadcasterNotice.style.display = 'block';
    }

    // Handle BroadcastChannel messages
    bc.onmessage = (event) => {
      const msg = event.data;
      if (!msg || msg.broadcasterId === myId) return; // ignore own

      if (msg.type === 'broadcast-start') {
        // A broadcaster is live, we are a viewer now (simulated in another tab)
        // This tab is not the broadcaster; we could optionally auto-join as viewer.
        // But here we just update viewer count if we are the broadcaster tab.
        if (USER_TYPE === 'broadcaster') {
          // Received start from another tab? That shouldn't happen in same tab.
        }
      }
      else if (msg.type === 'broadcast-stop') {
        // Viewer disconnected
      }
      else if (msg.type === 'viewer-join') {
        if (USER_TYPE === 'broadcaster' && isLive) {
          viewerCount++;
          updateViewerCount();
        }
      }
      else if (msg.type === 'viewer-leave') {
        if (USER_TYPE === 'broadcaster' && isLive) {
          viewerCount = Math.max(0, viewerCount - 1);
          updateViewerCount();
        }
      }
      else if (msg.type === 'chat-message') {
        if (USER_TYPE === 'broadcaster' && isLive) {
          addChatMessage(msg.author, msg.text);
        }
      }
    };

    // Viewer simulation: another tab can send messages to the broadcaster
    // We'll detect if we are a "viewer" by checking a URL param ?viewer=true
    const urlParams = new URLSearchParams(window.location.search);
    const isViewerTab = urlParams.get('viewer') === 'true';

    if (isViewerTab) {
      // This tab acts as a viewer
      document.title = 'Viewer - Send Chat';
      // Hide the broadcast preview (viewer doesn't have camera)
      document.getElementById('broadcastPanel').style.display = 'none';
      // Show only the chat input area
      viewerChatInputArea.style.display = 'flex';
      broadcasterNotice.style.display = 'none';
      // Automatically join as viewer
      bc.postMessage({ type: 'viewer-join', viewerId: myId });
      window.addEventListener('beforeunload', () => {
        bc.postMessage({ type: 'viewer-leave', viewerId: myId });
      });

      // Send message
      sendViewerMsgBtn.addEventListener('click', sendViewerMessage);
      viewerChatInput.addEventListener('keypress', (e) => {
        if (e.key === 'Enter') sendViewerMessage();
      });
      function sendViewerMessage() {
        const text = viewerChatInput.value.trim();
        if (text) {
          bc.postMessage({ type: 'chat-message', author: 'Viewer_' + myId.slice(-4), text });
          viewerChatInput.value = '';
        }
      }
    } else {
      // Broadcaster tab: if a viewer joins, increment count
      // Listener already set up
    }

    function addChatMessage(author, text) {
      const msgDiv = document.createElement('div');
      msgDiv.className = 'chat-message';
      msgDiv.innerHTML = `<span class="author">${author}:</span>${text}`;
      yourChatMessages.appendChild(msgDiv);
      yourChatMessages.scrollTop = yourChatMessages.scrollHeight;
    }

    function updateViewerCount() {
      viewerCountSpan.textContent = `${viewerCount} viewer${viewerCount !== 1 ? 's' : ''}`;
      if (viewerCount > 0) {
        broadcasterNotice.style.display = 'none';
      } else {
        broadcasterNotice.style.display = 'block';
      }
    }

    // Cleanup
    window.addEventListener('beforeunload', () => {
      if (isLive) {
        bc.postMessage({ type: 'broadcast-stop', broadcasterId: myId });
      }
      if (localStream) {
        localStream.getTracks().forEach(track => track.stop());
      }
    });

    // ---------- Simple resize handler ----------
    const resizeHandle = document.getElementById('resizeHandle');
    const watchPanel = document.getElementById('watchPanel');
    const broadcastPanel = document.getElementById('broadcastPanel');
    let isResizing = false;

    resizeHandle.addEventListener('mousedown', (e) => {
      isResizing = true;
      document.body.style.cursor = 'col-resize';
    });

    document.addEventListener('mousemove', (e) => {
      if (!isResizing) return;
      const containerWidth = watchPanel.parentElement.getBoundingClientRect().width;
      let newLeftWidth = e.clientX - watchPanel.getBoundingClientRect().left;
      const minWidth = 300;
      if (newLeftWidth < minWidth) newLeftWidth = minWidth;
      if (containerWidth - newLeftWidth < minWidth) newLeftWidth = containerWidth - minWidth;
      watchPanel.style.flex = `0 0 ${newLeftWidth}px`;
      broadcastPanel.style.flex = '1 1 auto';
    });

    document.addEventListener('mouseup', () => {
      if (isResizing) {
        isResizing = false;
        document.body.style.cursor = '';
      }
    });
  </script>
</body>
</html>
