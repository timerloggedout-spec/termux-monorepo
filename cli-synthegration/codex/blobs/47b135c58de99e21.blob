const API_BASE = import.meta.env.VITE_API_URL || 'http://localhost:3001/api';

export async function fetchCompounds() {
  const response = await fetch(`${API_BASE}/compounds`);
  if (!response.ok) throw new Error(`HTTP ${response.status}`);
  return response.json();
}

export async function batchUpdateCompounds(compounds) {
  const response = await fetch(`${API_BASE}/compounds/batch`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ compounds }),
  });
  if (!response.ok) throw new Error(`HTTP ${response.status}`);
  return response.json();
}

export async function updateCompound(id, updates) {
  const response = await fetch(`${API_BASE}/compounds/${id}`, {
    method: 'PATCH',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(updates),
  });
  if (!response.ok) throw new Error(`HTTP ${response.status}`);
  return response.json();
}
