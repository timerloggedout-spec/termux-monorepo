# omni_client/core/router.py
from typing import Optional, Dict, Any

from omni_client.core.accounts import CustodialAccountStore
from omni_client.providers.ccxt_all import CCXTAllExchanges
# from omni_client.providers.pumpfun import PumpfunClient, etc.

class ExecutionRouter:
    """ 
    Routes high-level intents (spot order, NFT trade, perp order) to the right provider adapter, chain, and venue.
    """ 

    def __init__(self, accounts: CustodialAccountStore) -> None:
        self.accounts = accounts
        self.ccxt = CCXTAllExchanges(accounts)
        # self.pumpfun = PumpfunClient(...)
        # self.hyperliquid = HyperliquidClient(...)
        # self.nft_magiceden = MagicEdenClient(...)

    async def place_spot_order(
        self,
        user_id: str,
        venue: str,
        symbol: str,
        side: str,
        type_: str,
        amount: float,
        price: Optional[float] = None,
        params: Optional[Dict[str, Any]] = None,
    ) -> Dict[str, Any]:
        """ 
        Unified spot order entry point.
        """ 
        if venue in self.ccxt_cache or hasattr(__import__("ccxt"), venue):
            return self.ccxt.create_order(
                user_id=user_id,
                venue=venue,
                symbol=symbol,
                side=side,
                type_=type_,
                amount=amount,
                price=price,
                params=params,
            )
        # elif venue == "pumpfun":
        #     return await self.pumpfun.lightning_trade(...)
        # elif ... other venues
        else:
            raise ValueError(f"Unsupported venue: {venue}")
