if (!state.graph[pair.base]) state.graph[pair.base] = {};
if (!state.graph[pair.target]) state.graph[pair.target] = {};

const effectiveRate = pair.price * (1 - pair.bidAskSpread);

// If we already have an edge for base->target, compare and keep the one with the lower spread (or higher liquidity?).
if (!state.graph[pair.base][pair.target] || state.graph[pair.base][pair.target].spread > pair.bidAskSpread) {
  state.graph[pair.base][pair.target] = {
    rate: effectiveRate,
    weight: -Math.log(effectiveRate),
    volume: pair.volume,
    liquidity: pair.liquidity,
    spread: pair.bidAskSpread,
    exchange: key // store the exchange key
  };
}
