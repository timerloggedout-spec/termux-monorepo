<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>IAMGAINZ – Coaching, Peptides & Worldwide Regulations</title>
  <style>
    :root {
      --bg: #0a0a0a;
      --card-bg: #1a1a1a;
      --accent: #ff3c00;
      --accent-light: #ff6b35;
      --text: #f0f0f0;
      --text-secondary: #aaa;
      --border: #2a2a2a;
      --nav-height: 60px;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.6;
      min-height: 100vh;
    }

    /* Navigation */
    .nav-bar {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(10, 10, 10, 0.95);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 24px;
      height: var(--nav-height);
    }
    .nav-logo {
      font-family: 'Anton', 'Impact', sans-serif;
      font-size: 1.4rem;
      font-weight: 800;
      letter-spacing: -0.5px;
      background: linear-gradient(135deg, var(--accent-light), var(--accent));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      text-transform: uppercase;
    }
    .nav-links {
      display: flex;
      gap: 8px;
      align-items: center;
    }
    .nav-link {
      padding: 8px 18px;
      border-radius: 8px;
      color: var(--text-secondary);
      text-decoration: none;
      font-weight: 600;
      font-size: 0.9rem;
      transition: all 0.2s;
      cursor: pointer;
      border: 1px solid transparent;
      background: none;
    }
    .nav-link:hover { color: #fff; border-color: #444; }
    .nav-link.active {
      color: #fff;
      background: #1a1a1a;
      border-color: #444;
    }
    .nav-link.primary {
      background: var(--accent);
      color: #fff;
      border-color: var(--accent);
    }
    .nav-link.primary:hover { background: #e03400; }

    /* Page Containers */
    .page {
      display: none;
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 24px;
    }
    .page.active { display: block; }

    /* Main Page Styles */
    .container { max-width: 1200px; margin: 0 auto; }
    .logo-block {
      text-align: center;
      padding: 60px 0 20px;
    }
    .logo-main {
      font-family: 'Anton', 'Impact', sans-serif;
      font-size: 4.5rem;
      font-weight: 800;
      letter-spacing: -1px;
      background: linear-gradient(135deg, #ff6b35, #ff3c00);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      text-transform: uppercase;
    }
    .logo-sub {
      font-size: 1.2rem;
      color: #aaa;
      margin-top: -8px;
    }
    .hero {
      text-align: center;
      padding: 20px 0 40px;
    }
    .hero h1 {
      font-size: 2.5rem;
      font-weight: 700;
      margin-bottom: 12px;
    }
    .hero p {
      font-size: 1.15rem;
      color: #ccc;
      max-width: 600px;
      margin: 0 auto 28px;
    }
    .cta-btn {
      display: inline-block;
      padding: 15px 38px;
      background: var(--accent);
      color: #fff;
      font-weight: 700;
      border-radius: 8px;
      text-decoration: none;
      transition: background 0.2s;
      font-size: 1.05rem;
    }
    .cta-btn:hover { background: #e03400; }

    .stats-bar {
      display: flex;
      justify-content: center;
      gap: 40px;
      margin: 20px 0 50px;
      flex-wrap: wrap;
    }
    .stat-item {
      text-align: center;
      background: #1a1a1a;
      border-radius: 12px;
      padding: 20px 28px;
      min-width: 150px;
    }
    .stat-num {
      font-size: 2.5rem;
      font-weight: 800;
      color: var(--accent-light);
      line-height: 1.2;
    }
    .stat-label {
      font-size: 0.85rem;
      color: #aaa;
    }

    .section {
      padding: 60px 0;
    }
    .section h2 {
      font-size: 2rem;
      text-align: center;
      margin-bottom: 10px;
    }
    .section .subtitle {
      text-align: center;
      color: #aaa;
      margin-bottom: 40px;
      font-size: 1.05rem;
    }
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 28px;
    }
    .card {
      background: #1a1a1a;
      border-radius: 16px;
      padding: 32px 24px;
      transition: transform 0.2s;
      border: 1px solid #2a2a2a;
    }
    .card:hover {
      transform: translateY(-3px);
      border-color: var(--accent);
    }
    .card h3 {
      font-size: 1.35rem;
      margin-bottom: 10px;
      color: var(--accent-light);
    }
    .card p {
      color: #bbb;
      margin-bottom: 14px;
    }
    .card .price {
      font-weight: 700;
      color: #fff;
    }
    .card a {
      color: var(--accent-light);
      text-decoration: none;
      font-weight: 600;
    }

    .about-card {
      background: #1a1a1a;
      border-radius: 16px;
      padding: 36px;
      max-width: 800px;
      margin: 0 auto;
      border: 1px solid #2a2a2a;
    }
    .about-card h3 {
      color: var(--accent-light);
      font-size: 1.4rem;
      margin-bottom: 14px;
    }
    .about-card p {
      color: #bbb;
      margin-bottom: 12px;
    }
    .badge-row {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin: 14px 0;
    }
    .badge-item {
      background: #2a2a2a;
      color: #ff6b35;
      padding: 6px 14px;
      border-radius: 20px;
      font-size: 0.8rem;
      font-weight: 600;
    }

    .testimonial {
      background: #111;
      border-radius: 20px;
      text-align: center;
      padding: 50px 24px;
      max-width: 700px;
      margin: 0 auto;
    }
    .testimonial .trophy {
      font-size: 3.5rem;
      margin-bottom: 8px;
    }
    .testimonial blockquote {
      font-size: 1.3rem;
      font-style: italic;
      color: #e0e0e0;
      margin: 20px 0;
    }
    .testimonial cite {
      color: var(--accent-light);
      font-weight: 600;
    }

    .resource-grid {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 14px;
      margin-top: 28px;
    }
    .resource-link {
      background: #1a1a1a;
      border-radius: 8px;
      padding: 12px 22px;
      color: #fff;
      text-decoration: none;
      font-weight: 600;
      border: 1px solid #333;
      transition: 0.2s;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .resource-link:hover {
      border-color: var(--accent);
      color: var(--accent-light);
    }

    footer {
      text-align: center;
      padding: 32px 0;
      color: #666;
      font-size: 0.85rem;
      border-top: 1px solid #1a1a1a;
      margin-top: 30px;
    }

    /* RegIntel Tool Styles */
    .reg-tool-container {
      max-width: 1300px;
      margin: 0 auto;
      padding: 20px 24px;
    }
    .reg-header {
      text-align: center;
      padding: 30px 0 20px;
    }
    .reg-header h1 {
      font-size: 2rem;
      color: var(--accent-light);
      margin-bottom: 6px;
    }
    .reg-header p {
      color: #aaa;
      font-size: 0.95rem;
    }
    .search-bar-wrap {
      display: flex;
      gap: 10px;
      max-width: 600px;
      margin: 0 auto 20px;
    }
    .search-bar-wrap input {
      flex: 1;
      padding: 12px 18px;
      border-radius: 10px;
      border: 1px solid #333;
      background: #1a1a1a;
      color: #fff;
      font-size: 1rem;
      outline: none;
    }
    .search-bar-wrap input:focus {
      border-color: var(--accent-light);
    }
    .search-bar-wrap button {
      padding: 12px 22px;
      border-radius: 10px;
      background: var(--accent);
      color: #fff;
      font-weight: 700;
      border: none;
      cursor: pointer;
    }
    .filter-row {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
      justify-content: center;
      margin-bottom: 20px;
    }
    .filter-row select {
      padding: 8px 14px;
      border-radius: 8px;
      border: 1px solid #333;
      background: #1a1a1a;
      color: #fff;
      font-size: 0.9rem;
    }
    .tab-nav {
      display: flex;
      gap: 2px;
      margin-bottom: 16px;
      border-bottom: 1px solid #2a2a2a;
      overflow-x: auto;
    }
    .tab-nav button {
      padding: 10px 20px;
      background: none;
      border: none;
      color: #aaa;
      cursor: pointer;
      font-weight: 600;
      font-size: 0.9rem;
      white-space: nowrap;
      border-bottom: 2px solid transparent;
      transition: 0.2s;
    }
    .tab-nav button.active {
      color: #fff;
      border-bottom-color: var(--accent);
    }
    .results-container {
      background: #1a1a1a;
      border-radius: 12px;
      padding: 16px;
      min-height: 300px;
      max-height: 500px;
      overflow-y: auto;
    }
    .result-item {
      padding: 12px 16px;
      border-bottom: 1px solid #2a2a2a;
      cursor: pointer;
      transition: background 0.15s;
    }
    .result-item:hover { background: #222; }
    .result-item:last-child { border-bottom: none; }
    .result-item h4 { color: var(--accent-light); font-size: 1rem; }
    .result-item p { color: #aaa; font-size: 0.85rem; margin-top: 2px; }
    .result-item .badge {
      display: inline-block;
      padding: 2px 8px;
      border-radius: 4px;
      font-size: 0.75rem;
      font-weight: 600;
      margin-right: 6px;
      background: #2a2a2a;
      color: #ccc;
    }
    .detail-panel {
      background: #1a1a1a;
      border-radius: 12px;
      padding: 24px;
      margin-top: 16px;
      border: 1px solid #2a2a2a;
      display: none;
    }
    .detail-panel.show { display: block; }
    .detail-panel h3 {
      font-size: 1.3rem;
      color: var(--accent-light);
      margin-bottom: 12px;
    }
    .detail-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 12px;
    }
    .detail-grid .field {
      padding: 8px 12px;
      background: #141414;
      border-radius: 8px;
    }
    .detail-grid .field label {
      font-size: 0.7rem;
      text-transform: uppercase;
      color: #888;
      font-weight: 600;
      margin-bottom: 2px;
      display: block;
    }
    .detail-grid .field span {
      display: block;
      color: #e0e0e0;
      font-size: 0.9rem;
    }
    .world-map {
      width: 100%;
      height: 350px;
      background: #111;
      border-radius: 12px;
      margin-top: 20px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #555;
      font-size: 1.1rem;
      border: 1px solid #2a2a2a;
    }
    .action-row {
      display: flex;
      gap: 10px;
      margin-top: 16px;
      flex-wrap: wrap;
    }
    .btn-sm {
      padding: 8px 16px;
      border-radius: 6px;
      font-size: 0.85rem;
      font-weight: 600;
      cursor: pointer;
      border: 1px solid #444;
      background: #2a2a2a;
      color: #fff;
      transition: 0.2s;
    }
    .btn-sm:hover { border-color: var(--accent); }
    .btn-sm.primary { background: var(--accent); border-color: var(--accent); }

    .loading-spinner {
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 40px;
      color: #888;
    }
    .loading-spinner::after {
      content: '';
      width: 28px;
      height: 28px;
      border: 3px solid #333;
      border-top-color: var(--accent-light);
      border-radius: 50%;
      animation: spin 0.7s linear infinite;
      margin-left: 12px;
    }
    @keyframes spin { to { transform: rotate(360deg); } }

    @media (max-width: 600px) {
      .logo-main { font-size: 2.8rem; }
      .hero h1 { font-size: 1.8rem; }
      .nav-bar { padding: 0 12px; }
      .nav-link { padding: 6px 12px; font-size: 0.8rem; }
    }
  </style>
</head>
