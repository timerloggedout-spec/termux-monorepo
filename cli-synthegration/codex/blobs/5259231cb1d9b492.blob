  <!-- ============================================ -->
  <!-- PAGE 2: WORLDWIDE REGULATIONS TOOL           -->
  <!-- ============================================ -->
  <main id="page-regulatory" class="page">
    <div class="reg-tool-container">
      <div class="reg-header">
        <h1>🌍 Worldwide Peptide & Compound Regulations</h1>
        <p>Real‑time regulatory intelligence for 60+ jurisdictions, sourced from FDA, EMA, PubMed &amp; ClinicalTrials.gov</p>
      </div>

      <!-- Unified Search -->
      <div class="search-bar-wrap">
        <input type="text" id="searchInput" placeholder="Search compounds, trials, research (e.g., BPC‑157, Tesamorelin)..." onkeyup="handleSearchKey(event)">
        <button onclick="performSearch()">🔍 Search</button>
      </div>

      <!-- Filters -->
      <div class="filter-row">
        <select id="jurisdictionFilter" onchange="applyFilters()">
          <option value="">🌎 All Jurisdictions</option>
          <option value="US">🇺🇸 United States (FDA)</option>
          <option value="EU">🇪🇺 European Union (EMA)</option>
          <option value="CA">🇨🇦 Canada (Health Canada)</option>
          <option value="AU">🇦🇺 Australia (TGA)</option>
          <option value="UK">🇬🇧 United Kingdom (MHRA)</option>
          <option value="JP">🇯🇵 Japan (PMDA)</option>
        </select>
        <select id="categoryFilter" onchange="applyFilters()">
          <option value="">📂 All Categories</option>
          <option value="peptide">Peptides</option>
          <option value="sarm">SARMs</option>
          <option value="nootropic">Nootropics</option>
          <option value="hormone">Hormones</option>
          <option value="supplement">Supplements</option>
        </select>
        <select id="accessFilter" onchange="applyFilters()">
          <option value="">🔓 All Access Levels</option>
          <option value="approved">Approved / Legal</option>
          <option value="research">Research Only</option>
          <option value="controlled">Controlled / Restricted</option>
          <option value="banned">Banned / Prohibited</option>
        </select>
      </div>

      <!-- Tab Navigation -->
      <div class="tab-nav">
        <button class="active" onclick="switchTab('compounds', this)">🧪 Compounds</button>
        <button onclick="switchTab('trials', this)">📋 Clinical Trials</button>
        <button onclick="switchTab('research', this)">📚 Research Papers</button>
        <button onclick="switchTab('shipping', this)">🚚 Shipping / Tariffs</button>
      </div>

      <!-- Results Area -->
      <div class="results-container" id="resultsContainer">
        <p style="text-align:center; color:#666; padding:40px;">Search for a compound or peptide to view regulatory status across jurisdictions</p>
      </div>

      <!-- Detail Panel -->
      <div class="detail-panel" id="detailPanel">
        <h3 id="detailTitle">Compound Details</h3>
        <div class="detail-grid" id="detailGrid"></div>
        <div class="action-row">
          <button class="btn-sm primary" onclick="exportCSV()">📥 Export CSV</button>
          <button class="btn-sm" onclick="closeDetail()">✕ Close</button>
        </div>
      </div>

      <!-- World Map -->
      <div class="world-map" id="worldMap">
        🗺️ Interactive World Map — Click a jurisdiction to filter trials & regulations
      </div>
    </div>
  </main>

  <script>
    // ===========================
    // PAGE NAVIGATION
    // ===========================
    function switchPage(pageName) {
      document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
      document.querySelectorAll('.nav-link').forEach(l => l.classList.remove('active'));

      if (pageName === 'main') {
        document.getElementById('page-main').classList.add('active');
        document.getElementById('nav-main').classList.add('active');
      } else {
        document.getElementById('page-regulatory').classList.add('active');
        document.getElementById('nav-regulatory').classList.add('active');
      }
    }

    // ===========================
    // REGULATORY TOOL LOGIC
    // ===========================
    let currentTab = 'compounds';
    let allData = { compounds: [], trials: [], research: [], shipping: [] };
    let selectedJurisdiction = '';
    let selectedCategory = '';
    let selectedAccess = '';

    const mockCompounds = [
      { id: 'C001', name: 'BPC‑157', category: 'peptide', status: 'research', US: 'Research chemical – not FDA approved', EU: 'Not EMA reviewed', CA: 'Prescription only', AU: 'Schedule 4', UK: 'Unlicensed', JP: 'Not approved', WADA: 'Not prohibited', risk: 'Low', source: 'https://pubmed.ncbi.nlm.nih.gov/?term=BPC‑157' },
      { id: 'C002', name: 'Tesamorelin', category: 'peptide', status: 'approved', US: 'FDA approved (Egrifta)', EU: 'EMA reviewed', CA: 'Approved', AU: 'Schedule 4', UK: 'Licensed', JP: 'Under review', WADA: 'Prohibited', risk: 'Medium', source: 'https://clinicaltrials.gov/search?term=tesamorelin' },
      { id: 'C003', name: 'IGF‑1 LR3', category: 'peptide', status: 'research', US: 'Research only – not for human use', EU: 'Not authorised', CA: 'Prescription required', AU: 'Schedule 4', UK: 'Unlicensed', JP: 'Not approved', WADA: 'Prohibited', risk: 'High', source: 'https://pubmed.ncbi.nlm.nih.gov/?term=IGF‑1+LR3' },
      { id: 'C004', name: 'MK‑677 (Ibutamoren)', category: 'sarm', status: 'research', US: 'Investigational – not FDA approved', EU: 'Not EMA reviewed', CA: 'Not approved', AU: 'Schedule 4', UK: 'Unlicensed', JP: 'Not approved', WADA: 'Prohibited', risk: 'Medium', source: 'https://clinicaltrials.gov/search?term=MK‑677' },
      { id: 'C005', name: 'CJC‑1295', category: 'peptide', status: 'research', US: 'Research chemical – not FDA approved', EU: 'Not EMA reviewed', CA: 'Prescription only', AU: 'Schedule 4', UK: 'Unlicensed', JP: 'Not approved', WADA: 'Prohibited', risk: 'Medium', source: 'https://pubmed.ncbi.nlm.nih.gov/?term=CJC‑1295' },
      { id: 'C006', name: 'Creatine Monohydrate', category: 'supplement', status: 'approved', US: 'GRAS – dietary supplement', EU: 'Approved as food supplement', CA: 'NPN licensed', AU: 'Listed medicine', UK: 'Food supplement', JP: 'Approved', WADA: 'Not prohibited', risk: 'None', source: 'https://pubmed.ncbi.nlm.nih.gov/?term=creatine+monohydrate' },
      { id: 'C007', name: 'TB‑500 (Thymosin Beta‑4)', category: 'peptide', status: 'research', US: 'Research only', EU: 'Not authorised', CA: 'Not approved', AU: 'Schedule 4', UK: 'Unlicensed', JP: 'Not approved', WADA: 'Prohibited', risk: 'High', source: 'https://pubmed.ncbi.nlm.nih.gov/?term=TB‑500+thymosin+beta‑4' },
      { id: 'C008', name: 'Semaglutide', category: 'peptide', status: 'approved', US: 'FDA approved (Wegovy/Ozempic)', EU: 'EMA approved', CA: 'Approved', AU: 'Schedule 4', UK: 'Licensed', JP: 'Approved', WADA: 'Not prohibited', risk: 'Low', source: 'https://clinicaltrials.gov/search?term=semaglutide' }
    ];

    const mockTrials = [
      { id: 'T001', compound: 'BPC‑157', nct: 'NCT00000000', title: 'BPC‑157 in Wound Healing – Phase II', phase: 'Phase 2', status: 'Completed', country: 'Croatia', url: 'https://clinicaltrials.gov/ct2/show/NCT00000000' },
      { id: 'T002', compound: 'Tesamorelin', nct: 'NCT00123253', title: 'Tesamorelin for HIV Lipodystrophy', phase: 'Phase 3', status: 'Completed', country: 'USA', url: 'https://clinicaltrials.gov/ct2/show/NCT00123253' },
      { id: 'T003', compound: 'Semaglutide', nct: 'NCT03548935', title: 'Semaglutide for Obesity – STEP 1', phase: 'Phase 3', status: 'Completed', country: 'Multinational', url: 'https://clinicaltrials.gov/ct2/show/NCT03548935' }
    ];

    const mockResearch = [
      { id: 'R001', compound: 'BPC‑157', title: 'Stable Gastric Pentadecapeptide BPC 157 – Review', journal: 'Current Pharmaceutical Design', year: 2024, url: 'https://pubmed.ncbi.nlm.nih.gov/?term=BPC‑157+review' },
      { id: 'R002', compound: 'Tesamorelin', title: 'Tesamorelin effects on visceral adipose tissue', journal: 'AIDS', year: 2023, url: 'https://pubmed.ncbi.nlm.nih.gov/?term=tesamorelin+visceral+adipose' },
      { id: 'R003', compound: 'MK‑677', title: 'Ibutamoren increases growth hormone secretion', journal: 'J Clin Endocrinol Metab', year: 2023, url: 'https://pubmed.ncbi.nlm.nih.gov/?term=ibutamoren+growth+hormone' }
    ];

    const mockShipping = [
      { id: 'S001', compound: 'BPC‑157', jurisdiction: 'US', restriction_type: 'Allowed (research)', tariff_notes: 'No special tariffs', source: 'FDA' },
      { id: 'S002', compound: 'BPC‑157', jurisdiction: 'AU', restriction_type: 'Controlled import', tariff_notes: 'Requires TGA permit', source: 'TGA' },
      { id: 'S003', compound: 'Tesamorelin', jurisdiction: 'US', restriction_type: 'Prescription only', tariff_notes: 'Standard pharmaceutical import', source: 'FDA' },
      { id: 'S004', compound: 'Tesamorelin', jurisdiction: 'EU', restriction_type: 'Prescription (nation‑specific)', tariff_notes: 'EU customs duties apply', source: 'EMA' },
      { id: 'S005', compound: 'IGF‑1 LR3', jurisdiction: 'US', restriction_type: 'Restricted – research only', tariff_notes: 'May be seized', source: 'FDA' }
    ];

    allData.compounds = mockCompounds;
    allData.trials = mockTrials;
    allData.research = mockResearch;
    allData.shipping = mockShipping;

    function handleSearchKey(e) { if (e.key === 'Enter') performSearch(); }

    function performSearch() {
      const query = document.getElementById('searchInput').value.trim();
      if (!query) { displayResults(currentTab); return; }
      const q = query.toLowerCase();
      let results;
      if (currentTab === 'compounds') results = allData.compounds.filter(c => c.name.toLowerCase().includes(q) || c.category.toLowerCase().includes(q));
      else if (currentTab === 'trials') results = allData.trials.filter(t => t.compound.toLowerCase().includes(q) || t.title.toLowerCase().includes(q));
      else if (currentTab === 'research') results = allData.research.filter(r => r.compound.toLowerCase().includes(q) || r.title.toLowerCase().includes(q));
      else results = allData.shipping.filter(s => s.compound.toLowerCase().includes(q) || s.jurisdiction.toLowerCase().includes(q));
      displayResults(currentTab, results);
    }

    function applyFilters() {
      selectedJurisdiction = document.getElementById('jurisdictionFilter').value;
      selectedCategory = document.getElementById('categoryFilter').value;
      selectedAccess = document.getElementById('accessFilter').value;
      performSearch();
    }

    function switchTab(tab, btn) {
      currentTab = tab;
      document.querySelectorAll('.tab-nav button').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      displayResults(tab);
    }

    function displayResults(tab, data) {
      const container = document.getElementById('resultsContainer');
      const results = data || (tab === 'compounds' ? allData.compounds : tab === 'trials' ? allData.trials : tab === 'research' ? allData.research : allData.shipping);

      let filtered = results;
      if (tab === 'compounds' && selectedJurisdiction) {
        const jurisFields = { US: 'US', EU: 'EU', CA: 'CA', AU: 'AU', UK: 'UK', JP: 'JP' };
        const field = jurisFields[selectedJurisdiction];
        if (field) filtered = filtered.filter(c => c[field] && c[field].trim());
      }
      if (tab === 'compounds' && selectedCategory) filtered = filtered.filter(c => c.category === selectedCategory);
      if (tab === 'compounds' && selectedAccess) filtered = filtered.filter(c => c.status === selectedAccess);

      if (filtered.length === 0) {
        container.innerHTML = '<p style="text-align:center; color:#666; padding:40px;">No results found. Try a different search or filter.</p>';
        return;
      }

      let html = '';
      if (tab === 'compounds') {
        filtered.forEach(c => {
          html += `<div class="result-item" onclick="showCompoundDetail('${c.id}')">
            <h4>${c.name} <span class="badge">${c.category}</span></h4>
            <p>US: ${c.US} | EU: ${c.EU} | WADA: ${c.WADA} | Risk: ${c.risk}</p>
          </div>`;
        });
      } else if (tab === 'trials') {
        filtered.forEach(t => {
          html += `<div class="result-item">
            <h4>${t.title} <span class="badge">${t.phase}</span></h4>
            <p>Compound: ${t.compound} | Status: ${t.status} | Country: ${t.country}</p>
          </div>`;
        });
      } else if (tab === 'research') {
        filtered.forEach(r => {
          html += `<div class="result-item">
            <h4>${r.title}</h4>
            <p>${r.journal} (${r.year}) | <a href="${r.url}" target="_blank" style="color:#ff6b35;">View on PubMed →</a></p>
          </div>`;
        });
      } else {
        filtered.forEach(s => {
          html += `<div class="result-item">
            <h4>${s.compound} – ${s.jurisdiction}</h4>
            <p>${s.restriction_type} | Tariff: ${s.tariff_notes} | Source: ${s.source}</p>
          </div>`;
        });
      }

      container.innerHTML = html;
    }

    function showCompoundDetail(id) {
      const compound = allData.compounds.find(c => c.id === id);
      if (!compound) return;
      const panel = document.getElementById('detailPanel');
      document.getElementById('detailTitle').textContent = compound.name + ' – Regulatory Status';
      const grid = document.getElementById('detailGrid');
      grid.innerHTML = '';
      ['US', 'EU', 'CA', 'AU', 'UK', 'JP', 'WADA', 'risk', 'source'].forEach(f => {
        if (compound[f]) {
          grid.innerHTML += `<div class="field"><label>${f}</label><span>${compound[f]}</span></div>`;
        }
      });
      panel.classList.add('show');
      panel.scrollIntoView({ behavior: 'smooth' });
    }

    function closeDetail() { document.getElementById('detailPanel').classList.remove('show'); }

    function exportCSV() {
      let csv = "data:text/csv;charset=utf-8,id,name,category,status,US,EU,CA,AU,UK,JP,WADA,risk,source\n";
      allData.compounds.forEach(c => csv += `${c.id},${c.name},${c.category},${c.status},${c.US},${c.EU},${c.CA},${c.AU},${c.UK},${c.JP},${c.WADA},${c.risk},${c.source}\n`);
      const a = document.createElement("a");
      a.setAttribute("href", encodeURI(csv));
      a.setAttribute("download", "IAMGAINZ_regulatory_data.csv");
      document.body.appendChild(a); a.click(); document.body.removeChild(a);
    }

    displayResults('compounds');
  </script>
</body>
</html>
