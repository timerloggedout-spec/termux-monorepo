<div class="sweepstakes">
    <h3>BOOM Particle Generator</h3>
    <p>Generate BOOM particles for bonus rewards</p>
    <div class="sweepstakes-options">
        <button class="sweepstakes-btn" data-time="short">Short Term (1 min)</button>
        <button class="sweepstakes-btn" data-time="medium">Medium Term (5 min)</button>
        <button class="sweepstakes-btn" data-time="long">Long Term (15 min)</button>
    </div>
    <div id="boomCounter">BOOM Particles: 3</div>
    <div id="sweepstakesInfo">Next sweepstakes entry in: 2h 15m</div>
</div>
