<!-- Add this inside <div class="container"> after the bankroll section -->
<div id="slotMachine" style="display:none;">
    <div class="slot-reels">
        <div class="reel" id="reel1"></div>
        <div class="reel" id="reel2"></div>
        <div class="reel" id="reel3"></div>
    </div>
    <button onclick="pullLever()" class="neon-btn" style="margin-top:20px;">🎰 PULL LEVER</button>
    <div id="slotResult" style="color:var(--gold); font-size:16px; margin-top:10px;"></div>
</div>
<button onclick="toggleSlot()" class="neon-btn cyan">🎰 TOGGLE SLOT MACHINE</button>
