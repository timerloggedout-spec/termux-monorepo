// components/ClinicalTrialsTab.jsx
import React, { useState, useEffect } from 'react';
import { Search, MapPin, ExternalLink } from 'lucide-react';

export default function ClinicalTrialsTab({ initialQuery = '', countryFilter = null }) {
  const [query, setQuery] = useState(initialQuery);
  const [country, setCountry] = useState(countryFilter);
  const [trials, setTrials] = useState([]);
  const [loading, setLoading] = useState(false);

  useEffect(() => {
    if (countryFilter) setCountry(countryFilter);
  }, [countryFilter]);

  const searchTrials = async (e) => {
    e.preventDefault();
    setLoading(true);
    try {
      let searchTerm = query;
      if (country) searchTerm += ` AND ${country}`;
      const res = await fetch(`https://clinicaltrials.gov/api/v2/studies?query.term=${encodeURIComponent(searchTerm)}&pageSize=20`);
      const data = await res.json();
      setTrials(data.studies || []);
    } catch (err) {
      console.error(err);
    } finally {
      setLoading(false);
    }
  };

  return (
    <div className="space-y-6">
      <form onSubmit={searchTrials} className="bg-white dark:bg-gray-800 p-6 rounded-xl shadow">
        <div className="flex flex-col md:flex-row gap-4">
          <div className="flex-1">
            <label className="block text-sm font-medium mb-1">Condition / Intervention</label>
            <div className="relative">
              <Search className="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 w-5 h-5" />
              <input
                type="text"
                value={query}
                onChange={(e) => setQuery(e.target.value)}
                placeholder="e.g., Semaglutide, Diabetes..."
                className="w-full pl-10 pr-4 py-2 rounded-lg border dark:bg-gray-900 dark:border-gray-700"
              />
            </div>
          </div>
          <div>
            <label className="block text-sm font-medium mb-1">Country (optional)</label>
            <div className="relative">
              <MapPin className="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 w-5 h-5" />
              <input
                type="text"
                value={country || ''}
                onChange={(e) => setCountry(e.target.value)}
                placeholder="e.g., United States"
                className="w-full pl-10 pr-4 py-2 rounded-lg border dark:bg-gray-900 dark:border-gray-700"
              />
            </div>
          </div>
          <div className="self-end">
            <button
              type="submit"
              disabled={loading}
              className="px-6 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 disabled:opacity-50"
            >
              {loading ? 'Searching...' : 'Search Trials'}
            </button>
          </div>
        </div>
      </form>

      <div className="grid gap-4">
        {trials.map((study) => {
          const protocol = study.protocolSection;
          const id = protocol?.identificationModule;
          const status = protocol?.statusModule;
          const locations = protocol?.contactsLocationsModule?.locations || [];
          return (
            <div key={id?.nctId} className="bg-white dark:bg-gray-800 p-6 rounded-xl shadow border dark:border-gray-700">
              <div className="flex justify-between items-start">
                <h3 className="font-bold text-lg">{id?.briefTitle}</h3>
                <span className="px-2 py-1 bg-blue-100 text-blue-800 text-xs rounded-full">
                  {status?.overallStatus}
                </span>
              </div>
              <p className="text-sm text-gray-500 mt-1">NCT ID: {id?.nctId}</p>
              <div className="mt-3 grid grid-cols-1 md:grid-cols-2 gap-2 text-sm">
                <div>
                  <span className="font-medium">Sponsor:</span> {protocol?.sponsorCollaboratorsModule?.leadSponsor?.name}
                </div>
                <div>
                  <span className="font-medium">Locations:</span>{' '}
                  {locations.slice(0, 3).map(l => `${l.city}, ${l.country}`).join('; ')}
                  {locations.length > 3 && '...'}
                </div>
              </div>
              <a
                href={`https://clinicaltrials.gov/study/${id?.nctId}`}
                target="_blank"
                rel="noreferrer"
                className="mt-3 inline-flex items-center text-indigo-600 hover:underline text-sm"
              >
                View Details <ExternalLink className="w-4 h-4 ml-1" />
              </a>
            </div>
          );
        })}
        {trials.length === 0 && !loading && (
          <div className="text-center py-12 text-gray-500">No trials found. Try adjusting your search.</div>
        )}
      </div>
    </div>
  );
}
