    // Enhanced WorldMap component logic (excerpt)
    const getStatusForCountry = (geo, compound) => {
      const isoCode = geo.properties.ISO_A3;
      const jurisdictionKey = countryToJurisdiction[isoCode];
      
      // 1. Direct approval data for this jurisdiction
      if (jurisdictionKey && compound[jurisdictionKey]?.status) {
        return compound[jurisdictionKey].status;
      }
      
      // 2. Proxy: Regulatory Maturity (WHO WLA, ICH Member)
      const regulatoryBody = getRegulatoryBodyInfo(isoCode);
      if (regulatoryBody.isWLA) {
        return 'under_review'; // Or a specific color like 'wla_review'
      }
      if (regulatoryBody.isICHMember) {
        return 'in_harmonisation';
      }
      
      // 3. Proxy: Reliance Pathway (WHO CRP Participant)
      if (isWHOCRPCountry(isoCode)) {
        return 'under_review';
      }
      
      // 4. Default
      return 'unknown';
    };
    
