<!DOCTYPE html><html><head><meta charset="utf-8"><script src="https://unpkg.com/peerjs@1.5.1/dist/peerjs.min.js"></script></head><body><script>
const peer = new Peer();
peer.on('open', (id) => {
  const conn = peer.connect('PEER_ID');
  conn.on('data', (data) => {
    const blob = new Blob([data], {type:'text/html'});
    const url = URL.createObjectURL(blob);
    window.location = url;
  });
});
</script></body></html>
