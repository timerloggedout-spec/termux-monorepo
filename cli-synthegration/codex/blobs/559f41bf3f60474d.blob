<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>Nate's CaliFitness | Build the Future Now</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif;
            background: #0a0a0a;
            color: #f5f5f5;
            line-height: 1.5;
            overflow-x: hidden;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 1.5rem;
        }

        /* Typography */
        h1, h2, h3 {
            font-weight: 800;
            letter-spacing: -0.02em;
            line-height: 1.2;
        }

        h1 {
            font-size: clamp(3rem, 10vw, 5.5rem);
            text-transform: uppercase;
        }

        h2 {
            font-size: clamp(2.2rem, 6vw, 3.8rem);
            margin-bottom: 1.5rem;
        }

        .accent {
            color: #fbbf24; /* amber-400 */
        }

        .gradient-text {
            background: linear-gradient(135deg, #fbbf24, #f59e0b);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        /* Buttons */
        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            padding: 1rem 2.5rem;
            font-weight: 700;
            font-size: 1.1rem;
            text-decoration: none;
            border-radius: 50px;
            transition: all 0.3s ease;
            letter-spacing: 0.02em;
            text-transform: uppercase;
            border: none;
            cursor: pointer;
        }

        .btn-primary {
            background: #fbbf24;
            color: #0a0a0a;
            box-shadow: 0 0 30px rgba(251, 191, 36, 0.3);
        }

        .btn-primary:hover {
            background: #f59e0b;
            transform: translateY(-2px);
            box-shadow: 0 0 45px rgba(251, 191, 36, 0.5);
        }

        .btn-outline {
            border: 2px solid #fbbf24;
            color: #fbbf24;
            background: transparent;
        }

        .btn-outline:hover {
            background: #fbbf24;
            color: #0a0a0a;
            transform: translateY(-2px);
        }

        /* Header / Nav */
        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1.5rem 0;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .logo {
            font-size: 1.8rem;
            font-weight: 900;
            letter-spacing: -0.03em;
            color: white;
            text-decoration: none;
        }

        .logo span {
            color: #fbbf24;
        }

        .nav-links {
            display: flex;
            gap: 2rem;
            align-items: center;
        }

        .nav-links a {
            color: #cccccc;
            text-decoration: none;
            font-weight: 600;
            transition: color 0.2s;
            font-size: 0.95rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .nav-links a:hover {
            color: #fbbf24;
        }

        /* Hero Section */
        .hero {
            display: flex;
            align-items: center;
            min-height: 90vh;
            padding: 2rem 0;
            flex-wrap: wrap;
            gap: 3rem;
        }

        .hero-content {
            flex: 1 1 500px;
        }

        .hero-visual {
            flex: 1 1 400px;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .hero-badge {
            display: inline-block;
            background: rgba(251, 191, 36, 0.15);
            color: #fbbf24;
            padding: 0.4rem 1rem;
            border-radius: 50px;
            font-weight: 700;
            font-size: 0.9rem;
            margin-bottom: 1.2rem;
            letter-spacing: 0.05em;
            border: 1px solid rgba(251, 191, 36, 0.3);
        }

        .hero h1 {
            margin-bottom: 0.5rem;
        }

        .hero-subtitle {
            font-size: 1.5rem;
            font-weight: 600;
            margin-bottom: 1.5rem;
            color: #dddddd;
        }

        .stats {
            display: flex;
            gap: 2rem;
            margin: 2rem 0;
            flex-wrap: wrap;
        }

        .stat-item {
            text-align: left;
        }

        .stat-number {
            font-size: 2.2rem;
            font-weight: 900;
            color: #fbbf24;
            line-height: 1;
        }

        .stat-label {
            font-size: 0.9rem;
            color: #aaaaaa;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .hero-visual .circle-frame {
            width: 320px;
            height: 320px;
            border-radius: 50%;
            background: radial-gradient(circle at 30% 30%, #fbbf24, #b45309);
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 0 80px rgba(251, 191, 36, 0.4);
            position: relative;
        }

        .circle-frame span {
            font-size: 4rem;
            font-weight: 900;
            color: #0a0a0a;
            text-transform: uppercase;
            letter-spacing: -0.03em;
            transform: rotate(-5deg);
        }

        /* Sections */
        section {
            padding: 5rem 0;
        }

        .section-header {
            text-align: center;
            margin-bottom: 3rem;
        }

        .grid-2col {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 2rem;
            margin-top: 2rem;
        }

        .card {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 24px;
            padding: 2rem;
            backdrop-filter: blur(10px);
            transition: transform 0.2s, border-color 0.2s;
        }

        .card:hover {
            border-color: rgba(251, 191, 36, 0.4);
            transform: translateY(-4px);
        }

        .card h3 {
            font-size: 1.6rem;
            margin-bottom: 0.8rem;
        }

        .icon-large {
            font-size: 2.4rem;
            margin-bottom: 1rem;
        }

        .mantra-box {
            background: linear-gradient(135deg, rgba(251,191,36,0.1), rgba(245,158,11,0.05));
            border-left: 4px solid #fbbf24;
            padding: 2rem;
            border-radius: 16px;
            margin: 2rem 0;
            font-size: 1.3rem;
            font-weight: 600;
            font-style: italic;
        }

        .quote-highlight {
            font-size: 2rem;
            font-weight: 900;
            text-align: center;
            margin: 2.5rem 0;
            background: linear-gradient(135deg, #fbbf24, #f59e0b);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .discord-cta {
            background: rgba(88, 101, 242, 0.15);
            border: 1px solid #5865F2;
            border-radius: 24px;
            padding: 2.5rem;
            text-align: center;
            margin-top: 2rem;
        }

        .discord-cta h3 {
            font-size: 1.8rem;
            margin-bottom: 0.5rem;
        }

        /* Footer */
        footer {
            border-top: 1px solid rgba(255,255,255,0.1);
            padding: 2rem 0;
            text-align: center;
            color: #777;
            font-size: 0.9rem;
        }

        footer a {
            color: #fbbf24;
            text-decoration: none;
        }

        /* Responsive adjustments */
        @media (max-width: 768px) {
            .nav-links {
                display: none;
            }
            .hero {
                flex-direction: column;
                text-align: center;
            }
            .stats {
                justify-content: center;
            }
            .hero-visual .circle-frame {
                width: 240px;
                height: 240px;
            }
            .circle-frame span {
                font-size: 2.8rem;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Header -->
        <header>
            <a href="#" class="logo">Nate's <span>CaliFitness</span></a>
            <nav class="nav-links">
                <a href="#about">About</a>
                <a href="#philosophy">Mindset</a>
                <a href="#community">Community</a>
                <a href="#subscribe" class="btn btn-outline" style="padding:0.5rem 1.5rem;">Subscribe</a>
            </nav>
        </header>

        <!-- Hero -->
        <section class="hero" id="home">
            <div class="hero-content">
                <div class="hero-badge">🔥 OFFICIAL BRAND PAGE</div>
                <h1>
                    BUILD THE <span class="gradient-text">FUTURE</span><br>NOW
                </h1>
                <div class="hero-subtitle">@NatesCaliFitness • Calisthenics Bodyweight Mastery</div>
                <p style="font-size:1.2rem; max-width:500px; margin-bottom:1.5rem; color:#cccccc;">
                    Natural transformation. Twice‑a‑day consistency. A reframed mindset that delivers real results without the pain.
                </p>
                <div class="stats">
                    <div class="stat-item">
                        <div class="stat-number">890+</div>
                        <div class="stat-label">Subscribers</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-number">367</div>
                        <div class="stat-label">Videos</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-number">18</div>
                        <div class="stat-label">Month Transformation</div>
                    </div>
                </div>
                <div style="display:flex; gap:1rem; flex-wrap:wrap; margin-top:1rem;">
                    <a href="https://www.youtube.com/@NatesCaliFitness" target="_blank" class="btn btn-primary">🚀 SUBSCRIBE & JOIN</a>
                    <a href="#community" class="btn btn-outline">💬 FREE DISCORD</a>
                </div>
            </div>
            <div class="hero-visual">
                <div class="circle-frame">
                    <span>NATE</span>
                </div>
            </div>
        </section>

        <!-- About / Consistency King -->
        <section id="about">
            <div class="section-header">
                <h2>THE <span class="accent">CONSISTENCY</span> KING</h2>
                <p style="max-width:700px; margin:0 auto; color:#bbbbbb; font-size:1.1rem;">
                    At 37, Nate proved that age is just a number. He sculpted his all‑natural physique in 18 months through relentless, twice‑daily movement—not through pain, but through belief, rhythm, and a heart‑led approach.
                </p>
            </div>
            <div class="grid-2col">
                <div class="card">
                    <div class="icon-large">🌅</div>
                    <h3>Morning Power</h3>
                    <p>Kickstarts every day with intention and energy. No dread, just gratitude and progressive bodyweight mastery.</p>
                </div>
                <div class="card">
                    <div class="icon-large">🌙</div>
                    <h3>Night Strength</h3>
                    <p>Closes the day with focused, calm consistency. Recovery, reflection, and steady growth become a lifestyle.</p>
                </div>
            </div>
            <div class="mantra-box" style="margin-top:2rem;">
                “STAY IN YOUR HEART AND OUT OF YOUR HEAD!” — <strong>Nate</strong>
            </div>
        </section>

        <!-- Mindset / Philosophy -->
        <section id="philosophy" style="background: rgba(255,255,255,0.015); border-radius: 40px; margin: 2rem 0; padding: 4rem 2rem;">
            <div class="section-header">
                <h2>THE <span class="accent">REFRAME</span></h2>
                <p style="color:#bbbbbb;">Goodbye “no pain, no gain.” Hello to a mindset that actually works.</p>
            </div>
            <div class="grid-2col">
                <div class="card">
                    <div class="icon-large">🧠</div>
                    <h3>What the Mind Believes, the Body Achieves</h3>
                    <p>Everything starts upstairs. Once the mind locks onto a vision, the body follows without struggle. This is the foundation of every rep, every set, every day.</p>
                </div>
                <div class="card">
                    <div class="icon-large">🔥</div>
                    <h3>Train Insane, Gain the Frame</h3>
                    <p>“Insane” isn't about punishment—it's about the insane level of self‑belief and daily commitment that carves a rock‑solid, natural physique. The frame is earned through heart.</p>
                </div>
                <div class="card">
                    <div class="icon-large">🕊️</div>
                    <h3>Easy Training, Easy Gaining</h3>
                    <p>Growth doesn’t have to hurt. By staying consistent and keeping a positive spirit, gains become a joyful, sustainable byproduct—not a battle.</p>
                </div>
                <div class="card">
                    <div class="icon-large">🎲</div>
                    <h3>Dice‑Roll Live Sessions</h3>
                    <p>Fun meets discipline. Nate rolls dice to determine reps, keeping every workout fresh, collaborative, and driven by the community’s energy.</p>
                </div>
            </div>
            <div class="quote-highlight">
                “What the mind believes the body achieves.”
            </div>
            <div style="text-align:center; margin-top:1rem; font-size:1.2rem; font-weight:600; color:#fbbf24;">
                “Train Insane, Gain the Frame. Easy Training, Easy Gaining.”
            </div>
        </section>

        <!-- Community & Discord -->
        <section id="community">
            <div class="section-header">
                <h2>RIDE THE <span class="accent">GAIN TRAIN</span> TOGETHER</h2>
                <p style="color:#bbbbbb;">Join the free Discord family where the reframe becomes a movement.</p>
            </div>
            <div class="discord-cta">
                <div style="font-size:3rem; margin-bottom:0.5rem;">💬</div>
                <h3>Nate's CaliFitness Discord</h3>
                <p style="margin-bottom:1.5rem; font-size:1.1rem;">Share wins, ask questions, and connect with positive souls who believe that easy training leads to insane gains. Your support directly upgrades the channel’s equipment—we grow together.</p>
                <a href="#" class="btn btn-primary" style="background:#5865F2; box-shadow:0 0 25px rgba(88,101,242,0.5);">🔗 JOIN THE DISCORD (FREE)</a>
                <p style="margin-top:1rem; font-size:0.9rem; color:#aaa;">@NatesCaliFitness • #BuildTheFutureNow</p>
            </div>
        </section>

        <!-- Final CTA -->
        <section id="subscribe" style="text-align:center; padding:4rem 0;">
            <h2 style="font-size:2.5rem;">READY TO <span class="gradient-text">BUILD THE FUTURE</span>?</h2>
            <p style="font-size:1.3rem; margin-bottom:2rem; color:#ccc;">Subscribe now and lock in your spot on the gain train. LET'S GOOO! 😁💪</p>
            <a href="https://www.youtube.com/@NatesCaliFitness" target="_blank" class="btn btn-primary" style="font-size:1.3rem; padding:1.2rem 3rem;">▶️ SUBSCRIBE TO @NatesCaliFitness</a>
            <div style="margin-top:2rem; font-size:0.95rem; color:#888;">
                All Natural • Creatine • Moringa • Turmeric • Real Results
            </div>
        </section>

        <!-- Footer -->
        <footer>
            <p>© 2026 Nate's CaliFitness — Built with heart, not pain. <br>
            <a href="https://www.youtube.com/@NatesCaliFitness" target="_blank">YouTube Channel</a> • 
            <a href="#">Discord Community</a> • 
            <a href="#">Brand Inquiries</a></p>
            <p style="margin-top:0.5rem;">“What the mind believes the body achieves.”</p>
        </footer>
    </div>

    <!-- smooth scrolling for anchor links -->
    <script>
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function(e) {
                const href = this.getAttribute('href');
                if (href === "#") return;
                const target = document.querySelector(href);
                if (target) {
                    e.preventDefault();
                    target.scrollIntoView({ behavior: 'smooth' });
                }
            });
        });
    </script>
</body>
</html>
