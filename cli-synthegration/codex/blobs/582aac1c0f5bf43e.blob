<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
  <title>🎰 QuanTM FOAM v23.30 – Unified Swarm + Trading Terminal</title>
  <style>
    :root {
      --pink: #ff00ff; --cyan: #00f0ff; --green: #00ffaa; --gold: #ffd700;
      --bg: #0a0a1a; --card: #1a1a2a; --border: #2a2a3a; --base-font-size: 10px;
    }
    * { margin:0; padding:0; box-sizing:border-box; }
    body { background:var(--bg); color:#a0a0ff; font-family:'Courier New',monospace; font-size:var(--base-font-size); overflow-x:hidden; }
    canvas#particleCanvas { position:fixed; top:0; left:0; width:100%; height:100%; pointer-events:none; z-index:9999; }
    .container { max-width:1500px; margin:0 auto; padding:8px; position:relative; z-index:1; }
    h1 { color:var(--gold); font-size:calc(var(--base-font-size)*1.8); text-shadow:0 0 12px var(--pink),0 0 20px var(--cyan); margin-bottom:4px; }
    h2 { color:var(--cyan); font-size:calc(var(--base-font-size)*1.3); margin:10px 0 5px; }
    .status-bar { padding:6px 12px; margin:6px 0; background:linear-gradient(145deg,#0a0a1a,#1a1a2a); border-radius:8px; border-left:4px solid var(--cyan); font-weight:bold; display:flex; justify-content:space-between; align-items:center; box-shadow:0 0 15px rgba(0,240,255,0.25); flex-wrap:wrap; }
    .controls { display:flex; flex-wrap:wrap; gap:5px; margin:6px 0; }
    button { background:#111; border:2px solid var(--pink); color:var(--pink); padding:6px 10px; border-radius:18px; font-size:calc(var(--base-font-size)*0.9); font-weight:bold; cursor:pointer; font-family:'Courier New',monospace; transition:all 0.2s; text-transform:uppercase; letter-spacing:1px; box-shadow:0 0 6px var(--pink); }
    button:hover { background:var(--pink); color:#000; box-shadow:0 0 18px var(--pink); }
    button:active { transform:scale(0.95); }
    button.cyan { border-color:var(--cyan); color:var(--cyan); box-shadow:0 0 6px var(--cyan); }
    button.cyan:hover { background:var(--cyan); color:#000; }
    button.live { border-color:#ff4444; color:#ff4444; animation:livePulse 1s infinite; }
    button.gold { border-color:var(--gold); color:var(--gold); box-shadow:0 0 10px var(--gold); font-size:calc(var(--base-font-size)*1.1); padding:8px 18px; }
    button.gold:hover { background:var(--gold); color:#000; box-shadow:0 0 25px var(--gold); }
    button.allin { border-color:#ff4444; color:#ff4444; box-shadow:0 0 10px #ff4444; font-size:calc(var(--base-font-size)*1.1); padding:8px 18px; }
    button.allin:hover { background:#ff4444; color:#000; box-shadow:0 0 25px #ff4444; }
    button.reset { border-color:#ffaa00; color:#ffaa00; box-shadow:0 0 8px #ffaa00; }
    button.reset:hover { background:#ffaa00; color:#000; box-shadow:0 0 20px #ffaa00; }
    button.test { border-color:#44ff44; color:#44ff44; box-shadow:0 0 8px #44ff44; }
    button.test:hover { background:#44ff44; color:#000; box-shadow:0 0 20px #44ff44; }
    @keyframes livePulse { 0%,100%{box-shadow:0 0 6px #ff4444;} 50%{box-shadow:0 0 16px #ff4444;} }
    button:disabled { opacity:0.4; cursor:not-allowed; }
    .grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(280px,1fr)); gap:8px; margin:8px 0; }
    .card { background:var(--card); border-radius:8px; padding:10px; border:1px solid var(--border); box-shadow:0 0 10px rgba(255,0,255,0.08); }
    .card h3 { color:var(--cyan); font-size:calc(var(--base-font-size)*1.1); margin-bottom:6px; }
    .exchange-status { display:flex; align-items:center; gap:5px; padding:3px; background:#0a0a1a; border-radius:4px; margin:2px 0; font-size:calc(var(--base-font-size)*0.8); border:1px solid #2a2a3a; }
    .indicator { width:6px; height:6px; border-radius:50%; background:#ff4444; box-shadow:0 0 5px #ff4444; }
    .indicator.online { background:var(--green); box-shadow:0 0 8px var(--green); animation:pulse 1.5s infinite; }
    .indicator.ws { background:#ff00ff; box-shadow:0 0 8px #ff00ff; animation:pulse 0.8s infinite; }
    .indicator.reconnecting { background:#ffaa00; box-shadow:0 0 8px #ffaa00; animation:pulse 0.5s infinite; }
    @keyframes pulse { 0%,100%{opacity:1;box-shadow:0 0 6px var(--green);} 50%{opacity:0.4;box-shadow:0 0 14px var(--green);} }
    .stat { display:flex; justify-content:space-between; padding:2px 0; font-size:calc(var(--base-font-size)*0.9); }
    .stat-value { color:var(--gold); font-weight:bold; }
    .rolling-number { font-size:calc(var(--base-font-size)*1.3); color:var(--gold); font-weight:bold; }
    .opp-section { margin:6px 0; padding:6px; background:#0f0f1f; border-radius:5px; border:1px solid #2a2a3a; }
    .opp-header { display:flex; justify-content:space-between; padding:6px; background:#1a1a2a; border-radius:5px; cursor:pointer; font-weight:bold; color:var(--pink); font-size:calc(var(--base-font-size)*0.9); }
    .opp-list { max-height:280px; overflow-y:auto; }
    .opportunity { background:#111; padding:6px; margin:3px 0; border-radius:5px; border-left:3px solid var(--green); cursor:pointer; font-size:calc(var(--base-font-size)*0.9); }
    .opportunity:hover { border-left-color:var(--pink); background:#1a1a2a; }
    .opportunity.mega { border-left-color:var(--gold); animation:glow 1s infinite alternate; }
    @keyframes glow { from{box-shadow:0 0 3px var(--gold);} to{box-shadow:0 0 16px var(--gold);} }
    .log-container { background:#000; padding:6px; border-radius:5px; max-height:150px; overflow-y:auto; font-size:calc(var(--base-font-size)*0.7); margin-top:6px; }
    .modal { display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.85); z-index:10000; align-items:center; justify-content:center; }
    .modal-content { background:#1a1a2a; border:2px solid var(--pink); border-radius:10px; padding:16px; max-width:700px; width:95%; color:white; max-height:85vh; overflow-y:auto; }
    .flex-row { display:flex; gap:6px; align-items:center; flex-wrap:wrap; }
    input,select { background:#0a0a1a; border:1px solid var(--cyan); color:var(--cyan); padding:2px 5px; border-radius:3px; font-family:'Courier New',monospace; font-size:calc(var(--base-font-size)*0.9); }
    .checkbox-group { display:flex; flex-wrap:wrap; gap:3px; align-items:center; }
    .checkbox-group label { display:flex; align-items:center; gap:2px; font-size:calc(var(--base-font-size)*0.7); color:var(--cyan); }
    .tier-badge { display:inline-block; padding:1px 4px; border-radius:2px; font-size:calc(var(--base-font-size)*0.6); color:#000; margin-left:2px; }
    .tier-pico { background:#ffaa00; } .tier-femto { background:#ff00ff; } .tier-planck { background:#00f0ff; }
    .progress-bar { height:6px; background:#333; border-radius:3px; margin:3px 0; }
    .progress-fill { height:100%; background:var(--gold); border-radius:3px; width:0%; }
    .perk-unlocked { color:var(--green); } .perk-locked { color:#ff4444; text-decoration:line-through; }
    #graphSlotContainer { display:none; background:linear-gradient(180deg,#0a0a1a,#1a0a2a); border:3px solid var(--gold); border-radius:14px; padding:12px; margin:10px 0; text-align:center; box-shadow:0 0 30px rgba(255,215,0,0.3); position:relative; overflow:hidden; }
    #graphNetwork { display:block; margin:0 auto; position:relative; z-index:2; }
    #batchResult { background:#0a0a1a; border:1px solid var(--gold); border-radius:6px; padding:8px; margin-top:8px; font-size:calc(var(--base-font-size)*0.8); max-height:250px; overflow-y:auto; text-align:left; position:relative; z-index:2; }
    #batchHistory { background:#0a0a1a; border:1px solid var(--cyan); border-radius:6px; padding:8px; margin-top:8px; font-size:calc(var(--base-font-size)*0.7); max-height:150px; overflow-y:auto; text-align:left; position:relative; z-index:2; }
    .target-preset { border:1px solid var(--cyan); padding:2px 6px; border-radius:10px; cursor:pointer; font-size:calc(var(--base-font-size)*0.7); color:var(--cyan); background:transparent; }
    .target-preset:hover { background:var(--cyan); color:#000; }
    .tooltip { position:relative; display:inline-block; cursor:help; color:var(--gold); }
    .tooltip .tooltiptext { visibility:hidden; width:200px; background:#1a1a2a; color:#fff; text-align:center; border-radius:6px; padding:5px; position:absolute; z-index:10; bottom:125%; left:50%; margin-left:-100px; opacity:0; transition:opacity 0.3s; font-size:calc(var(--base-font-size)*0.7); }
    .tooltip:hover .tooltiptext { visibility:visible; opacity:1; }
    .panel { background:var(--card); border-radius:8px; padding:10px; margin:6px 0; border:1px solid var(--border); display:none; }
    .panel h3 { color:var(--cyan); font-size:calc(var(--base-font-size)*1.1); margin-bottom:6px; }
    .panel textarea { width:100%; background:#0a0a1a; color:var(--cyan); border:1px solid var(--cyan); font-family:'Courier New',monospace; font-size:calc(var(--base-font-size)*0.9); padding:4px; }
    .torrent-progress { height:10px; background:#333; border-radius:5px; margin:4px 0; }
    .torrent-fill { height:100%; background:var(--green); border-radius:5px; width:0%; }
    .player-row { cursor:pointer; padding:3px 5px; margin:2px 0; border-radius:3px; background:#0a0a1a; }
    .player-row:hover { background:#2a2a3a; }
  </style>
  <script src="https://cdn.jsdelivr.net/npm/yjs@13.6.7/dist/yjs.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/y-webrtc@10.3.0/dist/y-webrtc.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/webtorrent@1.9.6/webtorrent.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/qrcode@1.5.1/build/qrcode.min.js"></script>
</head>
<body>
  <!-- UI ... (identical to previous full HTML, omitted for brevity but present in artifact) -->
  <!-- For the sake of readability, I'll show the key script changes instead of repeating the entire massive file. -->

  <script>
    // ... all previous code unchanged until the Engine.runTestSuite ...

    // ═══════════════════════════════════════════════════════════════
    //  EXPANDED TEST SUITE – Every feature, control, and option
    // ═══════════════════════════════════════════════════════════════
    const Engine = {
      // ... other methods unchanged ...
      async runTestSuite(){
        log('🧪 FULL SYSTEM TEST SUITE – all exchanges, fiats, modals, P2P…','success');
        const results = [];
        const test = async (name, fn) => {
          try { await fn(); results.push(`✅ ${name}`); log(`✅ ${name}`,'success'); }
          catch (e) { results.push(`❌ ${name}: ${e.message}`); log(`❌ ${name}: ${e.message}`,'error'); }
        };

        // ── 1. Core trading engine ──────────────────────────
        await test('INIT System (all exchanges)', async () => {
          await initSystem();
          // Verify every defined exchange has a status
          const allDefs = [...exchangeDefs, ...(State.testnetsActive ? testnetExchangeDefs : [])];
          for (const d of allDefs) {
            const ex = State.exchanges[d.key];
            if (!ex || (ex.status !== 'online' && ex.status !== 'offline')) throw new Error(`${d.key} status missing`);
          }
          if (State.stats.totalPairs < 50) log('Warning: less than 50 pairs', 'warning');
        });

        await test('FULL SCAN (triangular + bellman)', async () => {
          await runFullScan(false, true);
          if (Object.values(State.opportunities).flat().length === 0) throw new Error('No opportunities generated');
        });

        await test('Graph Render (canvas populated)', () => {
          if (!State.graphRenderer) State.graphRenderer = new GraphRenderer('graphNetwork');
          State.computePurchasePower();
          State.graphRenderer.buildFromGraph(State.graph, State.opportunities, State.purchasePower, State.highlightedPaths);
          if (Object.keys(State.graphRenderer.nodes).length === 0) throw new Error('Graph nodes empty');
        });

        await test('Forex Fetch (all selected fiats)', async () => {
          // Toggle all fiat currencies temporarily to test full fetch
          const fiats = ['RUB','INR','EUR','GBP','JPY','CNY','KRW','AUD','CAD','CHF','AED','TRY','BRL','SGD','PLN'];
          const prevSelected = new Set(State.selectedFiats);
          fiats.forEach(f => State.selectedFiats.add(f));
          await fetchForexRates();
          fiats.forEach(f => { if (!(f in State.forexRates)) throw new Error(`Missing rate for ${f}`); });
          State.selectedFiats = prevSelected;
          State.save();
        });

        await test('Coin Levels & Index Fund Allocation', () => {
          if (!State.userCoins.length) {
            State.userCoins.push({ symbol:'TEST', price:1, liq:1000, quote:'USDT', exchange:'QUANTM_DEX' });
            State.allPairs.push({ base:'TEST', target:'USDT', price:1, volume:300, liquidity:1000, bidPrice:0.999, askPrice:1.001, exchange:'QUANTM_DEX', exchangeType:'dex' });
          }
          State.addCoinXP('TEST', 5);
          if ((State.coinLevels['TEST']||1) < 6) throw new Error('Coin XP not applied');
          // Simulate a profit to trigger index fund
          const oldBankroll = State.bankroll;
          State.bankroll += 100;
          State.allocateIndexFund(100);
          if (State.bankroll >= oldBankroll + 100) throw new Error('Index fund allocation didn’t reduce bankroll');
        });

        await test('Live Testnet Trade (simulated)', async () => {
          const prevLive = State.liveMode, prevTest = State.liveTestMode;
          State.liveMode = true; State.liveTestMode = true;
          const opp = State.opportunities.triangular[0] || { path:['USD','USDT','EUR','USD'], edges:[{rate:1.01,liquidity:10000},{rate:0.99,liquidity:10000},{rate:1.001,liquidity:10000}], maxTradeSize:100, profitPercent:0.5 };
          await Engine.executeTrade(opp, 100, 1);
          if (!State.liveTradeHistory.length) throw new Error('Live trade not recorded');
          State.liveMode = prevLive; State.liveTestMode = prevTest;
          UI.updateProfile();
        });

        await test('Dashboard & Performance Stats', () => {
          UI.updateDashboard();
          const total = document.getElementById('totalTrades').textContent;
          if (total === '0') log('Dashboard has 0 trades – normal if none executed', 'warning');
        });

        await test('CSV Export', () => {
          if (State.tradeLedger.length === 0) State.tradeLedger.push({ time:new Date().toISOString(), path:'TEST', size:100, profit:10, type:'test', live:false, testnet:false });
          Engine.exportCSV();
        });

        await test('Batch Execute (all paylines)', async () => {
          if (State.bankroll <= 0) throw new Error('Bankroll exhausted before batch test');
          if (!State.highlightedPaths.length) {
            State.highlightedPaths = [State.opportunities.triangular[0]?.path || ['USD','USDT','EUR','USD']];
          }
          await Engine.executeAllLines();
        });

        await test('Level Perks & Constraints', () => {
          UI.applyLevelConstraints();
          UI.renderPerks();
          const el = document.getElementById('perksList');
          if (el.innerHTML.length < 10) throw new Error('Perks not rendered');
          // Check that Bellman is locked below level 5
          if (State.level < 5) {
            if (!document.getElementById('bellmanToggle').disabled) throw new Error('Bellman should be locked');
          }
        });

        await test('Save/Load Persistence', () => {
          const prevBankroll = State.bankroll;
          State.save();
          State.load();
          if (State.bankroll !== prevBankroll) throw new Error('Save/Load mismatch');
        });

        await test('Pull Cooldown Enforcement', () => {
          const cd = State.getPullCooldown();
          document.getElementById('pullLeverBtn2').disabled = false;
          if (typeof cd !== 'number' || cd <= 0) throw new Error('Invalid cooldown');
        });

        await test('Live Scan Interval Based on Level', () => {
          const iv = State.getLiveScanInterval();
          if (typeof iv !== 'number' || iv <= 0) throw new Error('Invalid interval');
        });

        await test('UI Scale Slider', () => {
          setUIScale(12);
          if (document.documentElement.style.getPropertyValue('--base-font-size') !== '12px') throw new Error('Scale not applied');
          setUIScale(10);
        });

        // ── 2. UI controls & options ──────────────────────
        await test('Bet/Depth Sliders Sync', () => {
          document.getElementById('betSlider').value = 5000;
          syncBetInput();
          if (document.getElementById('betInput').value !== '5000') throw new Error('Bet sync failed');
          document.getElementById('pathSlider').value = 8;
          UI.syncPathInput();
          if (document.getElementById('pathInput').value !== '8') throw new Error('Depth sync failed');
          // reset
          document.getElementById('betSlider').value = 1000; syncBetInput();
          document.getElementById('pathSlider').value = 5; UI.syncPathInput();
        });

        await test('Arb Mode Toggle', () => {
          const select = document.getElementById('arbMode');
          select.value = 'intra';
          if (getGraphPairs().length !== [...State.selectedIntraExchanges].flatMap(k => State.exchanges[k]?.pairs || []).length) {
            throw new Error('Intra mode did not filter pairs');
          }
          select.value = 'both';
        });

        await test('Short Toggle', () => {
          const cb = document.getElementById('shortToggle');
          cb.checked = !cb.checked;
          UI.logButton('Short toggle (test)');
          cb.checked = !cb.checked;
        });

        await test('Bellman Toggle & Level Gate', () => {
          const cb = document.getElementById('bellmanToggle');
          if (State.level >= 5) {
            cb.checked = !cb.checked;
            UI.logButton('Bellman toggle (test)');
            cb.checked = !cb.checked;
          }
        });

        await test('Target Presets', () => {
          setTargetPreset('BTC,ETH,SOL,LINK');
          if (document.getElementById('targetAssetsInput').value !== 'BTC,ETH,SOL,LINK') throw new Error('Preset not applied');
          setTargetPreset('USDT,USDC,USD,GUSD');
        });

        await test('Reinvest & Index Fund Percentage Inputs', () => {
          document.getElementById('reinvestPercent').value = 75;
          document.getElementById('indexFundPercent').value = 10;
          if (document.getElementById('reinvestPercent').value !== '75') throw new Error('Reinvest input fail');
          if (document.getElementById('indexFundPercent').value !== '10') throw new Error('Index input fail');
          document.getElementById('reinvestPercent').value = 50;
          document.getElementById('indexFundPercent').value = 5;
        });

        await test('Smart Batch Toggle', () => {
          const cb = document.getElementById('smartBatchToggle');
          cb.checked = !cb.checked;
          cb.checked = !cb.checked;
        });

        await test('Basket Input', () => {
          document.getElementById('basketInput').value = 'BTC,ETH,DOGE';
          State.save();
          if (document.getElementById('basketInput').value !== 'BTC,ETH,DOGE') throw new Error('Basket not saved');
        });

        await test('Wallet Address Inputs', () => {
          document.getElementById('solAddress').value = 'TestSolWallet123';
          document.getElementById('ethAddress').value = '0xTestEthWallet';
          State.saveWallet();
          if (localStorage.getItem('wallet_sol') !== 'TestSolWallet123') throw new Error('SOL wallet not saved');
          if (localStorage.getItem('wallet_eth') !== '0xTestEthWallet') throw new Error('ETH wallet not saved');
        });

        await test('Proxy Config Save & Modes', () => {
          document.getElementById('proxySelect').value = 'builtin';
          UI.onProxyChange();
          saveProxyConfig();
          if (State.proxyMode !== 'builtin') throw new Error('Proxy mode not saved');
          document.getElementById('proxySelect').value = 'direct';
          UI.onProxyChange();
          saveProxyConfig();
        });

        await test('Testnets Toggle', () => {
          const old = State.testnetsActive;
          toggleTestnets();
          if (State.testnetsActive === old) throw new Error('Testnets toggle failed');
          toggleTestnets();
        });

        await test('Pause Logs Toggle', () => {
          const old = logsPaused;
          togglePauseLogs();
          if (logsPaused === old) throw new Error('Pause logs toggle failed');
          togglePauseLogs();
        });

        await test('Theme Toggle', () => {
          const oldFilter = document.body.style.filter;
          toggleTheme();
          if (document.body.style.filter === oldFilter) throw new Error('Theme toggle had no effect');
          toggleTheme();
        });

        await test('Share Jackpot (clipboard)', async () => {
          if (!State.opportunities.mega.length) {
            State.opportunities.mega.push({ profitPercent: 10, path: ['TEST','USDT'], edges:[] });
          }
          shareJackpot();
        });

        // ── 3. Fiat & Intra exchange checkboxes ───────────
        await test('All Fiat Checkboxes Render & Toggle', () => {
          const container = document.getElementById('fiatCheckboxes');
          const checkboxes = container.querySelectorAll('input[type="checkbox"]');
          if (checkboxes.length !== 15) throw new Error(`Expected 15 fiat checkboxes, found ${checkboxes.length}`);
          // toggle each
          checkboxes.forEach(cb => {
            cb.checked = !cb.checked;
            UI.toggleFiat(cb.value);
          });
          // after toggling all, size should be 0 or 15 depending on initial
          if (State.selectedFiats.size !== 0 && State.selectedFiats.size !== 15) {
            // both possible, accept
          }
        });

        await test('Intra Exchange Select All / None', () => {
          selectAllIntra();
          if (State.selectedIntraExchanges.size === 0) throw new Error('Select all did not add exchanges');
          deselectAllIntra();
          if (State.selectedIntraExchanges.size !== 0) throw new Error('Deselect all failed');
          // restore at least one online exchange
          const online = Object.keys(State.exchanges).filter(k => State.exchanges[k].status === 'online' && State.exchanges[k].parser !== 'coingecko');
          if (online.length) {
            State.selectedIntraExchanges.add(online[0]);
            updateIntraExCheckboxes();
          }
        });

        // ── 4. Modals ──────────────────────────────────────
        await test('Create Coin Modal Open/Close', () => {
          // bypass level gate for test
          const origLevel = State.level;
          State.level = 10;
          openCreateCoinModal();
          if (document.getElementById('createCoinModal').style.display !== 'flex') throw new Error('Create coin modal not shown');
          closeCreateCoinModal();
          if (document.getElementById('createCoinModal').style.display !== 'none') throw new Error('Modal did not close');
          State.level = origLevel;
        });

        await test('Pump Launch Modal Open/Close', () => {
          const origLevel = State.level;
          State.level = 10;
          openPumpLaunchModal();
          if (document.getElementById('pumpLaunchModal').style.display !== 'flex') throw new Error('Pump modal not shown');
          closePumpLaunchModal();
          State.level = origLevel;
        });

        await test('API Keys Modal & Save', () => {
          openApiKeysModal();
          const keyInput = document.querySelector('.api-key-input');
          if (!keyInput) throw new Error('No API key input found');
          keyInput.value = 'test-api-key-123';
          keyInput.closest('.flex-row').querySelector('.api-enable').checked = true;
          saveApiKeysFromModal();
          if (State.apiKeys[keyInput.dataset.ex] !== 'test-api-key-123') throw new Error('API key not saved');
        });

        await test('Trade Modal (opp click)', () => {
          const opp = State.opportunities.triangular[0] || { path:['A','B','C'], edges:[{rate:1,liquidity:1000},{rate:1,liquidity:1000},{rate:1,liquidity:1000}], maxTradeSize:100, profitPercent:0 };
          UI.openTradeModal(encodeURIComponent(JSON.stringify(opp)));
          if (document.getElementById('tradeModal').style.display !== 'flex') throw new Error('Trade modal not shown');
          closeModal();
        });

        // ── 5. WebSocket & Live Scan ──────────────────────
        await test('WebSocket Connections (status check)', async () => {
          connectAllWebSockets();
          // wait a bit
          await new Promise(r => setTimeout(r, 500));
          const okxStatus = State.exchanges['okx']?.wsStatus;
          const binanceStatus = State.exchanges['binance']?.wsStatus;
          if (okxStatus === 'off' && binanceStatus === 'off') log('WebSocket may be blocked in test env', 'warning');
        });

        await test('Live Scan Toggle', () => {
          if (State.liveScanActive) {
            toggleLiveScan();
            if (State.liveScanActive) throw new Error('Live scan not stopped');
          } else {
            toggleLiveScan();
            if (!State.liveScanActive) throw new Error('Live scan not started');
            toggleLiveScan(); // stop
          }
        });

        // ── 6. P2P / Swarm modules ──────────────────────
        await test('DuckDB Initialization', async () => {
          if (!State.db) await initDuckDB();
          if (!State.db) throw new Error('DuckDB not loaded');
          await State.conn.query('SELECT 1 AS check');
        });

        await test('Yjs Swarm Join', async () => {
          if (!State.ydoc) await initYjs();
          if (!State.ydoc) throw new Error('Yjs not initialised');
          State.ymap.set('test', 'hello');
        });

        await test('Mana Increments', () => {
          const prevC = State.mana.compute, prevD = State.mana.data, prevT = State.mana.trade;
          addMana('compute', 1); addMana('data', 1); addMana('trade', 1);
          if (State.mana.compute <= prevC || State.mana.data <= prevD || State.mana.trade <= prevT) throw new Error('Mana not incremented');
        });

        await test('DEX Order Book & Placement', () => {
          if (!window.yDexOrders) initDEX();
          if (!window.yDexOrders) throw new Error('DEX Yjs array not ready');
          window.yDexOrders.push([{id:Date.now(), side:'buy', coin:'TEST', amount:1, user:NODE_ID, handle:playerHandle}]);
          if (!window.yDexOrders.length) throw new Error('Order not added');
          renderDEXOrderBook(window.yDexOrders);
        });

        await test('QR Code Generation', () => {
          generateQRCode();
          const canvas = document.getElementById('qrCanvas');
          if (!canvas || canvas.toDataURL().length < 100) throw new Error('QR empty');
        });

        await test('IPNS Check (connectivity)', async () => {
          await checkIPNSUpdate();
          const status = document.getElementById('ipnsStatus').textContent;
          if (status.includes('unreachable') || status.includes('failed')) throw new Error('IPNS unreachable');
        });

        await test('Private Strategy Room Creation', () => {
          const origLevel = State.level;
          State.level = 10;
          createPrivateRoom();
          const info = document.getElementById('privateRoomInfo').textContent;
          if (!info.includes('Room created')) throw new Error('Room not created');
          State.level = origLevel;
        });

        await test('Torrent Client Instanciation', () => {
          if (!State.torrentClient) {
            try { State.torrentClient = new WebTorrent(); } catch {}
          }
          if (!State.torrentClient) throw new Error('WebTorrent not available');
        });

        // ── Final report ──────────────────────────────────
        log(`🧪 COMPREHENSIVE TEST SUITE DONE: ${results.filter(r=>r.startsWith('✅')).length}/${results.length} passed`,'success');
        document.getElementById('batchResult').innerHTML = '<strong>🧪 FULL TEST RESULTS</strong><br>'+results.join('<br>');
      }
      // ... rest of Engine methods unchanged ...
    };

    // ... remaining code (bootstrap, globals, etc.) identical ...
    // (Full code available in the complete artifact)
  </script>
</body>
</html>
