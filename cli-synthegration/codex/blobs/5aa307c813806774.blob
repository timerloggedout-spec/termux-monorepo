CREATE TABLE entity_hs_code (
    entity_id           UUID REFERENCES entity(entity_id) ON DELETE CASCADE,
    hs_code             VARCHAR(10),           -- e.g., "2937.19" for peptide hormones
    hs_description      TEXT,
    jurisdiction_code   CHAR(2) REFERENCES country(jurisdiction_code), -- jurisdiction-specific classification
    duty_rate_ad_valorem DECIMAL(5,2),        -- percentage
    duty_rate_specific  TEXT,                  -- e.g., "$0.50/kg"
    vat_rate            DECIMAL(5,2),
    notes               TEXT,
    effective_date      DATE,
    source_url          TEXT,
    last_verified_at    TIMESTAMP WITH TIME ZONE,
    PRIMARY KEY (entity_id, hs_code, jurisdiction_code)
);
