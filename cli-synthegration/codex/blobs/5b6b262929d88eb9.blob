<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>Do Hard Things 365 | Official Fan Hub</title>
  <!-- Font Awesome 6 (free icons) -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      background: #0b0c0e;
      font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
      color: #f0f2f5;
      line-height: 1.5;
      overflow-x: hidden;
    }

    /* ---- TYPOGRAPHY & COLORS ---- */
    h1, h2, h3 {
      font-weight: 700;
      letter-spacing: -0.02em;
    }

    h1 {
      font-size: clamp(3rem, 8vw, 5.5rem);
      line-height: 1.1;
      text-transform: uppercase;
    }

    h2 {
      font-size: clamp(2rem, 5vw, 3rem);
      margin-bottom: 1.5rem;
      position: relative;
      display: inline-block;
    }

    h2::after {
      content: '';
      position: absolute;
      bottom: -8px;
      left: 0;
      width: 60%;
      height: 4px;
      background: #ff5722;
      border-radius: 4px;
    }

    .accent {
      color: #ff5722;
    }

    .text-muted {
      color: #aaa;
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 1.5rem;
    }

    /* ---- BUTTONS ---- */
    .btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.85rem 2rem;
      border-radius: 40px;
      font-weight: 600;
      text-decoration: none;
      transition: all 0.25s ease;
      border: 2px solid transparent;
      cursor: pointer;
    }

    .btn-primary {
      background: #ff5722;
      color: #fff;
      border-color: #ff5722;
      box-shadow: 0 8px 20px rgba(255, 87, 34, 0.4);
    }

    .btn-primary:hover {
      background: #e64a19;
      border-color: #e64a19;
      transform: translateY(-2px);
      box-shadow: 0 12px 28px rgba(255, 87, 34, 0.5);
    }

    .btn-outline {
      border-color: #ff5722;
      color: #ff5722;
      background: transparent;
    }

    .btn-outline:hover {
      background: #ff5722;
      color: #fff;
      transform: translateY(-2px);
    }

    /* ---- HERO ---- */
    .hero {
      min-height: 90vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      background: radial-gradient(circle at 30% 40%, #1f1f1f, #0b0c0e);
      padding: 3rem 1.5rem;
      position: relative;
    }

    .hero-badge {
      background: rgba(255, 87, 34, 0.15);
      color: #ff5722;
      padding: 0.4rem 1.4rem;
      border-radius: 30px;
      font-weight: 600;
      letter-spacing: 0.05em;
      margin-bottom: 1.5rem;
      border: 1px solid rgba(255, 87, 34, 0.3);
    }

    .hero p {
      font-size: 1.25rem;
      max-width: 650px;
      margin: 1.5rem auto 2rem;
    }

    .hero-buttons {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
      justify-content: center;
    }

    /* ---- STATS BAR ---- */
    .stats-bar {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 2.5rem;
      background: #111;
      padding: 2rem 1.5rem;
      border-top: 1px solid #222;
      border-bottom: 1px solid #222;
    }

    .stat-item {
      text-align: center;
    }

    .stat-number {
      font-size: 2.2rem;
      font-weight: 800;
      color: #ff5722;
    }

    .stat-label {
      font-size: 0.9rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: #aaa;
    }

    /* ---- SECTIONS ---- */
    section {
      padding: 5rem 0;
    }

    .section-header {
      margin-bottom: 3rem;
    }

    /* ---- PHILOSOPHY CARDS ---- */
    .cards-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 2rem;
      margin-top: 2rem;
    }

    .card {
      background: #16181a;
      border-radius: 20px;
      padding: 2rem 1.5rem;
      border: 1px solid #2a2a2a;
      transition: transform 0.2s ease, border-color 0.2s;
    }

    .card:hover {
      transform: translateY(-6px);
      border-color: #ff5722;
    }

    .card i {
      font-size: 2.2rem;
      color: #ff5722;
      margin-bottom: 1rem;
    }

    .card h3 {
      margin-bottom: 0.75rem;
      font-size: 1.4rem;
    }

    /* ---- FEATS TABLE / GRID ---- */
    .feats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1.5rem;
    }

    .feat-item {
      background: #16181a;
      border-radius: 16px;
      padding: 1.8rem 1.2rem;
      text-align: center;
      border-left: 4px solid #ff5722;
    }

    .feat-number {
      font-size: 2.4rem;
      font-weight: 800;
      color: #ff5722;
      line-height: 1.2;
    }

    .feat-desc {
      margin-top: 0.5rem;
      font-weight: 600;
    }

    /* ---- VIDEO PREVIEW ---- */
    .video-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 2rem;
      margin-top: 2rem;
    }

    .video-card {
      background: #16181a;
      border-radius: 18px;
      overflow: hidden;
      border: 1px solid #2a2a2a;
      transition: all 0.2s;
    }

    .video-card:hover {
      border-color: #ff5722;
      transform: scale(1.02);
    }

    .video-thumb {
      width: 100%;
      aspect-ratio: 16/9;
      background: #1e1e1e;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #ff5722;
      font-size: 2.5rem;
    }

    .video-info {
      padding: 1.2rem 1rem;
    }

    .video-info h4 {
      font-size: 1.1rem;
      margin-bottom: 0.4rem;
    }

    .video-meta {
      font-size: 0.85rem;
      color: #aaa;
    }

    /* ---- COMMUNITY CTA ---- */
    .community-cta {
      background: linear-gradient(135deg, #1a1a1a 0%, #0f0f0f 100%);
      border-radius: 30px;
      padding: 3rem 2rem;
      text-align: center;
      border: 1px solid #333;
      margin-top: 2rem;
    }

    .community-cta h2 {
      margin-bottom: 1rem;
    }

    .community-cta .btn {
      margin-top: 1.5rem;
    }

    /* ---- FOOTER ---- */
    footer {
      text-align: center;
      padding: 2.5rem 1rem;
      color: #666;
      border-top: 1px solid #222;
    }

    footer a {
      color: #ff5722;
      text-decoration: none;
    }

    /* ---- RESPONSIVE ---- */
    @media (max-width: 600px) {
      .hero h1 {
        font-size: 2.8rem;
      }
    }
  </style>
</head>
<body>

  <!-- HERO -->
  <header class="hero">
    <div class="hero-badge">🔥 #DHT365</div>
    <h1>DO HARD THINGS<br><span class="accent">365</span></h1>
    <p>1% better every day. Extreme endurance. Unbreakable mindset.<br>Join Rich Hernandez and a global community that refuses to quit.</p>
    <div class="hero-buttons">
      <a href="https://www.youtube.com/@Dohardthings365" target="_blank" class="btn btn-primary"><i class="fab fa-youtube"></i> Subscribe on YouTube</a>
      <a href="https://www.instagram.com/dohardthings365/" target="_blank" class="btn btn-outline"><i class="fab fa-instagram"></i> Instagram</a>
    </div>
  </header>

  <!-- STATS -->
  <div class="stats-bar">
    <div class="stat-item"><span class="stat-number">11.6K</span><div class="stat-label">Subscribers</div></div>
    <div class="stat-item"><span class="stat-number">2,097</span><div class="stat-label">Videos</div></div>
    <div class="stat-item"><span class="stat-number">70.5M+</span><div class="stat-label">Total Views</div></div>
    <div class="stat-item"><span class="stat-number">3,000+</span><div class="stat-label">Consecutive Push‑Ups</div></div>
  </div>

  <!-- ABOUT / FOUNDER -->
  <section>
    <div class="container">
      <div class="section-header">
        <h2>Meet the Founder</h2>
      </div>
      <div style="display: flex; flex-wrap: wrap; gap: 2rem; align-items: center;">
        <div style="flex: 1 1 250px; text-align: center;">
          <div style="width: 200px; height: 200px; background: #222; border-radius: 50%; margin: 0 auto; display: flex; align-items: center; justify-content: center; border: 4px solid #ff5722;">
            <i class="fas fa-user" style="font-size: 5rem; color: #ff5722;"></i>
          </div>
        </div>
        <div style="flex: 2 1 400px;">
          <h3 style="font-size: 2rem; margin-bottom: 0.5rem;">Rich Hernandez</h3>
          <p style="color: #ff5722; font-weight: 600; margin-bottom: 1rem;">Founder of Do Hard Things 365 · Extreme Athlete · Engineer</p>
          <p>Rich traded a successful engineering and business career to chase one mission: <strong>influence and inspire through extreme physical challenges</strong>. After reading David Goggins' <em>Can't Hurt Me</em>, he committed to doing something hard every single day—and sharing it with the world.</p>
          <p style="margin-top: 1rem;">His feats include <strong>3,000 consecutive push‑ups, a four‑hour plank, running the Grand Canyon rim‑to‑rim‑to‑rim,</strong> and countless live endurance sessions that push human limits.</p>
          <a href="https://www.iheart.com/podcast/269-tom-rowland-podcast-29945420/episode/rich-hernandez-do-hard-things-272680151/" target="_blank" class="btn btn-outline" style="margin-top: 1.5rem;"><i class="fas fa-podcast"></i> Hear the Tom Rowland Podcast</a>
        </div>
      </div>
    </div>
  </section>

  <!-- PHILOSOPHY -->
  <section style="background: #0e0f10;">
    <div class="container">
      <div class="section-header">
        <h2>The DHT365 Philosophy</h2>
      </div>
      <div class="cards-grid">
        <div class="card">
          <i class="fas fa-calendar-check"></i>
          <h3>Do Something Hard Every Day</h3>
          <p>Discipline beats motivation. A daily hard task—big or small—builds momentum that transforms your life.</p>
        </div>
        <div class="card">
          <i class="fas fa-cookie-bite"></i>
          <h3>The Cookie Jar</h3>
          <p>Inspired by David Goggins, Rich keeps a mental "cookie jar" of past victories. When doubt creeps in, he pulls one out and remembers what he's already conquered.</p>
        </div>
        <div class="card">
          <i class="fas fa-users"></i>
          <h3>Community & Accountability</h3>
          <p>You're not meant to grind alone. The DHT365 community keeps you accountable, shares wins, and reminds you that someone else is doing hard things right now too.</p>
        </div>
        <div class="card">
          <i class="fas fa-chart-line"></i>
          <h3>1% Better Every Day</h3>
          <p>Small, consistent improvements compound into massive change. The goal isn't perfection—it's progress, day after day.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- NOTABLE FEATS -->
  <section>
    <div class="container">
      <div class="section-header">
        <h2>Mind‑Boggling Feats</h2>
      </div>
      <div class="feats-grid">
        <div class="feat-item">
          <div class="feat-number">3,000</div>
          <div class="feat-desc">Consecutive Push‑Ups</div>
        </div>
        <div class="feat-item">
          <div class="feat-number">4‑Hour</div>
          <div class="feat-desc">Plank Hold</div>
        </div>
        <div class="feat-item">
          <div class="feat-number">10,000+</div>
          <div class="feat-desc">Push‑Ups in One Session</div>
        </div>
        <div class="feat-item">
          <div class="feat-number">Rim‑to‑Rim‑to‑Rim</div>
          <div class="feat-desc">Grand Canyon Run</div>
        </div>
        <div class="feat-item">
          <div class="feat-number">24‑Hour</div>
          <div class="feat-desc">Push‑Ups & Pull‑Ups Livestream</div>
        </div>
        <div class="feat-item">
          <div class="feat-number">1,490+</div>
          <div class="feat-desc">Consecutive Push‑Ups (Daily Challenge)</div>
        </div>
      </div>
      <p style="text-align: center; margin-top: 2rem; color: #aaa;">These are just a few highlights. Every week brings a new test of human endurance.</p>
    </div>
  </section>

  <!-- RECENT VIDEOS -->
  <section style="background: #0e0f10;">
    <div class="container">
      <div class="section-header">
        <h2>🔥 Latest Uploads</h2>
      </div>
      <div class="video-grid">
        <div class="video-card">
          <div class="video-thumb"><i class="fab fa-youtube"></i></div>
          <div class="video-info">
            <h4>I Walked 13 Miles… This Is Why I Can Do 11K Pushups</h4>
            <div class="video-meta">1.4K views · 4 weeks ago</div>
          </div>
        </div>
        <div class="video-card">
          <div class="video-thumb"><i class="fab fa-youtube"></i></div>
          <div class="video-info">
            <h4>I Did 11,111 Pushups… Here’s the Full Session</h4>
            <div class="video-meta">1K views · 1 month ago</div>
          </div>
        </div>
        <div class="video-card">
          <div class="video-thumb"><i class="fab fa-youtube"></i></div>
          <div class="video-info">
            <h4>How to Build Up to 1,000 Pushups (Most People Train Them Wrong)</h4>
            <div class="video-meta">8.6K views · 1 month ago</div>
          </div>
        </div>
        <div class="video-card">
          <div class="video-thumb"><i class="fab fa-youtube"></i></div>
          <div class="video-info">
            <h4>10,000 Pushups LIVE (Full 8.5 Hour Livestream)</h4>
            <div class="video-meta">2.2K views · 2 months ago</div>
          </div>
        </div>
        <div class="video-card">
          <div class="video-thumb"><i class="fab fa-youtube"></i></div>
          <div class="video-info">
            <h4>Slowest Continuous Push‑Up Ever (4+ Minutes)</h4>
            <div class="video-meta">1.2K views · 3 months ago</div>
          </div>
        </div>
        <div class="video-card">
          <div class="video-thumb"><i class="fab fa-youtube"></i></div>
          <div class="video-info">
            <h4>24 HR of PUSHUPS and PULLUPS (Parts 1‑3)</h4>
            <div class="video-meta">1.8K views · 6 months ago</div>
          </div>
        </div>
      </div>
      <div style="text-align: center; margin-top: 2.5rem;">
        <a href="https://www.youtube.com/@Dohardthings365/videos" target="_blank" class="btn btn-outline"><i class="fab fa-youtube"></i> Browse All Videos</a>
      </div>
    </div>
  </section>

  <!-- COMMUNITY -->
  <section>
    <div class="container">
      <div class="community-cta">
        <h2>Join the DHT365 Community</h2>
        <p style="font-size: 1.2rem; max-width: 600px; margin: 0 auto;">The heartbeat of Do Hard Things 365 is growing fast on <strong>Skool</strong> and <strong>YouTube</strong>. Connect with like‑minded people, share your daily "hard thing", and build unstoppable momentum.</p>
        <div style="margin-top: 2rem; display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
          <a href="https://www.youtube.com/@Dohardthings365" target="_blank" class="btn btn-primary"><i class="fab fa-youtube"></i> YouTube Community</a>
          <a href="https://www.instagram.com/dohardthings365/" target="_blank" class="btn btn-outline"><i class="fab fa-instagram"></i> Instagram</a>
          <a href="https://www.skool.com/first50" target="_blank" class="btn btn-outline"><i class="fas fa-users"></i> FIRST50 on Skool</a>
        </div>
        <p style="margin-top: 1.5rem; font-size: 0.9rem; color: #aaa;">#DHT365 · 1% better every day. Let's level up together. 💪</p>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer>
    <p>This is a fan‑made tribute to <a href="https://www.youtube.com/@Dohardthings365" target="_blank">@DoHardThings365</a>. Not affiliated with YouTube or Rich Hernandez.</p>
    <p style="margin-top: 0.5rem;">Built with 🔥 for the Do Hard Things community · 2026</p>
  </footer>

</body>
</html>
