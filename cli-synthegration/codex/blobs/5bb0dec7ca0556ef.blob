const handleFileUpload = (event) => {
  const file = event.target.files[0];
  Papa.parse(file, {
    header: true,
    complete: async (results) => {
      const compounds = results.data.map(transformRawCompound);
      await syncCompoundsToSheet(compounds);
      // Refresh local state
      const freshData = await fetchCompounds();
      setCompounds(freshData);
    },
  });
};
