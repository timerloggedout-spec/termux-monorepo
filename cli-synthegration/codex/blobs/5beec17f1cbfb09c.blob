<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>QuanTM FOAM | Quantum Investment Interface</title>
    <style>
        :root {
            --primary: #00f0ff;
            --secondary: #ff00ff;
            --accent: #00ffaa;
            --dark: #0a0a1a;
            --darker: #050510;
            --light: #a0a0ff;
            --glow: 0 0 10px currentColor, 0 0 20px currentColor, 0 0 30px currentColor;
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Orbitron', monospace;
        }
        
        body {
            background: linear-gradient(135deg, var(--darker) 0%, var(--dark) 100%);
            color: var(--light);
            min-height: 100vh;
            overflow-x: hidden;
            position: relative;
        }
        
        body::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: 
                radial-gradient(circle at 20% 50%, rgba(0, 240, 255, 0.1) 0%, transparent 50%),
                radial-gradient(circle at 80% 20%, rgba(255, 0, 255, 0.1) 0%, transparent 50%),
                radial-gradient(circle at 40% 80%, rgba(0, 255, 170, 0.1) 0%, transparent 50%);
            pointer-events: none;
            z-index: -1;
        }
        
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
        }
        
        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 0;
            border-bottom: 1px solid rgba(0, 240, 255, 0.3);
            margin-bottom: 30px;
        }
        
        .logo {
            display: flex;
            align-items: center;
            gap: 10px;
        }
        
        .logo-icon {
            width: 40px;
            height: 40px;
            background: var(--primary);
            border-radius: 50%;
            position: relative;
            box-shadow: var(--glow);
        }
        
        .logo-icon::before, .logo-icon::after {
            content: '';
            position: absolute;
            width: 100%;
            height: 100%;
            border-radius: 50%;
            border: 2px solid var(--secondary);
            animation: pulse 3s infinite;
        }
        
        .logo-icon::after {
            border-color: var(--accent);
            animation-delay: 1.5s;
        }
        
        @keyframes pulse {
            0% { transform: scale(1); opacity: 1; }
            100% { transform: scale(2); opacity: 0; }
        }
        
        .logo-text {
            font-size: 28px;
            font-weight: 700;
            background: linear-gradient(90deg, var(--primary), var(--secondary));
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            text-shadow: 0 0 10px rgba(0, 240, 255, 0.5);
        }
        
        .user-info {
            display: flex;
            align-items: center;
            gap: 15px;
        }
        
        .qbucks-display {
            background: rgba(0, 0, 0, 0.5);
            padding: 8px 15px;
            border-radius: 20px;
            border: 1px solid var(--primary);
            box-shadow: 0 0 10px rgba(0, 240, 255, 0.3);
        }
        
        .level-display {
            background: rgba(0, 0, 0, 0.5);
            padding: 8px 15px;
            border-radius: 20px;
            border: 1px solid var(--secondary);
            box-shadow: 0 0 10px rgba(255, 0, 255, 0.3);
        }
        
        .main-content {
            display: grid;
            grid-template-columns: 1fr 300px;
            gap: 30px;
        }
        
        .investment-interface {
            background: rgba(10, 10, 26, 0.7);
            border-radius: 15px;
            padding: 20px;
            border: 1px solid rgba(0, 240, 255, 0.2);
            box-shadow: 0 0 20px rgba(0, 240, 255, 0.1);
            position: relative;
            overflow: hidden;
        }
        
        .investment-interface::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 3px;
            background: linear-gradient(90deg, var(--primary), var(--secondary), var(--accent));
        }
        
        .portal-section {
            text-align: center;
            margin-bottom: 30px;
        }
        
        .portal-button {
            background: linear-gradient(45deg, var(--primary), var(--secondary));
            border: none;
            color: white;
            padding: 15px 30px;
            border-radius: 30px;
            font-size: 18px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s;
            box-shadow: 0 0 15px rgba(0, 240, 255, 0.5);
            margin: 20px 0;
        }
        
        .portal-button:hover {
            transform: scale(1.05);
            box-shadow: 0 0 25px rgba(0, 240, 255, 0.8);
        }
        
        .investment-options {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 20px;
            margin-top: 30px;
        }
        
        .investment-card {
            background: rgba(0, 0, 0, 0.5);
            border-radius: 10px;
            padding: 15px;
            border: 1px solid rgba(255, 0, 255, 0.3);
            transition: all 0.3s;
            cursor: pointer;
            position: relative;
            overflow: hidden;
        }
        
        .investment-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 0, 255, 0.2), transparent);
            transition: left 0.5s;
        }
        
        .investment-card:hover::before {
            left: 100%;
        }
        
        .investment-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 5px 15px rgba(255, 0, 255, 0.3);
        }
        
        .investment-card.locked {
            opacity: 0.5;
            cursor: not-allowed;
        }
        
        .investment-card.locked::after {
            content: 'LOCKED';
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background: rgba(0, 0, 0, 0.8);
            padding: 5px 10px;
            border-radius: 5px;
            font-size: 12px;
            color: var(--accent);
        }
        
        .investment-icon {
            width: 50px;
            height: 50px;
            background: rgba(0, 255, 170, 0.2);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 10px;
            font-size: 24px;
        }
        
        .sidebar {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }
        
        .tech-tree {
            background: rgba(10, 10, 26, 0.7);
            border-radius: 15px;
            padding: 20px;
            border: 1px solid rgba(0, 255, 170, 0.2);
            box-shadow: 0 0 20px rgba(0, 255, 170, 0.1);
        }
        
        .tech-tree h3 {
            margin-bottom: 15px;
            color: var(--accent);
            text-align: center;
        }
        
        .tech-node {
            background: rgba(0, 0, 0, 0.5);
            padding: 10px;
            border-radius: 8px;
            margin-bottom: 10px;
            border-left: 3px solid var(--accent);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .tech-node.locked {
            opacity: 0.5;
        }
        
        .sweepstakes {
            background: rgba(10, 10, 26, 0.7);
            border-radius: 15px;
            padding: 20px;
            border: 1px solid rgba(255, 0, 255, 0.2);
            box-shadow: 0 0 20px rgba(255, 0, 255, 0.1);
            text-align: center;
        }
        
        .sweepstakes h3 {
            margin-bottom: 15px;
            color: var(--secondary);
        }
        
        .boom-particle {
            position: fixed;
            width: 5px;
            height: 5px;
            border-radius: 50%;
            pointer-events: none;
            z-index: 1000;
        }
        
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(5, 5, 16, 0.9);
            z-index: 2000;
            align-items: center;
            justify-content: center;
        }
        
        .modal-content {
            background: linear-gradient(135deg, var(--darker) 0%, var(--dark) 100%);
            border-radius: 15px;
            padding: 30px;
            max-width: 500px;
            width: 90%;
            border: 1px solid var(--primary);
            box-shadow: var(--glow);
            position: relative;
        }
        
        .close-modal {
            position: absolute;
            top: 15px;
            right: 15px;
            background: none;
            border: none;
            color: var(--light);
            font-size: 20px;
            cursor: pointer;
        }
        
        .login-form {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }
        
        .form-group {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }
        
        .form-group label {
            color: var(--primary);
        }
        
        .form-group input {
            background: rgba(0, 0, 0, 0.5);
            border: 1px solid var(--primary);
            border-radius: 5px;
            padding: 10px;
            color: white;
        }
        
        .submit-btn {
            background: linear-gradient(45deg, var(--primary), var(--secondary));
            border: none;
            color: white;
            padding: 12px;
            border-radius: 5px;
            cursor: pointer;
            margin-top: 10px;
            font-weight: 700;
        }
        
        .generative-canvas {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: -1;
        }
        
        footer {
            text-align: center;
            padding: 20px 0;
            margin-top: 30px;
            border-top: 1px solid rgba(0, 240, 255, 0.3);
            font-size: 12px;
            color: rgba(160, 160, 255, 0.7);
        }
        
        @media (max-width: 768px) {
            .main-content {
                grid-template-columns: 1fr;
            }
            
            .investment-options {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <canvas class="generative-canvas" id="backgroundCanvas"></canvas>
    
    <div class="container">
        <header>
            <div class="logo">
                <div class="logo-icon"></div>
                <div class="logo-text">QuanTM FOAM</div>
            </div>
            <div class="user-info">
                <div class="qbucks-display" id="qbucksDisplay">Q-Bucks: 1,250</div>
                <div class="level-display" id="levelDisplay">Level 3</div>
                <button id="loginBtn" class="portal-button" style="padding: 8px 15px; font-size: 14px;">Login</button>
            </div>
        </header>
        
        <div class="main-content">
            <div class="investment-interface">
                <div class="portal-section">
                    <h2>Quantum Portal Interface</h2>
                    <p>Activate the quantum field to generate unique investment opportunities</p>
                    <button class="portal-button" id="portalJump">Initiate Portal Jump</button>
                    <div id="portalStatus">Portal Status: Stable</div>
                </div>
                
                <h3>Investment Modules</h3>
                <div class="investment-options">
                    <div class="investment-card" data-module="micro">
                        <div class="investment-icon">μ</div>
                        <h4>Micro-Cap Scanner</h4>
                        <p>Scan for emerging micro-cap cryptocurrencies with high growth potential</p>
                        <div class="module-status">Active</div>
                    </div>
                    
                    <div class="investment-card" data-module="nano">
                        <div class="investment-icon">η</div>
                        <h4>Nano-Cap Radar</h4>
                        <p>Detect nano-cap opportunities before they hit mainstream radar</p>
                        <div class="module-status">Active</div>
                    </div>
                    
                    <div class="investment-card locked" data-module="planck">
                        <div class="investment-icon">ℏ</div>
                        <h4>Planck-Level Detection</h4>
                        <p>Access quantum-level market movements (Unlocks at Level 5)</p>
                        <div class="module-status">Locked</div>
                    </div>
                    
                    <div class="investment-card" data-module="dca">
                        <div class="investment-icon">↔</div>
                        <h4>DCA Matrix</h4>
                        <p>Automated dollar-cost averaging with quantum timing algorithms</p>
                        <div class="module-status">Active</div>
                    </div>
                    
                    <div class="investment-card" data-module="snipe">
                        <div class="investment-icon">🎯</div>
                        <h4>Sniper Protocol</h4>
                        <p>Precision entry points for maximum profit extraction</p>
                        <div class="module-status">Active</div>
                    </div>
                    
                    <div class="investment-card locked" data-module="grid">
                        <div class="investment-icon">#</div>
                        <h4>Quantum Grid</h4>
                        <p>Multi-dimensional trading grids (Unlocks at Level 7)</p>
                        <div class="module-status">Locked</div>
                    </div>
                </div>
            </div>
            
            <div class="sidebar">
                <div class="tech-tree">
                    <h3>Quantum Tech Tree</h3>
                    <div class="tech-node">
                        <span>Basic Scanner</span>
                        <span>✓</span>
                    </div>
                    <div class="tech-node">
                        <span>Risk Assessment Matrix</span>
                        <span>✓</span>
                    </div>
                    <div class="tech-node">
                        <span>Volatility Predictor</span>
                        <span>✓</span>
                    </div>
                    <div class="tech-node locked">
                        <span>Quantum Entanglement Trading</span>
                        <span>🔒</span>
                    </div>
                    <div class="tech-node locked">
                        <span>Temporal Arbitrage</span>
                        <span>🔒</span>
                    </div>
                </div>
                
                <div class="sweepstakes">
                    <h3>BOOM Particle Generator</h3>
                    <p>Generate BOOM particles for bonus rewards</p>
                    <button class="portal-button" id="generateBoom" style="font-size: 14px; padding: 10px 20px;">Generate BOOM</button>
                    <div id="boomCounter">BOOM Particles: 3</div>
                    <div id="sweepstakesInfo">Next sweepstakes entry in: 2h 15m</div>
                </div>
            </div>
        </div>
        
        <footer>
            <p>QuanTM FOAM v1.0 | Quantum Investment Interface | For simulation purposes only</p>
        </footer>
    </div>
    
    <div class="modal" id="loginModal">
        <div class="modal-content">
            <button class="close-modal" id="closeLogin">&times;</button>
            <h2>Quantum Authentication</h2>
            <form class="login-form" id="loginForm">
                <div class="form-group">
                    <label for="username">Quantum ID</label>
                    <input type="text" id="username" placeholder="Enter your Quantum ID">
                </div>
                <div class="form-group">
                    <label for="password">Entanglement Key</label>
                    <input type="password" id="password" placeholder="Enter your Entanglement Key">
                </div>
                <button type="submit" class="submit-btn">Authenticate</button>
            </form>
        </div>
    </div>

    <script>
        // Generative background animation
        const canvas = document.getElementById('backgroundCanvas');
        const ctx = canvas.getContext('2d');
        
        function resizeCanvas() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        }
        
        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();
        
        // Particle system for background
        class Particle {
            constructor() {
                this.reset();
            }
            
            reset() {
                this.x = Math.random() * canvas.width;
                this.y = Math.random() * canvas.height;
                this.vx = (Math.random() - 0.5) * 2;
                this.vy = (Math.random() - 0.5) * 2;
                this.radius = Math.random() * 2 + 0.5;
                this.color = `hsl(${Math.random() * 60 + 180}, 100%, ${Math.random() * 30 + 50}%)`;
                this.alpha = Math.random() * 0.5 + 0.1;
            }
            
            update() {
                this.x += this.vx;
                this.y += this.vy;
                
                if (this.x < 0 || this.x > canvas.width) this.vx *= -1;
                if (this.y < 0 || this.y > canvas.height) this.vy *= -1;
                
                this.alpha -= 0.002;
                if (this.alpha <= 0) {
                    this.reset();
                }
            }
            
            draw() {
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);
                ctx.fillStyle = this.color;
                ctx.globalAlpha = this.alpha;
                ctx.fill();
            }
        }
        
        const particles = [];
        for (let i = 0; i < 100; i++) {
            particles.push(new Particle());
        }
        
        function animate() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            
            // Draw connections between nearby particles
            for (let i = 0; i < particles.length; i++) {
                for (let j = i + 1; j < particles.length; j++) {
                    const dx = particles[i].x - particles[j].x;
                    const dy = particles[i].y - particles[j].y;
                    const distance = Math.sqrt(dx * dx + dy * dy);
                    
                    if (distance < 100) {
                        ctx.beginPath();
                        ctx.moveTo(particles[i].x, particles[i].y);
                        ctx.lineTo(particles[j].x, particles[j].y);
                        ctx.strokeStyle = `rgba(0, 240, 255, ${0.1 * (1 - distance/100)})`;
                        ctx.lineWidth = 0.5;
                        ctx.stroke();
                    }
                }
            }
            
            particles.forEach(particle => {
                particle.update();
                particle.draw();
            });
            
            requestAnimationFrame(animate);
        }
        
        animate();
        
        // BOOM particle animation
        function createBoomParticle(x, y) {
            const particle = document.createElement('div');
            particle.className = 'boom-particle';
            particle.style.left = `${x}px`;
            particle.style.top = `${y}px`;
            particle.style.background = `radial-gradient(circle, ${getRandomColor()} 0%, transparent 70%)`;
            document.body.appendChild(particle);
            
            const size = Math.random() * 20 + 10;
            particle.style.width = `${size}px`;
            particle.style.height = `${size}px`;
            
            const angle = Math.random() * Math.PI * 2;
            const distance = Math.random() * 100 + 50;
            
            const animation = particle.animate([
                { transform: `translate(0, 0) scale(1)`, opacity: 1 },
                { transform: `translate(${Math.cos(angle) * distance}px, ${Math.sin(angle) * distance}px) scale(0)`, opacity: 0 }
            ], {
                duration: Math.random() * 1000 + 500,
                easing: 'cubic-bezier(0.1, 0.8, 0.2, 1)'
            });
            
            animation.onfinish = () => {
                document.body.removeChild(particle);
            };
        }
        
        function getRandomColor() {
            const colors = ['#00f0ff', '#ff00ff', '#00ffaa', '#ffaa00'];
            return colors[Math.floor(Math.random() * colors.length)];
        }
        
        // Modal functionality
        const loginModal = document.getElementById('loginModal');
        const loginBtn = document.getElementById('loginBtn');
        const closeLogin = document.getElementById('closeLogin');
        const loginForm = document.getElementById('loginForm');
        
        loginBtn.addEventListener('click', () => {
            loginModal.style.display = 'flex';
        });
        
        closeLogin.addEventListener('click', () => {
            loginModal.style.display = 'none';
        });
        
        window.addEventListener('click', (e) => {
            if (e.target === loginModal) {
                loginModal.style.display = 'none';
            }
        });
        
        loginForm.addEventListener('submit', (e) => {
            e.preventDefault();
            const username = document.getElementById('username').value;
            const password = document.getElementById('password').value;
            
            if (username && password) {
                // In a real app, you would authenticate here
                alert(`Quantum ID ${username} authenticated successfully!`);
                loginModal.style.display = 'none';
                loginBtn.textContent = username;
            }
        });
        
        // Portal jump functionality
        const portalJump = document.getElementById('portalJump');
        const portalStatus = document.getElementById('portalStatus');
        
        portalJump.addEventListener('click', () => {
            portalStatus.textContent = 'Portal Status: Quantum Fluctuation Detected';
            portalJump.disabled = true;
            portalJump.textContent = 'Portal Jumping...';
            
            // Create multiple BOOM particles
            for (let i = 0; i < 20; i++) {
                setTimeout(() => {
                    const x = Math.random() * window.innerWidth;
                    const y = Math.random() * window.innerHeight;
                    createBoomParticle(x, y);
                }, i * 100);
            }
            
            setTimeout(() => {
                portalStatus.textContent = 'Portal Status: Stable (New Opportunities Generated)';
                portalJump.disabled = false;
                portalJump.textContent = 'Initiate Portal Jump';
                
                // Simulate discovering new investment opportunities
                const investmentCards = document.querySelectorAll('.investment-card');
                investmentCards.forEach(card => {
                    if (!card.classList.contains('locked')) {
                        card.style.animation = 'pulse 1s';
                        setTimeout(() => {
                            card.style.animation = '';
                        }, 1000);
                    }
                });
            }, 3000);
        });
        
        // BOOM particle generation
        const generateBoom = document.getElementById('generateBoom');
        const boomCounter = document.getElementById('boomCounter');
        let boomParticles = 3;
        
        generateBoom.addEventListener('click', () => {
            if (boomParticles > 0) {
                boomParticles--;
                boomCounter.textContent = `BOOM Particles: ${boomParticles}`;
                
                // Create BOOM particles at random positions
                for (let i = 0; i < 5; i++) {
                    setTimeout(() => {
                        const x = Math.random() * window.innerWidth;
                        const y = Math.random() * window.innerHeight;
                        createBoomParticle(x, y);
                    }, i * 200);
                }
                
                // Simulate bonus reward
                setTimeout(() => {
                    const currentQbucks = parseInt(document.getElementById('qbucksDisplay').textContent.split(': ')[1].replace(/,/g, ''));
                    const bonus = Math.floor(Math.random() * 50) + 10;
                    document.getElementById('qbucksDisplay').textContent = `Q-Bucks: ${(currentQbucks + bonus).toLocaleString()}`;
                    
                    alert(`BOOM Particle generated +${bonus} Q-Bucks!`);
                }, 1500);
                
                // Replenish BOOM particles after some time
                if (boomParticles === 0) {
                    generateBoom.disabled = true;
                    generateBoom.textContent = 'Recharging...';
                    
                    setTimeout(() => {
                        boomParticles = 3;
                        boomCounter.textContent = `BOOM Particles: ${boomParticles}`;
                        generateBoom.disabled = false;
                        generateBoom.textContent = 'Generate BOOM';
                    }, 60000); // 1 minute recharge
                }
            }
        });
        
        // Investment card interactions
        const investmentCards = document.querySelectorAll('.investment-card:not(.locked)');
        
        investmentCards.forEach(card => {
            card.addEventListener('click', () => {
                const module = card.getAttribute('data-module');
                
                // Simulate module activation
                card.style.animation = 'pulse 0.5s';
                setTimeout(() => {
                    card.style.animation = '';
                }, 500);
                
                // Show module-specific interface (simulated)
                let message = '';
                switch(module) {
                    case 'micro':
                        message = 'Micro-Cap Scanner activated. Scanning for opportunities...';
                        break;
                    case 'nano':
                        message = 'Nano-Cap Radar engaged. Detecting hidden gems...';
                        break;
                    case 'dca':
                        message = 'DCA Matrix initialized. Optimizing investment intervals...';
                        break;
                    case 'snipe':
                        message = 'Sniper Protocol locked on. Awaiting precision entry points...';
                        break;
                }
                
                setTimeout(() => {
                    alert(message);
                }, 1000);
            });
        });
        
        // Simulate level progression
        setInterval(() => {
            const levelDisplay = document.getElementById('levelDisplay');
            const currentLevel = parseInt(levelDisplay.textContent.split(' ')[1]);
            const newLevel = currentLevel + 1;
            
            if (newLevel <= 10) {
                levelDisplay.textContent = `Level ${newLevel}`;
                
                // Unlock features at certain levels
                if (newLevel === 5) {
                    document.querySelector('[data-module="planck"]').classList.remove('locked');
                }
                
                if (newLevel === 7) {
                    document.querySelector('[data-module="grid"]').classList.remove('locked');
                }
                
                // Add some Q-Bucks as level reward
                const qbucksDisplay = document.getElementById('qbucksDisplay');
                const currentQbucks = parseInt(qbucksDisplay.textContent.split(': ')[1].replace(/,/g, ''));
                const reward = newLevel * 50;
                qbucksDisplay.textContent = `Q-Bucks: ${(currentQbucks + reward).toLocaleString()}`;
                
                // Show level up message
                setTimeout(() => {
                    alert(`Level Up! Reached Level ${newLevel}. +${reward} Q-Bucks awarded!`);
                }, 500);
            }
        }, 30000); // Level up every 30 seconds for demo purposes
    </script>
</body>
</html>
