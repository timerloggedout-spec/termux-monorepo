graph TD
    subgraph "Private Local Storage (per device)"
        LS[localStorage] --> Bankroll["Bankroll"]
        LS --> Ledger["Trade Ledger"]
        LS --> Basket["Basket Holdings"]
    end

    subgraph "Public Swarm (Yjs)"
        Profiles["Y.Map 'publicProfiles'"] --> P1["Node A: level, matrix, name"]
        Profiles --> P2["Node B: level, matrix, name"]
        Mana["Y.Map 'mana'"] --> M1["Node A mana"]
        DEX["Y.Array 'dexOrders'"]
    end

    Browser1["Device 1"] --> LS
    Browser1 --> Profiles
    Browser2["Device 2"] --> LS2["Private Storage 2"]
    Browser2 --> Profiles
