// modules/filter-engine/index.js
class FilterEngine {
    constructor(rules = []) {
        this.rules = rules; // Array of { name, test, action }
    }

    addRule(rule) {
        this.rules.push(rule);
    }

    async apply(message) {
        for (const rule of this.rules) {
            const result = await rule.test(message);
            if (!result.passed) {
                await rule.action(message, result.reason);
                return { allowed: false, rule: rule.name, reason: result.reason };
            }
        }
        return { allowed: true };
    }
}
