// contexts/AppContext.jsx
import React, { createContext, useReducer, useContext } from 'react';

const AppContext = createContext();

const initialState = {
  compounds: [],
  selectedCompound: null,
  mapCenter: [0, 20],
  mapZoom: 1.2,
  highlightedCountry: null, // ISO_A3 code
  filterCountry: null,      // for trials/ROR
  searchQuery: '',
  filterType: 'all',
  filterWADA: 'all',
};

function appReducer(state, action) {
  switch (action.type) {
    case 'SET_COMPOUNDS':
      return { ...state, compounds: action.payload };
    case 'SELECT_COMPOUND':
      return { ...state, selectedCompound: action.payload };
    case 'CLICK_COUNTRY':
      return {
        ...state,
        highlightedCountry: action.payload.isoCode,
        filterCountry: action.payload.countryName,
        // Optionally select a compound based on jurisdiction status
      };
    case 'SET_FILTERS':
      return { ...state, ...action.payload };
    default:
      return state;
  }
}

export function AppProvider({ children }) {
  const [state, dispatch] = useReducer(appReducer, initialState);
  return (
    <AppContext.Provider value={{ state, dispatch }}>
      {children}
    </AppContext.Provider>
  );
}

export function useAppContext() {
  return useContext(AppContext);
}
