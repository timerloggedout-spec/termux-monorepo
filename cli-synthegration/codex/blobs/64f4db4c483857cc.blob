# omni_client/utils/signers.py
from typing import Union, Optional
from solders.keypair import Keypair as SolanaKeypair
from solders.transaction import VersionedTransaction
from web3 import Web3
from eth_account import Account
import base58

class MultiChainSigner:
    """Unified signing interface for multiple chains."""
    
    @staticmethod
    def sign_solana_transaction(
        transaction_bytes: bytes,
        private_key: Union[str, bytes]
    ) -> VersionedTransaction:
        """Sign Solana transaction."""
        if isinstance(private_key, str):
            # Try base58 decoding first
            try:
                private_key_bytes = base58.b58decode(private_key)
            except:
                # Try hex decoding
                private_key_bytes = bytes.fromhex(private_key.strip('0x'))
        else:
            private_key_bytes = private_key
        
        keypair = SolanaKeypair.from_bytes(private_key_bytes)
        tx = VersionedTransaction.from_bytes(transaction_bytes)
        signed_tx = VersionedTransaction(tx.message, [keypair])
        return signed_tx
    
    @staticmethod
    def sign_ethereum_transaction(
        transaction_dict: Dict[str, Any],
        private_key: str
    ) -> str:
        """Sign Ethereum transaction."""
        if private_key.startswith('0x'):
            private_key = private_key[2:]
        
        account = Account.from_key(private_key)
        signed_tx = account.sign_transaction(transaction_dict)
        return signed_tx.rawTransaction.hex()
    
    @staticmethod
    def sign_message(
        message: str,
        private_key: str,
        chain: str = "evm"
    ) -> str:
        """Sign arbitrary message for authentication."""
        if chain == "evm":
            account = Account.from_key(private_key)
            message_hash = Web3.keccak(text=message)
            signed = account.signHash(message_hash)
            return signed.signature.hex()
        elif chain == "solana":
            # Solana message signing
            keypair = SolanaKeypair.from_bytes(base58.b58decode(private_key))
            signature = keypair.sign_message(message.encode())
            return base58.b58encode(signature).decode()
        else:
            raise ValueError(f"Unsupported chain: {chain}")
