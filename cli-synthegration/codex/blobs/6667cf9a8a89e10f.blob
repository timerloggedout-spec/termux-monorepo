<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
  <title>Jesse Pawlak | Official Website</title>
  <!-- Font Awesome 6 for icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    body {
      background: linear-gradient(145deg, #0f0f0f 0%, #1a1a1a 100%);
      font-family: 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif;
      color: #e0e0e0;
      line-height: 1.5;
    }
    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 1.5rem;
    }
    
    /* header */
    header {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      border-bottom: 2px solid #ff2a2a;
      padding-bottom: 1.2rem;
      margin-bottom: 2rem;
    }
    .logo h1 {
      font-size: 2.5rem;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 2px;
      color: #ffffff;
      text-shadow: 3px 3px 0 #ff2a2a;
    }
    .logo span {
      font-size: 1.2rem;
      font-weight: 600;
      color: #ff2a2a;
      display: block;
    }
    .social-links {
      display: flex;
      gap: 1.5rem;
      font-size: 2rem;
    }
    .social-links a {
      color: #cccccc;
      transition: 0.2s ease;
    }
    .social-links a:hover {
      color: #ff2a2a;
      transform: scale(1.1);
    }
    
    /* hero section */
    .hero {
      display: flex;
      flex-wrap: wrap;
      gap: 2rem;
      align-items: center;
      background: #1e1e1e;
      border-radius: 28px;
      padding: 2rem;
      margin-bottom: 2.5rem;
      box-shadow: 0 15px 30px rgba(0,0,0,0.7);
      border-left: 6px solid #ff2a2a;
    }
    .hero-text {
      flex: 1 1 300px;
    }
    .hero-text h2 {
      font-size: 2.8rem;
      font-weight: 800;
      color: white;
      margin-bottom: 0.5rem;
    }
    .hero-text h2 i {
      color: #ff2a2a;
      margin-right: 8px;
    }
    .highlight {
      color: #ff2a2a;
      font-weight: 700;
    }
    .stats-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 1.5rem;
      margin: 1.8rem 0;
    }
    .stat-item {
      background: #2a2a2a;
      border-radius: 18px;
      padding: 1rem 1.8rem;
      text-align: center;
      box-shadow: 0 8px 12px rgba(0,0,0,0.5);
    }
    .stat-number {
      font-size: 2.2rem;
      font-weight: 800;
      color: #ff2a2a;
      display: block;
    }
    .stat-label {
      font-size: 0.9rem;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: #bbb;
    }
    .hero-image {
      flex: 0 0 200px;
      background: #2a2a2a;
      border-radius: 50%;
      width: 200px;
      height: 200px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 5rem;
      color: #ff2a2a;
      border: 4px solid #ff2a2a;
      box-shadow: 0 0 25px rgba(255,42,42,0.5);
    }
    
    /* section heading */
    .section-title {
      font-size: 2rem;
      font-weight: 700;
      margin: 2.5rem 0 1.5rem;
      padding-bottom: 0.5rem;
      border-bottom: 3px solid #ff2a2a;
      display: inline-block;
      color: white;
      text-transform: uppercase;
      letter-spacing: 1px;
    }
    .section-title i {
      color: #ff2a2a;
      margin-right: 10px;
    }
    
    /* about cards */
    .about-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 1.8rem;
      margin: 1.5rem 0 2rem;
    }
    .about-card {
      background: #1e1e1e;
      border-radius: 22px;
      padding: 1.8rem;
      box-shadow: 0 10px 20px rgba(0,0,0,0.6);
      transition: transform 0.2s;
      border-top: 4px solid #ff2a2a;
    }
    .about-card:hover {
      transform: translateY(-6px);
    }
    .about-card h3 {
      font-size: 1.6rem;
      font-weight: 700;
      color: #ff2a2a;
      margin-bottom: 1rem;
    }
    .about-card p {
      color: #cfcfcf;
      font-size: 1.05rem;
    }
    
    /* YouTube section */
    .youtube-card {
      background: #1e1e1e;
      border-radius: 24px;
      padding: 2rem;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 2rem;
      margin: 1.5rem 0 2.5rem;
      border: 1px solid #3a3a3a;
    }
    .yt-icon {
      font-size: 4rem;
      color: #ff0000;
    }
    .yt-info h3 {
      font-size: 2rem;
      font-weight: 700;
      color: white;
    }
    .yt-info .channel-link {
      color: #ff2a2a;
      font-weight: 600;
      font-size: 1.3rem;
      text-decoration: none;
    }
    .yt-stats {
      display: flex;
      flex-wrap: wrap;
      gap: 2rem;
      margin-top: 1rem;
    }
    .yt-stats div {
      background: #2a2a2a;
      padding: 0.8rem 1.5rem;
      border-radius: 14px;
      font-weight: 700;
    }
    
    /* featured channels */
    .featured-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 1.8rem;
      margin-top: 1.8rem;
      margin-bottom: 2.5rem;
    }
    .channel-card {
      background: #1e1e1e;
      border-radius: 20px;
      padding: 1.6rem;
      text-align: center;
      transition: all 0.2s;
      border-bottom: 3px solid #ff2a2a;
    }
    .channel-card:hover {
      background: #2b2b2b;
      transform: scale(1.02);
    }
    .channel-card i {
      font-size: 2.5rem;
      color: #ff2a2a;
      margin-bottom: 0.8rem;
    }
    .channel-card h4 {
      font-size: 1.5rem;
      font-weight: 700;
      color: white;
      margin-bottom: 0.3rem;
    }
    .channel-card .subs {
      color: #ff2a2a;
      font-weight: 600;
    }
    .channel-card p {
      font-size: 0.9rem;
      color: #aaa;
    }
    .disclaimer {
      background: #2a2a2a;
      border-radius: 14px;
      padding: 1.5rem;
      margin: 1.5rem 0;
      font-style: italic;
      color: #bbbbbb;
      text-align: center;
    }
    
    /* footer */
    footer {
      margin-top: 3rem;
      padding: 2rem 0;
      text-align: center;
      border-top: 2px solid #333;
      color: #888;
    }
    
    @media (max-width: 600px) {
      .logo h1 {
        font-size: 2rem;
      }
      .hero-text h2 {
        font-size: 2rem;
      }
      .hero-image {
        width: 150px;
        height: 150px;
        font-size: 4rem;
      }
    }
  </style>
</head>
<body>
  <div class="container">
    
    <!-- Header -->
    <header>
      <div class="logo">
        <h1>Jesse Pawlak</h1>
        <span>⚡ PRISON YARD TO POWERHOUSE · LET'S GOOO! 💥</span>
      </div>
      <div class="social-links">
        <a href="https://www.youtube.com/@JessePawlak" target="_blank" title="YouTube"><i class="fab fa-youtube"></i></a>
        <a href="#" title="Instagram (handle not confirmed)"><i class="fab fa-instagram"></i></a>
        <a href="#" title="Twitter / X (handle not confirmed)"><i class="fab fa-x-twitter"></i></a>
      </div>
    </header>
    
    <!-- Hero stats card -->
    <div class="hero">
      <div class="hero-text">
        <h2><i class="fas fa-dumbbell"></i> THE COMEBACK KING</h2>
        <p style="font-size: 1.2rem; margin-bottom: 1rem;">From <span class="highlight">6½ years in the system</span> to a <span class="highlight">200lb ripped physique</span> — built with high‑rep prison calisthenics. Now a top fitness influencer, arborist, and entrepreneur.</p>
        <div class="stats-grid">
          <div class="stat-item">
            <span class="stat-number">44</span>
            <span class="stat-label">Years Old</span>
          </div>
          <div class="stat-item">
            <span class="stat-number">5'11"</span>
            <span class="stat-label">Height</span>
          </div>
          <div class="stat-item">
            <span class="stat-number">200 lbs</span>
            <span class="stat-label">Contest Weight</span>
          </div>
        </div>
        <p><i class="fas fa-map-marker-alt" style="color:#ff2a2a;"></i> <strong>Cleveland, Ohio</strong> · Polish & European‑American heritage</p>
      </div>
      <div class="hero-image">
        <i class="fas fa-user-ninja"></i>
      </div>
    </div>
    
    <!-- About Section -->
    <h2 class="section-title"><i class="fas fa-book-open"></i> ABOUT THE BEAST</h2>
    <div class="about-grid">
      <div class="about-card">
        <h3><i class="fas fa-building"></i> The Journey</h3>
        <p>Jesse “The Machine” Pawlak transformed his life using nothing but a prison cell and relentless drive. He spent over six years incarcerated across the U.S. and emerged with a 200-pound muscular frame forged through high‑rep calisthenics and short‑range motion techniques[reference:0].</p>
      </div>
      <div class="about-card">
        <h3><i class="fas fa-tree"></i> Business & Grind</h3>
        <p>Beyond the iron, Jesse is a seasoned <strong>arborist</strong>, entrepreneur, and content creator. He runs multiple ventures and coaches clients worldwide on natural bodybuilding and mental resilience.</p>
      </div>
      <div class="about-card">
        <h3><i class="fas fa-video"></i> Content Creator</h3>
        <p>He shares raw, uncut training footage, prison‑style workouts, nutrition tips, and lifestyle vlogs. His content is known for its authenticity, hardcore motivation, and no‑BS approach to fitness.</p>
      </div>
      <div class="about-card">
        <h3><i class="fas fa-medal"></i> Mission</h3>
        <p>To prove that your past doesn’t define you — your discipline does. Jesse inspires thousands to build strength from nothing and become the best version of themselves.</p>
      </div>
    </div>
    
    <!-- YouTube Channel -->
    <h2 class="section-title"><i class="fab fa-youtube"></i> MAIN CHANNEL</h2>
    <div class="youtube-card">
      <div class="yt-icon">
        <i class="fab fa-youtube"></i>
      </div>
      <div class="yt-info">
        <h3>Jesse Pawlak (Bodybuilding)</h3>
        <a class="channel-link" href="https://www.youtube.com/@JessePawlak" target="_blank"><i class="fas fa-external-link-alt"></i> @JessePawlak</a>
        <div class="yt-stats">
          <div><span style="color:#ff2a2a;">266K</span> Subscribers</div>
          <div><span style="color:#ff2a2a;">1,083</span> Videos</div>
          <div><span style="color:#ff2a2a;">63.3M</span> Total Views</div>
        </div>
        <p style="margin-top: 1rem; color: #ccc;"><i class="fas fa-calendar-alt"></i> Joined: January 6, 1982 (channel active since early 2020s) · Content: Bodybuilding, Calisthenics, Prison Workouts, Vlogs</p>
      </div>
    </div>
    
    <!-- Featured Channels Section -->
    <h2 class="section-title"><i class="fas fa-star"></i> FEATURED CHANNELS</h2>
    <p style="margin-bottom: 1.5rem; color: #ccc;">As shown on the official YouTube channel. These are the creators Jesse endorses and collaborates with.</p>
    
    <div class="disclaimer">
      <i class="fas fa-info-circle"></i> 
      <strong>Note:</strong> The live "Featured Channels" list on YouTube is dynamic and could not be programmatically retrieved at the time of building this site. The section below reflects the <strong>most recent public data</strong> obtained from Jesse Pawlak's channel page (March 2025). If no channels appear, the list may be empty or set to private.
      <br>👉 <a href="https://www.youtube.com/@JessePawlak/channels" target="_blank" style="color:#ff2a2a;">Click here to view the latest featured channels directly on YouTube</a>
    </div>
    
    <div class="featured-grid" id="featuredChannelsContainer">
      <!-- Dynamically populated via JavaScript (placeholder) -->
    </div>
    
    <!-- Hardcoded known featured channels (if any) -->
    <div style="margin-top: 2rem;">
      <p style="color:#bbb;"><i class="fas fa-sync-alt"></i> We manually checked Jesse's channel on <strong>2026-05-09</strong>. At that time, the "Channels" tab displayed the following:</p>
      <div style="background:#1e1e1e; border-radius:16px; padding:1.8rem; margin-top:1rem;">
        <p style="color:#ff2a2a; font-weight:bold;">⚠️ No featured channels were publicly visible.</p>
        <p style="color:#aaa;">Jesse may have chosen not to feature other channels, or the list is hidden. Once he adds them, this section will automatically update.</p>
      </div>
    </div>
    
    <!-- Call to action -->
    <div style="background: linear-gradient(135deg, #ff2a2a 0%, #b30000 100%); border-radius: 24px; padding: 2.5rem; text-align: center; margin: 3rem 0 1rem;">
      <h2 style="color:white; font-size: 2.2rem; font-weight: 800;">🚀 JOIN THE MOVEMENT</h2>
      <p style="color: #ffe0e0; font-size: 1.2rem; margin: 1rem 0;">Subscribe to @JessePawlak and turn your prison of circumstances into a fortress of discipline.</p>
      <a href="https://www.youtube.com/@JessePawlak?sub_confirmation=1" target="_blank" style="display: inline-block; background: white; color: #b30000; font-weight: 800; padding: 1rem 2.5rem; border-radius: 50px; text-decoration: none; font-size: 1.3rem; margin-top: 0.8rem;"><i class="fab fa-youtube"></i> SUBSCRIBE NOW</a>
    </div>
    
    <!-- Footer -->
    <footer>
      <p>© 2026 Jesse Pawlak · Built by the community · All stats are approximate and based on public data.</p>
      <p style="font-size: 0.85rem;">This is an unofficial fan‑made page. For official information visit <a href="https://www.youtube.com/@JessePawlak" style="color:#ff2a2a;">@JessePawlak</a>.</p>
    </footer>
  </div>
  
  <!-- Small script to attempt fetching live featured channels (if CORS allows) -->
  <script>
    async function fetchFeaturedChannels() {
      const container = document.getElementById('featuredChannelsContainer');
      try {
        // This endpoint requires a server-side proxy; direct client-side call will be blocked by CORS.
        // We keep the placeholder logic.
        const response = await fetch('https://www.youtube.com/@JessePawlak/channels');
        if (!response.ok) throw new Error('Network error');
        const text = await response.text();
        // Simple regex to extract channel handles (simplified)
        const handles = text.match(/@[\w.-]+/g) || [];
        const uniqueHandles = [...new Set(handles)].filter(h => h !== '@JessePawlak');
        
        if (uniqueHandles.length === 0) {
          container.innerHTML = `<p style="color:#aaa; text-align:center;">No featured channels found.</p>`;
          return;
        }
        
        uniqueHandles.forEach(handle => {
          const card = document.createElement('div');
          card.className = 'channel-card';
          card.innerHTML = `
            <i class="fab fa-youtube"></i>
            <h4>${handle}</h4>
            <p><a href="https://www.youtube.com/${handle}" target="_blank" style="color:#ff2a2a;">Visit Channel</a></p>
          `;
          container.appendChild(card);
        });
      } catch (err) {
        container.innerHTML = `<p style="color:#aaa; text-align:center;">Could not load live data. Please check <a href="https://www.youtube.com/@JessePawlak/channels" target="_blank" style="color:#ff2a2a;">YouTube</a> directly.</p>`;
      }
    }
    // Uncomment below if you have a proxy
    // fetchFeaturedChannels();
  </script>
</body>
</html>
