.data-toggle {
    display: flex;
    align-items: center;
    gap: 10px;
}

.data-toggle label {
    color: var(--primary);
    font-size: 14px;
}

.data-toggle input[type="checkbox"] {
    width: 40px;
    height: 20px;
    appearance: none;
    background: rgba(0, 0, 0, 0.5);
    border-radius: 10px;
    position: relative;
    border: 1px solid var(--primary);
    cursor: pointer;
}

.data-toggle input[type="checkbox"]:checked {
    background: var(--primary);
}

.data-toggle input[type="checkbox"]::before {
    content: '';
    position: absolute;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: white;
    top: 1px;
    left: 1px;
    transition: left 0.3s;
}

.data-toggle input[type="checkbox"]:checked::before {
    left: 21px;
}
