if (useLiveData) {
  // ... fetch data
  data.forEach(coin => {
    const existingCoin = this.coins.find(c => c.id === coin.id);
    if (existingCoin) {
      // Set both prices to the live price, then add a small random variation to priceB
      existingCoin.priceA = coin.current_price;
      existingCoin.priceB = coin.current_price * (1 + (Math.random() * 0.02 - 0.01)); // ±1% variation
      existingCoin.changeA = coin.price_change_percentage_24h;
      existingCoin.changeB = coin.price_change_percentage_24h;
    }
  });
} else {
  this.simulatePriceChanges();
}
