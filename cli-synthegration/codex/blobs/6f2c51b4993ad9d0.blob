# omni_client/providers/bitquery.py
import requests
from typing import Dict, Any, List, Optional

class BitqueryAnalytics:
    """Bitquery analytics integration for on-chain data."""
    
    BASE_URL = "https://graphql.bitquery.io"
    
    def __init__(self, api_key: str):
        self.api_key = api_key
        self.headers = {
            "Authorization": f"Bearer {api_key}",
            "Content-Type": "application/json"
        }
    
    def query(self, query_str: str, variables: Optional[Dict] = None) -> Dict[str, Any]:
        """Execute GraphQL query."""
        payload = {
            "query": query_str,
            "variables": variables or {}
        }
        
        response = requests.post(
            self.BASE_URL,
            json=payload,
            headers=self.headers,
            timeout=30
        )
        response.raise_for_status()
        return response.json()
    
    def get_pumpfun_token_metrics(
        self,
        mint_address: str,
        timeframe_days: int = 7
    ) -> Dict[str, Any]:
        """Get Pump.fun token metrics."""
        query = """
        query PumpFunMetrics($mint: String!, $since: ISO8601DateTime!) {
          solana {
            transfers(
              transferType: {tokenMint: $mint}
              time: {since: $since}
            ) {
              amount
              transaction {
                signature
                block {
                  timestamp
                }
              }
              sender {
                address
              }
              receiver {
                address
              }
            }
          }
        }
        """
        # Implementation would need proper date calculation
        return self.query(query, {"mint": mint_address})
