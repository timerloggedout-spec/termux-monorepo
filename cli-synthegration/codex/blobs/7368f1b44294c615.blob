/**
 * Parse PDF using Gemini API for structured extraction
 * @param {string} pdfUrl - URL of the PDF to parse
 * @returns {Array} Array of parsed product objects
 */
function parseWithGemini(pdfUrl) {
  const API_KEY = 'YOUR_GEMINI_API_KEY';
  const endpoint = 'https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent';
  
  const prompt = `Extract all pharmaceutical products from this catalogue PDF.
For each product, return:
- product_name: The name of the compound
- dosage: The dosage amount (e.g., "5mg x 10 vials")
- price: The price in USD (numeric only)
- category: Type of product (peptide, hormone, anabolic, etc.)
Return ONLY a valid JSON array of objects. No markdown, no preamble.`;

  const requestBody = {
    contents: [{
      parts: [
        { text: prompt },
        { fileData: { fileUri: pdfUrl, mimeType: 'application/pdf' } }
      ]
    }],
    generationConfig: {
      responseMimeType: 'application/json',
      temperature: 0.1
    }
  };

  const options = {
    method: 'post',
    headers: { 'Content-Type': 'application/json' },
    payload: JSON.stringify(requestBody),
    muteHttpExceptions: true
  };

  const response = UrlFetchApp.fetch(`${endpoint}?key=${API_KEY}`, options);
  const data = JSON.parse(response.getContentText());
  
  // Extract JSON from response
  const jsonText = data.candidates[0].content.parts[0].text;
