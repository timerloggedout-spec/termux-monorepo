<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
  <title>Build the Future Now! 💪🤓 – BioForge + RegimenForge + PAIesque</title>
  <!-- Fuse.js fuzzy search (CDN) -->
  <script src="https://cdn.jsdelivr.net/npm/fuse.js@7.0.0/dist/fuse.min.js"></script>
  <!-- Chart.js (CDN) -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
  <style>
    :root {
      --bg: #0b0f15;
      --surface: #151a22;
      --surface2: #1e2530;
      --border: #2b3240;
      --text: #e2e8f0;
      --text2: #94a3b8;
      --accent: #06b6d4;
      --accent2: #8b5cf6;
      --green: #10b981;
      --orange: #f59e0b;
      --red: #ef4444;
      --radius: 10px;
      --shadow: 0 8px 30px rgba(0,0,0,0.4);
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      background: var(--bg); color: var(--text); line-height: 1.5;
      min-height: 100vh; display: flex; flex-direction: column;
    }
    header {
      background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
      padding: 1rem 1.5rem; border-bottom: 1px solid var(--border);
      display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
      gap: 0.75rem;
    }
    header .title {
      font-size: 1.6rem; font-weight: 800; letter-spacing: -0.5px;
      background: linear-gradient(135deg, #06b6d4, #8b5cf6);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .subtitle { font-size: 0.8rem; color: var(--text2); }
    nav {
      display: flex; flex-wrap: wrap; gap: 0.35rem; padding: 0.5rem 1rem;
      background: var(--surface); border-bottom: 1px solid var(--border);
    }
    nav button {
      background: transparent; border: 1px solid transparent;
      color: var(--text2); padding: 0.45rem 1rem; border-radius: 20px;
      cursor: pointer; font-size: 0.85rem; font-weight: 500; transition: all 0.2s;
    }
    nav button:hover { color: var(--text); border-color: var(--border); }
    nav button.active {
      background: var(--accent); color: #000; border-color: var(--accent);
      font-weight: 600; box-shadow: 0 0 12px rgba(6,182,212,0.4);
    }
    main { flex: 1; padding: 1.5rem; max-width: 1300px; margin: 0 auto; width: 100%; }
    .tab-content { display: none; animation: fadeIn 0.25s ease; }
    .tab-content.active { display: block; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }
    .card {
      background: var(--surface); border: 1px solid var(--border);
      border-radius: var(--radius); padding: 1.25rem; margin-bottom: 1rem;
      box-shadow: var(--shadow);
    }
    .card h2 { font-size: 1.15rem; margin-bottom: 0.75rem; color: var(--accent); }
    .card h3 { font-size: 1rem; margin-bottom: 0.5rem; color: var(--text); }
    .grid2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1rem; }
    .grid3 { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; }
    .grid4 { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 0.75rem; }
    .stat {
      background: var(--surface2); border-radius: var(--radius); padding: 1rem;
      text-align: center; border: 1px solid var(--border);
    }
    .stat .value { font-size: 1.8rem; font-weight: 700; color: var(--accent); }
    .stat .label { font-size: 0.75rem; color: var(--text2); }
    table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
    th, td { padding: 0.5rem 0.6rem; text-align: left; border-bottom: 1px solid var(--border); }
    th { color: var(--accent); font-weight: 600; white-space: nowrap; }
    tbody tr:hover { background: var(--surface2); }
    input, select, textarea {
      background: var(--surface2); border: 1px solid var(--border);
      color: var(--text); padding: 0.5rem 0.7rem; border-radius: 6px;
      font-size: 0.85rem; width: 100%; margin-bottom: 0.5rem;
      font-family: inherit;
    }
    input:focus, select:focus, textarea:focus {
      outline: none; border-color: var(--accent); box-shadow: 0 0 0 2px rgba(6,182,212,0.2);
    }
    button {
      background: var(--accent); color: #000; border: none; padding: 0.5rem 1.2rem;
      border-radius: 20px; cursor: pointer; font-weight: 600; font-size: 0.85rem;
      transition: all 0.2s;
    }
    button:hover { filter: brightness(1.15); }
    button.secondary { background: var(--surface2); color: var(--text); border: 1px solid var(--border); }
    button.danger { background: var(--red); }
    button.success { background: var(--green); }
    .flex-row { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; }
    .badge {
      display: inline-block; padding: 0.2rem 0.6rem; border-radius: 12px;
      font-size: 0.7rem; font-weight: 600;
    }
    .badge-success { background: rgba(16,185,129,0.2); color: var(--green); }
    .badge-warning { background: rgba(245,158,11,0.2); color: var(--orange); }
    .badge-danger { background: rgba(239,68,68,0.2); color: var(--red); }
    .badge-info { background: rgba(6,182,212,0.2); color: var(--accent); }
    .chart-wrap { position: relative; width: 100%; max-height: 300px; }
    canvas { width: 100% !important; }
    .modal-overlay {
      position: fixed; inset: 0; background: rgba(0,0,0,0.7);
      display: none; align-items: center; justify-content: center; z-index: 100;
    }
    .modal-overlay.show { display: flex; }
    .modal {
      background: var(--surface); border: 1px solid var(--border);
      border-radius: var(--radius); padding: 1.5rem; max-width: 600px; width: 90%;
      max-height: 85vh; overflow-y: auto;
    }
    .modal h3 { margin-bottom: 1rem; }
    @media (max-width: 600px) {
      header .title { font-size: 1.2rem; }
      nav button { padding: 0.35rem 0.7rem; font-size: 0.75rem; }
    }
  </style>
</head>
<body>
<header>
  <div>
    <div class="title">Build the Future Now! 💪🤓</div>
    <div class="subtitle">BioForge · RegimenForge · PAIesque — local-first, privacy-first</div>
  </div>
  <div class="flex-row">
    <button onclick="exportAllData()" class="secondary">⬇ Export All</button>
    <button onclick="document.getElementById('importFile').click()" class="secondary">⬆ Import</button>
    <input type="file" id="importFile" accept=".json" style="display:none" onchange="importAllData(event)">
    <button onclick="resetApp()" class="danger">⚠ Reset</button>
  </div>
</header>

<nav id="mainNav">
  <button data-tab="dashboard" class="active">📊 Dashboard</button>
  <button data-tab="regimens">📋 Regimen Builder</button>
  <button data-tab="fitness">❤️ Fitness Metrics</button>
  <button data-tab="compounds">🧬 Compound Tracker</button>
  <button data-tab="competition">🏆 Competition</button>
  <button data-tab="manage">⚙️ Data Management</button>
</nav>

<main>
  <!-- ========== DASHBOARD TAB ========== -->
  <div id="tab-dashboard" class="tab-content active">
    <div class="grid3">
      <div class="stat"><div class="value" id="statRegimens">0</div><div class="label">Active Regimens</div></div>
      <div class="stat"><div class="value" id="statCompounds">0</div><div class="label">Compounds Tracked</div></div>
      <div class="stat"><div class="value" id="statPRs">0</div><div class="label">Personal Records</div></div>
      <div class="stat"><div class="value" id="statHRV">--</div><div class="label">Latest HRV (RMSSD)</div></div>
      <div class="stat"><div class="value" id="statACWR">--</div><div class="label">ACWR</div></div>
      <div class="stat"><div class="value" id="statTRIMP">--</div><div class="label">Today's TRIMP</div></div>
    </div>
    <div class="grid2" style="margin-top:1rem;">
      <div class="card">
        <h2>📈 Recent Fitness Trend</h2>
        <div class="chart-wrap"><canvas id="chartFitnessOverview"></canvas></div>
      </div>
      <div class="card">
        <h2>🧪 Compound Summary</h2>
        <div class="chart-wrap"><canvas id="chartCompoundSummary"></canvas></div>
      </div>
    </div>
  </div>

  <!-- ========== REGIMEN BUILDER TAB ========== -->
  <div id="tab-regimens" class="tab-content">
    <div class="flex-row" style="justify-content: space-between; margin-bottom: 1rem;">
      <h2 style="margin:0;">📋 Regimens (Workout + Diet + Supplements + Therapeutics)</h2>
      <button onclick="showRegimenModal()">+ New Regimen</button>
    </div>
    <div class="card">
      <input type="text" id="regimenSearch" placeholder="🔍 Search regimens..." oninput="renderRegimensList()">
    </div>
    <div id="regimensList"></div>
  </div>

  <!-- ========== FITNESS METRICS TAB ========== -->
  <div id="tab-fitness" class="tab-content">
    <h2>❤️ PAIesque-Inspired Fitness Metrics</h2>
    <p style="color:var(--text2); margin-bottom:1rem;">
      All metrics derived from peer-reviewed research. Data stays local.
    </p>
    <div class="grid2">
      <div class="card">
        <h3>📝 Log Heart Rate Session</h3>
        <label>Duration (minutes)</label><input type="number" id="fitDuration" placeholder="e.g. 45">
        <label>Average HR (bpm)</label><input type="number" id="fitAvgHR" placeholder="e.g. 140">
        <label>Resting HR (bpm)</label><input type="number" id="fitRestHR" value="60">
        <label>Max HR (bpm)</label><input type="number" id="fitMaxHR" value="190">
        <label>HRV RMSSD (ms, optional)</label><input type="number" id="fitHRV" placeholder="e.g. 45">
        <div class="flex-row" style="margin-top:0.5rem;">
          <button onclick="logFitnessSession()">Log Session</button>
        </div>
      </div>
      <div class="card">
        <h3>📊 Calculated Metrics</h3>
        <div class="grid2">
          <div class="stat"><div class="value" id="calcTRIMP">--</div><div class="label">TRIMP (Banister)</div></div>
          <div class="stat"><div class="value" id="calcACWR">--</div><div class="label">ACWR (7/28d)</div></div>
          <div class="stat"><div class="value" id="calcHRV">--</div><div class="label">Latest HRV</div></div>
          <div class="stat"><div class="value" id="calcRHR">--</div><div class="label">Resting HR</div></div>
        </div>
      </div>
    </div>
    <div class="card" style="margin-top:1rem;">
      <h3>📈 TRIMP & ACWR History</h3>
      <div class="chart-wrap"><canvas id="chartFitnessHistory"></canvas></div>
    </div>
    <div class="card">
      <h3>📋 Session Log</h3>
      <div id="fitnessLogTable" style="max-height:300px; overflow-y:auto;"></div>
    </div>
  </div>

  <!-- ========== COMPOUND TRACKER TAB ========== -->
  <div id="tab-compounds" class="tab-content">
    <div class="flex-row" style="justify-content: space-between; margin-bottom: 1rem;">
      <h2 style="margin:0;">🧬 Compound & Therapeutic Tracker</h2>
      <button onclick="showCompoundModal()">+ Add Compound</button>
    </div>
    <div class="card">
      <div class="flex-row">
        <input type="text" id="compoundSearch" placeholder="🔍 Fuzzy search compounds..." style="flex:1;" oninput="renderCompoundsTable()">
        <select id="jurisdictionFilter" onchange="renderCompoundsTable()" style="width:auto;">
          <option value="">All Jurisdictions</option>
          <option value="US">US (FDA)</option>
          <option value="EU">EU (EMA)</option>
          <option value="CA">Canada</option>
          <option value="AU">Australia</option>
          <option value="UK">UK (MHRA)</option>
          <option value="JP">Japan (PMDA)</option>
        </select>
        <select id="statusFilter" onchange="renderCompoundsTable()" style="width:auto;">
          <option value="">All Statuses</option>
          <option value="approved">Approved</option>
          <option value="pending">Pending Review</option>
          <option value="investigational">Investigational</option>
          <option value="restricted">Restricted</option>
        </select>
      </div>
    </div>
    <div class="card" style="overflow-x:auto;">
      <div id="compoundsTable"></div>
    </div>
  </div>

  <!-- ========== COMPETITION TAB ========== -->
  <div id="tab-competition" class="tab-content">
    <h2>🏆 Time-Agnostic Competition & Leaderboards</h2>
    <p style="color:var(--text2); margin-bottom:1rem;">
      Submit your performance; it enters a dynamic bracket that never closes. Inspired by speedrun.com.
    </p>
    <div class="grid2">
      <div class="card">
        <h3>📤 Submit Attempt</h3>
        <label>Event Category</label>
        <select id="compEvent">
          <option value="Squat (Raw)">Squat (Raw)</option>
          <option value="Bench Press (Raw)">Bench Press (Raw)</option>
          <option value="Deadlift (Raw)">Deadlift (Raw)</option>
          <option value="Pull-Ups (Max Reps)">Pull-Ups (Max Reps)</option>
          <option value="5K Run">5K Run</option>
          <option value="Custom">Custom...</option>
        </select>
        <label>Result (kg or reps)</label><input type="number" id="compResult" placeholder="e.g. 150">
        <label>Bodyweight (kg, optional)</label><input type="number" id="compBW" placeholder="e.g. 82">
        <label>Video URL (YouTube, optional)</label><input type="text" id="compVideo" placeholder="https://youtu.be/...">
        <button onclick="submitAttempt()" style="margin-top:0.5rem;">Submit Attempt</button>
      </div>
      <div class="card">
        <h3>🏅 Leaderboard</h3>
        <select id="leaderboardEvent" onchange="renderLeaderboard()" style="width:auto;">
          <option value="All">All Events</option>
        </select>
        <div id="leaderboardTable" style="max-height:300px; overflow-y:auto;"></div>
      </div>
    </div>
  </div>

  <!-- ========== DATA MANAGEMENT TAB ========== -->
  <div id="tab-manage" class="tab-content">
    <h2>⚙️ Data Management & Privacy</h2>
    <p style="color:var(--text2); margin-bottom:1rem;">
      All data is stored locally in your browser (localStorage). Nothing leaves your device unless you export it.
    </p>
    <div class="grid2">
      <div class="card">
        <h3>📦 Import / Export</h3>
        <button onclick="exportAllData()">⬇ Export All Data (JSON)</button>
        <button onclick="document.getElementById('importFile2').click()" class="secondary" style="margin-left:0.5rem;">⬆ Import Data</button>
        <input type="file" id="importFile2" accept=".json" style="display:none" onchange="importAllData(event)">
      </div>
      <div class="card">
        <h3>🗑️ Clear Data</h3>
        <button onclick="resetApp()" class="danger">⚠ Reset All Data</button>
        <p style="font-size:0.75rem; color:var(--text2); margin-top:0.5rem;">This cannot be undone. Export first!</p>
      </div>
      <div class="card">
        <h3>🔒 Privacy</h3>
        <ul style="font-size:0.85rem; color:var(--text2); padding-left:1.2rem;">
          <li>No accounts, no cloud sync</li>
          <li>No analytics, no tracking</li>
          <li>All calculations are transparent</li>
          <li>Data export in open formats (JSON, CSV)</li>
        </ul>
      </div>
    </div>
  </div>
</main>

<!-- MODALS -->
<div class="modal-overlay" id="modalRegimen">
  <div class="modal">
    <h3 id="modalRegimenTitle">New Regimen</h3>
    <label>Regimen Name</label><input type="text" id="regimenName">
    <label>Type</label>
    <select id="regimenType">
      <option value="Workout">Workout</option>
      <option value="Nutrition">Nutrition</option>
      <option value="Supplement">Supplement Stack</option>
      <option value="Therapeutic">Therapeutic / PED</option>
      <option value="Mixed">Mixed</option>
    </select>
    <label>Description</label><textarea id="regimenDesc" rows="3"></textarea>
    <label>Parent Regimen ID (for forking)</label><input type="text" id="regimenParent" placeholder="Leave empty if original">
    <label>Modules (JSON)</label><textarea id="regimenModules" rows="4" placeholder='{"exercises":[], "meals":[], "supplements":[], "therapeutics":[]}'></textarea>
    <div class="flex-row" style="margin-top:1rem;">
      <button onclick="saveRegimen()">💾 Save</button>
      <button onclick="closeModal('modalRegimen')" class="secondary">Cancel</button>
    </div>
    <input type="hidden" id="regimenEditId">
  </div>
</div>

<div class="modal-overlay" id="modalCompound">
  <div class="modal">
    <h3 id="modalCompoundTitle">Add Compound</h3>
    <label>Canonical Name</label><input type="text" id="compoundName">
    <label>Synonyms (comma-separated)</label><input type="text" id="compoundSynonyms">
    <label>Entity Type</label>
    <select id="compoundType">
      <option value="small_molecule">Small Molecule</option>
      <option value="peptide">Peptide</option>
      <option value="hormone">Hormone</option>
      <option value="gene_therapy">Gene Therapy</option>
      <option value="nootropic">Nootropic</option>
      <option value="supplement">Supplement</option>
      <option value="other">Other</option>
    </select>
    <label>Mechanism Summary</label><input type="text" id="compoundMechanism">
    <label>US FDA Status</label>
    <select id="compoundUS"><option value="">Unknown</option><option value="approved">Approved</option><option value="investigational">Investigational</option><option value="restricted">Restricted</option></select>
    <label>EU EMA Status</label>
    <select id="compoundEU"><option value="">Unknown</option><option value="approved">Approved</option><option value="investigational">Investigational</option><option value="restricted">Restricted</option></select>
    <label>WADA Category (if applicable)</label>
    <select id="compoundWADA"><option value="">None</option><option value="S1">S1 Anabolic</option><option value="S2">S2 Hormone</option><option value="S4">S4 Hormone Modulator</option><option value="Prohibited">Prohibited</option></select>
    <label>Shipping Restrictions (comma-sep jurisdictions)</label><input type="text" id="compoundShipping" placeholder="e.g. US, CA">
    <label>Notes</label><textarea id="compoundNotes" rows="2"></textarea>
    <div class="flex-row" style="margin-top:1rem;">
      <button onclick="saveCompound()">💾 Save</button>
      <button onclick="closeModal('modalCompound')" class="secondary">Cancel</button>
    </div>
    <input type="hidden" id="compoundEditId">
  </div>
</div>

<script>
// ============== DATA LAYER (localStorage) ==============
const STORAGE_KEY = 'bioforge_platform_data';

function loadDB() {
  const raw = localStorage.getItem(STORAGE_KEY);
  if (!raw) return getDefaultDB();
  try { return JSON.parse(raw); } catch(e) { return getDefaultDB(); }
}

function saveDB(db) {
  localStorage.setItem(STORAGE_KEY, JSON.stringify(db));
}

function getDefaultDB() {
  return {
    regimens: [],
    fitnessSessions: [],
    compounds: [],
    attempts: [],
    nextId: 1
  };
}

function genId(db) {
  return 'id_' + (db.nextId++);
}

// ============== GLOBAL STATE ==============
let DB = loadDB();

// ============== NAVIGATION ==============
document.querySelectorAll('#mainNav button').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('#mainNav button').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    const tab = btn.dataset.tab;
    document.querySelectorAll('.tab-content').forEach(tc => tc.classList.remove('active'));
    document.getElementById('tab-' + tab).classList.add('active');
    refreshTab(tab);
  });
});

function refreshTab(tab) {
  if (tab === 'dashboard') refreshDashboard();
  if (tab === 'regimens') renderRegimensList();
  if (tab === 'fitness') { renderFitnessLog(); recalcFitness(); renderFitnessChart(); }
  if (tab === 'compounds') renderCompoundsTable();
  if (tab === 'competition') { populateLeaderboardEvents(); renderLeaderboard(); }
}

// ============== DASHBOARD ==============
function refreshDashboard() {
  document.getElementById('statRegimens').textContent = DB.regimens.length;
  document.getElementById('statCompounds').textContent = DB.compounds.length;
  document.getElementById('statPRs').textContent = DB.attempts.filter(a => a.validationStatus === 'verified').length;
  if (DB.fitnessSessions.length > 0) {
    const last = DB.fitnessSessions[DB.fitnessSessions.length - 1];
    document.getElementById('statHRV').textContent = last.hrv ? last.hrv.toFixed(1) : '--';
    document.getElementById('statACWR').textContent = last.acwr ? last.acwr.toFixed(2) : '--';
    document.getElementById('statTRIMP').textContent = last.trimp ? last.trimp.toFixed(1) : '--';
  }
  renderDashboardCharts();
}

function renderDashboardCharts() {
  // Fitness overview chart
  const ctx1 = document.getElementById('chartFitnessOverview')?.getContext('2d');
  if (ctx1) {
    if (window._chartFitOverview) window._chartFitOverview.destroy();
    const sessions = DB.fitnessSessions.slice(-14);
    window._chartFitOverview = new Chart(ctx1, {
      type: 'line',
      data: {
        labels: sessions.map((s,i) => `Day ${i+1}`),
        datasets: [
          { label: 'TRIMP', data: sessions.map(s=>s.trimp), borderColor: '#06b6d4', tension: 0.3, fill: false },
          { label: 'ACWR', data: sessions.map(s=>s.acwr), borderColor: '#f59e0b', tension: 0.3, fill: false, yAxisID: 'y1' }
        ]
      },
      options: { responsive: true, maintainAspectRatio: true, scales: { y: { beginAtZero: true, grid: { color: '#2b3240' } }, y1: { position: 'right', grid: { display: false }, min: 0 } } }
    });
  }
  // Compound summary chart
  const ctx2 = document.getElementById('chartCompoundSummary')?.getContext('2d');
  if (ctx2) {
    if (window._chartCompSummary) window._chartCompSummary.destroy();
    const types = {};
    DB.compounds.forEach(c => { types[c.entityType] = (types[c.entityType] || 0) + 1; });
    window._chartCompSummary = new Chart(ctx2, {
      type: 'doughnut',
      data: {
        labels: Object.keys(types),
        datasets: [{ data: Object.values(types), backgroundColor: ['#06b6d4','#8b5cf6','#10b981','#f59e0b','#ef4444','#94a3b8'] }]
      },
      options: { responsive: true, maintainAspectRatio: true }
    });
  }
}

// ============== REGIMEN BUILDER ==============
function renderRegimensList() {
  const search = (document.getElementById('regimenSearch')?.value || '').toLowerCase();
  let filtered = DB.regimens;
  if (search) {
    filtered = DB.regimens.filter(r => r.name.toLowerCase().includes(search) || r.description.toLowerCase().includes(search));
  }
  const container = document.getElementById('regimensList');
  if (!container) return;
  if (filtered.length === 0) {
    container.innerHTML = '<p style="color:var(--text2);">No regimens yet. Create one!</p>';
    return;
  }
  container.innerHTML = filtered.map(r => `
    <div class="card">
      <div class="flex-row" style="justify-content:space-between;">
        <h3>${esc(r.name)} <span class="badge badge-info">${esc(r.type)}</span></h3>
        <div>
          <button onclick="forkRegimen('${r.id}')" class="secondary" style="padding:0.3rem 0.7rem;">🍴 Fork</button>
          <button onclick="editRegimen('${r.id}')" style="padding:0.3rem 0.7rem;">✏️ Edit</button>
          <button onclick="deleteRegimen('${r.id}')" class="danger" style="padding:0.3rem 0.7rem;">🗑</button>
        </div>
      </div>
      <p style="color:var(--text2);">${esc(r.description || '')}</p>
      ${r.parentId ? `<p style="font-size:0.75rem; color:var(--accent2);">Forked from: ${r.parentId}</p>` : ''}
      <pre style="font-size:0.7rem; background:var(--bg); padding:0.5rem; border-radius:6px; max-height:100px; overflow:auto;">${esc(JSON.stringify(r.modules, null, 2))}</pre>
    </div>
  `).join('');
}

function showRegimenModal(editId = null) {
  document.getElementById('modalRegimen').classList.add('show');
  if (editId) {
    const r = DB.regimens.find(r => r.id === editId);
    if (r) {
      document.getElementById('modalRegimenTitle').textContent = 'Edit Regimen';
      document.getElementById('regimenName').value = r.name;
      document.getElementById('regimenType').value = r.type;
      document.getElementById('regimenDesc').value = r.description || '';
      document.getElementById('regimenParent').value = r.parentId || '';
      document.getElementById('regimenModules').value = JSON.stringify(r.modules, null, 2);
      document.getElementById('regimenEditId').value = r.id;
    }
  } else {
    document.getElementById('modalRegimenTitle').textContent = 'New Regimen';
    document.getElementById('regimenName').value = '';
    document.getElementById('regimenType').value = 'Workout';
    document.getElementById('regimenDesc').value = '';
    document.getElementById('regimenParent').value = '';
    document.getElementById('regimenModules').value = '{"exercises":[], "meals":[], "supplements":[], "therapeutics":[]}';
    document.getElementById('regimenEditId').value = '';
  }
}

function closeModal(id) {
  document.getElementById(id).classList.remove('show');
}

function saveRegimen() {
  const editId = document.getElementById('regimenEditId').value;
  let regimen;
  if (editId) {
    regimen = DB.regimens.find(r => r.id === editId);
    if (!regimen) return;
  } else {
    regimen = { id: genId(DB), createdAt: new Date().toISOString(), version: 1 };
    DB.regimens.push(regimen);
  }
  regimen.name = document.getElementById('regimenName').value || 'Untitled';
  regimen.type = document.getElementById('regimenType').value;
  regimen.description = document.getElementById('regimenDesc').value;
  regimen.parentId = document.getElementById('regimenParent').value || null;
  try {
    regimen.modules = JSON.parse(document.getElementById('regimenModules').value);
  } catch(e) {
    alert('Invalid JSON in modules');
    return;
  }
  regimen.updatedAt = new Date().toISOString();
  saveDB(DB);
  closeModal('modalRegimen');
  renderRegimensList();
  refreshDashboard();
}

function editRegimen(id) { showRegimenModal(id); }
function forkRegimen(id) {
  const orig = DB.regimens.find(r => r.id === id);
  if (!orig) return;
  const forked = {
    id: genId(DB), name: orig.name + ' (fork)', type: orig.type,
    description: orig.description, parentId: orig.id, version: 1,
    modules: JSON.parse(JSON.stringify(orig.modules)),
    createdAt: new Date().toISOString(), updatedAt: new Date().toISOString()
  };
  DB.regimens.push(forked);
  saveDB(DB);
  renderRegimensList();
  refreshDashboard();
}
function deleteRegimen(id) {
  if (!confirm('Delete this regimen?')) return;
  DB.regimens = DB.regimens.filter(r => r.id !== id);
  saveDB(DB);
  renderRegimensList();
  refreshDashboard();
}

// ============== FITNESS METRICS (PAIesque-inspired) ==============
// Banister TRIMP: TRIMP = duration × HRr × a × exp(b × HRr)
// HRr = (HRavg - HRrest) / (HRmax - HRrest)
// Male coefficients: a=0.64, b=1.92; Female: a=0.86, b=1.67
function calcTRIMP(durationMin, avgHR, restHR, maxHR, gender='male') {
  const hrReserve = (avgHR - restHR) / (maxHR - restHR);
  if (hrReserve <= 0) return 0;
  const a = gender === 'female' ? 0.86 : 0.64;
  const b = gender === 'female' ? 1.67 : 1.92;
  return durationMin * hrReserve * a * Math.exp(b * hrReserve);
}

function calcACWR(sessions, acuteDays=7, chronicDays=28) {
  if (sessions.length === 0) return null;
  const now = new Date();
  const acute = sessions.filter(s => {
    const d = new Date(s.date);
    return (now - d) / (1000*60*60*24) <= acuteDays;
  }).reduce((sum, s) => sum + (s.trimp || 0), 0) / acuteDays;
  const chronic = sessions.filter(s => {
    const d = new Date(s.date);
    return (now - d) / (1000*60*60*24) <= chronicDays;
  }).reduce((sum, s) => sum + (s.trimp || 0), 0) / chronicDays;
  if (chronic === 0) return null;
  return acute / chronic;
}

function logFitnessSession() {
  const duration = parseFloat(document.getElementById('fitDuration').value);
  const avgHR = parseFloat(document.getElementById('fitAvgHR').value);
  const restHR = parseFloat(document.getElementById('fitRestHR').value) || 60;
  const maxHR = parseFloat(document.getElementById('fitMaxHR').value) || 190;
  const hrv = parseFloat(document.getElementById('fitHRV').value) || null;
  if (!duration || !avgHR) { alert('Enter duration and average HR'); return; }
  const trimp = calcTRIMP(duration, avgHR, restHR, maxHR);
  const session = {
    id: genId(DB), date: new Date().toISOString(),
    duration, avgHR, restHR, maxHR, hrv, trimp, acwr: null
  };
  DB.fitnessSessions.push(session);
  // Recalc ACWR
  const acwr = calcACWR(DB.fitnessSessions);
  session.acwr = acwr;
  saveDB(DB);
  renderFitnessLog();
  recalcFitness();
  renderFitnessChart();
  refreshDashboard();
  // Clear inputs
  document.getElementById('fitDuration').value = '';
  document.getElementById('fitAvgHR').value = '';
  document.getElementById('fitHRV').value = '';
}

function recalcFitness() {
  if (DB.fitnessSessions.length === 0) return;
  const last = DB.fitnessSessions[DB.fitnessSessions.length - 1];
  document.getElementById('calcTRIMP').textContent = last.trimp ? last.trimp.toFixed(1) : '--';
  document.getElementById('calcACWR').textContent = last.acwr ? last.acwr.toFixed(2) : '--';
  document.getElementById('calcHRV').textContent = last.hrv ? last.hrv.toFixed(1) : '--';
  document.getElementById('calcRHR').textContent = last.restHR ? last.restHR.toFixed(0) : '--';
  // ACWR interpretation
  if (last.acwr) {
    let color = 'var(--green)';
    if (last.acwr < 0.8 || last.acwr > 1.3) color = 'var(--orange)';
    if (last.acwr > 1.5) color = 'var(--red)';
    document.getElementById('calcACWR').style.color = color;
  }
}

function renderFitnessLog() {
  const container = document.getElementById('fitnessLogTable');
  if (!container) return;
  const sessions = DB.fitnessSessions.slice(-20).reverse();
  if (sessions.length === 0) {
    container.innerHTML = '<p style="color:var(--text2);">No sessions logged.</p>';
    return;
  }
  container.innerHTML = `<table><thead><tr>
    <th>Date</th><th>Dur (min)</th><th>Avg HR</th><th>HRV</th><th>TRIMP</th><th>ACWR</th><th></th>
  </tr></thead><tbody>${sessions.map(s => `
    <tr>
      <td>${new Date(s.date).toLocaleDateString()}</td>
      <td>${s.duration}</td><td>${s.avgHR}</td><td>${s.hrv ? s.hrv.toFixed(1) : '--'}</td>
      <td>${s.trimp.toFixed(1)}</td>
      <td><span style="color:${s.acwr > 1.5 ? 'var(--red)' : s.acwr > 1.3 ? 'var(--orange)' : 'var(--green)'}">${s.acwr ? s.acwr.toFixed(2) : '--'}</span></td>
      <td><button onclick="deleteFitnessSession('${s.id}')" class="danger" style="padding:0.2rem 0.5rem; font-size:0.7rem;">✕</button></td>
    </tr>`).join('')}</tbody></table>`;
}

function deleteFitnessSession(id) {
  DB.fitnessSessions = DB.fitnessSessions.filter(s => s.id !== id);
  saveDB(DB);
  renderFitnessLog();
  recalcFitness();
  renderFitnessChart();
  refreshDashboard();
}

let fitnessChartInstance = null;
function renderFitnessChart() {
  const ctx = document.getElementById('chartFitnessHistory')?.getContext('2d');
  if (!ctx) return;
  if (fitnessChartInstance) fitnessChartInstance.destroy();
  const sessions = DB.fitnessSessions.slice(-30);
  fitnessChartInstance = new Chart(ctx, {
    type: 'line',
    data: {
      labels: sessions.map((s,i) => `#${i+1}`),
      datasets: [
        { label: 'TRIMP', data: sessions.map(s=>s.trimp), borderColor: '#06b6d4', tension: 0.3, yAxisID: 'y' },
        { label: 'ACWR', data: sessions.map(s=>s.acwr), borderColor: '#f59e0b', tension: 0.3, yAxisID: 'y1' }
      ]
    },
    options: {
      responsive: true, maintainAspectRatio: true,
      scales: { y: { beginAtZero: true, grid: { color: '#2b3240' } }, y1: { position: 'right', grid: { display: false }, min: 0 } }
    }
  });
}

// ============== COMPOUND TRACKER ==============
function renderCompoundsTable() {
  const search = (document.getElementById('compoundSearch')?.value || '').toLowerCase();
  const jurisdiction = document.getElementById('jurisdictionFilter')?.value || '';
  const status = document.getElementById('statusFilter')?.value || '';
  let filtered = DB.compounds;
  if (search && typeof Fuse !== 'undefined') {
    const fuse = new Fuse(filtered, { keys: ['canonicalName', 'synonyms', 'mechanismSummary'], threshold: 0.4 });
    filtered = fuse.search(search).map(r => r.item);
  } else if (search) {
    filtered = filtered.filter(c => c.canonicalName.toLowerCase().includes(search) || c.synonyms.toLowerCase().includes(search));
  }
  if (status) filtered = filtered.filter(c => c.status === status);
  const container = document.getElementById('compoundsTable');
  if (!container) return;
  if (filtered.length === 0) {
    container.innerHTML = '<p style="color:var(--text2);">No compounds tracked. Add one!</p>';
    return;
  }
  container.innerHTML = `<table><thead><tr>
    <th>Name</th><th>Type</th><th>US (FDA)</th><th>EU (EMA)</th><th>WADA</th><th>Status</th><th>Shipping Restrictions</th><th></th>
  </tr></thead><tbody>${filtered.map(c => `
    <tr>
      <td><strong>${esc(c.canonicalName)}</strong>${c.synonyms ? '<br><small style="color:var(--text2);">'+esc(c.synonyms)+'</small>' : ''}</td>
      <td><span class="badge badge-info">${esc(c.entityType)}</span></td>
      <td>${esc(c.usFdaStatus || '?')}</td>
      <td>${esc(c.euEmaStatus || '?')}</td>
      <td>${c.wadaCategory ? '<span class="badge badge-danger">'+esc(c.wadaCategory)+'</span>' : '--'}</td>
      <td><span class="badge ${c.status==='approved'?'badge-success':c.status==='pending'?'badge-warning':'badge-danger'}">${esc(c.status||'pending')}</span></td>
      <td>${esc(c.shippingRestrictions || 'None')}</td>
      <td><button onclick="deleteCompound('${c.id}')" class="danger" style="padding:0.2rem 0.5rem;font-size:0.7rem;">✕</button></td>
    </tr>`).join('')}</tbody></table>`;
}

function showCompoundModal(editId = null) {
  document.getElementById('modalCompound').classList.add('show');
  if (editId) {
    const c = DB.compounds.find(c => c.id === editId);
    if (c) {
      document.getElementById('modalCompoundTitle').textContent = 'Edit Compound';
      document.getElementById('compoundName').value = c.canonicalName;
      document.getElementById('compoundSynonyms').value = c.synonyms || '';
      document.getElementById('compoundType').value = c.entityType;
      document.getElementById('compoundMechanism').value = c.mechanismSummary || '';
      document.getElementById('compoundUS').value = c.usFdaStatus || '';
      document.getElementById('compoundEU').value = c.euEmaStatus || '';
      document.getElementById('compoundWADA').value = c.wadaCategory || '';
      document.getElementById('compoundShipping').value = c.shippingRestrictions || '';
      document.getElementById('compoundNotes').value = c.notes || '';
      document.getElementById('compoundEditId').value = c.id;
    }
  } else {
    document.getElementById('modalCompoundTitle').textContent = 'Add Compound';
    document.getElementById('compoundName').value = '';
    document.getElementById('compoundSynonyms').value = '';
    document.getElementById('compoundType').value = 'small_molecule';
    document.getElementById('compoundMechanism').value = '';
    document.getElementById('compoundUS').value = '';
    document.getElementById('compoundEU').value = '';
    document.getElementById('compoundWADA').value = '';
    document.getElementById('compoundShipping').value = '';
    document.getElementById('compoundNotes').value = '';
    document.getElementById('compoundEditId').value = '';
  }
}

function saveCompound() {
  const editId = document.getElementById('compoundEditId').value;
  let compound;
  if (editId) {
    compound = DB.compounds.find(c => c.id === editId);
    if (!compound) return;
  } else {
    compound = { id: genId(DB), createdAt: new Date().toISOString() };
    DB.compounds.push(compound);
  }
  compound.canonicalName = document.getElementById('compoundName').value || 'Unknown';
  compound.synonyms = document.getElementById('compoundSynonyms').value;
  compound.entityType = document.getElementById('compoundType').value;
  compound.mechanismSummary = document.getElementById('compoundMechanism').value;
  compound.usFdaStatus = document.getElementById('compoundUS').value;
  compound.euEmaStatus = document.getElementById('compoundEU').value;
  compound.wadaCategory = document.getElementById('compoundWADA').value;
  compound.shippingRestrictions = document.getElementById('compoundShipping').value;
  compound.notes = document.getElementById('compoundNotes').value;
  compound.status = compound.status || 'pending';
  compound.updatedAt = new Date().toISOString();
  saveDB(DB);
  closeModal('modalCompound');
  renderCompoundsTable();
  refreshDashboard();
}

function deleteCompound(id) {
  if (!confirm('Delete this compound?')) return;
  DB.compounds = DB.compounds.filter(c => c.id !== id);
  saveDB(DB);
  renderCompoundsTable();
  refreshDashboard();
}

// ============== COMPETITION ==============
function submitAttempt() {
  const event = document.getElementById('compEvent').value;
  const result = parseFloat(document.getElementById('compResult').value);
  const bw = parseFloat(document.getElementById('compBW').value) || null;
  const video = document.getElementById('compVideo').value || '';
  if (!result) { alert('Enter a result'); return; }
  const attempt = {
    id: genId(DB), event, result, bodyweight: bw, videoUrl: video,
    date: new Date().toISOString(), validationStatus: 'pending'
  };
  DB.attempts.push(attempt);
  saveDB(DB);
  populateLeaderboardEvents();
  renderLeaderboard();
  refreshDashboard();
  document.getElementById('compResult').value = '';
  document.getElementById('compBW').value = '';
  document.getElementById('compVideo').value = '';
}

function populateLeaderboardEvents() {
  const events = [...new Set(DB.attempts.map(a => a.event))];
  const sel = document.getElementById('leaderboardEvent');
  if (!sel) return;
  sel.innerHTML = '<option value="All">All Events</option>' + events.map(e => `<option value="${esc(e)}">${esc(e)}</option>`).join('');
}

function renderLeaderboard() {
  const eventFilter = document.getElementById('leaderboardEvent')?.value || 'All';
  let attempts = DB.attempts;
  if (eventFilter !== 'All') attempts = attempts.filter(a => a.event === eventFilter);
  attempts.sort((a,b) => b.result - a.result);
  const container = document.getElementById('leaderboardTable');
  if (!container) return;
  if (attempts.length === 0) {
    container.innerHTML = '<p style="color:var(--text2);">No attempts yet.</p>';
    return;
  }
  container.innerHTML = `<table><thead><tr><th>Rank</th><th>Event</th><th>Result</th><th>BW</th><th>Date</th><th>Validation</th></tr></thead>
    <tbody>${attempts.map((a,i) => `
      <tr>
        <td>#${i+1}</td><td>${esc(a.event)}</td><td><strong>${a.result}</strong></td>
        <td>${a.bodyweight || '--'}</td><td>${new Date(a.date).toLocaleDateString()}</td>
        <td><span class="badge ${a.validationStatus==='verified'?'badge-success':'badge-warning'}">${a.validationStatus}</span></td>
      </tr>`).join('')}</tbody></table>`;
}

// ============== DATA MANAGEMENT ==============
function exportAllData() {
  const blob = new Blob([JSON.stringify(DB, null, 2)], { type: 'application/json' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url; a.download = 'bioforge_data_' + new Date().toISOString().slice(0,10) + '.json';
  a.click(); URL.revokeObjectURL(url);
}

function importAllData(event) {
  const file = event.target.files[0];
  if (!file) return;
  const reader = new FileReader();
  reader.onload = function(e) {
    try {
      const data = JSON.parse(e.target.result);
      if (data.regimens && data.fitnessSessions && data.compounds && data.attempts && data.nextId) {
        if (confirm('Import data? This will overwrite current data.')) {
          DB = data;
          saveDB(DB);
          refreshAll();
          alert('Data imported successfully!');
        }
      } else {
        alert('Invalid data format.');
      }
    } catch(err) {
      alert('Error reading file: ' + err.message);
    }
  };
  reader.readAsText(file);
  event.target.value = '';
}

function resetApp() {
  if (confirm('⚠️ Delete ALL locally stored data? This cannot be undone!')) {
    localStorage.removeItem(STORAGE_KEY);
    DB = getDefaultDB();
    saveDB(DB);
    refreshAll();
  }
}

function refreshAll() {
  refreshDashboard();
  renderRegimensList();
  renderFitnessLog();
  recalcFitness();
  renderFitnessChart();
  renderCompoundsTable();
  populateLeaderboardEvents();
  renderLeaderboard();
}

// ============== UTILITIES ==============
function esc(str) {
  return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}

// ============== CLOSE MODALS ON OVERLAY CLICK ==============
document.querySelectorAll('.modal-overlay').forEach(overlay => {
  overlay.addEventListener('click', function(e) {
    if (e.target === overlay) overlay.classList.remove('show');
  });
});

// ============== INITIAL LOAD ==============
refreshDashboard();
</script>
</body>
</html>
