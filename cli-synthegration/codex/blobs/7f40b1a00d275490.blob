<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>PRIS – Pharmaceutical Regulatory Intelligence System</title>
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=JetBrains+Mono:wght@400;500;600&family=Outfit:wght@300;400;500;600&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <script src="https://cdn.jsdelivr.net/npm/react@18.2.0/umd/react.production.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/react-dom@18.2.0/umd/react-dom.production.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { background: #040810; color: #c8d3e8; font-family: 'Outfit', sans-serif; }
    ::-webkit-scrollbar { width: 4px; height: 4px; }
    ::-webkit-scrollbar-track { background: #060d1a; }
    ::-webkit-scrollbar-thumb { background: #1e3a5f; border-radius: 2px; }
    @keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
    .spin { animation: spin 1s linear infinite; }
    @keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.5; } }
    .pulse { animation: pulse 2s ease-in-out infinite; }
  </style>
</head>
<body class="bg-[#040810] text-[#c8d3e8]">
  <div id="root"></div>
  <script type="text/babel">
    const { useState, useEffect, useRef, useCallback, useMemo } = React;

    // ──────────────────────────────────────────────
    //  SEED COMPOUNDS – minimal, API enriches the rest
    // ──────────────────────────────────────────────
    const SEED_COMPOUNDS = [
      { id:"SEMA001", name:"Semaglutide", synonyms:"Ozempic; Wegovy; Rybelsus", nct_ids:["NCT01930999","NCT04668612"], fda_nda:"209637" },
      { id:"TIRZ001", name:"Tirzepatide", synonyms:"Mounjaro; Zepbound", nct_ids:["NCT04184622","NCT04670926"], fda_nda:"215866" },
      { id:"RETA001", name:"Retatrutide", synonyms:"LY3437943", nct_ids:["NCT05929066","NCT05929079"], fda_nda:null },
      { id:"TESM001", name:"Tesamorelin", synonyms:"Egrifta; TH9507", nct_ids:["NCT03150511"], fda_nda:"022505" },
      { id:"SERM001", name:"Sermorelin", synonyms:"GRF 1-29 NH2; Geref", nct_ids:["NCT00257712"], fda_nda:"019764" },
      { id:"CJC001",  name:"CJC-1295", synonyms:"CJC-1295 with DAC; Drug Affinity Complex GHRH", nct_ids:[], fda_nda:null },
      { id:"IPAM001", name:"Ipamorelin", synonyms:"", nct_ids:[], fda_nda:null },
      { id:"HGH001",  name:"Somatropin", synonyms:"HGH; rHGH; Norditropin; Genotropin", nct_ids:[], fda_nda:"019763" },
      { id:"BPC001",  name:"BPC-157", synonyms:"Body Protection Compound 157; PL-10", nct_ids:[], fda_nda:null },
      { id:"TB50001", name:"TB-500", synonyms:"Thymosin Beta-4; Tβ4", nct_ids:["NCT02974907","NCT03937882"], fda_nda:null },
      { id:"IGF1LR3", name:"IGF-1 LR3", synonyms:"Long R3 IGF-1", nct_ids:[], fda_nda:null },
      { id:"HCG001",  name:"Human Chorionic Gonadotropin", synonyms:"HCG; Pregnyl; Novarel", nct_ids:[], fda_nda:null },
      { id:"AICAR01", name:"AICAR", synonyms:"Acadesine; 5-AICA-ribonucleoside", nct_ids:[], fda_nda:null },
      { id:"SLU001",  name:"SLU-PP-332", synonyms:"ERR agonist; exercise mimetic", nct_ids:[], fda_nda:null },
      { id:"FST344",  name:"Follistatin 344", synonyms:"FST344", nct_ids:[], fda_nda:null },
      { id:"TEST001", name:"Testosterone", synonyms:"Testosterone Cypionate; Enanthate; Sustanon", nct_ids:[], fda_nda:"010991" },
      { id:"TREN001", name:"Trenbolone", synonyms:"Trenbolone Acetate; Parabolan; Finaplix", nct_ids:[], fda_nda:null },
      { id:"OXAN001", name:"Oxandrolone", synonyms:"Anavar; Oxandrin", nct_ids:[], fda_nda:"013718" },
      { id:"STAN001", name:"Stanozolol", synonyms:"Winstrol; Stromba", nct_ids:[], fda_nda:"014440" },
      { id:"TAMOX01", name:"Tamoxifen", synonyms:"Nolvadex; ICI 46474", nct_ids:[], fda_nda:"017970" },
      { id:"ANAST01", name:"Anastrozole", synonyms:"Arimidex; ZD 1033", nct_ids:[], fda_nda:"020541" },
      { id:"CLEN001", name:"Clenbuterol", synonyms:"Clenbuterol HCl; Spiropent", nct_ids:[], fda_nda:null },
      { id:"T3001",   name:"Liothyronine", synonyms:"T3; Cytomel; Triostat", nct_ids:[], fda_nda:"010379" },
      { id:"MK67701", name:"MK-677", synonyms:"Ibutamoren; Ibutamoren mesylate", nct_ids:[], fda_nda:null },
    ];

    // ──────────────────────────────────────────────
    //  API SERVICE FUNCTIONS
    // ──────────────────────────────────────────────
    const fetchOpenFDA = async (name) => {
      try {
        const url = `https://api.fda.gov/drug/label.json?search=openfda.brand_name:"${encodeURIComponent(name)}"&limit=1`;
        const r = await fetch(url);
        if (!r.ok) return null;
        const d = await r.json();
        if (!d.results?.length) return null;
        const drug = d.results[0];
        return {
          intended_use: drug.indications_and_usage?.[0] || '',
          mechanism: drug.mechanism_of_action?.[0] || '',
          side_effects: drug.adverse_reactions?.[0] || '',
          warnings: drug.warnings_and_cautions?.[0] || '',
          active_ingredient: drug.active_ingredient?.[0] || name,
        };
      } catch { return null; }
    };

    const fetchClinicalTrials = async (nctIds) => {
      if (!nctIds?.length) return [];
      try {
        const results = await Promise.all(nctIds.slice(0,3).map(async (id) => {
          const url = `https://clinicaltrials.gov/api/v2/studies/${id}`;
          const r = await fetch(url);
          if (!r.ok) return null;
          const d = await r.json();
          const p = d.protocolSection;
          return {
            nct_id: id,
            title: p?.identificationModule?.briefTitle || '',
            phase: p?.designModule?.phases?.join(', ') || '',
            status: p?.statusModule?.overallStatus || '',
            conditions: p?.conditionsModule?.conditions?.join('; ') || '',
            sponsor: p?.sponsorCollaboratorsModule?.leadSponsor?.name || '',
          };
        }));
        return results.filter(Boolean);
      } catch { return []; }
    };

    const fetchPubMed = async (name) => {
      try {
        const searchUrl = `https://eutils.ncbi.nlm.nih.gov/entrez/eutils/esearch.fcgi?db=pubmed&term=${encodeURIComponent(name)}+AND+(pharmacology+OR+clinical+trial)&retmax=5&retmode=json`;
        const r = await fetch(searchUrl);
        const d = await r.json();
        const ids = d.esearchresult?.idlist || [];
        if (!ids.length) return [];
        const summaryUrl = `https://eutils.ncbi.nlm.nih.gov/entrez/eutils/esummary.fcgi?db=pubmed&id=${ids.slice(0,3).join(',')}&retmode=json`;
        const sr = await fetch(summaryUrl);
        const sd = await sr.json();
        return ids.slice(0,3).map(id => {
          const p = sd.result[id];
          return {
            pmid: id,
            title: p?.title || '',
            pubdate: p?.pubdate || '',
            source: p?.source || '',
            url: `https://pubmed.ncbi.nlm.nih.gov/${id}/`,
          };
        });
      } catch { return []; }
    };

    // ──────────────────────────────────────────────
    //  PDF PARSER (client-side)
    // ──────────────────────────────────────────────
    const parsePDFText = async (file) => {
      const arrayBuffer = await file.arrayBuffer();
      const pdf = await pdfjsLib.getDocument({ data: arrayBuffer }).promise;
      let fullText = '';
      for (let i = 1; i <= pdf.numPages; i++) {
        const page = await pdf.getPage(i);
        const content = await page.getTextContent();
        const pageText = content.items.map(item => item.str).join(' ');
        fullText += pageText + '\n';
      }
      return fullText;
    };

    const extractProducts = (text) => {
      const products = [];
      const lines = text.split('\n').map(l => l.trim()).filter(l => l.length > 3);
      for (let i = 0; i < lines.length; i++) {
        // Match "ProductName 5mg x 10 vials" or similar
        const match = lines[i].match(/^([A-Za-z0-9\-\+\s\(\)]+?)\s+(\d+(?:\.\d+)?\s*(?:mg|mcg|iu|ml|g)?)\s*x\s*(\d+)\s*(?:vials|tablets|pcs)/i);
        if (match) {
          const name = match[1].trim();
          const dosage = match[2] + ' x ' + match[3];
          // Look for price on same or next line
          let price = '';
          const priceMatch = (lines[i] + ' ' + (lines[i+1] || '')).match(/\$(\d+(?:\.\d{2})?)/);
          if (priceMatch) price = priceMatch[1];
          if (name.length > 2) {
            products.push({
              id: 'PDF_' + name.replace(/[^A-Z0-9]/gi, '').toUpperCase().slice(0,8) + '_' + Date.now(),
              name,
              dosage,
              price,
              source: 'pdf_upload',
            });
          }
        }
      }
      return products;
    };

    // ──────────────────────────────────────────────
    //  HELPER COMPONENTS
    // ──────────────────────────────────────────────
    const Badge = ({ color, children, small }) => (
      <span className="inline-block" style={{
        background: color + '18', color, border: `1px solid ${color}44`,
        borderRadius: 4, padding: small ? '1px 6px' : '2px 8px',
        fontSize: small ? 9 : 10, fontFamily: "'JetBrains Mono', monospace",
        fontWeight: 600, whiteSpace: 'nowrap', letterSpacing: '0.03em',
      }}>{children}</span>
    );

    const Spinner = () => (
      <div className="flex items-center justify-center p-8">
        <span className="spin text-2xl" style={{color:'#60a5fa'}}>⟳</span>
      </div>
    );

    // ──────────────────────────────────────────────
    //  MAIN APP
    // ──────────────────────────────────────────────
    function App() {
      const [compounds, setCompounds] = useState([]);
      const [search, setSearch] = useState('');
      const [selected, setSelected] = useState(null);
      const [activeTab, setActiveTab] = useState('matrix');
      const [loading, setLoading] = useState(true);
      const [enriching, setEnriching] = useState(false);
      const [enrichedData, setEnrichedData] = useState({});
      const [pdfProducts, setPdfProducts] = useState([]);
      const [pdfLoading, setPdfLoading] = useState(false);
      const [trials, setTrials] = useState({});
      const [papers, setPapers] = useState({});

      // Initialize compounds from seed
      useEffect(() => {
        setCompounds(SEED_COMPOUNDS.map(c => ({...c, status:'ready'})));
        setLoading(false);
      }, []);

      // Fuzzy search
      const filtered = useMemo(() => {
        if (!search.trim()) return compounds;
        const q = search.toLowerCase();
        return compounds.filter(c =>
          c.name.toLowerCase().includes(q) ||
          (c.synonyms || '').toLowerCase().includes(q) ||
          c.id.toLowerCase().includes(q)
        );
      }, [compounds, search]);

      // Enrich a single compound from APIs
      const enrichCompound = useCallback(async (compound) => {
        if (enrichedData[compound.id]) return;
        setEnriching(true);
        try {
          const [fda, trialsData, pubmedData] = await Promise.all([
            fetchOpenFDA(compound.name),
            fetchClinicalTrials(compound.nct_ids),
            fetchPubMed(compound.name),
          ]);
          setEnrichedData(prev => ({...prev, [compound.id]: {fda, trials: trialsData, papers: pubmedData} }));
          setTrials(prev => ({...prev, [compound.id]: trialsData}));
          setPapers(prev => ({...prev, [compound.id]: pubmedData}));
        } catch (e) {
          console.error('Enrichment failed:', e);
        } finally {
          setEnriching(false);
        }
      }, [enrichedData]);

      // Handle PDF upload
      const handlePDFUpload = async (e) => {
        const file = e.target.files?.[0];
        if (!file) return;
        setPdfLoading(true);
        try {
          const text = await parsePDFText(file);
          const products = extractProducts(text);
          setPdfProducts(products);
          // Merge into main compound list
          const newCompounds = products.map(p => ({
            id: p.id,
            name: p.name,
            synonyms: '',
            nct_ids: [],
            fda_nda: null,
            dosage: p.dosage,
            price: p.price,
            status: 'pdf_ingested',
          }));
          setCompounds(prev => [...new Set([...prev, ...newCompounds])]);
        } catch (err) {
          alert('PDF parsing failed: ' + err.message);
        } finally {
          setPdfLoading(false);
        }
      };

      // Stats
      const stats = useMemo(() => ({
        total: compounds.length,
        withTrials: Object.keys(trials).length,
        withPapers: Object.keys(papers).length,
      }), [compounds, trials, papers]);

      if (loading) return <Spinner />;

      return (
        <div className="min-h-screen bg-[#040810]">
          {/* ── HEADER ── */}
          <div className="border-b border-[#0e2040]" style={{background:'linear-gradient(180deg, #060e1f 0%, #040810 100%)'}}>
            <div className="max-w-7xl mx-auto px-4 py-4">
              <div className="flex items-center justify-between flex-wrap gap-4">
                <div className="flex items-center gap-3">
                  <div className="w-10 h-10 rounded-lg flex items-center justify-center"
                    style={{background:'linear-gradient(135deg, #0d3060, #1a5a9a)', border:'1px solid #2a6fb0'}}>
                    <i data-lucide="shield" className="w-5 h-5" style={{color:'#60aaff'}}></i>
                  </div>
                  <div>
                    <h1 className="text-xl font-extrabold tracking-wider" style={{fontFamily:"'Syne',sans-serif", color:'#e8f0ff'}}>PRIS</h1>
                    <p className="text-xs tracking-widest" style={{fontFamily:"'JetBrains Mono',monospace", color:'#3a6a9a'}}>PHARMACEUTICAL REGULATORY INTELLIGENCE SYSTEM</p>
                  </div>
                </div>
                <div className="flex gap-6">
                  {[{l:'COMPOUNDS',v:stats.total,c:'#60aaff'},{l:'ENRICHED',v:stats.withTrials,c:'#10b981'},{l:'PUBMED',v:stats.withPapers,c:'#a78bfa'}].map(s => (
                    <div key={s.l} className="text-right">
                      <div className="text-2xl font-bold" style={{fontFamily:"'Syne',sans-serif",color:s.c}}>{s.v}</div>
                      <div className="text-xs tracking-wider" style={{fontFamily:"'JetBrains Mono',monospace",color:'#3a5a7a'}}>{s.l}</div>
                    </div>
                  ))}
                </div>
              </div>
              {/* Tabs */}
              <div className="flex gap-0 mt-3">
                {[{k:'matrix',l:'MATRIX'},{k:'analytics',l:'ANALYTICS'},{k:'import',l:'IMPORT PDF'}].map(t => (
                  <button key={t.k} onClick={() => setActiveTab(t.k)} className="tab-btn px-4 py-2 text-xs font-semibold tracking-wider transition-colors"
                    style={{
                      fontFamily:"'JetBrains Mono',monospace",
                      color: activeTab===t.k ? '#f59e0b' : '#4a6a8a',
                      borderBottom: activeTab===t.k ? '2px solid #f59e0b' : '2px solid transparent',
                      background: 'transparent',
                      cursor: 'pointer',
                    }}>{t.l}</button>
                ))}
              </div>
            </div>
          </div>

          {/* ── SEARCH BAR ── */}
          <div className="max-w-7xl mx-auto px-4 py-3">
            <div className="relative">
              <i data-lucide="search" className="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4" style={{color:'#3a5a7a'}}></i>
              <input
                value={search}
                onChange={e => setSearch(e.target.value)}
                placeholder="Search compounds by name, synonym, or ID…"
                className="w-full pl-10 pr-4 py-2.5 rounded-lg text-sm outline-none"
                style={{
                  background:'#060d1a',
                  border:'1px solid #0e2040',
                  color:'#c8d3e8',
                  fontFamily:"'Outfit',sans-serif",
                }}
              />
            </div>
          </div>

          {/* ── MATRIX TAB ── */}
          {activeTab === 'matrix' && (
            <div className="max-w-7xl mx-auto px-4 pb-8">
              <div className="overflow-x-auto rounded-xl" style={{border:'1px solid #0e2040'}}>
                <table className="w-full text-sm" style={{borderCollapse:'collapse'}}>
                  <thead>
                    <tr style={{background:'#060d1a', borderBottom:'2px solid #0e2040'}}>
                      {['Compound','Type','Stage','Trials','PubMed','Actions'].map(h => (
                        <th key={h} className="px-4 py-3 text-left text-xs font-semibold tracking-wider" style={{fontFamily:"'JetBrains Mono',monospace",color:'#3a5a7a'}}>{h}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {filtered.map((c, i) => {
                      const isSelected = selected?.id === c.id;
                      const hasTrials = trials[c.id]?.length > 0;
                      const hasPapers = papers[c.id]?.length > 0;
                      return (
                        <React.Fragment key={c.id}>
                          <tr
                            onClick={() => {
                              setSelected(isSelected ? null : c);
                              if (!isSelected && !enrichedData[c.id]) enrichCompound(c);
                            }}
                            className="cursor-pointer transition-colors"
                            style={{
                              background: isSelected ? '#0a1828' : i%2===0 ? '#040a16' : '#050d1c',
                              borderBottom: '1px solid #0a1a30',
                            }}
                            onMouseEnter={e => { if (!isSelected) e.currentTarget.style.background = '#081020'; }}
                            onMouseLeave={e => { if (!isSelected) e.currentTarget.style.background = i%2===0 ? '#040a16' : '#050d1c'; }}
                          >
                            <td className="px-4 py-3">
                              <div className="font-medium" style={{color:'#d0ddf0'}}>{c.name}</div>
                              {c.synonyms && <div className="text-xs mt-0.5 truncate max-w-xs" style={{fontFamily:"'JetBrains Mono',monospace",color:'#2a4a6a'}}>{c.synonyms}</div>}
                            </td>
                            <td className="px-4 py-3">
                              <Badge color="#3a7aaa" small>{c.fda_nda ? 'FDA Listed' : 'Unapproved'}</Badge>
                            </td>
                            <td className="px-4 py-3">
                              <Badge color={c.nct_ids?.length ? '#10b981' : '#64748b'} small>{c.nct_ids?.length ? 'Has Trials' : 'No Trials'}</Badge>
                            </td>
                            <td className="px-4 py-3">
                              {hasTrials ? <Badge color="#10b981" small>{trials[c.id].length} trials</Badge> : <span className="text-xs" style={{color:'#3a5a7a'}}>—</span>}
                            </td>
                            <td className="px-4 py-3">
                              {hasPapers ? <Badge color="#a78bfa" small>{papers[c.id].length} papers</Badge> : <span className="text-xs" style={{color:'#3a5a7a'}}>—</span>}
                            </td>
                            <td className="px-4 py-3">
                              <button
                                onClick={(e) => { e.stopPropagation(); enrichCompound(c); }}
                                className="px-3 py-1 rounded text-xs font-semibold tracking-wider transition-colors"
                                style={{
                                  fontFamily:"'JetBrains Mono',monospace",
                                  background: enrichedData[c.id] ? '#052e16' : '#0d2040',
                                  color: enrichedData[c.id] ? '#10b981' : '#60aaff',
                                  border: `1px solid ${enrichedData[c.id] ? '#10b98144' : '#1a4a7a'}`,
                                  cursor: enrichedData[c.id] ? 'default' : 'pointer',
                                }}
                                disabled={enriching && !enrichedData[c.id]}
                              >
                                {enrichedData[c.id] ? '✓ ENRICHED' : enriching ? '…' : 'ENRICH'}
                              </button>
                            </td>
                          </tr>
                          {/* Expanded detail row */}
                          {isSelected && enrichedData[c.id] && (
                            <tr>
                              <td colSpan={6} className="p-0">
                                <div className="p-6" style={{background:'#070f1e', borderTop:'2px solid #0e2a40'}}>
                                  <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
                                    {/* FDA Data */}
                                    <div>
                                      <h3 className="text-xs font-semibold tracking-wider mb-3" style={{fontFamily:"'JetBrains Mono',monospace",color:'#10b981'}}>
                                        FDA DRUG LABEL
                                      </h3>
                                      {enrichedData[c.id]?.fda ? (
                                        <div className="space-y-3 text-sm" style={{color:'#7a9abf', lineHeight:1.6}}>
                                          <div>
                                            <span className="text-xs font-semibold" style={{color:'#3a6a9a'}}>INTENDED USE</span>
                                            <p className="mt-1">{enrichedData[c.id].fda.intended_use?.slice(0,300) || 'Not specified'}</p>
                                          </div>
                                          <div>
                                            <span className="text-xs font-semibold" style={{color:'#3a6a9a'}}>MECHANISM OF ACTION</span>
                                            <p className="mt-1">{enrichedData[c.id].fda.mechanism?.slice(0,300) || 'Not specified'}</p>
                                          </div>
                                          <div>
                                            <span className="text-xs font-semibold" style={{color:'#ef4444'}}>SIDE EFFECTS</span>
                                            <p className="mt-1">{enrichedData[c.id].fda.side_effects?.slice(0,300) || 'Not specified'}</p>
                                          </div>
                                        </div>
                                      ) : (
                                        <p className="text-sm" style={{color:'#4a6a8a'}}>No FDA label data available for this compound.</p>
                                      )}
                                      {c.fda_nda && (
                                        <a
                                          href={`https://www.accessdata.fda.gov/scripts/cder/daf/index.cfm?event=overview.process&ApplNo=${c.fda_nda}`}
                                          target="_blank" rel="noopener noreferrer"
                                          className="inline-flex items-center gap-1 mt-3 text-xs font-semibold tracking-wider"
                                          style={{fontFamily:"'JetBrains Mono',monospace",color:'#4a8aaa',textDecoration:'none'}}
                                        >
                                          <i data-lucide="external-link" className="w-3 h-3"></i> FDA Drugs@FDA
                                        </a>
                                      )}
                                    </div>
                                    {/* Clinical Trials */}
                                    <div>
                                      <h3 className="text-xs font-semibold tracking-wider mb-3" style={{fontFamily:"'JetBrains Mono',monospace",color:'#3b82f6'}}>
                                        CLINICAL TRIALS
                                      </h3>
                                      {enrichedData[c.id]?.trials?.length > 0 ? (
                                        <div className="space-y-3">
                                          {enrichedData[c.id].trials.map(t => (
                                            <div key={t.nct_id} className="p-3 rounded-lg" style={{background:'#060d1a',border:'1px solid #0e2040'}}>
                                              <a href={`https://clinicaltrials.gov/study/${t.nct_id}`} target="_blank" rel="noopener noreferrer"
                                                className="text-xs font-semibold" style={{fontFamily:"'JetBrains Mono',monospace",color:'#60a5fa',textDecoration:'none'}}>
                                                {t.nct_id}
                                              </a>
                                              <p className="text-sm mt-1" style={{color:'#7a9abf'}}>{t.title}</p>
                                              <div className="flex gap-2 mt-2">
                                                <Badge color="#a78bfa" small>{t.phase || 'N/A'}</Badge>
                                                <Badge color={t.status==='COMPLETED'?'#10b981':'#f59e0b'} small>{t.status}</Badge>
                                              </div>
                                              {t.conditions && <p className="text-xs mt-1" style={{color:'#4a6a8a'}}>{t.conditions}</p>}
                                            </div>
                                          ))}
                                        </div>
                                      ) : (
                                        <p className="text-sm" style={{color:'#4a6a8a'}}>No clinical trials found.</p>
                                      )}
                                    </div>
                                    {/* PubMed Papers */}
                                    <div>
                                      <h3 className="text-xs font-semibold tracking-wider mb-3" style={{fontFamily:"'JetBrains Mono',monospace",color:'#a78bfa'}}>
                                        PUBMED LITERATURE
                                      </h3>
                                      {enrichedData[c.id]?.papers?.length > 0 ? (
                                        <div className="space-y-3">
                                          {enrichedData[c.id].papers.map(p => (
                                            <div key={p.pmid} className="p-3 rounded-lg" style={{background:'#060d1a',border:'1px solid #0e2040'}}>
                                              <a href={p.url} target="_blank" rel="noopener noreferrer"
                                                className="text-sm font-medium hover:underline" style={{color:'#93c5fd',textDecoration:'none'}}>
                                                {p.title}
                                              </a>
                                              <p className="text-xs mt-1" style={{color:'#4a6a8a'}}>{p.source} · {p.pubdate}</p>
                                              <p className="text-xs mt-0.5" style={{fontFamily:"'JetBrains Mono',monospace",color:'#2a4a6a'}}>PMID: {p.pmid}</p>
                                            </div>
                                          ))}
                                        </div>
                                      ) : (
                                        <p className="text-sm" style={{color:'#4a6a8a'}}>No PubMed literature found.</p>
                                      )}
                                    </div>
                                  </div>
                                </div>
                              </td>
                            </tr>
                          )}
                        </React.Fragment>
                      );
                    })}
                  </tbody>
                </table>
                {filtered.length === 0 && (
                  <div className="text-center py-12 text-sm" style={{fontFamily:"'JetBrains Mono',monospace",color:'#2a4a6a'}}>
                    NO COMPOUNDS MATCH YOUR SEARCH
                  </div>
                )}
              </div>
            </div>
          )}

          {/* ── ANALYTICS TAB ── */}
          {activeTab === 'analytics' && (
            <div className="max-w-7xl mx-auto px-4 pb-8">
              <div className="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
                {[
                  {label:'TOTAL COMPOUNDS',value:stats.total,color:'#60aaff'},
                  {label:'WITH TRIALS',value:stats.withTrials,color:'#10b981'},
                  {label:'WITH LITERATURE',value:stats.withPapers,color:'#a78bfa'},
                ].map(s => (
                  <div key={s.label} className="p-4 rounded-xl" style={{background:'#060d1a',border:'1px solid #0e2040'}}>
                    <div className="text-3xl font-bold" style={{fontFamily:"'Syne',sans-serif",color:s.color}}>{s.value}</div>
                    <div className="text-xs tracking-wider mt-1" style={{fontFamily:"'JetBrains Mono',monospace",color:'#3a5a7a'}}>{s.label}</div>
                  </div>
                ))}
              </div>
              {/* WADA Class Summary */}
              <div className="p-6 rounded-xl" style={{background:'#060d1a',border:'1px solid #0e2040'}}>
                <h3 className="text-sm font-bold mb-4" style={{fontFamily:"'Syne',sans-serif",color:'#e8f0ff'}}>DATA COVERAGE</h3>
                <div className="space-y-3">
                  {[
                    {label:'Compounds with FDA Labels', value: Object.values(enrichedData).filter(d => d.fda).length, color:'#10b981'},
                    {label:'Compounds with Clinical Trials', value: Object.keys(trials).length, color:'#3b82f6'},
                    {label:'Compounds with PubMed References', value: Object.keys(papers).length, color:'#a78bfa'},
                    {label:'PDF-Ingested Products', value: compounds.filter(c => c.status === 'pdf_ingested').length, color:'#f59e0b'},
                  ].map(item => {
                    const pct = stats.total > 0 ? Math.round((item.value / stats.total) * 100) : 0;
                    return (
                      <div key={item.label}>
                        <div className="flex justify-between text-xs mb-1" style={{fontFamily:"'JetBrains Mono',monospace"}}>
                          <span style={{color:'#4a7aaa'}}>{item.label}</span>
                          <span style={{color:item.color}}>{item.value} ({pct}%)</span>
                        </div>
                        <div className="h-2 rounded-full" style={{background:'#080e1c'}}>
                          <div className="h-2 rounded-full transition-all" style={{width:`${pct}%`,background:item.color}}></div>
                        </div>
                      </div>
                    );
                  })}
                </div>
              </div>
            </div>
          )}

          {/* ── IMPORT TAB ── */}
          {activeTab === 'import' && (
            <div className="max-w-7xl mx-auto px-4 pb-8">
              <div className="p-6 rounded-xl mb-6" style={{background:'#060d1a',border:'1px solid #0e2040'}}>
                <h3 className="text-sm font-bold mb-3" style={{fontFamily:"'Syne',sans-serif",color:'#e8f0ff'}}>
                  INGEST PHARMACEUTICAL CATALOGUE (PDF)
                </h3>
                <p className="text-xs mb-4" style={{color:'#4a6a8a'}}>
                  Upload a PDF product catalogue. The system will extract product names, dosages, and prices using client‑side parsing.
                  Extracted products are added to the compound matrix for enrichment.
                </p>
                <label className="inline-flex items-center gap-2 px-4 py-2 rounded-lg cursor-pointer transition-colors"
                  style={{background:'#0d2040',border:'1px solid #1a4a7a',color:'#60aaff',fontFamily:"'JetBrains Mono',monospace",fontSize:'0.75rem'}}>
                  <i data-lucide="upload" className="w-4 h-4"></i>
                  SELECT PDF FILE
                  <input type="file" accept=".pdf" onChange={handlePDFUpload} className="hidden" />
                </label>
                {pdfLoading && <Spinner />}
              </div>
              {pdfProducts.length > 0 && (
                <div className="rounded-xl" style={{border:'1px solid #0e2040'}}>
                  <div className="p-4" style={{background:'#060d1a',borderBottom:'1px solid #0e2040'}}>
                    <h3 className="text-sm font-bold" style={{fontFamily:"'Syne',sans-serif",color:'#e8f0ff'}}>
                      EXTRACTED PRODUCTS ({pdfProducts.length})
                    </h3>
                  </div>
                  <div className="overflow-x-auto">
                    <table className="w-full text-sm">
                      <thead>
                        <tr style={{background:'#040a16',borderBottom:'1px solid #0e2040'}}>
                          {['Product','Dosage','Price'].map(h => (
                            <th key={h} className="px-4 py-2 text-left text-xs font-semibold tracking-wider" style={{fontFamily:"'JetBrains Mono',monospace",color:'#3a5a7a'}}>{h}</th>
                          ))}
                        </tr>
                      </thead>
                      <tbody>
                        {pdfProducts.map((p,i) => (
                          <tr key={p.id} style={{background:i%2===0?'#040a16':'#050d1c',borderBottom:'1px solid #0a1a30'}}>
                            <td className="px-4 py-2" style={{color:'#d0ddf0'}}>{p.name}</td>
                            <td className="px-4 py-2" style={{fontFamily:"'JetBrains Mono',monospace",color:'#4a7aaa'}}>{p.dosage}</td>
                            <td className="px-4 py-2" style={{fontFamily:"'JetBrains Mono',monospace",color:'#10b981'}}>{p.price ? '$'+p.price : '—'}</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                </div>
              )}
            </div>
          )}

          {/* ── FOOTER ── */}
          <div className="border-t" style={{borderColor:'#080e1c',marginTop:'auto'}}>
            <div className="max-w-7xl mx-auto px-4 py-3 flex justify-between flex-wrap gap-2 text-xs" style={{fontFamily:"'JetBrains Mono',monospace"}}>
              <span style={{color:'#1a3a5a'}}>PRIS v1.0 · API‑DRIVEN · SELF‑HOSTED</span>
              <span style={{color:'#1a2a3a'}}>FOR REGULATORY RESEARCH PURPOSES · NOT MEDICAL OR LEGAL ADVICE</span>
            </div>
          </div>
        </div>
      );
    }

    ReactDOM.createRoot(document.getElementById('root')).render(<App />);
    setTimeout(() => lucide.createIcons(), 100);
  </script>
</body>
</html>
