// Transform raw CSV row to internal jurisdiction object structure (for map display)
export function transformToJurisdictions(compound) {
  const jurisdictions = {};
  
  const mapping = {
    us: { status: 'US_FDA_Status', access: 'US_Legal_Access' },
    eu: { status: 'EU_EMA_Status', access: 'EU_Legal_Access' },
    ca: { status: 'CA_HealthCanada_Status', access: 'CA_Legal_Access' },
    au: { status: 'AU_TGA_Status', access: 'AU_Legal_Access' },
    uk: { status: 'UK_MHRA_Status', access: 'UK_Legal_Access' },
    jp: { status: 'JP_PMDA_Status', access: 'JP_Legal_Access' },
    ru: { status: 'RU_Status', access: 'RU_Legal_Access' },
  };
  
  for (const [key, fields] of Object.entries(mapping)) {
    jurisdictions[key] = {
      status: compound[fields.status] || 'unknown',
      access: compound[fields.access] || 'unknown',
    };
  }
  
  return jurisdictions;
}
