// ---- Hybrid approach: RxDB for documents + Pinata for IPFS persistence ----

import { createRxDatabase, addRxPlugin } from 'rxdb';
import { getRxStorageIndexedDB } from 'rxdb/plugins/storage-indexeddb';
import { replicateWebRTC } from 'rxdb/plugins/replication-webrtc';

// 1. Initialize RxDB with IndexedDB (free, browser-native)
const db = await createRxDatabase({
  name: 'longevity_db',
  storage: getRxStorageIndexedDB()
});

await db.addCollections({
  plasmids: { schema: plasmidSchema },
  dna_sequences: { schema: dnaSequenceSchema },
  genes: { schema: geneSchema }
});

// 2. Fetch from Addgene API and feed back into local DB
async function ingestAddgenePlasmid(plasmidId) {
  const res = await fetch(`https://api.addgene.org/v1/plasmids/${plasmidId}`);
  const data = await res.json();

  // Insert into RxDB → triggers WebRTC replication to other peers
  await db.plasmids.upsert({
    plasmid_id: String(data.id),
    name: data.name,
    vector_backbone: data.vectorBackbone,
    resistance_markers: data.resistance,
    expression_system: data.expressionSystem,
    sequence_id: data.genbankAcc,
    source: 'addgene',
    source_id: String(data.id)
  });

  // 3. Also pin plasmid JSON to IPFS via Pinata for long-term availability
  await fetch('https://api.pinata.cloud/pinning/pinJSONToIPFS', {
    method: 'POST',
    headers: {
      'Authorization': `Bearer ${PINATA_JWT}`,
      'Content-Type': 'application/json'
    },
    body: JSON.stringify({
      pinataContent: data,
      pinataMetadata: { name: `plasmid-${plasmidId}` }
    })
  });
}

// 4. Set up WebRTC replication (serverless P2P sync)
const replication = replicateWebRTC({
  collection: db.plasmids,
  topic: 'longevity-plasmids',  // shared topic for peer discovery
  signalServer: 'wss://free-signal.example.com'  // optional free signaling
});
