function buildTradingGraph() {
  log('Building graph...', 'info');
  state.graph = {};
  let edgeCount = 0;
  const minLiq = parseFloat(document.getElementById('minLiq').value || 100);

  state.allPairs.forEach(function(pair) {
    if (pair.liquidity < minLiq) return;

    if (!state.graph[pair.base]) state.graph[pair.base] = {};
    if (!state.graph[pair.target]) state.graph[pair.target] = {};

    const effectiveRate = pair.price * (1 - pair.bidAskSpread);

    // Forward edge: base -> target
    if (effectiveRate > 0) {
      const forwardEdge = {
        rate: effectiveRate,
        weight: -Math.log(effectiveRate),
        volume: pair.volume,
        liquidity: pair.liquidity,
        spread: pair.bidAskSpread,
        exchange: pair.exchange // We need to store the exchange in the pair? We don't have it now.
      };

      // If we already have an edge, compare the spreads and keep the one with the lower spread.
      if (!state.graph[pair.base][pair.target] || state.graph[pair.base][pair.target].spread > forwardEdge.spread) {
        state.graph[pair.base][pair.target] = forwardEdge;
        edgeCount++;
      }

      // Reverse edge: target -> base
      const reverseRate = 1 / effectiveRate;
      const reverseEdge = {
        rate: reverseRate,
        weight: -Math.log(reverseRate),
        volume: pair.volume,
        liquidity: pair.liquidity,
        spread: pair.bidAskSpread,
        exchange: pair.exchange
      };

      if (!state.graph[pair.target][pair.base] || state.graph[pair.target][pair.base].spread > reverseEdge.spread) {
        state.graph[pair.target][pair.base] = reverseEdge;
        edgeCount++;
      }
    }
  });

  state.stats.graphNodes = Object.keys(state.graph).length;
  state.stats.graphEdges = edgeCount;

  log('Graph: ' + state.stats.graphNodes + ' nodes, ' + edgeCount + ' edges', 'success');
}
