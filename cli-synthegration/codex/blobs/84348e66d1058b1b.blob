function resolveROR() {
  var sheet = SpreadsheetApp.getActiveSheet();
  var cell = sheet.getActiveCell();
  var orgName = cell.getValue();
  
  var url = `https://api.ror.org/organizations?query=${encodeURIComponent(orgName)}`;
  var response = UrlFetchApp.fetch(url);
  var data = JSON.parse(response);
  
  if (data.items && data.items.length > 0) {
    var rorId = data.items[0].id;
    var matchedName = data.items[0].name;
    // Write ROR ID to adjacent cell (e.g., column C)
    sheet.getRange(cell.getRow(), 3).setValue(rorId); 
    sheet.getRange(cell.getRow(), 2).setValue(matchedName); // Correct the name
    SpreadsheetApp.getUi().alert(`Matched: ${matchedName}\nROR ID: ${rorId}`);
  } else {
    SpreadsheetApp.getUi().alert('No ROR match found.');
  }
}
