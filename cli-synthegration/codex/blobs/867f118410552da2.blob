// components/MatrixView.jsx
import React, { useState } from 'react';
import { Search, Download } from 'lucide-react';
import { exportToCSV } from '../utils/export';

const STATUS_COLORS = {
  approved: 'bg-green-100 text-green-800',
  investigational: 'bg-blue-100 text-blue-800',
  unapproved: 'bg-red-100 text-red-800',
  withdrawn: 'bg-yellow-100 text-yellow-800',
  unknown: 'bg-gray-100 text-gray-800',
};

export default function MatrixView({ compounds, onSelectCompound, selectedCompound }) {
  const [search, setSearch] = useState('');
  const [filterType, setFilterType] = useState('all');
  const [filterWADA, setFilterWADA] = useState('all');

  const types = ['all', ...new Set(compounds.map(c => c.type))];
  const wadaStatuses = ['all', 'prohibited', 'permitted', 'unknown'];

  const filtered = compounds.filter(c => {
    const q = search.toLowerCase();
    const matchSearch = !q || c.name.toLowerCase().includes(q) || c.synonyms?.toLowerCase().includes(q);
    const matchType = filterType === 'all' || c.type === filterType;
    const matchWADA = filterWADA === 'all' || c.wadaStatus === filterWADA;
    return matchSearch && matchType && matchWADA;
  });

  return (
    <div className="max-w-7xl mx-auto">
      <header className="mb-6 flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div>
          <h1 className="text-3xl font-bold text-gray-900 dark:text-white">Global Regulatory Matrix</h1>
          <p className="text-gray-500 dark:text-gray-400 mt-1">
            Peptides, hormones, anabolics, and advanced therapies.
          </p>
        </div>
        <button
          onClick={() => exportToCSV(filtered)}
          className="inline-flex items-center px-4 py-2 bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 rounded-lg text-sm font-medium shadow-sm hover:bg-gray-50 dark:hover:bg-gray-700"
        >
          <Download className="w-4 h-4 mr-2" />
          Export CSV
        </button>
      </header>

      {/* Filters */}
      <div className="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-4 mb-6 flex flex-wrap gap-4">
        <div className="relative flex-1 min-w-[200px]">
          <Search className="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 w-5 h-5" />
          <input
            type="text"
            placeholder="Search compounds..."
            value={search}
            onChange={(e) => setSearch(e.target.value)}
            className="w-full pl-10 pr-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-900 focus:ring-2 focus:ring-indigo-500 outline-none"
          />
        </div>
        <select
          value={filterType}
          onChange={(e) => setFilterType(e.target.value)}
          className="px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-900"
        >
          {types.map(t => <option key={t} value={t}>{t === 'all' ? 'All Types' : t}</option>)}
        </select>
        <select
          value={filterWADA}
          onChange={(e) => setFilterWADA(e.target.value)}
          className="px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-900"
        >
          {wadaStatuses.map(s => <option key={s} value={s}>{s === 'all' ? 'All WADA' : s}</option>)}
        </select>
        <div className="ml-auto text-sm text-gray-500 dark:text-gray-400 self-center">
          {filtered.length} of {compounds.length} compounds
        </div>
      </div>

      {/* Table */}
      <div className="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 overflow-x-auto">
        <table className="w-full text-sm">
          <thead className="bg-gray-50 dark:bg-gray-700 text-gray-600 dark:text-gray-300 font-semibold border-b border-gray-200 dark:border-gray-600">
            <tr>
              <th className="px-6 py-3 text-left">Compound</th>
              <th className="px-6 py-3 text-left">Type</th>
              <th className="px-6 py-3 text-center">US Status</th>
              <th className="px-6 py-3 text-center">EU Status</th>
              <th className="px-6 py-3 text-center">WADA</th>
            </tr>
          </thead>
          <tbody className="divide-y divide-gray-200 dark:divide-gray-700">
            {filtered.map(c => (
              <tr
                key={c.id}
                onClick={() => onSelectCompound(c)}
                className={`hover:bg-gray-50 dark:hover:bg-gray-700 cursor-pointer transition ${
                  selectedCompound?.id === c.id ? 'bg-indigo-50 dark:bg-indigo-900/20' : ''
                }`}
              >
                <td className="px-6 py-4">
                  <div className="font-medium text-gray-900 dark:text-white">{c.name}</div>
                  <div className="text-xs text-gray-500 dark:text-gray-400">{c.id}</div>
                </td>
                <td className="px-6 py-4 text-gray-700 dark:text-gray-300">{c.type}</td>
                <td className="px-6 py-4 text-center">
                  <span className={`inline-flex px-2 py-1 rounded-full text-xs font-medium ${STATUS_COLORS[c.usStatus] || STATUS_COLORS.unknown}`}>
                    {c.usStatus}
                  </span>
                </td>
                <td className="px-6 py-4 text-center">
                  <span className={`inline-flex px-2 py-1 rounded-full text-xs font-medium ${STATUS_COLORS[c.euStatus] || STATUS_COLORS.unknown}`}>
                    {c.euStatus}
                  </span>
                </td>
                <td className="px-6 py-4 text-center">
                  <span className={`inline-flex px-2 py-1 rounded-full text-xs font-medium ${
                    c.wadaStatus === 'prohibited' ? 'bg-red-100 text-red-800' :
                    c.wadaStatus === 'permitted' ? 'bg-green-100 text-green-800' :
                    'bg-gray-100 text-gray-800'
                  }`}>
                    {c.wadaStatus}
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  );
}
