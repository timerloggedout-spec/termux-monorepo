-- Enable UUID extension for surrogate keys
CREATE EXTENSION IF NOT EXISTS "uuid-ossp";

-- ============================================================================
-- CORE TABLES
-- ============================================================================

CREATE TABLE entity (
    entity_id           UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    canonical_name      TEXT NOT NULL,
    entity_type         TEXT NOT NULL CHECK (entity_type IN (
                            'peptide', 'peptide_hormone', 'protein', 'gene_therapy',
                            'anabolic_agent', 'steroid', 'small_molecule', 'other'
                        )),
    modality            TEXT CHECK (modality IN (
                            'peptide', 'recombinant_protein', 'gene_transfer',
                            'viral_vector', 'nonviral_gene_therapy', 'steroid',
                            'hormone', 'mixed'
                        )),
    sequence            TEXT,               -- amino acid or nucleotide, nullable
    sequence_length     INTEGER,
    modifications       TEXT,               -- e.g., acetylation, PEGylation, etc.
    target              TEXT,               -- biological target
    mechanism           TEXT,
    indication_summary  TEXT,
    source_primary      TEXT,               -- URI or reference to primary source
    source_secondary    TEXT,
    created_at          TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
    last_verified_at    TIMESTAMP WITH TIME ZONE,
    UNIQUE (canonical_name)                 -- business key, dedupe handled in ETL
);

-- Indexes for entity
CREATE INDEX idx_entity_type ON entity(entity_type);
CREATE INDEX idx_entity_modality ON entity(modality);

-- ============================================================================
CREATE TABLE synonym (
    synonym_id          UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    entity_id           UUID NOT NULL REFERENCES entity(entity_id) ON DELETE CASCADE,
    synonym_name        TEXT NOT NULL,
    synonym_type        TEXT CHECK (synonym_type IN (
                            'INN', 'USAN', 'brand', 'registry_name', 'legacy_name',
                            'transliterated', 'abbreviation'
                        )),
    source_id           UUID,               -- references source table later
    confidence          NUMERIC(3,2) CHECK (confidence BETWEEN 0 AND 1),
    created_at          TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
    UNIQUE (entity_id, synonym_name)        -- no duplicate synonyms per entity
);

CREATE INDEX idx_synonym_name ON synonym(synonym_name);
CREATE INDEX idx_synonym_entity ON synonym(entity_id);

-- ============================================================================
CREATE TABLE organization (
    org_id              UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    org_name_canonical  TEXT NOT NULL,
    org_type            TEXT CHECK (org_type IN (
                            'sponsor', 'manufacturer', 'regulator', 'research_body', 'other'
                        )),
    ror_id              TEXT UNIQUE,        -- canonical org ID
    grid_id             TEXT,
    wikidata_id         TEXT,
    isni_id             TEXT,
    crossref_funder_id  TEXT,
    country             CHAR(2),            -- ISO 3166-1 alpha-2
    website             TEXT,
    source_url          TEXT,
    created_at          TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
    last_verified_at    TIMESTAMP WITH TIME ZONE
);

CREATE INDEX idx_org_ror ON organization(ror_id);
CREATE INDEX idx_org_name ON organization(org_name_canonical);

-- ============================================================================
CREATE TABLE trial (
    trial_id_internal   UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    entity_id           UUID NOT NULL REFERENCES entity(entity_id) ON DELETE CASCADE,
    registry_name       TEXT NOT NULL CHECK (registry_name IN (
                            'ClinicalTrials.gov', 'EUCTR', 'ISRCTN', 'ANZCTR',
                            'ChiCTR', 'IRCT', 'JPRN', 'DRKS', 'NTR', 'PACTR',
                            'ReBec', 'RPCEC', 'SLCTR', 'TCTR', 'UMIN-CTR'
                        )),
    registry_id         TEXT NOT NULL,      -- e.g., NCT12345678
    sponsor_org_id      UUID REFERENCES organization(org_id),
    collaborator_org_ids UUID[],            -- array of org_id references
    phase               TEXT CHECK (phase IN (
                            'Early Phase 1', 'Phase 1', 'Phase 1/2', 'Phase 2',
                            'Phase 2/3', 'Phase 3', 'Phase 4', 'Not Applicable'
                        )),
    status              TEXT NOT NULL CHECK (status IN (
                            'Not yet recruiting', 'Recruiting', 'Enrolling by invitation',
                            'Active, not recruiting', 'Completed', 'Suspended',
                            'Terminated', 'Withdrawn', 'Unknown status'
                        )),
    study_type          TEXT CHECK (study_type IN (
                            'Interventional', 'Observational', 'Expanded Access'
                        )),
    condition           TEXT,               -- comma-separated or array in practice
    country_list        TEXT[],             -- ISO 3166-1 alpha-2 codes
    start_date          DATE,
    completion_date     DATE,
    intervention_name   TEXT,
    intervention_class  TEXT,
    source_url          TEXT,
    last_verified_at    TIMESTAMP WITH TIME ZONE,
    UNIQUE (registry_name, registry_id)
);

CREATE INDEX idx_trial_entity ON trial(entity_id);
CREATE INDEX idx_trial_registry ON trial(registry_name, registry_id);
CREATE INDEX idx_trial_status ON trial(status);

-- ============================================================================
CREATE TABLE country (
    jurisdiction_code   CHAR(2) PRIMARY KEY,  -- ISO 3166-1 alpha-2
    jurisdiction_name   TEXT NOT NULL,
    region              TEXT,                 -- e.g., Europe, North America
    regulator_name_primary TEXT,
    regulator_urls      TEXT[],               -- array of URLs
    notes               TEXT
);

-- ============================================================================
CREATE TABLE regulatory_jurisdiction (
    reg_id              UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    entity_id           UUID NOT NULL REFERENCES entity(entity_id) ON DELETE CASCADE,
    jurisdiction_code   CHAR(2) NOT NULL REFERENCES country(jurisdiction_code),
    jurisdiction_name   TEXT NOT NULL,        -- denormalized for ease
    regulator_name      TEXT,
    approval_status     TEXT CHECK (approval_status IN (
                            'approved', 'authorized', 'conditionally_authorized',
                            'investigational', 'unapproved', 'banned', 'restricted',
                            'withdrawn', 'unavailable', 'unknown'
                        )),
    market_status       TEXT CHECK (market_status IN (
                            'marketed', 'not_marketed', 'discontinued', 'shortage',
                            'import_only', 'pharmacy_compounded', 'unknown'
                        )),
    legal_access_status TEXT CHECK (legal_access_status IN (
                            'prescription_only', 'otc', 'special_access',
                            'clinical_trial_only', 'compassionate_use', 'prohibited', 'unknown'
                        )),
    approved_indications TEXT,
    approval_date       DATE,
    route_restrictions  TEXT,
    formulation_restrictions TEXT,
    import_restrictions TEXT,
    compounding_restrictions TEXT,
    evidence_url        TEXT,
    last_verified_at    TIMESTAMP WITH TIME ZONE,
    UNIQUE (entity_id, jurisdiction_code)
);

CREATE INDEX idx_reg_entity ON regulatory_jurisdiction(entity_id);
CREATE INDEX idx_reg_jurisdiction ON regulatory_jurisdiction(jurisdiction_code);
CREATE INDEX idx_reg_approval ON regulatory_jurisdiction(approval_status);

-- ============================================================================
CREATE TABLE anti_doping (
    doping_id           UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    entity_id           UUID NOT NULL REFERENCES entity(entity_id) ON DELETE CASCADE,
    framework           TEXT NOT NULL CHECK (framework IN (
                            'WADA', 'AIU', 'local_anti_doping', 'other'
                        )),
    status              TEXT CHECK (status IN (
                            'prohibited', 'monitored', 'permitted', 'unknown'
                        )),
    category            TEXT,                -- e.g., S1, S2, etc. for WADA
    in_competition      BOOLEAN,
    out_of_competition  BOOLEAN,
    notes               TEXT,
    source_url          TEXT,
    last_verified_at    TIMESTAMP WITH TIME ZONE,
    UNIQUE (entity_id, framework)            -- one status per framework per entity
);

CREATE INDEX idx_doping_entity ON anti_doping(entity_id);
CREATE INDEX idx_doping_framework ON anti_doping(framework);

-- ============================================================================
CREATE TABLE source (
    source_id           UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    source_type         TEXT NOT NULL CHECK (source_type IN (
                            'official_registry', 'trial_registry', 'database',
                            'journal_article', 'review', 'news', 'aggregator'
                        )),
    source_name         TEXT NOT NULL,
    url                 TEXT,
    citation_text       TEXT,
    retrieval_date      DATE,
    reliability_tier    INTEGER CHECK (reliability_tier BETWEEN 1 AND 5),
    UNIQUE (source_name, url)                 -- avoid exact duplicates
);

-- ============================================================================
-- CROSS-REFERENCE TABLES (provenance tracking)
-- ============================================================================

CREATE TABLE entity_source (
    entity_id           UUID NOT NULL REFERENCES entity(entity_id) ON DELETE CASCADE,
    source_id           UUID NOT NULL REFERENCES source(source_id) ON DELETE CASCADE,
    field_name          TEXT,                -- optional: which field this source supports
    PRIMARY KEY (entity_id, source_id, field_name)
);

CREATE TABLE synonym_source (
    synonym_id          UUID NOT NULL REFERENCES synonym(synonym_id) ON DELETE CASCADE,
    source_id           UUID NOT NULL REFERENCES source(source_id) ON DELETE CASCADE,
    PRIMARY KEY (synonym_id, source_id)
);

-- Add foreign key for synonym.source_id after source table creation
ALTER TABLE synonym
    ADD CONSTRAINT synonym_source_fk FOREIGN KEY (source_id) REFERENCES source(source_id) ON DELETE SET NULL;

-- ============================================================================
-- VERSIONING / CHANGE HISTORY (simplified)
-- ============================================================================

CREATE TABLE entity_history (
    history_id          UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    entity_id           UUID NOT NULL REFERENCES entity(entity_id) ON DELETE CASCADE,
    changed_at          TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
    changed_by          TEXT,                -- process name / user
    field_name          TEXT NOT NULL,
    old_value           TEXT,
    new_value           TEXT
);

CREATE INDEX idx_history_entity ON entity_history(entity_id);
CREATE INDEX idx_history_timestamp ON entity_history(changed_at);

-- ============================================================================
-- ADDITIONAL INDEXES FOR PERFORMANCE
-- ============================================================================

CREATE INDEX idx_entity_canonical_trgm ON entity USING gin (canonical_name gin_trgm_ops);
CREATE INDEX idx_synonym_name_trgm ON synonym USING gin (synonym_name gin_trgm_ops);

COMMENT ON TABLE entity IS 'Canonical substance/entity record';
COMMENT ON TABLE regulatory_jurisdiction IS 'Per-jurisdiction regulatory and market status';
COMMENT ON TABLE anti_doping IS 'Sport anti-doping prohibitions per framework';
