class ProductionArbitrageEngine {
    constructor(dataManager, logger) {
        this.dataManager = dataManager;
        this.logger = logger;
        this.isScanning = false;
        this.currentScan = null;
        this.opportunities = [];
        this.performance = {
            lastScanTime: 0,
            opportunitiesFound: 0,
            totalCycles: 0
        };
    }

    async initialize() {
        this.logger.log('ARBITRAGE_ENGINE', 'Initializing arbitrage detection engine...', 'info');
        
        // Initialize algorithms
        this.triangularArbitrage = new TriangularArbitrage(this.dataManager, this.logger);
        this.bellmanFordArbitrage = new BellmanFordArbitrage(this.dataManager, this.logger);
        this.lowValueArbitrage = new LowValueArbitrage(this.dataManager, this.logger);
        
        this.logger.log('ARBITRAGE_ENGINE', 'Arbitrage algorithms loaded', 'success');
        return true;
    }

    async executeMultiExchangeScan(params) {
        if (this.isScanning) {
            this.logger.log('ARBITRAGE_ENGINE', 'Scan already in progress', 'warning');
            return;
        }

        this.isScanning = true;
        this.performance.lastScanTime = Date.now();
        
        const {
            exchanges = ['binance', 'kraken', 'kucoin', 'coingecko', 'dexscreener'],
            method = 'triangular',
            investmentAmount = 100,
            batchSize = 100,
            minProfitPercent = 0.01
        } = params;

        this.logger.log('ARBITRAGE_ENGINE', 
            `Starting ${method} scan on ${exchanges.length} exchanges`, 'info');

        try {
            let allOpportunities = [];
            
            // Scan each exchange in parallel where possible
            const exchangeScans = exchanges.map(async (exchange) => {
                return await this.scanSingleExchange({
                    exchange,
                    method,
                    investmentAmount,
                    batchSize,
                    minProfitPercent
                });
            });

            const results = await Promise.allSettled(exchangeScans);
            
            results.forEach((result, index) => {
                if (result.status === 'fulfilled') {
                    allOpportunities = allOpportunities.concat(result.value);
                    this.logger.log('ARBITRAGE_ENGINE', 
                        `Found ${result.value.length} opportunities on ${exchanges[index]}`, 'success');
                } else {
                    this.logger.log('ARBITRAGE_ENGINE', 
                        `Scan failed for ${exchanges[index]}: ${result.reason.message}`, 'error');
                }
            });

            // Filter and sort opportunities
            this.opportunities = this.filterAndSortOpportunities(allOpportunities, minProfitPercent);
            this.performance.opportunitiesFound = this.opportunities.length;
            this.performance.totalCycles++;

            this.logger.log('ARBITRAGE_ENGINE', 
                `Scan completed: ${this.opportunities.length} profitable opportunities found`, 'success');
            
            return this.opportunities;

        } catch (error) {
            this.logger.log('ARBITRAGE_ENGINE', `Scan failed: ${error.message}`, 'error');
            return [];
        } finally {
            this.isScanning = false;
        }
    }

    async scanSingleExchange(params) {
        const { exchange, method, investmentAmount, batchSize, minProfitPercent } = params;
        const startTime = Date.now();
        
        this.logger.log('ARBITRAGE_ENGINE', `Scanning ${exchange} with ${method} method`, 'info');

        let opportunities = [];
        const exchangeData = this.dataManager.getExchangePairs(exchange);
        
        if (!exchangeData || exchangeData.length === 0) {
            this.logger.log('ARBITRAGE_ENGINE', `No data available for ${exchange}`, 'warning');
            return [];
        }

        try {
            switch (method) {
                case 'triangular':
                    opportunities = await this.triangularArbitrage.scan(
                        exchangeData, investmentAmount, minProfitPercent
                    );
                    break;
                    
                case 'bellman-ford':
                    opportunities = await this.bellmanFordArbitrage.scan(
                        exchangeData, investmentAmount, minProfitPercent
                    );
                    break;
                    
                case 'low-value':
                    opportunities = await this.lowValueArbitrage.scan(
                        exchangeData, investmentAmount, minProfitPercent
                    );
                    break;
                    
                default:
                    this.logger.log('ARBITRAGE_ENGINE', `Unknown method: ${method}`, 'error');
                    return [];
            }

            const scanTime = Date.now() - startTime;
            this.logger.log('ARBITRAGE_ENGINE', 
                `${exchange} scan completed in ${scanTime}ms: ${opportunities.length} opportunities`, 'info');

            return opportunities;

        } catch (error) {
            this.logger.log('ARBITRAGE_ENGINE', 
                `${exchange} scan failed: ${error.message}`, 'error');
            return [];
        }
    }

    filterAndSortOpportunities(opportunities, minProfitPercent) {
        return opportunities
            .filter(opp => opp.profitPercent >= minProfitPercent)
            .sort((a, b) => b.profitPercent - a.profitPercent)
            .slice(0, 50); // Limit to top 50 opportunities
    }

    stopScan() {
        if (this.isScanning) {
            this.isScanning = false;
            this.logger.log('ARBITRAGE_ENGINE', 'Scan stopped by user', 'warning');
            return true;
        }
        return false;
    }

    getPerformanceMetrics() {
        return {
            ...this.performance,
            isScanning: this.isScanning,
            currentOpportunities: this.opportunities.length
        };
    }
}

// Triangular Arbitrage Algorithm
class TriangularArbitrage {
    constructor(dataManager, logger) {
        this.dataManager = dataManager;
        this.logger = logger;
    }

    async scan(exchangeData, investmentAmount, minProfitPercent) {
        const startTime = Date.now();
        const opportunities = [];
        
        // Group pairs by base currency
        const pairsByBase = {};
        exchangeData.forEach(pair => {
            if (!pairsByBase[pair.base]) {
                pairsByBase[pair.base] = [];
            }
            pairsByBase[pair.base].push(pair);
        });

        // Look for triangular arbitrage opportunities
        const bases = Object.keys(pairsByBase);
        
        for (let i = 0; i < bases.length && i < 50; i++) { // Limit to first 50 bases for performance
            const baseCurrency = bases[i];
            const basePairs = pairsByBase[baseCurrency];
            
            for (const pair1 of basePairs) {
                const intermediateCurrency = pair1.target;
                const intermediatePairs = pairsByBase[intermediateCurrency] || [];
                
                for (const pair2 of intermediatePairs) {
                    const finalCurrency = pair2.target;
                    const returnPairs = pairsByBase[finalCurrency] || [];
                    
                    for (const pair3 of returnPairs) {
                        if (pair3.target === baseCurrency) {
                            // Found triangular path: A -> B -> C -> A
                            const opportunity = this.calculateTriangularOpportunity(
                                [pair1, pair2, pair3], investmentAmount, minProfitPercent
                            );
                            
                            if (opportunity) {
                                opportunities.push(opportunity);
                            }
                        }
                    }
                }
            }
        }

        const scanTime = Date.now() - startTime;
        this.logger.log('TRIANGULAR', 
            `Scanned ${bases.length} base currencies in ${scanTime}ms, found ${opportunities.length} opportunities`, 'info');
        
        return opportunities;
    }

    calculateTriangularOpportunity(path, investmentAmount, minProfitPercent) {
        try {
            const [pair1, pair2, pair3] = path;
            
            // Calculate forward path
            let amount = investmentAmount;
            
            // Step 1: Base -> Intermediate
            amount = amount / pair1.last;
            
            // Step 2: Intermediate -> Final  
            amount = amount / pair2.last;
            
            // Step 3: Final -> Base
            amount = amount * pair3.last;
            
            const profit = amount - investmentAmount;
            const profitPercent = (profit / investmentAmount) * 100;
            
            if (profitPercent >= minProfitPercent) {
                return {
                    path: `${pair1.base} → ${pair1.target} → ${pair2.target} → ${pair3.target}`,
                    profitPercent: profitPercent,
                    profit: profit,
                    investment: investmentAmount,
                    finalAmount: amount,
                    exchange: path[0].exchange,
                    type: 'triangular',
                    timestamp: Date.now()
                };
            }
        } catch (error) {
            this.logger.log('TRIANGULAR', `Error calculating opportunity: ${error.message}`, 'error');
        }
        
        return null;
    }
}

// Bellman-Ford Algorithm for Arbitrage
class BellmanFordArbitrage {
    constructor(dataManager, logger) {
        this.dataManager = dataManager;
        this.logger = logger;
    }

    async scan(exchangeData, investmentAmount, minProfitPercent) {
        const startTime = Date.now();
        
        // Build graph from exchange data
        const graph = this.buildGraph(exchangeData);
        const opportunities = this.findArbitrageOpportunities(graph, investmentAmount, minProfitPercent);
        
        const scanTime = Date.now() - startTime;
        this.logger.log('BELLMAN_FORD', 
            `Graph analysis completed in ${scanTime}ms, found ${opportunities.length} opportunities`, 'info');
        
        return opportunities;
    }

    buildGraph(exchangeData) {
        const graph = {};
        
        exchangeData.forEach(pair => {
            if (!graph[pair.base]) {
                graph[pair.base] = {};
            }
            if (!graph[pair.target]) {
                graph[pair.target] = {};
            }
            
            // Convert price to log for negative cycle detection
            const weight = -Math.log(pair.last);
            graph[pair.base][pair.target] = {
                weight: weight,
                originalPrice: pair.last,
                pair: pair
            };
        });
        
        return graph;
    }

    findArbitrageOpportunities(graph, investmentAmount, minProfitPercent) {
        const opportunities = [];
        const currencies = Object.keys(graph);
        
        // Run Bellman-Ford from each currency
        currencies.forEach(startCurrency => {
            const distances = {};
            const predecessors = {};
            
            // Initialize distances
            currencies.forEach(currency => {
                distances[currency] = Infinity;
                predecessors[currency] = null;
            });
            distances[startCurrency] = 0;
            
            // Relax edges |V| - 1 times
            for (let i = 0; i < currencies.length - 1; i++) {
                let updated = false;
                
                for (const u of currencies) {
                    for (const v in graph[u]) {
                        const weight = graph[u][v].weight;
                        if (distances[u] + weight < distances[v]) {
                            distances[v] = distances[u] + weight;
                            predecessors[v] = u;
                            updated = true;
                        }
                    }
                }
                
                if (!updated) break;
            }
            
            // Check for negative cycles (arbitrage opportunities)
            for (const u of currencies) {
                for (const v in graph[u]) {
                    const weight = graph[u][v].weight;
                    if (distances[u] + weight < distances[v]) {
                        // Negative cycle found - reconstruct path
                        const cycle = this.reconstructCycle(u, v, predecessors);
                        if (cycle && cycle.length > 2) {
                            const opportunity = this.calculateCycleOpportunity(
                                cycle, graph, investmentAmount, minProfitPercent
                            );
                            if (opportunity) {
                                opportunities.push(opportunity);
                            }
                        }
                    }
                }
            }
        });
        
        return opportunities;
    }

    reconstructCycle(u, v, predecessors) {
        const cycle = [v, u];
        let current = predecessors[u];
        const visited = new Set([u, v]);
        
        while (current && !visited.has(current)) {
            cycle.unshift(current);
            visited.add(current);
            current = predecessors[current];
            
            if (cycle.length > 10) break; // Prevent infinite loops
        }
        
        return cycle.length >= 3 ? cycle : null;
    }

    calculateCycleOpportunity(cycle, graph, investmentAmount, minProfitPercent) {
        try {
            let amount = investmentAmount;
            const pathDescription = [];
            
            for (let i = 0; i < cycle.length - 1; i++) {
                const from = cycle[i];
                const to = cycle[i + 1];
                const edge = graph[from][to];
                
                if (!edge) {
                    this.logger.log('BELLMAN_FORD', `Missing edge from ${from} to ${to}`, 'error');
                    return null;
                }
                
                amount = amount / edge.originalPrice;
                pathDescription.push(`${from}→${to}`);
            }
            
            // Close the cycle
            const from = cycle[cycle.length - 1];
            const to = cycle[0];
            const edge = graph[from][to];
            
            if (!edge) {
                this.logger.log('BELLMAN_FORD', `Missing closing edge from ${from} to ${to}`, 'error');
                return null;
            }
            
            amount = amount * edge.originalPrice;
            pathDescription.push(`${from}→${to}`);
            
            const profit = amount - investmentAmount;
            const profitPercent = (profit / investmentAmount) * 100;
            
            if (profitPercent >= minProfitPercent) {
                return {
                    path: pathDescription.join(' → '),
                    profitPercent: profitPercent,
                    profit: profit,
                    investment: investmentAmount,
                    finalAmount: amount,
                    exchange: 'multiple', // Could be from first edge
                    type: 'bellman-ford',
                    timestamp: Date.now(),
                    cycleLength: cycle.length
                };
            }
        } catch (error) {
            this.logger.log('BELLMAN_FORD', `Error calculating cycle: ${error.message}`, 'error');
        }
        
        return null;
    }
}

// Low Value Coin Arbitrage
class LowValueArbitrage {
    constructor(dataManager, logger) {
        this.dataManager = dataManager;
        this.logger = logger;
    }

    async scan(exchangeData, investmentAmount, minProfitPercent) {
        const startTime = Date.now();
        const opportunities = [];
        
        // Focus on low-value coins (under $0.01)
        const lowValuePairs = exchangeData.filter(pair => pair.last < 0.01);
        
        this.logger.log('LOW_VALUE', 
            `Found ${lowValuePairs.length} low-value pairs to analyze`, 'info');
        
        // Simple strategy: look for quick flips between stable pairs
        for (const pair of lowValuePairs.slice(0, 100)) { // Limit for performance
            const opportunity = this.analyzeLowValuePair(pair, investmentAmount, minProfitPercent);
            if (opportunity) {
                opportunities.push(opportunity);
            }
        }
        
        const scanTime = Date.now() - startTime;
        this.logger.log('LOW_VALUE', 
            `Low-value scan completed in ${scanTime}ms, found ${opportunities.length} opportunities`, 'info');
        
        return opportunities;
    }

    analyzeLowValuePair(pair, investmentAmount, minProfitPercent) {
        try {
            // Simple analysis: look for price discrepancies in related pairs
            // This is a simplified version - in production you'd want more sophisticated analysis
            
            const potentialProfit = this.estimateLowValueProfit(pair);
            const profitPercent = (potentialProfit / investmentAmount) * 100;
            
            if (profitPercent >= minProfitPercent) {
                return {
                    path: `${pair.base}/${pair.target} low-value play`,
                    profitPercent: profitPercent,
                    profit: potentialProfit,
                    investment: investmentAmount,
                    finalAmount: investmentAmount + potentialProfit,
                    exchange: pair.exchange,
                    type: 'low-value',
                    timestamp: Date.now(),
                    coinPrice: pair.last
                };
            }
        } catch (error) {
            this.logger.log('LOW_VALUE', `Error analyzing pair: ${error.message}`, 'error');
        }
        
        return null;
    }

    estimateLowValueProfit(pair) {
        // Simplified profit estimation for low-value coins
        // In production, this would use historical volatility, liquidity, and market analysis
        const baseProfit = pair.last * 1000; // Scale based on coin price
        const volumeFactor = Math.min(pair.volume / 1000, 10); // Scale by volume
        const randomFactor = 0.8 + (Math.random() * 0.4); // Some randomness
        
        return baseProfit * volumeFactor * randomFactor;
    }
}

// Make available globally
if (typeof module !== 'undefined' && module.exports) {
    module.exports = { ProductionArbitrageEngine, TriangularArbitrage, BellmanFordArbitrage, LowValueArbitrage };
} else {
    window.ProductionArbitrageEngine = ProductionArbitrageEngine;
    window.TriangularArbitrage = TriangularArbitrage;
    window.BellmanFordArbitrage = BellmanFordArbitrage;
    window.LowValueArbitrage = LowValueArbitrage;
}
