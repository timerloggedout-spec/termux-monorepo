function generateInvestmentCards() {
    const container = document.getElementById('investmentOptions');
    container.innerHTML = '';
    
    Object.entries(MODULES).forEach(([key, module]) => {
        const unlocked = STATE.user.unlockedModules.includes(key);
        const card = document.createElement('div');
        card.className = `investment-card ${unlocked ? '' : 'locked'}`;
        card.setAttribute('data-module', key);
        card.innerHTML = `
            <div class="investment-icon">${module.icon}</div>
            <h4>${module.name}</h4>
            <p>${unlocked ? 'Active' : `Unlocks at Level ${module.level}`}</p>
            ${unlocked ? `
                <div class="investment-controls">
                    <input type="number" id="amount-${key}" placeholder="Amount in Q-Bucks" min="1" max="${STATE.user.qBucks}" value="${module.cost}">
                    <button class="invest-btn" data-module="${key}">Invest</button>
                </div>
            ` : ''}
            <div class="module-status">${unlocked ? 'Active' : 'Locked'}</div>
        `;
        container.appendChild(card);
    });

    // Add event listeners to the invest buttons
    container.querySelectorAll('.invest-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
            const moduleKey = e.target.getAttribute('data-module');
            const amountInput = document.getElementById(`amount-${moduleKey}`);
            const amount = parseFloat(amountInput.value);
            if (amount && amount > 0 && amount <= STATE.user.qBucks) {
                activateInvestmentModule(moduleKey, amount);
            } else {
                showMessage('Invalid Amount', 'Please enter a valid amount within your Q-Bucks balance.');
            }
        });
    });
}
