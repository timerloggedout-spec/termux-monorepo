import express from 'express';
import { fetchCompounds, batchUpdateCompounds, updateCompound } from '../services/googleSheets.js';

const router = express.Router();

// GET all compounds
router.get('/', async (req, res) => {
  try {
    const data = await fetchCompounds();
    res.json(data);
  } catch (err) {
    console.error('Error fetching compounds:', err);
    res.status(500).json({ error: err.message });
  }
});

// POST batch update (for CSV import)
router.post('/batch', async (req, res) => {
  try {
    const { compounds } = req.body;
    if (!compounds || !Array.isArray(compounds)) {
      return res.status(400).json({ error: 'Invalid payload: compounds array required' });
    }
    const result = await batchUpdateCompounds(compounds);
    res.json(result);
  } catch (err) {
    console.error('Error batch updating:', err);
    res.status(500).json({ error: err.message });
  }
});

// PATCH single compound
router.patch('/:id', async (req, res) => {
  try {
    const result = await updateCompound(req.params.id, req.body);
    res.json(result);
  } catch (err) {
    console.error('Error updating compound:', err);
    res.status(500).json({ error: err.message });
  }
});

export default router;
