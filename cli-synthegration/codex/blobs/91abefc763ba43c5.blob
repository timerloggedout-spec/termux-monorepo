async initializeExchangeData() {
    try {
        this.logger.log('DATA_MANAGER', 'Initializing exchange data...', 'info');
        
        const liveDataToggle = document.getElementById('liveDataToggle').checked;
        if (liveDataToggle) {
            await this.loadAllExchanges();
        } else {
            throw new Error('Live data disabled by user');
        }
        
        if (Object.keys(this.exchangeData).length === 0) {
            throw new Error('No exchange data loaded');
        }
        
        this.isOnline = true;
        this.startPerformanceMonitoring();
        this.logger.log('DATA_MANAGER', 'Exchange data initialized successfully', 'success');
        return true;
        
    } catch (error) {
        this.logger.log('DATA_MANAGER', `Initialization failed: ${error.message}`, 'error');
        this.logger.log('DATA_MANAGER', 'Attempting fallback initialization...', 'warning');
        await this.initializeWithFallbackData();
        this.isOnline = true;
        this.logger.log('DATA_MANAGER', 'Fallback data initialized', 'warning');
        return true;
    }
}
