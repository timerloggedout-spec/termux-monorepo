.pip-container {
  position: absolute;
  bottom: 10px;
  right: 10px;
  width: 200px;
  height: 112px;
  z-index: 10;
  background: #000;
  border: 2px solid #3ea6ff;
  border-radius: 6px;
  overflow: hidden;
  box-shadow: 0 0 10px rgba(0,0,0,0.7);
  display: none;
}
.pip-container iframe {
  width: 100%;
  height: 100%;
  border: none;
}
.pip-close {
  position: absolute;
  top: 2px;
  right: 2px;
  background: rgba(0,0,0,0.7);
  color: white;
  border: none;
  border-radius: 3px;
  padding: 2px 6px;
  font-size: 0.8rem;
  cursor: pointer;
  z-index: 1;
}
