// ================= CONFIGURATION =================
const SHEET_ID = SpreadsheetApp.getActiveSpreadsheet().getId();
const COMPOUND_SHEET = "compounds";
const TRIAL_SHEET = "trials";
const ORG_SHEET = "organizations";

// ================= MAIN IMPORT FUNCTIONS =================

// 1. Import peptides from Peptipedia (via their public API or CSV)
function importPeptides() {
  // Peptipedia v2.0 provides a downloadable CSV at:
  // https://peptipedia.cl/export (requires scraping; alternative: use static curated list)
  // For demo, we use a public GitHub dataset of known therapeutic peptides
  const url = "https://raw.githubusercontent.com/your-repo/peptide-database/main/peptides.csv";
  const response = UrlFetchApp.fetch(url);
  const csv = response.getContentText();
  const parsed = Utilities.parseCsv(csv);
  const sheet = SpreadsheetApp.openById(SHEET_ID).getSheetByName(COMPOUND_SHEET);
  // Append new rows, avoiding duplicates by Entity_ID
  // Implementation depends on CSV structure
}

// 2. Import FDA approved drugs (openFDA)
function importFDA() {
  const url = "https://api.fda.gov/drug/drugsfda.json?limit=100&search=products.brand_name.exact:?&sort=effective_date:desc";
  // Note: openFDA requires pagination; this is a simplified example
  const response = UrlFetchApp.fetch(url);
  const data = JSON.parse(response.getContentText());
  const sheet = SpreadsheetApp.openById(SHEET_ID).getSheetByName(COMPOUND_SHEET);
  data.results.forEach(drug => {
    const product = drug.products[0];
    const row = {
      Entity_ID: drug.application_number,
      Canonical_Name: product.brand_name,
      Entity_Type: "small_molecule",
      US_FDA_Status: "approved",
      US_Legal_Access: "prescription_only",
      Last_Verified: new Date().toISOString(),
      Source_URL: `https://www.accessdata.fda.gov/scripts/cder/daf/index.cfm?event=overview.process&ApplNo=${drug.application_number}`
    };
    // Append or update row
    appendOrUpdateRow(row);
  });
}

