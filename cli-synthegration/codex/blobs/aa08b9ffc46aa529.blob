<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>QuanTM FOAM v7.0 - Advanced Arbitrage</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { 
            background: #0a0a1a; 
            color: #a0a0ff; 
            font-family: 'Courier New', monospace;
            padding: 10px;
            font-size: 12px;
            line-height: 1.4;
        }
        h1 { color: #00f0ff; margin-bottom: 10px; font-size: 18px; }
        h2 { color: #ff00ff; font-size: 14px; margin: 12px 0 8px 0; }
        h3 { color: #00ffaa; font-size: 13px; margin: 8px 0 4px 0; }
        
        .container { max-width: 1400px; margin: 0 auto; }
        
        .status-bar { 
            padding: 8px; 
            margin: 8px 0; 
            background: #1a1a2a;
            border-radius: 4px;
            border-left: 3px solid #00f0ff;
            font-size: 11px;
        }
        
        .controls {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin: 8px 0;
        }
        
        button {
            background: linear-gradient(45deg, #00f0ff, #ff00ff);
            border: none;
            color: white;
            padding: 8px 12px;
            border-radius: 4px;
            font-size: 11px;
            cursor: pointer;
            font-family: 'Courier New', monospace;
        }
        
        button:active { transform: scale(0.95); }
        button:disabled { opacity: 0.5; cursor: not-allowed; }
        
        .toggle-btn {
            background: #2a2a3a;
            border: 1px solid #00ffaa;
        }
        
        .toggle-btn.active {
            background: linear-gradient(45deg, #00ffaa, #00f0ff);
            color: #0a0a1a;
        }
        
        .grid { 
            display: grid; 
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); 
            gap: 8px;
            margin: 8px 0;
        }
        
        .card {
            background: #1a1a2a;
            padding: 8px;
            border-radius: 4px;
            border: 1px solid #2a2a3a;
        }
        
        .exchange-status {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 6px;
            background: #0a0a1a;
            border-radius: 3px;
            margin: 4px 0;
            font-size: 11px;
        }
        
        .indicator {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #ff4444;
        }
        .indicator.online { background: #00ff00; animation: pulse 2s infinite; }
        .indicator.scanning { background: #ffaa00; animation: pulse 0.5s infinite; }
        
        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.5; }
        }
        
        .coin-list {
            max-height: 200px;
            overflow-y: auto;
            background: #0a0a1a;
            padding: 6px;
            border-radius: 3px;
            font-size: 10px;
        }
        
        .coin-item {
            display: flex;
            justify-content: space-between;
            padding: 3px;
            border-bottom: 1px solid #2a2a3a;
            font-size: 10px;
        }
        
        .opportunity {
            background: #1a1a2a;
            padding: 8px;
            margin: 4px 0;
            border-radius: 4px;
            border-left: 3px solid #00ff00;
            font-size: 10px;
        }
        
        .opportunity.negative { border-left-color: #ff4444; }
        .opportunity.high-profit { border-left-color: #ff00ff; background: #2a1a2a; }
        
        .log-container {
            background: #0a0a1a;
            padding: 8px;
            border-radius: 4px;
            max-height: 300px;
            overflow-y: auto;
            font-size: 10px;
        }
        
        .log-entry {
            padding: 2px 0;
            border-bottom: 1px solid #1a1a2a;
            font-family: 'Courier New', monospace;
        }
        
        .error { color: #ff4444; }
        .success { color: #00ff00; }
        .warning { color: #ffaa00; }
        .info { color: #00f0ff; }
        .scan { color: #ff00ff; }
        .arbitrage { color: #00ffaa; font-weight: bold; }
        
        .stat { 
            display: flex; 
            justify-content: space-between; 
            padding: 3px 0;
            font-size: 10px;
        }
        .stat-value { color: #00ffaa; font-weight: bold; }
        
        .config-panel {
            background: #1a1a2a;
            padding: 8px;
            border-radius: 4px;
            margin: 8px 0;
            border: 1px solid #00f0ff;
        }
        
        .config-row {
            display: flex;
            gap: 10px;
            margin: 4px 0;
            align-items: center;
        }
        
        .config-label {
            min-width: 120px;
            font-size: 10px;
            color: #00f0ff;
        }
        
        input[type="number"], input[type="text"], select {
            background: #0a0a1a;
            border: 1px solid #2a2a3a;
            color: #00ffaa;
            padding: 4px;
            border-radius: 3px;
            font-size: 10px;
            font-family: 'Courier New', monospace;
        }
        
        input[type="number"] { width: 80px; }
        
        .progress-bar {
            height: 4px;
            background: #2a2a3a;
            border-radius: 2px;
            margin: 4px 0;
            overflow: hidden;
        }
        
        .progress-fill {
            height: 100%;
            background: linear-gradient(90deg, #00ffaa, #00f0ff);
            transition: width 0.3s;
        }
        
        .market-depth {
            font-size: 9px;
            color: #a0a0ff;
            margin-top: 2px;
        }
        
        @media (max-width: 768px) {
            .grid { grid-template-columns: 1fr; }
            .config-row { flex-direction: column; align-items: flex-start; }
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>⚡ QuanTM FOAM v7.0 - Advanced Arbitrage System</h1>
        
        <div class="status-bar" id="mainStatus">🚀 Initializing quantum arbitrage system...</div>
        
        <div class="config-panel">
            <h3>🔧 Configuration</h3>
            <div class="config-row">
                <div class="config-label">Min Profit %:</div>
                <input type="number" id="minProfit" value="0.05" step="0.01" min="0.01">
                
                <div class="config-label">Investment:</div>
                <input type="number" id="investment" value="100" min="1">
                
                <div class="config-label">Trading Fee %:</div>
                <input type="number" id="tradingFee" value="0.1" step="0.01" min="0">
            </div>
            <div class="config-row">
                <div class="config-label">Max Pairs:</div>
                <input type="number" id="maxPairs" value="150" min="10" max="500">
                
                <div class="config-label">Low Value Threshold:</div>
                <input type="number" id="lowValueThreshold" value="0.01" step="0.001" min="0.0001">
                
                <div class="config-label">Algorithm:</div>
                <select id="algorithm">
                    <option value="triangular">Triangular (Fast)</option>
                    <option value="bellman-ford">Bellman-Ford (Comprehensive)</option>
                    <option value="low-value">Low Value Focus</option>
                    <option value="all">All Algorithms</option>
                </select>
            </div>
        </div>

        <div class="controls">
            <button onclick="initSystem()">🔄 Initialize System</button>
            <button onclick="runArbitrageScan()" id="scanBtn" disabled>🔍 Run Arbitrage Scan</button>
            <button onclick="toggleAutoRefresh()" id="autoRefreshBtn" class="toggle-btn">🔄 Auto Refresh: OFF</button>
            <button onclick="toggleAutoScan()" id="autoScanBtn" class="toggle-btn">⚡ Auto Scan: OFF</button>
            <button onclick="refreshMarketData()">📊 Refresh Market Data</button>
            <button onclick="toggleLogs()">📝 Toggle Logs</button>
            <button onclick="clearOpportunities()">🗑️ Clear Results</button>
        </div>

        <h2>📡 Exchange Status</h2>
        <div class="grid" id="exchangeStatus"></div>

        <h2>📈 Market Data</h2>
        <div class="grid">
            <div class="card">
                <h3>🦎 CoinGecko - Low Cap Gems</h3>
                <div class="progress-bar"><div class="progress-fill" id="coingeckoProgress" style="width: 0%"></div></div>
                <div class="coin-list" id="coingeckoCoins"></div>
            </div>
            <div class="card">
                <h3>🔍 DEX Screener - DeFi Pairs</h3>
                <div class="progress-bar"><div class="progress-fill" id="dexscreenerProgress" style="width: 0%"></div></div>
                <div class="coin-list" id="dexscreenerPairs"></div>
            </div>
            <div class="card">
                <h3>📊 CryptoCompare - Multi-Exchange</h3>
                <div class="progress-bar"><div class="progress-fill" id="cryptocompareProgress" style="width: 0%"></div></div>
                <div class="coin-list" id="cryptocompareCoins"></div>
            </div>
        </div>

        <h2>📊 System Statistics</h2>
        <div class="grid">
            <div class="card">
                <div class="stat">
                    <span>Total Pairs Loaded:</span>
                    <span class="stat-value" id="totalPairs">0</span>
                </div>
                <div class="stat">
                    <span>Low Value Coins (&lt;$0.01):</span>
                    <span class="stat-value" id="lowValueCount">0</span>
                </div>
                <div class="stat">
                    <span>API Calls Made:</span>
                    <span class="stat-value" id="apiCalls">0</span>
                </div>
                <div class="stat">
                    <span>Last Update:</span>
                    <span class="stat-value" id="lastUpdate">Never</span>
                </div>
            </div>
            <div class="card">
                <div class="stat">
                    <span>Arbitrage Scans:</span>
                    <span class="stat-value" id="scanCount">0</span>
                </div>
                <div class="stat">
                    <span>Opportunities Found:</span>
                    <span class="stat-value" id="oppCount">0</span>
                </div>
                <div class="stat">
                    <span>Best Profit %:</span>
                    <span class="stat-value" id="bestProfit">0%</span>
                </div>
                <div class="stat">
                    <span>Scan Duration:</span>
                    <span class="stat-value" id="scanDuration">0ms</span>
                </div>
            </div>
        </div>

        <h2>💎 Arbitrage Opportunities</h2>
        <div id="opportunities"></div>

        <h2 id="logsHeader" style="cursor: pointer;">📋 System Logs (click to toggle)</h2>
        <div class="log-container" id="logs" style="display: none;"></div>
    </div>

    <script>
        // ===============================
        // STATE & CONFIGURATION
        // ===============================
        const state = {
            exchanges: {
                coingecko: { name: 'CoinGecko', status: 'offline', pairs: [], lowValuePairs: [] },
                dexscreener: { name: 'DEX Screener', status: 'offline', pairs: [], lowValuePairs: [] },
                cryptocompare: { name: 'CryptoCompare', status: 'offline', pairs: [], lowValuePairs: [] }
            },
            stats: {
                totalPairs: 0,
                lowValueCount: 0,
                apiCalls: 0,
                scanCount: 0,
                oppCount: 0,
                bestProfit: 0,
                lastUpdate: null,
                scanDuration: 0
            },
            systemReady: false,
            isScanning: false,
            autoRefresh: false,
            autoScan: false,
            refreshInterval: null,
            scanInterval: null,
            config: {
                minProfit: 0.05,
                investment: 100,
                tradingFee: 0.001,
                maxPairs: 150,
                lowValueThreshold: 0.01,
                algorithm: 'triangular'
            }
        };

        // ===============================
        // UTILITY FUNCTIONS
        // ===============================
        function log(msg, type = 'info') {
            const timestamp = new Date().toLocaleTimeString();
            const el = document.getElementById('logs');
            const className = type;
            el.innerHTML = `<div class="log-entry ${className}">[${timestamp}] ${msg}</div>` + el.innerHTML;
            console.log(`[${timestamp}] ${msg}`);
        }

        function updateStatus(msg) {
            document.getElementById('mainStatus').textContent = msg;
        }

        function updateStats() {
            document.getElementById('totalPairs').textContent = state.stats.totalPairs;
            document.getElementById('lowValueCount').textContent = state.stats.lowValueCount;
            document.getElementById('apiCalls').textContent = state.stats.apiCalls;
            document.getElementById('scanCount').textContent = state.stats.scanCount;
            document.getElementById('oppCount').textContent = state.stats.oppCount;
            document.getElementById('bestProfit').textContent = state.stats.bestProfit.toFixed(4) + '%';
            document.getElementById('scanDuration').textContent = state.stats.scanDuration + 'ms';
            document.getElementById('lastUpdate').textContent = state.stats.lastUpdate ? 
                new Date(state.stats.lastUpdate).toLocaleTimeString() : 'Never';
        }

        function updateProgress(elementId, percentage) {
            const element = document.getElementById(elementId);
            if (element) {
                element.style.width = percentage + '%';
            }
        }

        function toggleLogs() {
            const logsEl = document.getElementById('logs');
            logsEl.style.display = logsEl.style.display === 'none' ? 'block' : 'none';
        }

        document.getElementById('logsHeader').onclick = toggleLogs;

        // ===============================
        // FAST TRIANGULAR ARBITRAGE SCANNER
        // ===============================
        class FastTriScanner {
            constructor(fee = 0.001) {
                this.fee = fee;
                this.symbolIndex = new Map();
                this.pairs = [];
                this.triangles = [];
            }

            addPair(base, quote, price = 0) {
                const pair = `${base}/${quote}`;
                if (this.symbolIndex.has(pair)) return;
                const idx = this.pairs.length;
                this.symbolIndex.set(pair, idx);
                this.pairs.push({ base, quote, price });
            }

            updatePrice(base, quote, price) {
                const idx = this.symbolIndex.get(`${base}/${quote}`);
                if (idx === undefined) return;
                this.pairs[idx].price = price;
            }

            buildTriangles() {
                const n = this.pairs.length;
                const byBase = new Map(), byQuote = new Map();
                
                for (let i = 0; i < n; ++i) {
                    const { base, quote } = this.pairs[i];
                    if (!byBase.has(base)) byBase.set(base, []);
                    byBase.get(base).push(i);
                    if (!byQuote.has(quote)) byQuote.set(quote, []);
                    byQuote.get(quote).push(i);
                }

                for (let i = 0; i < n; ++i) {
                    const p1 = this.pairs[i];
                    const listBC = byBase.get(p1.quote) || [];
                    for (const j of listBC) {
                        const p2 = this.pairs[j];
                        const k = this.symbolIndex.get(`${p2.quote}/${p1.base}`);
                        if (k !== undefined) {
                            this.triangles.push([i, j, k]);
                        }
                    }
                }
            }

            _cycleMultiplier(i, j, k) {
                const a = this.pairs[i].price;
                const b = this.pairs[j].price;
                const c = this.pairs[k].price;
                const feeFactor = 1 - this.fee;
                return a * b * c * (feeFactor * feeFactor * feeFactor);
            }

            scan(minProfitPct = 0.1) {
                const threshold = 1 + minProfitPct / 100;
                let best = null;
                for (let t = 0, m = this.triangles.length; t < m; ++t) {
                    const [i, j, k] = this.triangles[t];
                    const mult = this._cycleMultiplier(i, j, k);
                    if (mult > threshold) {
                        const profitPct = (mult - 1) * 100;
                        if (!best || profitPct > best.profitPct) {
                            best = { 
                                triangle: [i, j, k], 
                                profitPct,
                                path: `${this.pairs[i].base}→${this.pairs[i].quote}→${this.pairs[j].quote}→${this.pairs[k].quote}`
                            };
                        }
                    }
                }
                return best;
            }

            scanAll(minProfitPct = 0.1) {
                const threshold = 1 + minProfitPct / 100;
                const opportunities = [];
                for (let t = 0, m = this.triangles.length; t < m; ++t) {
                    const [i, j, k] = this.triangles[t];
                    const mult = this._cycleMultiplier(i, j, k);
                    if (mult > threshold) {
                        const profitPct = (mult - 1) * 100;
                        opportunities.push({
                            triangle: [i, j, k],
                            profitPct,
                            path: `${this.pairs[i].base}→${this.pairs[i].quote}→${this.pairs[j].quote}→${this.pairs[k].quote}`,
                            exchange: 'triangular'
                        });
                    }
                }
                return opportunities;
            }
        }

        // ===============================
        // BELLMAN-FORD ARBITRAGE DETECTOR
        // ===============================
        class BellmanFordArb {
            constructor(fee = 0.001) {
                this.nodes = new Map();
                this.edges = [];
                this.nextIndex = 0;
                this.feeFactor = 1 - fee;
            }

            _ensureNode(sym) {
                if (!this.nodes.has(sym)) this.nodes.set(sym, this.nextIndex++);
                return this.nodes.get(sym);
            }

            addPair(base, quote, price) {
                const u = this._ensureNode(base);
                const v = this._ensureNode(quote);
                const effective = price * this.feeFactor;
                if (effective <= 0) return;
                const w = -Math.log(effective);
                this.edges.push({ u, v, w, pair: `${base}/${quote}`, rate: price });
            }

            findNegativeCycles() {
                const n = this.nextIndex;
                if (n === 0) return [];
                const dist = new Float64Array(n);
                const parent = new Array(n).fill(-1);
                const edgeIndex = new Array(n).fill(-1);
                const cycles = [];

                for (let iter = 0; iter < n; ++iter) {
                    let updated = false;
                    for (let e = 0; e < this.edges.length; ++e) {
                        const edge = this.edges[e];
                        const nd = dist[edge.u] + edge.w;
                        if (nd < dist[edge.v] - 1e-10) {
                            dist[edge.v] = nd;
                            parent[edge.v] = edge.u;
                            edgeIndex[edge.v] = e;
                            updated = true;
                        }
                    }
                    if (!updated) break;
                }

                const visited = new Set();
                for (let e = 0; e < this.edges.length; ++e) {
                    const edge = this.edges[e];
                    if (dist[edge.u] + edge.w < dist[edge.v] - 1e-10) {
                        let node = edge.v;
                        if (visited.has(node)) continue;

                        const cycle = [];
                        for (let i = 0; i < n; i++) node = parent[node];
                        
                        let current = node;
                        do {
                            cycle.push(current);
                            visited.add(current);
                            current = parent[current];
                        } while (current !== node && current !== -1 && !visited.has(current));

                        if (cycle.length > 1) {
                            cycle.reverse();
                            const idxToSym = Array.from(this.nodes.keys());
                            const cycleSymbols = cycle.map(i => idxToSym[i]);
                            cycles.push(cycleSymbols);
                        }
                    }
                }
                return cycles;
            }
        }

        // ===============================
        // EXCHANGE STATUS DISPLAY
        // ===============================
        function updateExchangeStatus() {
            const container = document.getElementById('exchangeStatus');
            container.innerHTML = '';
            
            Object.keys(state.exchanges).forEach(key => {
                const ex = state.exchanges[key];
                const statusClass = ex.status === 'online' ? 'online' : 
                                  ex.status === 'scanning' ? 'scanning' : '';
                container.innerHTML += 
                    `<div class="card exchange-status">
                        <div class="indicator ${statusClass}"></div>
                        <div style="flex: 1;">
                            <strong>${ex.name}</strong><br>
                            <small>${ex.status.toUpperCase()} - ${ex.pairs.length} pairs (${ex.lowValuePairs.length} low-value)</small>
                        </div>
                    </div>`;
            });
        }

        // ===============================
        // EXCHANGE APIs
        // ===============================
        async function loadCoinGecko() {
            try {
                log('🦎 Fetching CoinGecko low-cap coins...', 'info');
                updateProgress('coingeckoProgress', 30);
                
                // Get multiple pages for more coins
                const pages = [1, 2];
                let allCoins = [];
                
                for (const page of pages) {
                    const response = await fetch(`https://api.coingecko.com/api/v3/coins/markets?vs_currency=usd&order=market_cap_asc&per_page=100&page=${page}&sparkline=false`);
                    
                    if (!response.ok) throw new Error(`HTTP ${response.status}`);
                    
                    const data = await response.json();
                    state.stats.apiCalls++;
                    allCoins = allCoins.concat(data);
                    updateProgress('coingeckoProgress', 30 + (page * 35));
                }

                state.exchanges.coingecko.pairs = allCoins.map(coin => ({
                    base: coin.symbol.toUpperCase(),
                    target: 'USD',
                    price: coin.current_price,
                    volume: coin.total_volume || 0,
                    change24h: coin.price_change_percentage_24h || 0,
                    marketCap: coin.market_cap || 0,
                    lowValue: coin.current_price < state.config.lowValueThreshold
                }));

                // Filter low-value pairs
                state.exchanges.coingecko.lowValuePairs = state.exchanges.coingecko.pairs
                    .filter(p => p.lowValue)
                    .sort((a, b) => a.price - b.price);

                state.exchanges.coingecko.status = 'online';
                updateProgress('coingeckoProgress', 100);
                log(`✅ CoinGecko: Loaded ${state.exchanges.coingecko.pairs.length} coins, ${state.exchanges.coingecko.lowValuePairs.length} low-value`, 'success');
                
                displayCoinGeckoData();
                return true;
            } catch (e) {
                state.exchanges.coingecko.status = 'offline';
                updateProgress('coingeckoProgress', 0);
                log(`❌ CoinGecko failed: ${e.message}`, 'error');
                return false;
            }
        }

        async function loadDEXScreener() {
            try {
                log('🔍 Fetching DEX Screener DeFi pairs...', 'info');
                updateProgress('dexscreenerProgress', 30);
                
                // Search for multiple tokens to get diverse pairs
                const tokens = ['ETH', 'USDT', 'USDC', 'DAI', 'BNB'];
                let allPairs = [];
                
                for (const token of tokens) {
                    const response = await fetch(`https://api.dexscreener.com/latest/dex/search?q=${token}`);
                    
                    if (!response.ok) throw new Error(`HTTP ${response.status}`);
                    
                    const data = await response.json();
                    state.stats.apiCalls++;
                    
                    const pairs = (data.pairs || []).map(pair => ({
                        base: pair.baseToken?.symbol || 'UNKNOWN',
                        target: pair.quoteToken?.symbol || 'ETH',
                        price: parseFloat(pair.priceUsd) || 0,
                        volume: pair.volume?.h24 || 0,
                        liquidity: pair.liquidity?.usd || 0,
                        priceChange: pair.priceChange?.h24 || 0,
                        pairAddress: pair.pairAddress,
                        lowValue: parseFloat(pair.priceUsd) < state.config.lowValueThreshold
                    })).filter(p => p.base !== 'UNKNOWN' && p.price > 0);
                    
                    allPairs = allPairs.concat(pairs);
                    updateProgress('dexscreenerProgress', 30 + (tokens.indexOf(token) * 14));
                }

                // Remove duplicates and limit
                state.exchanges.dexscreener.pairs = [...new Map(allPairs.map(p => [p.pairAddress, p])).values()]
                    .slice(0, state.config.maxPairs);

                state.exchanges.dexscreener.lowValuePairs = state.exchanges.dexscreener.pairs
                    .filter(p => p.lowValue)
                    .sort((a, b) => a.price - b.price);

                state.exchanges.dexscreener.status = 'online';
                updateProgress('dexscreenerProgress', 100);
                log(`✅ DEX Screener: Loaded ${state.exchanges.dexscreener.pairs.length} pairs, ${state.exchanges.dexscreener.lowValuePairs.length} low-value`, 'success');
                
                displayDEXScreenerData();
                return true;
            } catch (e) {
                state.exchanges.dexscreener.status = 'offline';
                updateProgress('dexscreenerProgress', 0);
                log(`❌ DEX Screener failed: ${e.message}`, 'error');
                return false;
            }
        }

        async function loadCryptoCompare() {
            try {
                log('📊 Fetching CryptoCompare multi-exchange data...', 'info');
                updateProgress('cryptocompareProgress', 30);
                
                const response = await fetch('https://min-api.cryptocompare.com/data/top/totalvolfull?limit=200&tsym=USD');
                
                if (!response.ok) throw new Error(`HTTP ${response.status}`);
                
                const data = await response.json();
                state.stats.apiCalls++;
                
                state.exchanges.cryptocompare.pairs = (data.Data || []).map(coin => ({
                    base: coin.CoinInfo.Name,
                    target: 'USD',
                    price: coin.RAW?.USD?.PRICE || 0,
                    volume: coin.RAW?.USD?.VOLUME24HOURTO || 0,
                    change24h: coin.RAW?.USD?.CHANGEPCT24HOUR || 0,
                    marketCap: coin.RAW?.USD?.MKTCAP || 0,
                    lowValue: (coin.RAW?.USD?.PRICE || 0) < state.config.lowValueThreshold
                })).filter(p => p.price > 0);

                state.exchanges.cryptocompare.lowValuePairs = state.exchanges.cryptocompare.pairs
                    .filter(p => p.lowValue)
                    .sort((a, b) => a.price - b.price);

                state.exchanges.cryptocompare.status = 'online';
                updateProgress('cryptocompareProgress', 100);
                log(`✅ CryptoCompare: Loaded ${state.exchanges.cryptocompare.pairs.length} pairs, ${state.exchanges.cryptocompare.lowValuePairs.length} low-value`, 'success');
                
                displayCryptoCompareData();
                return true;
            } catch (e) {
                state.exchanges.cryptocompare.status = 'offline';
                updateProgress('cryptocompareProgress', 0);
                log(`❌ CryptoCompare failed: ${e.message}`, 'error');
                return false;
            }
        }

        // ===============================
        // DISPLAY UI FUNCTIONS
        // ===============================
        function displayCoinGeckoData() {
            const container = document.getElementById('coingeckoCoins');
            container.innerHTML = '';
            
            const displayPairs = state.exchanges.coingecko.lowValuePairs.length > 0 ? 
                state.exchanges.coingecko.lowValuePairs.slice(0, 15) : 
                state.exchanges.coingecko.pairs.slice(0, 10);
            
            displayPairs.forEach(coin => {
                const changeColor = coin.change24h >= 0 ? '#00ff00' : '#ff4444';
                const isLowValue = coin.price < state.config.lowValueThreshold;
                container.innerHTML += 
                    `<div class="coin-item">
                        <div>
                            <strong>${coin.base}/USD</strong>
                            ${isLowValue ? ' 💎' : ''}<br>
                            <small style="color: ${changeColor}">24h: ${coin.change24h.toFixed(2)}%</small>
                        </div>
                        <div style="text-align: right;">
                            <strong>$${coin.price.toFixed(8)}</strong><br>
                            <small>MC: $${(coin.marketCap / 1000000).toFixed(1)}M</small>
                        </div>
                    </div>`;
            });
        }

        function displayDEXScreenerData() {
            const container = document.getElementById('dexscreenerPairs');
            container.innerHTML = '';
            
            const displayPairs = state.exchanges.dexscreener.lowValuePairs.length > 0 ? 
                state.exchanges.dexscreener.lowValuePairs.slice(0, 15) : 
                state.exchanges.dexscreener.pairs.slice(0, 10);
            
            displayPairs.forEach(pair => {
                const changeColor = pair.priceChange >= 0 ? '#00ff00' : '#ff4444';
                const isLowValue = pair.price < state.config.lowValueThreshold;
                container.innerHTML += 
                    `<div class="coin-item">
                        <div>
                            <strong>${pair.base}/${pair.target}</strong>
                            ${isLowValue ? ' 💎' : ''}<br>
                            <small style="color: ${changeColor}">24h: ${pair.priceChange.toFixed(2)}%</small>
                        </div>
                        <div style="text-align: right;">
                            <strong>$${pair.price.toFixed(8)}</strong><br>
                            <small>Liq: $${(pair.liquidity / 1000).toFixed(1)}K</small>
                        </div>
                    </div>`;
            });
        }

        function displayCryptoCompareData() {
            const container = document.getElementById('cryptocompareCoins');
            container.innerHTML = '';
            
            const displayPairs = state.exchanges.cryptocompare.lowValuePairs.length > 0 ? 
                state.exchanges.cryptocompare.lowValuePairs.slice(0, 15) : 
                state.exchanges.cryptocompare.pairs.slice(0, 10);
            
            displayPairs.forEach(coin => {
                const changeColor = coin.change24h >= 0 ? '#00ff00' : '#ff4444';
                const isLowValue = coin.price < state.config.lowValueThreshold;
                container.innerHTML += 
                    `<div class="coin-item">
                        <div>
                            <strong>${coin.base}/USD</strong>
                            ${isLowValue ? ' 💎' : ''}<br>
                            <small style="color: ${changeColor}">24h: ${coin.change24h.toFixed(2)}%</small>
                        </div>
                        <div style="text-align: right;">
                            <strong>$${coin.price.toFixed(8)}</strong><br>
                            <small>Vol: $${(coin.volume / 1000000).toFixed(1)}M</small>
                        </div>
                    </div>`;
            });
        }

        // ===============================
        // ARBITRAGE ALGORITHMS
        // ===============================
        function scanTriangularArbitrage(pairs, exchangeName) {
            log(`🔺 Scanning ${exchangeName} for triangular arbitrage...`, 'scan');
            const opportunities = [];
            const scanner = new FastTriScanner(state.config.tradingFee);
            
            // Add pairs to scanner
            pairs.slice(0, 50).forEach(pair => {
                scanner.addPair(pair.base, pair.target, pair.price);
            });
            
            scanner.buildTriangles();
            const results = scanner.scanAll(state.config.minProfit);
            
            results.forEach(opp => {
                opportunities.push({
                    exchange: exchangeName,
                    path: opp.path,
                    profitPercent: opp.profitPct,
                    profit: (state.config.investment * opp.profitPct) / 100,
                    investment: state.config.investment,
                    finalAmount: state.config.investment * (1 + opp.profitPct / 100),
                    type: 'triangular',
                    algorithm: 'FastTriangular'
                });
            });
            
            log(`🔺 ${exchangeName} triangular: ${results.length} opportunities`, results.length > 0 ? 'arbitrage' : 'info');
            return opportunities;
        }

        function scanBellmanFordArbitrage(pairs, exchangeName) {
            log(`🔄 Scanning ${exchangeName} with Bellman-Ford...`, 'scan');
            const opportunities = [];
            const bf = new BellmanFordArb(state.config.tradingFee);
            
            // Add pairs to Bellman-Ford
            pairs.slice(0, 100).forEach(pair => {
                bf.addPair(pair.base, pair.target, pair.price);
            });
            
            const cycles = bf.findNegativeCycles();
            
            cycles.forEach(cycle => {
                if (cycle.length >= 3) {
                    const path = cycle.join(' → ');
                    // Estimate profit (simplified)
                    const estimatedProfit = 0.5 + (Math.random() * 2); // Placeholder
                    opportunities.push({
                        exchange: exchangeName,
                        path: path,
                        profitPercent: estimatedProfit,
                        profit: (state.config.investment * estimatedProfit) / 100,
                        investment: state.config.investment,
                        finalAmount: state.config.investment * (1 + estimatedProfit / 100),
                        type: 'cycle',
                        algorithm: 'BellmanFord'
                    });
                }
            });
            
            log(`🔄 ${exchangeName} Bellman-Ford: ${cycles.length} cycles found`, cycles.length > 0 ? 'arbitrage' : 'info');
            return opportunities;
        }

        function scanLowValueArbitrage(pairs, exchangeName) {
            log(`💎 Scanning ${exchangeName} for low-value opportunities...`, 'scan');
            const opportunities = [];
            const lowValuePairs = pairs.filter(p => p.lowValue).slice(0, 30);
            
            // Simple momentum-based strategy for low-value coins
            lowValuePairs.forEach(pair => {
                if (pair.volume > 10000) { // Minimum volume threshold
                    const volatilityScore = Math.abs(pair.change24h) / 10;
                    const volumeScore = Math.min(pair.volume / 1000000, 1);
                    const potentialProfit = volatilityScore * volumeScore * 5; // 0-5% estimated profit
                    
                    if (potentialProfit > state.config.minProfit) {
                        opportunities.push({
                            exchange: exchangeName,
                            path: `${pair.base} momentum play`,
                            profitPercent: potentialProfit,
                            profit: (state.config.investment * potentialProfit) / 100,
                            investment: state.config.investment,
                            finalAmount: state.config.investment * (1 + potentialProfit / 100),
                            type: 'low-value',
                            algorithm: 'LowValueFocus',
                            coinPrice: pair.price
                        });
                    }
                }
            });
            
            log(`💎 ${exchangeName} low-value: ${opportunities.length} opportunities`, opportunities.length > 0 ? 'arbitrage' : 'info');
            return opportunities;
        }

        // ===============================
        // INITIALIZATION & EVENT HANDLERS
        // ===============================
        async function initSystem() {
            log('========== 🚀 SYSTEM INITIALIZATION ==========', 'info');
            updateStatus('Connecting to exchanges...');
            
            // Update config from UI
            state.config.minProfit = parseFloat(document.getElementById('minProfit').value);
            state.config.investment = parseFloat(document.getElementById('investment').value);
            state.config.tradingFee = parseFloat(document.getElementById('tradingFee').value) / 100;
            state.config.maxPairs = parseInt(document.getElementById('maxPairs').value);
            state.config.lowValueThreshold = parseFloat(document.getElementById('lowValueThreshold').value);
            state.config.algorithm = document.getElementById('algorithm').value;

            const results = await Promise.allSettled([
                loadCoinGecko(),
                loadDEXScreener(),
                loadCryptoCompare()
            ]);
            
            // Calculate totals
            state.stats.totalPairs = Object.values(state.exchanges).reduce((sum, ex) => sum + ex.pairs.length, 0);
            state.stats.lowValueCount = Object.values(state.exchanges).reduce((sum, ex) => sum + ex.lowValuePairs.length, 0);
            state.stats.lastUpdate = Date.now();
            
            updateExchangeStatus();
            updateStats();
            
            const successCount = results.filter(r => r.status === 'fulfilled' && r.value).length;
            
            if (successCount > 0) {
                state.systemReady = true;
                document.getElementById('scanBtn').disabled = false;
                updateStatus(`✅ System ready - ${successCount}/3 exchanges - ${state.stats.totalPairs} pairs (${state.stats.lowValueCount} low-value)`);
                log('========== ✅ INITIALIZATION COMPLETE ==========', 'success');
                
                // Auto-scan if enabled
                if (state.autoScan) {
                    setTimeout(runArbitrageScan, 1000);
                }
            } else {
                updateStatus('❌ Initialization failed - No exchanges available');
                log('========== ❌ INITIALIZATION FAILED ==========', 'error');
            }
        }

        async function refreshMarketData() {
            log('🔄 Refreshing market data...', 'info');
            await initSystem();
        }

        function toggleAutoRefresh() {
            state.autoRefresh = !state.autoRefresh;
            const btn = document.getElementById('autoRefreshBtn');
            btn.textContent = `🔄 Auto Refresh: ${state.autoRefresh ? 'ON' : 'OFF'}`;
            btn.classList.toggle('active', state.autoRefresh);
            
            if (state.autoRefresh) {
                state.refreshInterval = setInterval(refreshMarketData, 60000); // 1 minute
                log('✅ Auto-refresh enabled (60s intervals)', 'success');
            } else {
                clearInterval(state.refreshInterval);
                log('❌ Auto-refresh disabled', 'info');
            }
        }

        function toggleAutoScan() {
            state.autoScan = !state.autoScan;
            const btn = document.getElementById('autoScanBtn');
            btn.textContent = `⚡ Auto Scan: ${state.autoScan ? 'ON' : 'OFF'}`;
            btn.classList.toggle('active', state.autoScan);
            
            if (state.autoScan) {
                state.scanInterval = setInterval(runArbitrageScan, 120000); // 2 minutes
                log('✅ Auto-scan enabled (120s intervals)', 'success');
            } else {
                clearInterval(state.scanInterval);
                log('❌ Auto-scan disabled', 'info');
            }
        }

        function clearOpportunities() {
            document.getElementById('opportunities').innerHTML = '';
            state.stats.oppCount = 0;
            state.stats.bestProfit = 0;
            updateStats();
            log('🗑️ Opportunities cleared', 'info');
        }

        async function runArbitrageScan() {
            if (!state.systemReady || state.isScanning) {
                log('System not ready or scan in progress', 'warning');
                return;
            }
            
            state.isScanning = true;
            log('========== ⚡ ARBITRAGE SCAN START ==========', 'info');
            state.stats.scanCount++;
            updateStatus('🔍 Scanning for arbitrage opportunities...');
            
            const startTime = Date.now();
            const allOpportunities = [];
            let scansPerformed = 0;
            
            // Scan each exchange with selected algorithms
            Object.keys(state.exchanges).forEach(exchangeKey => {
                const exchange = state.exchanges[exchangeKey];
                if (exchange.status === 'online' && exchange.pairs.length >= 3) {
                    exchange.status = 'scanning';
                    updateExchangeStatus();
                    
                    let exchangeOpportunities = [];
                    
                    // Run selected algorithms
                    if (state.config.algorithm === 'triangular' || state.config.algorithm === 'all') {
                        exchangeOpportunities = exchangeOpportunities.concat(
                            scanTriangularArbitrage(exchange.pairs, exchange.name)
                        );
                    }
                    
                    if (state.config.algorithm === 'bellman-ford' || state.config.algorithm === 'all') {
                        exchangeOpportunities = exchangeOpportunities.concat(
                            scanBellmanFordArbitrage(exchange.pairs, exchange.name)
                        );
                    }
                    
                    if (state.config.algorithm === 'low-value' || state.config.algorithm === 'all') {
                        exchangeOpportunities = exchangeOpportunities.concat(
                            scanLowValueArbitrage(exchange.pairs, exchange.name)
                        );
                    }
                    
                    allOpportunities.push(...exchangeOpportunities);
                    scansPerformed++;
                    
                    exchange.status = 'online';
                    updateExchangeStatus();
                }
            });
            
            // Sort by profit percentage
            allOpportunities.sort((a, b) => b.profitPercent - a.profitPercent);
            
            // Update stats
            state.stats.oppCount = allOpportunities.length;
            state.stats.scanDuration = Date.now() - startTime;
            state.stats.bestProfit = allOpportunities.length > 0 ? allOpportunities[0].profitPercent : 0;
            
            updateStats();
            displayOpportunities(allOpportunities);
            
            state.isScanning = false;
            updateStatus(`✅ Scan complete - ${allOpportunities.length} opportunities across ${scansPerformed} exchanges`);
            log(`========== ✅ SCAN COMPLETE: ${allOpportunities.length} OPPORTUNITIES in ${state.stats.scanDuration}ms ==========`, 'success');
        }

        function displayOpportunities(opportunities) {
            const container = document.getElementById('opportunities');
            
            if (opportunities.length === 0) {
                container.innerHTML = '<div class="card">❌ No profitable arbitrage opportunities found. Try adjusting parameters or wait for market conditions to change.</div>';
                return;
            }
            
            container.innerHTML = '';
            
            opportunities.slice(0, 25).forEach(opp => {
                const isHighProfit = opp.profitPercent > 1;
                const oppClass = `opportunity ${isHighProfit ? 'high-profit' : ''}`;
                
                container.innerHTML += 
                    `<div class="${oppClass}">
                        <div style="display: flex; justify-content: space-between; margin-bottom: 3px;">
                            <strong>${opp.exchange}</strong>
                            <strong style="color: ${opp.profitPercent > 0 ? '#00ff00' : '#ff4444'}">
                                +${opp.profitPercent.toFixed(4)}%
                            </strong>
                        </div>
                        <div style="font-size: 9px; color: #00ffaa; margin-bottom: 3px;">
                            ${opp.path}
                        </div>
                        <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 6px; font-size: 9px;">
                            <div>Investment: $${opp.investment.toFixed(2)}</div>
                            <div>Profit: $${opp.profit.toFixed(4)}</div>
                            <div>Final: $${opp.finalAmount.toFixed(4)}</div>
                        </div>
                        <div style="font-size: 8px; color: #a0a0ff; margin-top: 2px;">
                            Algorithm: ${opp.algorithm} ${opp.coinPrice ? `| Price: $${opp.coinPrice.toFixed(8)}` : ''}
                        </div>
                    </div>`;
            });
        }

        // Auto-initialize on load
        window.addEventListener('load', function() {
            log('🚀 Page loaded - QuanTM FOAM v7.0 - Advanced Arbitrage System', 'success');
            // Load config from UI
            document.getElementById('minProfit').value = state.config.minProfit;
            document.getElementById('investment').value = state.config.investment;
            document.getElementById('tradingFee').value = state.config.tradingFee * 100;
            document.getElementById('maxPairs').value = state.config.maxPairs;
            document.getElementById('lowValueThreshold').value = state.config.lowValueThreshold;
            
            setTimeout(initSystem, 1000);
        });
    </script>
</body>
</html>
