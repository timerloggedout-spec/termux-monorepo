// services/sheets.js
import Papa from 'papaparse';

// Option 1: Direct Google Sheets published CSV
const SHEET_CSV_URL = 'https://docs.google.com/spreadsheets/d/e/.../pub?output=csv';

// Option 2: Sheety API (recommended)
const SHEETY_URL = 'https://api.sheety.co/YOUR_PROJECT_ID/compounds';

export async function fetchCompoundsFromSheet() {
  // Using Sheety
  const response = await fetch(SHEETY_URL);
  const json = await response.json();
  // Sheety returns { compounds: [...] }
  return json.compounds.map(transformRawCompound);
}

// Fallback: parse published CSV
export async function fetchCompoundsFromCSV() {
  const response = await fetch(SHEET_CSV_URL);
  const csvText = await response.text();
  return new Promise((resolve, reject) => {
    Papa.parse(csvText, {
      header: true,
      skipEmptyLines: true,
      complete: (result) => resolve(result.data.map(transformRawCompound)),
      error: reject,
    });
  });
}

// Normalize field names to match our internal model
function transformRawCompound(raw) {
  return {
    id: raw.Entity_ID,
    name: raw.Canonical_Name,
    synonyms: raw.Synonyms,
    type: raw.Entity_Type,
    modality: raw.Modality,
    mechanism: raw.Mechanism_Summary,
    stage: raw.Development_Stage_Global,
    usStatus: raw.US_FDA_Status,
    usAccess: raw.US_Legal_Access,
    usNotes: raw.US_Notes,
    euStatus: raw.EU_EMA_Status,
    euAccess: raw.EU_Legal_Access,
    euNotes: raw.EU_Notes,
    caStatus: raw.CA_HealthCanada_Status,
    caAccess: raw.CA_Legal_Access,
    caNotes: raw.CA_Notes,
    auStatus: raw.AU_TGA_Status,
    auAccess: raw.AU_Legal_Access,
    auNotes: raw.AU_Notes,
    ukStatus: raw.UK_MHRA_Status,
    ukAccess: raw.UK_Legal_Access,
    ukNotes: raw.UK_Notes,
    jpStatus: raw.JP_PMDA_Status,
    jpAccess: raw.JP_Legal_Access,
    jpNotes: raw.JP_Notes,
    ruStatus: raw.RU_Status,
    ruAccess: raw.RU_Legal_Access,
    ruNotes: raw.RU_Notes,
    wadaStatus: raw.WADA_Status,
    wadaCategory: raw.WADA_Category,
    wadaInCompetition: raw.WADA_In_Competition === 'TRUE',
    wadaOutCompetition: raw.WADA_Out_Competition === 'TRUE',
    keyRisks: raw.Key_Regulatory_Risks,
    lastVerified: raw.Last_Verified,
  };
}
