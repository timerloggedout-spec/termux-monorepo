function scanTriangular(minProfit) {
  const opps = [];
  
  for (let t = 0; t < state.triangles.length; t++) {
    const triangle = state.triangles[t];
    const A = triangle[0];
    const B = triangle[1];
    const C = triangle[2];
    
    const e1 = state.graph[A] ? state.graph[A][B] : null;
    const e2 = state.graph[B] ? state.graph[B][C] : null;
    const e3 = state.graph[C] ? state.graph[C][A] : null;
    
    if (!e1 || !e2 || !e3) continue;
    
    const product = e1.rate * e2.rate * e3.rate;
    const profitPct = (product - 1) * 100;
    const minLiq = Math.min(e1.liquidity, e2.liquidity, e3.liquidity);
    
    if (profitPct >= minProfit) {
      opps.push({
        type: 'triangular',
        path: [A, B, C, A],
        product: product,
        minLiquidity: minLiq,
        edges: [e1, e2, e3]
      });
    }
  }
  
  return opps;
}
