/* Add to <style> */
.slot-reels {
    display: flex;
    justify-content: center;
    gap: 15px;
    margin: 20px 0;
}
.reel {
    width: 100px;
    height: 120px;
    background: #000;
    border: 3px solid var(--pink);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 32px;
    color: var(--pink);
    text-shadow: 0 0 15px var(--pink);
    overflow: hidden;
    position: relative;
}
.reel div {
    position: absolute;
    width: 100%;
    text-align: center;
    transition: top 0.1s linear;
}
