// After compounds load, build Fuse index
const fuse = new Fuse(compounds, {
  keys: ['Canonical_Name', 'Synonyms', 'Entity_ID'],
  threshold: 0.4,        // 0.0 = exact, 1.0 = matches anything
  includeScore: true,
  includeMatches: true
});

// In render, instead of manual filter:
const fuseResults = search ? fuse.search(search) : compounds.map(c => ({ item: c }));
const filtered = fuseResults.map(r => r.item);
