document.getElementById('rollDice').addEventListener('click', () => {
    const bet = parseInt(document.getElementById('diceBet').value);
    if (bet > STATE.user.qBucks) {
        showMessage('Insufficient Q-Bucks', 'You do not have enough Q-Bucks for this bet.');
        return;
    }
    
    // Deduct the bet
    STATE.user.qBucks -= bet;
    
    // Roll the dice (1-6)
    const roll = Math.floor(Math.random() * 6) + 1;
    document.getElementById('diceResult').textContent = roll;
    
    // Determine win or loss
    let outcome;
    if (roll >= 4) {
        // Win: double the bet
        outcome = bet * 2;
        STATE.user.qBucks += outcome;
        showMessage('Dice Roll Win!', `You rolled a ${roll} and won ${outcome} Q-Bucks!`);
    } else {
        // Loss
        outcome = -bet;
        showMessage('Dice Roll Loss', `You rolled a ${roll} and lost ${bet} Q-Bucks.`);
    }
    
    // Add points regardless of win or loss
    addPoints(Math.abs(bet) / 10);
    
    // Update UI
    DB.set('user', STATE.user);
    updateUI();
});
