findRate(fromCurrency, toCurrency, pairs) {
    for (const pair of pairs) {
        if (pair.base === fromCurrency) {
            const quoteCurrency = pair.target.split('/')[1];
            if (quoteCurrency === toCurrency) {
                return pair.last;
            }
        }
        // Also check the reverse? But note: we might not have the reverse pair in the list.
        // For triangular arbitrage, we need to have the exact pairs for the triangle.
    }
    return null;
}
