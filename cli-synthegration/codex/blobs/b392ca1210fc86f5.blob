<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>QuanTM FOAM | Quantum Investment Interface</title>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #00f0ff; --secondary: #ff00ff; --accent: #00ffaa;
            --dark: #0a0a1a; --darker: #050510; --light: #a0a0ff;
            --glow: 0 0 10px currentColor, 0 0 20px currentColor;
        }
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Orbitron', monospace; }
        body { background: var(--dark); color: var(--light); min-height: 100vh; overflow-x: hidden; }
        .container { max-width: 1200px; margin: 0 auto; padding: 15px; }
        header { display: flex; justify-content: space-between; align-items: center; padding: 15px 0; border-bottom: 1px solid rgba(0, 240, 255, 0.3); margin-bottom: 20px; flex-wrap: wrap; }
        .logo { display: flex; align-items: center; gap: 10px; }
        .logo-icon { width: 35px; height: 35px; background: var(--primary); border-radius: 50%; box-shadow: var(--glow); }
        .logo-text { font-size: 24px; font-weight: 700; background: linear-gradient(90deg, var(--primary), var(--secondary)); -webkit-background-clip: text; background-clip: text; color: transparent; }
        .user-info { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
        .info-display { background: rgba(0, 0, 0, 0.5); padding: 6px 12px; border-radius: 15px; border: 1px solid; font-size: 14px; }
        .qbucks { border-color: var(--primary); box-shadow: 0 0 8px rgba(0, 240, 255, 0.3); }
        .level { border-color: var(--secondary); box-shadow: 0 0 8px rgba(255, 0, 255, 0.3); }
        .points { border-color: var(--accent); box-shadow: 0 0 8px rgba(0, 255, 170, 0.3); }
        .main-content { display: grid; grid-template-columns: 1fr 280px; gap: 20px; }
        .investment-interface, .tech-tree, .sweepstakes, .base-game { 
            background: rgba(10, 10, 26, 0.7); border-radius: 12px; padding: 15px; 
            border: 1px solid; position: relative; overflow: hidden; margin-bottom: 15px;
        }
        .investment-interface { border-color: rgba(0, 240, 255, 0.2); }
        .tech-tree { border-color: rgba(0, 255, 170, 0.2); }
        .sweepstakes { border-color: rgba(255, 0, 255, 0.2); }
        .base-game { border-color: rgba(255, 170, 0, 0.2); }
        .portal-section { text-align: center; margin-bottom: 20px; }
        .portal-button { background: linear-gradient(45deg, var(--primary), var(--secondary)); border: none; color: white; padding: 12px 24px; border-radius: 25px; font-size: 16px; cursor: pointer; transition: all 0.3s; box-shadow: 0 0 12px rgba(0, 240, 255, 0.5); margin: 15px 0; }
        .portal-button:hover { transform: scale(1.05); box-shadow: 0 0 20px rgba(0, 240, 255, 0.8); }
        .portal-button:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }
        .investment-options { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 15px; margin-top: 20px; }
        .investment-card { background: rgba(0, 0, 0, 0.5); border-radius: 8px; padding: 12px; border: 1px solid rgba(255, 0, 255, 0.3); transition: all 0.3s; cursor: pointer; position: relative; }
        .investment-card:hover { transform: translateY(-3px); box-shadow: 0 3px 10px rgba(255, 0, 255, 0.3); }
        .investment-card.locked { opacity: 0.5; cursor: not-allowed; }
        .investment-icon { width: 40px; height: 40px; background: rgba(0, 255, 170, 0.2); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-bottom: 8px; font-size: 20px; }
        .tech-node { background: rgba(0, 0, 0, 0.5); padding: 8px; border-radius: 6px; margin-bottom: 8px; border-left: 3px solid var(--accent); display: flex; justify-content: space-between; }
        .tech-node.locked { opacity: 0.5; }
        .boom-particle { position: fixed; width: 4px; height: 4px; border-radius: 50%; pointer-events: none; z-index: 1000; }
        .modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(5, 5, 16, 0.95); z-index: 2000; align-items: center; justify-content: center; }
        .modal-content { background: linear-gradient(135deg, var(--darker), var(--dark)); border-radius: 12px; padding: 20px; max-width: 450px; width: 90%; border: 1px solid var(--primary); box-shadow: var(--glow); }
        .close-modal { position: absolute; top: 12px; right: 12px; background: none; border: none; color: var(--light); font-size: 18px; cursor: pointer; }
        .login-form { display: flex; flex-direction: column; gap: 12px; }
        .form-group { display: flex; flex-direction: column; gap: 4px; }
        .form-group label { color: var(--primary); font-size: 14px; }
        .form-group input { background: rgba(0, 0, 0, 0.5); border: 1px solid var(--primary); border-radius: 4px; padding: 8px; color: white; }
        .submit-btn { background: linear-gradient(45deg, var(--primary), var(--secondary)); border: none; color: white; padding: 10px; border-radius: 4px; cursor: pointer; margin-top: 8px; font-weight: 700; }
        .generative-canvas { position: fixed; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: -1; }
        footer { text-align: center; padding: 15px 0; margin-top: 20px; border-top: 1px solid rgba(0, 240, 255, 0.3); font-size: 11px; color: rgba(160, 160, 255, 0.7); }
        .toggle-switch { position: relative; display: inline-block; width: 50px; height: 24px; margin-left: 10px; }
        .toggle-switch input { opacity: 0; width: 0; height: 0; }
        .slider { position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0; background-color: #ccc; transition: .4s; border-radius: 24px; }
        .slider:before { position: absolute; content: ""; height: 16px; width: 16px; left: 4px; bottom: 4px; background-color: white; transition: .4s; border-radius: 50%; }
        input:checked + .slider { background-color: var(--accent); }
        input:checked + .slider:before { transform: translateX(26px); }
        .game-option { background: rgba(0, 0, 0, 0.5); padding: 10px; border-radius: 8px; margin-bottom: 10px; text-align: center; cursor: pointer; border: 1px solid rgba(255, 170, 0, 0.3); }
        .game-option:hover { background: rgba(0, 0, 0, 0.7); }
        .sweepstakes-options { display: flex; justify-content: space-between; margin: 10px 0; }
        .sweepstakes-btn { background: rgba(0, 0, 0, 0.5); border: 1px solid var(--secondary); color: var(--light); padding: 8px 12px; border-radius: 6px; cursor: pointer; flex: 1; margin: 0 5px; font-size: 12px; }
        .sweepstakes-btn.active { background: var(--secondary); color: white; }
        .investment-controls { margin-top: 10px; display: flex; gap: 10px; }
        .investment-controls input { flex: 1; background: rgba(0, 0, 0, 0.5); border: 1px solid var(--primary); border-radius: 4px; padding: 5px; color: white; }
        
        /* Slot Machine Styles */
        .slot-machine { width: 100%; padding: 15px; background: rgba(0, 0, 0, 0.8); border: 2px solid var(--primary); border-radius: 15px; box-shadow: 0 0 30px rgba(0, 240, 255, 0.5); position: relative; overflow: hidden; margin-top: 15px; }
        .holographic-overlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: linear-gradient(45deg, rgba(0, 240, 255, 0.1), rgba(0, 0, 0, 0.2)); pointer-events: none; z-index: 1; }
        .slot-controls { display: flex; justify-content: space-between; margin-bottom: 10px; color: var(--primary); flex-wrap: wrap; }
        .slot-controls label { margin-right: 10px; }
        .slot-controls select, .slot-controls input[type="number"] { background: var(--darker); color: var(--primary); border: 1px solid var(--primary); padding: 5px; border-radius: 5px; }
        .slot-balance { color: var(--primary); margin-bottom: 10px; text-align: center; }
        .reels { display: flex; justify-content: space-between; margin: 15px 0; overflow: hidden; background: var(--darker); border: 2px solid var(--primary); border-radius: 10px; padding: 8px; position: relative; height: 200px; }
        .reel { width: 18%; height: 100%; overflow: hidden; position: relative; display: flex; flex-direction: column; }
        .strip { display: flex; flex-direction: column; transition: transform 2s ease-out; will-change: transform; }
        .spinning .strip { transition: none; animation: spin 0.2s linear infinite; }
        @keyframes spin { 0% { transform: translateY(0); } 100% { transform: translateY(-28.57px); } }
        .symbol { width: 100%; height: 28.57px; display: flex; justify-content: center; align-items: center; font-size: 1.2em; color: var(--primary); text-shadow: 0 0 10px var(--primary); background: rgba(255, 255, 255, 0.1); border-bottom: 1px solid var(--primary); filter: blur(0); }
        .spinning .symbol { filter: blur(2px); }
        .win { animation: electrify 1s infinite alternate; }
        @keyframes electrify { 0% { text-shadow: 0 0 10px var(--primary), 0 0 20px var(--primary); box-shadow: 0 0 10px var(--primary) inset; } 100% { text-shadow: 0 0 20px var(--accent), 0 0 40px var(--accent); box-shadow: 0 0 20px var(--accent) inset; color: white; } }
        #paylineCanvas { position: absolute; top: 8px; left: 8px; width: calc(100% - 16px); height: calc(100% - 16px); pointer-events: none; z-index: 2; }
        .slot-spin-button { width: 100%; padding: 12px; background: var(--primary); color: var(--dark); font-size: 1.2em; border: none; border-radius: 10px; cursor: pointer; transition: all 0.3s; box-shadow: 0 0 20px rgba(0, 240, 255, 0.7); }
        .slot-spin-button:hover { background: #00d0e0; transform: scale(1.05); }
        .slot-spin-button:active { transform: scale(0.95); }
        .slot-spin-button:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }
        .slot-info-panel { margin-top: 15px; padding: 8px; background: rgba(0, 240, 255, 0.1); border-radius: 10px; color: var(--primary); text-align: center; font-size: 0.9em; }
        .slot-odds-heatmap { margin-top: 15px; position: relative; }
        #heatmapCanvas { width: 100%; height: 150px; border: 2px solid var(--primary); border-radius: 10px; }
        .slot-congrats { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); color: var(--accent); font-size: 1.5em; text-shadow: 0 0 20px var(--accent); animation: slotCongratsAnim 2s ease-in-out; z-index: 10; text-align: center; background: rgba(0, 0, 0, 0.4); padding: 15px; border-radius: 10px; border: 2px solid var(--primary); box-shadow: 0 0 20px var(--primary); }
        @keyframes slotCongratsAnim { 0% { transform: translate(-50%, -50%) scale(0); opacity: 0; } 50% { transform: translate(-50%, -50%) scale(1.5); opacity: 1; } 100% { transform: translate(-50%, -50%) scale(1); opacity: 0; } }
        
        @media (max-width: 768px) { 
            .main-content { grid-template-columns: 1fr; } 
            .investment-options { grid-template-columns: 1fr; } 
            header { flex-direction: column; gap: 10px; }
            .user-info { justify-content: center; }
        }
    </style>
</head>
<body>
    <canvas class="generative-canvas" id="backgroundCanvas"></canvas>
    
    <div class="container">
        <header>
            <div class="logo">
                <div class="logo-icon"></div>
                <div class="logo-text">QuanTM FOAM</div>
            </div>
            <div class="user-info">
                <div class="info-display qbucks" id="qbucksDisplay">Q-Bucks: 1,250</div>
                <div class="info-display level" id="levelDisplay">Level 1</div>
                <div class="info-display points" id="pointsDisplay">Points: 0/100</div>
                <div style="display: flex; align-items: center;">
                    <span style="font-size: 12px;">Live Data</span>
                    <label class="toggle-switch">
                        <input type="checkbox" id="liveDataToggle">
                        <span class="slider"></span>
                    </label>
                </div>
                <button id="loginBtn" class="portal-button" style="padding: 6px 12px; font-size: 12px;">Login</button>
            </div>
        </header>
        
        <div class="main-content">
            <div class="investment-interface">
                <div class="portal-section">
                    <h2>Quantum Portal Interface</h2>
                    <p>Activate the quantum field to generate unique investment opportunities</p>
                    <button class="portal-button" id="portalJump">Initiate Portal Jump</button>
                    <div id="portalStatus">Portal Status: Stable</div>
                </div>
                
                <h3>Investment Modules</h3>
                <div class="investment-options" id="investmentOptions">
                    <!-- Investment cards will be generated by JavaScript -->
                </div>
                
                <!-- Quantum Slot Machine Integration -->
                <div class="slot-machine">
                    <div class="holographic-overlay"></div>
                    <div class="slot-controls">
                        <div>
                            <label for="paylinesSelect">Paylines:</label>
                            <select id="paylinesSelect">
                                <option value="1">1</option>
                                <option value="3">3</option>
                                <option value="5" selected>5</option>
                                <option value="9">9</option>
                                <option value="15">15</option>
                                <option value="20">20</option>
                                <option value="25">25</option>
                            </select>
                        </div>
                        <div>
                            <input type="checkbox" id="showPaylines" checked>
                            <label for="showPaylines">Show Paylines</label>
                        </div>
                    </div>
                    <div class="slot-controls">
                        <div>
                            <label for="orderAmount">Order Amount:</label>
                            <input type="number" id="orderAmount" value="10" min="1">
                        </div>
                    </div>
                    <div class="slot-balance" id="slotBalance">Balance: 1000</div>
                    <div class="reels">
                        <canvas id="paylineCanvas"></canvas>
                        <div class="reel" id="reel1"><div class="strip"></div></div>
                        <div class="reel" id="reel2"><div class="strip"></div></div>
                        <div class="reel" id="reel3"><div class="strip"></div></div>
                        <div class="reel" id="reel4"><div class="strip"></div></div>
                        <div class="reel" id="reel5"><div class="strip"></div></div>
                    </div>
                    <button class="slot-spin-button" id="slotSpinButton">QUANTUM SPIN</button>
                    <div class="slot-info-panel" id="slotInfo">Spin to Win! Active Paylines: 5 (1-5) | Odds: 1 in 7</div>
                    <div class="slot-odds-heatmap">
                        <canvas id="heatmapCanvas"></canvas>
                    </div>
                </div>
            </div>
            
            <div class="sidebar">
                <div class="base-game">
                    <h3>Base Games</h3>
                    <div id="baseGames">
                        <!-- Base games will be generated by JavaScript -->
                    </div>
                </div>
                
                <div class="tech-tree">
                    <h3>Quantum Tech Tree</h3>
                    <div id="techTreeNodes">
                        <!-- Tech nodes will be generated by JavaScript -->
                    </div>
                </div>
                
                <div class="sweepstakes">
                    <h3>BOOM Particle Generator</h3>
                    <p>Generate BOOM particles for bonus rewards</p>
                    <div class="sweepstakes-options">
                        <button class="sweepstakes-btn active" data-time="1">1 min</button>
                        <button class="sweepstakes-btn" data-time="5">5 min</button>
                        <button class="sweepstakes-btn" data-time="15">15 min</button>
                    </div>
                    <button class="portal-button" id="generateBoom" style="font-size: 12px; padding: 8px 16px; width: 100%;">Generate BOOM</button>
                    <div id="boomCounter">BOOM Particles: 3</div>
                    <div id="sweepstakesInfo">Next entry: <span id="sweepstakesTimer">1:00</span></div>
                </div>

                <div class="sweepstakes">
                    <h3>Portfolio Overview</h3>
                    <div id="portfolioValue">Total Value: $0.00</div>
                    <div id="portfolioChange">24h Change: +0.00%</div>
                    <div id="topHoldings">Top Holdings: None</div>
                </div>
            </div>
        </div>
        
        <footer>
            <p>QuanTM FOAM v2.0 | Quantum Investment Interface | For simulation purposes only</p>
        </footer>
    </div>
    
    <div class="modal" id="loginModal">
        <div class="modal-content">
            <button class="close-modal" id="closeLogin">&times;</button>
            <h2>Quantum Authentication</h2>
            <form class="login-form" id="loginForm">
                <div class="form-group">
                    <label for="username">Quantum ID</label>
                    <input type="text" id="username" placeholder="Enter your Quantum ID">
                </div>
                <div class="form-group">
                    <label for="password">Entanglement Key</label>
                    <input type="password" id="password" placeholder="Enter your Entanglement Key">
                </div>
                <button type="submit" class="submit-btn">Authenticate</button>
            </form>
        </div>
    </div>

    <div class="modal" id="messageModal">
        <div class="modal-content">
            <button class="close-modal" id="closeMessage">&times;</button>
            <h2 id="messageTitle">Quantum Message</h2>
            <p id="messageText"></p>
        </div>
    </div>

    <script>
        // ========== CONFIGURATION ==========
        const CONFIG = {
            INITIAL_Q_BUCKS: 1250,
            INITIAL_LEVEL: 1,
            INITIAL_POINTS: 0,
            POINTS_PER_LEVEL: 100,
            BOOM_PARTICLES: 3,
            BOOM_RECHARGE_TIME: 60000,
            LEVEL_UP_INTERVAL: 30000,
            CRYPTO_UPDATE_INTERVAL: 10000,
            BASE_GAME_COST: 10,
            SLOT_INITIAL_BALANCE: 1000
        };

        const MODULES = {
            micro: { name: 'Micro-Cap Scanner', icon: 'μ', level: 1, cost: 50, risk: 0.3, reward: 0.15, uses: 0, maxUses: 5 },
            nano: { name: 'Nano-Cap Radar', icon: 'η', level: 3, cost: 100, risk: 0.5, reward: 0.25, uses: 0, maxUses: 10 },
            planck: { name: 'Planck-Level Detection', icon: 'ℏ', level: 5, cost: 500, risk: 0.8, reward: 0.5, uses: 0, maxUses: 20 },
            dca: { name: 'DCA Matrix', icon: '↔', level: 2, cost: 75, risk: 0.2, reward: 0.1, uses: 0, maxUses: 15 },
            snipe: { name: 'Sniper Protocol', icon: '🎯', level: 4, cost: 150, risk: 0.6, reward: 0.3, uses: 0, maxUses: 8 },
            grid: { name: 'Quantum Grid', icon: '#', level: 7, cost: 1000, risk: 0.7, reward: 0.4, uses: 0, maxUses: 25 }
        };

        const BASE_GAMES = {
            dice: { name: 'Quantum Dice', icon: '🎲', cost: 10, reward: 20, risk: 0.4 },
            slots: { name: 'Neon Slots', icon: '🎰', cost: 25, reward: 50, risk: 0.6 },
            wheel: { name: 'Fortune Wheel', icon: '🎡', cost: 50, reward: 100, risk: 0.5 }
        };

        const TECH_TREE = [
            { name: 'Basic Scanner', level: 1, unlocked: true },
            { name: 'Risk Assessment Matrix', level: 2, unlocked: false },
            { name: 'Volatility Predictor', level: 3, unlocked: false },
            { name: 'Quantum Entanglement Trading', level: 5, unlocked: false },
            { name: 'Temporal Arbitrage', level: 8, unlocked: false }
        ];

        const SLOT_CONFIG = {
            baseSymbols: ['⚡️', '🌌', '🔮', '💎', '🪐', '⭐', '🌟', '🚀'],
            visibleSymbols: 7,
            baseSpinDuration: 2000,
            reelDelay: 300,
            extraSymbols: 30,
            symbolMultipliers: {
                '⚡️': 2, '🌌': 3, '🔮': 5, '💎': 10, 
                '🪐': 15, '⭐': 20, '🌟': 30, '🚀': 50
            },
            houseEdge: 0.05,
            paylines: [
                [3,3,3,3,3], [2,2,2,2,2], [4,4,4,4,4], [1,1,1,1,1], [5,5,5,5,5],
                [0,1,2,3,4], [6,5,4,3,2], [2,3,4,3,2], [4,3,2,3,4], [0,0,0,0,0],
                [6,6,6,6,6], [1,2,3,4,5], [5,4,3,2,1], [0,1,0,1,0], [6,5,6,5,6],
                [1,0,1,0,1], [5,6,5,6,5], [0,2,4,6,5], [6,4,2,0,1], [3,2,1,2,3],
                [3,4,5,4,3], [2,1,0,1,2], [4,5,6,5,4], [1,3,5,3,1], [5,3,1,3,5]
            ],
            colors: [
                '#ff0000', '#00ff00', '#0000ff', '#ffff00', '#ff00ff', '#00ffff', '#ff8000', '#8000ff', '#00ff80',
                '#ff0080', '#80ff00', '#0080ff', '#80ff80', '#ff80ff', '#ffff80', '#80ffff', '#ff8080', '#8080ff',
                '#80ff00', '#00ff80', '#8000ff', '#ff00ff', '#ffff00', '#00ffff', '#ff8000'
            ],
            oddsMap: {1: 30, 3: 11, 5: 7, 9: 5, 15: 3, 20: 2, 25: 2}
        };

        // ========== STATE MANAGEMENT ==========
        const StateManager = {
            user: null,
            
            init() {
                if (!this.loadFromStorage('user')) {
                    this.user = {
                        username: null,
                        level: CONFIG.INITIAL_LEVEL,
                        points: CONFIG.INITIAL_POINTS,
                        qBucks: CONFIG.INITIAL_Q_BUCKS,
                        boomParticles: CONFIG.BOOM_PARTICLES,
                        unlockedModules: ['micro'],
                        portfolio: {},
                        toolUses: {},
                        lastSweepstakes: Date.now(),
                        sweepstakesTime: 1,
                        slotBalance: CONFIG.SLOT_INITIAL_BALANCE
                    };
                    this.saveToStorage('user', this.user);
                } else {
                    this.user = this.loadFromStorage('user');
                }
            },
            
            loadFromStorage(key) {
                return JSON.parse(localStorage.getItem(`quanTM_${key}`) || 'null');
            },
            
            saveToStorage(key, value) {
                localStorage.setItem(`quanTM_${key}`, JSON.stringify(value));
            },
            
            updateUser(updates) {
                this.user = { ...this.user, ...updates };
                this.saveToStorage('user', this.user);
                return this.user;
            }
        };

        // ========== UI COMPONENTS ==========
        const UIComponents = {
            // Modal Management
            modals: {
                login: document.getElementById('loginModal'),
                message: document.getElementById('messageModal')
            },
            
            initModals() {
                // Login modal
                document.getElementById('loginBtn').addEventListener('click', () => {
                    this.modals.login.style.display = 'flex';
                });
                
                document.getElementById('closeLogin').addEventListener('click', () => {
                    this.modals.login.style.display = 'none';
                });
                
                document.getElementById('loginForm').addEventListener('submit', (e) => {
                    e.preventDefault();
                    const username = document.getElementById('username').value;
                    if (username) {
                        StateManager.updateUser({ username });
                        document.getElementById('loginBtn').textContent = username;
                        this.modals.login.style.display = 'none';
                    }
                });
                
                // Message modal
                document.getElementById('closeMessage').addEventListener('click', () => {
                    this.modals.message.style.display = 'none';
                });
                
                // Close modals when clicking outside
                window.addEventListener('click', (e) => {
                    if (e.target === this.modals.login) this.modals.login.style.display = 'none';
                    if (e.target === this.modals.message) this.modals.message.style.display = 'none';
                });
            },
            
            showMessage(title, text) {
                document.getElementById('messageTitle').textContent = title;
                document.getElementById('messageText').textContent = text;
                this.modals.message.style.display = 'flex';
            },
            
            // Dynamic UI Generation
            generateInvestmentCards() {
                const container = document.getElementById('investmentOptions');
                container.innerHTML = '';
                
                Object.entries(MODULES).forEach(([key, module]) => {
                    const unlocked = StateManager.user.unlockedModules.includes(key);
                    const usesLeft = module.maxUses - (StateManager.user.toolUses[key] || 0);
                    const canUse = unlocked && usesLeft > 0 && StateManager.user.level >= module.level;
                    
                    const card = document.createElement('div');
                    card.className = `investment-card ${unlocked && canUse ? '' : 'locked'}`;
                    card.setAttribute('data-module', key);
                    card.innerHTML = `
                        <div class="investment-icon">${module.icon}</div>
                        <h4>${module.name}</h4>
                        <p>${unlocked ? 
                            (canUse ? 
                                `Cost: ${module.cost} Q-Bucks | Uses: ${usesLeft}/${module.maxUses}` : 
                                `Level ${module.level} required | ${usesLeft > 0 ? 'Upgrade available' : 'No uses left'}`) : 
                            `Unlocks at Level ${module.level}`}
                        </p>
                        ${unlocked && canUse ? `
                            <div class="investment-controls">
                                <input type="number" id="amount-${key}" placeholder="Q-Bucks to invest" min="1" max="${StateManager.user.qBucks}" value="${module.cost}">
                                <button class="portal-button" style="padding: 5px 10px; font-size: 12px;" data-module="${key}">Invest</button>
                            </div>
                        ` : ''}
                        <div class="module-status">${unlocked ? (canUse ? 'Active' : 'Locked') : 'Locked'}</div>
                    `;
                    container.appendChild(card);
                });
                
                // Add event listeners to investment buttons
                container.querySelectorAll('.portal-button').forEach(btn => {
                    btn.addEventListener('click', (e) => {
                        const moduleKey = e.target.getAttribute('data-module');
                        const amountInput = document.getElementById(`amount-${moduleKey}`);
                        const amount = parseInt(amountInput.value) || MODULES[moduleKey].cost;
                        
                        if (amount > 0 && amount <= StateManager.user.qBucks) {
                            GameLogic.activateInvestmentModule(moduleKey, amount);
                        } else {
                            this.showMessage('Quantum Flux Error', 'Invalid investment amount. Check your Q-Bucks balance.');
                        }
                    });
                });
            },
            
            generateBaseGames() {
                const container = document.getElementById('baseGames');
                container.innerHTML = '';
                
                Object.entries(BASE_GAMES).forEach(([key, game]) => {
                    const gameEl = document.createElement('div');
                    gameEl.className = 'game-option';
                    gameEl.setAttribute('data-game', key);
                    gameEl.innerHTML = `
                        <div style="display: flex; align-items: center; justify-content: space-between;">
                            <span>${game.icon} ${game.name}</span>
                            <span>${game.cost} Q-Bucks</span>
                        </div>
                    `;
                    container.appendChild(gameEl);
                });
                
                // Add event listeners to base games
                container.querySelectorAll('.game-option').forEach(game => {
                    game.addEventListener('click', (e) => {
                        const gameKey = e.currentTarget.getAttribute('data-game');
                        GameLogic.playBaseGame(gameKey);
                    });
                });
            },
            
            generateTechTreeNodes() {
                const container = document.getElementById('techTreeNodes');
                container.innerHTML = '';
                
                TECH_TREE.forEach(node => {
                    const unlocked = node.unlocked || StateManager.user.level >= node.level;
                    const nodeEl = document.createElement('div');
                    nodeEl.className = `tech-node ${unlocked ? '' : 'locked'}`;
                    nodeEl.innerHTML = `
                        <span>${node.name}</span>
                        <span>${unlocked ? '✓' : `Lvl ${node.level}`}</span>
                    `;
                    container.appendChild(nodeEl);
                });
            },
            
            // UI Updates
            updateUI() {
                document.getElementById('qbucksDisplay').textContent = `Q-Bucks: ${StateManager.user.qBucks.toLocaleString()}`;
                document.getElementById('levelDisplay').textContent = `Level ${StateManager.user.level}`;
                document.getElementById('pointsDisplay').textContent = `Points: ${StateManager.user.points}/${CONFIG.POINTS_PER_LEVEL}`;
                document.getElementById('boomCounter').textContent = `BOOM Particles: ${StateManager.user.boomParticles}`;
                document.getElementById('slotBalance').textContent = `Balance: ${StateManager.user.slotBalance}`;
                
                this.updatePortfolioDisplay();
            },
            
            updatePortfolioDisplay() {
                const portfolio = StateManager.user.portfolio;
                let totalValue = 0;
                let totalChange = 0;
                let topHoldings = [];
                
                Object.entries(portfolio).forEach(([symbol, holding]) => {
                    const coin = CryptoSimulator.getCoin(symbol);
                    if (coin) {
                        const value = holding.amount * coin.price;
                        totalValue += value;
                        totalChange += holding.amount * coin.price * (coin.change / 100);
                        topHoldings.push({ symbol, value });
                    }
                });
                
                topHoldings.sort((a, b) => b.value - a.value);
                const topThree = topHoldings.slice(0, 3).map(h => h.symbol.toUpperCase()).join(', ') || 'None';
                const changePercent = totalValue > 0 ? (totalChange / totalValue * 100) : 0;
                
                document.getElementById('portfolioValue').textContent = `Total Value: $${totalValue.toFixed(2)}`;
                document.getElementById('portfolioChange').textContent = `24h Change: ${changePercent >= 0 ? '+' : ''}${changePercent.toFixed(2)}%`;
                document.getElementById('topHoldings').textContent = `Top Holdings: ${topThree}`;
            }
        };

        // ========== GAME LOGIC ==========
        const GameLogic = {
            // Investment Module Logic
            activateInvestmentModule(moduleKey, amount) {
                const module = MODULES[moduleKey];
                if (!module || amount > StateManager.user.qBucks) {
                    UIComponents.showMessage('Investment Error', 'Insufficient Q-Bucks for this investment.');
                    return;
                }
                
                const usesLeft = module.maxUses - (StateManager.user.toolUses[moduleKey] || 0);
                if (usesLeft <= 0) {
                    UIComponents.showMessage('Tool Depleted', `You have no uses left for ${module.name}. Upgrade at level ${module.level + 2}.`);
                    return;
                }
                
                // Deduct cost and track usage
                StateManager.updateUser({
                    qBucks: StateManager.user.qBucks - amount,
                    toolUses: { ...StateManager.user.toolUses, [moduleKey]: (StateManager.user.toolUses[moduleKey] || 0) + 1 }
                });
                
                // Determine which coin to invest in based on level
                let coin;
                if (StateManager.user.level >= 5) {
                    coin = CryptoSimulator.getCheapestCoin();
                } else if (StateManager.user.level >= 3) {
                    coin = CryptoSimulator.coins.find(c => c.symbol === 'nano') || CryptoSimulator.getRandomCoin();
                } else {
                    coin = CryptoSimulator.coins.find(c => c.symbol === 'micro') || CryptoSimulator.getRandomCoin();
                }
                
                // Calculate coin amount and add to portfolio
                const coinAmount = amount / coin.price;
                const portfolio = { ...StateManager.user.portfolio };
                
                if (!portfolio[coin.symbol]) {
                    portfolio[coin.symbol] = { amount: 0, avgPrice: 0 };
                }
                
                const portfolioItem = portfolio[coin.symbol];
                const totalCost = portfolioItem.amount * portfolioItem.avgPrice + amount;
                portfolioItem.amount += coinAmount;
                portfolioItem.avgPrice = totalCost / portfolioItem.amount;
                
                StateManager.updateUser({ portfolio });
                
                // Add points and check for level up
                this.addPoints(amount / 10);
                
                // Update UI
                UIComponents.updateUI();
                UIComponents.generateInvestmentCards();
                
                // Show result after delay
                setTimeout(() => {
                    const profitLoss = (Math.random() * module.reward - module.risk/2) * amount;
                    const message = profitLoss >= 0 ? 
                        `Quantum alignment achieved! +${profitLoss.toFixed(2)} Q-Bucks profit` :
                        `Quantum fluctuation detected! ${Math.abs(profitLoss).toFixed(2)} Q-Bucks loss`;
                    
                    UIComponents.showMessage(
                        `${module.name} Activated`, 
                        `Invested in ${coin.name} (${coinAmount.toFixed(coin.decimals)} coins)\n${message}`
                    );
                    
                    // Add profit/loss to Q-Bucks
                    StateManager.updateUser({ qBucks: StateManager.user.qBucks + profitLoss });
                    UIComponents.updateUI();
                }, 1000);
            },
            
            // Base Game Logic
            playBaseGame(gameKey) {
                const game = BASE_GAMES[gameKey];
                if (!game || StateManager.user.qBucks < game.cost) {
                    UIComponents.showMessage('Game Error', 'Insufficient Q-Bucks to play this game.');
                    return;
                }
                
                // Deduct cost
                StateManager.updateUser({ qBucks: StateManager.user.qBucks - game.cost });
                
                // Determine win/loss
                const win = Math.random() > game.risk;
                let outcomeMessage, qbucksChange;
                
                if (win) {
                    qbucksChange = game.reward;
                    outcomeMessage = `Quantum victory! You won ${qbucksChange} Q-Bucks!`;
                    StateManager.updateUser({ qBucks: StateManager.user.qBucks + qbucksChange });
                } else {
                    qbucksChange = -game.cost;
                    outcomeMessage = `Quantum misalignment. You lost ${game.cost} Q-Bucks.`;
                }
                
                // Add points
                this.addPoints(game.cost / 5);
                
                // Award bonus coins on win
                if (win) {
                    const coin = CryptoSimulator.getRandomCoin();
                    const coinAmount = (game.reward * 0.1) / coin.price;
                    const portfolio = { ...StateManager.user.portfolio };
                    
                    if (!portfolio[coin.symbol]) {
                        portfolio[coin.symbol] = { amount: 0, avgPrice: 0 };
                    }
                    
                    const portfolioItem = portfolio[coin.symbol];
                    const totalCost = portfolioItem.amount * portfolioItem.avgPrice + (game.reward * 0.1);
                    portfolioItem.amount += coinAmount;
                    portfolioItem.avgPrice = totalCost / portfolioItem.amount;
                    
                    StateManager.updateUser({ portfolio });
                    outcomeMessage += `\nBonus: Acquired ${coinAmount.toFixed(coin.decimals)} ${coin.symbol.toUpperCase()}`;
                }
                
                // Update UI and show result
                UIComponents.updateUI();
                UIComponents.showMessage(`${game.name} Result`, outcomeMessage);
            },
            
            // Points and Level System
            addPoints(points) {
                const newPoints = StateManager.user.points + points;
                let newLevel = StateManager.user.level;
                let levelUps = 0;
                
                // Check for level ups
                while (newPoints >= CONFIG.POINTS_PER_LEVEL) {
                    newLevel++;
                    levelUps++;
                    StateManager.updateUser({ points: newPoints - CONFIG.POINTS_PER_LEVEL });
                    newPoints -= CONFIG.POINTS_PER_LEVEL;
                }
                
                StateManager.updateUser({ points: newPoints, level: newLevel });
                
                // Unlock modules for each level up
                if (levelUps > 0) {
                    const unlockedModules = [...StateManager.user.unlockedModules];
                    Object.entries(MODULES).forEach(([key, module]) => {
                        if (module.level <= newLevel && !unlockedModules.includes(key)) {
                            unlockedModules.push(key);
                            StateManager.updateUser({ toolUses: { ...StateManager.user.toolUses, [key]: 0 } });
                        }
                    });
                    
                    StateManager.updateUser({ unlockedModules });
                    
                    // Award Q-Bucks for leveling up
                    const levelBonus = newLevel * 100;
                    StateManager.updateUser({ qBucks: StateManager.user.qBucks + levelBonus });
                    
                    // Regenerate UI elements
                    UIComponents.generateInvestmentCards();
                    UIComponents.generateTechTreeNodes();
                    
                    UIComponents.showMessage('Quantum Level Up!', `Reached Level ${newLevel}. +${levelBonus} Q-Bucks awarded! New tools unlocked.`);
                }
                
                UIComponents.updateUI();
            },
            
            // Portal Jump Logic
            initiatePortalJump() {
                const portalStatus = document.getElementById('portalStatus');
                const portalButton = document.getElementById('portalJump');
                
                portalStatus.textContent = 'Portal Status: Quantum Fluctuation Detected';
                portalButton.disabled = true;
                portalButton.textContent = 'Portal Jumping...';
                
                // Create visual effects
                for (let i = 0; i < 15; i++) {
                    setTimeout(() => {
                        const x = Math.random() * window.innerWidth;
                        const y = Math.random() * window.innerHeight;
                        VisualEffects.createBoomParticle(x, y, true);
                    }, i * 100);
                }
                
                // Simulate portal jump completion
                setTimeout(() => {
                    portalStatus.textContent = 'Portal Status: Stable (New Opportunities Generated)';
                    portalButton.disabled = false;
                    portalButton.textContent = 'Initiate Portal Jump';
                    
                    // Add points for portal jump
                    this.addPoints(25);
                    
                    // Animate investment cards
                    document.querySelectorAll('.investment-card:not(.locked)').forEach(card => {
                        card.style.animation = 'pulse 1s';
                        setTimeout(() => card.style.animation = '', 1000);
                    });
                    
                    UIComponents.showMessage('Quantum Portal Activated', 'New investment opportunities have been generated across the quantum field.');
                }, 3000);
            },
            
            // BOOM Particle Logic
            generateBoomParticle() {
                if (StateManager.user.boomParticles > 0 && Date.now() - StateManager.user.lastBoomTime > 1000) {
                    StateManager.updateUser({
                        boomParticles: StateManager.user.boomParticles - 1,
                        lastBoomTime: Date.now()
                    });
                    
                    UIComponents.updateUI();
                    
                    // Create visual effects
                    for (let i = 0; i < 5; i++) {
                        setTimeout(() => {
                            const x = Math.random() * window.innerWidth;
                            const y = Math.random() * window.innerHeight;
                            VisualEffects.createBoomParticle(x, y, false);
                        }, i * 200);
                    }
                    
                    // Award random Q-Bucks based on sweepstakes time
                    const timeMultiplier = StateManager.user.sweepstakesTime;
                    const bonus = Math.floor(Math.random() * 50 * timeMultiplier) + (10 * timeMultiplier);
                    StateManager.updateUser({ qBucks: StateManager.user.qBucks + bonus });
                    UIComponents.updateUI();
                    
                    UIComponents.showMessage('BOOM Particle Generated', `Quantum energy released! +${bonus} Q-Bucks awarded.`);
                    
                    // Replenish BOOM particles if empty
                    if (StateManager.user.boomParticles === 0) {
                        const boomButton = document.getElementById('generateBoom');
                        boomButton.disabled = true;
                        boomButton.textContent = 'Recharging...';
                        
                        setTimeout(() => {
                            StateManager.updateUser({ boomParticles: CONFIG.BOOM_PARTICLES });
                            UIComponents.updateUI();
                            boomButton.disabled = false;
                            boomButton.textContent = 'Generate BOOM';
                            UIComponents.showMessage('BOOM Particles Recharged', 'Quantum energy reserves replenished.');
                        }, CONFIG.BOOM_RECHARGE_TIME);
                    }
                }
            }
        };

        // ========== SLOT MACHINE ==========
        const SlotMachine = {
            isSpinning: false,
            dominantSymbol: null,
            symbols: [],
            
            init() {
                this.dominantSymbol = SLOT_CONFIG.baseSymbols[0];
                this.symbols = Array(7).fill(this.dominantSymbol).concat(SLOT_CONFIG.baseSymbols.slice(1));
                
                // Initialize reels
                const reels = document.querySelectorAll('.reel .strip');
                reels.forEach(strip => {
                    let html = '';
                    for (let i = 0; i < SLOT_CONFIG.visibleSymbols; i++) {
                        const sym = this.symbols[Math.floor(Math.random() * this.symbols.length)];
                        html += `<div class="symbol">${sym}</div>`;
                    }
                    strip.innerHTML = html;
                });
                
                this.updateInfo();
                this.drawPaylines([]);
                this.drawHeatmap(0);
                
                // Event listeners
                document.getElementById('paylinesSelect').addEventListener('change', () => this.updateInfo());
                document.getElementById('showPaylines').addEventListener('change', () => this.drawPaylines([]));
                document.getElementById('slotSpinButton').addEventListener('click', () => this.spinReels());
                
                // Sweepstakes buttons
                document.querySelectorAll('.sweepstakes-btn').forEach(btn => {
                    btn.addEventListener('click', (e) => {
                        document.querySelectorAll('.sweepstakes-btn').forEach(b => b.classList.remove('active'));
                        e.target.classList.add('active');
                        StateManager.updateUser({ sweepstakesTime: parseInt(e.target.getAttribute('data-time')) });
                        GameLogic.startSweepstakesTimer();
                    });
                });
            },
            
            updateInfo() {
                const numPaylines = parseInt(document.getElementById('paylinesSelect').value);
                const odds = SLOT_CONFIG.oddsMap[numPaylines];
                document.getElementById('slotInfo').textContent = `Spin to Win! Active Paylines: ${numPaylines} (1-${numPaylines}) | Odds: 1 in ${odds}`;
                this.drawPaylines([]);
                this.drawHeatmap(0);
            },
            
            drawPaylines(winningIndices = []) {
                const canvas = document.getElementById('paylineCanvas');
                const ctx = canvas.getContext('2d');
                const showPaylines = document.getElementById('showPaylines').checked;
                
                if (!showPaylines && winningIndices.length === 0) {
                    ctx.clearRect(0, 0, canvas.width, canvas.height);
                    return;
                }
                
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                const numPaylines = parseInt(document.getElementById('paylinesSelect').value);
                const reelWidth = canvas.width / 5;
                const symHeight = canvas.height / SLOT_CONFIG.visibleSymbols;

                for (let i = 0; i < numPaylines; i++) {
                    const pl = SLOT_CONFIG.paylines[i];
                    const isWinning = winningIndices.includes(i);
                    ctx.globalAlpha = isWinning ? 1 : 0.3;
                    ctx.beginPath();
                    for (let col = 0; col < 5; col++) {
                        const x = reelWidth * (col + 0.5);
                        const y = symHeight * (pl[col] + 0.5);
                        if (col === 0) ctx.moveTo(x, y);
                        else ctx.lineTo(x, y);
                    }
                    ctx.strokeStyle = SLOT_CONFIG.colors[i % SLOT_CONFIG.colors.length];
                    ctx.lineWidth = isWinning ? 5 : 2;
                    ctx.stroke();

                    const x0 = 10;
                    const y0 = symHeight * (pl[0] + 0.5);
                    ctx.fillStyle = SLOT_CONFIG.colors[i % SLOT_CONFIG.colors.length];
                    ctx.font = 'bold 12px Orbitron';
                    ctx.globalAlpha = isWinning ? 1 : 0.5;
                    ctx.fillText(i + 1, x0, y0);
                }
            },
            
            drawHeatmap(numStopped) {
                const canvas = document.getElementById('heatmapCanvas');
                const ctx = canvas.getContext('2d');
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                
                const numPaylines = parseInt(document.getElementById('paylinesSelect').value);
                const reelWidth = canvas.width / 5;
                const symHeight = canvas.height / SLOT_CONFIG.visibleSymbols;
                const viableHeatGrid = Array.from({length: SLOT_CONFIG.visibleSymbols}, () => Array(5).fill(0));
                const brokenHeatGrid = Array.from({length: SLOT_CONFIG.visibleSymbols}, () => Array(5).fill(0));

                for (let i = 0; i < numPaylines; i++) {
                    const pl = SLOT_CONFIG.paylines[i];
                    let isViable = true;
                    if (numStopped > 1) {
                        const prefixSym = this.getSymbolAt(0, pl[0]);
                        for (let col = 1; col < numStopped; col++) {
                            if (this.getSymbolAt(col, pl[col]) !== prefixSym) {
                                isViable = false;
                                break;
                            }
                        }
                    }
                    const grid = isViable ? viableHeatGrid : brokenHeatGrid;
                    for (let col = 0; col < 5; col++) {
                        const row = pl[col];
                        grid[row][col]++;
                    }
                }

                const maxViable = Math.max(...viableHeatGrid.flat(), 1);
                const maxBroken = Math.max(...brokenHeatGrid.flat(), 1);

                for (let row = 0; row < SLOT_CONFIG.visibleSymbols; row++) {
                    for (let col = 0; col < 5; col++) {
                        const brokenIntensity = brokenHeatGrid[row][col] / maxBroken;
                        ctx.fillStyle = `rgba(255, 0, 0, ${brokenIntensity * 0.5})`;
                        ctx.fillRect(col * reelWidth, row * symHeight, reelWidth, symHeight);

                        const viableIntensity = viableHeatGrid[row][col] / maxViable;
                        ctx.fillStyle = `rgba(0, 255, 0, ${viableIntensity * 0.5})`;
                        ctx.fillRect(col * reelWidth, row * symHeight, reelWidth, symHeight);

                        ctx.strokeStyle = '#00f0ff';
                        ctx.lineWidth = 1;
                        ctx.strokeRect(col * reelWidth, row * symHeight, reelWidth, symHeight);
                    }
                }
            },
            
            getSymbolAt(reelIndex, row) {
                const strip = document.querySelectorAll('.reel .strip')[reelIndex];
                const symbolsInStrip = strip.querySelectorAll('.symbol');
                const visibleIndex = symbolsInStrip.length - (SLOT_CONFIG.visibleSymbols - row);
                return symbolsInStrip[visibleIndex].textContent;
            },
            
            spinReels() {
                if (this.isSpinning) return;
                const orderAmount = parseInt(document.getElementById('orderAmount').value);
                if (StateManager.user.slotBalance < orderAmount || orderAmount <= 0) {
                    document.getElementById('slotInfo').textContent = 'Insufficient balance or invalid order amount!';
                    return;
                }
                
                StateManager.updateUser({ slotBalance: StateManager.user.slotBalance - orderAmount });
                UIComponents.updateUI();
                this.isSpinning = true;
                document.getElementById('slotInfo').textContent = 'Spinning...';
                document.getElementById('slotSpinButton').disabled = true;
                
                if (!document.getElementById('showPaylines').checked) {
                    this.drawPaylines([]);
                }
                this.drawHeatmap(0);

                const reels = document.querySelectorAll('.reel');
                let stoppedReels = 0;

                reels.forEach((reel, index) => {
                    const strip = reel.querySelector('.strip');
                    const finalSymbols = Array.from({length: SLOT_CONFIG.visibleSymbols}, () => 
                        this.symbols[Math.floor(Math.random() * this.symbols.length)]);
                    const stripSymbols = this.generateStrip(finalSymbols);

                    strip.style.transition = 'none';
                    strip.style.transform = 'translateY(0px)';

                    let html = '';
                    stripSymbols.forEach(sym => {
                        html += `<div class="symbol">${sym}</div>`;
                    });
                    strip.innerHTML = html;

                    reel.classList.add('spinning');
                    const totalHeight = stripSymbols.length * 28.57;
                    const endPosition = -(totalHeight - (SLOT_CONFIG.visibleSymbols * 28.57));
                    const thisDuration = SLOT_CONFIG.baseSpinDuration + index * SLOT_CONFIG.reelDelay;

                    requestAnimationFrame(() => {
                        strip.style.transition = `transform ${thisDuration}ms ease-out`;
                        strip.style.transform = `translateY(${endPosition}px)`;
                    });

                    setTimeout(() => {
                        reel.classList.remove('spinning');
                        strip.style.transition = 'none';
                        stoppedReels++;
                        this.drawHeatmap(stoppedReels);
                        if (stoppedReels === 5) {
                            this.isSpinning = false;
                            document.getElementById('slotSpinButton').disabled = false;
                            const { hasWin, numWins, winningIndices, totalPayout } = this.checkWins(orderAmount);
                            if (hasWin) {
                                StateManager.updateUser({ slotBalance: StateManager.user.slotBalance + totalPayout });
                                UIComponents.updateUI();
                                this.showCongrats(orderAmount, numWins, totalPayout, winningIndices);
                            }
                        }
                    }, thisDuration);
                });
            },
            
            generateStrip(finalSymbols) {
                const stripSymbols = [];
                for (let i = 0; i < SLOT_CONFIG.extraSymbols; i++) {
                    stripSymbols.push(this.symbols[Math.floor(Math.random() * this.symbols.length)]);
                }
                stripSymbols.push(...finalSymbols.reverse());
                return stripSymbols;
            },
            
            checkWins(orderAmount) {
                let winningIndices = [];
                let hasWin = false;
                let numWins = 0;
                let totalPayout = 0;
                const numPaylines = parseInt(document.getElementById('paylinesSelect').value);

                for (let i = 0; i < numPaylines; i++) {
                    const payline = SLOT_CONFIG.paylines[i];
                    const lineSymbols = payline.map((row, reelIndex) => this.getSymbolAt(reelIndex, row));
                    const allSame = lineSymbols.every(sym => sym === lineSymbols[0]);
                    if (allSame) {
                        hasWin = true;
                        numWins++;
                        winningIndices.push(i);
                        const symbolMultiplier = SLOT_CONFIG.symbolMultipliers[lineSymbols[0]] || 1;
                        const payout = (orderAmount / numPaylines) * symbolMultiplier * (1 - SLOT_CONFIG.houseEdge);
                        totalPayout += payout;
                        this.highlightPath(i, payline);
                    }
                }

                this.drawPaylines(winningIndices);

                if (hasWin) {
                    document.getElementById('slotInfo').textContent = `Won on ${numWins} payline(s)! Total: ${totalPayout.toFixed(2)}`;
                } else {
                    document.getElementById('slotInfo').textContent = 'Try Again!';
                }
                return { hasWin, numWins, winningIndices, totalPayout };
            },
            
            highlightPath(paylineIndex, payline) {
                payline.forEach((row, reelIndex) => {
                    const strip = document.querySelectorAll('.reel .strip')[reelIndex];
                    const symbolsInStrip = strip.querySelectorAll('.symbol');
                    const visibleIndex = symbolsInStrip.length - (SLOT_CONFIG.visibleSymbols - row);
                    symbolsInStrip[visibleIndex].classList.add('win');
                });
                setTimeout(() => {
                    payline.forEach((row, reelIndex) => {
                        const strip = document.querySelectorAll('.reel .strip')[reelIndex];
                        const symbolsInStrip = strip.querySelectorAll('.symbol');
                        const visibleIndex = symbolsInStrip.length - (SLOT_CONFIG.visibleSymbols - row);
                        symbolsInStrip[visibleIndex].classList.remove('win');
                    });
                    this.drawPaylines([]);
                }, 3000);
            },
            
            showCongrats(orderAmount, numWins, totalPayout, winningIndices) {
                const congratsDiv = document.createElement('div');
                congratsDiv.classList.add('slot-congrats');
                congratsDiv.innerHTML = `QUANTUM EXTRAVAGANZA!<br>WON ${totalPayout.toFixed(2)}<br>Paylines: ${winningIndices.map(i => i+1).join(', ')}`;
                document.querySelector('.slot-machine').appendChild(congratsDiv);
                setTimeout(() => {
                    congratsDiv.remove();
                }, 5000);
            }
        };

        // ========== CRYPTO SIMULATOR ==========
        const CryptoSimulator = {
            coins: [
                { id: 'bitcoin', symbol: 'btc', name: 'Bitcoin', price: 45000, change: 2.5, decimals: 8 },
                { id: 'ethereum', symbol: 'eth', name: 'Ethereum', price: 3000, change: 1.8, decimals: 18 },
                { id: 'planck-coin', symbol: 'plk', name: 'Planck Coin', price: 0.00000001, change: 15.7, decimals: 24 },
                { id: 'nano-token', symbol: 'nano', name: 'Nano Token', price: 0.0001, change: 8.3, decimals: 18 },
                { id: 'micro-cap', symbol: 'micro', name: 'Micro Cap', price: 0.001, change: 5.2, decimals: 12 }
            ],
            
            async updatePrices() {
                const useLiveData = document.getElementById('liveDataToggle').checked;
                
                if (useLiveData) {
                    try {
                        // Using a CORS proxy to bypass restrictions
                        const proxyUrl = 'https://cors-anywhere.herokuapp.com/';
                        const apiUrl = 'https://api.coingecko.com/api/v3/coins/markets?vs_currency=usd&ids=bitcoin,ethereum&per_page=2';
                        
                        const response = await fetch(proxyUrl + apiUrl);
                        const data = await response.json();
                        
                        data.forEach(coin => {
                            const existingCoin = this.coins.find(c => c.id === coin.id);
                            if (existingCoin) {
                                existingCoin.price = coin.current_price;
                                existingCoin.change = coin.price_change_percentage_24h;
                            }
                        });
                    } catch (error) {
                        console.error('Failed to fetch live data:', error);
                        this.simulatePriceChanges();
                    }
                } else {
                    this.simulatePriceChanges();
                }
                
                UIComponents.updatePortfolioDisplay();
            },
            
            simulatePriceChanges() {
                this.coins.forEach(coin => {
                    const change = (Math.random() * 15 - 5) / 100;
                    coin.price *= (1 + change);
                    coin.change = change * 100;
                });
            },
            
            getCoin(symbol) {
                return this.coins.find(c => c.symbol === symbol);
            },
            
            getRandomCoin() {
                return this.coins[Math.floor(Math.random() * this.coins.length)];
            },
            
            getCheapestCoin() {
                return this.coins.reduce((cheapest, coin) => 
                    coin.price < cheapest.price ? coin : cheapest, this.coins[0]);
            }
        };

        // ========== VISUAL EFFECTS ==========
        const VisualEffects = {
            createBoomParticle(x, y, isPortal) {
                const particle = document.createElement('div');
                particle.className = 'boom-particle';
                particle.style.left = `${x}px`;
                particle.style.top = `${y}px`;
                
                const colors = ['#00f0ff', '#ff00ff', '#00ffaa', '#ffaa00'];
                const color = colors[Math.floor(Math.random() * colors.length)];
                particle.style.background = `radial-gradient(circle, ${color} 0%, transparent 70%)`;
                
                document.body.appendChild(particle);
                
                const size = isPortal ? Math.random() * 25 + 15 : Math.random() * 15 + 5;
                particle.style.width = `${size}px`;
                particle.style.height = `${size}px`;
                
                const angle = Math.random() * Math.PI * 2;
                const distance = isPortal ? Math.random() * 150 + 100 : Math.random() * 80 + 40;
                
                const animation = particle.animate([
                    { transform: `translate(0, 0) scale(1)`, opacity: 1 },
                    { transform: `translate(${Math.cos(angle) * distance}px, ${Math.sin(angle) * distance}px) scale(0)`, opacity: 0 }
                ], {
                    duration: Math.random() * 1000 + 500,
                    easing: 'cubic-bezier(0.1, 0.8, 0.2, 1)'
                });
                
                animation.onfinish = () => document.body.removeChild(particle);
            },
            
            initBackgroundAnimation() {
                const canvas = document.getElementById('backgroundCanvas');
                const ctx = canvas.getContext('2d');
                
                function resizeCanvas() {
                    canvas.width = window.innerWidth;
                    canvas.height = window.innerHeight;
                }
                
                window.addEventListener('resize', resizeCanvas);
                resizeCanvas();
                
                const particles = Array.from({ length: 50 }, () => ({
                    x: Math.random() * canvas.width,
                    y: Math.random() * canvas.height,
                    vx: (Math.random() - 0.5) * 2,
                    vy: (Math.random() - 0.5) * 2,
                    radius: Math.random() * 2 + 0.5,
                    color: `hsl(${Math.random() * 60 + 180}, 100%, ${Math.random() * 30 + 50}%)`,
                    alpha: Math.random() * 0.5 + 0.1
                }));
                
                function animate() {
                    ctx.clearRect(0, 0, canvas.width, canvas.height);
                    
                    particles.forEach(p => {
                        p.x += p.vx;
                        p.y += p.vy;
                        
                        if (p.x < 0 || p.x > canvas.width) p.vx *= -1;
                        if (p.y < 0 || p.y > canvas.height) p.vy *= -1;
                        
                        ctx.beginPath();
                        ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
                        ctx.fillStyle = p.color;
                        ctx.globalAlpha = p.alpha;
                        ctx.fill();
                    });
                    
                    requestAnimationFrame(animate);
                }
                
                animate();
            }
        };

        // ========== INITIALIZATION ==========
        function init() {
            // Initialize state management
            StateManager.init();
            
            // Initialize UI components
            UIComponents.initModals();
            UIComponents.generateInvestmentCards();
            UIComponents.generateBaseGames();
            UIComponents.generateTechTreeNodes();
            UIComponents.updateUI();
            
            // Initialize slot machine
            SlotMachine.init();
            
            // Initialize visual effects
            VisualEffects.initBackgroundAnimation();
            
            // Set up event listeners
            document.getElementById('portalJump').addEventListener('click', () => GameLogic.initiatePortalJump());
            document.getElementById('generateBoom').addEventListener('click', () => GameLogic.generateBoomParticle());
            document.getElementById('liveDataToggle').addEventListener('change', () => {
                UIComponents.showMessage('Data Source Updated', 
                    document.getElementById('liveDataToggle').checked ? 
                    'Now using live market data from CoinGecko' : 
                    'Now using simulated market data');
            });
            
            // Start background processes
            startCryptoUpdates();
            startLevelProgression();
            startSweepstakesTimer();
            
            // Restore username if logged in
            if (StateManager.user.username) {
                document.getElementById('loginBtn').textContent = StateManager.user.username;
            }
        }

        // ========== BACKGROUND PROCESSES ==========
        function startCryptoUpdates() {
            setInterval(() => {
                CryptoSimulator.updatePrices();
            }, CONFIG.CRYPTO_UPDATE_INTERVAL);
        }

        function startLevelProgression() {
            setInterval(() => {
                GameLogic.addPoints(5);
            }, CONFIG.LEVEL_UP_INTERVAL);
        }

        function startSweepstakesTimer() {
            let timeLeft = StateManager.user.sweepstakesTime * 60;
            
            setInterval(() => {
                timeLeft--;
                
                if (timeLeft <= 0) {
                    timeLeft = StateManager.user.sweepstakesTime * 60;
                    StateManager.updateUser({ 
                        boomParticles: Math.min(StateManager.user.boomParticles + 1, CONFIG.BOOM_PARTICLES) 
                    });
                    UIComponents.updateUI();
                    
                    UIComponents.showMessage('Sweepstakes Reward', 'Time portal activated! +1 BOOM Particle awarded.');
                }
                
                const minutes = Math.floor(timeLeft / 60);
                const seconds = timeLeft % 60;
                document.getElementById('sweepstakesTimer').textContent = `${minutes}:${seconds.toString().padStart(2, '0')}`;
            }, 1000);
        }

        // Initialize the application when DOM is loaded
        document.addEventListener('DOMContentLoaded', init);
    </script>
</body>
</html>
