async loadAllExchanges() {
    const exchanges = Object.keys(PRODUCTION_CONFIG.EXCHANGES);
    this.logger.log('DATA_MANAGER', `Loading ${exchanges.length} exchanges`, 'info');
    
    for (const exchange of exchanges) {
        await this.loadExchangePairs(exchange);
        this.identifyLowValueCoins(exchange);
        this.updateExchangeUI(exchange);
    }
    
    this.updateDataStatus();
}
