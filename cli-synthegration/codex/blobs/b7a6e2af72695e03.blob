<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>IAMGAINZ – Coaching, Peptides &amp; Nutrition</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Inter', system-ui, -apple-system, sans-serif; background: #0a0a0a; color: #f0f0f0; line-height: 1.6; }
    .container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }

    /* Header */
    header { text-align: center; padding: 60px 0 20px; }
    .logo { font-family: 'Anton', 'Impact', sans-serif; font-size: 4.5rem; font-weight: 800; letter-spacing: -1px; background: linear-gradient(135deg, #ff6b35, #ff3c00); -webkit-background-clip: text; -webkit-text-fill-color: transparent; text-transform: uppercase; }
    .sub-logo { font-size: 1.2rem; color: #aaa; margin-top: -8px; }
    .youtube-link { display: inline-block; margin-top: 16px; color: #ff6b35; text-decoration: none; font-weight: 600; }

    /* Hero */
    .hero { text-align: center; padding: 40px 0 60px; }
    .hero h1 { font-size: 3rem; font-weight: 700; margin-bottom: 16px; }
    .hero p { font-size: 1.2rem; color: #ccc; max-width: 600px; margin: 0 auto 32px; }
    .cta-btn { display: inline-block; padding: 16px 40px; background: #ff3c00; color: #fff; font-weight: 700; border-radius: 8px; text-decoration: none; transition: background 0.2s; font-size: 1.1rem; }
    .cta-btn:hover { background: #e03400; }

    /* Stats from real client data */
    .stats { display: flex; justify-content: center; gap: 48px; margin: 20px 0 60px; flex-wrap: wrap; }
    .stat { text-align: center; background: #1a1a1a; border-radius: 12px; padding: 24px 32px; min-width: 160px; }
    .stat-number { font-size: 2.8rem; font-weight: 800; color: #ff6b35; line-height: 1.2; }
    .stat-label { font-size: 0.9rem; color: #aaa; }

    /* Section */
    .section { padding: 80px 0; }
    .section h2 { font-size: 2.2rem; text-align: center; margin-bottom: 16px; color: #fff; }
    .section .subtitle { text-align: center; color: #aaa; margin-bottom: 48px; font-size: 1.1rem; }
    .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 32px; }

    .card { background: #1a1a1a; border-radius: 16px; padding: 36px 28px; transition: transform 0.2s; border: 1px solid #2a2a2a; }
    .card:hover { transform: translateY(-4px); border-color: #ff3c00; }
    .card h3 { font-size: 1.5rem; margin-bottom: 12px; color: #ff6b35; }
    .card p { color: #bbb; margin-bottom: 16px; }
    .card .price { font-weight: 700; color: #fff; }
    .card a { color: #ff6b35; text-decoration: none; font-weight: 600; }

    /* Resources list */
    .resource-grid { display: flex; flex-wrap: wrap; justify-content: center; gap: 16px; margin-top: 32px; }
    .resource-link { background: #1a1a1a; border-radius: 8px; padding: 12px 24px; color: #fff; text-decoration: none; font-weight: 600; border: 1px solid #333; transition: 0.2s; display: flex; align-items: center; gap: 8px; }
    .resource-link:hover { border-color: #ff3c00; color: #ff6b35; }

    /* Footer */
    footer { text-align: center; padding: 40px 0; color: #666; font-size: 0.9rem; border-top: 1px solid #1a1a1a; margin-top: 40px; }

    @media (max-width: 600px) {
      .logo { font-size: 2.8rem; }
      .hero h1 { font-size: 2rem; }
    }
  </style>
</head>
