<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>LiveStream Watch Party + Video Call</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: system-ui, sans-serif;
      background: #0f0f0f;
      color: #fff;
      overflow: hidden;
      height: 100vh;
      display: flex;
      flex-direction: column;
    }
    .top-bar {
      padding: 12px;
      background: #1a1a1a;
      display: flex;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
    }
    .top-bar input {
      padding: 8px 12px;
      border-radius: 6px;
      border: 1px solid #444;
      background: #2a2a2a;
      color: #fff;
      flex: 1;
      min-width: 200px;
    }
    .top-bar button {
      padding: 8px 16px;
      border-radius: 6px;
      border: none;
      background: #3ea6ff;
      color: #000;
      font-weight: bold;
      cursor: pointer;
    }
    .top-bar button.stop {
      background: #ff4d4d;
    }
    .main {
      flex: 1;
      display: flex;
      gap: 8px;
      padding: 8px;
      min-height: 0;
    }
    .youtube-container {
      flex: 3;
      background: #000;
      border-radius: 8px;
      overflow: hidden;
      position: relative;
    }
    .youtube-container iframe {
      width: 100%;
      height: 100%;
      border: none;
    }
    .self-view {
      position: absolute;
      bottom: 10px;
      right: 10px;
      width: 160px;
      height: 120px;
      background: #222;
      border-radius: 8px;
      overflow: hidden;
      border: 2px solid #3ea6ff;
    }
    .self-view video {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .participants {
      flex: 1;
      background: #1a1a1a;
      border-radius: 8px;
      padding: 8px;
      display: flex;
      flex-direction: column;
      gap: 8px;
      overflow-y: auto;
      min-width: 200px;
    }
    .participant-video {
      width: 100%;
      aspect-ratio: 4/3;
      background: #2a2a2a;
      border-radius: 6px;
      overflow: hidden;
      position: relative;
    }
    .participant-video video {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .participant-label {
      position: absolute;
      bottom: 4px;
      left: 4px;
      background: rgba(0,0,0,0.6);
      padding: 2px 6px;
      border-radius: 4px;
      font-size: 0.8rem;
    }
  </style>
</head>
<body>
  <div class="top-bar">
    <input type="text" id="youtubeUrl" placeholder="YouTube Live video ID or URL" value="jfKfPfyJRdk">
    <button id="loadBtn">Watch</button>
    <button id="broadcastBtn">Start Broadcast</button>
    <button id="stopBroadcastBtn" class="stop" style="display:none;">Stop Broadcast</button>
    <span style="margin-left:auto;">🔴 Broadcast: <span id="status">off</span></span>
  </div>
  <div class="main">
    <div class="youtube-container">
      <div id="player"></div>
      <div class="self-view" id="selfView" style="display:none;">
        <video id="localVideo" autoplay muted playsinline></video>
      </div>
    </div>
    <div class="participants" id="participantsGrid">
      <div style="color:#888; text-align:center; padding-top:20px;">No remote participants yet. Open another tab to join.</div>
    </div>
  </div>

  <!-- YouTube IFrame API -->
  <script>
    // Load YouTube IFrame API
    const tag = document.createElement('script');
    tag.src = "https://www.youtube.com/iframe_api";
    const firstScriptTag = document.getElementsByTagName('script')[0];
    firstScriptTag.parentNode.insertBefore(tag, firstScriptTag);

    // ----- YouTube Player -----
    let player;
    function onYouTubeIframeAPIReady() {
      player = new YT.Player('player', {
        height: '100%',
        width: '100%',
        videoId: '',
        playerVars: {
          autoplay: 1,
          controls: 1,
          modestbranding: 1,
        },
        events: {
          'onReady': onPlayerReady,
        }
      });
    }
    function onPlayerReady(event) {
      // When ready, load the default video
      loadVideo();
    }
    function loadVideo() {
      const input = document.getElementById('youtubeUrl').value.trim();
      let videoId = input;
      // Extract video ID from URL if needed
      const patterns = [
        /(?:youtube\.com\/watch\?v=|youtu\.be\/|youtube\.com\/live\/)([a-zA-Z0-9_-]{11})/,
      ];
      for (const p of patterns) {
        const m = input.match(p);
        if (m) { videoId = m[1]; break; }
      }
      if (videoId && player && player.loadVideoById) {
        player.loadVideoById(videoId);
      }
    }
    document.getElementById('loadBtn').addEventListener('click', loadVideo);

    // ----- WebRTC & Broadcast -----
    const CHANNEL_NAME = 'livestream-watchparty';
    const bc = new BroadcastChannel(CHANNEL_NAME);
    const myId = Date.now().toString(36) + Math.random().toString(36).substr(2, 5);
    console.log('My ID:', myId);

    let localStream = null;
    const peerConnections = new Map(); // peerId -> RTCPeerConnection
    const remoteStreams = new Map();   // peerId -> MediaStream (for video elements)

    // DOM Elements
    const localVideo = document.getElementById('localVideo');
    const selfView = document.getElementById('selfView');
    const broadcastBtn = document.getElementById('broadcastBtn');
    const stopBroadcastBtn = document.getElementById('stopBroadcastBtn');
    const statusSpan = document.getElementById('status');
    const participantsGrid = document.getElementById('participantsGrid');

    // Start/stop local broadcast
    broadcastBtn.addEventListener('click', startBroadcast);
    stopBroadcastBtn.addEventListener('click', stopBroadcast);

    async function startBroadcast() {
      try {
        localStream = await navigator.mediaDevices.getUserMedia({ video: true, audio: true });
        localVideo.srcObject = localStream;
        selfView.style.display = 'block';
        broadcastBtn.style.display = 'none';
        stopBroadcastBtn.style.display = 'inline-block';
        statusSpan.textContent = 'on';
        // Announce ourselves to the room
        bc.postMessage({ type: 'join', id: myId });
        console.log('Broadcasting started, joining room');
      } catch (err) {
        alert('Camera/mic access denied: ' + err.message);
      }
    }

    function stopBroadcast() {
      // Hang up all connections
      for (const pc of peerConnections.values()) {
        pc.close();
      }
      peerConnections.clear();
      remoteStreams.clear();
      // Stop local tracks
      if (localStream) {
        localStream.getTracks().forEach(track => track.stop());
        localStream = null;
      }
      localVideo.srcObject = null;
      selfView.style.display = 'none';
      broadcastBtn.style.display = 'inline-block';
      stopBroadcastBtn.style.display = 'none';
      statusSpan.textContent = 'off';
      // Clear remote video grid
      participantsGrid.innerHTML = '<div style="color:#888;text-align:center;padding-top:20px;">No remote participants.</div>';
      // Announce leave
      bc.postMessage({ type: 'leave', id: myId });
    }

    // Handle incoming signalling messages
    bc.onmessage = (event) => {
      const msg = event.data;
      if (!msg || msg.id === myId) return; // ignore own messages

      if (msg.type === 'join') {
        // A new peer joined, initiate connection as offerer
        handleNewPeer(msg.id);
      }
      else if (msg.type === 'offer' && msg.to === myId) {
        handleOffer(msg.from, msg.sdp);
      }
      else if (msg.type === 'answer' && msg.to === myId) {
        handleAnswer(msg.from, msg.sdp);
      }
      else if (msg.type === 'ice-candidate' && msg.to === myId) {
        handleIceCandidate(msg.from, msg.candidate);
      }
      else if (msg.type === 'leave') {
        handlePeerLeave(msg.id);
      }
    };

    // Offerer side: create connection to a new peer
    function handleNewPeer(peerId) {
      if (peerConnections.has(peerId)) return;
      const pc = createPeerConnection(peerId);
      // Add local tracks to new connection
      if (localStream) {
        localStream.getTracks().forEach(track => pc.addTrack(track, localStream));
      }
      // Create offer
      pc.createOffer()
        .then(offer => {
          return pc.setLocalDescription(offer);
        })
        .then(() => {
          bc.postMessage({ type: 'offer', sdp: pc.localDescription, from: myId, to: peerId });
        })
        .catch(err => console.error('Error creating offer:', err));
    }

    // Answerer side: handle incoming offer
    async function handleOffer(peerId, sdp) {
      if (peerConnections.has(peerId)) {
        // already connected, maybe renegotiate? For simplicity, ignore.
        return;
      }
      const pc = createPeerConnection(peerId);
      if (localStream) {
        localStream.getTracks().forEach(track => pc.addTrack(track, localStream));
      }
      try {
        await pc.setRemoteDescription(new RTCSessionDescription(sdp));
        const answer = await pc.createAnswer();
        await pc.setLocalDescription(answer);
        bc.postMessage({ type: 'answer', sdp: pc.localDescription, from: myId, to: peerId });
      } catch (err) {
        console.error('Error handling offer:', err);
      }
    }

    // Offerer side: handle answer
    async function handleAnswer(peerId, sdp) {
      const pc = peerConnections.get(peerId);
      if (!pc) return;
      try {
        await pc.setRemoteDescription(new RTCSessionDescription(sdp));
      } catch (err) {
        console.error('Error setting remote description from answer:', err);
      }
    }

    // Handle ICE candidate
    function handleIceCandidate(peerId, candidate) {
      const pc = peerConnections.get(peerId);
      if (!pc) return;
      try {
        pc.addIceCandidate(new RTCIceCandidate(candidate));
      } catch (err) {
        console.error('Error adding ICE candidate:', err);
      }
    }

    // Remove peer when they leave
    function handlePeerLeave(peerId) {
      const pc = peerConnections.get(peerId);
      if (pc) {
        pc.close();
        peerConnections.delete(peerId);
      }
      // Remove the video element for this peer
      const videoEl = document.getElementById(`remote-${peerId}`);
      if (videoEl) videoEl.parentElement.remove();
      remoteStreams.delete(peerId);
      if (participantsGrid.children.length === 0) {
        participantsGrid.innerHTML = '<div style="color:#888;text-align:center;padding-top:20px;">No remote participants.</div>';
      }
    }

    // Create and configure RTCPeerConnection
    function createPeerConnection(peerId) {
      const configuration = { iceServers: [{ urls: 'stun:stun.l.google.com:19302' }] };
      const pc = new RTCPeerConnection(configuration);
      peerConnections.set(peerId, pc);

      // Send ICE candidates
      pc.onicecandidate = (event) => {
        if (event.candidate) {
          bc.postMessage({
            type: 'ice-candidate',
            candidate: event.candidate,
            from: myId,
            to: peerId
          });
        }
      };

      // Handle incoming remote stream
      pc.ontrack = (event) => {
        const remoteStream = event.streams[0];
        if (!remoteStream) return;
        remoteStreams.set(peerId, remoteStream);
        // Add or update video element
        let videoEl = document.getElementById(`remote-${peerId}`);
        if (!videoEl) {
          // Create container
          const container = document.createElement('div');
          container.className = 'participant-video';
          videoEl = document.createElement('video');
          videoEl.id = `remote-${peerId}`;
          videoEl.autoplay = true;
          videoEl.playsInline = true;
          videoEl.muted = false; // unmute remote for demo
          const label = document.createElement('div');
          label.className = 'participant-label';
          label.textContent = `Peer ${peerId.slice(-4)}`;
          container.appendChild(videoEl);
          container.appendChild(label);
          // Remove placeholder if present
          const placeholder = participantsGrid.querySelector('div:first-child');
          if (placeholder && placeholder.textContent.includes('No remote participants')) {
            placeholder.remove();
          }
          participantsGrid.appendChild(container);
        }
        // Set stream
        if (videoEl.srcObject !== remoteStream) {
          videoEl.srcObject = remoteStream;
        }
      };

      pc.onconnectionstatechange = () => {
        if (pc.connectionState === 'failed' || pc.connectionState === 'disconnected') {
          handlePeerLeave(peerId);
        }
      };

      return pc;
    }

    // Clean up on page unload
    window.addEventListener('beforeunload', () => {
      bc.postMessage({ type: 'leave', id: myId });
      // Close all connections
      for (const pc of peerConnections.values()) {
        pc.close();
      }
      if (localStream) {
        localStream.getTracks().forEach(track => track.stop());
      }
    });
  </script>
</body>
</html>
