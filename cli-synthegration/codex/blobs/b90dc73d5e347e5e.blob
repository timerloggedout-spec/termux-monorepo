function createPipPlayer() {
  pipPlayer = new YT.Player('pipPlayer', {
    videoId: '',
    playerVars: {
      autoplay: 1,
      controls: 0,
      modestbranding: 1,
      mute: 1,
    },
    events: {
      'onReady': () => {
        // Load current video if any
        const currentVideoId = player.getVideoData()?.video_id;
        if (currentVideoId) pipPlayer.loadVideoById(currentVideoId);
      }
    }
  });
}
