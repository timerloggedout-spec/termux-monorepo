class DiagnosticLogger {
    constructor() {
        this.logs = [];
    }

    log(category, message, data = null) {
        const timestamp = new Date().toISOString();
        const logEntry = { timestamp, category, message, data };
        this.logs.push(logEntry);
        
        // Also print to console for immediate debugging
        console.log(`[${category}] ${message}`, data || '');
    }

    exportScanSummary(scanParams, opportunities, duration) {
        this.log('SCAN_SUMMARY', `Scan completed in ${duration}ms`, {
            parameters: scanParams,
            opportunitiesFound: opportunities.length,
            topOpportunities: opportunities.slice(0, 3) // Log the top 3
        });
    }
}
