<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>🎰 QuanTM FOAM v11 - Arbitrage Casino (17 Exchanges)</title>
    <style>
        :root {
            --pink: #ff00ff; --cyan: #00f0ff; --green: #00ffaa; --gold: #ffd700;
            --bg: #0a0a1a; --card: #1a1a2a; --border: #2a2a3a;
        }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            background: #0a0a1a; color: #a0a0ff; font-family: 'Courier New', monospace;
            font-size: 11px; overflow-x: hidden;
        }
        canvas#particleCanvas {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            pointer-events: none; z-index: 9999;
        }
        .container { max-width: 1500px; margin: 0 auto; padding: 10px; position: relative; z-index: 1; }
        h1 {
            color: var(--gold); font-size: 20px; text-shadow: 0 0 15px var(--pink), 0 0 25px var(--cyan);
            margin-bottom: 8px; letter-spacing: 2px;
        }
        .status-bar {
            padding: 10px 15px; margin: 10px 0; background: linear-gradient(145deg, #0a0a1a, #1a1a2a);
            border-radius: 10px; border-left: 5px solid var(--cyan); font-weight: bold;
            display: flex; justify-content: space-between; align-items: center;
            box-shadow: 0 0 20px rgba(0, 240, 255, 0.3);
        }
        .controls { display: flex; flex-wrap: wrap; gap: 8px; margin: 12px 0; }
        button {
            background: #111; border: 2px solid var(--pink); color: var(--pink);
            padding: 8px 15px; border-radius: 25px; font-size: 10px; font-weight: bold;
            cursor: pointer; font-family: 'Courier New', monospace; transition: all 0.2s;
            text-transform: uppercase; letter-spacing: 1px; box-shadow: 0 0 10px var(--pink);
        }
        button:hover { background: var(--pink); color: #000; box-shadow: 0 0 25px var(--pink); }
        button:active { transform: scale(0.95); }
        button.cyan { border-color: var(--cyan); color: var(--cyan); box-shadow: 0 0 10px var(--cyan); }
        button.cyan:hover { background: var(--cyan); color: #000; }
        button:disabled { opacity: 0.4; cursor: not-allowed; }
        .grid {
            display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 12px; margin: 12px 0;
        }
        .card {
            background: var(--card); border-radius: 12px; padding: 14px;
            border: 1px solid var(--border); box-shadow: 0 0 15px rgba(255, 0, 255, 0.15);
            transition: all 0.3s;
        }
        .card:hover { border-color: var(--pink); box-shadow: 0 0 30px rgba(255, 0, 255, 0.4); }
        .card h3 { color: var(--cyan); font-size: 13px; margin-bottom: 10px; }
        .exchange-status {
            display: flex; align-items: center; gap: 8px; padding: 5px;
            background: #0a0a1a; border-radius: 6px; margin: 3px 0; font-size: 10px;
            border: 1px solid #2a2a3a;
        }
        .indicator {
            width: 8px; height: 8px; border-radius: 50%; background: #ff4444;
            box-shadow: 0 0 8px #ff4444; flex-shrink: 0;
        }
        .indicator.online { background: var(--green); box-shadow: 0 0 12px var(--green); animation: pulse 1.5s infinite; }
        @keyframes pulse {
            0%, 100% { opacity: 1; box-shadow: 0 0 8px var(--green); }
            50% { opacity: 0.4; box-shadow: 0 0 22px var(--green); }
        }
        .stat { display: flex; justify-content: space-between; padding: 4px 0; font-size: 11px; }
        .stat-value { color: var(--gold); font-weight: bold; }
        .rolling-number { font-size: 16px; color: var(--gold); font-weight: bold; }
        .opp-section { margin: 12px 0; padding: 10px; background: #0f0f1f; border-radius: 8px; border: 1px solid #2a2a3a; }
        .opp-header {
            display: flex; justify-content: space-between; align-items: center;
            padding: 10px; background: #1a1a2a; border-radius: 8px; cursor: pointer;
            font-weight: bold; color: var(--pink);
        }
        .opp-list { max-height: 450px; overflow-y: auto; }
        .opportunity {
            background: #111; padding: 10px; margin: 6px 0; border-radius: 8px;
            border-left: 5px solid var(--green); cursor: pointer; transition: all 0.2s;
        }
        .opportunity:hover { border-left-color: var(--pink); background: #1a1a2a; box-shadow: 0 0 15px rgba(255, 0, 255, 0.4); }
        .opportunity.mega { border-left-color: var(--gold); animation: glow 1s infinite alternate; }
        @keyframes glow {
            from { box-shadow: 0 0 5px var(--gold); }
            to { box-shadow: 0 0 25px var(--gold); }
        }
        .path-visual { font-size: 9px; color: var(--cyan); margin: 5px 0; }
        .depth-info { font-size: 8px; color: #ffaa00; }
        .log-container {
            background: #000; padding: 10px; border-radius: 8px;
            max-height: 200px; overflow-y: auto; font-size: 9px;
        }
        .log-entry { padding: 2px 0; border-bottom: 1px solid #222; }
        .error { color: #ff4444; } .success { color: #00ff00; } .warning { color: #ffaa00; } .info { color: #00f0ff; }
        .bet-slider { width: 100%; margin: 8px 0; appearance: none; height: 6px; border-radius: 3px; background: #333; }
        .bet-slider::-webkit-slider-thumb { appearance: none; width: 22px; height: 22px; background: var(--pink); border-radius: 50%; box-shadow: 0 0 12px var(--pink); }
        .modal {
            display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0, 0, 0, 0.85); z-index: 10000; align-items: center; justify-content: center;
        }
        .modal-content {
            background: #1a1a2a; border: 2px solid var(--pink); border-radius: 15px;
            padding: 25px; max-width: 500px; width: 90%; color: white;
        }
        .chip {
            background: var(--pink); color: #000; padding: 2px 8px; border-radius: 12px;
            font-size: 9px; font-weight: bold; display: inline-block;
        }
        .flex-row { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
        @media (max-width: 768px) {
            .grid { grid-template-columns: 1fr; }
            .controls { justify-content: center; }
        }
    </style>
</head>
<body>
    <canvas id="particleCanvas"></canvas>
    <div class="container">
        <h1>🎰 QUANTM FOAM v11 <span style="font-size:13px;">ARBITRAGE CASINO · 17 EXCHANGES</span></h1>

        <div class="status-bar" id="mainStatus">🟡 READY TO SPIN</div>

        <div class="controls">
            <button class="cyan" onclick="initSystem()">🔄 INIT</button>
            <button id="scanBtn" onclick="runFullScan()" disabled>🎲 FULL SCAN</button>
            <button onclick="scanMicroCaps()">💎 MICRO</button>
            <button class="cyan" onclick="connectWebSockets()">📡 LIVE</button>
            <button onclick="toggleLogs()">📋 LOGS</button>
            <button onclick="shareJackpot()">📤 SHARE</button>
            <button onclick="toggleTheme()">🎨 THEME</button>
        </div>

        <div class="flex-row" style="margin:10px 0; background:#1a1a2a; padding:12px; border-radius:12px;">
            <span style="color:var(--gold);font-size:14px;">💰 BANKROLL:</span>
            <span class="rolling-number" id="bankroll">$10,000.00</span>
            <span style="margin-left:auto;color:var(--cyan);">📈 P/L:</span>
            <span id="pnl" style="color:var(--green);font-size:14px;">$0.00 (0.00%)</span>
        </div>

        <h2>⚡ EXCHANGE STATUS</h2>
        <div class="grid" id="exchangeStatus"></div>

        <div class="grid">
            <div class="card">
                <h3>🔥 ULTRA LOW (<$0.0001)</h3>
                <div id="ultraLowValue" style="max-height:200px; overflow-y:auto;"></div>
            </div>
            <div class="card">
                <h3>💧 MICRO CAP (<$0.001)</h3>
                <div id="microCap" style="max-height:200px; overflow-y:auto;"></div>
            </div>
            <div class="card">
                <h3>📊 STATISTICS</h3>
                <div class="stat"><span>Pairs:</span><span class="stat-value" id="totalPairs">0</span></div>
                <div class="stat"><span>Nodes:</span><span class="stat-value" id="graphNodes">0</span></div>
                <div class="stat"><span>Edges:</span><span class="stat-value" id="graphEdges">0</span></div>
                <div class="stat"><span>Triangles:</span><span class="stat-value" id="triangleCount">0</span></div>
                <div class="stat"><span>API Calls:</span><span class="stat-value" id="apiCalls">0</span></div>
                <div class="stat"><span>Opps:</span><span class="stat-value rolling-number" id="oppCount">0</span></div>
            </div>
        </div>

        <div class="flex-row" style="margin:10px 0;">
            <label style="color:var(--cyan);">🎚️ BET:</label>
            <input type="range" class="bet-slider" id="betSlider" min="100" max="10000" value="1000" step="100" oninput="updateBet()">
            <span id="betDisplay" style="color:var(--gold);font-size:13px;">$1,000</span>
        </div>

        <h2>🎯 OPPORTUNITIES</h2>
        <div class="opp-section"><div class="opp-header" onclick="toggleSection('megaOpps')">🌟 MEGA JACKPOTS (>5%) <span id="megaCount">0</span></div><div id="megaOpps" class="opp-list"></div></div>
        <div class="opp-section"><div class="opp-header" onclick="toggleSection('triangularOpps')">📐 TRIANGULAR <span id="triangularCount">0</span></div><div id="triangularOpps" class="opp-list"></div></div>
        <div class="opp-section"><div class="opp-header" onclick="toggleSection('bellmanOpps')">🔍 BELLMAN-FORD <span id="bellmanCount">0</span></div><div id="bellmanOpps" class="opp-list"></div></div>
        <div class="opp-section"><div class="opp-header" onclick="toggleSection('microOpps')">💎 MICRO <span id="microCount">0</span></div><div id="microOpps" class="opp-list"></div></div>

        <h2 style="cursor:pointer;" onclick="toggleLogs()">📜 LOGS</h2>
        <div class="log-container" id="logs" style="display:none;"></div>
    </div>

    <!-- Trade Modal -->
    <div id="tradeModal" class="modal">
        <div class="modal-content">
            <h3 style="color:var(--gold);">🎰 EXECUTE ARBITRAGE</h3>
            <div id="tradeDetails"></div>
            <div style="margin-top:15px;display:flex;gap:10px;justify-content:flex-end;">
                <button onclick="closeModal()">CANCEL</button>
                <button class="cyan" id="executeTradeBtn">💸 PULL LEVER</button>
            </div>
        </div>
    </div>

    <script>
        // ==================== AUDIO ====================
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        function playTone(f, d, t='square', v=0.08) {
            const o = audioCtx.createOscillator(), g = audioCtx.createGain();
            o.type = t; o.frequency.value = f;
            g.gain.setValueAtTime(v, audioCtx.currentTime);
            g.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + d);
            o.connect(g); g.connect(audioCtx.destination);
            o.start(); o.stop(audioCtx.currentTime + d);
        }
        function playSpin() { playTone(800, 0.1, 'sawtooth', 0.04); }
        function playWin() { playTone(523, 0.12); setTimeout(()=>playTone(659,0.12),120); setTimeout(()=>playTone(784,0.2),240); }
        function playJackpot() { [523,659,784,1047].forEach((f,i)=>setTimeout(()=>playTone(f,0.25,'square',0.12),i*140)); }

        // ==================== PARTICLES ====================
        const canvas = document.getElementById('particleCanvas');
        const ctx = canvas.getContext('2d');
        let particles = [];
        function resize() { canvas.width = innerWidth; canvas.height = innerHeight; }
        window.addEventListener('resize', resize); resize();
        class Particle {
            constructor(x,y,vx,vy,c,l) { this.x=x;this.y=y;this.vx=vx;this.vy=vy;this.color=c;this.life=l; }
        }
        function anim() {
            ctx.clearRect(0,0,canvas.width,canvas.height);
            for(let i=particles.length-1;i>=0;i--) {
                const p=particles[i];
                p.x+=p.vx; p.y+=p.vy; p.vy+=0.08; p.life-=0.015;
                ctx.fillStyle=p.color; ctx.globalAlpha=Math.max(0,p.life);
                ctx.fillRect(p.x,p.y,4,4);
                if(p.life<=0) particles.splice(i,1);
            }
            requestAnimationFrame(anim);
        }
        anim();
        function confetti(x,y,n=35) {
            const cols=['#ff00ff','#00f0ff','#ffd700','#00ffaa'];
            for(let i=0;i<n;i++) particles.push(new Particle(x,y,(Math.random()-0.5)*9,(Math.random()-0.5)*8-4,cols[Math.floor(Math.random()*cols.length)],0.7+Math.random()*0.5));
        }

        // ==================== STATE ====================
        const state = {
            exchanges: {},
            opportunities: { mega:[], triangular:[], bellman:[], micro:[] },
            stats: { totalPairs:0, graphNodes:0, graphEdges:0, triangleCount:0, apiCalls:0, oppCount:0 },
            systemReady: false, graph: {}, triangles: [], allPairs: [],
            bankroll: 10000, trades: []
        };

        const exchangeDefs = [
            { key:'okx', name:'OKX', url:'https://www.okx.com/api/v5/market/tickers?instType=SPOT', type:'okx' },
            { key:'coinbase', name:'Coinbase', url:'https://api.exchange.coinbase.com/products', type:'coinbase' },
            { key:'binance', name:'Binance', url:'https://api.binance.com/api/v3/ticker/24hr', type:'binance' },
            { key:'kucoin', name:'KuCoin', url:'https://api.kucoin.com/api/v1/market/allTickers', type:'kucoin' },
            { key:'bybit', name:'Bybit', url:'https://api.bybit.com/v5/market/tickers?category=spot', type:'bybit' },
            { key:'gate', name:'Gate.io', url:'https://api.gateio.ws/api/v4/spot/tickers', type:'gate' },
            { key:'mexc', name:'MEXC', url:'https://api.mexc.com/api/v3/ticker/24hr', type:'mexc' },
            { key:'kraken', name:'Kraken', url:'https://api.kraken.com/0/public/Ticker?pair=ALL', type:'kraken' },
            { key:'bitstamp', name:'Bitstamp', url:'https://www.bitstamp.net/api/v2/ticker/', type:'bitstamp' },
            { key:'indodax', name:'Indodax', url:'https://indodax.com/api/tickers', type:'indodax' },
            { key:'yobit', name:'Yobit', url:'https://yobit.net/api/3/info', type:'yobit' },
            { key:'alpaca', name:'Alpaca Crypto', url:'https://data.alpaca.markets/v1beta3/crypto/latest/trades?symbols=BTCUSD,ETHUSD', type:'alpaca' },
            { key:'dexscreener_eth', name:'DexScreener ETH', url:'https://api.dexscreener.com/latest/dex/search?q=ETH', type:'dexscreener' },
            { key:'dexscreener_bsc', name:'DexScreener BSC', url:'https://api.dexscreener.com/latest/dex/search?q=BNB', type:'dexscreener' },
            { key:'dexscreener_polygon', name:'DexScreener Polygon', url:'https://api.dexscreener.com/latest/dex/search?q=MATIC', type:'dexscreener' },
            { key:'dexscreener_arb', name:'DexScreener Arbitrum', url:'https://api.dexscreener.com/latest/dex/search?q=ARB', type:'dexscreener' },
            { key:'dexscreener_sol', name:'DexScreener Solana', url:'https://api.dexscreener.com/latest/dex/search?q=SOL', type:'dexscreener' },
        ];

        exchangeDefs.forEach(d => {
            state.exchanges[d.key] = { name:d.name, status:'offline', pairs:[], bytesReceived:0, url:d.url, type:d.type };
        });

        function log(msg, type='info') {
            const t = new Date().toLocaleTimeString();
            document.getElementById('logs').innerHTML = `<div class="log-entry ${type}">[${t}] ${msg}</div>` + document.getElementById('logs').innerHTML;
            console.log(`[${t}] ${msg}`);
        }
        function updateStatus(msg) { document.getElementById('mainStatus').innerHTML = msg; }
        function updateStats() {
            document.getElementById('totalPairs').textContent = state.stats.totalPairs;
            document.getElementById('graphNodes').textContent = state.stats.graphNodes;
            document.getElementById('graphEdges').textContent = state.stats.graphEdges;
            document.getElementById('triangleCount').textContent = state.stats.triangleCount;
            document.getElementById('apiCalls').textContent = state.stats.apiCalls;
            document.getElementById('oppCount').textContent = state.stats.oppCount;
            document.getElementById('megaCount').textContent = state.opportunities.mega.length;
            document.getElementById('triangularCount').textContent = state.opportunities.triangular.length;
            document.getElementById('bellmanCount').textContent = state.opportunities.bellman.length;
            document.getElementById('microCount').textContent = state.opportunities.micro.length;
            document.getElementById('bankroll').textContent = '$'+state.bankroll.toFixed(2);
            const pnlPct = ((state.bankroll-10000)/10000*100).toFixed(2);
            document.getElementById('pnl').innerHTML = `$${(state.bankroll-10000).toFixed(2)} (${pnlPct}%)`;
            document.getElementById('pnl').style.color = state.bankroll>=10000 ? 'var(--green)' : '#ff4444';
        }
        function updateBet() {
            document.getElementById('betDisplay').textContent = '$'+Number(document.getElementById('betSlider').value).toLocaleString();
        }
        function toggleLogs() { const el=document.getElementById('logs'); el.style.display = el.style.display==='none'?'block':'none'; }
        function toggleSection(id) { const el=document.getElementById(id); el.style.display = el.style.display==='none'?'block':'none'; }
        function updateExchangeDisplay() {
            const c = document.getElementById('exchangeStatus');
            c.innerHTML = '';
            Object.values(state.exchanges).forEach(ex => {
                c.innerHTML += `<div class="exchange-status">
                    <div class="indicator ${ex.status==='online'?'online':''}"></div>
                    <div><strong>${ex.name}</strong><br><small>${ex.status.toUpperCase()} · ${ex.pairs.length} pairs</small></div>
                </div>`;
            });
        }

        // ==================== API LOADERS ====================
        function normalizePairs(pairs, exchangeKey) {
            return pairs.filter(p => p && p.price > 0).map(p => ({ ...p, exchange: exchangeKey }));
        }

        async function loadOKX() {
            try {
                const r = await fetch(state.exchanges.okx.url);
                if(!r.ok) throw new Error('HTTP '+r.status);
                const d = await r.json(); state.stats.apiCalls++;
                const pairs = (d.data||[]).slice(0,500).map(t => {
                    const parts = t.instId.split('-'); if(parts.length!==2) return null;
                    const price = parseFloat(t.last)||0;
                    const vol = parseFloat(t.volCcy24h)*price||0;
                    return { base:parts[0], target:parts[1], price, volume:vol, liquidity:vol,
                        bidPrice:parseFloat(t.bidPx)||price*0.999, askPrice:parseFloat(t.askPx)||price*1.001,
                        spread:0 };
                }).filter(Boolean);
                state.exchanges.okx.pairs = normalizePairs(pairs, 'okx');
                state.exchanges.okx.status = 'online';
                log(`OKX: ${state.exchanges.okx.pairs.length} pairs`, 'success');
            } catch(e) { state.exchanges.okx.status='offline'; log('OKX: '+e.message,'error'); }
        }

        async function loadCoinbase() {
            try {
                const r = await fetch(state.exchanges.coinbase.url);
                if(!r.ok) throw new Error('HTTP '+r.status);
                const d = await r.json(); state.stats.apiCalls++;
                const pairs = d.slice(0,300).map(p => ({
                    base:p.base_currency, target:p.quote_currency, price:p.price||1,
                    volume:p.volume*p.price||0, liquidity:p.volume*p.price||0,
                    bidPrice:p.price*0.998, askPrice:p.price*1.002, spread:0.004
                }));
                state.exchanges.coinbase.pairs = normalizePairs(pairs, 'coinbase');
                state.exchanges.coinbase.status = 'online';
                log(`Coinbase: ${state.exchanges.coinbase.pairs.length} pairs`, 'success');
            } catch(e) { state.exchanges.coinbase.status='offline'; log('Coinbase: '+e.message,'error'); }
        }

        async function loadBinance() {
            try {
                const r = await fetch(state.exchanges.binance.url);
                if(!r.ok) throw new Error('HTTP '+r.status);
                const d = await r.json(); state.stats.apiCalls++;
                const pairs = (Array.isArray(d)?d:[]).slice(0,500).map(t => {
                    const price = parseFloat(t.lastPrice)||0;
                    const vol = parseFloat(t.quoteVolume)*price||0;
                    return { base:t.symbol?.replace(/USDT$|BTC$|ETH$|BNB$/,'')||t.symbol,
                        target:t.symbol?.includes('USDT')?'USDT':t.symbol?.includes('BTC')?'BTC':'ETH',
                        price, volume:vol, liquidity:vol,
                        bidPrice:parseFloat(t.bidPrice)||price*0.999, askPrice:parseFloat(t.askPrice)||price*1.001,
                        spread:0 };
                }).filter(p=>p.price>0);
                state.exchanges.binance.pairs = normalizePairs(pairs, 'binance');
                state.exchanges.binance.status = 'online';
                log(`Binance: ${state.exchanges.binance.pairs.length} pairs`, 'success');
            } catch(e) { state.exchanges.binance.status='offline'; log('Binance: '+e.message,'error'); }
        }

        async function loadKuCoin() {
            try {
                const r = await fetch(state.exchanges.kucoin.url);
                if(!r.ok) throw new Error('HTTP '+r.status);
                const d = await r.json(); state.stats.apiCalls++;
                const tickers = d?.data?.ticker || [];
                const pairs = tickers.slice(0,400).map(t => {
                    const price = parseFloat(t.last)||0;
                    const vol = parseFloat(t.volValue)*price||0;
                    return { base:t.symbol?.split('-')[0]||t.symbol, target:t.symbol?.split('-')[1]||'USDT',
                        price, volume:vol, liquidity:vol,
                        bidPrice:parseFloat(t.buy)||price*0.999, askPrice:parseFloat(t.sell)||price*1.001,
                        spread:0 };
                }).filter(p=>p.price>0);
                state.exchanges.kucoin.pairs = normalizePairs(pairs, 'kucoin');
                state.exchanges.kucoin.status = 'online';
                log(`KuCoin: ${state.exchanges.kucoin.pairs.length} pairs`, 'success');
            } catch(e) { state.exchanges.kucoin.status='offline'; log('KuCoin: '+e.message,'error'); }
        }

        async function loadBybit() {
            try {
                const r = await fetch(state.exchanges.bybit.url);
                if(!r.ok) throw new Error('HTTP '+r.status);
                const d = await r.json(); state.stats.apiCalls++;
                const pairs = (d?.result?.list||[]).slice(0,300).map(t => {
                    const price = parseFloat(t.lastPrice)||0;
                    const vol = parseFloat(t.volume24h)*price||0;
                    return { base:t.symbol?.replace(/USDT$|USDC$/,'')||t.symbol, target:'USDT',
                        price, volume:vol, liquidity:vol,
                        bidPrice:parseFloat(t.bid1Price)||price*0.999, askPrice:parseFloat(t.ask1Price)||price*1.001,
                        spread:0 };
                }).filter(p=>p.price>0);
                state.exchanges.bybit.pairs = normalizePairs(pairs, 'bybit');
                state.exchanges.bybit.status = 'online';
                log(`Bybit: ${state.exchanges.bybit.pairs.length} pairs`, 'success');
            } catch(e) { state.exchanges.bybit.status='offline'; log('Bybit: '+e.message,'error'); }
        }

        async function loadGate() {
            try {
                const r = await fetch(state.exchanges.gate.url);
                if(!r.ok) throw new Error('HTTP '+r.status);
                const d = await r.json(); state.stats.apiCalls++;
                const pairs = (Array.isArray(d)?d:[]).slice(0,300).map(t => {
                    const price = parseFloat(t.last)||0;
                    const vol = parseFloat(t.quote_volume)*price||0;
                    return { base:t.currency_pair?.split('_')[0]||'', target:t.currency_pair?.split('_')[1]||'USDT',
                        price, volume:vol, liquidity:vol,
                        bidPrice:parseFloat(t.highest_bid)||price*0.999, askPrice:parseFloat(t.lowest_ask)||price*1.001,
                        spread:0 };
                }).filter(p=>p.price>0&&p.base);
                state.exchanges.gate.pairs = normalizePairs(pairs, 'gate');
                state.exchanges.gate.status = 'online';
                log(`Gate.io: ${state.exchanges.gate.pairs.length} pairs`, 'success');
            } catch(e) { state.exchanges.gate.status='offline'; log('Gate.io: '+e.message,'error'); }
        }

        async function loadMEXC() {
            try {
                const r = await fetch(state.exchanges.mexc.url);
                if(!r.ok) throw new Error('HTTP '+r.status);
                const d = await r.json(); state.stats.apiCalls++;
                const pairs = (Array.isArray(d)?d:[]).slice(0,300).map(t => {
                    const price = parseFloat(t.lastPrice)||0;
                    const vol = parseFloat(t.quoteVolume)*price||0;
                    return { base:t.symbol?.replace(/USDT$/,'')||t.symbol, target:'USDT',
                        price, volume:vol, liquidity:vol,
                        bidPrice:parseFloat(t.bidPrice)||price*0.999, askPrice:parseFloat(t.askPrice)||price*1.001,
                        spread:0 };
                }).filter(p=>p.price>0);
                state.exchanges.mexc.pairs = normalizePairs(pairs, 'mexc');
                state.exchanges.mexc.status = 'online';
                log(`MEXC: ${state.exchanges.mexc.pairs.length} pairs`, 'success');
            } catch(e) { state.exchanges.mexc.status='offline'; log('MEXC: '+e.message,'error'); }
        }

        async function loadKraken() {
            try {
                const r = await fetch(state.exchanges.kraken.url);
                if(!r.ok) throw new Error('HTTP '+r.status);
                const d = await r.json(); state.stats.apiCalls++;
                const result = d?.result || {};
                const pairs = Object.keys(result).slice(0,200).map(k => {
                    const t = result[k];
                    const price = parseFloat(t.c?.[0])||0;
                    const vol = parseFloat(t.v?.[1])*price||0;
                    const base = k.replace(/^X|Z/g,'').replace(/USD$|EUR$|BTC$/,'');
                    return { base, target:'USD', price, volume:vol, liquidity:vol,
                        bidPrice:parseFloat(t.b?.[0])||price*0.999, askPrice:parseFloat(t.a?.[0])||price*1.001,
                        spread:0 };
                }).filter(p=>p.price>0);
                state.exchanges.kraken.pairs = normalizePairs(pairs, 'kraken');
                state.exchanges.kraken.status = 'online';
                log(`Kraken: ${state.exchanges.kraken.pairs.length} pairs`, 'success');
            } catch(e) { state.exchanges.kraken.status='offline'; log('Kraken: '+e.message,'error'); }
        }

        async function loadBitstamp() {
            try {
                const r = await fetch(state.exchanges.bitstamp.url);
                if(!r.ok) throw new Error('HTTP '+r.status);
                const d = await r.json(); state.stats.apiCalls++;
                const pairs = (Array.isArray(d)?d:[]).slice(0,200).map(t => {
                    const price = parseFloat(t.last)||0;
                    const vol = parseFloat(t.volume)*price||0;
                    const parts = (t.pair||'').split('/');
                    return { base:parts[0]||'', target:parts[1]||'USD', price, volume:vol, liquidity:vol,
                        bidPrice:parseFloat(t.bid)||price*0.999, askPrice:parseFloat(t.ask)||price*1.001,
                        spread:0 };
                }).filter(p=>p.price>0&&p.base);
                state.exchanges.bitstamp.pairs = normalizePairs(pairs, 'bitstamp');
                state.exchanges.bitstamp.status = 'online';
                log(`Bitstamp: ${state.exchanges.bitstamp.pairs.length} pairs`, 'success');
            } catch(e) { state.exchanges.bitstamp.status='offline'; log('Bitstamp: '+e.message,'error'); }
        }

        async function loadIndodax() {
            try {
                const r = await fetch(state.exchanges.indodax.url);
                if(!r.ok) throw new Error('HTTP '+r.status);
                const d = await r.json(); state.stats.apiCalls++;
                const tickers = d || {};
                const pairs = Object.keys(tickers).slice(0,200).map(k => {
                    const t = tickers[k];
                    const price = parseFloat(t.last)||0;
                    const parts = k.split('_');
                    return { base:parts[0]||'', target:(parts[1]||'idr').toUpperCase(), price,
                        volume:parseFloat(t.vol_idr)*price||0, liquidity:parseFloat(t.vol_idr)*price||0,
                        bidPrice:parseFloat(t.buy)||price*0.999, askPrice:parseFloat(t.sell)||price*1.001,
                        spread:0 };
                }).filter(p=>p.price>0);
                state.exchanges.indodax.pairs = normalizePairs(pairs, 'indodax');
                state.exchanges.indodax.status = 'online';
                log(`Indodax: ${state.exchanges.indodax.pairs.length} pairs`, 'success');
            } catch(e) { state.exchanges.indodax.status='offline'; log('Indodax: '+e.message,'error'); }
        }

        async function loadYobit() {
            try {
                const r = await fetch(state.exchanges.yobit.url);
                if(!r.ok) throw new Error('HTTP '+r.status);
                const d = await r.json(); state.stats.apiCalls++;
                const info = d?.pairs || {};
                const pairs = Object.keys(info).slice(0,200).map(k => {
                    const parts = k.split('_');
                    const price = 1;
                    return { base:parts[0]?.toUpperCase()||'', target:parts[1]?.toUpperCase()||'USD',
                        price, volume:0, liquidity:0,
                        bidPrice:price*0.99, askPrice:price*1.01, spread:0.02 };
                }).filter(p=>p.base);
                state.exchanges.yobit.pairs = normalizePairs(pairs, 'yobit');
                state.exchanges.yobit.status = 'online';
                log(`Yobit: ${state.exchanges.yobit.pairs.length} pairs (metadata only)`, 'warning');
            } catch(e) { state.exchanges.yobit.status='offline'; log('Yobit: '+e.message,'error'); }
        }

        async function loadAlpaca() {
            try {
                const r = await fetch(state.exchanges.alpaca.url);
                if(!r.ok) throw new Error('HTTP '+r.status);
                const d = await r.json(); state.stats.apiCalls++;
                const trades = d?.trades || {};
                const pairs = Object.keys(trades).map(k => {
                    const t = trades[k];
                    const price = parseFloat(t?.p)||0;
                    return { base:k.replace('USD',''), target:'USD', price,
                        volume:parseFloat(t?.s)*price||0, liquidity:100000,
                        bidPrice:price*0.999, askPrice:price*1.001, spread:0.002 };
                }).filter(p=>p.price>0);
                state.exchanges.alpaca.pairs = normalizePairs(pairs, 'alpaca');
                state.exchanges.alpaca.status = 'online';
                log(`Alpaca: ${state.exchanges.alpaca.pairs.length} pairs`, 'success');
            } catch(e) { state.exchanges.alpaca.status='offline'; log('Alpaca: '+e.message,'error'); }
        }

        async function loadDexScreener(key) {
            const ex = state.exchanges[key];
            try {
                const r = await fetch(ex.url);
                if(!r.ok) throw new Error('HTTP '+r.status);
                const d = await r.json(); state.stats.apiCalls++;
                const rawPairs = d?.pairs || [];
                const pairs = rawPairs.slice(0,300).map(p => {
                    const price = parseFloat(p.priceUsd)||0;
                    const liq = p.liquidity?.usd || 0;
                    const vol = p.volume?.h24 || 0;
                    const spread = liq>0 ? Math.max(0.003, Math.min(0.05, 5000/liq)) : 0.03;
                    return {
                        base: p.baseToken?.symbol || 'UNKNOWN',
                        target: p.quoteToken?.symbol || 'ETH',
                        price, volume: vol, liquidity: liq,
                        bidPrice: price*(1-spread/2), askPrice: price*(1+spread/2),
                        spread, dexId: p.dexId, chainId: p.chainId
                    };
                }).filter(p => p.base !== 'UNKNOWN' && p.price > 0);
                ex.pairs = normalizePairs(pairs, key);
                ex.status = 'online';
                log(`${ex.name}: ${ex.pairs.length} pairs`, 'success');
            } catch(e) { ex.status='offline'; log(`${ex.name}: ${e.message}`,'error'); }
        }

        // ==================== INIT ====================
        async function initSystem() {
            log('🎰 INITIALIZING 17 EXCHANGES...', 'info');
            updateStatus('🔄 LOADING ALL EXCHANGES...');
            playSpin();

            const loaders = [
                loadOKX(), loadCoinbase(), loadBinance(), loadKuCoin(),
                loadBybit(), loadGate(), loadMEXC(), loadKraken(),
                loadBitstamp(), loadIndodax(), loadYobit(), loadAlpaca(),
                loadDexScreener('dexscreener_eth'), loadDexScreener('dexscreener_bsc'),
                loadDexScreener('dexscreener_polygon'), loadDexScreener('dexscreener_arb'),
                loadDexScreener('dexscreener_sol')
            ];

            await Promise.allSettled(loaders);

            state.allPairs = [];
            Object.values(state.exchanges).forEach(ex => state.allPairs.push(...ex.pairs));
            state.stats.totalPairs = state.allPairs.length;

            buildGraph();
            buildTriangles();
            displayLowValue();
            updateExchangeDisplay();
            updateStats();

            const online = Object.values(state.exchanges).filter(e => e.status === 'online').length;
            if (online > 0) {
                state.systemReady = true;
                document.getElementById('scanBtn').disabled = false;
                updateStatus(`✅ READY · ${online}/17 EXCHANGES ONLINE · ${state.stats.totalPairs} PAIRS`);
                log(`🎰 SYSTEM READY · ${online}/17 exchanges`, 'success');
            } else {
                updateStatus('❌ ALL EXCHANGES OFFLINE');
                log('INIT FAILED', 'error');
            }
        }

        function buildGraph() {
            state.graph = {};
            let edges = 0;
            state.allPairs.forEach(p => {
                if (p.liquidity < 50) return;
                if (!state.graph[p.base]) state.graph[p.base] = {};
                if (!state.graph[p.target]) state.graph[p.target] = {};
                state.graph[p.base][p.target] = {
                    rate: 1/p.askPrice, weight: -Math.log(1/p.askPrice),
                    volume: p.volume, liquidity: p.liquidity, spread: p.spread, exchange: p.exchange
                };
                edges++;
                state.graph[p.target][p.base] = {
                    rate: p.bidPrice, weight: -Math.log(p.bidPrice),
                    volume: p.volume, liquidity: p.liquidity, spread: p.spread, exchange: p.exchange
                };
                edges++;
            });
            state.stats.graphNodes = Object.keys(state.graph).length;
            state.stats.graphEdges = edges;
        }
        function buildTriangles() {
            state.triangles = [];
            const nodes = Object.keys(state.graph);
            for (let i = 0; i < Math.min(nodes.length, 80); i++) {
                const A = nodes[i];
                const nA = Object.keys(state.graph[A] || {});
                for (const B of nA) {
                    const nB = Object.keys(state.graph[B] || {});
                    for (const C of nB) {
                        if (state.graph[C] && state.graph[C][A]) state.triangles.push([A, B, C]);
                    }
                }
            }
            state.stats.triangleCount = state.triangles.length;
        }
        function displayLowValue() {
            const ultra = state.allPairs.filter(p => p.price < 0.0001 && p.price > 0 && p.liquidity >= 10)
                .sort((a, b) => a.price - b.price).slice(0, 25);
            const micro = state.allPairs.filter(p => p.price < 0.001 && p.price >= 0.0001 && p.liquidity >= 10)
                .sort((a, b) => a.price - b.price).slice(0, 25);
            document.getElementById('ultraLowValue').innerHTML = ultra.length ? ultra.map(c =>
                `<div style="display:flex;justify-content:space-between;padding:3px 0;border-bottom:1px solid #222;"><span>${c.base} <span class="chip">${c.exchange}</span></span><span>$${c.price.toFixed(10)}</span></div>`
            ).join('') : 'None found';
            document.getElementById('microCap').innerHTML = micro.length ? micro.map(c =>
                `<div style="display:flex;justify-content:space-between;padding:3px 0;border-bottom:1px solid #222;"><span>${c.base} <span class="chip">${c.exchange}</span></span><span>$${c.price.toFixed(8)}</span></div>`
            ).join('') : 'None found';
        }

        function calcMaxSize(edges) {
            let minLiq = Infinity;
            edges.forEach(e => { if (e.liquidity < minLiq) minLiq = e.liquidity; });
            return minLiq * 0.05;
        }
        function scanTriangular(minProfit = 0.0001) {
            const opps = [];
            const inv = 1000;
            state.triangles.forEach(([A, B, C]) => {
                const e1 = state.graph[A]?.[B], e2 = state.graph[B]?.[C], e3 = state.graph[C]?.[A];
                if (!e1 || !e2 || !e3) return;
                const final = inv * e1.rate * e2.rate * e3.rate;
                const profit = final - inv, pct = (profit / inv) * 100;
                if (pct >= minProfit) {
                    const maxSize = calcMaxSize([e1, e2, e3]);
                    opps.push({ type: 'triangular', path: [A, B, C, A], profitPercent: pct, profit,
                        actualProfit: (maxSize / inv) * profit, maxTradeSize: maxSize,
                        totalLiquidity: Math.min(e1.liquidity, e2.liquidity, e3.liquidity),
                        edges: [e1, e2, e3] });
                }
            });
            return opps;
        }
        function bellmanFord(startCur, maxPath = 5) {
            const currencies = Object.keys(state.graph);
            if (!currencies.includes(startCur)) return [];
            const dist = {}, pred = {};
            currencies.forEach(c => { dist[c] = Infinity; pred[c] = null; });
            dist[startCur] = 0;
            for (let i = 0; i < Math.min(maxPath - 1, currencies.length - 1); i++) {
                let updated = false;
                for (const u of currencies) {
                    const neighbors = state.graph[u]; if (!neighbors) continue;
                    for (const v in neighbors) {
                        const w = neighbors[v].weight;
                        if (dist[u] !== Infinity && dist[u] + w < dist[v]) {
                            dist[v] = dist[u] + w; pred[v] = u; updated = true;
                        }
                    }
                }
                if (!updated) break;
            }
            const opps = [];
            for (const u of currencies) {
                const neighbors = state.graph[u]; if (!neighbors) continue;
                for (const v in neighbors) {
                    if (dist[u] !== Infinity && dist[u] + neighbors[v].weight < dist[v]) {
                        const cycle = reconstructCycle(v, pred, maxPath);
                        if (cycle && cycle.length >= 3 && cycle[0] === startCur) {
                            const opp = calcCycleOpp(cycle);
                            if (opp) opps.push(opp);
                        }
                    }
                }
            }
            return opps;
        }
        function reconstructCycle(start, pred, maxLen) {
            const cycle = [start]; let curr = pred[start]; const visited = new Set([start]);
            while (curr && !visited.has(curr) && cycle.length < maxLen) {
                cycle.unshift(curr); visited.add(curr); curr = pred[curr];
            }
            return cycle.length >= 3 ? cycle : null;
        }
        function calcCycleOpp(cycle) {
            let amount = 1000; const edges = []; let totalLiq = Infinity;
            for (let i = 0; i < cycle.length - 1; i++) {
                const edge = state.graph[cycle[i]]?.[cycle[i + 1]]; if (!edge) return null;
                amount *= edge.rate; edges.push(edge); totalLiq = Math.min(totalLiq, edge.liquidity);
            }
            const lastEdge = state.graph[cycle[cycle.length - 1]]?.[cycle[0]]; if (!lastEdge) return null;
            amount *= lastEdge.rate; edges.push(lastEdge); totalLiq = Math.min(totalLiq, lastEdge.liquidity);
            const profit = amount - 1000, pct = (profit / 1000) * 100;
            if (pct >= 0.0001 && totalLiq >= 50) {
                const maxSize = calcMaxSize(edges);
                return { type: 'bellman-ford', path: cycle, profitPercent: pct, profit,
                    actualProfit: (maxSize / 1000) * profit, maxTradeSize: maxSize,
                    totalLiquidity: totalLiq, edges };
            }
            return null;
        }

        async function runFullScan() {
            if (!state.systemReady) return log('System not ready', 'error');
            log('🎲 SPINNING WHEEL...', 'info');
            updateStatus('🎰 SCANNING...');
            playSpin();
            state.opportunities = { mega: [], triangular: [], bellman: [], micro: [] };
            const triOpps = scanTriangular(0.0001);
            const bfOpps = [];
            const topCur = {};
            state.allPairs.forEach(p => { if (!topCur[p.base]) topCur[p.base] = 0; topCur[p.base] += p.volume; });
            const sortedCur = Object.keys(topCur).sort((a, b) => topCur[b] - topCur[a]).slice(0, 40);
            for (const c of sortedCur) bfOpps.push(...bellmanFord(c, 5));
            const seen = new Set();
            triOpps.forEach(o => {
                const k = o.path.slice().sort().join('-');
                if (!seen.has(k)) { seen.add(k); o.profitPercent > 5 ? state.opportunities.mega.push(o) : state.opportunities.triangular.push(o); }
            });
            bfOpps.forEach(o => {
                const k = o.path.slice().sort().join('-');
                if (!seen.has(k)) { seen.add(k); o.profitPercent > 5 ? state.opportunities.mega.push(o) : state.opportunities.bellman.push(o); }
            });
            state.stats.oppCount = Object.values(state.opportunities).flat().length;
            updateStats();
            displayAllOpps();
            updateStatus(`✅ COMPLETE · ${state.stats.oppCount} OPPORTUNITIES`);
            if (state.opportunities.mega.length > 0) { confetti(innerWidth / 2, 100, 60); playJackpot(); }
            log('🎉 SCAN DONE', 'success');
        }

        async function scanMicroCaps() {
            if (!state.systemReady) return;
            const microPairs = state.allPairs.filter(p => p.price < 0.001 && p.price > 0 && p.liquidity >= 10);
            const tempGraph = {};
            microPairs.forEach(p => {
                if (!tempGraph[p.base]) tempGraph[p.base] = {};
                if (!tempGraph[p.target]) tempGraph[p.target] = {};
                tempGraph[p.base][p.target] = { rate: 1/p.askPrice, weight: -Math.log(1/p.askPrice), volume: p.volume, liquidity: p.liquidity, spread: p.spread, exchange: p.exchange };
                tempGraph[p.target][p.base] = { rate: p.bidPrice, weight: -Math.log(p.bidPrice), volume: p.volume, liquidity: p.liquidity, spread: p.spread, exchange: p.exchange };
            });
            const orig = state.graph; state.graph = tempGraph;
            const currencies = Object.keys(tempGraph).slice(0, 50);
            const opps = [];
            for (const c of currencies) opps.push(...bellmanFord(c, 5));
            state.graph = orig;
            state.opportunities.micro = opps.sort((a, b) => b.actualProfit - a.actualProfit);
            updateStats();
            displayMicroOpps();
            log(`💎 Micro-cap scan: ${opps.length}`, 'success');
        }

        function displayAllOpps() {
            document.getElementById('megaOpps').innerHTML = state.opportunities.mega.slice(0, 20).map(o => renderOppCard(o, 'mega')).join('');
            document.getElementById('triangularOpps').innerHTML = state.opportunities.triangular.slice(0, 20).map(o => renderOppCard(o, '')).join('');
            document.getElementById('bellmanOpps').innerHTML = state.opportunities.bellman.slice(0, 20).map(o => renderOppCard(o, '')).join('');
        }
        function displayMicroOpps() {
            document.getElementById('microOpps').innerHTML = state.opportunities.micro.slice(0, 20).map(o => renderOppCard(o, 'micro')).join('');
        }
        function renderOppCard(opp, cls) {
            const pathHtml = opp.edges.map((e, i) =>
                `<div style="margin:2px 0;">${opp.path[i]} → ${opp.path[i+1]} <span class="chip">${e.exchange}</span> Rate:${e.rate.toFixed(6)} Liq:$${e.liquidity.toFixed(0)}</div>`
            ).join('');
            return `<div class="opportunity ${cls}" onclick="openTradeModal('${encodeURIComponent(JSON.stringify(opp))}')">
                <div style="display:flex;justify-content:space-between;"><strong>${opp.type.toUpperCase()}</strong><strong style="color:${opp.profitPercent>5?'var(--gold)':'var(--green)'}">+${opp.profitPercent.toFixed(4)}%</strong></div>
                <div class="path-visual">${pathHtml}</div>
                <div class="depth-info">Max: $${opp.maxTradeSize.toFixed(2)} · Profit: $${opp.actualProfit.toFixed(4)}</div>
            </div>`;
        }

        function openTradeModal(oppStr) {
            const opp = JSON.parse(decodeURIComponent(oppStr));
            const bet = parseFloat(document.getElementById('betSlider').value);
            const tradeSize = Math.min(opp.maxTradeSize, bet);
            const profit = (tradeSize / opp.maxTradeSize) * opp.actualProfit;
            const gas = 15;
            const net = profit - gas;
            document.getElementById('tradeDetails').innerHTML = `
                <p>🔄 <strong>${opp.path.join(' → ')}</strong></p>
                <p>💰 Trade: $${tradeSize.toFixed(2)}</p>
                <p>📈 Gross: $${profit.toFixed(4)}</p>
                <p>⛽ Gas: $${gas.toFixed(2)}</p>
                <p style="color:${net>0?'var(--green)':'#ff4444'}">💵 Net: $${net.toFixed(4)}</p>
                <p style="color:var(--gold);">⚠️ MEV Risk: Medium</p>`;
            document.getElementById('executeTradeBtn').onclick = () => executeTrade(opp, tradeSize, net);
            document.getElementById('tradeModal').style.display = 'flex';
        }
        function closeModal() { document.getElementById('tradeModal').style.display = 'none'; }
        function executeTrade(opp, size, netProfit) {
            state.bankroll += netProfit;
            state.trades.push({ opp, size, netProfit, time: new Date() });
            log(`🎰 TRADE: +$${netProfit.toFixed(2)} | Bankroll: $${state.bankroll.toFixed(2)}`, netProfit>0?'success':'error');
            updateStats();
            closeModal();
            if (netProfit > 30) confetti(innerWidth/2, 180, 80);
            playWin();
        }

        function connectWebSockets() {
            log('📡 WebSocket streams ready for OKX/Binance/Bybit', 'info');
            setInterval(updateStats, 2000);
        }
        function shareJackpot() {
            const mega = state.opportunities.mega[0];
            if (mega) {
                const text = `🎰 I just found a ${mega.profitPercent.toFixed(2)}% arbitrage on QuanTM FOAM! Path: ${mega.path.join('→')} #DeFi #ArbitrageCasino`;
                navigator.clipboard.writeText(text).then(() => log('📤 Copied!', 'success'));
            } else log('No jackpot to share', 'warning');
        }
        function toggleTheme() {
            document.body.style.filter = document.body.style.filter === 'hue-rotate(180deg)' ? 'none' : 'hue-rotate(180deg)';
        }

        window.addEventListener('load', () => {
            log('🎰 QuanTM FOAM v11 - 17 EXCHANGES', 'success');
            setTimeout(initSystem, 600);
            updateBet();
        });
    </script>
</body>
</html>
