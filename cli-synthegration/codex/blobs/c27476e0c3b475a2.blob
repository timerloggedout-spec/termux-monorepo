<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>QuanTM FOAM v8.2 - Enhanced WebSocket Arbitrage</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { 
            background: #0a0a1a; 
            color: #a0a0ff; 
            font-family: monospace;
            padding: 10px;
            font-size: 12px;
        }
        h1 { color: #00f0ff; margin-bottom: 10px; font-size: 16px; }
        h2 { color: #ff00ff; font-size: 14px; margin: 10px 0 6px 0; }
        h3 { color: #00ffaa; font-size: 12px; margin: 6px 0 4px 0; }
        
        .container { max-width: 1400px; margin: 0 auto; }
        
        .status-bar { 
            padding: 8px; 
            margin: 8px 0; 
            background: #1a1a2a;
            border-radius: 4px;
            border-left: 3px solid #00f0ff;
            font-size: 11px;
        }
        
        .controls {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            margin: 8px 0;
        }
        
        button {
            background: linear-gradient(45deg, #00f0ff, #ff00ff);
            border: none;
            color: white;
            padding: 8px 12px;
            border-radius: 4px;
            font-size: 11px;
            cursor: pointer;
            font-family: monospace;
        }
        
        button:active { transform: scale(0.95); }
        button:disabled { opacity: 0.5; cursor: not-allowed; }
        
        .grid { 
            display: grid; 
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); 
            gap: 8px;
            margin: 8px 0;
        }
        
        .card {
            background: #1a1a2a;
            padding: 8px;
            border-radius: 4px;
            border: 1px solid #2a2a3a;
        }
        
        .exchange-status {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 5px;
            background: #0a0a1a;
            border-radius: 3px;
            margin: 3px 0;
            font-size: 10px;
        }
        
        .indicator {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #ff4444;
            flex-shrink: 0;
        }
        .indicator.online { background: #00ff00; animation: pulse 2s infinite; }
        
        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.5; }
        }
        
        .coin-list {
            max-height: 220px;
            overflow-y: auto;
            background: #0a0a1a;
            padding: 5px;
            border-radius: 3px;
            font-size: 10px;
        }
        
        .coin-item {
            display: flex;
            justify-content: space-between;
            padding: 3px;
            border-bottom: 1px solid #2a2a3a;
        }
        
        .opportunity-section {
            margin-bottom: 15px;
            border: 1px solid #2a2a3a;
            border-radius: 4px;
            overflow: hidden;
        }
        
        .opportunity-header {
            background: #2a2a3a;
            padding: 6px 8px;
            font-weight: bold;
            display: flex;
            justify-content: space-between;
            cursor: pointer;
        }
        
        .opportunity-content {
            max-height: 400px;
            overflow-y: auto;
            transition: max-height 0.3s ease;
        }
        
        .opportunity-content.collapsed {
            max-height: 0;
            overflow: hidden;
        }
        
        .opportunity {
            background: #1a1a2a;
            padding: 8px;
            margin: 4px 0;
            border-radius: 4px;
            border-left: 3px solid #00ff00;
            font-size: 10px;
        }
        
        .opportunity.mega { border-left-color: #ffff00; }
        .opportunity.triangular { border-left-color: #00f0ff; }
        .opportunity.bellman { border-left-color: #ff00ff; }
        .opportunity.micro { border-left-color: #ffaa00; }
        
        .log-container {
            background: #0a0a1a;
            padding: 6px;
            border-radius: 4px;
            max-height: 300px;
            overflow-y: auto;
            font-size: 9px;
        }
        
        .log-entry {
            padding: 2px 0;
            border-bottom: 1px solid #1a1a2a;
        }
        
        .error { color: #ff4444; }
        .success { color: #00ff00; }
        .warning { color: #ffaa00; }
        .info { color: #00f0ff; }
        
        .stat { 
            display: flex; 
            justify-content: space-between; 
            padding: 3px 0;
            font-size: 10px;
        }
        .stat-value { color: #00ffaa; font-weight: bold; }
        
        .scan-params {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
            gap: 6px;
            margin: 8px 0;
        }
        
        .scan-params input {
            background: #0a0a1a;
            border: 1px solid #2a2a3a;
            color: #a0a0ff;
            padding: 5px;
            border-radius: 3px;
            font-size: 10px;
            font-family: monospace;
        }
        
        .path-visual {
            font-size: 9px;
            color: #00ffaa;
            margin: 3px 0;
            padding: 3px;
            background: #0a0a1a;
            border-radius: 2px;
        }
        
        .tab-container {
            display: flex;
            gap: 4px;
            margin: 8px 0;
        }
        
        .tab {
            padding: 6px 12px;
            background: #1a1a2a;
            border-radius: 4px;
            cursor: pointer;
            font-size: 11px;
            border: 1px solid #2a2a3a;
        }
        
        .tab.active {
            background: linear-gradient(45deg, #00f0ff, #ff00ff);
            color: white;
        }
        
        @media (max-width: 768px) {
            .grid { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>QuanTM FOAM v8.2 - Enhanced WebSocket Arbitrage Engine</h1>
        
        <div class="status-bar" id="mainStatus">Initializing...</div>
        
        <div class="controls">
            <button onclick="initSystem()">Initialize</button>
            <button onclick="runArbitrageScan()" id="scanBtn" disabled>Unified Scan</button>
            <button onclick="connectWebSockets()">Connect WebSockets</button>
            <button onclick="toggleLogs()">Logs</button>
            <button onclick="scanMicroCaps()">Micro-Cap Focus</button>
            <button onclick="clearOpportunities()">Clear Results</button>
        </div>

        <div class="tab-container">
            <div class="tab active" onclick="switchTab('main')">Main</div>
            <div class="tab" onclick="switchTab('opportunities')">Opportunities</div>
            <div class="tab" onclick="switchTab('analysis')">Analysis</div>
        </div>

        <div id="mainTab" class="tab-content">
            <h2>Scan Parameters</h2>
            <div class="card">
                <div class="scan-params">
                    <div>
                        <label style="display: block; font-size: 9px; margin-bottom: 2px;">Min Profit %</label>
                        <input type="number" id="minProfit" value="0.0001" step="0.0001">
                    </div>
                    <div>
                        <label style="display: block; font-size: 9px; margin-bottom: 2px;">Max Path</label>
                        <input type="number" id="maxPath" value="5" min="3" max="7">
                    </div>
                    <div>
                        <label style="display: block; font-size: 9px; margin-bottom: 2px;">Min Liq $</label>
                        <input type="number" id="minLiq" value="100" step="10">
                    </div>
                    <div>
                        <label style="display: block; font-size: 9px; margin-bottom: 2px;">Investment $</label>
                        <input type="number" id="investment" value="100" min="1">
                    </div>
                    <div>
                        <label style="display: block; font-size: 9px; margin-bottom: 2px;">Max Price $</label>
                        <input type="number" id="maxPrice" value="0.001" step="0.0001">
                    </div>
                </div>
            </div>

            <h2>Exchange Status</h2>
            <div class="grid" id="exchangeStatus"></div>

            <div class="grid">
                <div class="card">
                    <h3>Ultra Low-Value (&lt;$0.0001)</h3>
                    <div class="coin-list" id="ultraLowValue"></div>
                </div>
                <div class="card">
                    <h3>Micro-Cap (&lt;$0.001)</h3>
                    <div class="coin-list" id="microCap"></div>
                </div>
                <div class="card">
                    <h3>Statistics</h3>
                    <div class="stat">
                        <span>Total Pairs:</span>
                        <span class="stat-value" id="totalPairs">0</span>
                    </div>
                    <div class="stat">
                        <span>Nodes:</span>
                        <span class="stat-value" id="graphNodes">0</span>
                    </div>
                    <div class="stat">
                        <span>Edges:</span>
                        <span class="stat-value" id="graphEdges">0</span>
                    </div>
                    <div class="stat">
                        <span>Triangles:</span>
                        <span class="stat-value" id="triangleCount">0</span>
                    </div>
                    <div class="stat">
                        <span>API Calls:</span>
                        <span class="stat-value" id="apiCalls">0</span>
                    </div>
                    <div class="stat">
                        <span>WS Bytes:</span>
                        <span class="stat-value" id="wsBytes">0</span>
                    </div>
                    <div class="stat">
                        <span>Opportunities:</span>
                        <span class="stat-value" id="oppCount">0</span>
                    </div>
                </div>
            </div>
        </div>

        <div id="opportunitiesTab" class="tab-content" style="display: none;">
            <h2>Arbitrage Opportunities</h2>
            <div id="opportunitiesContainer"></div>
        </div>

        <div id="analysisTab" class="tab-content" style="display: none;">
            <h2>Market Analysis</h2>
            <div class="card">
                <h3>Exchange Coverage</h3>
                <div id="exchangeCoverage"></div>
            </div>
            <div class="card">
                <h3>Top Currency Hubs</h3>
                <div id="currencyHubs"></div>
            </div>
        </div>

        <h2 style="cursor: pointer;" onclick="toggleLogs()">System Logs</h2>
        <div class="log-container" id="logs" style="display: none;"></div>
    </div>

    <script>
        const state = {
            exchanges: {
                binance: { name: 'Binance', status: 'offline', pairs: [], ws: null, bytesReceived: 0 },
                kucoin: { name: 'KuCoin', status: 'offline', pairs: [], ws: null, bytesReceived: 0 },
                okx: { name: 'OKX', status: 'offline', pairs: [], ws: null, bytesReceived: 0 },
                bybit: { name: 'Bybit', status: 'offline', pairs: [], ws: null, bytesReceived: 0 },
                coinbase: { name: 'Coinbase', status: 'offline', pairs: [], ws: null, bytesReceived: 0 }
            },
            stats: {
                totalPairs: 0,
                graphNodes: 0,
                graphEdges: 0,
                triangleCount: 0,
                apiCalls: 0,
                wsBytes: 0,
                oppCount: 0
            },
            opportunities: {
                triangular: [],
                bellman: [],
                micro: [],
                all: []
            },
            systemReady: false,
            graph: {},
            triangles: [],
            allPairs: [],
            lastScanTime: 0
        };

        // Enhanced logging with performance tracking
        function log(msg, type) {
            const t = new Date().toLocaleTimeString();
            const el = document.getElementById('logs');
            el.innerHTML = '<div class="log-entry ' + (type || 'info') + '">[' + t + '] ' + msg + '</div>' + el.innerHTML;
            console.log('[' + t + '] ' + msg);
        }

        function updateStatus(msg) {
            document.getElementById('mainStatus').textContent = msg;
        }

        function updateStats() {
            document.getElementById('totalPairs').textContent = state.stats.totalPairs;
            document.getElementById('graphNodes').textContent = state.stats.graphNodes;
            document.getElementById('graphEdges').textContent = state.stats.graphEdges;
            document.getElementById('triangleCount').textContent = state.stats.triangleCount;
            document.getElementById('apiCalls').textContent = state.stats.apiCalls;
            document.getElementById('wsBytes').textContent = (state.stats.wsBytes / 1024).toFixed(2) + ' KB';
            document.getElementById('oppCount').textContent = state.stats.oppCount;
        }

        function toggleLogs() {
            const el = document.getElementById('logs');
            el.style.display = el.style.display === 'none' ? 'block' : 'none';
        }

        function switchTab(tabName) {
            // Hide all tabs
            document.getElementById('mainTab').style.display = 'none';
            document.getElementById('opportunitiesTab').style.display = 'none';
            document.getElementById('analysisTab').style.display = 'none';
            
            // Remove active class from all tabs
            document.querySelectorAll('.tab').forEach(tab => {
                tab.classList.remove('active');
            });
            
            // Show selected tab and mark as active
            document.getElementById(tabName + 'Tab').style.display = 'block';
            event.target.classList.add('active');
            
            if (tabName === 'analysis') {
                updateAnalysis();
            }
        }

        function updateExchangeStatus() {
            const container = document.getElementById('exchangeStatus');
            container.innerHTML = '';
            
            Object.keys(state.exchanges).forEach(function(key) {
                const ex = state.exchanges[key];
                const statusClass = ex.status === 'online' ? 'online' : '';
                const bytes = (ex.bytesReceived / 1024).toFixed(2);
                container.innerHTML += 
                    '<div class="exchange-status">' +
                    '<div class="indicator ' + statusClass + '"></div>' +
                    '<div style="flex: 1;"><strong>' + ex.name + '</strong><br>' +
                    '<small>' + ex.status.toUpperCase() + ' - ' + ex.pairs.length + ' pairs - ' + bytes + ' KB</small></div>' +
                    '</div>';
            });
        }

        // Enhanced exchange loading with retry logic
        async function loadExchangeWithRetry(loadFunction, exchangeName, retries = 3) {
            for (let i = 0; i < retries; i++) {
                try {
                    const success = await loadFunction();
                    if (success) return true;
                } catch (e) {
                    if (i === retries - 1) throw e;
                    await new Promise(resolve => setTimeout(resolve, 1000 * (i + 1)));
                }
            }
            return false;
        }

        // Enhanced Binance loader with CORS proxy fallback
        async function loadBinance() {
            try {
                log('Fetching Binance REST...', 'info');
                let response;
                
                // Try direct connection first
                try {
                    response = await fetch('https://api.binance.com/api/v3/ticker/24hr');
                } catch (e) {
                    // Fallback to CORS proxy
                    response = await fetch('https://corsproxy.io/?' + encodeURIComponent('https://api.binance.com/api/v3/ticker/24hr'));
                }
                
                if (!response.ok) {
                    throw new Error('HTTP ' + response.status);
                }
                
                const data = await response.json();
                state.stats.apiCalls++;
                
                state.exchanges.binance.pairs = data.slice(0, 500).map(function(ticker) {
                    const symbol = ticker.symbol;
                    let base = '', target = '';
                    
                    if (symbol.endsWith('USDT')) {
                        base = symbol.slice(0, -4);
                        target = 'USDT';
                    } else if (symbol.endsWith('BTC')) {
                        base = symbol.slice(0, -3);
                        target = 'BTC';
                    } else if (symbol.endsWith('ETH')) {
                        base = symbol.slice(0, -3);
                        target = 'ETH';
                    } else if (symbol.endsWith('BNB')) {
                        base = symbol.slice(0, -3);
                        target = 'BNB';
                    }
                    
                    if (!base || !target) return null;
                    
                    const volume = parseFloat(ticker.quoteVolume) || 0;
                    const price = parseFloat(ticker.lastPrice) || 0;
                    const spread = volume > 0 ? Math.max(0.0005, Math.min(0.01, 50000 / volume)) : 0.01;
                    
                    return {
                        base: base,
                        target: target,
                        price: price,
                        volume: volume,
                        change24h: parseFloat(ticker.priceChangePercent) || 0,
                        liquidity: volume,
                        bidAskSpread: spread,
                        exchange: 'binance'
                    };
                }).filter(function(p) { return p && p.price > 0; });
                
                state.exchanges.binance.status = 'online';
                log('Binance: ' + state.exchanges.binance.pairs.length + ' pairs', 'success');
                return true;
            } catch (e) {
                state.exchanges.binance.status = 'offline';
                log('Binance failed: ' + e.message, 'error');
                return false;
            }
        }

        // Similar enhancements for other exchanges (KuCoin, OKX, Bybit, Coinbase)
        // ... (implement similar improvements for other exchange loaders)

        async function initSystem() {
            log('========== INITIALIZING SYSTEM ==========', 'info');
            updateStatus('Loading market data...');
            
            await Promise.allSettled([
                loadExchangeWithRetry(loadBinance, 'Binance'),
                // loadExchangeWithRetry(loadKuCoin, 'KuCoin'),
                // loadExchangeWithRetry(loadOKX, 'OKX'),
                // loadExchangeWithRetry(loadBybit, 'Bybit'),
                // loadExchangeWithRetry(loadCoinbase, 'Coinbase')
            ]);
            
            state.allPairs = [];
            Object.keys(state.exchanges).forEach(function(key) {
                state.allPairs.push.apply(state.allPairs, state.exchanges[key].pairs);
            });
            
            state.stats.totalPairs = state.allPairs.length;
            
            buildTradingGraph();
            buildTriangles();
            displayUltraLowValue();
            displayMicroCap();
            
            updateExchangeStatus();
            updateStats();
            
            const onlineCount = Object.keys(state.exchanges).filter(function(k) {
                return state.exchanges[k].status === 'online';
            }).length;
            
            if (onlineCount > 0) {
                state.systemReady = true;
                document.getElementById('scanBtn').disabled = false;
                updateStatus('Ready - ' + onlineCount + '/5 online - ' + state.stats.totalPairs + ' pairs');
                log('========== INITIALIZATION COMPLETE ==========', 'success');
            } else {
                updateStatus('Failed to connect to any exchange');
                log('========== INITIALIZATION FAILED ==========', 'error');
            }
        }

        // Enhanced WebSocket connection with heartbeat
        function connectWebSockets() {
            log('Connecting WebSockets...', 'info');
            
            // Binance WebSocket with heartbeat
            try {
                const binanceWs = new WebSocket('wss://stream.binance.com:9443/ws/!ticker@arr');
                binanceWs.onopen = function() {
                    log('Binance WS connected', 'success');
                    state.exchanges.binance.ws = binanceWs;
                    
                    // Start heartbeat
                    setInterval(() => {
                        if (binanceWs.readyState === WebSocket.OPEN) {
                            binanceWs.send(JSON.stringify({ method: "PING" }));
                        }
                    }, 30000);
                };
                binanceWs.onmessage = function(event) {
                    state.exchanges.binance.bytesReceived += event.data.length;
                    state.stats.wsBytes += event.data.length;
                    
                    // Process real-time data for liquidity updates
                    try {
                        const data = JSON.parse(event.data);
                        if (Array.isArray(data)) {
                            data.forEach(ticker => {
                                // Update liquidity in real-time
                                updateRealTimeLiquidity(ticker, 'binance');
                            });
                        }
                    } catch (e) {
                        // Ignore parsing errors
                    }
                };
                binanceWs.onerror = function(e) {
                    log('Binance WS error', 'error');
                };
                binanceWs.onclose = function() {
                    log('Binance WS disconnected', 'warning');
                    state.exchanges.binance.ws = null;
                };
            } catch (e) {
                log('Binance WS failed: ' + e.message, 'error');
            }
            
            updateExchangeStatus();
            setInterval(updateStats, 2000);
        }

        // Real-time liquidity updates based on WebSocket data
        function updateRealTimeLiquidity(ticker, exchange) {
            // Placeholder for real-time liquidity updates
            // This would integrate with exchange-specific WebSocket data
            // to update bid/ask depth and calculate actual slippage
        }

        // Enhanced graph building with performance optimization
        function buildTradingGraph() {
            log('Building graph...', 'info');
            state.graph = {};
            let edgeCount = 0;
            const minLiq = parseFloat(document.getElementById('minLiq').value || 100);
            
            // Use Map for faster lookups
            const pairMap = new Map();
            
            state.allPairs.forEach(function(pair) {
                if (pair.liquidity < minLiq) return;
                
                const key = `${pair.base}-${pair.target}`;
                if (!pairMap.has(key)) {
                    pairMap.set(key, []);
                }
                pairMap.get(key).push(pair);
            });
            
            // Build graph with best rates
            pairMap.forEach((pairs, key) => {
                const [base, target] = key.split('-');
                
                if (!state.graph[base]) state.graph[base] = {};
                if (!state.graph[target]) state.graph[target] = {};
                
                // Find the pair with the best rate (lowest spread)
                const bestPair = pairs.reduce((best, current) => {
                    return (current.bidAskSpread < best.bidAskSpread) ? current : best;
                });
                
                const effectiveRate = bestPair.price * (1 - bestPair.bidAskSpread);
                
                if (effectiveRate > 0) {
                    state.graph[base][target] = {
                        rate: effectiveRate,
                        weight: -Math.log(effectiveRate),
                        volume: bestPair.volume,
                        liquidity: bestPair.liquidity,
                        spread: bestPair.bidAskSpread,
                        exchange: bestPair.exchange
                    };
                    edgeCount++;
                    
                    state.graph[target][base] = {
                        rate: 1 / effectiveRate,
                        weight: Math.log(effectiveRate),
                        volume: bestPair.volume,
                        liquidity: bestPair.liquidity,
                        spread: bestPair.bidAskSpread,
                        exchange: bestPair.exchange
                    };
                    edgeCount++;
                }
            });
            
            state.stats.graphNodes = Object.keys(state.graph).length;
            state.stats.graphEdges = edgeCount;
            
            log('Graph: ' + state.stats.graphNodes + ' nodes, ' + edgeCount + ' edges', 'success');
        }

        // Optimized triangle detection
        function buildTriangles() {
            log('Building triangles...', 'info');
            state.triangles = [];
            
            const nodes = Object.keys(state.graph);
            const adjacency = new Map();
            
            // Build adjacency list
            nodes.forEach(node => {
                adjacency.set(node, Object.keys(state.graph[node]));
            });
            
            // Optimized triangle detection with early termination
            const visited = new Set();
            
            for (let i = 0; i < Math.min(nodes.length, 200); i++) {
                const A = nodes[i];
                const neighborsA = adjacency.get(A) || [];
                
                for (let j = 0; j < neighborsA.length; j++) {
                    const B = neighborsA[j];
                    const neighborsB = adjacency.get(B) || [];
                    
                    // Find intersection of neighbors of A and B
                    const commonNeighbors = neighborsB.filter(n => 
                        adjacency.get(n) && adjacency.get(n).includes(A)
                    );
                    
                    commonNeighbors.forEach(C => {
                        const triangleKey = [A, B, C].sort().join('-');
                        if (!visited.has(triangleKey)) {
                            visited.add(triangleKey);
                            state.triangles.push([A, B, C]);
                        }
                    });
                }
            }
            
            state.stats.triangleCount = state.triangles.length;
            log('Triangles: ' + state.triangles.length, 'success');
        }

        // Display functions remain similar but with performance improvements
        function displayUltraLowValue() {
            const container = document.getElementById('ultraLowValue');
            const ultra = state.allPairs
                .filter(function(p) { return p.price < 0.0001 && p.price > 0 && p.liquidity >= 100; })
                .sort(function(a, b) { return a.price - b.price; })
                .slice(0, 30);
            
            container.innerHTML = '';
            if (ultra.length === 0) {
                container.innerHTML = '<div class="coin-item">No ultra low-value coins found</div>';
                return;
            }
            
            ultra.forEach(function(coin) {
                const changeColor = coin.change24h >= 0 ? '#00ff00' : '#ff4444';
                container.innerHTML += 
                    '<div class="coin-item">' +
                    '<div><strong>' + coin.base + '</strong><br>' +
                    '<small style="color: ' + changeColor + '">' + coin.change24h.toFixed(2) + '%</small></div>' +
                    '<div style="text-align: right;"><strong>$' + coin.price.toFixed(10) + '</strong><br>' +
                    '<small>$' + coin.liquidity.toFixed(2) + '</small></div>' +
                    '</div>';
            });
        }

        function displayMicroCap() {
            const container = document.getElementById('microCap');
            const micro = state.allPairs
                .filter(function(p) { return p.price < 0.001 && p.price >= 0.0001 && p.liquidity >= 100; })
                .sort(function(a, b) { return a.price - b.price; })
                .slice(0, 30);
            
            container.innerHTML = '';
            if (micro.length === 0) {
                container.innerHTML = '<div class="coin-item">No micro-cap coins found</div>';
                return;
            }
            
            micro.forEach(function(coin) {
                const changeColor = coin.change24h >= 0 ? '#00ff00' : '#ff4444';
                container.innerHTML += 
                    '<div class="coin-item">' +
                    '<div><strong>' + coin.base + '</strong><br>' +
                    '<small style="color: ' + changeColor + '">' + coin.change24h.toFixed(2) + '%</small></div>' +
                    '<div style="text-align: right;"><strong>$' + coin.price.toFixed(8) + '</strong><br>' +
                    '<small>$' + coin.liquidity.toFixed(2) + '</small></div>' +
                    '</div>';
            });
        }

        // Enhanced opportunity scanning with deduplication
        function scanTriangular(minProfit) {
            const opps = [];
            const investment = parseFloat(document.getElementById('investment').value || 100);
            const seen = new Set();
            
            for (let t = 0; t < state.triangles.length; t++) {
                const triangle = state.triangles[t];
                const A = triangle[0];
                const B = triangle[1];
                const C = triangle[2];
                
                const e1 = state.graph[A] ? state.graph[A][B] : null;
                const e2 = state.graph[B] ? state.graph[B][C] : null;
                const e3 = state.graph[C] ? state.graph[C][A] : null;
                
                if (!e1 || !e2 || !e3) continue;
                
                const finalAmt = investment * e1.rate * e2.rate * e3.rate;
                const profit = finalAmt - investment;
                const profitPct = (profit / investment) * 100;
                
                if (profitPct >= minProfit) {
                    const minLiq = Math.min(e1.liquidity, e2.liquidity, e3.liquidity);
                    const pathKey = [A, B, C].sort().join('-');
                    
                    if (!seen.has(pathKey)) {
                        seen.add(pathKey);
                        opps.push({
                            type: 'triangular',
                            path: [A, B, C, A],
                            profitPercent: profitPct,
                            profit: profit,
                            investment: investment,
                            finalAmount: finalAmt,
                            totalLiquidity: minLiq,
                            edges: [e1, e2, e3],
                            timestamp: Date.now(),
                            exchanges: [e1.exchange, e2.exchange, e3.exchange].filter((v, i, a) => a.indexOf(v) === i)
                        });
                    }
                }
            }
            
            return opps;
        }

        // Enhanced Bellman-Ford with path validation
        function bellmanFord(startCurrency, maxPath) {
            const currencies = Object.keys(state.graph);
            if (!currencies.includes(startCurrency)) return [];
            
            const dist = {};
            const pred = {};
            const opportunities = [];
            
            currencies.forEach(function(c) {
                dist[c] = Infinity;
                pred[c] = null;
            });
            dist[startCurrency] = 0;
            
            // Relax edges
            for (let i = 0; i < Math.min(maxPath - 1, currencies.length - 1); i++) {
                let updated = false;
                for (let j = 0; j < currencies.length; j++) {
                    const u = currencies[j];
                    const neighbors = state.graph[u];
                    if (!neighbors) continue;
                    
                    for (const v in neighbors) {
                        const edge = neighbors[v];
                        if (dist[u] !== Infinity && dist[u] + edge.weight < dist[v]) {
                            dist[v] = dist[u] + edge.weight;
                            pred[v] = u;
                            updated = true;
                        }
                    }
                }
                if (!updated) break;
            }
            
            // Check for negative cycles (opportunities)
            const seenCycles = new Set();
            for (let i = 0; i < currencies.length; i++) {
                const u = currencies[i];
                const neighbors = state.graph[u];
                if (!neighbors) continue;
                
                for (const v in neighbors) {
                    const edge = neighbors[v];
                    if (dist[u] !== Infinity && dist[u] + edge.weight < dist[v]) {
                        const cycle = reconstructCycle(v, pred, maxPath);
                        if (cycle && cycle.length >= 3 && cycle[0] === startCurrency) {
                            const cycleKey = cycle.sort().join('-');
                            if (!seenCycles.has(cycleKey)) {
                                seenCycles.add(cycleKey);
                                const opp = calculateCycleOpportunity(cycle);
                                if (opp) opportunities.push(opp);
                            }
                        }
                    }
                }
            }
            
            return opportunities;
        }

        function reconstructCycle(start, pred, maxLen) {
            const cycle = [start];
            let curr = pred[start];
            const visited = new Set([start]);
            
            while (curr && !visited.has(curr) && cycle.length < maxLen) {
                cycle.unshift(curr);
                visited.add(curr);
                curr = pred[curr];
            }
            
            // Ensure we return to start
            if (cycle.length >= 3 && state.graph[cycle[cycle.length-1]] && 
                state.graph[cycle[cycle.length-1]][cycle[0]]) {
                return cycle;
            }
            
            return null;
        }

        function calculateCycleOpportunity(cycle) {
            const investment = parseFloat(document.getElementById('investment').value || 100);
            let amount = investment;
            const edges = [];
            let totalLiquidity = Infinity;
            const exchanges = new Set();
            
            for (let i = 0; i < cycle.length - 1; i++) {
                const from = cycle[i];
                const to = cycle[i + 1];
                const edge = state.graph[from] ? state.graph[from][to] : null;
                
                if (!edge) return null;
                
                amount = amount * edge.rate;
                totalLiquidity = Math.min(totalLiquidity, edge.liquidity);
                edges.push(edge);
                exchanges.add(edge.exchange);
            }
            
            const lastFrom = cycle[cycle.length - 1];
            const firstTo = cycle[0];
            const closeEdge = state.graph[lastFrom] ? state.graph[lastFrom][firstTo] : null;
            
            if (!closeEdge) return null;
            
            amount = amount * closeEdge.rate;
            totalLiquidity = Math.min(totalLiquidity, closeEdge.liquidity);
            edges.push(closeEdge);
            exchanges.add(closeEdge.exchange);
            
            const profit = amount - investment;
            const profitPercent = (profit / investment) * 100;
            
            const minProfit = parseFloat(document.getElementById('minProfit').value || 0.0001);
            const minLiq = parseFloat(document.getElementById('minLiq').value || 100);
            
            if (profitPercent >= minProfit && totalLiquidity >= minLiq) {
                return {
                    type: 'bellman-ford',
                    path: cycle.concat([cycle[0]]),
                    profitPercent: profitPercent,
                    profit: profit,
                    investment: investment,
                    finalAmount: amount,
                    totalLiquidity: totalLiquidity,
                    edges: edges,
                    timestamp: Date.now(),
                    exchanges: Array.from(exchanges)
                };
            }
            
            return null;
        }

        // Enhanced scanning with categorization
        async function runArbitrageScan() {
            if (!state.systemReady) {
                log('System not ready', 'error');
                return;
            }
            
            // Rate limiting
            const now = Date.now();
            if (now - state.lastScanTime < 5000) {
                log('Scan too frequent, please wait 5 seconds', 'warning');
                return;
            }
            state.lastScanTime = now;
            
            log('========== UNIFIED SCAN ==========', 'info');
            updateStatus('Scanning...');
            
            const minProfit = parseFloat(document.getElementById('minProfit').value || 0.0001);
            const maxPath = parseInt(document.getElementById('maxPath').value || 5);
            
            log('Phase 1: Triangular...', 'info');
            const triOpps = scanTriangular(minProfit);
            state.opportunities.triangular = triOpps;
            log('Triangular: ' + triOpps.length + ' opps', triOpps.length > 0 ? 'success' : 'warning');
            
            log('Phase 2: Bellman-Ford...', 'info');
            const bfOpps = [];
            
            const topCurrencies = {};
            state.allPairs.forEach(function(p) {
                if (!topCurrencies[p.base]) topCurrencies[p.base] = 0;
                topCurrencies[p.base] += p.volume;
            });
            
            const sortedCurrencies = Object.keys(topCurrencies)
                .sort(function(a, b) { return topCurrencies[b] - topCurrencies[a]; })
                .slice(0, 20); // Reduced for performance
            
            for (let i = 0; i < sortedCurrencies.length; i++) {
                const opps = bellmanFord(sortedCurrencies[i], maxPath);
                bfOpps.push.apply(bfOpps, opps);
            }
            
            state.opportunities.bellman = bfOpps;
            log('Bellman-Ford: ' + bfOpps.length + ' opps', bfOpps.length > 0 ? 'success' : 'warning');
            
            // Combine and deduplicate
            const allOpps = triOpps.concat(bfOpps);
            const uniqueOpps = removeDuplicates(allOpps);
            
            state.opportunities.all = uniqueOpps;
            state.stats.oppCount = uniqueOpps.length;
            updateStats();
            
            displayOpportunities();
            
            updateStatus('Complete - ' + uniqueOpps.length + ' opportunities');
            log('========== SCAN COMPLETE: ' + uniqueOpps.length + ' ==========', 'success');
            
            // Auto-switch to opportunities tab
            switchTab('opportunities');
        }

        function removeDuplicates(opps) {
            const seen = new Set();
            const unique = [];
            
            opps.forEach(function(opp) {
                const pathStr = opp.path.slice().sort().join('-');
                if (!seen.has(pathStr)) {
                    seen.add(pathStr);
                    unique.push(opp);
                }
            });
            
            return unique;
        }

        // Enhanced micro-cap scanning
        async function scanMicroCaps() {
            if (!state.systemReady) {
                log('System not ready', 'error');
                return;
            }
            
            log('========== MICRO-CAP SCAN ==========', 'info');
            updateStatus('Scanning micro-caps...');
            
            const maxPrice = parseFloat(document.getElementById('maxPrice').value || 0.001);
            const microPairs = state.allPairs.filter(function(p) {
                return p.price < maxPrice && p.price > 0 && p.liquidity >= 100;
            });
            
            log('Found ' + microPairs.length + ' micro-cap pairs', 'info');
            
            if (microPairs.length === 0) {
                updateStatus('No micro-cap pairs found');
                log('========== MICRO-CAP SCAN COMPLETE: 0 ==========', 'warning');
                return;
            }
            
            const tempGraph = {};
            microPairs.forEach(function(pair) {
                if (!tempGraph[pair.base]) tempGraph[pair.base] = {};
                if (!tempGraph[pair.target]) tempGraph[pair.target] = {};
                
                const effectiveRate = pair.price * (1 - pair.bidAskSpread);
                
                tempGraph[pair.base][pair.target] = {
                    rate: effectiveRate,
                    weight: -Math.log(effectiveRate),
                    volume: pair.volume,
                    liquidity: pair.liquidity,
                    spread: pair.bidAskSpread,
                    exchange: pair.exchange
                };
                
                tempGraph[pair.target][pair.base] = {
                    rate: 1 / effectiveRate,
                    weight: Math.log(effectiveRate),
                    volume: pair.volume,
                    liquidity: pair.liquidity,
                    spread: pair.bidAskSpread,
                    exchange: pair.exchange
                };
            });
            
            const originalGraph = state.graph;
            state.graph = tempGraph;
            
            const currencies = Object.keys(tempGraph).slice(0, 30);
            const maxPath = parseInt(document.getElementById('maxPath').value || 5);
            const opportunities = [];
            
            for (let i = 0; i < currencies.length; i++) {
                const opps = bellmanFord(currencies[i], maxPath);
                opportunities.push.apply(opportunities, opps);
            }
            
            state.graph = originalGraph;
            
            const uniqueOpps = removeDuplicates(opportunities);
            uniqueOpps.sort(function(a, b) { return b.profitPercent - a.profitPercent; });
            
            state.opportunities.micro = uniqueOpps;
            displayOpportunities();
            
            updateStatus('Micro-cap scan complete - ' + uniqueOpps.length + ' opps');
            log('========== MICRO-CAP SCAN COMPLETE: ' + uniqueOpps.length + ' ==========', 'success');
            
            // Auto-switch to opportunities tab
            switchTab('opportunities');
        }

        // Enhanced opportunity display with categorization
        function displayOpportunities() {
            const container = document.getElementById('opportunitiesContainer');
            container.innerHTML = '';
            
            // Triangular Opportunities Section
            if (state.opportunities.triangular.length > 0) {
                container.innerHTML += `
                    <div class="opportunity-section">
                        <div class="opportunity-header" onclick="toggleSection('triangular')">
                            <span>Triangular Arbitrage (${state.opportunities.triangular.length})</span>
                            <span>▼</span>
                        </div>
                        <div class="opportunity-content" id="triangularSection">
                            ${state.opportunities.triangular.slice(0, 20).map(opp => renderOpportunity(opp)).join('')}
                        </div>
                    </div>
                `;
            }
            
            // Bellman-Ford Opportunities Section
            if (state.opportunities.bellman.length > 0) {
                container.innerHTML += `
                    <div class="opportunity-section">
                        <div class="opportunity-header" onclick="toggleSection('bellman')">
                            <span>Bellman-Ford Arbitrage (${state.opportunities.bellman.length})</span>
                            <span>▼</span>
                        </div>
                        <div class="opportunity-content" id="bellmanSection">
                            ${state.opportunities.bellman.slice(0, 20).map(opp => renderOpportunity(opp)).join('')}
                        </div>
                    </div>
                `;
            }
            
            // Micro-Cap Opportunities Section
            if (state.opportunities.micro.length > 0) {
                container.innerHTML += `
                    <div class="opportunity-section">
                        <div class="opportunity-header" onclick="toggleSection('micro')">
                            <span>Micro-Cap Arbitrage (${state.opportunities.micro.length})</span>
                            <span>▼</span>
                        </div>
                        <div class="opportunity-content" id="microSection">
                            ${state.opportunities.micro.slice(0, 20).map(opp => renderOpportunity(opp)).join('')}
                        </div>
                    </div>
                `;
            }
            
            if (container.innerHTML === '') {
                container.innerHTML = '<div class="card">No profitable opportunities found. Try lowering thresholds.</div>';
            }
        }

        function renderOpportunity(opp) {
            const oppClass = `opportunity ${opp.type} ${opp.profitPercent > 5 ? 'mega' : ''}`;
            
            let pathHtml = '<div class="path-visual">';
            for (let i = 0; i < opp.path.length - 1; i++) {
                const from = opp.path[i];
                const to = opp.path[i + 1];
                const edge = opp.edges[i];
                
                pathHtml += '<div style="margin: 2px 0;">';
                pathHtml += '<strong>' + from + ' → ' + to + '</strong> ';
                pathHtml += 'Rate: ' + edge.rate.toFixed(10) + ' | ';
                pathHtml += 'Liq: $' + edge.liquidity.toFixed(2) + ' | ';
                pathHtml += 'Spread: ' + (edge.spread * 100).toFixed(3) + '%';
                pathHtml += ' (' + edge.exchange + ')';
                pathHtml += '</div>';
            }
            pathHtml += '</div>';
            
            const maxTradeSize = Math.min(opp.totalLiquidity * 0.05, opp.investment * 10);
            const totalSpread = opp.edges.reduce(function(sum, e) { return sum + e.spread; }, 0);
            const slippageRisk = (totalSpread * 100).toFixed(2);
            const exchanges = opp.exchanges ? opp.exchanges.join(', ') : 'Multiple';
            
            return `
                <div class="${oppClass}">
                    <div style="display: flex; justify-content: space-between; margin-bottom: 4px;">
                        <strong>${opp.type.toUpperCase()}</strong>
                        <strong style="color: ${opp.profitPercent > 5 ? '#ffff00' : '#00ff00'}">+${opp.profitPercent.toFixed(6)}%</strong>
                    </div>
                    ${pathHtml}
                    <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; margin-top: 6px; font-size: 9px;">
                        <div>In: $${opp.investment.toFixed(2)}</div>
                        <div>Profit: $${opp.profit.toFixed(6)}</div>
                        <div>Out: $${opp.finalAmount.toFixed(6)}</div>
                        <div>MinLiq: $${opp.totalLiquidity.toFixed(2)}</div>
                    </div>
                    <div style="margin-top: 4px; padding: 3px; background: #0a0a1a; border-radius: 2px; font-size: 9px;">
                        <strong>Execution:</strong> MaxSize: $${maxTradeSize.toFixed(2)} | 
                        Slippage: ${slippageRisk}% | 
                        Exchanges: ${exchanges}
                    </div>
                </div>
            `;
        }

        function toggleSection(sectionId) {
            const content = document.getElementById(sectionId + 'Section');
            content.classList.toggle('collapsed');
            
            const header = event.target.closest('.opportunity-header');
            const arrow = header.querySelector('span:last-child');
            arrow.textContent = content.classList.contains('collapsed') ? '▶' : '▼';
        }

        function clearOpportunities() {
            state.opportunities = {
                triangular: [],
                bellman: [],
                micro: [],
                all: []
            };
            state.stats.oppCount = 0;
            updateStats();
            displayOpportunities();
            log('Opportunities cleared', 'info');
        }

        function updateAnalysis() {
            // Exchange coverage analysis
            const exchangeCoverage = document.getElementById('exchangeCoverage');
            let coverageHtml = '';
            
            Object.keys(state.exchanges).forEach(exchange => {
                const ex = state.exchanges[exchange];
                const coverage = ex.pairs.length > 0 ? (ex.pairs.length / state.stats.totalPairs * 100).toFixed(1) : 0;
                coverageHtml += `
                    <div class="stat">
                        <span>${ex.name}:</span>
                        <span class="stat-value">${ex.pairs.length} pairs (${coverage}%)</span>
                    </div>
                `;
            });
            
            exchangeCoverage.innerHTML = coverageHtml;
            
            // Currency hub analysis
            const currencyHubs = document.getElementById('currencyHubs');
            const hubCounts = {};
            
            Object.keys(state.graph).forEach(currency => {
                hubCounts[currency] = Object.keys(state.graph[currency]).length;
            });
            
            const topHubs = Object.keys(hubCounts)
                .sort((a, b) => hubCounts[b] - hubCounts[a])
                .slice(0, 10)
                .map(hub => `<div class="stat"><span>${hub}:</span><span class="stat-value">${hubCounts[hub]} connections</span></div>`)
                .join('');
                
            currencyHubs.innerHTML = topHubs;
        }

        window.addEventListener('load', function() {
            log('QuanTM FOAM v8.2 - Enhanced WebSocket Arbitrage Engine', 'success');
            setTimeout(initSystem, 500);
        });
    </script>
</body>
</html>
