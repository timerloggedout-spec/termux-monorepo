<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tipsdot_jpeg - YouTube Creators</title>
    <!-- SEO Meta Tags -->
    <meta name="description" content="Tipsdot_jpeg - home of fitness, diet, and lifestyle tips. Join the community and get inspired to live your best life.">
    <meta name="keywords" content="tipsdot_jpeg, YouTube, fitness, diet, lifestyle, gym, workout, fat loss, protein, meal plan">
    <meta name="author" content="tipsdot_jpeg">
    <!-- Open Graph / Social Media Meta Tags -->
    <meta property="og:title" content="Tipsdot_jpeg - YouTube Creators">
    <meta property="og:description" content="Home of fitness, diet, and lifestyle tips. Join the community!">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://www.youtube.com/@tipsdot_jpeg">
    <meta property="og:image" content="https://img.youtube.com/vi/VIDEO_ID/maxresdefault.jpg">
    <meta property="og:image:width" content="1280">
    <meta property="og:image:height" content="720">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="Tipsdot_jpeg - YouTube Creators">
    <meta name="twitter:description" content="Home of fitness, diet, and lifestyle tips. Join the community!">
    <meta name="twitter:image" content="https://img.youtube.com/vi/VIDEO_ID/maxresdefault.jpg">
    <style>
        /* Global Styles */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #0a0a0a;
            color: #eee;
            line-height: 1.6;
            overflow-x: hidden;
        }
        a {
            color: #f97316;
            text-decoration: none;
            transition: color 0.2s ease;
        }
        a:hover {
            color: #fb923c;
        }
        .container {
            max-width: 1100px;
            margin: 0 auto;
            padding: 0 20px;
        }
        /* Header */
        header {
            background: linear-gradient(135deg, #1a1a1a 0%, #0a0a0a 100%);
            border-bottom: 2px solid #f97316;
            padding: 15px 0;
            position: sticky;
            top: 0;
            z-index: 1000;
            backdrop-filter: blur(10px);
        }
        .header-inner {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .logo {
            font-size: 1.8rem;
            font-weight: bold;
            color: #f97316;
            letter-spacing: 1px;
        }
        .logo span {
            color: #fff;
        }
        nav ul {
            list-style: none;
            display: flex;
            gap: 25px;
        }
        nav ul li a {
            font-weight: 600;
            font-size: 1rem;
            color: #ccc;
            transition: color 0.2s;
        }
        nav ul li a:hover {
            color: #f97316;
        }
        .btn {
            display: inline-block;
            padding: 10px 25px;
            background-color: #f97316;
            color: #000;
            font-weight: bold;
            border-radius: 30px;
            transition: background-color 0.3s ease;
            border: none;
            cursor: pointer;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        .btn:hover {
            background-color: #fb923c;
        }
        /* Hero Section */
        .hero {
            background: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 600" width="1200" height="600"><rect width="1200" height="600" fill="%231a1a1a"/><circle cx="200" cy="150" r="80" fill="%23f97316" opacity="0.3"/><circle cx="900" cy="450" r="120" fill="%23f97316" opacity="0.2"/><circle cx="600" cy="300" r="180" fill="%23f97316" opacity="0.1"/><text x="600" y="280" font-family="Arial" font-size="60" fill="white" text-anchor="middle" font-weight="bold">TIPS DOT JPEG</text><text x="600" y="380" font-family="Arial" font-size="30" fill="%23f97316" text-anchor="middle">Fitness, Diet, Life</text></svg>');
            background-size: cover;
            background-position: center;
            height: 70vh;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            position: relative;
        }
        .hero::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.6);
        }
        .hero-content {
            position: relative;
            z-index: 1;
            max-width: 800px;
            padding: 20px;
        }
        .hero h1 {
            font-size: 4rem;
            margin-bottom: 20px;
            color: white;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.7);
        }
        .hero h1 span {
            color: #f97316;
        }
        .hero p {
            font-size: 1.4rem;
            margin-bottom: 30px;
            color: #ddd;
        }
        .cta-buttons {
            display: flex;
            gap: 20px;
            justify-content: center;
            flex-wrap: wrap;
        }
        .btn-outline {
            background: transparent;
            border: 2px solid #f97316;
            color: #f97316;
        }
        .btn-outline:hover {
            background-color: #f97316;
            color: #000;
        }
        /* Sections */
        section {
            padding: 80px 0;
        }
        .section-title {
            text-align: center;
            margin-bottom: 50px;
        }
        .section-title h2 {
            font-size: 2.5rem;
            color: #f97316;
            margin-bottom: 15px;
            position: relative;
            display: inline-block;
        }
        .section-title h2::after {
            content: '';
            width: 60%;
            height: 3px;
            background: #f97316;
            position: absolute;
            bottom: -10px;
            left: 20%;
        }
        .section-title p {
            font-size: 1.1rem;
            color: #aaa;
        }
        /* About Section */
        .about-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 40px;
            align-items: center;
        }
        .about-text h3 {
            font-size: 1.8rem;
            color: #f97316;
            margin-bottom: 20px;
        }
        .about-text p {
            margin-bottom: 20px;
            color: #ccc;
        }
        .about-image {
            background: #1a1a1a;
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(249, 115, 22, 0.2);
        }
        .about-image img {
            width: 100%;
            display: block;
            border-radius: 15px;
        }
        /* Latest Video Section */
        .video-container {
            position: relative;
            padding-bottom: 56.25%;
            height: 0;
            overflow: hidden;
            max-width: 100%;
            background: #000;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(249, 115, 22, 0.3);
        }
        .video-container iframe {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            border-radius: 15px;
        }
        /* Diet Plan Section */
        .diet-plan {
            background: #111;
            border-radius: 15px;
            padding: 40px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
            border-left: 4px solid #f97316;
        }
        .diet-plan h3 {
            font-size: 2rem;
            color: #f97316;
            margin-bottom: 25px;
        }
        .diet-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 30px;
            margin-top: 30px;
        }
        .diet-card {
            background: #1a1a1a;
            padding: 25px;
            border-radius: 12px;
            transition: transform 0.3s ease;
        }
        .diet-card:hover {
            transform: translateY(-5px);
        }
        .diet-card h4 {
            color: #f97316;
            margin-bottom: 15px;
            font-size: 1.3rem;
        }
        .diet-card ul {
            list-style: none;
            padding-left: 0;
        }
        .diet-card ul li {
            padding: 8px 0;
            border-bottom: 1px solid #333;
            color: #ccc;
        }
        .diet-card ul li:last-child {
            border-bottom: none;
        }
        /* Stats Section */
        .stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 30px;
            text-align: center;
        }
        .stat-box {
            background: #111;
            padding: 30px;
            border-radius: 15px;
            border: 1px solid #333;
            transition: transform 0.3s ease;
        }
        .stat-box:hover {
            transform: scale(1.05);
            border-color: #f97316;
        }
        .stat-number {
            font-size: 3rem;
            font-weight: bold;
            color: #f97316;
        }
        .stat-label {
            color: #aaa;
            font-size: 1.2rem;
        }
        /* Testimonials / Community */
        .testimonials {
            background: #111;
            padding: 40px;
            border-radius: 15px;
            margin-top: 30px;
        }
        .testimonial-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 30px;
        }
        .testimonial-card {
            background: #1a1a1a;
            padding: 25px;
            border-radius: 12px;
            position: relative;
        }
        .testimonial-card::before {
            content: '"';
            font-size: 4rem;
            color: #f97316;
            position: absolute;
            top: -15px;
            left: 15px;
            opacity: 0.5;
        }
        .testimonial-card p {
            color: #ccc;
            margin-bottom: 15px;
            font-style: italic;
        }
        .testimonial-card .author {
            color: #f97316;
            font-weight: bold;
        }
        /* Contact Section */
        .contact-form {
            max-width: 600px;
            margin: 0 auto;
            background: #111;
            padding: 40px;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        }
        .form-group {
            margin-bottom: 25px;
        }
        .form-group label {
            display: block;
            margin-bottom: 8px;
            color: #f97316;
            font-weight: 600;
        }
        .form-group input,
        .form-group textarea {
            width: 100%;
            padding: 12px 15px;
            background: #1a1a1a;
            border: 1px solid #333;
            border-radius: 8px;
            color: #eee;
            font-size: 1rem;
            transition: border-color 0.3s;
        }
        .form-group input:focus,
        .form-group textarea:focus {
            outline: none;
            border-color: #f97316;
        }
        .form-group textarea {
            height: 120px;
            resize: vertical;
        }
        /* Footer */
        footer {
            background: #000;
            padding: 40px 0;
            text-align: center;
            border-top: 2px solid #f97316;
        }
        .social-links {
            display: flex;
            justify-content: center;
            gap: 30px;
            margin-bottom: 25px;
        }
        .social-links a {
            font-size: 1.8rem;
            color: #ccc;
            transition: color 0.3s, transform 0.3s;
        }
        .social-links a:hover {
            color: #f97316;
            transform: translateY(-3px);
        }
        footer p {
            color: #666;
        }
        /* Responsive */
        @media (max-width: 768px) {
            .about-grid {
                grid-template-columns: 1fr;
            }
            .hero h1 {
                font-size: 2.5rem;
            }
            .hero p {
                font-size: 1.2rem;
            }
            nav ul {
                gap: 15px;
            }
            .header-inner {
                flex-direction: column;
                gap: 10px;
            }
        }
    </style>
</head>
<body>
    <!-- Header -->
    <header>
        <div class="container header-inner">
            <div class="logo">tips<span>dot</span>_jpeg</div>
            <nav>
                <ul>
                    <li><a href="#about">About</a></li>
                    <li><a href="#videos">Videos</a></li>
                    <li><a href="#diet">Diet Plan</a></li>
                    <li><a href="#community">Community</a></li>
                    <li><a href="#contact">Contact</a></li>
                </ul>
            </nav>
            <a href="https://www.youtube.com/@tipsdot_jpeg" target="_blank" class="btn">Subscribe</a>
        </div>
    </header>

    <!-- Hero -->
    <section class="hero">
        <div class="hero-content">
            <h1>TIPS <span>DOT</span> JPEG</h1>
            <p>Fuel your body. Transform your mind. Live the life you deserve.</p>
            <div class="cta-buttons">
                <a href="#videos" class="btn">Latest Video</a>
                <a href="#diet" class="btn btn-outline">Diet Plan</a>
            </div>
        </div>
    </section>

    <!-- About Section -->
    <section id="about">
        <div class="container">
            <div class="section-title">
                <h2>About the Channel</h2>
                <p>Learn about the creator behind tipsdot_jpeg</p>
            </div>
            <div class="about-grid">
                <div class="about-text">
                    <h3>Welcome to tipsdot_jpeg</h3>
                    <p>Hey, I'm Tips, and this is my corner of the internet. I'm on a mission to share what I've learned about fitness, fat loss, and building muscle without overcomplicating things. My channel is a mix of real-talk nutrition advice, workout routines, and the occasional life hack that actually works.</p>
                    <p>I've lost over 20kg of fat and gained lean muscle through a simple, no-BS approach: drink your water, eat real food, cut out the junk, and lift heavy things. On this page you'll find my signature "Read Last Paragraph Minimum OK?" diet plan that's been getting people results.</p>
                    <p>When I'm not in the gym, I'm experimenting with homemade bread, banana bread that's "friggin delish," and trying to stay away from Starbursts (I cheat sometimes). Join 3,170+ subscribers and let's grow together!</p>
                    <a href="https://www.youtube.com/@tipsdot_jpeg" target="_blank" class="btn" style="margin-top:20px;">Visit YouTube Channel</a>
                </div>
                <div class="about-image">
                    <img src="data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='500' height='400' viewBox='0 0 500 400'><rect width='500' height='400' fill='%231a1a1a'/><circle cx='250' cy='180' r='100' fill='%23f97316' opacity='0.6'/><text x='250' y='190' font-family='Arial' font-size='24' fill='white' text-anchor='middle'>TIPS</text><text x='250' y='340' font-family='Arial' font-size='20' fill='%23ccc' text-anchor='middle'>Fitness &amp; Diet</text></svg>" alt="Tipsdot_jpeg channel art">
                </div>
            </div>
        </div>
    </section>

    <!-- Latest Video Section -->
    <section id="videos" style="background-color:#0f0f0f;">
        <div class="container">
            <div class="section-title">
                <h2>Watch the Latest</h2>
                <p>Chest & Triceps Workout Live!</p>
            </div>
            <div class="video-container">
                <!-- Replace VIDEO_ID with actual YouTube video ID -->
                <iframe src="https://www.youtube.com/embed/sample_id" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen title="Latest tipsdot_jpeg video"></iframe>
            </div>
            <div style="text-align:center; margin-top:25px;">
                <a href="https://www.youtube.com/@tipsdot_jpeg/videos" target="_blank" class="btn">View All Videos</a>
            </div>
        </div>
    </section>

    <!-- Diet Plan Section -->
    <section id="diet">
        <div class="container">
            <div class="section-title">
                <h2>The Famous Diet Plan</h2>
                <p>"Read Last Paragraph Minimum OK?" - Tips' Fat Loss Diet</p>
            </div>
            <div class="diet-plan">
                <h3>MY Fat Loss Diet (as described by Tips)</h3>
                <p style="color:#ccc; margin-bottom:25px;">This is the exact plan that helped Tips drop weight and build muscle. Always consult a professional before starting any new diet.</p>
                <div class="diet-grid">
                    <div class="diet-card">
                        <h4>🌅 Morning & Pre-Workout</h4>
                        <ul>
                            <li>Water all day with BCAAs or "Sport Drink"</li>
                            <li>Pre-workout or coffee in the morning</li>
                            <li>Methylene blue (20-30mg)</li>
                            <li>Pre-workout before lifts around 6:50pm</li>
                        </ul>
                    </div>
                    <div class="diet-card">
                        <h4>☀️ Noon Meal</h4>
                        <ul>
                            <li>Oatmeal</li>
                            <li>Peanut butter, honey, banana, salt</li>
                            <li>Protein shake (50g protein)</li>
                        </ul>
                    </div>
                    <div class="diet-card">
                        <h4>🥜 Snacks</h4>
                        <ul>
                            <li>1-2 bananas between meals</li>
                            <li>2-3 handfuls of nuts and seeds</li>
                            <li>Scoops of PB & a swig of whole milk</li>
                            <li>Vitamins with PB or milk (fat soluble)</li>
                        </ul>
                    </div>
                    <div class="diet-card">
                        <h4>🍖 Evening Meal (4-7pm)</h4>
                        <ul>
                            <li>Meat source (beef/chicken/pork)</li>
                            <li>Veggies</li>
                            <li>Baked potato (microwaved, cooled)</li>
                            <li>Protein shake (50g protein)</li>
                        </ul>
                    </div>
                    <div class="diet-card">
                        <h4>🚫 Foods to AVOID</h4>
                        <ul>
                            <li>Store-bought bread</li>
                            <li>Cake, Pie, Cookies, Donuts, Brownies</li>
                            <li>Air heads, Starbursts (cheat sometimes)</li>
                            <li>Pasta! NO PASTA!</li>
                            <li>SODA! NO SODA! No HFCS!</li>
                        </ul>
                    </div>
                    <div class="diet-card">
                        <h4>✅ Allowed in Moderation</h4>
                        <ul>
                            <li>Real sugar</li>
                            <li>Butter</li>
                            <li>Extra virgin olive oil</li>
                            <li>Milk</li>
                            <li>Cheese</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Stats Section -->
    <section style="background-color:#0f0f0f;">
        <div class="container">
            <div class="section-title">
                <h2>Channel Stats</h2>
                <p>As of 2026, tipsdot_jpeg is growing fast</p>
            </div>
            <div class="stats">
                <div class="stat-box">
                    <div class="stat-number">3,170</div>
                    <div class="stat-label">Subscribers</div>
                </div>
                <div class="stat-box">
                    <div class="stat-number">1,081</div>
                    <div class="stat-label">Videos</div>
                </div>
                <div class="stat-box">
                    <div class="stat-number">150g</div>
                    <div class="stat-label">Daily Protein Goal</div>
                </div>
                <div class="stat-box">
                    <div class="stat-number">20kg+</div>
                    <div class="stat-label">Fat Loss Journey</div>
                </div>
            </div>
        </div>
    </section>

    <!-- Community Testimonials -->
    <section id="community">
        <div class="container">
            <div class="section-title">
                <h2>Community Love</h2>
                <p>What people are saying about the channel</p>
            </div>
            <div class="testimonials">
                <div class="testimonial-grid">
                    <div class="testimonial-card">
                        <p>"I recommend this youtube channel. surprised it actually exists. just two uploads, but very solid so far."</p>
                        <div class="author">— funnyjunk.com user</div>
                    </div>
                    <div class="testimonial-card">
                        <p>"The diet plan is straight fire. Finally someone who keeps it real about what works and what doesn't."</p>
                        <div class="author">— YouTube Commenter</div>
                    </div>
                    <div class="testimonial-card">
                        <p>"Tipsdot_jpeg got me off soda and onto whole foods. Down 12 lbs in 6 weeks. Love ya Tips!"</p>
                        <div class="author">— Subscriber</div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Contact Section -->
    <section id="contact" style="background-color:#0f0f0f;">
        <div class="container">
            <div class="section-title">
                <h2>Get In Touch</h2>
                <p>Have questions about the diet or want to collaborate?</p>
            </div>
            <div class="contact-form">
                <form action="#" method="POST">
                    <div class="form-group">
                        <label for="name">Your Name</label>
                        <input type="text" id="name" name="name" placeholder="Enter your name" required>
                    </div>
                    <div class="form-group">
                        <label for="email">Email Address</label>
                        <input type="email" id="email" name="email" placeholder="Enter your email" required>
                    </div>
                    <div class="form-group">
                        <label for="message">Message</label>
                        <textarea id="message" name="message" placeholder="What would you like to ask Tips?" required></textarea>
                    </div>
                    <button type="submit" class="btn" style="width:100%;">Send Message</button>
                </form>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer>
        <div class="container">
            <div class="social-links">
                <a href="https://www.youtube.com/@tipsdot_jpeg" target="_blank" title="YouTube">▶</a>
                <a href="#" title="Instagram (coming soon)">📷</a>
                <a href="#" title="TikTok (coming soon)">🎵</a>
            </div>
            <p>© 2026 tipsdot_jpeg. This is a fan-made page. All rights belong to the channel owner.</p>
            <p style="margin-top:10px;">Disclaimer: The diet plan is the creator's personal approach. Consult a healthcare professional before making dietary changes.</p>
            <p><a href="https://www.youtube.com/@tipsdot_jpeg" target="_blank" style="color:#f97316;">Subscribe on YouTube</a></p>
        </div>
    </footer>
</body>
</html>
