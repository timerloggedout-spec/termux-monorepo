<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Streamer Dashboard – Expandable Chats</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: system-ui, sans-serif;
      background: #0a0a0a;
      color: #fff;
      height: 100vh;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    /* Toolbar */
    .toolbar {
      display: flex;
      gap: 10px;
      padding: 10px;
      background: #1a1a1a;
      align-items: center;
      flex-wrap: wrap;
    }
    .toolbar input {
      padding: 6px 10px;
      border-radius: 4px;
      border: 1px solid #333;
      background: #2a2a2a;
      color: #fff;
      width: 160px;
    }
    .toolbar button {
      padding: 6px 14px;
      border: none;
      border-radius: 4px;
      font-weight: bold;
      cursor: pointer;
      background: #3ea6ff;
      color: #000;
    }
    .btn-go-live { background: #ff4d4d; color: #fff; }
    .btn-stop { background: #555; color: #fff; display: none; }
    .status { margin-left: auto; font-size: 0.9rem; }
    .status span { color: #ff4d4d; }

    /* Main grid */
    .main-grid {
      flex: 1;
      display: grid;
      grid-template-columns: 1fr 4px 1fr;
      min-height: 0;
      transition: grid-template-columns 0.3s;
    }

    /* Watch panel */
    .watch-panel {
      display: flex;
      flex-direction: column;
      min-width: 0;
      overflow: hidden;
    }
    .player-container {
      flex: 3;
      background: #000;
      min-height: 0;
      transition: flex 0.3s, max-height 0.3s;
      overflow: hidden;
      position: relative;
    }
    .player-container.collapsed {
      flex: 0 0 60px;
      max-height: 60px;
    }
    .player-container iframe {
      width: 100%;
      height: 100%;
      border: none;
    }
    .watched-chat {
      flex: 1;
      min-height: 150px;
      border-top: 1px solid #333;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      transition: flex 0.3s;
    }
    .watched-chat.expanded {
      flex: 5;
    }
    .chat-header-bar {
      padding: 6px 10px;
      background: #1f1f1f;
      font-weight: bold;
      font-size: 0.85rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .chat-header-bar button {
      background: transparent;
      border: 1px solid #555;
      color: #ccc;
      border-radius: 4px;
      padding: 2px 8px;
      cursor: pointer;
      font-size: 1rem;
      transition: background 0.2s;
    }
    .chat-header-bar button:hover {
      background: #333;
    }
    .watched-chat iframe {
      width: 100%;
      flex: 1;
      border: none;
      background: #181818;
    }

    /* Resize handle */
    .resize-handle {
      background: #2a2a2a;
      cursor: col-resize;
      transition: background 0.2s;
    }
    .resize-handle:hover { background: #555; }

    /* Broadcast panel */
    .broadcast-panel {
      display: flex;
      flex-direction: column;
      min-width: 0;
      overflow: hidden;
    }
    .preview-section {
      height: 220px;
      background: #111;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      border-bottom: 1px solid #333;
      transition: height 0.3s;
    }
    .preview-section.minimized {
      height: 60px;
    }
    #localVideo {
      width: 100%;
      height: 100%;
      object-fit: contain;
      display: none;
    }
    .preview-placeholder {
      color: #666;
      font-size: 1.5rem;
    }
    .participants-grid {
      flex: 1;
      display: flex;
      flex-wrap: wrap;
      gap: 4px;
      padding: 4px;
      overflow-y: auto;
      align-content: flex-start;
      min-height: 60px;
      transition: flex 0.3s, max-height 0.3s;
    }
    .participants-grid.collapsed {
      flex: 0 0 60px;
      max-height: 60px;
    }
    .participant-card {
      width: calc(50% - 6px);
      aspect-ratio: 4/3;
      background: #1a1a1a;
      border-radius: 6px;
      overflow: hidden;
      position: relative;
      min-width: 120px;
    }
    .participant-card video {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .participant-label {
      position: absolute;
      bottom: 4px;
      left: 4px;
      background: rgba(0,0,0,0.7);
      padding: 2px 6px;
      border-radius: 4px;
      font-size: 0.75rem;
    }
    .your-chat {
      display: flex;
      flex-direction: column;
      border-top: 1px solid #333;
      transition: flex 0.3s;
      min-height: 60px;
    }
    .your-chat.expanded {
      flex: 1;
    }
    .chat-messages {
      flex: 1;
      overflow-y: auto;
      padding: 8px;
      background: #0f0f0f;
      display: flex;
      flex-direction: column;
      gap: 4px;
      font-size: 0.8rem;
    }
    .chat-message {
      word-break: break-word;
    }
    .chat-message .author {
      font-weight: bold;
      color: #3ea6ff;
      margin-right: 6px;
    }
    .chat-input-area {
      display: flex;
      padding: 6px;
      border-top: 1px solid #333;
      background: #1a1a1a;
    }
    .chat-input-area input {
      flex: 1;
      padding: 6px;
      border-radius: 4px;
      border: none;
      background: #2a2a2a;
      color: white;
    }
    .chat-input-area button {
      margin-left: 6px;
      padding: 6px 12px;
      background: #3ea6ff;
      border: none;
      border-radius: 4px;
      font-weight: bold;
      cursor: pointer;
    }
  </style>
</head>
<body>
  <div class="toolbar">
    <input id="watchVideoId" placeholder="Watched video ID" value="jfKfPfyJRdk">
    <button id="loadWatchBtn">Load</button>
    <input id="ownVideoId" placeholder="Your live video ID" value="">
    <button id="loadOwnChatBtn">Own Chat</button>
    <button id="goLiveBtn" class="btn-go-live">🔴 Go Live</button>
    <button id="stopLiveBtn" class="btn-stop">Stop</button>
    <button id="joinCallBtn" style="background:#3ea6ff;">👥 Join Room</button>
    <div class="status">Your stream: <span id="streamStatus">off</span></div>
  </div>

  <div class="main-grid" id="mainGrid">
    <!-- Watch panel -->
    <div class="watch-panel" id="watchPanel">
      <div class="player-container" id="playerContainer">
        <div id="player"></div>
      </div>
      <div class="watched-chat" id="watchedChatContainer">
        <div class="chat-header-bar">
          <span>💬 Watched stream chat</span>
          <button id="toggleWatchedChatBtn" title="Maximize/Minimize chat">🗖</button>
        </div>
        <iframe id="watchedChatIframe" style="display:none;"></iframe>
        <div style="color:#666; padding:20px; text-align:center;">Live chat will appear here</div>
      </div>
    </div>

    <!-- Resize handle -->
    <div class="resize-handle" id="resizeHandle"></div>

    <!-- Broadcast panel -->
    <div class="broadcast-panel">
      <div class="preview-section" id="previewSection">
        <video id="localVideo" autoplay muted playsinline></video>
        <div id="previewPlaceholder" class="preview-placeholder">📷 Your camera</div>
      </div>
      <div class="participants-grid" id="participantsGrid">
        <div style="color:#444; width:100%; text-align:center; padding-top:20px;">
          Remote participants appear here
        </div>
      </div>
      <div class="your-chat" id="yourChatPanel">
        <div class="chat-header-bar">
          <span>💬 Your broadcast chat</span>
          <button id="toggleYourChatBtn" title="Maximize/Minimize chat">🗖</button>
        </div>
        <div class="chat-messages" id="yourChatMessages"></div>
        <div class="chat-input-area" id="viewerChatInputArea" style="display:none;">
          <input id="viewerChatInput" placeholder="Send a message as a viewer...">
          <button id="sendViewerMsgBtn">Send</button>
        </div>
        <div id="broadcasterNotice" style="padding:10px;color:#888;text-align:center;">
          Open another tab and start a call to see messages.
        </div>
      </div>
    </div>
  </div>

  <!-- YouTube IFrame API -->
  <script>
    const tag = document.createElement('script');
    tag.src = "https://www.youtube.com/iframe_api";
    const firstScriptTag = document.getElementsByTagName('script')[0];
    firstScriptTag.parentNode.insertBefore(tag, firstScriptTag);

    let player;
    window.onYouTubeIframeAPIReady = () => {
      player = new YT.Player('player', {
        videoId: '',
        playerVars: { autoplay: 1, controls: 1, modestbranding: 1 },
        events: { 'onReady': () => loadWatchVideo() }
      });
    };

    function loadWatchVideo() {
      const videoId = document.getElementById('watchVideoId').value.trim() || 'jfKfPfyJRdk';
      if (player && player.loadVideoById) {
        player.loadVideoById(videoId);
        updateWatchedChat(videoId);
      }
    }
    document.getElementById('loadWatchBtn').addEventListener('click', loadWatchVideo);

    function updateWatchedChat(videoId) {
      const iframe = document.getElementById('watchedChatIframe');
      const container = document.getElementById('watchedChatContainer');
      const placeholder = container.querySelector('div:not(.chat-header-bar)');
      if (!videoId) {
        iframe.style.display = 'none';
        if (placeholder) placeholder.style.display = 'block';
        return;
      }
      iframe.src = `https://www.youtube.com/live_chat?v=${videoId}&embed_domain=${window.location.hostname}`;
      iframe.style.display = 'block';
      if (placeholder) placeholder.style.display = 'none';
    }

    document.getElementById('loadOwnChatBtn').addEventListener('click', () => {
      const ownId = document.getElementById('ownVideoId').value.trim();
      if (ownId) alert(`Embed your own live chat: https://www.youtube.com/live_chat?v=${ownId}`);
    });

    // ---------- Expand/Collapse Chats ----------
    const toggleWatchedChatBtn = document.getElementById('toggleWatchedChatBtn');
    const watchedChatContainer = document.getElementById('watchedChatContainer');
    const playerContainer = document.getElementById('playerContainer');
    let watchedChatExpanded = false;

    toggleWatchedChatBtn.addEventListener('click', () => {
      watchedChatExpanded = !watchedChatExpanded;
      if (watchedChatExpanded) {
        // Expand watched chat: shrink player, grow chat
        playerContainer.classList.add('collapsed');
        watchedChatContainer.classList.add('expanded');
        toggleWatchedChatBtn.textContent = '🗕';
      } else {
        playerContainer.classList.remove('collapsed');
        watchedChatContainer.classList.remove('expanded');
        toggleWatchedChatBtn.textContent = '🗖';
      }
    });

    const toggleYourChatBtn = document.getElementById('toggleYourChatBtn');
    const yourChatPanel = document.getElementById('yourChatPanel');
    const participantsGrid = document.getElementById('participantsGrid');
    const previewSection = document.getElementById('previewSection');
    let yourChatExpanded = false;

    toggleYourChatBtn.addEventListener('click', () => {
      yourChatExpanded = !yourChatExpanded;
      if (yourChatExpanded) {
        // Expand your broadcast chat: minimize preview & participants
        previewSection.classList.add('minimized');
        participantsGrid.classList.add('collapsed');
        yourChatPanel.classList.add('expanded');
        toggleYourChatBtn.textContent = '🗕';
      } else {
        previewSection.classList.remove('minimized');
        participantsGrid.classList.remove('collapsed');
        yourChatPanel.classList.remove('expanded');
        toggleYourChatBtn.textContent = '🗖';
      }
    });

    // ---------- Broadcast & Multi‑Party (WebRTC + BroadcastChannel) ----------
    const CHANNEL = 'streamer-room';
    const bc = new BroadcastChannel(CHANNEL);
    const myId = Date.now().toString(36) + Math.random().toString(36).substr(2,5);

    let localStream = null;
    let isLive = false;
    const localVideo = document.getElementById('localVideo');
    const goLiveBtn = document.getElementById('goLiveBtn');
    const stopLiveBtn = document.getElementById('stopLiveBtn');
    const streamStatus = document.getElementById('streamStatus');
    const placeholder = document.getElementById('previewPlaceholder');
    const yourChatMessages = document.getElementById('yourChatMessages');
    const viewerCountSpan = document.getElementById('viewerCount');
    let viewerCount = 0;
    const viewerChatInputArea = document.getElementById('viewerChatInputArea');
    const viewerChatInput = document.getElementById('viewerChatInput');
    const sendViewerMsgBtn = document.getElementById('sendViewerMsgBtn');
    const broadcasterNotice = document.getElementById('broadcasterNotice');

    const peerConnections = new Map();
    const remoteStreams = new Map();

    async function startBroadcast() {
      try {
        localStream = await navigator.mediaDevices.getUserMedia({ video: true, audio: true });
        localVideo.srcObject = localStream;
        localVideo.style.display = 'block';
        placeholder.style.display = 'none';
        isLive = true;
        goLiveBtn.style.display = 'none';
        stopLiveBtn.style.display = 'inline-block';
        streamStatus.textContent = 'live 🔴';
        streamStatus.style.color = '#ff4d4d';
        bc.postMessage({ type: 'broadcast-start', id: myId });
      } catch (err) {
        alert('Camera/mic access denied: ' + err.message);
      }
    }

    function stopBroadcast() {
      if (localStream) {
        localStream.getTracks().forEach(t => t.stop());
        localStream = null;
      }
      localVideo.srcObject = null;
      localVideo.style.display = 'none';
      placeholder.style.display = 'flex';
      isLive = false;
      goLiveBtn.style.display = 'inline-block';
      stopLiveBtn.style.display = 'none';
      streamStatus.textContent = 'off';
      streamStatus.style.color = '';
      bc.postMessage({ type: 'broadcast-stop', id: myId });
      for (const pc of peerConnections.values()) pc.close();
      peerConnections.clear();
      remoteStreams.clear();
      participantsGrid.innerHTML = '<div style="color:#444; width:100%; text-align:center; padding-top:20px;">Remote participants appear here</div>';
      if (yourChatExpanded) {
        // Reset expanded state if chat was expanded
        toggleYourChatBtn.click();
      }
      viewerCount = 0;
      updateViewerCount();
      yourChatMessages.innerHTML = '';
      broadcasterNotice.style.display = 'block';
    }

    goLiveBtn.addEventListener('click', startBroadcast);
    stopLiveBtn.addEventListener('click', stopBroadcast);

    document.getElementById('joinCallBtn').addEventListener('click', () => {
      if (!localStream) {
        alert('Start your broadcast first to join with camera.');
        return;
      }
      bc.postMessage({ type: 'join-room', id: myId });
    });

    bc.onmessage = (e) => {
      const msg = e.data;
      if (!msg || msg.id === myId) return;

      if (msg.type === 'broadcast-start') {}
      else if (msg.type === 'broadcast-stop') {}
      else if (msg.type === 'viewer-join') {
        if (isLive) { viewerCount++; updateViewerCount(); }
      }
      else if (msg.type === 'viewer-leave') {
        if (isLive) { viewerCount = Math.max(0, viewerCount - 1); updateViewerCount(); }
      }
      else if (msg.type === 'chat-message') {
        if (isLive) {
          const div = document.createElement('div');
          div.className = 'chat-message';
          div.innerHTML = `<span class="author">${msg.author}:</span>${msg.text}`;
          yourChatMessages.appendChild(div);
          yourChatMessages.scrollTop = yourChatMessages.scrollHeight;
        }
      }
      else if (msg.type === 'join-room') handleNewPeer(msg.id);
      else if (msg.type === 'offer' && msg.to === myId) handleOffer(msg.from, msg.sdp);
      else if (msg.type === 'answer' && msg.to === myId) handleAnswer(msg.from, msg.sdp);
      else if (msg.type === 'ice-candidate' && msg.to === myId) handleIceCandidate(msg.from, msg.candidate);
      else if (msg.type === 'leave-room') handlePeerLeave(msg.id);
    };

    function updateViewerCount() {
      viewerCountSpan.textContent = `${viewerCount} viewer${viewerCount !== 1 ? 's' : ''}`;
      broadcasterNotice.style.display = viewerCount > 0 ? 'none' : 'block';
    }

    function createPeerConnection(peerId) {
      const pc = new RTCPeerConnection({ iceServers: [{ urls: 'stun:stun.l.google.com:19302' }] });
      peerConnections.set(peerId, pc);
      if (localStream) localStream.getTracks().forEach(track => pc.addTrack(track, localStream));
      pc.onicecandidate = (event) => {
        if (event.candidate) bc.postMessage({ type: 'ice-candidate', candidate: event.candidate, from: myId, to: peerId });
      };
      pc.ontrack = (event) => {
        const remoteStream = event.streams[0];
        if (!remoteStream) return;
        remoteStreams.set(peerId, remoteStream);
        addRemoteVideo(peerId, remoteStream);
      };
      pc.onconnectionstatechange = () => {
        if (pc.connectionState === 'failed' || pc.connectionState === 'disconnected') handlePeerLeave(peerId);
      };
      return pc;
    }

    function addRemoteVideo(peerId, stream) {
      const placeholderDiv = participantsGrid.querySelector('div:first-child');
      if (placeholderDiv && placeholderDiv.textContent.includes('Remote participants')) placeholderDiv.remove();
      let card = document.getElementById(`remote-${peerId}`);
      if (!card) {
        card = document.createElement('div');
        card.className = 'participant-card';
        card.id = `remote-${peerId}`;
        const vid = document.createElement('video');
        vid.autoplay = true;
        vid.playsInline = true;
        const label = document.createElement('div');
        label.className = 'participant-label';
        label.textContent = `Peer ${peerId.slice(-4)}`;
        card.appendChild(vid); card.appendChild(label);
        participantsGrid.appendChild(card);
      }
      const videoEl = card.querySelector('video');
      if (videoEl.srcObject !== stream) videoEl.srcObject = stream;
    }

    function handleNewPeer(peerId) {
      if (peerConnections.has(peerId)) return;
      const pc = createPeerConnection(peerId);
      pc.createOffer().then(offer => pc.setLocalDescription(offer)).then(() => {
        bc.postMessage({ type: 'offer', sdp: pc.localDescription, from: myId, to: peerId });
      }).catch(console.error);
    }

    async function handleOffer(peerId, sdp) {
      if (peerConnections.has(peerId)) return;
      const pc = createPeerConnection(peerId);
      await pc.setRemoteDescription(new RTCSessionDescription(sdp));
      const answer = await pc.createAnswer();
      await pc.setLocalDescription(answer);
      bc.postMessage({ type: 'answer', sdp: pc.localDescription, from: myId, to: peerId });
    }

    async function handleAnswer(peerId, sdp) {
      const pc = peerConnections.get(peerId);
      if (!pc) return;
      await pc.setRemoteDescription(new RTCSessionDescription(sdp));
    }

    function handleIceCandidate(peerId, candidate) {
      const pc = peerConnections.get(peerId);
      if (pc) pc.addIceCandidate(new RTCIceCandidate(candidate)).catch(console.error);
    }

    function handlePeerLeave(peerId) {
      const pc = peerConnections.get(peerId);
      if (pc) { pc.close(); peerConnections.delete(peerId); }
      const card = document.getElementById(`remote-${peerId}`);
      if (card) card.remove();
      remoteStreams.delete(peerId);
      if (participantsGrid.children.length === 0) {
        participantsGrid.innerHTML = '<div style="color:#444; width:100%; text-align:center; padding-top:20px;">Remote participants appear here</div>';
      }
      bc.postMessage({ type: 'leave-room', id: peerId });
    }

    // Viewer chat simulation (?viewer=true)
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('viewer') === 'true') {
      document.title = 'Viewer – Watch Party';
      document.querySelector('.preview-section').style.display = 'none';
      participantsGrid.style.display = 'none';
      viewerChatInputArea.style.display = 'flex';
      broadcasterNotice.style.display = 'none';
      bc.postMessage({ type: 'viewer-join', id: myId });
      window.addEventListener('beforeunload', () => bc.postMessage({ type: 'viewer-leave', id: myId }));
      sendViewerMsgBtn.addEventListener('click', sendViewerMessage);
      viewerChatInput.addEventListener('keypress', (e) => { if (e.key === 'Enter') sendViewerMessage(); });
      function sendViewerMessage() {
        const text = viewerChatInput.value.trim();
        if (text) {
          bc.postMessage({ type: 'chat-message', author: 'Viewer_' + myId.slice(-4), text });
          viewerChatInput.value = '';
        }
      }
    }

    window.addEventListener('beforeunload', () => {
      bc.postMessage({ type: 'leave-room', id: myId });
      if (isLive) bc.postMessage({ type: 'broadcast-stop', id: myId });
      for (const pc of peerConnections.values()) pc.close();
      if (localStream) localStream.getTracks().forEach(t => t.stop());
    });

    // Resize handle (unchanged)
    (function() {
      const handle = document.getElementById('resizeHandle');
      const mainGrid = document.getElementById('mainGrid');
      let isResizing = false;
      handle.addEventListener('mousedown', (e) => {
        isResizing = true;
        document.body.style.cursor = 'col-resize';
        e.preventDefault();
      });
      document.addEventListener('mousemove', (e) => {
        if (!isResizing) return;
        const gridRect = mainGrid.getBoundingClientRect();
        const leftWidth = e.clientX - gridRect.left;
        if (leftWidth < 300 || leftWidth > gridRect.width - 300) return;
        mainGrid.style.gridTemplateColumns = `${leftWidth}px 4px 1fr`;
      });
      document.addEventListener('mouseup', () => {
        isResizing = false;
        document.body.style.cursor = '';
      });
    })();
  </script>
</body>
</html>
