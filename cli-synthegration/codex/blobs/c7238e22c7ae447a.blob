// ====================== CONFIGURATION ======================
const SHEET_ID = 'YOUR_SHEET_ID';

const SHEETS = {
  compounds: 'compounds',
  country_tiers: 'country_tiers',
  trials: 'trials',
  organizations: 'organizations',
  sources: 'sources',
  synonyms: 'synonyms',
  interactions: 'interactions',
  research_links: 'research_links',
  combination_stacks: 'combination_stacks',
  production_facilities: 'production_facilities',
  shipping_restrictions: 'shipping_restrictions'
};

// ====================== WEB APP API ======================
function doGet(e) {
  const type = e?.parameter?.type || 'compounds';
  const sheetName = SHEETS[type] || SHEETS.compounds;
  const sheet = SpreadsheetApp.openById(SHEET_ID).getSheetByName(sheetName);
  if (!sheet) {
    return ContentService.createTextOutput(JSON.stringify({error: 'Sheet not found'}))
      .setMimeType(ContentService.MimeType.JSON);
  }
  const rows = sheet.getDataRange().getValues();
  const headers = rows[0];
  const data = rows.slice(1).map(row => {
    let obj = {};
    headers.forEach((h, i) => obj[h] = row[i] || '');
    return obj;
  });
  return ContentService.createTextOutput(JSON.stringify(data))
    .setMimeType(ContentService.MimeType.JSON);
}

function doPost(e) {
  const action = e?.parameter?.action;
  const payload = JSON.parse(e.postData.contents);

  if (action === 'enrich') return handleEnrich(payload.query);
  if (action === 'approve') return handleApproval(payload.id, 'approved');
  if (action === 'reject') return handleApproval(payload.id, 'rejected');
  if (action === 'ingestUrl') return handleIngestUrl(payload.url);
  if (action === 'addSource') return handleAddSource(payload);
  if (action === 'addFacility') return handleAddFacility(payload);

  // Default: batch update compounds (CSV import)
  const sheet = SpreadsheetApp.openById(SHEET_ID).getSheetByName(SHEETS.compounds);
  const headers = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0];
  sheet.getRange(2, 1, sheet.getLastRow() - 1, sheet.getLastColumn()).clear();
  payload.forEach(row => {
    const rowData = headers.map(h => row[h] || '');
    sheet.appendRow(rowData);
  });
  return ContentService.createTextOutput(JSON.stringify({success: true, count: payload.length}))
    .setMimeType(ContentService.MimeType.JSON);
}

// ====================== PDF INGESTION ======================
function handleIngestUrl(url) {
  try {
    // Fetch PDF as blob
    const response = UrlFetchApp.fetch(url, {muteHttpExceptions: true});
    if (response.getResponseCode() !== 200) {
      return ContentService.createTextOutput(JSON.stringify({error: 'Failed to fetch PDF'}))
        .setMimeType(ContentService.MimeType.JSON);
    }
    const blob = response.getBlob();

    // Use Drive API to extract text (OCR if needed)
    const resource = { title: 'temp_pdf', mimeType: 'application/pdf' };
    const file = Drive.Files.insert(resource, blob, {ocr: true, ocrLanguage: 'en'});
    const doc = DocumentApp.openById(file.id);
    const text = doc.getBody().getText();
    Drive.Files.remove(file.id); // clean up

    // Parse the catalogue text
    const products = parseCatalogueText(text);
    if (products.length === 0) {
      return ContentService.createTextOutput(JSON.stringify({error: 'No products found'}))
        .setMimeType(ContentService.MimeType.JSON);
    }

    // Append to compounds sheet
    const sheet = SpreadsheetApp.openById(SHEET_ID).getSheetByName(SHEETS.compounds);
    const headers = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0];
    const existingIds = sheet.getRange(2, 1, sheet.getLastRow()-1, 1).getValues().flat();

    let added = 0;
    products.forEach(p => {
      // Check if already exists by name
      const exists = existingIds.some(id => id === p.Entity_ID) ||
                     sheet.getDataRange().getValues().slice(1).some(row =>
                       row[1]?.toString().toLowerCase() === p.Canonical_Name.toLowerCase()
                     );
      if (!exists) {
        const row = headers.map(h => p[h] || '');
        sheet.appendRow(row);
        added++;
      }
    });

    return ContentService.createTextOutput(JSON.stringify({success: true, added, total: products.length}))
      .setMimeType(ContentService.MimeType.JSON);
  } catch (e) {
    return ContentService.createTextOutput(JSON.stringify({error: e.toString()}))
      .setMimeType(ContentService.MimeType.JSON);
  }
}

// Parse the two-column catalogue format from the PDF
function parseCatalogueText(text) {
  const products = [];
  const lines = text.split('\n').map(l => l.trim()).filter(l => l);

  // Heuristic: lines containing ' x ' are dosage lines, and they are followed by price
  for (let i = 0; i < lines.length; i++) {
    const line = lines[i];
    // Match pattern like "Retatrutide 5mg x 10 vials"
    const match = line.match(/^([A-Za-z0-9\-\s\+\(\)]+?)\s+(\d+(?:\.\d+)?\s*(?:mg|mcg|iu|ml|g)?)\s*x\s*(\d+)\s*(?:vials|tablets|pcs)/i);
    if (match) {
      const name = match[1].trim();
      const dosage = match[2] + ' x ' + match[3];
      // Next line should contain price (e.g., "$195")
      let price = '';
      if (i + 1 < lines.length) {
        const priceMatch = lines[i+1].match(/\$?(\d+(?:\.\d{2})?)/);
        if (priceMatch) price = priceMatch[1];
      }
      if (name && dosage) {
        const id = name.replace(/[^A-Z0-9]/gi, '').toUpperCase().slice(0,8) + '_' + Date.now();
        products.push({
          Entity_ID: id,
          Canonical_Name: name,
          Entity_Type: guessType(name),
          Dosage: dosage,
          Price: price,
          Source_URL: 'user_upload',
          Last_Verified: new Date().toISOString(),
          Status: 'pending_review'
        });
      }
    }
  }
  return products;
}

function guessType(name) {
  const n = name.toLowerCase();
  if (n.includes('hgh') || n.includes('igf') || n.includes('hcg')) return 'protein';
  if (n.includes('dianabol') || n.includes('anavar') || n.includes('winstrol')) return 'anabolic_agent';
  if (n.includes('clen') || n.includes('t3') || n.includes('t4')) return 'small_molecule';
  return 'peptide';
}

// ====================== MANUAL ADDITIONS ======================
function handleAddSource(data) {
  const sheet = SpreadsheetApp.openById(SHEET_ID).getSheetByName(SHEETS.sources);
  const headers = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0];
  const row = headers.map(h => data[h] || '');
  sheet.appendRow(row);
  return ContentService.createTextOutput(JSON.stringify({success: true}))
    .setMimeType(ContentService.MimeType.JSON);
}

function handleAddFacility(data) {
  const sheet = SpreadsheetApp.openById(SHEET_ID).getSheetByName(SHEETS.production_facilities);
  const headers = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0];
  const row = headers.map(h => data[h] || '');
  sheet.appendRow(row);
  return ContentService.createTextOutput(JSON.stringify({success: true}))
    .setMimeType(ContentService.MimeType.JSON);
}

