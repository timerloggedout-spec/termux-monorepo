getRealisticPrice(symbol) {
    const priceRanges = {
        'BTC': [30000, 60000], 'ETH': [2000, 4000], 'ADA': [0.3, 0.6],
        'SOL': [50, 200], 'MATIC': [0.5, 1.0], 'AVAX': [20, 50],
        'DOT': [5, 10], 'LINK': [10, 20], 
        // Planck-tier coins
        'PEPE': [0.000001, 0.00001], 'SHIB': [0.000005, 0.00003], 
        'BONK': [0.0000001, 0.000001], 'FLOKI': [0.00001, 0.00005],
        'BABYDOGE': [0.000000001, 0.00000001], 'AKITA': [0.0000001, 0.000001],
        'SAITAMA': [0.00000001, 0.0000001], 'KISHU': [0.000000001, 0.00000001],
        // Add more Planck-tier coins here
        'DOGE': [0.05, 0.15], // Dogecoin is relatively low but not Planck-tier
    };
    const range = priceRanges[symbol] || [0.000000001, 0.01]; // Default range for unknown coins
    return Math.random() * (range[1] - range[0]) + range[0];
}
