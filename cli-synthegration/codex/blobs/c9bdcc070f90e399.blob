# omni_client/omni.py
from omni_client.core.accounts import CustodialAccountStore, UserAccount
from omni_client.core.router import ExecutionRouter

class OmniClient:
    """ 
    Central orchestrator: 
    - Custodial multi-tenant account management 
    - Web3 / exchange routing 
    - Delegation to modular provider adapters 
    """ 

    def __init__(self) -> None: 
        self.accounts = CustodialAccountStore() 
        self.router = ExecutionRouter(self.accounts)

    # Account management API
    def register_user(self, user: UserAccount) -> None: 
        self.accounts.upsert_user(user)

    # High-level trading API
    async def spot_order( 
        self, 
        user_id: str, 
        venue: str, 
        symbol: str, 
        side: str, 
        type_: str, 
        amount: float, 
        price: float | None = None, 
    ) -> Dict[str, Any]:
        return await self.router.place_spot_order( 
            user_id=user_id, 
            venue=venue, 
            symbol=symbol, 
            side=side, 
            type_=type_, 
            amount=amount, 
            price=price, 
        )
