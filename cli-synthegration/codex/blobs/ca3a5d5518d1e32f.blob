    <main id="page-regulatory" class="page">
        <div class="container">
            <div class="reg-header">
                <h1>🌍 Worldwide Peptide &amp; Compound Regulations</h1>
                <p class="sub">Regulatory intelligence for 43 jurisdictions — FDA, EMA, WADA, ClinicalTrials.gov, PubMed</p>
            </div>

            <div class="search-wrap">
                <input type="text" id="searchInput" placeholder="Search compounds (e.g., BPC-157, Tesamorelin, Semaglutide)..." onkeyup="if(event.key==='Enter')performSearch()">
                <button onclick="performSearch()">🔍 Search</button>
            </div>

            <div class="filter-row">
                <select id="jurisFilter" onchange="performSearch()">
                    <option value="">🌎 All Jurisdictions</option>
                </select>
                <select id="catFilter" onchange="performSearch()">
                    <option value="">📂 All Categories</option>
                </select>
                <select id="wadaFilter" onchange="performSearch()">
                    <option value="">🔓 All WADA</option>
                    <option value="prohibited">⚠️ Prohibited</option>
                    <option value="permitted">✅ Permitted</option>
                </select>
                <select id="riskFilter" onchange="performSearch()">
                    <option value="0">⚡ All Risk Levels</option>
                    <option value="1">Low</option>
                    <option value="2">Moderate</option>
                    <option value="3">Elevated</option>
                    <option value="4">Critical</option>
                </select>
            </div>

            <div class="tab-nav-reg">
                <button class="active" onclick="switchRegTab('compounds',this)">🧪 Compounds</button>
                <button onclick="switchRegTab('trials',this)">📋 Trials</button>
                <button onclick="switchRegTab('jurisdictions',this)">🗺️ Jurisdictions</button>
            </div>

            <div class="results-box" id="resultsBox">
                <p style="text-align:center;color:#555;padding:30px;">Search for a compound to view regulatory status</p>
            </div>

            <div class="detail-panel" id="detailPanel">
                <h3 id="detailTitle"></h3>
                <div class="detail-grid" id="detailGrid"></div>
                <div style="margin-top:12px;display:flex;gap:8px;flex-wrap:wrap;">
                    <button class="btn-outline" onclick="document.getElementById('detailPanel').classList.remove('show')">✕ Close</button>
                </div>
            </div>

            <div id="worldMap"></div>
        </div>
    </main>

