<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>IAMGAINZ – Coaching, Peptides & Worldwide Regulations</title>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <style>
        :root {
            --bg: #080c14;
            --card-bg: #0d1526;
            --accent: #ff3c00;
            --accent2: #ff6b35;
            --text: #e2e8f0;
            --muted: #64748b;
            --border: #1e3a5f;
            --nav-h: 56px;
            --font-heading: 'Rajdhani', 'Impact', sans-serif;
            --font-mono: 'JetBrains Mono', monospace;
            --font-body: 'DM Sans', 'Inter', sans-serif;
        }
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: var(--font-body);
            background: var(--bg);
            color: var(--text);
            line-height: 1.6;
            min-height: 100vh;
        }
        ::-webkit-scrollbar {
            width: 5px;
        }
        ::-webkit-scrollbar-track {
            background: #0a0f1a;
        }
        ::-webkit-scrollbar-thumb {
            background: #2a4a6e;
            border-radius: 3px;
        }

        /* ── Navigation ── */
        .nav-bar {
            position: sticky;
            top: 0;
            z-index: 1000;
            background: rgba(8, 12, 20, 0.95);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 20px;
            height: var(--nav-h);
            gap: 10px;
            flex-wrap: wrap;
        }
        .nav-brand {
            font-family: var(--font-heading);
            font-size: 1.3rem;
            font-weight: 700;
            letter-spacing: 1px;
            background: linear-gradient(135deg, var(--accent2), var(--accent));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            text-transform: uppercase;
            white-space: nowrap;
        }
        .nav-links {
            display: flex;
            gap: 6px;
            flex-wrap: wrap;
            align-items: center;
        }
        .nav-btn {
            padding: 7px 16px;
            border-radius: 8px;
            color: var(--muted);
            text-decoration: none;
            font-weight: 600;
            font-size: .82rem;
            transition: all .2s;
            cursor: pointer;
            border: 1px solid transparent;
            background: none;
            font-family: var(--font-body);
            white-space: nowrap;
        }
        .nav-btn:hover {
            color: #fff;
            border-color: #334;
        }
        .nav-btn.active {
            color: #fff;
            background: var(--card-bg);
            border-color: #334;
        }
        .nav-btn.cta {
            background: var(--accent);
            color: #fff;
            border-color: var(--accent);
        }
        .nav-btn.cta:hover {
            background: #e03400;
        }

        /* ── Page System ── */
        .page {
            display: none;
        }
        .page.active {
            display: block;
        }
        .container {
            max-width: 1300px;
            margin: 0 auto;
            padding: 0 20px;
        }

        /* ── Main Page Styles ── */
        .logo-block {
            text-align: center;
            padding: 50px 0 10px;
        }
        .logo-main {
            font-family: var(--font-heading);
            font-size: clamp(2.5rem, 8vw, 5rem);
            font-weight: 800;
            letter-spacing: -1px;
            background: linear-gradient(135deg, var(--accent2), var(--accent));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            text-transform: uppercase;
            line-height: 1.1;
        }
        .logo-yt {
            font-size: 1rem;
            color: #aaa;
            margin-top: -2px;
        }
        .logo-yt a {
            color: var(--accent2);
            text-decoration: none;
            font-weight: 600;
        }
        .hero {
            text-align: center;
            padding: 20px 0 35px;
        }
        .hero h1 {
            font-family: var(--font-heading);
            font-size: clamp(1.8rem, 5vw, 2.5rem);
            font-weight: 700;
            margin-bottom: 8px;
            letter-spacing: .5px;
        }
        .hero .sub {
            font-size: 1.05rem;
            color: #aaa;
            max-width: 580px;
            margin: 0 auto 24px;
        }
        .btn-primary {
            display: inline-block;
            padding: 14px 34px;
            background: var(--accent);
            color: #fff;
            font-weight: 700;
            border-radius: 8px;
            text-decoration: none;
            transition: background .2s;
            font-size: 1rem;
            border: none;
            cursor: pointer;
            font-family: var(--font-body);
        }
        .btn-primary:hover {
            background: #e03400;
        }
        .btn-outline {
            display: inline-block;
            padding: 10px 22px;
            border: 1px solid var(--accent2);
            color: var(--accent2);
            border-radius: 8px;
            text-decoration: none;
            font-weight: 600;
            transition: all .2s;
            font-size: .9rem;
            background: transparent;
            cursor: pointer;
        }
        .btn-outline:hover {
            background: #ff3c0011;
        }

        .stats-row {
            display: flex;
            justify-content: center;
            gap: clamp(16px, 3vw, 40px);
            margin: 20px 0 45px;
            flex-wrap: wrap;
        }
        .stat-box {
            text-align: center;
            background: var(--card-bg);
            border-radius: 12px;
            padding: 18px 26px;
            min-width: 130px;
            border: 1px solid #1a2a3a;
        }
        .stat-num {
            font-family: var(--font-heading);
            font-size: 2.3rem;
            font-weight: 800;
            color: var(--accent2);
            line-height: 1.2;
        }
        .stat-label {
            font-size: .78rem;
            color: #aaa;
        }

        .section {
            padding: 50px 0;
        }
        .section h2 {
            font-family: var(--font-heading);
            font-size: 1.8rem;
            text-align: center;
            margin-bottom: 6px;
            letter-spacing: .5px;
        }
        .section .subtitle {
            text-align: center;
            color: #aaa;
            margin-bottom: 35px;
            font-size: .95rem;
        }
        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
            gap: 22px;
        }
        .card {
            background: var(--card-bg);
            border-radius: 14px;
            padding: 28px 22px;
            transition: transform .2s, border-color .2s;
            border: 1px solid #1a2a3a;
        }
        .card:hover {
            transform: translateY(-3px);
            border-color: var(--accent);
        }
        .card h3 {
            font-family: var(--font-heading);
            font-size: 1.25rem;
            margin-bottom: 8px;
            color: var(--accent2);
            letter-spacing: .3px;
        }
        .card p {
            color: #bbb;
            margin-bottom: 12px;
            font-size: .9rem;
        }
        .card .tag {
            display: inline-block;
            padding: 3px 10px;
            border-radius: 20px;
            font-size: .72rem;
            font-weight: 600;
            background: #1a2a1a;
            color: #4ade80;
            margin-bottom: 8px;
        }
        .card .price {
            font-weight: 700;
            color: #fff;
            font-size: 1.1rem;
        }

        .badge-row {
            display: flex;
            flex-wrap: wrap;
            gap: 7px;
            margin: 12px 0;
        }
        .badge-item {
            background: #1a2a3a;
            color: var(--accent2);
            padding: 5px 12px;
            border-radius: 20px;
            font-size: .75rem;
            font-weight: 600;
        }

        .testimonial {
            background: #0d1520;
            border-radius: 18px;
            text-align: center;
            padding: 40px 20px;
            max-width: 650px;
            margin: 0 auto;
            border: 1px solid #1a2a3a;
        }
        .testimonial blockquote {
            font-size: 1.2rem;
            font-style: italic;
            color: #d0d0d0;
            margin: 16px 0;
        }
        .testimonial cite {
            color: var(--accent2);
            font-weight: 600;
            font-style: normal;
        }

        .social-grid {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 10px;
            margin-top: 20px;
        }
        .social-link {
            background: var(--card-bg);
            border-radius: 8px;
            padding: 10px 18px;
            color: #fff;
            text-decoration: none;
            font-weight: 600;
            border: 1px solid #2a3a4a;
            transition: .2s;
            font-size: .85rem;
            display: flex;
            align-items: center;
            gap: 7px;
        }
        .social-link:hover {
            border-color: var(--accent);
            color: var(--accent2);
        }

        /* ── Regulatory Tool ── */
        .reg-header {
            text-align: center;
            padding: 25px 0 15px;
        }
        .reg-header h1 {
            font-family: var(--font-heading);
            font-size: 1.7rem;
            color: var(--accent2);
            letter-spacing: .5px;
        }
        .reg-header .sub {
            color: #aaa;
            font-size: .85rem;
        }
        .search-wrap {
            display: flex;
            gap: 8px;
            max-width: 550px;
            margin: 0 auto 16px;
        }
        .search-wrap input {
            flex: 1;
            padding: 10px 14px;
            border-radius: 8px;
            border: 1px solid #333;
            background: var(--card-bg);
            color: #fff;
            font-size: .9rem;
            outline: none;
            font-family: var(--font-body);
        }
        .search-wrap input:focus {
            border-color: var(--accent2);
        }
        .search-wrap button {
            padding: 10px 20px;
            border-radius: 8px;
            background: var(--accent);
            color: #fff;
            font-weight: 700;
            border: none;
            cursor: pointer;
            font-family: var(--font-body);
        }
        .filter-row {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            justify-content: center;
            margin-bottom: 14px;
        }
        .filter-row select {
            padding: 7px 12px;
            border-radius: 6px;
            border: 1px solid #333;
            background: var(--card-bg);
            color: #fff;
            font-size: .8rem;
            font-family: var(--font-body);
        }
        .tab-nav-reg {
            display: flex;
            gap: 2px;
            margin-bottom: 12px;
            border-bottom: 1px solid #1e2a3a;
            overflow-x: auto;
        }
        .tab-nav-reg button {
            padding: 8px 16px;
            background: none;
            border: none;
            color: #aaa;
            cursor: pointer;
            font-weight: 600;
            font-size: .8rem;
            white-space: nowrap;
            border-bottom: 2px solid transparent;
            transition: .2s;
            font-family: var(--font-body);
        }
        .tab-nav-reg button.active {
            color: #fff;
            border-bottom-color: var(--accent);
        }
        .results-box {
            background: var(--card-bg);
            border-radius: 10px;
            padding: 12px;
            min-height: 250px;
            max-height: 450px;
            overflow-y: auto;
            border: 1px solid #1a2a3a;
        }
        .result-item {
            padding: 10px 12px;
            border-bottom: 1px solid #1a2a3a;
            cursor: pointer;
            transition: background .15s;
            border-radius: 6px;
        }
        .result-item:hover {
            background: #111d2e;
        }
        .result-item:last-child {
            border-bottom: none;
        }
        .result-item h4 {
            color: var(--accent2);
            font-size: .95rem;
            font-family: var(--font-heading);
            letter-spacing: .3px;
        }
        .result-item .meta {
            color: #aaa;
            font-size: .78rem;
            margin-top: 2px;
        }
        .chip {
            display: inline-block;
            padding: 2px 7px;
            border-radius: 4px;
            font-size: .68rem;
            font-weight: 600;
            margin-right: 4px;
            font-family: var(--font-mono);
        }
        .detail-panel {
            background: var(--card-bg);
            border-radius: 10px;
            padding: 18px;
            margin-top: 12px;
            border: 1px solid #1a2a3a;
            display: none;
        }
        .detail-panel.show {
            display: block;
        }
        .detail-panel h3 {
            font-family: var(--font-heading);
            color: var(--accent2);
            margin-bottom: 10px;
            font-size: 1.2rem;
            letter-spacing: .3px;
        }
        .detail-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
            gap: 8px;
        }
        .field {
            padding: 8px 10px;
            background: #0a0f1a;
            border-radius: 6px;
            font-size: .8rem;
        }
        .field label {
            font-size: .65rem;
            text-transform: uppercase;
            color: #888;
            font-weight: 600;
            display: block;
            letter-spacing: .5px;
        }
        .field span {
            color: #d0d0d0;
            font-size: .82rem;
        }
        #worldMap {
            width: 100%;
            height: 380px;
            border-radius: 12px;
            margin-top: 16px;
            border: 1px solid #1a2a3a;
            z-index: 1;
        }
        .leaflet-container {
            background: #080c14 !important;
        }
        .map-legend {
            background: #0d1526;
            padding: 8px 12px;
            border-radius: 6px;
            font-size: .72rem;
            font-family: var(--font-mono);
            color: #ccc;
            border: 1px solid #1a2a3a;
            line-height: 1.6;
        }
        .map-legend i {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            display: inline-block;
            margin-right: 4px;
            vertical-align: middle;
        }

        footer {
            text-align: center;
            padding: 25px 0;
            color: #555;
            font-size: .78rem;
            border-top: 1px solid #111;
            margin-top: 30px;
        }
        footer a {
            color: var(--accent2);
            text-decoration: none;
        }

        @media(max-width:700px) {
            .nav-bar {
                padding: 8px 12px;
                height: auto;
                gap: 6px;
            }
            .nav-btn {
                font-size: .7rem;
                padding: 5px 10px;
            }
            .logo-main {
                font-size: 2.2rem;
            }
            .section h2 {
                font-size: 1.4rem;
            }
            #worldMap {
                height: 250px;
            }
        }
    </style>
</head>
