        const JURIS_KEYS = ["US", "EU", "CA", "AU", "UK", "JP", "RU"];

        // ═══════════ INIT FILTERS ═══════════
        function initFilters() {
            const jurSel = document.getElementById('jurisFilter');
            JURISDICTIONS.forEach(j => { const o = document.createElement('option');
                o.value = j.code;
                o.textContent = j.flag + ' ' + j.name;
                jurSel.appendChild(o); });
            const cats = [...new Set(COMPOUNDS.map(c => c.cat))].sort();
            const catSel = document.getElementById('catFilter');
            cats.forEach(c => { const o = document.createElement('option');
                o.value = c;
                o.textContent = c;
                catSel.appendChild(o); });
        }

        // ═══════════ REGULATORY TOOL ═══════════
        let regTab = 'compounds';

        function switchRegTab(tab, btn) {
            regTab = tab;
            document.querySelectorAll('.tab-nav-reg button').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            performSearch();
        }

        function performSearch() {
            const q = (document.getElementById('searchInput').value || '').toLowerCase();
            const jurF = document.getElementById('jurisFilter').value;
            const catF = document.getElementById('catFilter').value;
            const wadaF = document.getElementById('wadaFilter').value;
            const riskF = parseInt(document.getElementById('riskFilter').value) || 0;

            let results = COMPOUNDS.filter(c => {
                if (q && !c.name.toLowerCase().includes(q) && !c.syn.toLowerCase().includes(q) && !c.id
                    .toLowerCase().includes(q)) return false;
                if (catF && c.cat !== catF) return false;
                if (wadaF && c.wada !== wadaF) return false;
                if (riskF && c.risk !== riskF) return false;
                if (jurF && JURIS_KEYS.includes(jurF) && c[jurF] !== 'approved') return false;
                return true;
            });

            const box = document.getElementById('resultsBox');
            if (regTab === 'compounds') {
                if (results.length === 0) {
                    box.innerHTML =
                        '<p style="text-align:center;color:#555;padding:30px;">No compounds match. Try different filters.</p>';
                } else {
                    box.innerHTML = results.map(c => {
                        const wadaCol = c.wada === 'prohibited' ? '#ef4444' : c.wada === 'permitted' ?
                            '#22c55e' : '#94a3b8';
                        const riskCol = ['', '#22c55e', '#f59e0b', '#f97316', '#ef4444'][c.risk];
                        const riskLab = ['', 'LOW', 'MODERATE', 'ELEVATED', 'CRITICAL'][c.risk];
                        const jstatus = JURIS_KEYS.map(j => {
                            const s = c[j] || 'unknown';
                            const col = s === 'approved' ? '#22c55e' : s === 'investigational' ?
                                '#3b82f6' : s === 'withdrawn' ? '#f59e0b' : s === 'unapproved' ?
                                '#ef4444' : '#64748b';
                            return `<span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:${col};margin:0 1px;" title="${j}:${s}"></span>`;
                        }).join('');
                        return `<div class="result-item" onclick="showDetail('${c.id}')" style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;">
                  <div style="flex:1;min-width:180px;">
                    <h4>${c.name} <span class="chip" style="background:#1a2a3a;color:#aaa;">${c.cat}</span></h4>
                    <div class="meta">${c.mod} · Stage: ${c.stage.replace(/_/g,' ')} · ${c.syn.slice(0,60)}</div>
                  </div>
                  <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
                    <span class="chip" style="background:${wadaCol}22;color:${wadaCol};">WADA ${c.wada.toUpperCase()}</span>
                    <span class="chip" style="background:${riskCol}22;color:${riskCol};">${riskLab}</span>
                    <span style="font-size:.7rem;">${jstatus}</span>
                  </div>
                </div>`;
                    }).join('');
                }
            } else if (regTab === 'trials') {
                box.innerHTML =
                    '<p style="text-align:center;color:#555;padding:30px;">🔗 <a href="https://clinicaltrials.gov/" target="_blank" style="color:#ff6b35;">Search ClinicalTrials.gov</a> for active trials on filtered compounds.</p><p style="text-align:center;color:#555;">Key trials linked in compound detail view.</p>';
            } else if (regTab === 'jurisdictions') {
                box.innerHTML = '<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:8px;">' +
                    JURISDICTIONS.map(j => {
                        const approved = COMPOUNDS.filter(c => c[j.code] === 'approved').length;
                        const tierCol = j.tier === 1 ? '#f59e0b' : j.tier === 2 ? '#a78bfa' : '#3b82f6';
                        return `<div class="result-item" style="cursor:default;">
                    <strong>${j.flag} ${j.name}</strong> <span class="chip" style="background:${tierCol}22;color:${tierCol};">T${j.tier}</span>
                    <div class="meta">${j.body} · Approved: ${approved}</div>
                  </div>`;
                    }).join('') + '</div>';
            }
        }

        function showDetail(id) {
            const c = COMPOUNDS.find(x => x.id === id);
            if (!c) return;
            const panel = document.getElementById('detailPanel');
            document.getElementById('detailTitle').textContent = c.name + ' — Regulatory Profile';
            const wadaCol = c.wada === 'prohibited' ? '#ef4444' : c.wada === 'permitted' ? '#22c55e' : '#94a3b8';
            const riskCol = ['', '#22c55e', '#f59e0b', '#f97316', '#ef4444'][c.risk];
            document.getElementById('detailGrid').innerHTML = [
                { l: 'Synonyms', v: c.syn || '—' },
                { l: 'Category', v: c.cat },
                { l: 'Modality', v: c.mod },
                { l: 'Stage', v: c.stage.replace(/_/g, ' ') },
                { l: 'WADA', v: `<span style="color:${wadaCol};font-weight:700;">${c.wada.toUpperCase()}</span> — ${c.wadaCat}` },
                { l: 'Risk', v: `<span style="color:${riskCol};font-weight:700;">${['','LOW','MODERATE','ELEVATED','CRITICAL'][c.risk]}</span>` },
                ...JURIS_KEYS.map(j => ({ l: j, v: `<span style="color:${c[j]==='approved'?'#22c55e':c[j]==='investigational'?'#3b82f6':c[j]==='withdrawn'?'#f59e0b':c[j]==='unapproved'?'#ef4444':'#64748b'};">${c[j]}</span>` })),
                { l: 'Notes', v: c.note || '—' },
                { l: 'Source', v: `<a href="${c.src}" target="_blank" style="color:#ff6b35;">${c.src.slice(0,50)}...</a>` },
            ].map(f => `<div class="field"><label>${f.l}</label><span>${f.v}</span></div>`).join('');
            panel.classList.add('show');
            panel.scrollIntoView({ behavior: 'smooth' });
        }

        // ═══════════ LEAFLET MAP ═══════════
        function initMap() {
            const mapEl = document.getElementById('worldMap');
            if (!mapEl || mapEl.dataset.init) return;
            mapEl.dataset.init = '1';

            const map = L.map('worldMap', { zoomControl: true, scrollWheelZoom: true }).setView([25, 0], 2);
            window.map = map;

            L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
                attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OSM</a> &copy; <a href="https://carto.com/">CARTO</a>',
                subdomains: 'abcd',
                maxZoom: 19,
            }).addTo(map);

            const tierColors = { 1: '#f59e0b', 2: '#a78bfa', 3: '#3b82f6' };
            JURISDICTIONS.forEach(j => {
                const color = tierColors[j.tier] || '#64748b';
                const marker = L.circleMarker([j.lat, j.lng], {
                    radius: j.tier === 1 ? 8 : j.tier === 2 ? 6 : 4,
                    fillColor: color,
                    color: '#fff',
                    weight: 1,
                    fillOpacity: 0.8,
                }).addTo(map);
                marker.bindTooltip(`${j.flag} ${j.name} · ${j.body} · Tier ${j.tier}`, {
                    direction: 'top',
                    offset: [0, -8],
                });
            });

            const legend = L.control({ position: 'bottomright' });
            legend.onAdd = function() {
                const div = L.DomUtil.create('div', 'map-legend');
                div.innerHTML = `
              <strong>Jurisdiction Tiers</strong><br>
              <i style="background:#f59e0b;"></i> Tier 1 — ICH Founders<br>
              <i style="background:#a78bfa;"></i> Tier 2 — Major Markets<br>
              <i style="background:#3b82f6;"></i> Tier 3 — National Authorities
            `;
                return div;
            };
            legend.addTo(map);

            setTimeout(() => map.invalidateSize(), 400);
        }

        // ═══════════ INIT ═══════════
        document.addEventListener('DOMContentLoaded', () => {
            initFilters();
            performSearch();
            initMap();
            // Re-init map when switching to regulatory page
            const origSwitch = switchPage;
            switchPage = function(name) {
                origSwitch(name);
                if (name === 'regulatory') {
                    setTimeout(() => {
                        if (window.map) window.map.invalidateSize();
                        else initMap();
                    }, 300);
                }
            };
        });
    </script>
</body>
</html>
