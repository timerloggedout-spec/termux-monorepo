// Inside your slot machine lever pull:
async function onLeverPull() {
    if (!ArbitrageCasino.getReady()) {
        alert('Engine still loading...');
        return;
    }
    const result = await ArbitrageCasino.pullLever(['USDT', 'BTC', 'ETH'], 1000);
    if (result.win) {
        // Animate reels to show result.path symbols
        animateReels(result.path);
        // Update player balance
        updateBalance(result.bankroll);
        // Play win sound, confetti, etc.
    } else {
        // Show loss, no profitable path
    }
}
