            s.src = 'data:text/javascript;base64,' + btoa(document.getElementById('core-payload').textContent);
            document.head.appendChild(s);
        }
    </script>
</head>
<body>
    <canvas id="particleCanvas"></canvas>
    <!-- GUI structure is identical to original, only the core logic is obfuscated -->
    <div class="container">
        <!-- ... (exact same HTML body as original, not duplicated for brevity) ... -->
    </div>

    <!-- Hidden base64‑encoded original JS logic (compressed) -->
