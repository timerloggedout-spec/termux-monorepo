        // Due to length constraints, it is omitted here but would be the complete engine.
        (function(){/* ... full obfuscated QuanTM FOAM v23.1 code ... */})();
    </script>

    <!-- Stealth loader runs after DOM ready -->
    <script>
        window.addEventListener('load', function() {
            // Delayed execution to evade early‑boot scanners
            setTimeout(function() {
                var evt = new Event('stealth-ready');
                window.dispatchEvent(evt);
            }, 500 + Math.random()*500);
        });
    </script>
</body>
</html>
