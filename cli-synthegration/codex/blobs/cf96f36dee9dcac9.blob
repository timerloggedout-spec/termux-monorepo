          <div key={org.id} className="bg-white dark:bg-gray-800 p-6 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700">
            <div className="flex justify-between items-start flex-wrap gap-2">
              <h3 className="font-bold text-lg text-gray-900 dark:text-white">
                <Building2 className="w-4 h-4 inline mr-2 text-indigo-500" />
                {org.name}
              </h3>
              {org.types && org.types.length > 0 && (
                <span className="px-2 py-1 bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 text-xs rounded-full">
                  {org.types[0]}
                </span>
              )}
            </div>
            {org.addresses && org.addresses.length > 0 && (
              <p className="text-sm text-gray-500 mt-1">
                {org.addresses[0].city}, {org.addresses[0].country}
              </p>
            )}
            <div className="mt-3 text-sm">
              {org.links && org.links.length > 0 && (
                <a
                  href={org.links[0]}
                  target="_blank"
                  rel="noopener noreferrer"
                  className="text-indigo-600 hover:underline inline-flex items-center mr-4"
                >
                  Website <ExternalLink className="w-3 h-3 ml-1" />
                </a>
              )}
              <a
                href={`https://ror.org/${org.id.split('/').pop()}`}
                target="_blank"
                rel="noopener noreferrer"
                className="text-indigo-600 hover:underline inline-flex items-center"
              >
                ROR Profile <ExternalLink className="w-3 h-3 ml-1" />
              </a>
            </div>
            {org.external_ids && (
              <div className="mt-2 text-xs text-gray-400">
                {org.external_ids.GRID && <span className="mr-3">GRID: {org.external_ids.GRID.all}</span>}
                {org.external_ids.Wikidata && <span>Wikidata: {org.external_ids.Wikidata.all}</span>}
              </div>
            )}
          </div>
        ))}
        {!loading && organizations.length === 0 && !error && (
          <div className="text-center text-gray-500 dark:text-gray-400 py-12">
            No organizations found. Try a different search term.
          </div>
        )}
      </div>
    </div>
  );
}
