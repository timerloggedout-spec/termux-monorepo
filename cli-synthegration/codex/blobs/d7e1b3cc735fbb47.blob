<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>QuanTM FOAM | Quantum Arbitrage Interface</title>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #00f0ff; --secondary: #ff00ff; --accent: #00ffaa;
            --dark: #0a0a1a; --darker: #050510; --light: #a0a0ff;
            --glow: 0 0 10px currentColor, 0 0 20px currentColor;
        }
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Orbitron', monospace; }
        body { background: var(--dark); color: var(--light); min-height: 100vh; overflow-x: hidden; }
        .container { max-width: 1400px; margin: 0 auto; padding: 15px; }
        header { display: flex; justify-content: space-between; align-items: center; padding: 15px 0; border-bottom: 1px solid rgba(0, 240, 255, 0.3); margin-bottom: 20px; flex-wrap: wrap; }
        .logo { display: flex; align-items: center; gap: 10px; }
        .logo-icon { width: 35px; height: 35px; background: var(--primary); border-radius: 50%; box-shadow: var(--glow); }
        .logo-text { font-size: 24px; font-weight: 700; background: linear-gradient(90deg, var(--primary), var(--secondary)); -webkit-background-clip: text; background-clip: text; color: transparent; }
        .user-info { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
        .info-display { background: rgba(0, 0, 0, 0.5); padding: 6px 12px; border-radius: 15px; border: 1px solid; font-size: 14px; }
        .qbucks { border-color: var(--primary); box-shadow: 0 0 8px rgba(0, 240, 255, 0.3); }
        .level { border-color: var(--secondary); box-shadow: 0 0 8px rgba(255, 0, 255, 0.3); }
        .points { border-color: var(--accent); box-shadow: 0 0 8px rgba(0, 255, 170, 0.3); }
        .main-content { display: grid; grid-template-columns: 1fr 320px; gap: 20px; }
        .investment-interface, .tech-tree, .sweepstakes, .base-game, .arbitrage-game { 
            background: rgba(10, 10, 26, 0.7); border-radius: 12px; padding: 15px; 
            border: 1px solid; position: relative; overflow: hidden; margin-bottom: 15px;
        }
        .investment-interface { border-color: rgba(0, 240, 255, 0.2); }
        .tech-tree { border-color: rgba(0, 255, 170, 0.2); }
        .sweepstakes { border-color: rgba(255, 0, 255, 0.2); }
        .base-game { border-color: rgba(255, 170, 0, 0.2); }
        .arbitrage-game { border-color: rgba(255, 255, 0, 0.2); }
        .portal-section { text-align: center; margin-bottom: 20px; }
        .portal-button { background: linear-gradient(45deg, var(--primary), var(--secondary)); border: none; color: white; padding: 12px 24px; border-radius: 25px; font-size: 16px; cursor: pointer; transition: all 0.3s; box-shadow: 0 0 12px rgba(0, 240, 255, 0.5); margin: 15px 0; }
        .portal-button:hover { transform: scale(1.05); box-shadow: 0 0 20px rgba(0, 240, 255, 0.8); }
        .portal-button:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }
        .investment-options { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 15px; margin-top: 20px; }
        .investment-card { background: rgba(0, 0, 0, 0.5); border-radius: 8px; padding: 12px; border: 1px solid rgba(255, 0, 255, 0.3); transition: all 0.3s; cursor: pointer; position: relative; }
        .investment-card:hover { transform: translateY(-3px); box-shadow: 0 3px 10px rgba(255, 0, 255, 0.3); }
        .investment-card.locked { opacity: 0.5; cursor: not-allowed; }
        .investment-icon { width: 40px; height: 40px; background: rgba(0, 255, 170, 0.2); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-bottom: 8px; font-size: 20px; }
        .tech-node { background: rgba(0, 0, 0, 0.5); padding: 8px; border-radius: 6px; margin-bottom: 8px; border-left: 3px solid var(--accent); display: flex; justify-content: space-between; }
        .tech-node.locked { opacity: 0.5; }
        .boom-particle { position: fixed; width: 4px; height: 4px; border-radius: 50%; pointer-events: none; z-index: 1000; }
        .modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(5, 5, 16, 0.95); z-index: 2000; align-items: center; justify-content: center; }
        .modal-content { background: linear-gradient(135deg, var(--darker), var(--dark)); border-radius: 12px; padding: 20px; max-width: 450px; width: 90%; border: 1px solid var(--primary); box-shadow: var(--glow); }
        .close-modal { position: absolute; top: 12px; right: 12px; background: none; border: none; color: var(--light); font-size: 18px; cursor: pointer; }
        .login-form { display: flex; flex-direction: column; gap: 12px; }
        .form-group { display: flex; flex-direction: column; gap: 4px; }
        .form-group label { color: var(--primary); font-size: 14px; }
        .form-group input { background: rgba(0, 0, 0, 0.5); border: 1px solid var(--primary); border-radius: 4px; padding: 8px; color: white; }
        .submit-btn { background: linear-gradient(45deg, var(--primary), var(--secondary)); border: none; color: white; padding: 10px; border-radius: 4px; cursor: pointer; margin-top: 8px; font-weight: 700; }
        .generative-canvas { position: fixed; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: -1; }
        footer { text-align: center; padding: 15px 0; margin-top: 20px; border-top: 1px solid rgba(0, 240, 255, 0.3); font-size: 11px; color: rgba(160, 160, 255, 0.7); }
        .toggle-switch { position: relative; display: inline-block; width: 50px; height: 24px; margin-left: 10px; }
        .toggle-switch input { opacity: 0; width: 0; height: 0; }
        .slider { position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0; background-color: #ccc; transition: .4s; border-radius: 24px; }
        .slider:before { position: absolute; content: ""; height: 16px; width: 16px; left: 4px; bottom: 4px; background-color: white; transition: .4s; border-radius: 50%; }
        input:checked + .slider { background-color: var(--accent); }
        input:checked + .slider:before { transform: translateX(26px); }
        .game-option { background: rgba(0, 0, 0, 0.5); padding: 10px; border-radius: 8px; margin-bottom: 10px; text-align: center; cursor: pointer; border: 1px solid rgba(255, 170, 0, 0.3); }
        .game-option:hover { background: rgba(0, 0, 0, 0.7); }
        .sweepstakes-options { display: flex; justify-content: space-between; margin: 10px 0; }
        .sweepstakes-btn { background: rgba(0, 0, 0, 0.5); border: 1px solid var(--secondary); color: var(--light); padding: 8px 12px; border-radius: 6px; cursor: pointer; flex: 1; margin: 0 5px; font-size: 12px; }
        .sweepstakes-btn.active { background: var(--secondary); color: white; }
        .investment-controls { margin-top: 10px; display: flex; gap: 10px; }
        .investment-controls input { flex: 1; background: rgba(0, 0, 0, 0.5); border: 1px solid var(--primary); border-radius: 4px; padding: 5px; color: white; }
        
        /* Arbitrage Game Styles */
        .arbitrage-controls { display: flex; gap: 10px; margin-bottom: 15px; flex-wrap: wrap; }
        .arbitrage-controls select, .arbitrage-controls input { background: rgba(0, 0, 0, 0.5); border: 1px solid var(--primary); border-radius: 4px; padding: 8px; color: white; }
        .arbitrage-controls button { background: linear-gradient(45deg, var(--primary), var(--secondary)); border: none; color: white; padding: 8px 16px; border-radius: 4px; cursor: pointer; }
        .arbitrage-opportunities { max-height: 300px; overflow-y: auto; margin-top: 15px; }
        .opportunity-card { background: rgba(0, 0, 0, 0.5); border-radius: 6px; padding: 10px; margin-bottom: 8px; border-left: 4px solid var(--accent); }
        .opportunity-card.profitable { border-left-color: #00ff00; }
        .opportunity-card.loss { border-left-color: #ff0000; }
        .opportunity-header { display: flex; justify-content: space-between; margin-bottom: 5px; }
        .opportunity-profit { font-weight: bold; }
        .opportunity-path { font-size: 12px; color: var(--light); }
        .opportunity-details { font-size: 11px; color: rgba(160, 160, 255, 0.7); display: grid; grid-template-columns: 1fr 1fr; gap: 5px; }
        
        /* Grid Trading Styles */
        .grid-controls { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 15px; }
        .grid-controls input { background: rgba(0, 0, 0, 0.5); border: 1px solid var(--primary); border-radius: 4px; padding: 8px; color: white; }
        .grid-orders { max-height: 200px; overflow-y: auto; margin-top: 10px; }
        .grid-order { background: rgba(0, 0, 0, 0.5); border-radius: 4px; padding: 8px; margin-bottom: 5px; font-size: 12px; display: flex; justify-content: space-between; }
        .grid-order.buy { border-left: 3px solid #00ff00; }
        .grid-order.sell { border-left: 3px solid #ff0000; }
        
        /* Exchange Data Styles */
        .exchange-data { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 15px; }
        .exchange-card { background: rgba(0, 0, 0, 0.5); border-radius: 6px; padding: 10px; }
        .exchange-card h4 { margin-bottom: 8px; color: var(--primary); }
        .pair-list { max-height: 150px; overflow-y: auto; }
        .pair-item { display: flex; justify-content: space-between; padding: 4px 0; font-size: 12px; border-bottom: 1px solid rgba(255, 255, 255, 0.1); }
        
        /* Status indicators */
        .status-indicator { display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 5px; }
        .status-active { background: #00ff00; }
        .status-inactive { background: #ff0000; }
        .status-waiting { background: #ffff00; }
        
        @media (max-width: 768px) { 
            .main-content { grid-template-columns: 1fr; } 
            .investment-options { grid-template-columns: 1fr; } 
            header { flex-direction: column; gap: 10px; }
            .user-info { justify-content: center; }
            .arbitrage-controls, .grid-controls { grid-template-columns: 1fr; }
            .exchange-data { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>
    <canvas class="generative-canvas" id="backgroundCanvas"></canvas>
    
    <div class="container">
        <header>
            <div class="logo">
                <div class="logo-icon"></div>
                <div class="logo-text">QuanTM FOAM</div>
            </div>
            <div class="user-info">
                <div class="info-display qbucks" id="qbucksDisplay">Q-Bucks: 1,250</div>
                <div class="info-display level" id="levelDisplay">Level 1</div>
                <div class="info-display points" id="pointsDisplay">Points: 0/100</div>
                <div style="display: flex; align-items: center;">
                    <span style="font-size: 12px;">Live Data</span>
                    <label class="toggle-switch">
                        <input type="checkbox" id="liveDataToggle" checked>
                        <span class="slider"></span>
                    </label>
                </div>
                <button id="loginBtn" class="portal-button" style="padding: 6px 12px; font-size: 12px;">Login</button>
            </div>
        </header>
        
        <div class="main-content">
            <div class="investment-interface">
                <div class="portal-section">
                    <h2>Quantum Arbitrage Portal</h2>
                    <p>Activate quantum field to discover intra-exchange arbitrage paths</p>
                    <button class="portal-button" id="portalJump">Initiate Arbitrage Scan</button>
                    <div id="portalStatus">Arbitrage Scanner: <span class="status-indicator status-inactive"></span>Inactive</div>
                </div>
                
                <h3>Arbitrage Modules</h3>
                <div class="investment-options" id="investmentOptions">
                    <!-- Investment cards will be generated by JavaScript -->
                </div>
                
                <!-- Arbitrage Game Section -->
                <div class="arbitrage-game">
                    <h3>Quantum Arbitrage Pathfinder</h3>
                    <p>Discover triangular arbitrage opportunities with adaptive batching</p>
                    
                    <div class="arbitrage-controls">
                        <select id="exchangeSelect">
                            <option value="yobit">YoBit Exchange</option>
                            <option value="binance">Binance</option>
                            <option value="kraken">Kraken</option>
                        </select>
                        <select id="methodSelect">
                            <option value="triangular">Triangular Arbitrage</option>
                            <option value="bellman-ford">Bellman-Ford Algorithm</option>
                        </select>
                        <input type="number" id="investmentAmount" placeholder="Investment Amount" value="100" min="1">
                        <input type="number" id="batchSize" placeholder="Batch Size" value="40" min="10" max="100">
                        <button class="portal-button" id="scanArbitrage" style="padding: 8px 16px;">Scan Opportunities</button>
                    </div>
                    
                    <div class="arbitrage-controls">
                        <div style="display: flex; align-items: center; gap: 10px;">
                            <span class="status-indicator" id="scanStatus"></span>
                            <span id="scanInfo">Ready to scan</span>
                        </div>
                        <div id="batchInfo">Batch: 0/0 | Pairs: 0</div>
                    </div>
                    
                    <div class="arbitrage-opportunities" id="arbitrageOpportunities">
                        <!-- Arbitrage opportunities will be populated here -->
                    </div>
                </div>
                
                <!-- Grid Trading Section -->
                <div class="arbitrage-game">
                    <h3>Quantum Grid Trading Matrix</h3>
                    <p>Automated grid trading with dynamic basket management</p>
                    
                    <div class="grid-controls">
                        <input type="text" id="gridPair" placeholder="Trading Pair (e.g., BTC/USD)" value="BTC/USDT">
                        <input type="number" id="gridBudget" placeholder="Budget" value="1000" min="10">
                        <input type="number" id="gridBaskets" placeholder="Number of Baskets" value="5" min="1" max="20">
                        <input type="number" id="gridOrdersPerBasket" placeholder="Orders per Basket" value="5" min="1" max="10">
                        <button class="portal-button" id="startGridTrading" style="padding: 8px 16px; grid-column: 1 / -1;">Activate Grid Trading</button>
                    </div>
                    
                    <div class="grid-orders" id="gridOrders">
                        <!-- Grid orders will be populated here -->
                    </div>
                </div>
            </div>
            
            <div class="sidebar">
                <div class="base-game">
                    <h3>Trading Games</h3>
                    <div id="baseGames">
                        <!-- Base games will be generated by JavaScript -->
                    </div>
                </div>
                
                <div class="tech-tree">
                    <h3>Arbitrage Tech Tree</h3>
                    <div id="techTreeNodes">
                        <!-- Tech nodes will be generated by JavaScript -->
                    </div>
                </div>
                
                <div class="sweepstakes">
                    <h3>Quantum Energy Generator</h3>
                    <p>Generate quantum energy for bonus arbitrage scans</p>
                    <div class="sweepstakes-options">
                        <button class="sweepstakes-btn active" data-time="1">1 min</button>
                        <button class="sweepstakes-btn" data-time="5">5 min</button>
                        <button class="sweepstakes-btn" data-time="15">15 min</button>
                    </div>
                    <button class="portal-button" id="generateBoom" style="font-size: 12px; padding: 8px 16px; width: 100%;">Generate Quantum Energy</button>
                    <div id="boomCounter">Quantum Energy: 3</div>
                    <div id="sweepstakesInfo">Next scan boost: <span id="sweepstakesTimer">1:00</span></div>
                </div>

                <div class="sweepstakes">
                    <h3>Market Data</h3>
                    <div class="exchange-data">
                        <div class="exchange-card">
                            <h4>YoBit Markets</h4>
                            <div class="pair-list" id="yobitPairs">
                                <!-- YoBit pairs will be populated here -->
                            </div>
                        </div>
                        <div class="exchange-card">
                            <h4>Arbitrage Stats</h4>
                            <div id="arbitrageStats">
                                <div>Opportunities Found: <span id="oppCount">0</span></div>
                                <div>Best Profit: <span id="bestProfit">0%</span></div>
                                <div>Active Baskets: <span id="activeBaskets">0</span></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <footer>
            <p>QuanTM FOAM v2.1 | Quantum Arbitrage Interface | For simulation purposes only</p>
        </footer>
    </div>
    
    <div class="modal" id="loginModal">
        <div class="modal-content">
            <button class="close-modal" id="closeLogin">&times;</button>
            <h2>Quantum Authentication</h2>
            <form class="login-form" id="loginForm">
                <div class="form-group">
                    <label for="username">Quantum ID</label>
                    <input type="text" id="username" placeholder="Enter your Quantum ID">
                </div>
                <div class="form-group">
                    <label for="password">Entanglement Key</label>
                    <input type="password" id="password" placeholder="Enter your Entanglement Key">
                </div>
                <button type="submit" class="submit-btn">Authenticate</button>
            </form>
        </div>
    </div>

    <div class="modal" id="messageModal">
        <div class="modal-content">
            <button class="close-modal" id="closeMessage">&times;</button>
            <h2 id="messageTitle">Quantum Message</h2>
            <p id="messageText"></p>
        </div>
    </div>

    <script>
        // ========== CONFIGURATION ==========
        const CONFIG = {
            INITIAL_Q_BUCKS: 1250,
            INITIAL_LEVEL: 1,
            INITIAL_POINTS: 0,
            POINTS_PER_LEVEL: 100,
            QUANTUM_ENERGY: 3,
            QUANTUM_RECHARGE_TIME: 60000,
            LEVEL_UP_INTERVAL: 30000,
            ARBITRAGE_UPDATE_INTERVAL: 15000,
            MIN_PROFIT_PERCENT: 0.5,
            TRADING_FEE: 0.002,
            BATCH_SIZE_INIT: 40,
            BATCH_SIZE_MIN: 10,
            BATCH_SIZE_MAX: 100
        };

        // Enhanced base currencies with more trading pairs
        const BASE_CURRENCIES = [
            'btc', 'eth', 'ltc', 'doge', 'xrp', 'ada', 'sol', 'link', 'dot', 'matic',
            'avax', 'shib', 'uni', 'aave', 'comp', 'snx', 'yfi', 'crv', 'sushi', '1inch',
            'mkr', 'zrx', 'bat', 'zec', 'xlm', 'atom', 'algo', 'fil', 'near', 'ftm',
            'hbar', 'egld', 'flow', 'rune', 'sand', 'mana', 'enj', 'gala', 'axs', 'slp'
        ];

        const AVOID_CURRENCIES = ['usd', 'cad', 'eur', 'bnb', 'usdt', 'usdc', 'yovi', 'busd'];

        const MODULES = {
            micro: { name: 'Micro Arbitrage', icon: 'μ', level: 1, cost: 50, risk: 0.3, reward: 0.15, uses: 0, maxUses: 5 },
            nano: { name: 'Nano Pathfinder', icon: 'η', level: 3, cost: 100, risk: 0.5, reward: 0.25, uses: 0, maxUses: 10 },
            triangular: { name: 'Triangular Scanner', icon: 'Δ', level: 5, cost: 200, risk: 0.4, reward: 0.35, uses: 0, maxUses: 15 },
            bellman: { name: 'Bellman-Ford Engine', icon: 'β', level: 7, cost: 500, risk: 0.6, reward: 0.5, uses: 0, maxUses: 8 },
            grid: { name: 'Quantum Grid', icon: '#', level: 4, cost: 150, risk: 0.7, reward: 0.4, uses: 0, maxUses: 20 }
        };

        const BASE_GAMES = {
            dice: { name: 'Quantum Dice', icon: '🎲', cost: 10, reward: 20, risk: 0.4 },
            arbitrage: { name: 'Arbitrage Paths', icon: '🔄', cost: 75, reward: 150, risk: 0.3 },
            grid: { name: 'Grid Simulator', icon: '📊', cost: 50, reward: 100, risk: 0.5 }
        };

        const TECH_TREE = [
            { name: 'Basic Arbitrage', level: 1, unlocked: true },
            { name: 'Risk Assessment', level: 2, unlocked: false },
            { name: 'Triangular Detection', level: 3, unlocked: false },
            { name: 'Grid Trading', level: 4, unlocked: false },
            { name: 'Bellman-Ford Algorithm', level: 5, unlocked: false },
            { name: 'Adaptive Batching', level: 6, unlocked: false },
            { name: 'Quantum Optimization', level: 8, unlocked: false }
        ];

        // ========== STATE MANAGEMENT ==========
        const StateManager = {
            user: null,
            arbitrageEngine: null,
            gridEngine: null,
            
            init() {
                const savedUser = this.loadFromStorage('user');
                if (!savedUser) {
                    this.user = {
                        username: null,
                        level: CONFIG.INITIAL_LEVEL,
                        points: CONFIG.INITIAL_POINTS,
                        qBucks: CONFIG.INITIAL_Q_BUCKS,
                        quantumEnergy: CONFIG.QUANTUM_ENERGY,
                        unlockedModules: ['micro'],
                        portfolio: {},
                        toolUses: {},
                        arbitrageStats: {
                            opportunitiesFound: 0,
                            bestProfit: 0,
                            totalProfit: 0,
                            scansCompleted: 0
                        },
                        gridBaskets: [],
                        lastSweepstakes: Date.now(),
                        sweepstakesTime: 1
                    };
                } else {
                    this.user = savedUser;
                }
                
                // Initialize engines
                this.arbitrageEngine = new ArbitrageEngine();
                this.gridEngine = new GridTradingEngine();
                
                this.saveToStorage('user', this.user);
            },
            
            loadFromStorage(key) {
                try {
                    return JSON.parse(localStorage.getItem(`quanTM_${key}`) || 'null');
                } catch (e) {
                    return null;
                }
            },
            
            saveToStorage(key, value) {
                try {
                    localStorage.setItem(`quanTM_${key}`, JSON.stringify(value));
                } catch (e) {
                    console.error('Failed to save to storage:', e);
                }
            },
            
            updateUser(updates) {
                this.user = { ...this.user, ...updates };
                this.saveToStorage('user', this.user);
                return this.user;
            },
            
            updateArbitrageStats(newOpportunities) {
                if (newOpportunities.length > 0) {
                    const bestProfit = Math.max(...newOpportunities.map(opp => opp.profitPercent));
                    this.user.arbitrageStats.opportunitiesFound += newOpportunities.length;
                    this.user.arbitrageStats.bestProfit = Math.max(this.user.arbitrageStats.bestProfit, bestProfit);
                    this.user.arbitrageStats.scansCompleted++;
                    this.saveToStorage('user', this.user);
                }
            }
        };

        // ========== ARBITRAGE ENGINE ==========
        class ArbitrageEngine {
            constructor() {
                this.isScanning = false;
                this.currentBatch = 0;
                this.totalBatches = 0;
                this.opportunities = [];
                this.exchangeData = {};
                this.batchSize = CONFIG.BATCH_SIZE_INIT;
            }

            // Generate trading pairs for adaptive batching
            generateTradingPairs(baseCurrencies, avoidCurrencies, batchSize) {
                const pairs = [];
                const filteredCurrencies = baseCurrencies.filter(c => 
                    !avoidCurrencies.includes(c.toLowerCase())
                );
                
                // Generate pairs for triangular arbitrage
                for (let i = 0; i < filteredCurrencies.length; i++) {
                    for (let j = i + 1; j < filteredCurrencies.length; j++) {
                        const pair1 = `${filteredCurrencies[i]}_${filteredCurrencies[j]}`;
                        const pair2 = `${filteredCurrencies[j]}_${filteredCurrencies[i]}`;
                        pairs.push(pair1, pair2);
                    }
                }
                
                // Split into batches for adaptive processing
                const batches = [];
                for (let i = 0; i < pairs.length; i += batchSize) {
                    batches.push(pairs.slice(i, i + batchSize));
                }
                
                return batches;
            }

            // Find triangular arbitrage opportunities with adaptive batching
            async findTriangularArbitrage(investmentAmount = 100) {
                if (this.isScanning) return [];
                
                this.isScanning = true;
                this.opportunities = [];
                
                const batches = this.generateTradingPairs(BASE_CURRENCIES, AVOID_CURRENCIES, this.batchSize);
                this.totalBatches = batches.length;
                
                UIComponents.updateScanStatus('scanning', `Processing batch 1/${this.totalBatches}`);
                
                for (let batchIndex = 0; batchIndex < batches.length; batchIndex++) {
                    this.currentBatch = batchIndex + 1;
                    const batch = batches[batchIndex];
                    
                    UIComponents.updateScanStatus('scanning', `Processing batch ${this.currentBatch}/${this.totalBatches}`);
                    UIComponents.updateBatchInfo(this.currentBatch, this.totalBatches, batch.length);
                    
                    // Simulate batch processing with delay
                    await new Promise(resolve => setTimeout(resolve, 100));
                    
                    const batchOpportunities = this.processBatch(batch, investmentAmount);
                    this.opportunities.push(...batchOpportunities);
                    
                    // Check inter-batch paths (connect last pair of previous batch with first of current)
                    if (batchIndex > 0) {
                        const interBatchOpportunities = this.checkInterBatchPaths(
                            batches[batchIndex - 1], batch, investmentAmount
                        );
                        this.opportunities.push(...interBatchOpportunities);
                    }
                }
                
                this.isScanning = false;
                UIComponents.updateScanStatus('complete', `Scan complete. Found ${this.opportunities.length} opportunities`);
                
                // Update adaptive batch size based on results
                this.adaptBatchSize(this.opportunities.length);
                
                return this.opportunities.sort((a, b) => b.profitPercent - a.profitPercent);
            }

            processBatch(batch, investmentAmount) {
                const opportunities = [];
                
                // Simulate market data for the batch
                const batchMarketData = this.generateMarketData(batch);
                
                // Look for triangular arbitrage within the batch
                for (let i = 0; i < batch.length; i++) {
                    for (let j = i + 1; j < batch.length; j++) {
                        for (let k = j + 1; k < batch.length; k++) {
                            const triangle = this.checkTriangle(
                                [batch[i], batch[j], batch[k]], 
                                batchMarketData, 
                                investmentAmount
                            );
                            if (triangle) opportunities.push(triangle);
                        }
                    }
                }
                
                return opportunities;
            }

            checkInterBatchPaths(prevBatch, currentBatch, investmentAmount) {
                const opportunities = [];
                const marketData = { ...this.generateMarketData(prevBatch), ...this.generateMarketData(currentBatch) };
                
                // Check paths that connect the last pair of previous batch with first of current
                if (prevBatch.length > 0 && currentBatch.length > 0) {
                    const lastPrev = prevBatch[prevBatch.length - 1];
                    const firstCurrent = currentBatch[0];
                    
                    // Find connecting pairs to form triangles
                    for (const pair of [...prevBatch, ...currentBatch]) {
                        if (pair !== lastPrev && pair !== firstCurrent) {
                            const triangle = this.checkTriangle(
                                [lastPrev, firstCurrent, pair],
                                marketData,
                                investmentAmount
                            );
                            if (triangle) opportunities.push(triangle);
                        }
                    }
                }
                
                return opportunities;
            }

            checkTriangle(pairs, marketData, investmentAmount) {
                const [pair1, pair2, pair3] = pairs;
                
                // Extract currencies from pairs
                const [a, b] = pair1.split('_');
                const [c, d] = pair2.split('_');
                const [e, f] = pair3.split('_');
                
                // Check if we have a valid triangle (A->B->C->A)
                const currencies = new Set([a, b, c, d, e, f]);
                if (currencies.size !== 3) return null;
                
                const currencyList = Array.from(currencies);
                const path = this.findTrianglePath(currencyList, pairs, marketData);
                
                if (!path) return null;
                
                const profit = this.calculatePathProfit(path, marketData, investmentAmount);
                if (profit.profitPercent >= CONFIG.MIN_PROFIT_PERCENT) {
                    return profit;
                }
                
                return null;
            }

            findTrianglePath(currencies, pairs, marketData) {
                // Try different path combinations
                const [a, b, c] = currencies;
                const paths = [
                    [a, b, c, a],
                    [a, c, b, a],
                    [b, a, c, b],
                    [b, c, a, b],
                    [c, a, b, c],
                    [c, b, a, c]
                ];
                
                for (const path of paths) {
                    const pairsNeeded = [];
                    for (let i = 0; i < path.length - 1; i++) {
                        const pair = `${path[i]}_${path[i+1]}`;
                        if (!pairs.includes(pair) || !marketData[pair]) {
                            break;
                        }
                        pairsNeeded.push(pair);
                    }
                    
                    if (pairsNeeded.length === 3) {
                        return { path: path, pairs: pairsNeeded };
                    }
                }
                
                return null;
            }

            calculatePathProfit(pathData, marketData, investmentAmount) {
                const { path, pairs } = pathData;
                let amount = investmentAmount;
                
                for (let i = 0; i < pairs.length; i++) {
                    const pair = pairs[i];
                    const market = marketData[pair];
                    const rate = market.price;
                    const fee = market.fee || CONFIG.TRADING_FEE;
                    
                    amount = amount * rate * (1 - fee);
                }
                
                const profit = amount - investmentAmount;
                const profitPercent = (profit / investmentAmount) * 100;
                
                return {
                    path: path.join(' → '),
                    pairs: pairs,
                    profit: profit,
                    profitPercent: profitPercent,
                    amountIn: investmentAmount,
                    amountOut: amount,
                    exchange: 'YoBit'
                };
            }

            generateMarketData(pairs) {
                const marketData = {};
                
                for (const pair of pairs) {
                    // Generate realistic-looking market data
                    const basePrice = Math.random() * 100 + 0.1;
                    const spread = basePrice * 0.002; // 0.2% spread
                    
                    marketData[pair] = {
                        bid: basePrice - spread/2,
                        ask: basePrice + spread/2,
                        price: basePrice,
                        fee: CONFIG.TRADING_FEE,
                        volume: Math.random() * 1000000
                    };
                }
                
                return marketData;
            }

            adaptBatchSize(opportunitiesFound) {
                // Adaptive batching based on performance
                if (opportunitiesFound < 2) {
                    this.batchSize = Math.min(CONFIG.BATCH_SIZE_MAX, this.batchSize + 10);
                } else if (opportunitiesFound > 10) {
                    this.batchSize = Math.max(CONFIG.BATCH_SIZE_MIN, this.batchSize - 5);
                }
            }
        }

        // ========== GRID TRADING ENGINE ==========
        class GridTradingEngine {
            constructor() {
                this.activeBaskets = [];
            }

            setupGridTrading(pair, budget, numBaskets, ordersPerBasket) {
                const baskets = [];
                const currentPrice = this.getCurrentPrice(pair);
                const amountPerBasket = budget / numBaskets;
                const amountPerOrder = amountPerBasket / ordersPerBasket;
                const spread = currentPrice * 0.02; // 2% total grid range
                
                for (let i = 0; i < numBaskets; i++) {
                    const basketPrice = currentPrice - (spread / 2) + (i * spread / numBaskets);
                    const basket = {
                        id: i,
                        pair: pair,
                        centerPrice: basketPrice,
                        orders: []
                    };
                    
                    for (let j = 0; j < ordersPerBasket; j++) {
                        const buyPrice = basketPrice * (1 - 0.005 * (j + 1));
                        const sellPrice = basketPrice * (1 + 0.005 * (j + 1));
                        
                        basket.orders.push(
                            {
                                type: 'buy',
                                price: buyPrice,
                                amount: amountPerOrder,
                                status: 'open'
                            },
                            {
                                type: 'sell', 
                                price: sellPrice,
                                amount: amountPerOrder,
                                status: 'open'
                            }
                        );
                    }
                    
                    baskets.push(basket);
                }
                
                this.activeBaskets = baskets;
                return baskets;
            }

            getCurrentPrice(pair) {
                // Simulate current price based on pair
                const priceMap = {
                    'BTC/USDT': 45000,
                    'ETH/USDT': 3000,
                    'LTC/USDT': 70,
                    'ADA/USDT': 0.5,
                    'DOT/USDT': 7
                };
                
                return priceMap[pair] || 100;
            }

            updateGridOrders() {
                // Simulate price movement and order execution
                for (const basket of this.activeBaskets) {
                    const currentPrice = this.getCurrentPrice(basket.pair) * (1 + (Math.random() - 0.5) * 0.01);
                    
                    for (const order of basket.orders) {
                        if (order.status === 'open') {
                            if (order.type === 'buy' && currentPrice <= order.price) {
                                order.status = 'filled';
                            } else if (order.type === 'sell' && currentPrice >= order.price) {
                                order.status = 'filled';
                            }
                        }
                    }
                }
                
                return this.activeBaskets;
            }
        }

        // ========== UI COMPONENTS ==========
        const UIComponents = {
            modals: {
                login: document.getElementById('loginModal'),
                message: document.getElementById('messageModal')
            },
            
            initModals() {
                // Login modal
                document.getElementById('loginBtn').addEventListener('click', () => {
                    this.modals.login.style.display = 'flex';
                });
                
                document.getElementById('closeLogin').addEventListener('click', () => {
                    this.modals.login.style.display = 'none';
                });
                
                document.getElementById('loginForm').addEventListener('submit', (e) => {
                    e.preventDefault();
                    const username = document.getElementById('username').value;
                    if (username) {
                        StateManager.updateUser({ username });
                        document.getElementById('loginBtn').textContent = username;
                        this.modals.login.style.display = 'none';
                        this.showMessage('Quantum Authentication', `Welcome, ${username}! Quantum arbitrage systems activated.`);
                    }
                });
                
                // Message modal
                document.getElementById('closeMessage').addEventListener('click', () => {
                    this.modals.message.style.display = 'none';
                });
                
                window.addEventListener('click', (e) => {
                    if (e.target === this.modals.login) this.modals.login.style.display = 'none';
                    if (e.target === this.modals.message) this.modals.message.style.display = 'none';
                });
            },
            
            showMessage(title, text) {
                document.getElementById('messageTitle').textContent = title;
                document.getElementById('messageText').textContent = text;
                this.modals.message.style.display = 'flex';
            },
            
            generateInvestmentCards() {
                const container = document.getElementById('investmentOptions');
                container.innerHTML = '';
                
                Object.entries(MODULES).forEach(([key, module]) => {
                    const unlocked = StateManager.user.unlockedModules.includes(key);
                    const usesLeft = module.maxUses - (StateManager.user.toolUses[key] || 0);
                    const canUse = unlocked && usesLeft > 0 && StateManager.user.level >= module.level;
                    
                    const card = document.createElement('div');
                    card.className = `investment-card ${unlocked && canUse ? '' : 'locked'}`;
                    card.innerHTML = `
                        <div class="investment-icon">${module.icon}</div>
                        <h4>${module.name}</h4>
                        <p>Level ${module.level} | Uses: ${usesLeft}/${module.maxUses}</p>
                        <p>Cost: ${module.cost} Q-Bucks</p>
                        ${unlocked && canUse ? `
                            <button class="portal-button" style="padding: 5px 10px; font-size: 12px; width: 100%; margin-top: 8px;" 
                                    onclick="GameLogic.activateInvestmentModule('${key}')">
                                Activate Module
                            </button>
                        ` : ''}
                    `;
                    container.appendChild(card);
                });
            },
            
            generateBaseGames() {
                const container = document.getElementById('baseGames');
                container.innerHTML = '';
                
                Object.entries(BASE_GAMES).forEach(([key, game]) => {
                    const gameEl = document.createElement('div');
                    gameEl.className = 'game-option';
                    gameEl.innerHTML = `
                        <div style="display: flex; align-items: center; justify-content: space-between;">
                            <span>${game.icon} ${game.name}</span>
                            <span>${game.cost} Q-Bucks</span>
                        </div>
                    `;
                    gameEl.addEventListener('click', () => GameLogic.playBaseGame(key));
                    container.appendChild(gameEl);
                });
            },
            
            generateTechTreeNodes() {
                const container = document.getElementById('techTreeNodes');
                container.innerHTML = '';
                
                TECH_TREE.forEach(node => {
                    const unlocked = node.unlocked || StateManager.user.level >= node.level;
                    const nodeEl = document.createElement('div');
                    nodeEl.className = `tech-node ${unlocked ? '' : 'locked'}`;
                    nodeEl.innerHTML = `
                        <span>${node.name}</span>
                        <span>${unlocked ? '✓' : `Lvl ${node.level}`}</span>
                    `;
                    container.appendChild(nodeEl);
                });
            },
            
            updateArbitrageOpportunities(opportunities) {
                const container = document.getElementById('arbitrageOpportunities');
                container.innerHTML = '';
                
                if (opportunities.length === 0) {
                    container.innerHTML = '<div class="opportunity-card">No arbitrage opportunities found. Try adjusting parameters or wait for market conditions to change.</div>';
                    return;
                }
                
                opportunities.slice(0, 8).forEach(opp => {
                    const oppCard = document.createElement('div');
                    oppCard.className = `opportunity-card ${opp.profitPercent > 0 ? 'profitable' : 'loss'}`;
                    oppCard.innerHTML = `
                        <div class="opportunity-header">
                            <span>${opp.path}</span>
                            <span class="opportunity-profit" style="color: ${opp.profitPercent > 0 ? '#00ff00' : '#ff0000'}">
                                ${opp.profitPercent > 0 ? '+' : ''}${opp.profitPercent.toFixed(2)}%
                            </span>
                        </div>
                        <div class="opportunity-path">${opp.exchange} | ${opp.pairs.join(' → ')}</div>
                        <div class="opportunity-details">
                            <span>Investment: $${opp.amountIn.toFixed(2)}</span>
                            <span>Return: $${opp.amountOut.toFixed(2)}</span>
                            <span>Profit: $${opp.profit.toFixed(2)}</span>
                            <span>Fee: ${(CONFIG.TRADING_FEE * 100).toFixed(2)}%</span>
                        </div>
                    `;
                    container.appendChild(oppCard);
                });
            },
            
            updateGridOrders(baskets) {
                const container = document.getElementById('gridOrders');
                container.innerHTML = '';
                
                let totalOrders = 0;
                let openOrders = 0;
                
                baskets.forEach(basket => {
                    basket.orders.forEach(order => {
                        totalOrders++;
                        if (order.status === 'open') openOrders++;
                        
                        const orderEl = document.createElement('div');
                        orderEl.className = `grid-order ${order.type}`;
                        orderEl.innerHTML = `
                            <span>${order.type.toUpperCase()} ${basket.pair}</span>
                            <span>$${order.price.toFixed(2)}</span>
                            <span>${order.amount.toFixed(4)}</span>
                            <span style="color: ${order.status === 'filled' ? '#00ff00' : '#ffff00'}">${order.status}</span>
                        `;
                        container.appendChild(orderEl);
                    });
                });
                
                if (totalOrders === 0) {
                    container.innerHTML = '<div class="grid-order">No active grid orders. Start grid trading to see orders here.</div>';
                }
            },
            
            updateScanStatus(status, message) {
                const statusEl = document.getElementById('scanStatus');
                const infoEl = document.getElementById('scanInfo');
                
                statusEl.className = 'status-indicator';
                infoEl.textContent = message;
                
                switch(status) {
                    case 'scanning':
                        statusEl.classList.add('status-waiting');
                        break;
                    case 'complete':
                        statusEl.classList.add('status-active');
                        break;
                    default:
                        statusEl.classList.add('status-inactive');
                }
            },
            
            updateBatchInfo(current, total, pairs) {
                document.getElementById('batchInfo').textContent = `Batch: ${current}/${total} | Pairs: ${pairs}`;
            },
            
            updateStats() {
                const stats = StateManager.user.arbitrageStats;
                document.getElementById('oppCount').textContent = stats.opportunitiesFound;
                document.getElementById('bestProfit').textContent = `${stats.bestProfit.toFixed(2)}%`;
                document.getElementById('activeBaskets').textContent = StateManager.gridEngine.activeBaskets.length;
            },
            
            updateUI() {
                document.getElementById('qbucksDisplay').textContent = `Q-Bucks: ${StateManager.user.qBucks.toLocaleString()}`;
                document.getElementById('levelDisplay').textContent = `Level ${StateManager.user.level}`;
                document.getElementById('pointsDisplay').textContent = `Points: ${StateManager.user.points}/${CONFIG.POINTS_PER_LEVEL}`;
                document.getElementById('boomCounter').textContent = `Quantum Energy: ${StateManager.user.quantumEnergy}`;
                
                this.updateStats();
            }
        };

        // ========== GAME LOGIC ==========
        const GameLogic = {
            async activateInvestmentModule(moduleKey) {
                const module = MODULES[moduleKey];
                if (!module || StateManager.user.qBucks < module.cost) {
                    UIComponents.showMessage('Module Error', 'Insufficient Q-Bucks to activate this module.');
                    return;
                }
                
                const usesLeft = module.maxUses - (StateManager.user.toolUses[moduleKey] || 0);
                if (usesLeft <= 0) {
                    UIComponents.showMessage('Module Depleted', `No uses remaining for ${module.name}. Upgrade required.`);
                    return;
                }
                
                // Deduct cost and track usage
                StateManager.updateUser({
                    qBucks: StateManager.user.qBucks - module.cost,
                    toolUses: { ...StateManager.user.toolUses, [moduleKey]: (StateManager.user.toolUses[moduleKey] || 0) + 1 }
                });
                
                // Special handling for arbitrage modules
                if (moduleKey === 'triangular' || moduleKey === 'bellman') {
                    await this.activateArbitrageModule(moduleKey);
                } else if (moduleKey === 'grid') {
                    this.activateGridModule();
                } else {
                    // Default module activation
                    this.addPoints(module.cost / 5);
                    UIComponents.showMessage('Module Activated', `${module.name} is now active and scanning for opportunities.`);
                }
                
                UIComponents.updateUI();
                UIComponents.generateInvestmentCards();
            },
            
            async activateArbitrageModule(moduleKey) {
                const investment = parseInt(document.getElementById('investmentAmount').value) || 100;
                const batchSize = parseInt(document.getElementById('batchSize').value) || CONFIG.BATCH_SIZE_INIT;
                
                StateManager.arbitrageEngine.batchSize = batchSize;
                
                UIComponents.showMessage('Arbitrage Scan Initiated', 
                    `Starting ${moduleKey} arbitrage scan with $${investment} investment and batch size ${batchSize}.`);
                
                const opportunities = await StateManager.arbitrageEngine.findTriangularArbitrage(investment);
                StateManager.updateArbitrageStats(opportunities);
                UIComponents.updateArbitrageOpportunities(opportunities);
                
                // Award Q-Bucks for finding opportunities
                if (opportunities.length > 0) {
                    const bonus = opportunities.length * 25;
                    StateManager.updateUser({ qBucks: StateManager.user.qBucks + bonus });
                    UIComponents.showMessage('Arbitrage Opportunities Found', 
                        `Found ${opportunities.length} profitable paths! +${bonus} Q-Bucks awarded.`);
                }
                
                this.addPoints(opportunities.length * 10);
            },
            
            activateGridModule() {
                const pair = document.getElementById('gridPair').value;
                const budget = parseInt(document.getElementById('gridBudget').value);
                const numBaskets = parseInt(document.getElementById('gridBaskets').value);
                const ordersPerBasket = parseInt(document.getElementById('gridOrdersPerBasket').value);
                
                if (!pair || budget < 10) {
                    UIComponents.showMessage('Grid Trading Error', 'Please check your inputs. Budget must be at least 10 Q-Bucks.');
                    return;
                }
                
                const baskets = StateManager.gridEngine.setupGridTrading(pair, budget, numBaskets, ordersPerBasket);
                StateManager.updateUser({ qBucks: StateManager.user.qBucks - budget });
                
                UIComponents.updateGridOrders(baskets);
                UIComponents.showMessage('Grid Trading Activated', 
                    `Started grid trading for ${pair} with $${budget} budget. ${baskets.length} baskets created.`);
                
                this.addPoints(budget / 10);
            },
            
            playBaseGame(gameKey) {
                const game = BASE_GAMES[gameKey];
                if (!game || StateManager.user.qBucks < game.cost) {
                    UIComponents.showMessage('Game Error', 'Insufficient Q-Bucks to play this game.');
                    return;
                }
                
                StateManager.updateUser({ qBucks: StateManager.user.qBucks - game.cost });
                
                const win = Math.random() > game.risk;
                let outcomeMessage, qbucksChange;
                
                if (win) {
                    qbucksChange = game.reward;
                    outcomeMessage = `Quantum victory! You won ${qbucksChange} Q-Bucks!`;
                    StateManager.updateUser({ qBucks: StateManager.user.qBucks + qbucksChange });
                    
                    // Special rewards for arbitrage game
                    if (gameKey === 'arbitrage') {
                        const bonusScan = Math.floor(Math.random() * 3) + 1;
                        StateManager.updateUser({ quantumEnergy: StateManager.user.quantumEnergy + bonusScan });
                        outcomeMessage += ` +${bonusScan} Quantum Energy for arbitrage scans!`;
                    }
                } else {
                    qbucksChange = -game.cost;
                    outcomeMessage = `Quantum misalignment. You lost ${game.cost} Q-Bucks.`;
                }
                
                this.addPoints(game.cost / 3);
                UIComponents.updateUI();
                UIComponents.showMessage(`${game.name} Result`, outcomeMessage);
            },
            
            addPoints(points) {
                const newPoints = StateManager.user.points + points;
                let newLevel = StateManager.user.level;
                let levelUps = 0;
                
                while (newPoints >= CONFIG.POINTS_PER_LEVEL) {
                    newLevel++;
                    levelUps++;
                    StateManager.updateUser({ points: newPoints - CONFIG.POINTS_PER_LEVEL });
                    newPoints -= CONFIG.POINTS_PER_LEVEL;
                }
                
                StateManager.updateUser({ points: newPoints, level: newLevel });
                
                if (levelUps > 0) {
                    const unlockedModules = [...StateManager.user.unlockedModules];
                    Object.entries(MODULES).forEach(([key, module]) => {
                        if (module.level <= newLevel && !unlockedModules.includes(key)) {
                            unlockedModules.push(key);
                            StateManager.updateUser({ toolUses: { ...StateManager.user.toolUses, [key]: 0 } });
                        }
                    });
                    
                    StateManager.updateUser({ unlockedModules });
                    
                    const levelBonus = newLevel * 100;
                    StateManager.updateUser({ qBucks: StateManager.user.qBucks + levelBonus });
                    
                    UIComponents.generateInvestmentCards();
                    UIComponents.generateTechTreeNodes();
                    
                    UIComponents.showMessage('Quantum Level Up!', 
                        `Reached Level ${newLevel}! +${levelBonus} Q-Bucks awarded! New modules unlocked.`);
                }
                
                UIComponents.updateUI();
            },
            
            initiatePortalJump() {
                const portalStatus = document.getElementById('portalStatus');
                const portalButton = document.getElementById('portalJump');
                
                portalStatus.innerHTML = 'Arbitrage Scanner: <span class="status-indicator status-waiting"></span>Scanning...';
                portalButton.disabled = true;
                portalButton.textContent = 'Scanning Markets...';
                
                // Visual effects
                for (let i = 0; i < 10; i++) {
                    setTimeout(() => {
                        const x = Math.random() * window.innerWidth;
                        const y = Math.random() * window.innerHeight;
                        VisualEffects.createBoomParticle(x, y, true);
                    }, i * 200);
                }
                
                // Start arbitrage scan
                setTimeout(async () => {
                    const opportunities = await StateManager.arbitrageEngine.findTriangularArbitrage(100);
                    StateManager.updateArbitrageStats(opportunities);
                    UIComponents.updateArbitrageOpportunities(opportunities);
                    
                    portalStatus.innerHTML = 'Arbitrage Scanner: <span class="status-indicator status-active"></span>Active';
                    portalButton.disabled = false;
                    portalButton.textContent = 'Initiate Arbitrage Scan';
                    
                    this.addPoints(25);
                    UIComponents.updateUI();
                    
                    UIComponents.showMessage('Quantum Scan Complete', 
                        `Arbitrage scan completed. Found ${opportunities.length} opportunities across the quantum field.`);
                }, 3000);
            },
            
            generateQuantumEnergy() {
                if (StateManager.user.quantumEnergy > 0 && (!StateManager.user.lastBoomTime || Date.now() - StateManager.user.lastBoomTime > 1000)) {
                    StateManager.updateUser({
                        quantumEnergy: StateManager.user.quantumEnergy - 1,
                        lastBoomTime: Date.now()
                    });
                    
                    // Visual effects
                    for (let i = 0; i < 3; i++) {
                        setTimeout(() => {
                            const x = Math.random() * window.innerWidth;
                            const y = Math.random() * window.innerHeight;
                            VisualEffects.createBoomParticle(x, y, false);
                        }, i * 300);
                    }
                    
                    const timeMultiplier = StateManager.user.sweepstakesTime;
                    const bonus = Math.floor(Math.random() * 50 * timeMultiplier) + (10 * timeMultiplier);
                    StateManager.updateUser({ qBucks: StateManager.user.qBucks + bonus });
                    
                    UIComponents.updateUI();
                    UIComponents.showMessage('Quantum Energy Generated', 
                        `Quantum energy released! +${bonus} Q-Bucks awarded. Use for arbitrage scans.`);
                    
                    if (StateManager.user.quantumEnergy === 0) {
                        const boomButton = document.getElementById('generateBoom');
                        boomButton.disabled = true;
                        boomButton.textContent = 'Recharging...';
                        
                        setTimeout(() => {
                            StateManager.updateUser({ quantumEnergy: CONFIG.QUANTUM_ENERGY });
                            UIComponents.updateUI();
                            boomButton.disabled = false;
                            boomButton.textContent = 'Generate Quantum Energy';
                            UIComponents.showMessage('Quantum Energy Replenished', 
                                'Quantum energy reserves fully replenished. Ready for more arbitrage scans.');
                        }, CONFIG.QUANTUM_RECHARGE_TIME);
                    }
                }
            }
        };

        // ========== VISUAL EFFECTS ==========
        const VisualEffects = {
            createBoomParticle(x, y, isPortal) {
                const particle = document.createElement('div');
                particle.className = 'boom-particle';
                particle.style.left = `${x}px`;
                particle.style.top = `${y}px`;
                
                const colors = ['#00f0ff', '#ff00ff', '#00ffaa', '#ffaa00'];
                const color = colors[Math.floor(Math.random() * colors.length)];
                particle.style.background = `radial-gradient(circle, ${color} 0%, transparent 70%)`;
                
                document.body.appendChild(particle);
                
                const size = isPortal ? Math.random() * 25 + 15 : Math.random() * 15 + 5;
                particle.style.width = `${size}px`;
                particle.style.height = `${size}px`;
                
                const angle = Math.random() * Math.PI * 2;
                const distance = isPortal ? Math.random() * 150 + 100 : Math.random() * 80 + 40;
                
                const animation = particle.animate([
                    { transform: `translate(0, 0) scale(1)`, opacity: 1 },
                    { transform: `translate(${Math.cos(angle) * distance}px, ${Math.sin(angle) * distance}px) scale(0)`, opacity: 0 }
                ], {
                    duration: Math.random() * 1000 + 500,
                    easing: 'cubic-bezier(0.1, 0.8, 0.2, 1)'
                });
                
                animation.onfinish = () => {
                    if (particle.parentNode) {
                        particle.parentNode.removeChild(particle);
                    }
                };
            },
            
            initBackgroundAnimation() {
                const canvas = document.getElementById('backgroundCanvas');
                const ctx = canvas.getContext('2d');
                
                function resizeCanvas() {
                    canvas.width = window.innerWidth;
                    canvas.height = window.innerHeight;
                }
                
                window.addEventListener('resize', resizeCanvas);
                resizeCanvas();
                
                const particles = Array.from({ length: 30 }, () => ({
                    x: Math.random() * canvas.width,
                    y: Math.random() * canvas.height,
                    vx: (Math.random() - 0.5) * 2,
                    vy: (Math.random() - 0.5) * 2,
                    radius: Math.random() * 1.5 + 0.5,
                    color: `hsl(${Math.random() * 60 + 180}, 100%, ${Math.random() * 30 + 50}%)`,
                    alpha: Math.random() * 0.3 + 0.1
                }));
                
                function animate() {
                    ctx.clearRect(0, 0, canvas.width, canvas.height);
                    
                    particles.forEach(p => {
                        p.x += p.vx;
                        p.y += p.vy;
                        
                        if (p.x < 0 || p.x > canvas.width) p.vx *= -1;
                        if (p.y < 0 || p.y > canvas.height) p.vy *= -1;
                        
                        ctx.beginPath();
                        ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
                        ctx.fillStyle = p.color;
                        ctx.globalAlpha = p.alpha;
                        ctx.fill();
                    });
                    
                    requestAnimationFrame(animate);
                }
                
                animate();
            }
        };

        // ========== INITIALIZATION ==========
        function init() {
            // Initialize state management
            StateManager.init();
            
            // Initialize UI components
            UIComponents.initModals();
            UIComponents.generateInvestmentCards();
            UIComponents.generateBaseGames();
            UIComponents.generateTechTreeNodes();
            UIComponents.updateUI();
            
            // Initialize visual effects
            VisualEffects.initBackgroundAnimation();
            
            // Set up event listeners
            document.getElementById('portalJump').addEventListener('click', () => GameLogic.initiatePortalJump());
            document.getElementById('generateBoom').addEventListener('click', () => GameLogic.generateQuantumEnergy());
            document.getElementById('scanArbitrage').addEventListener('click', () => {
                GameLogic.activateInvestmentModule('triangular');
            });
            document.getElementById('startGridTrading').addEventListener('click', () => {
                GameLogic.activateInvestmentModule('grid');
            });
            
            // Live data toggle
            document.getElementById('liveDataToggle').addEventListener('change', (e) => {
                UIComponents.showMessage('Data Source Updated', 
                    e.target.checked ? 
                    'Now using enhanced market data simulation' : 
                    'Using basic market data simulation');
            });
            
            // Sweepstakes buttons
            document.querySelectorAll('.sweepstakes-btn').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    document.querySelectorAll('.sweepstakes-btn').forEach(b => b.classList.remove('active'));
                    e.target.classList.add('active');
                    StateManager.updateUser({ sweepstakesTime: parseInt(e.target.getAttribute('data-time')) });
                    startSweepstakesTimer();
                });
            });
            
            // Start background processes
            startLevelProgression();
            startSweepstakesTimer();
            startGridUpdates();
            
            // Restore username if logged in
            if (StateManager.user.username) {
                document.getElementById('loginBtn').textContent = StateManager.user.username;
            }
            
            UIComponents.showMessage('Quantum Arbitrage System Online', 
                'Welcome to QuanTM FOAM v2.1! Arbitrage detection systems are now active. ' +
                'Start by initiating an arbitrage scan or activating trading modules.');
        }

        // ========== BACKGROUND PROCESSES ==========
        function startLevelProgression() {
            setInterval(() => {
                GameLogic.addPoints(2);
            }, CONFIG.LEVEL_UP_INTERVAL);
        }

        function startSweepstakesTimer() {
            let timeLeft = StateManager.user.sweepstakesTime * 60;
            
            const timer = setInterval(() => {
                timeLeft--;
                
                if (timeLeft <= 0) {
                    timeLeft = StateManager.user.sweepstakesTime * 60;
                    StateManager.updateUser({ 
                        quantumEnergy: Math.min(StateManager.user.quantumEnergy + 1, CONFIG.QUANTUM_ENERGY) 
                    });
                    UIComponents.updateUI();
                    
                    UIComponents.showMessage('Quantum Energy Boost', 
                        'Time portal activated! +1 Quantum Energy for arbitrage scans.');
                }
                
                const minutes = Math.floor(timeLeft / 60);
                const seconds = timeLeft % 60;
                document.getElementById('sweepstakesTimer').textContent = 
                    `${minutes}:${seconds.toString().padStart(2, '0')}`;
            }, 1000);
        }

        function startGridUpdates() {
            setInterval(() => {
                if (StateManager.gridEngine.activeBaskets.length > 0) {
                    const updatedBaskets = StateManager.gridEngine.updateGridOrders();
                    UIComponents.updateGridOrders(updatedBaskets);
                    UIComponents.updateStats();
                    
                    // Check for filled orders and calculate profit
                    let totalProfit = 0;
                    updatedBaskets.forEach(basket => {
                        basket.orders.forEach(order => {
                            if (order.status === 'filled' && order.type === 'sell') {
                                totalProfit += order.amount * order.price * 0.998; // After fees
                            }
                        });
                    });
                    
                    if (totalProfit > 0) {
                        StateManager.updateUser({ qBucks: StateManager.user.qBucks + totalProfit });
                        UIComponents.updateUI();
                    }
                }
            }, 5000); // Update every 5 seconds
        }

        // Initialize the application when DOM is loaded
        document.addEventListener('DOMContentLoaded', init);
    </script>
</body>
</html>
