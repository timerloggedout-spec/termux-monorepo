async loadExchangePairs(exchange) {
    try {
        this.logger.log('EXCHANGE', `Loading pairs from ${exchange}`, 'info');
        let pairs = [];

        if (exchange === 'coingecko') {
            pairs = await this.fetchCoinGeckoData();
        } else if (exchange === 'dex screener') {
            pairs = await this.fetchDEXScreenerData();
        } else {
            pairs = await this.generateRealisticPairs(exchange);
        }

        PRODUCTION_CONFIG.EXCHANGES[exchange].pairs = pairs
            .sort((a, b) => b.volume - a.volume)
            .slice(0, PRODUCTION_CONFIG.PERFORMANCE.MAX_PAIRS_PER_EXCHANGE);

        this.logger.log('EXCHANGE', `Loaded ${pairs.length} pairs from ${exchange}`, 'success');
        return true;
        
    } catch (error) {
        this.logger.log('EXCHANGE', `Failed to load ${exchange}: ${error.message}`, 'error');
        await this.generateRealisticPairs(exchange);
        return false;
    }
}
