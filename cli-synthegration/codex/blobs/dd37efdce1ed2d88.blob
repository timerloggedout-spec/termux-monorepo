export function exportToCSV(compounds) {
  if (!compounds || compounds.length === 0) {
    alert('No data to export');
    return;
  }

  // Get all unique headers from the first compound
  const headers = Object.keys(compounds[0]);
  const rows = compounds.map(c => headers.map(h => c[h] || ''));
  
  const csvContent = [headers, ...rows]
    .map(row => row.map(cell => `"${String(cell).replace(/"/g, '""')}"`).join(','))
    .join('\n');
  
  const blob = new Blob(["\uFEFF" + csvContent], { type: 'text/csv;charset=utf-8;' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = `regulatory_matrix_${new Date().toISOString().slice(0,19).replace(/:/g, '-')}.csv`;
  a.click();
  URL.revokeObjectURL(url);
}
