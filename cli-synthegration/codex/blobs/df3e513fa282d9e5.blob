graph TD
    subgraph “DevOps & Admin (Push Updates)”
        A1[Dev Team] -->|IPNS Publish (ipfs.name.publish)| IPNS
        A2[Admin Keypair] -->|Private Key for Signing| IPNS
    end

    subgraph “P2P Data Layer (Fully Distributed)”
        IPNS[IPNS: Mutable App Pointer] --> B1[Bootstrapper Peer]
        B1 --> B2[Peer 1 Browser]
        B2 --> B3[Peer 2 Browser]
        B3 --> B4[Peer N Browser]

        subgraph “Real-Time Market Data Stream”
            C1[Market Simulator / Validator Node] -->|GossipSub Publish| B2
            B2 <-->|GossipSub Mesh| B3
            B3 <-->|GossipSub Mesh| B4
        end

        subgraph “Historical Data Distribution”
            D1[Admin Seeds Torrent] -->|Magnet Link| B2
            B2 <-->|WebTorrent Swarm| B3
            B3 <-->|WebTorrent Swarm| B4
        end

        subgraph “Game State Sync”
            B2 <-->|y-webrtc / y-libp2p| B3
            B3 <-->|y-webrtc / y-libp2p| B4
        end
    end

    subgraph “Browser Client (Peer Node)”
        E1[Market Data: GossipSub Subscriber] --> E2[Ring Buffer / μts] --> E3[DuckDB-Wasm]
        E4[Historical Data: WebTorrent Client] --> E3
        E5[Game State: Yjs CRDT Doc] --> E6[IndexedDB Persistence]
        E7[Compute Engine: Web Workers] --> E8[Arbitrage & Portfolio Optimization]
        E9[UI: React/Vue] --> E3 & E5 & E8
        E10[Backtest Engine: Web Workers] --> E3 & E5
    end

    subgraph “Optional Distributed Compute”
        E8 <-.-> F1[Peer Compute Mesh: WebRTC DataChannel]
    end
