        <div class="section" id="strategic-notes">
            <div class="section-header">
                <div class="section-title">Strategic Notes & Recommendations</div>
                <div class="section-description">Key observations and strategic guidance for ongoing investigation</div>
            </div>
            
            <div class="strategic-notes">
                <h3>Critical Observations</h3>
                <ul>
                    <li>Immediate preservation efforts were crucial for maintaining evidence integrity</li>
                    <li>Documentation of timeline and communications provides strong foundation for legal action</li>
                    <li>Service animal status elevates case to potential federal jurisdiction</li>
                    <li>Pattern of suspicious activity prior to incident suggests premeditation</li>
                </ul>
                
                <h3>Strategic Recommendations</h3>
                <ul>
                    <li>Maintain chain of custody for all evidence and documentation</li>
                    <li>Coordinate with legal authorities to ensure proper handling of criminal investigation</li>
                    <li>Consider civil action in parallel with criminal proceedings</li>
                    <li>Utilize media strategically to raise awareness of service animal protection issues</li>
                    <li>Establish clear communication protocols with all involved entities</li>
                </ul>
            </div>
        </div>
    </div>

    <script>
        // Contact details data structure
        const contactDetails = {
            'dumas': {
                name: 'Dumas',
                role: 'Primary Investigator / Service Animal Handler',
                email: 'Secure channels only',
                phone: 'Confidential',
                context: 'Service animal handler and primary investigator. Maintains detailed documentation of timeline and evidence.',
                notes: 'Has preserved extensive evidence including photographs, communications, and physical samples. Key witness in potential criminal proceedings.'
            },
            'ucdavis': {
                name: 'UC Davis VMTH/CAHFS',
                role: 'Veterinary Medical Teaching Hospital / California Animal Health and Food Safety Laboratory',
                email: 'vmth@ucdavis.edu | cahfs@ucdavis.edu',
                phone: '530-752-1393 (VMTH) | 530-752-8700 (CAHFS)',
                context: 'Primary veterinary pathology and toxicology analysis facility. Responsible for necropsy and evidence preservation.',
                notes: 'Received body with explicit instructions for preservation and comprehensive analysis. Critical partner in determining cause of death.'
            },
            'nsg': {
                name: 'National Service Group (NSG)',
                role: 'Service Animal Organization',
                email: 'W.L. Spangler (Primary Contact)',
                phone: 'Organization contact channels',
                context: 'Service animal organization with vested interest in case outcome and animal welfare standards.',
                notes: 'Acknowledged receipt of case details and service animal status. Potential resource for advocacy and legal support.'
            },
            'legal': {
                name: 'Legal Entities',
                role: 'California Attorney General, FBI Animal Cruelty Division',
                email: 'Official channels only',
                phone: 'Confidential',
                context: 'State and federal legal authorities with jurisdiction over animal cruelty and service animal protection cases.',
                notes: 'Escalation to these entities indicates serious nature of case and potential for criminal prosecution.'
            }
        };

        // Function to show contact details in popup
        function showContactDetails(contactKey, context) {
            const contact = contactDetails[contactKey];
            const popup = document.getElementById('contactPopup');
            const overlay = document.getElementById('popupOverlay');
            const content = document.getElementById('contactContent');
            
            if (contact) {
                content.innerHTML = `
                    <div class="contact-name">${contact.name}</div>
                    <div class="contact-context">${context}</div>
                    <div class="contact-details-item">
                        <div class="contact-role"><strong>Role:</strong> ${contact.role}</div>
                        <div class="contact-email"><strong>Email:</strong> ${contact.email}</div>
                        <div class="contact-phone"><strong>Phone:</strong> ${contact.phone}</div>
                    </div>
                    <div class="contact-notes">${contact.notes}</div>
                `;
                
                popup.classList.add('active');
                overlay.classList.add('active');
            }
        }

        // Function to close contact popup
        function closeContactPopup() {
            const popup = document.getElementById('contactPopup');
            const overlay = document.getElementById('popupOverlay');
            
            popup.classList.remove('active');
            overlay.classList.remove('active');
        }

        // Close popup when clicking overlay
        document.getElementById('popupOverlay').addEventListener('click', closeContactPopup);

        // SVG zoom functionality
        let currentScale = 1;
        const svgElement = document.getElementById('responseFlow');
        
        function zoomIn() {
            currentScale *= 1.2;
            updateSvgScale();
        }
        
        function zoomOut() {
            currentScale /= 1.2;
            updateSvgScale();
        }
        
        function resetZoom() {
            currentScale = 1;
            updateSvgScale();
        }
        
        function updateSvgScale() {
            svgElement.style.transform = `scale(${currentScale})`;
            svgElement.style.transformOrigin = 'center center';
        }

        // Smooth scrolling for navigation links
        document.querySelectorAll('.nav-link').forEach(link => {
            link.addEventListener('click', function(e) {
                e.preventDefault();
                const targetId = this.getAttribute('href');
                const targetSection = document.querySelector(targetId);
                
                if (targetSection) {
                    window.scrollTo({
                        top: targetSection.offsetTop - 20,
                        behavior: 'smooth'
                    });
                }
            });
        });

        // Print functionality
        document.addEventListener('keydown', function(e) {
            if (e.ctrlKey && e.key === 'p') {
                e.preventDefault();
                window.print();
            }
        });
    </script>
</body>
</html>
