 async function fetchWithCorsFallback(url) {
   // If we are running locally, use proxy
   if (window.location.protocol === 'file:') {
     // Use allorigins
     url = 'https://api.allorigins.win/raw?url=' + encodeURIComponent(url);
   }

   const response = await fetch(url);
   return response;
 }
 
