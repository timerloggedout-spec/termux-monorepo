<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
  <title>🎰 QuanTM FOAM v23.30 – Full Coverage Test (Fixed)</title>
  <style>
    :root {
      --pink: #ff00ff; --cyan: #00f0ff; --green: #00ffaa; --gold: #ffd700;
      --bg: #0a0a1a; --card: #1a1a2a; --border: #2a2a3a; --base-font-size: 10px;
    }
    * { margin:0; padding:0; box-sizing:border-box; }
    body { background:var(--bg); color:#a0a0ff; font-family:'Courier New',monospace; font-size:var(--base-font-size); overflow-x:hidden; }
    canvas#particleCanvas { position:fixed; top:0; left:0; width:100%; height:100%; pointer-events:none; z-index:9999; }
    .container { max-width:1500px; margin:0 auto; padding:8px; position:relative; z-index:1; }
    h1 { color:var(--gold); font-size:calc(var(--base-font-size)*1.8); text-shadow:0 0 12px var(--pink),0 0 20px var(--cyan); margin-bottom:4px; }
    h2 { color:var(--cyan); font-size:calc(var(--base-font-size)*1.3); margin:10px 0 5px; }
    .status-bar { padding:6px 12px; margin:6px 0; background:linear-gradient(145deg,#0a0a1a,#1a1a2a); border-radius:8px; border-left:4px solid var(--cyan); font-weight:bold; display:flex; justify-content:space-between; align-items:center; box-shadow:0 0 15px rgba(0,240,255,0.25); flex-wrap:wrap; }
    .controls { display:flex; flex-wrap:wrap; gap:5px; margin:6px 0; }
    button { background:#111; border:2px solid var(--pink); color:var(--pink); padding:6px 10px; border-radius:18px; font-size:calc(var(--base-font-size)*0.9); font-weight:bold; cursor:pointer; font-family:'Courier New',monospace; transition:all 0.2s; text-transform:uppercase; letter-spacing:1px; box-shadow:0 0 6px var(--pink); }
    button:hover { background:var(--pink); color:#000; box-shadow:0 0 18px var(--pink); }
    button:active { transform:scale(0.95); }
    button.cyan { border-color:var(--cyan); color:var(--cyan); box-shadow:0 0 6px var(--cyan); }
    button.cyan:hover { background:var(--cyan); color:#000; }
    button.live { border-color:#ff4444; color:#ff4444; animation:livePulse 1s infinite; }
    button.gold { border-color:var(--gold); color:var(--gold); box-shadow:0 0 10px var(--gold); font-size:calc(var(--base-font-size)*1.1); padding:8px 18px; }
    button.gold:hover { background:var(--gold); color:#000; box-shadow:0 0 25px var(--gold); }
    button.allin { border-color:#ff4444; color:#ff4444; box-shadow:0 0 10px #ff4444; font-size:calc(var(--base-font-size)*1.1); padding:8px 18px; }
    button.allin:hover { background:#ff4444; color:#000; box-shadow:0 0 25px #ff4444; }
    button.reset { border-color:#ffaa00; color:#ffaa00; box-shadow:0 0 8px #ffaa00; }
    button.reset:hover { background:#ffaa00; color:#000; box-shadow:0 0 20px #ffaa00; }
    button.test { border-color:#44ff44; color:#44ff44; box-shadow:0 0 8px #44ff44; }
    button.test:hover { background:#44ff44; color:#000; box-shadow:0 0 20px #44ff44; }
    @keyframes livePulse { 0%,100%{box-shadow:0 0 6px #ff4444;} 50%{box-shadow:0 0 16px #ff4444;} }
    button:disabled { opacity:0.4; cursor:not-allowed; }
    .grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(280px,1fr)); gap:8px; margin:8px 0; }
    .card { background:var(--card); border-radius:8px; padding:10px; border:1px solid var(--border); box-shadow:0 0 10px rgba(255,0,255,0.08); }
    .card h3 { color:var(--cyan); font-size:calc(var(--base-font-size)*1.1); margin-bottom:6px; }
    .exchange-status { display:flex; align-items:center; gap:5px; padding:3px; background:#0a0a1a; border-radius:4px; margin:2px 0; font-size:calc(var(--base-font-size)*0.8); border:1px solid #2a2a3a; }
    .indicator { width:6px; height:6px; border-radius:50%; background:#ff4444; box-shadow:0 0 5px #ff4444; }
    .indicator.online { background:var(--green); box-shadow:0 0 8px var(--green); animation:pulse 1.5s infinite; }
    .indicator.ws { background:#ff00ff; box-shadow:0 0 8px #ff00ff; animation:pulse 0.8s infinite; }
    .indicator.reconnecting { background:#ffaa00; box-shadow:0 0 8px #ffaa00; animation:pulse 0.5s infinite; }
    @keyframes pulse { 0%,100%{opacity:1;box-shadow:0 0 6px var(--green);} 50%{opacity:0.4;box-shadow:0 0 14px var(--green);} }
    .stat { display:flex; justify-content:space-between; padding:2px 0; font-size:calc(var(--base-font-size)*0.9); }
    .stat-value { color:var(--gold); font-weight:bold; }
    .rolling-number { font-size:calc(var(--base-font-size)*1.3); color:var(--gold); font-weight:bold; }
    .opp-section { margin:6px 0; padding:6px; background:#0f0f1f; border-radius:5px; border:1px solid #2a2a3a; }
    .opp-header { display:flex; justify-content:space-between; padding:6px; background:#1a1a2a; border-radius:5px; cursor:pointer; font-weight:bold; color:var(--pink); font-size:calc(var(--base-font-size)*0.9); }
    .opp-list { max-height:280px; overflow-y:auto; }
    .opportunity { background:#111; padding:6px; margin:3px 0; border-radius:5px; border-left:3px solid var(--green); cursor:pointer; font-size:calc(var(--base-font-size)*0.9); }
    .opportunity:hover { border-left-color:var(--pink); background:#1a1a2a; }
    .opportunity.mega { border-left-color:var(--gold); animation:glow 1s infinite alternate; }
    @keyframes glow { from{box-shadow:0 0 3px var(--gold);} to{box-shadow:0 0 16px var(--gold);} }
    .log-container { background:#000; padding:6px; border-radius:5px; max-height:150px; overflow-y:auto; font-size:calc(var(--base-font-size)*0.7); margin-top:6px; }
    .modal { display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.85); z-index:10000; align-items:center; justify-content:center; }
    .modal-content { background:#1a1a2a; border:2px solid var(--pink); border-radius:10px; padding:16px; max-width:700px; width:95%; color:white; max-height:85vh; overflow-y:auto; }
    .flex-row { display:flex; gap:6px; align-items:center; flex-wrap:wrap; }
    input,select { background:#0a0a1a; border:1px solid var(--cyan); color:var(--cyan); padding:2px 5px; border-radius:3px; font-family:'Courier New',monospace; font-size:calc(var(--base-font-size)*0.9); }
    .checkbox-group { display:flex; flex-wrap:wrap; gap:3px; align-items:center; }
    .checkbox-group label { display:flex; align-items:center; gap:2px; font-size:calc(var(--base-font-size)*0.7); color:var(--cyan); }
    .tier-badge { display:inline-block; padding:1px 4px; border-radius:2px; font-size:calc(var(--base-font-size)*0.6); color:#000; margin-left:2px; }
    .tier-pico { background:#ffaa00; } .tier-femto { background:#ff00ff; } .tier-planck { background:#00f0ff; }
    .progress-bar { height:6px; background:#333; border-radius:3px; margin:3px 0; }
    .progress-fill { height:100%; background:var(--gold); border-radius:3px; width:0%; }
    .perk-unlocked { color:var(--green); } .perk-locked { color:#ff4444; text-decoration:line-through; }
    #graphSlotContainer { display:none; background:linear-gradient(180deg,#0a0a1a,#1a0a2a); border:3px solid var(--gold); border-radius:14px; padding:12px; margin:10px 0; text-align:center; box-shadow:0 0 30px rgba(255,215,0,0.3); position:relative; overflow:hidden; }
    #graphNetwork { display:block; margin:0 auto; position:relative; z-index:2; }
    #batchResult { background:#0a0a1a; border:1px solid var(--gold); border-radius:6px; padding:8px; margin-top:8px; font-size:calc(var(--base-font-size)*0.8); max-height:250px; overflow-y:auto; text-align:left; position:relative; z-index:2; }
    #batchHistory { background:#0a0a1a; border:1px solid var(--cyan); border-radius:6px; padding:8px; margin-top:8px; font-size:calc(var(--base-font-size)*0.7); max-height:150px; overflow-y:auto; text-align:left; position:relative; z-index:2; }
    .target-preset { border:1px solid var(--cyan); padding:2px 6px; border-radius:10px; cursor:pointer; font-size:calc(var(--base-font-size)*0.7); color:var(--cyan); background:transparent; }
    .target-preset:hover { background:var(--cyan); color:#000; }
    .tooltip { position:relative; display:inline-block; cursor:help; color:var(--gold); }
    .tooltip .tooltiptext { visibility:hidden; width:200px; background:#1a1a2a; color:#fff; text-align:center; border-radius:6px; padding:5px; position:absolute; z-index:10; bottom:125%; left:50%; margin-left:-100px; opacity:0; transition:opacity 0.3s; font-size:calc(var(--base-font-size)*0.7); }
    .tooltip:hover .tooltiptext { visibility:visible; opacity:1; }
    .panel { background:var(--card); border-radius:8px; padding:10px; margin:6px 0; border:1px solid var(--border); display:none; }
    .panel h3 { color:var(--cyan); font-size:calc(var(--base-font-size)*1.1); margin-bottom:6px; }
    .panel textarea { width:100%; background:#0a0a1a; color:var(--cyan); border:1px solid var(--cyan); font-family:'Courier New',monospace; font-size:calc(var(--base-font-size)*0.9); padding:4px; }
    .torrent-progress { height:10px; background:#333; border-radius:5px; margin:4px 0; }
    .torrent-fill { height:100%; background:var(--green); border-radius:5px; width:0%; }
    .player-row { cursor:pointer; padding:3px 5px; margin:2px 0; border-radius:3px; background:#0a0a1a; }
    .player-row:hover { background:#2a2a3a; }
  </style>
  <script src="https://cdn.jsdelivr.net/npm/yjs@13.6.7/dist/yjs.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/y-webrtc@10.3.0/dist/y-webrtc.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/webtorrent@1.9.6/webtorrent.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/qrcode@1.5.1/build/qrcode.min.js"></script>
</head>
<body>
  <canvas id="particleCanvas"></canvas>
  <div class="container">
    <h1>🎰 QUANTM FOAM <span style="font-size:11px;">v23.30 – Full Coverage Test (Fixed)</span></h1>
    <div class="status-bar"><span id="mainStatus">🟡 STANDBY — Click INIT</span><div class="flex-row"><span style="font-size:8px;">VIRTUAL</span><input type="checkbox" id="liveToggle" onchange="UI.toggleLiveMode()"><span style="font-size:8px;">LIVE</span><span style="font-size:8px;color:#ffaa00;display:none;" id="testnetLabel">🧪 TESTNET</span><input type="checkbox" id="liveTestnetToggle" onchange="UI.toggleLiveTestnet()" style="display:none;"><span class="tooltip">ℹ️<span class="tooltiptext">LIVE uses real endpoints. Enable TESTNET for official testnet trading (Uniswap, PancakeSwap, OKX, Binance).</span></span></div></div>
    <div class="controls"><button class="cyan" onclick="UI.logButton('INIT');initSystem()">🔄 INIT</button><button id="scanBtn" onclick="UI.logButton('FULL SCAN');runFullScan()" disabled>🎲 SCAN</button><button id="liveScanBtn" onclick="UI.logButton('LIVE SCAN');toggleLiveScan()">🔄 LIVE</button><button onclick="UI.logButton('LIVE WS');connectAllWebSockets()">📡 WS</button><button onclick="UI.logButton('CREATE COIN');openCreateCoinModal()">🪙 COIN</button><button onclick="UI.logButton('PUMP LAUNCH');openPumpLaunchModal()">🚀 PUMP</button><button onclick="UI.logButton('GRAPH UI');UI.toggleGraphSlot()">🌐 GRAPH</button><button onclick="UI.logButton('LOGS');toggleLogs()">📋 LOGS</button><button onclick="UI.logButton('COPY LOGS');UI.copyLogsRobust()">📋 COPY</button><button onclick="UI.logButton('CSV EXPORT');Engine.exportCSV()">📥 CSV</button><button onclick="UI.logButton('API KEYS');openApiKeysModal()">🔑 KEYS</button><button onclick="UI.logButton('SHARE');shareJackpot()">📤 SHARE</button><button onclick="UI.logButton('THEME');toggleTheme()">🎨</button><button class="reset" onclick="Engine.resetPaperAccount()">🧹 RESET</button><button class="test" onclick="Engine.runTestSuite()">🧪 TEST</button><button id="torrentBtn" onclick="UI.togglePanel('torrentPanel')">📦 TORRENT</button><button onclick="UI.togglePanel('dbPanel')">📊 DB</button><button onclick="UI.togglePanel('ipnsPanel')">☁️ IPNS</button><button onclick="UI.togglePanel('manaPanel')">⚡ MANA</button><button onclick="UI.togglePanel('dexPanel')">💱 DEX</button><button id="strategyBtn" onclick="UI.togglePanel('strategyPanel')" disabled>🔐 STRATEGY</button></div>
    <div class="card" style="margin-bottom:6px;"><div class="flex-row"><label>🌐 FETCH:</label><select id="proxySelect" onchange="UI.onProxyChange()"><option value="direct">⚡ Direct</option><option value="builtin">🔁 Proxy</option><option value="custom">📝 Custom</option></select><input type="text" id="corsProxyUrl" placeholder="Proxy URL" style="display:none;width:180px;"><label>🔐 WALLET:</label><input type="text" id="walletProxyUrl" style="width:140px;"><label>🔗 Exec Path:</label><input type="text" id="execPath" value="/execute" style="width:65px;"><button onclick="UI.logButton('SAVE PROXY');saveProxyConfig()" class="cyan">SAVE</button></div><div id="proxyStatusMsg"></div><div class="flex-row" style="margin-top:4px;"><label>🌐 Testnets:</label><input type="checkbox" id="testnetToggle" onchange="toggleTestnets()"><span style="font-size:8px;color:#888;">Binance Testnet, OKX Demo, Uniswap Sepolia, PancakeSwap Testnet, SushiSwap Testnet</span><label>⏸️ Pause Logs:</label><input type="checkbox" id="pauseLogsToggle" onchange="togglePauseLogs()"></div></div>
    <div class="card" style="margin-bottom:6px;"><div class="flex-row"><label>🆔 Handle:</label><input type="text" id="playerHandle" value="" onchange="setPlayerHandle()" style="width:140px;"><span style="font-size:7px;color:var(--cyan);">(shared via Yjs swarm)</span></div></div>
    <div class="flex-row" style="gap:8px;margin:4px 0;"><label>🔍 UI Scale:</label><input type="range" id="uiScaleSlider" min="8" max="16" value="10" oninput="setUIScale(this.value)" style="width:120px;"><span id="uiScaleLabel">10px</span></div>
    <div id="graphSlotContainer"><h3 style="color:var(--gold);">🌐 MULTI‑LINE GRAPH</h3><canvas id="graphNetwork" width="700" height="380"></canvas><div id="graphLegend">🟢 Size = purchase power | 🔆 Glow = profit | ⚠️ Dashed red = shared edge</div><div><label>🔗 Depth: <span id="slotDepthLabel2">5</span></label><label><input type="checkbox" id="autoOpenTrade" checked> Auto‑open</label><label><input type="checkbox" id="bellmanToggle" onchange="UI.logButton('Bellman toggle')"> Bellman‑Ford</label><label>🎯 Target: <input type="text" id="targetAssetsInput" placeholder="e.g. BABYDOGE,USDT" style="width:130px;"></label><span class="target-preset" onclick="setTargetPreset('BABYDOGE,MEME,PEPE,WOW,TRON')">🕹️ Meme</span><span class="target-preset" onclick="setTargetPreset('USDT,USDC,USD,GUSD')">💵 Stables</span><span class="target-preset" onclick="setTargetPreset('BTC,ETH,SOL,LINK')">🏦 Blue</span><span class="target-preset" onclick="setTargetPreset('UNI,WETH,WBTC')" style="border-color:#ff00ff;color:#ff00ff;">🦄 Uniswap</span><label>📉 Short: <input type="checkbox" id="shortToggle" onchange="UI.logButton('Short toggle')"></label><label>📊 Min Profit%: <input type="number" id="minProfitInput" value="0.0001" step="0.0001" style="width:60px;"></label><label>🔄 Fallback: <input type="checkbox" id="fallbackCheck" checked></label><label>🌈 Lines: <input type="number" id="multiLineCount" value="7" min="1" max="8" style="width:35px;"></label><label>💰 Reinvest%: <input type="number" id="reinvestPercent" value="50" min="0" max="100" style="width:40px;">%</label><label>📈 Index%: <input type="number" id="indexFundPercent" value="5" min="0" max="25" style="width:35px;">%</label><label>🧠 Smart Order: <input type="checkbox" id="smartBatchToggle" checked></label></div><button onclick="UI.logButton('PULL LEVER');Engine.pullGraphLever()" class="gold" id="pullLeverBtn2">🎰 PULL LEVER <span id="pullCountdown2"></span></button><button onclick="UI.logButton('EXECUTE ALL');Engine.executeAllLines()" class="allin" id="executeAllBtn">🚀 EXECUTE ALL LINES</button><div id="slotResult2"></div><div id="accumulationInfo" style="font-size:8px;color:var(--cyan);"></div><div id="batchResult"></div><details><summary style="color:var(--cyan);cursor:pointer;font-size:9px;">📜 Batch History</summary><div id="batchHistory"></div></details></div>

    <!-- P2P panels -->
    <div id="torrentPanel" class="panel"><h3>📦 TORRENT <button onclick="UI.closePanel('torrentPanel')" style="float:right;background:transparent;border:none;color:var(--pink);font-size:10px;">✖</button></h3><input type="text" id="magnetInput" placeholder="magnet:?xt=urn:btih:..." style="width:100%;"><button onclick="addTorrentFromInput()">DOWNLOAD</button><div class="torrent-progress"><div class="torrent-fill" id="torrentProgressBar"></div></div><div id="torrentStatus"></div><ul id="torrentFileList"></ul></div>
    <div id="dbPanel" class="panel"><h3>📊 DUCKDB QUERY <button onclick="UI.closePanel('dbPanel')" style="float:right;background:transparent;border:none;color:var(--pink);font-size:10px;">✖</button></h3><textarea id="sqlQuery" rows="3" placeholder="SELECT * FROM ohlc LIMIT 5;"></textarea><button onclick="executeDBQuery()">RUN</button><pre id="dbResult" style="max-height:150px;overflow:auto;background:#000;padding:4px;font-size:9px;"></pre><div id="dbStatus"></div></div>
    <div id="ipnsPanel" class="panel"><h3>☁️ IPNS & SHARE <button onclick="UI.closePanel('ipnsPanel')" style="float:right;background:transparent;border:none;color:var(--pink);font-size:10px;">✖</button></h3><div>🔐 Trusted IPNS Key: <span id="trustedKey">k51q...youradminkey</span></div><div id="ipnsStatus">Checking...</div><button onclick="checkIPNSUpdate()">CHECK UPDATE</button><hr><h4>📤 SHARE ROOM</h4><canvas id="qrCanvas" width="200" height="200"></canvas><br><button onclick="copyShareURL()">📋 COPY URL</button><div><small>Scan or copy to join the same Yjs swarm</small></div></div>
    <div id="manaPanel" class="panel"><h3>⚡ MANA TRACKER <button onclick="UI.closePanel('manaPanel')" style="float:right;background:transparent;border:none;color:var(--pink);font-size:10px;">✖</button></h3><div><strong>Your Node ID:</strong> <span id="nodeIdDisplay"></span></div><div>🔋 Compute Mana: <span id="computeMana">0</span></div><div>📡 Data Mana: <span id="dataMana">0</span></div><div>💸 Trade Mana: <span id="tradeMana">0</span></div><div><small>Mana is synced via Yjs and represents your contribution to the swarm.</small></div></div>
    <div id="dexPanel" class="panel"><h3>💱 INTERNAL DEX (QuanTM FOAM) <button onclick="UI.closePanel('dexPanel')" style="float:right;background:transparent;border:none;color:var(--pink);font-size:10px;">✖</button></h3><div><strong>Order Book (shared Yjs)</strong></div><div id="dexOrderBook"></div><input type="text" id="dexCoin" placeholder="COIN SYMBOL" style="width:100px;"><input type="number" id="dexAmount" placeholder="Amount" style="width:80px;"><button onclick="placeDEXOrder()">BUY</button><button onclick="placeDEXOrder('sell')">SELL</button></div>
    <div id="strategyPanel" class="panel"><h3>🔐 PRIVATE STRATEGY ROOM <button onclick="UI.closePanel('strategyPanel')" style="float:right;background:transparent;border:none;color:var(--pink);font-size:10px;">✖</button></h3><div>Unlock at Level 10 – Encrypted P2P room for your automated strategies.</div><button onclick="createPrivateRoom()" id="createRoomBtn" disabled>CREATE ROOM</button><div id="privateRoomInfo"></div></div>

    <div class="grid">
      <div class="card"><h3>👤 MATRIX LVL <span id="userLevel">1</span> (<span id="modeLabel">PAPER</span>)</h3><div>Score: <span id="matrixScore">0</span> / <span id="nextLevelScore">100</span></div><div class="progress-bar"><div class="progress-fill" id="levelProgress"></div></div><div>💰 Royalties: <span id="royalties">$0.00</span></div><div>🏦 Quantum: <span id="quantumFundVisible">$0.00</span> | 🔒<span id="quantumFundLocked">$0.00</span></div><div><label>SOL:</label><input type="text" id="solAddress" onchange="State.saveWallet()"><span id="solBalance">0.00</span></div><div><label>ETH:</label><input type="text" id="ethAddress" onchange="State.saveWallet()"><span id="ethBalance">0.00</span></div></div>
      <div class="card"><h3>🪙 COIN LEVELS</h3><div id="coinLevels" style="font-size:8px;">No coins yet</div></div>
      <div class="card"><h3>📊 PERFORMANCE</h3><div class="stat"><span>Total Trades:</span><span class="stat-value" id="totalTrades">0</span></div><div class="stat"><span>Win Rate:</span><span class="stat-value" id="winRate">0%</span></div><div class="stat"><span>Best Trade:</span><span class="stat-value" id="bestTrade">$0.00</span></div><div class="stat"><span>Worst Trade:</span><span class="stat-value" id="worstTrade">$0.00</span></div><div class="stat"><span>Avg Profit/Trade:</span><span class="stat-value" id="avgProfit">$0.00</span></div><div class="stat"><span>Total P/L:</span><span class="stat-value" id="totalPL">$0.00</span></div></div>
      <div class="card"><h3>📡 LIVE TRADES</h3><div id="liveTrades" style="font-size:8px;">No live trades yet</div></div>
      <div class="card"><h3>⏱️ OPERATION LATENCY</h3><div id="latencyDisplay" style="font-size:8px;">No operations yet</div></div>
      <div class="card"><h3>⭐ LEVEL PERKS</h3><div id="perksList"></div></div>
      <div class="card"><h3>🏦 BASKET TRACKER</h3><div id="basketTracker" style="font-size:8px;">No purchases yet</div><div id="basketValue" style="font-size:8px;color:var(--gold);"></div></div>
      <div class="card"><h3>📊 STATISTICS</h3><div class="stat"><span>Pairs:</span><span class="stat-value" id="totalPairs">0</span></div><div class="stat"><span>Nodes:</span><span class="stat-value" id="graphNodes">0</span></div><div class="stat"><span>Edges:</span><span class="stat-value" id="graphEdges">0</span></div><div class="stat"><span>Triangles:</span><span class="stat-value" id="triangleCount">0</span></div><div class="stat"><span>Opps:</span><span class="stat-value" id="oppCount">0</span></div><div class="stat"><span>WS Reconnects:</span><span class="stat-value" id="wsReconnects">0</span></div></div>
      <div class="card"><h3>🌍 NETWORK</h3><div id="playerList">No peers yet</div></div>
    </div>
    <div class="flex-row" style="background:#1a1a2a;padding:8px;border-radius:8px;margin:6px 0;"><span>💰 BANKROLL:</span><span class="rolling-number" id="bankroll">$10,000.00</span><span>📈 P/L:</span><span id="pnl">$0.00</span></div>
    <div class="flex-row" style="gap:6px;margin:4px 0;"><div><label>🎚️ BET:</label><input type="range" id="betSlider" min="100" max="10000" value="1000" oninput="syncBetInput()"><input type="number" id="betInput" value="1000" style="width:60px;" onchange="syncBetSlider()"></div><div><label>📐 DEPTH:</label><input type="range" id="pathSlider" min="3" max="10" value="5" oninput="UI.syncPathInput()"><input type="number" id="pathInput" value="5" style="width:35px;" onchange="UI.syncPathSlider()"></div><div><label>🧺 BASKET:</label><input type="text" id="basketInput" value="USDT,BTC,ETH,DOGE,SHIB,SOL"></div><div><label>🔁 MODE:</label><select id="arbMode"><option value="both">Both</option><option value="intra">Intra</option><option value="inter">Inter</option></select></div><div><label>🔑 PUMP:</label><input type="text" id="pumpToken"></div></div>
    <div style="margin:4px 0;"><div id="intraExCheckboxes" class="checkbox-group"></div><button onclick="selectAllIntra()" class="cyan">ALL</button><button onclick="deselectAllIntra()" class="cyan">NONE</button></div>
    <div class="card"><h3>💱 FIAT (Multi-source)</h3><div class="flex-row"><div class="checkbox-group" id="fiatCheckboxes"></div><button onclick="UI.logButton('FETCH RATES');fetchForexRates()" class="cyan">🔄 FETCH</button><span id="forexStatus"></span><span id="forexAutoStatus" style="font-size:7px;color:#888;"></span></div></div>
    <h2>⚡ EXCHANGES</h2><div class="grid" id="exchangeStatus"></div>
    <div class="grid"><div class="card"><h3>🔥 PICO</h3><div id="picoValue"></div></div><div class="card"><h3>⚡ FEMTO</h3><div id="femtoValue"></div></div><div class="card"><h3>💧 PLANCK</h3><div id="planckValue"></div></div></div>
    <h2>🎯 OPPORTUNITIES</h2>
    <div class="opp-section"><div class="opp-header" onclick="toggleSection('megaOpps')">🌟 MEGA >5% <span id="megaCount">0</span></div><div id="megaOpps" class="opp-list"></div></div>
    <div class="opp-section"><div class="opp-header" onclick="toggleSection('triangularOpps')">📐 TRIANGULAR <span id="triangularCount">0</span></div><div id="triangularOpps" class="opp-list"></div></div>
    <div class="opp-section"><div class="opp-header" onclick="toggleSection('bellmanOpps')">🔗 BELLMAN-FORD <span id="bellmanCount">0</span></div><div id="bellmanOpps" class="opp-list"></div></div>
    <div class="opp-section"><div class="opp-header" onclick="toggleSection('suspiciousOpps')">⚠️ SUSPICIOUS <span id="suspiciousCount">0</span></div><div id="suspiciousOpps" class="opp-list"></div></div>
    <div class="card"><h3>📒 TRADE LEDGER</h3><div id="tradeLedger"></div></div>
    <h2 onclick="toggleLogs()">📋 LOGS</h2><div class="log-container" id="logs"></div>
  </div>

  <!-- Modals -->
  <div id="tradeModal" class="modal"><div class="modal-content"><h3>🎰 EXECUTE</h3><div id="tradeDetails"></div><div class="math-breakdown" id="compoundingMath"></div><div id="rateWarning"></div><div id="conflictWarning"></div><button onclick="closeModal()">CANCEL</button><button class="cyan" id="executeTradeBtn">💸 PULL LEVER</button></div></div>
  <div id="createCoinModal" class="modal"><div class="modal-content"><h3>🪙 CREATE TOKEN</h3><div><label>Symbol:</label><input type="text" id="newCoinSymbol" placeholder="SYMBOL" style="width:80px;"><label>Quote:</label><select id="newCoinQuote"><option value="USDT">USDT</option><option value="USDC">USDC</option><option value="USD">USD</option><option value="GUSD">GUSD</option><option value="ETH">ETH</option><option value="SOL">SOL</option></select></div><div><label>Price ($):</label><input type="number" id="newCoinPrice" value="0.000001" step="0.000001" style="width:80px;"><label>Liquidity ($):</label><input type="number" id="newCoinLiq" value="500" step="100" style="width:70px;"></div><div style="margin-top:6px;"><label>Exchanges:</label><div id="coinExCheckboxes" class="checkbox-group"></div></div><div><small style="color:var(--cyan);">Paper: simulated DEX. Live: requires token deployment.</small></div><div id="coinCooldown" style="color:#ffaa00;font-size:8px;"></div><div style="margin-top:8px;"><button onclick="closeCreateCoinModal()">CANCEL</button><button id="createCoinBtn" class="cyan">MINT</button></div></div></div>
  <div id="pumpLaunchModal" class="modal"><div class="modal-content"><h3>🚀 LAUNCH ON PUMP.FUN (Testnet)</h3><div><label>Token Name:</label><input type="text" id="pumpTokenName" placeholder="My Token" style="width:150px;"><label>Symbol:</label><input type="text" id="pumpTokenSymbol" placeholder="TKN" style="width:80px;"></div><div><label>Description:</label><input type="text" id="pumpTokenDesc" placeholder="A meme coin" style="width:200px;"></div><div><label>Image URL:</label><input type="text" id="pumpTokenImage" placeholder="https://..." style="width:200px;"></div><div><label>Pump.fun API:</label><input type="text" id="pumpApiUrl" value="https://frontend-api.pump.fun" style="width:200px;"></div><div><small style="color:var(--cyan);">Launches a simulated token on Pump.fun (paper). Live would require wallet signature.</small></div><div style="margin-top:8px;"><button onclick="closePumpLaunchModal()">CANCEL</button><button id="pumpLaunchBtn" class="cyan">🚀 LAUNCH</button></div></div></div>
  <div id="apiKeysModal" class="modal"><div class="modal-content"><h3>🔑 API KEYS</h3><div id="apiKeyList" class="checkbox-group" style="flex-direction:column;align-items:flex-start;"></div><button onclick="saveApiKeysFromModal()" class="cyan">SAVE</button><button onclick="closeApiKeysModal()">CLOSE</button></div></div>

<script>
// ═══════════════════════════════════════════════════════════════
//  QUANTM FOAM v23.30 – Fixed: fiat toggle test + CoinGecko case
// ═══════════════════════════════════════════════════════════════

// ── Audio & Particles ──────────────────────────────────
const audioCtx = new(window.AudioContext || window.webkitAudioContext)();
function playTone(f,d,t='square',v=0.05){const o=audioCtx.createOscillator(),g=audioCtx.createGain();o.type=t;o.frequency.value=f;g.gain.setValueAtTime(v,audioCtx.currentTime);g.gain.exponentialRampToValueAtTime(0.001,audioCtx.currentTime+d);o.connect(g);g.connect(audioCtx.destination);o.start();o.stop(audioCtx.currentTime+d);}
function playSpin(){playTone(800,0.08,'sawtooth',0.04);}
function playWin(){playTone(523,0.08);setTimeout(()=>playTone(659,0.08),80);setTimeout(()=>playTone(784,0.15),160);}
const canvas = document.getElementById('particleCanvas'), ctx = canvas.getContext('2d');let particles=[];
function resize(){canvas.width=innerWidth;canvas.height=innerHeight;}
window.addEventListener('resize',resize);resize();
class Particle{constructor(x,y,vx,vy,c,l){this.x=x;this.y=y;this.vx=vx;this.vy=vy;this.color=c;this.life=l;}}
function anim(){ctx.clearRect(0,0,canvas.width,canvas.height);for(let i=particles.length-1;i>=0;i--){const p=particles[i];p.x+=p.vx;p.y+=p.vy;p.vy+=0.05;p.life-=0.012;ctx.fillStyle=p.color;ctx.globalAlpha=Math.max(0,p.life);ctx.fillRect(p.x,p.y,3,3);if(p.life<=0)particles.splice(i,1);}requestAnimationFrame(anim);}anim();
function confetti(x,y,n=25){const cols=['#ff00ff','#00ff00','#ffd700','#00f0ff'];for(let i=0;i<n;i++)particles.push(new Particle(x,y,(Math.random()-0.5)*7,(Math.random()-0.5)*6-3,cols[Math.floor(Math.random()*cols.length)],0.5+Math.random()*0.4));}

// ── Identity ─────────────────────────────────────────
let NODE_ID = localStorage.getItem('qfoam_nodeId');
if(!NODE_ID){NODE_ID='node_'+Math.random().toString(36).substr(2,9);localStorage.setItem('qfoam_nodeId',NODE_ID);}
let playerHandle=localStorage.getItem('qfoam_handle')||'Player';
document.getElementById('playerHandle').value=playerHandle;
function setPlayerHandle(){playerHandle=document.getElementById('playerHandle').value.trim()||'Player';localStorage.setItem('qfoam_handle',playerHandle);if(State.ymap)syncStateToYjs();}

function setUIScale(val){document.documentElement.style.setProperty('--base-font-size',val+'px');document.getElementById('uiScaleLabel').textContent=val+'px';localStorage.setItem('uiScale',val);}

const STORAGE_KEY='qfoam_v23_30';

// ── State ─────────────────────────────────────────────
const State={
  bankroll:10000,paperMatrix:0,liveMatrix:0,paperLevel:1,liveLevel:1,
  get matrix(){return this.liveMode?this.liveMatrix:this.paperMatrix;},
  set matrix(v){if(this.liveMode)this.liveMatrix=v;else this.paperMatrix=v;},
  get level(){return this.liveMode?this.liveLevel:this.paperLevel;},
  set level(v){if(this.liveMode)this.liveLevel=v;else this.paperLevel=v;},
  qFund:0,lFund:0,liveMode:false,liveTestMode:false,
  userCoins:[],exchanges:{},allPairs:[],graph:{},triangles:[],
  opportunities:{mega:[],triangular:[],bellman:[],suspicious:[]},
  stats:{totalPairs:0,graphNodes:0,graphEdges:0,triangleCount:0,wsBytes:0,oppCount:0,wsReconnects:0},
  selectedIntraExchanges:new Set(),selectedFiats:new Set(['RUB','INR','EUR','GBP']),
  liveScanInterval:null,liveScanActive:false,forexRates:{},forexInterval:null,
  wsTickers:{},wsConnections:{},tradeLedger:[],liveTradeHistory:[],
  proxyMode:'direct',customProxyUrl:'',execPath:'/execute',
  lastTradeExecTime:0,lastPullTime:0,lastCoinCreateTime:0,
  graphRenderer:null,purchasePower:{},highlightedPaths:[],conflictEdges:new Set(),
  basketHoldings:{},acquisitionPaths:{},batchHistory:[],coinExchangeList:['QUANTM_DEX'],
  operationLatency:[],testnetsActive:false,pauseLogs:false,logBuffer:[],apiKeys:{},coinLevels:{},
  ydoc:null,ymap:null,yPlayers:null,db:null,conn:null,torrentClient:null,
  mana:{compute:0,data:0,trade:0},otherPlayers:{},
  load(){try{const s=JSON.parse(localStorage.getItem(STORAGE_KEY));if(s){this.bankroll=s.bankroll||10000;this.paperMatrix=s.paperMatrix||0;this.liveMatrix=s.liveMatrix||0;this.paperLevel=s.paperLevel||1;this.liveLevel=s.liveLevel||1;this.liveMode=s.liveMode||false;this.liveTestMode=s.liveTestMode||false;this.userCoins=s.userCoins||[];this.selectedIntraExchanges=s.selectedIntraExchanges?new Set(s.selectedIntraExchanges):new Set();this.forexRates=s.forexRates||{};this.selectedFiats=s.selectedFiats?new Set(s.selectedFiats):new Set();this.tradeLedger=s.tradeLedger?s.tradeLedger.slice(-50):[];this.liveTradeHistory=s.liveTradeHistory?s.liveTradeHistory.slice(-20):[];this.proxyMode=s.proxyMode||'direct';this.customProxyUrl=s.customProxyUrl||'';this.execPath=s.execPath||'/execute';this.basketHoldings=s.basketHoldings||{};this.acquisitionPaths=s.acquisitionPaths||{};this.batchHistory=s.batchHistory?s.batchHistory.slice(-20):[];this.coinExchangeList=s.coinExchangeList||['QUANTM_DEX'];this.stats.wsReconnects=s.wsReconnects||0;this.lastCoinCreateTime=s.lastCoinCreateTime||0;this.operationLatency=s.operationLatency?s.operationLatency.slice(-10):[];this.testnetsActive=s.testnetsActive||false;this.apiKeys=s.apiKeys||{};this.coinLevels=s.coinLevels||{};}}catch(e){}document.getElementById('solAddress').value=localStorage.getItem('wallet_sol')||'';document.getElementById('ethAddress').value=localStorage.getItem('wallet_eth')||'';document.getElementById('pumpToken').value=localStorage.getItem('pumpfun_token')||'';document.getElementById('basketInput').value=localStorage.getItem('basket')||'USDT,BTC,ETH,DOGE,SHIB,SOL';document.getElementById('pathInput').value=localStorage.getItem('pathDepth')||5;document.getElementById('pathSlider').value=document.getElementById('pathInput').value;document.getElementById('liveToggle').checked=this.liveMode;document.getElementById('liveTestnetToggle').checked=this.liveTestMode;document.getElementById('liveTestnetToggle').style.display=this.liveMode?'inline-block':'none';document.getElementById('testnetLabel').style.display=this.liveMode?'inline':'none';document.getElementById('proxySelect').value=this.proxyMode;document.getElementById('corsProxyUrl').value=this.customProxyUrl;document.getElementById('execPath').value=this.execPath;document.getElementById('walletProxyUrl').value=localStorage.getItem('walletProxyUrl')||'';document.getElementById('targetAssetsInput').value=localStorage.getItem('targetAssets')||'';document.getElementById('testnetToggle').checked=this.testnetsActive;UI.updateProfile();UI.renderFiatCheckboxes();UI.onProxyChange();UI.renderTradeLedger();UI.renderLiveTrades();UI.renderCoinLevels();UI.applyLevelConstraints();updateIntraExCheckboxes();UI.renderBasketTracker();UI.renderBatchHistory();UI.updateDashboard();UI.renderLatency();},
  save(){localStorage.setItem(STORAGE_KEY,JSON.stringify({bankroll:this.bankroll,paperMatrix:this.paperMatrix,liveMatrix:this.liveMatrix,paperLevel:this.paperLevel,liveLevel:this.liveLevel,liveMode:this.liveMode,liveTestMode:this.liveTestMode,userCoins:this.userCoins,selectedIntraExchanges:[...this.selectedIntraExchanges],forexRates:this.forexRates,selectedFiats:[...this.selectedFiats],tradeLedger:this.tradeLedger.slice(-50),liveTradeHistory:this.liveTradeHistory.slice(-20),proxyMode:this.proxyMode,customProxyUrl:this.customProxyUrl,execPath:this.execPath,basketHoldings:this.basketHoldings,acquisitionPaths:this.acquisitionPaths,batchHistory:this.batchHistory.slice(-20),coinExchangeList:this.coinExchangeList,wsReconnects:this.stats.wsReconnects,lastCoinCreateTime:this.lastCoinCreateTime,operationLatency:this.operationLatency.slice(-10),testnetsActive:this.testnetsActive,apiKeys:this.apiKeys,coinLevels:this.coinLevels}));localStorage.setItem('wallet_sol',document.getElementById('solAddress').value);localStorage.setItem('wallet_eth',document.getElementById('ethAddress').value);localStorage.setItem('pumpfun_token',document.getElementById('pumpToken').value);localStorage.setItem('basket',document.getElementById('basketInput').value);localStorage.setItem('pathDepth',document.getElementById('pathInput').value);localStorage.setItem('walletProxyUrl',document.getElementById('walletProxyUrl').value);localStorage.setItem('targetAssets',document.getElementById('targetAssetsInput').value);},
  saveWallet(){this.save();},savePumpToken(){this.save();},
  addTradeToLedger(opp,size,netProfit){this.tradeLedger.unshift({time:new Date().toISOString(),path:opp.path.join(' → '),size,profit:netProfit,type:opp.type,live:this.liveMode,testnet:this.liveTestMode});if(this.tradeLedger.length>50)this.tradeLedger.length=50;this.save();UI.renderTradeLedger();UI.updateDashboard();},
  addLiveTrade(opp,size,netProfit,txHash){this.liveTradeHistory.unshift({time:new Date().toISOString(),path:opp.path.join(' → '),size,profit:netProfit,txHash,status:'confirmed',testnet:this.liveTestMode});if(this.liveTradeHistory.length>20)this.liveTradeHistory.length=20;this.save();UI.renderLiveTrades();},
  recordBasketPurchase(asset,amount,pathDescription){if(!this.basketHoldings[asset])this.basketHoldings[asset]=0;this.basketHoldings[asset]+=amount;if(!this.acquisitionPaths[asset])this.acquisitionPaths[asset]=[];this.acquisitionPaths[asset].push({amount,path:pathDescription||'unknown',time:new Date().toISOString()});this.save();UI.renderBasketTracker();},
  addBatchHistory(entry){this.batchHistory.unshift(entry);if(this.batchHistory.length>20)this.batchHistory.length=20;this.save();UI.renderBatchHistory();UI.updateDashboard();},
  getAssetPrice(asset){const stableTargets=['USDT','USD','USDC','GUSD','BUSD'];for(const t of stableTargets){const pair=this.allPairs.find(p=>p.base===asset&&p.target===t);if(pair)return pair.bidPrice||pair.price*0.999;}const anyPair=this.allPairs.find(p=>p.base===asset);if(anyPair){const price=anyPair.bidPrice||anyPair.price*0.999;if(!stableTargets.includes(anyPair.target)){const tp=this.getAssetPrice(anyPair.target);if(tp>0)return price*tp;}return price;}return 0;},
  computePurchasePower(){this.purchasePower={};if(this.bankroll<=0)return;const prices={};for(const pair of this.allPairs){if(!pair.base||!pair.target)continue;const ask=pair.askPrice||pair.price*1.001;if(!prices[pair.base]||ask<prices[pair.base])prices[pair.base]=ask;}for(const[asset,price]of Object.entries(prices)){if(price>0)this.purchasePower[asset]=this.bankroll/price;}for(const stable of['USDT','USD','USDC','GUSD','BUSD']){if(!this.purchasePower[stable])this.purchasePower[stable]=this.bankroll;}},
  getTargetAssets(){const raw=document.getElementById('targetAssetsInput')?.value.trim();if(raw)return raw.split(',').map(s=>s.trim().toUpperCase()).filter(Boolean);return document.getElementById('basketInput').value.split(',').map(s=>s.trim().toUpperCase()).filter(Boolean);},
  validateEdge(edge){return edge&&edge.rate>0&&edge.rate<1e6&&isFinite(edge.rate);},
  validateCycle(edges){let p=1;for(const e of edges){if(!this.validateEdge(e))return false;p*=e.rate;}return p>0.5&&p<100;},
  getMaxCoinExchanges(){return Math.min(1+Math.floor(this.level/3),8);},
  getCoinCooldown(){if(this.level<5)return Infinity;return Math.max(60,300-(this.level-5)*30);},
  getPullCooldown(){if(this.level<=3)return 15000;if(this.level<=6)return 12000;if(this.level<=9)return 9000;return 6000;},
  getLiveScanInterval(){if(this.level<2)return 60000;if(this.level<5)return 45000;if(this.level<8)return 30000;if(this.level<10)return 15000;return 10000;},
  startAutoForex(){if(this.forexInterval)clearInterval(this.forexInterval);if(this.level>=3&&this.selectedFiats.size>0){document.getElementById('forexAutoStatus').textContent='🔄 Auto (5min)';this.forexInterval=setInterval(()=>{if(!document.getElementById('scanBtn').disabled)fetchForexRates();},300000);}else{document.getElementById('forexAutoStatus').textContent='';}},
  allocateIndexFund(profit){const pct=parseFloat(document.getElementById('indexFundPercent')?.value||5)/100;if(pct<=0||profit<=0||this.userCoins.length===0)return;const amount=profit*pct;if(amount<=0||this.bankroll<amount)return;this.bankroll-=amount;const totalWeight=this.userCoins.reduce((sum,c)=>sum+(this.coinLevels[c.symbol]||1),0);let r=Math.random()*totalWeight;for(const coin of this.userCoins){const w=this.coinLevels[coin.symbol]||1;r-=w;if(r<=0){const price=this.getAssetPrice(coin.symbol);if(price>0){const qty=amount/price;this.recordBasketPurchase(coin.symbol,qty,'Index Fund (weighted)');}return;}}},
  addCoinXP(symbol,xp){if(!this.coinLevels[symbol])this.coinLevels[symbol]=1;this.coinLevels[symbol]+=xp;this.save();UI.renderCoinLevels();}
};

// ── Logging & helpers ────────────────────────────────
function log(msg,type='info'){const t=new Date().toLocaleTimeString();const el=document.getElementById('logs');if(!el)return;const c=type==='error'?'#ff4444':type==='success'?'var(--green)':'inherit';const entry=`<div style="color:${c}">[${t}] ${msg}</div>`;if(State.pauseLogs){State.logBuffer.push(entry);if(State.logBuffer.length>50)State.logBuffer.shift();}else{while(State.logBuffer.length>0){el.innerHTML=State.logBuffer.shift()+el.innerHTML;}el.innerHTML=entry+el.innerHTML;}}
function toggleLogs(){const e=document.getElementById('logs');e.style.display=e.style.display==='none'?'block':'none';}
function toggleSection(id){const e=document.getElementById(id);e.style.display=e.style.display==='none'?'block':'none';}
function toggleTestnets(){State.testnetsActive=document.getElementById('testnetToggle').checked;rebuildExchangeDefinitions();State.save();log(`🖱️ Testnets: ${State.testnetsActive?'ON':'OFF'}`);}
let logsPaused=false;
function togglePauseLogs(){logsPaused=document.getElementById('pauseLogsToggle').checked;log(`🖱️ Pause Logs: ${logsPaused?'ON':'OFF'}`);}

// ── Network / Proxy ───────────────────────────────────
const CORS_OK_EXCHANGES=new Set(['okx','coinbase','binance','kucoin','gemini','bitstamp','kraken','dexscreener_eth','dexscreener_bsc','dexscreener_polygon','dexscreener_arb','dexscreener_sol','coingecko','coinpaprika','coinlore']);
const BUILTIN_PROXIES=['https://corsproxy.io/?','https://api.allorigins.win/raw?url='];let currentProxyIndex=0;
function getEffectiveProxyUrl(){if(State.proxyMode==='custom'){const c=(document.getElementById('corsProxyUrl').value||'').trim();if(c&&!c.includes('placeholder'))return c;return null;}if(State.proxyMode==='builtin')return BUILTIN_PROXIES[currentProxyIndex];return null;}
function rotateProxy(){currentProxyIndex=(currentProxyIndex+1)%BUILTIN_PROXIES.length;UI.updateProxyStatus();}
async function smartFetch(url,options={},isCorsSafe=false){if(isCorsSafe||State.proxyMode==='direct'){try{const r=await fetch(url,options);if(r.ok)return r;if(r.status>=400)throw new Error('HTTP '+r.status);}catch(e){}}const proxy=getEffectiveProxyUrl();if(proxy){try{const r=await fetch(proxy+encodeURIComponent(url),options);if(!r.ok)throw new Error('Proxy HTTP '+r.status);const text=await r.text();if(text.startsWith('<')||text.includes('corsdemo'))throw new Error('Non-JSON');try{return new Response(JSON.stringify(JSON.parse(text)),{status:200,headers:{'Content-Type':'application/json'}});}catch{return new Response(text,{status:200,headers:{'Content-Type':'text/plain'}});}}catch(e){rotateProxy();}}throw new Error('All fetch attempts exhausted');}

// ── Exchange definitions ──────────────────────────────
const KNOWN_QUOTES=['USDT','USDC','BUSD','GUSD','USD','BTC','ETH','BNB','SOL','EUR','GBP','JPY','KRW','AUD','CAD','CHF','RUB','INR','TRY','BRL','IDR','DAI','SGD','PLN','UAH','AED','BETH','ZEC','ZRX','RAY','STRK','MATIC','DOT','TRB','TON','PI','LTC','XRP','SHIB','DOGE','BONK','PEPE','FLOKI','WIN','SATS','NEIRO','CAT','DUCK','BOME','OMI','DEGEN','NOT','MEME','TOSHI','MEW','HMSTR','XCHNG','WBNB','RNDR','LINK','JITOSOL','LINEA','HYPE','PNUT','POL','TRUMP','POPCAT','CTX','JUP','GALA','FTM','FET','SAND','GRT','CRV','LTC','XTZ','SUI','XCH','AVAX','WIF','UNI','FIL','STX','OP','TON','LINK','LPT','ENS','WLFI','ZEC','PENGU','APE','GOAT','MOODENG','MANA','INJ','ATOM','AAVE','TRX','SKY','CHZ','SEI','ZETA','ARB','XDC','BONK','PEPE','SHIB','FLR','VIRTUAL','NEAR','ADA','HBAR','API3','STORJ','IMX','LDO','MON','BCH','PUMP','MASK','OFC','COMP','JUP','DOT','USDG','BAT','BABYDOGE','ALGO','RLUSD','TRAC','SKL','CTSI','MEW','CXT','PYTH','KITE','DIRT','WOW','ARRR','TRON','MEME'];
KNOWN_QUOTES.sort((a,b)=>b.length-a.length);
function parsePairSymbol(rawSymbol){const s=(rawSymbol||'').toUpperCase().replace(/[^A-Z0-9]/g,'');if(!s)return null;for(const q of KNOWN_QUOTES){if(s.endsWith(q)&&s.length>q.length){const b=s.slice(0,s.length-q.length);if(b.length>=1&&b!==q)return{base:b,target:q};}}const p=s.split(/[_-]/);if(p.length>=2)return{base:p[0],target:p.slice(1).join('_')};return null;}
const exchangeDefs=[{key:'okx',name:'OKX',url:'https://www.okx.com/api/v5/market/tickers?instType=SPOT',parser:'okx'},{key:'coinbase',name:'Coinbase',url:'https://api.exchange.coinbase.com/products',parser:'coinbase'},{key:'binance',name:'Binance',url:'https://api.binance.com/api/v3/ticker/24hr',parser:'binance'},{key:'kucoin',name:'KuCoin',url:'https://api.kucoin.com/api/v1/market/allTickers',parser:'kucoin'},{key:'bybit',name:'Bybit',url:'https://api.bybit.com/v5/market/tickers?category=spot',parser:'bybit'},{key:'gate',name:'Gate.io',url:'https://api.gateio.ws/api/v4/spot/tickers',parser:'gate'},{key:'mexc',name:'MEXC',url:'https://api.mexc.com/api/v3/ticker/24hr',parser:'mexc'},{key:'kraken',name:'Kraken',url:'https://api.kraken.com/0/public/Ticker?pair=ALL',parser:'kraken'},{key:'bitstamp',name:'Bitstamp',url:'https://www.bitstamp.net/api/v2/ticker/',parser:'bitstamp'},{key:'indodax',name:'Indodax',url:'https://indodax.com/api/tickers',parser:'indodax'},{key:'yobit',name:'Yobit',url:'https://yobit.net/api/3/info',parser:'yobit'},{key:'pumpfun',name:'Pump.fun',url:'https://frontend-api.pump.fun/coins?offset=0&limit=100&sort=created_timestamp&order=DESC',parser:'pumpfun',auth:true},{key:'poloniex',name:'Poloniex',url:'https://api.poloniex.com/markets/ticker24h',parser:'poloniex'},{key:'huobi',name:'Huobi',url:'https://api.huobi.pro/market/tickers',parser:'huobi'},{key:'gemini',name:'Gemini',url:'https://api.gemini.com/v1/pricefeed',parser:'gemini'},{key:'ascendex',name:'AscendEX',url:'https://ascendex.com/api/pro/v1/ticker',parser:'ascendex'},{key:'digifinex',name:'Digifinex',url:'https://openapi.digifinex.com/v3/ticker',parser:'digifinex'},{key:'bittrex',name:'Bittrex',url:'https://api.bittrex.com/v3/markets/tickers',parser:'bittrex'},{key:'crypto.com',name:'Crypto.com',url:'https://api.crypto.com/v2/public/get-ticker',parser:'cryptocom'},{key:'dexscreener_eth',name:'DexScreener ETH',url:'https://api.dexscreener.com/latest/dex/search?q=ETH',parser:'dexscreener'},{key:'dexscreener_bsc',name:'DexScreener BSC',url:'https://api.dexscreener.com/latest/dex/search?q=BNB',parser:'dexscreener'},{key:'dexscreener_polygon',name:'DexScreener Polygon',url:'https://api.dexscreener.com/latest/dex/search?q=MATIC',parser:'dexscreener'},{key:'dexscreener_arb',name:'DexScreener Arbitrum',url:'https://api.dexscreener.com/latest/dex/search?q=ARB',parser:'dexscreener'},{key:'dexscreener_sol',name:'DexScreener Solana',url:'https://api.dexscreener.com/latest/dex/search?q=SOL',parser:'dexscreener'},{key:'dexscreener_uni',name:'Uniswap V2 (DexScreener)',url:'https://api.dexscreener.com/latest/dex/search?q=UNI',parser:'dexscreener'},{key:'coingecko',name:'CoinGecko',url:'https://api.coingecko.com/api/v3/coins/markets?vs_currency=usd&order=market_cap_desc&per_page=250&page=1',parser:'coingecko'},{key:'coinlore',name:'CoinLore',url:'https://api.coinlore.net/api/tickers/',parser:'coinlore'},{key:'coinpaprika',name:'CoinPaprika',url:'https://api.coinpaprika.com/v1/tickers',parser:'coinpaprika'},{key:'coincap',name:'CoinCap',url:'https://api.coincap.io/v2/assets?limit=100',parser:'coincap'}];
const testnetExchangeDefs=[{key:'binance_test',name:'Binance Testnet',url:'https://testnet.binance.vision/api/v3/ticker/24hr',parser:'binance'},{key:'okx_demo',name:'OKX Demo',url:'https://www.okx.com/api/v5/market/tickers?instType=SPOT',parser:'okx'},{key:'uniswap_sepolia',name:'Uniswap Sepolia',url:'https://api.thegraph.com/subgraphs/name/uniswap/uniswap-v3-sepolia',parser:'dexscreener'},{key:'pancake_test',name:'PancakeSwap Testnet',url:'https://pancake.kiemtienonline360.com/api/v1/ticker/24hr',parser:'binance'},{key:'sushi_test',name:'SushiSwap Testnet',url:'https://raw.githubusercontent.com/sushiswap/...',parser:'dexscreener'}];
function rebuildExchangeDefinitions(){exchangeDefs.forEach(d=>{State.exchanges[d.key]={name:d.name,status:'offline',pairs:[],url:d.url,parser:d.parser,auth:d.auth||false,wsStatus:'off'};});if(State.testnetsActive){testnetExchangeDefs.forEach(d=>{State.exchanges[d.key]={name:d.name,status:'offline',pairs:[],url:d.url,parser:d.parser,auth:d.auth||false,wsStatus:'off'};});}}

// ── Forex (FIXED: CoinGecko lowercase keys + success check) ──
async function fetchForexRates(){
  const f=[...State.selectedFiats];if(!f.length){log('No fiats selected','warning');return;}
  let success=false;
  // Try Frankfurter (keys are uppercase)
  try{const r=await smartFetch('https://api.frankfurter.app/latest?from=USD',{},true);const d=await r.json();if(d.rates){State.forexRates={};for(const cur of f){if(d.rates[cur])State.forexRates[cur]=1/d.rates[cur];}success=Object.keys(State.forexRates).length>0;if(success){document.getElementById('forexStatus').textContent=`✅ ${Object.keys(State.forexRates).length} rates (Frankfurter)`;log(`Forex: ${Object.keys(State.forexRates).length} from Frankfurter`,'success');}}}catch(e){log('Frankfurter failed, trying CoinGecko…','warning');}
  // Try CoinGecko (FIXED: keys are lowercase)
  if(!success){
    try{const url=`https://api.coingecko.com/api/v3/simple/price?ids=bitcoin&vs_currencies=usd,${f.join(',').toLowerCase()}`;const r=await smartFetch(url,{},true);const d=await r.json();if(d.bitcoin?.usd){const bu=d.bitcoin.usd;State.forexRates={};for(const cur of f){const lc=cur.toLowerCase();if(d.bitcoin[lc])State.forexRates[cur]=bu/d.bitcoin[lc];}success=Object.keys(State.forexRates).length>0;if(success){document.getElementById('forexStatus').textContent=`✅ ${Object.keys(State.forexRates).length} rates (CoinGecko)`;log(`Forex: ${Object.keys(State.forexRates).length} from CoinGecko`,'success');}}}catch(e){log('CoinGecko failed, using cache','error');}
  }
  if(!success){const fb={RUB:0.012,INR:0.012,EUR:1.08,GBP:1.26,JPY:0.0067,CNY:0.14,KRW:0.00076,AUD:0.64,CAD:0.73,CHF:1.12,AED:0.27,TRY:0.032,BRL:0.18,SGD:0.74,PLN:0.23};State.forexRates={};for(const cur of f){if(fb[cur])State.forexRates[cur]=fb[cur];}document.getElementById('forexStatus').textContent=`✅ ${Object.keys(State.forexRates).length} (cached)`;}
  State.save();displayLowValue();
}

