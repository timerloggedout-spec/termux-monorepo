// utils/sync.js
import { batchUpdateCompounds } from '../services/api';

export async function syncCompoundsToSheet(compounds) {
  try {
    const result = await batchUpdateCompounds(compounds);
    console.log(`Synced ${result.count} compounds to Google Sheets`);
    return result;
  } catch (error) {
    console.error('Sync failed:', error);
    throw error;
  }
}
