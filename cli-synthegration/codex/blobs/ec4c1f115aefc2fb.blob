graph TD
    subgraph Admin["DevOps & Admin (Push Updates)"]
        Dev[Dev Team] -->|IPNS Publish| IPNS[Mutable App Pointer]
        AdminKey[Admin Keypair] --> IPNS
    end

    subgraph DataIngestion["Data Ingestion & Normalization"]
        CEX["Centralized Exchanges<br/>(Binance, Coinbase)"] -->|WebSocket| Adapter
        DEX["Decentralized Exchanges<br/>(Uniswap v3, Sushi)"] -->|RPC/GraphQL| Adapter
        Adapter["Exchange Adapters<br/>(Normalize to Common Schema)"] --> Validator[Validator / Relay Node]
    end

    subgraph P2PLayer["P2P Data Distribution"]
        Validator -->|GossipSub Publish| Mesh((GossipSub Mesh))
        Seed[Admin Seeds Torrent] -->|Magnet Link| TorrentSwarm((WebTorrent Swarm))

        subgraph Peers["Browser Peers"]
            P1[Peer 1] <-->|GossipSub| Mesh
            P2[Peer 2] <-->|GossipSub| Mesh
            P3[Peer N] <-->|GossipSub| Mesh
            P1 <-->|WebTorrent| TorrentSwarm
            P2 <-->|WebTorrent| TorrentSwarm
            P3 <-->|WebTorrent| TorrentSwarm
            P1 <-->|y-webrtc| P2
            P2 <-->|y-webrtc| P3
            P3 <-->|y-webrtc| P1
        end
    end

    subgraph Client["Browser Client (Full Node)"]
        MarketSub[Market Feed Subscriber] --> RingBuf[Ring Buffer / μts] --> DuckDB[DuckDB-Wasm]
        TorrentClient[Torrent Client] --> DuckDB
        YjsDoc[Yjs CRDT Doc] --> IDB[IndexedDB Persistence]
        Workers[Web Workers] --> Compute[Arbitrage & Portfolio Optimization]
        Backtest[Backtest Engine] --> DuckDB & YjsDoc
        UI[React / Vue UI] --> DuckDB & YjsDoc & Compute
    end
