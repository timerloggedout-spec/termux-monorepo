import React, { useState, useEffect } from 'react';
import { Search, MapPin, ExternalLink } from 'lucide-react';

export default function ClinicalTrialsTab({ initialQuery = '', countryFilter = null }) {
  const [query, setQuery] = useState(initialQuery);
  const [country, setCountry] = useState(countryFilter);
  const [trials, setTrials] = useState([]);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState(null);

  useEffect(() => {
    if (initialQuery) setQuery(initialQuery);
  }, [initialQuery]);

  useEffect(() => {
    if (countryFilter) setCountry(countryFilter);
  }, [countryFilter]);

  const searchTrials = async (e) => {
    if (e) e.preventDefault();
    if (!query.trim() && !country) return;
    
    setLoading(true);
    setError(null);
    try {
      let searchTerm = query.trim();
      if (country && country.trim()) {
        searchTerm += ` AND ${country.trim()}`;
      }
      const url = `https://clinicaltrials.gov/api/v2/studies?query.term=${encodeURIComponent(searchTerm)}&pageSize=30`;
      const res = await fetch(url);
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data = await res.json();
      setTrials(data.studies || []);
    } catch (err) {
      setError(err.message);
      setTrials([]);
    } finally {
      setLoading(false);
    }
  };

  return (
    <div className="space-y-6">
      <form onSubmit={searchTrials} className="bg-white dark:bg-gray-800 p-6 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700">
        <div className="flex flex-col md:flex-row gap-4">
          <div className="flex-1">
            <label className="block text-sm font-medium mb-1">Condition / Intervention</label>
            <div className="relative">
              <Search className="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 w-5 h-5" />
              <input
                type="text"
                value={query}
                onChange={(e) => setQuery(e.target.value)}
                placeholder="e.g., semaglutide, gene therapy"
                className="w-full pl-10 pr-4 py-2 rounded-lg border dark:bg-gray-900 dark:border-gray-700"
              />
            </div>
          </div>
          <div className="flex-1">
            <label className="block text-sm font-medium mb-1">Country (optional)</label>
            <div className="relative">
              <MapPin className="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 w-5 h-5" />
              <input
                type="text"
                value={country || ''}
                onChange={(e) => setCountry(e.target.value)}
                placeholder="e.g., United States, Japan"
                className="w-full pl-10 pr-4 py-2 rounded-lg border dark:bg-gray-900 dark:border-gray-700"
              />
            </div>
          </div>
          <div className="self-end">
            <button
              type="submit"
              disabled={loading}
              className="px-6 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 disabled:opacity-50"
            >
              {loading ? 'Searching...' : 'Search Trials'}
            </button>
          </div>
        </div>
      </form>

      {error && (
        <div className="bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg p-4 text-red-700 dark:text-red-300">
          Error: {error}
        </div>
      )}

      <div className="space-y-4">
        {trials.map((study) => {
          const protocol = study.protocolSection;
          const id = protocol?.identificationModule;
          const status = protocol?.statusModule;
          const locations = protocol?.contactsLocationsModule?.locations || [];
          const countries = [...new Set(locations.map(l => l.country).filter(Boolean))];
          return (
            <div key={id?.nctId} className="bg-white dark:bg-gray-800 p-6 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700">
              <div className="flex justify-between items-start flex-wrap gap-2">
                <h3 className="font-bold text-lg text-gray-900 dark:text-white">{id?.briefTitle || id?.officialTitle || 'Untitled'}</h3>
                <span className="px-2 py-1 bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-300 text-xs rounded-full">
                  {status?.overallStatus}
                </span>
              </div>
              <p className="text-sm text-gray-500 mt-1">NCT ID: {id?.nctId}</p>
              {countries.length > 0 && (
                <p className="text-sm text-gray-500">Countries: {countries.join(', ')}</p>
              )}
              <div className="mt-3 grid grid-cols-1 md:grid-cols-2 gap-2 text-sm">
                <div><span className="font-medium">Sponsor:</span> {protocol?.sponsorCollaboratorsModule?.leadSponsor?.name || '—'}</div>
                <div><span className="font-medium">Phase:</span> {protocol?.designModule?.phases?.join(', ') || '—'}</div>
              </div>
              {protocol?.conditionsModule?.conditions?.length > 0 && (
                <div className="mt-2 text-sm"><span className="font-medium">Conditions:</span> {protocol.conditionsModule.conditions.join(', ')}</div>
              )}
              <div className="mt-3">
                <a
                  href={`https://clinicaltrials.gov/ct2/show/${id?.nctId}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  className="text-indigo-600 hover:underline text-sm inline-flex items-center"
                >
                  View on ClinicalTrials.gov <ExternalLink className="w-3 h-3 ml-1" />
                </a>
              </div>
            </div>
          );
        })}
        {!loading && trials.length === 0 && !error && (
          <div className="text-center text-gray-500 dark:text-gray-400 py-12">
            No trials found. Try a different search term.
          </div>
        )}
      </div>
    </div>
  );
}
