<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>Global Regulatory Intelligence</title>
  <!-- Fonts & Styles -->
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=JetBrains+Mono:wght@400;500;600&family=Outfit:wght@300;400;500;600&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <script src="https://cdn.jsdelivr.net/npm/react@18.2.0/umd/react.production.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/react-dom@18.2.0/umd/react-dom.production.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/react-simple-maps@3/dist/react-simple-maps.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/papaparse@5.4.1/papaparse.min.js"></script>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { background: #080c14; color: #e2e8f0; font-family: 'Outfit', sans-serif; }
    ::-webkit-scrollbar { width: 4px; height: 4px; }
    ::-webkit-scrollbar-track { background: #0f1724; }
    ::-webkit-scrollbar-thumb { background: #2d4a6e; border-radius: 2px; }
    .spin { animation: spin 1s linear infinite; }
    @keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
    .slide-in { animation: slideIn .25s ease-out; }
    @keyframes slideIn { from { transform: translateX(20px); opacity: 0; } to { transform: translateX(0); opacity: 1; } }
    .sidebar-mobile { transform: translateX(-100%); transition: transform 0.3s ease; }
    .sidebar-mobile.open { transform: translateX(0); }
    .detail-panel { transform: translateX(100%); transition: transform 0.3s ease; }
    .detail-panel.open { transform: translateX(0); }
  </style>
</head>
<body class="bg-[#080c14] text-[#e2e8f0]">
  <div id="root"></div>
  <script type="text/babel">
    const { useState, useEffect, useRef, useCallback } = React;
    const { ComposableMap, Geographies, Geography, ZoomableGroup } = window.ReactSimpleMaps;

    // ================= CONFIG =================
    const API_URL = 'YOUR_APPS_SCRIPT_URL'; // <-- REPLACE THIS
    const GEO_URL = 'https://cdn.jsdelivr.net/npm/world-atlas@2/countries-110m.json';
    const ISO_COUNTRIES_URL = 'https://raw.githubusercontent.com/stefangabos/world_countries/master/data/countries/en/world.json';

    // --- Regulatory Tier Map (WLA/ICH) ---
    // SOURCES:
    // WLA: WHO Listed Authorities (e.g., FDA, EMA, MHRA, PMDA, HSA, MFDS, Health Canada, Swissmedic, TGA)[reference:0][reference:1][reference:2]
    // ICH: ICH Members (e.g., US, EU, JP, CA, CH, CN, KR, BR, MX, IN, SA, ZA, NG, etc.)[reference:3][reference:4]
    const REGULATORY_TIER_MAP = {
      // WHO Listed Authorities (WLA) - Highest Tier
      'USA': { tier: 'wla', name: 'FDA' },
      'CAN': { tier: 'wla', name: 'Health Canada' },
      'GBR': { tier: 'wla', name: 'MHRA' },
      'JPN': { tier: 'wla', name: 'PMDA' },
      'KOR': { tier: 'wla', name: 'MFDS' },
      'SGP': { tier: 'wla', name: 'HSA' },
      'ZAF': { tier: 'wla', name: 'SAHPRA' },
      'CHE': { tier: 'wla', name: 'Swissmedic' },
      'AUS': { tier: 'wla', name: 'TGA' },
      // ICH Members (Non-WLA) - Secondary Tier
      'MEX': { tier: 'ich', name: 'COFEPRIS' },
      'MYS': { tier: 'ich', name: 'NPRA' },
      'IDN': { tier: 'ich', name: 'BPOM' },
      'CHN': { tier: 'ich', name: 'NMPA' },
      'IND': { tier: 'ich', name: 'CDSCO' },
      'BRA': { tier: 'ich', name: 'ANVISA' },
      'SAU': { tier: 'ich', name: 'SFDA' },
      'NGA': { tier: 'ich', name: 'NAFDAC' },
      // EU member states (WLA via EMA network)[reference:5]
      'FRA': { tier: 'wla', name: 'ANSM' }, 'DEU': { tier: 'wla', name: 'BfArM/PEI' },
      'ITA': { tier: 'wla', name: 'AIFA' }, 'ESP': { tier: 'wla', name: 'AEMPS' },
      'NLD': { tier: 'wla', name: 'MEB' }, 'BEL': { tier: 'wla', name: 'FAGG' },
      'SWE': { tier: 'wla', name: 'MPA' }, 'AUT': { tier: 'wla', name: 'AGES' },
      'DNK': { tier: 'wla', name: 'DKMA' }, 'FIN': { tier: 'wla', name: 'Fimea' },
      'IRL': { tier: 'wla', name: 'HPRA' }, 'PRT': { tier: 'wla', name: 'INFARMED' },
      'GRC': { tier: 'wla', name: 'EOF' }, 'CZE': { tier: 'wla', name: 'SUKL' },
      'HUN': { tier: 'wla', name: 'OGYEI' }, 'POL': { tier: 'wla', name: 'URPL' },
      'ROU': { tier: 'wla', name: 'ANMDMR' }, 'BGR': { tier: 'wla', name: 'BDA' },
      'SVK': { tier: 'wla', name: 'SUKL' }, 'SVN': { tier: 'wla', name: 'JAZMP' },
      'HRV': { tier: 'wla', name: 'HALMED' }, 'LTU': { tier: 'wla', name: 'VVKT' },
      'LVA': { tier: 'wla', name: 'ZVA' }, 'EST': { tier: 'wla', name: 'SAM' },
      'CYP': { tier: 'wla', name: 'CyPHS' }, 'MLT': { tier: 'wla', name: 'MMA' },
      'LUX': { tier: 'wla', name: 'MS' }, 'ISL': { tier: 'wla', name: 'IMA' },
      'NOR': { tier: 'wla', name: 'NoMA' }, 'LIE': { tier: 'wla', name: 'AKWL' }
    };
    const DEFAULT_TIER = { tier: 'unknown', name: 'National Regulatory Authority' };

    const statusColors = {
      approved: '#22c55e', investigational: '#3b82f6', unapproved: '#ef4444', withdrawn: '#f59e0b',
      under_review: '#a78bfa', harmonised: '#818cf8', unknown: '#64748b'
    };
    const wadaColor = { prohibited: '#ef4444', permitted: '#22c55e', unknown: '#64748b' };
    const JURISDICTIONS = ['US','EU','CA','AU','UK','JP','RU'];

    // ================= HELPER COMPONENTS (styled inline per v2) =================
    const Badge = ({ color, bg, children, small }) => (
      <span style={{
        background: bg || color + '22', color, border: `1px solid ${color}44`,
        borderRadius: 4, padding: small ? '1px 6px' : '2px 8px',
        fontSize: small ? 10 : 11, fontFamily: "'JetBrains Mono', monospace",
        fontWeight: 600, whiteSpace: 'nowrap', letterSpacing: 0.5
      }}>{children}</span>
    );

    const JurisCell = ({ status, access }) => {
      const s = statusColors[status] || '#64748b';
      const bgMap = { prescription_only:'#1a3a2a', clinical_trial_only:'#1a2a3a', pharmacy_compounded:'#2a2a1a', prohibited:'#3a1a1a', not_marketed:'#1a1a2a', unknown:'#1a1a1a' };
      const labelMap = { prescription_only:'Rx Only', clinical_trial_only:'Trial Only', pharmacy_compounded:'Compounding', prohibited:'Prohibited', not_marketed:'Not Marketed', unknown:'Unknown' };
      const textMap = { prescription_only:'#86efac', clinical_trial_only:'#93c5fd', pharmacy_compounded:'#fde68a', prohibited:'#fca5a5', not_marketed:'#94a3b8', unknown:'#64748b' };
      const bg = bgMap[access] || '#1a1a1a';
      const tc = textMap[access] || '#94a3b8';
      const lb = labelMap[access] || '—';
      return (
        <div style={{ background: bg, border: `1px solid ${s}44`, borderRadius: 6, padding: '4px 6px', minWidth: 80, textAlign: 'center' }}>
          <div style={{ color: s, fontSize: 10, fontFamily: "'JetBrains Mono', monospace", fontWeight: 600, textTransform: 'uppercase', letterSpacing: 0.5 }}>{status}</div>
          <div style={{ color: tc, fontSize: 9, marginTop: 1 }}>{lb}</div>
        </div>
      );
    };

    const RiskChip = ({ level }) => {
      const map = { approved:{c:'#22c55e',l:'Approved'}, phase_3:{c:'#8b5cf6',l:'Phase 3'}, phase_2:{c:'#a78bfa',l:'Phase 2'}, withdrawn:{c:'#f59e0b',l:'Withdrawn'}, unapproved:{c:'#ef4444',l:'No Approval'}, preclinical:{c:'#f97316',l:'Preclinical'} };
      const m = map[level] || {c:'#64748b',l:'Unknown'};
      return <Badge color={m.c}>{m.l}</Badge>;
    };

    const SectionBlock = ({ title, children, accent = '#3b82f6' }) => (
      <div style={{ marginBottom: 16 }}>
        <div style={{ color: accent, fontSize: 10, fontFamily: "'JetBrains Mono', monospace", fontWeight: 600, letterSpacing: 1.5, textTransform: 'uppercase', borderBottom: `1px solid ${accent}33`, paddingBottom: 4, marginBottom: 8 }}>{title}</div>
        <div style={{ color: '#cbd5e1', fontSize: 13, lineHeight: 1.6 }}>{children}</div>
      </div>
    );

    // ================= MAIN APP =================
    function App() {
      const [compounds, setCompounds] = useState([]);
      const [loading, setLoading] = useState(true);
      const [search, setSearch] = useState('');
      const [filterType, setFilterType] = useState('all');
      const [filterWADA, setFilterWADA] = useState('all');
      const [filterUS, setFilterUS] = useState('all');
      const [selected, setSelected] = useState(null);
      const [activeTab, setActiveTab] = useState('matrix');
      const [mobileMenuOpen, setMobileMenuOpen] = useState(false);
      const [trialsData, setTrialsData] = useState([]);
      const [rorData, setRorData] = useState([]);
      const [trialsLoading, setTrialsLoading] = useState(false);
      const [rorLoading, setRorLoading] = useState(false);
      const [countryMap, setCountryMap] = useState({});
      const [countryList, setCountryList] = useState([]);
      const panelRef = useRef(null);

      // Fetch compounds and country data
      useEffect(() => {
        const fetchData = async () => {
          try {
            const [compRes, countryRes] = await Promise.all([
              fetch(API_URL),
              fetch(ISO_COUNTRIES_URL)
            ]);
            const compData = await compRes.json();
            const countryData = await countryRes.json();
            
            // Build dynamic jurisdiction mapping
            const newMap = {};
            countryData.forEach(c => {
              const iso3 = c.alpha3.toUpperCase();
              // Assign jurisdiction key
              if (iso3 === 'USA') newMap[iso3] = 'us';
              else if (iso3 === 'CAN') newMap[iso3] = 'ca';
              else if (iso3 === 'GBR') newMap[iso3] = 'uk';
              else if (iso3 === 'AUS') newMap[iso3] = 'au';
              else if (iso3 === 'JPN') newMap[iso3] = 'jp';
              else if (iso3 === 'RUS') newMap[iso3] = 'ru';
              else if (['FRA','DEU','ITA','ESP','NLD','BEL','SWE','AUT','DNK','FIN','IRL','PRT','GRC','CZE','HUN','POL','ROU','BGR','SVK','SVN','HRV','LTU','LVA','EST','CYP','MLT','LUX'].includes(iso3)) newMap[iso3] = 'eu';
              else newMap[iso3] = iso3.toLowerCase();
            });
            setCountryMap(newMap);
            setCountryList(countryData);
            setCompounds(compData);
          } catch (err) {
            console.error("Failed to load initial data:", err);
          } finally {
            setLoading(false);
          }
        };
        fetchData();
      }, []);

      const types = ['all', ...new Set(compounds.map(c => c.Entity_Type).filter(Boolean))];
      const wadaStatuses = ['all', 'prohibited', 'permitted', 'unknown'];
      const usStatuses = ['all', 'approved', 'unapproved', 'investigational', 'withdrawn'];

      const filtered = compounds.filter(c => {
        const q = search.toLowerCase();
        const name = (c.Canonical_Name || '').toLowerCase();
        const synonyms = (c.Synonyms || '').toLowerCase();
        const id = (c.Entity_ID || '').toLowerCase();
        const matchSearch = !q || name.includes(q) || synonyms.includes(q) || id.includes(q);
        const matchType = filterType === 'all' || c.Entity_Type === filterType;
        const matchWADA = filterWADA === 'all' || (c.WADA_Status || 'unknown').toLowerCase() === filterWADA;
        const matchUS = filterUS === 'all' || (c.US_FDA_Status || 'unknown') === filterUS;
        return matchSearch && matchType && matchWADA && matchUS;
      });

      const stats = {
        total: compounds.length,
        approved: compounds.filter(c => c.US_FDA_Status === 'approved').length,
        prohibited: compounds.filter(c => c.WADA_Status === 'prohibited').length,
        unapproved: compounds.filter(c => c.US_FDA_Status === 'unapproved').length,
        investigational: compounds.filter(c => ['phase_3','phase_2'].includes(c.Development_Stage_Global)).length
      };

      const getCountryStatus = (geo, compound) => {
        const iso = geo.properties.ISO_A3;
        const jurisKey = countryMap[iso] || iso.toLowerCase();
        if (compound) {
          const status = compound[`${jurisKey}_FDA_Status`] || compound[`${jurisKey}_EMA_Status`] || compound[`${jurisKey}_Status`];
          if (status) return status;
        }
        const regInfo = REGULATORY_TIER_MAP[iso] || DEFAULT_TIER;
        if (regInfo.tier === 'wla') return 'under_review';
        if (regInfo.tier === 'ich') return 'harmonised';
        return 'unknown';
      };

      const searchTrials = async (query, country = '') => {
        setTrialsLoading(true);
        let term = query;
        if (country) term += ` AND ${country}`;
        const url = `https://clinicaltrials.gov/api/v2/studies?query.term=${encodeURIComponent(term)}&pageSize=30`;
        try {
          const res = await fetch(url);
          const data = await res.json();
          setTrialsData(data.studies || []);
        } catch (e) { console.error(e); }
        finally { setTrialsLoading(false); }
      };

      const searchROR = async (query, country = '') => {
        setRorLoading(true);
        let url = `https://api.ror.org/organizations?query=${encodeURIComponent(query)}`;
        if (country) url += `&filter=country.country_code:${country.substring(0,2).toUpperCase()}`;
        try {
          const res = await fetch(url);
          const data = await res.json();
          setRorData(data.items || []);
        } catch (e) { console.error(e); }
        finally { setRorLoading(false); }
      };

      const exportCSV = () => {
        const headers = ['Entity_ID','Canonical_Name','Entity_Type','US_FDA_Status','EU_EMA_Status','WADA_Status'];
        const rows = filtered.map(c => [c.Entity_ID, c.Canonical_Name, c.Entity_Type, c.US_FDA_Status, c.EU_EMA_Status, c.WADA_Status]);
        const csv = [headers, ...rows].map(r => r.join(',')).join('\n');
        const blob = new Blob([csv], { type: 'text/csv' });
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = 'regulatory_export.csv';
        a.click();
      };

      const importCSV = (file) => {
        Papa.parse(file, {
          header: true,
          complete: async (results) => {
            const rows = results.data;
            await fetch(API_URL, {
              method: 'POST',
              body: JSON.stringify(rows),
              headers: { 'Content-Type': 'application/json' }
            });
            const res = await fetch(API_URL);
            const fresh = await res.json();
            setCompounds(fresh);
            alert('Import complete!');
          }
        });
      };

      if (loading) return <div className="flex justify-center items-center h-screen"><div className="spin text-2xl">⟳</div></div>;

      return (
        <div className="min-h-screen flex flex-col md:flex-row bg-[#080c14]">
          {/* Mobile header */}
          <div className="md:hidden bg-[#0d1526] border-b border-[#1e3a5f] p-4 flex justify-between items-center sticky top-0 z-20">
            <div className="flex items-center gap-2 font-bold text-lg" style={{fontFamily:'Syne'}}>
              <i data-lucide="activity" className="w-5 h-5 text-indigo-400"></i>
              <span>RegIntel</span>
            </div>
            <button onClick={() => setMobileMenuOpen(!mobileMenuOpen)} className="p-2">
              <i data-lucide={mobileMenuOpen ? "x" : "menu"} className="w-6 h-6"></i>
            </button>
          </div>

          {/* Sidebar */}
          <nav className={`sidebar-mobile ${mobileMenuOpen ? 'open' : ''} md:translate-x-0 fixed md:static top-0 left-0 h-full w-64 bg-[#0d1526] border-r border-[#1e3a5f] text-gray-300 z-30 flex-shrink-0 overflow-y-auto`}>
            <div className="p-6 hidden md:flex items-center text-white font-bold text-xl gap-2" style={{fontFamily:'Syne'}}>
              <i data-lucide="activity" className="w-6 h-6 text-indigo-400"></i>
              <span>RegIntel</span>
            </div>
            <div className="px-4 pb-6 space-y-2">
              {[
                { id: 'matrix', label: 'Matrix', icon: 'database' },
                { id: 'map', label: 'World Map', icon: 'map' },
                { id: 'trials', label: 'Clinical Trials', icon: 'flask-conical' },
                { id: 'ror', label: 'Research Orgs', icon: 'building-2' }
              ].map(tab => (
                <button key={tab.id} onClick={() => { setActiveTab(tab.id); setMobileMenuOpen(false); }}
                  className={`w-full flex items-center px-4 py-3 rounded-lg transition ${activeTab === tab.id ? 'bg-indigo-600 text-white' : 'hover:bg-gray-800 hover:text-white'}`}>
                  <i data-lucide={tab.icon} className="w-5 h-5 mr-3"></i> {tab.label}
                </button>
              ))}
              <div className="pt-4 mt-4 border-t border-[#1e3a5f] space-y-2">
                <button onClick={() => document.getElementById('csvUpload').click()} className="w-full flex items-center px-4 py-2 text-sm rounded-lg hover:bg-gray-800 transition">
                  <i data-lucide="upload" className="w-4 h-4 mr-3"></i> Import CSV
                </button>
                <button onClick={exportCSV} className="w-full flex items-center px-4 py-2 text-sm rounded-lg hover:bg-gray-800 transition">
                  <i data-lucide="download" className="w-4 h-4 mr-3"></i> Export CSV
                </button>
                <input type="file" id="csvUpload" accept=".csv" className="hidden" onChange={e => importCSV(e.target.files[0])} />
              </div>
            </div>
          </nav>

          {/* Main Content */}
          <main className="flex-1 p-4 md:p-6 overflow-y-auto">
            {activeTab === 'matrix' && (
              <div>
                <div className="flex flex-wrap gap-4 mb-6">
                  {[
                    {l:"TOTAL",v:stats.total,c:"#60a5fa"},
                    {l:"APPROVED (US)",v:stats.approved,c:"#4ade80"},
                    {l:"WADA PROHIBITED",v:stats.prohibited,c:"#f87171"},
                    {l:"NO APPROVAL",v:stats.unapproved,c:"#fb923c"},
                    {l:"INVESTIGATIONAL",v:stats.investigational,c:"#c084fc"}
                  ].map(s => (
                    <div key={s.l} className="bg-[#0f1724] border border-[#1e3a5f] rounded-lg p-3 min-w-[120px]">
                      <div className="text-[9px] text-[#475569] font-mono tracking-wider">{s.l}</div>
                      <div className="text-2xl font-bold" style={{fontFamily:'Syne', color:s.c}}>{s.v}</div>
                    </div>
                  ))}
                </div>
                <div className="bg-[#0f1724] border border-[#1e3a5f] rounded-xl p-4 mb-6 flex flex-wrap gap-4 items-center">
                  <div className="relative flex-1 min-w-[200px]">
                    <i data-lucide="search" className="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 w-5 h-5"></i>
                    <input type="text" placeholder="Search compounds..." value={search} onChange={e => setSearch(e.target.value)}
                      className="w-full pl-10 pr-4 py-2 rounded-lg border border-[#1e3a5f] bg-[#0a0f1a] text-white focus:ring-2 focus:ring-indigo-500 outline-none" />
                  </div>
                  <select value={filterType} onChange={e => setFilterType(e.target.value)} className="px-4 py-2 rounded-lg border border-[#1e3a5f] bg-[#0a0f1a] text-gray-300">
                    {types.map(t => <option key={t} value={t}>{t==='all'?'All Types':t}</option>)}
                  </select>
                  <select value={filterWADA} onChange={e => setFilterWADA(e.target.value)} className="px-4 py-2 rounded-lg border border-[#1e3a5f] bg-[#0a0f1a] text-gray-300">
                    {wadaStatuses.map(s => <option key={s} value={s}>{s==='all'?'All WADA':s}</option>)}
                  </select>
                  <select value={filterUS} onChange={e => setFilterUS(e.target.value)} className="px-4 py-2 rounded-lg border border-[#1e3a5f] bg-[#0a0f1a] text-gray-300">
                    {usStatuses.map(s => <option key={s} value={s}>{s==='all'?'All US':s}</option>)}
                  </select>
                  <div className="ml-auto text-sm text-gray-500">{filtered.length} of {compounds.length}</div>
                </div>
                <div className="bg-[#0d1526] border border-[#1e3a5f] rounded-xl overflow-x-auto">
                  <table className="w-full text-sm font-mono">
                    <thead className="bg-[#0a0f1a] text-gray-400 border-b border-[#1e3a5f]">
                      <tr>
                        <th className="px-6 py-3 text-left sticky left-0 bg-[#0a0f1a]">Compound</th>
                        <th className="px-4 py-3 text-left">Type</th>
                        <th className="px-4 py-3 text-center">US</th>
                        <th className="px-4 py-3 text-center">EU</th>
                        <th className="px-4 py-3 text-center">WADA</th>
                      </tr>
                    </thead>
                    <tbody className="divide-y divide-[#1e3a5f]">
                      {filtered.map(c => (
                        <tr key={c.Entity_ID} onClick={() => setSelected(c)} className="hover:bg-[#1a2a4a] cursor-pointer">
                          <td className="px-6 py-4 sticky left-0 bg-[#0d1526]">
                            <div className="font-medium text-white">{c.Canonical_Name}</div>
                            <div className="text-xs text-gray-500">{c.Entity_ID}</div>
                          </td>
                          <td className="px-4 py-4 text-gray-300">{c.Entity_Type || '—'}</td>
                          <td className="px-4 py-4 text-center">
                            <span className={`px-2 py-1 rounded-full text-xs font-medium`} style={{backgroundColor: statusColors[c.US_FDA_Status]+'33', color: statusColors[c.US_FDA_Status]}}>
                              {c.US_FDA_Status || 'unknown'}
                            </span>
                          </td>
                          <td className="px-4 py-4 text-center">
                            <span className={`px-2 py-1 rounded-full text-xs font-medium`} style={{backgroundColor: statusColors[c.EU_EMA_Status]+'33', color: statusColors[c.EU_EMA_Status]}}>
                              {c.EU_EMA_Status || 'unknown'}
                            </span>
                          </td>
                          <td className="px-4 py-4 text-center">
                            <span className={`px-2 py-1 rounded-full text-xs font-medium`} style={{backgroundColor: wadaColor[c.WADA_Status]+'33', color: wadaColor[c.WADA_Status]}}>
                              {c.WADA_Status || 'unknown'}
                            </span>
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            )}

            {activeTab === 'map' && (
              <div className="bg-[#0d1526] border border-[#1e3a5f] rounded-xl p-4">
                <h2 className="text-xl font-bold mb-4" style={{fontFamily:'Syne'}}>Global Regulatory Status {selected && <span className="text-sm font-normal ml-2 text-gray-400">for {selected.Canonical_Name}</span>}</h2>
                <ComposableMap projection="geoMercator" width={800} height={500}>
                  <ZoomableGroup center={[0,20]} zoom={1.2}>
                    <Geographies geography={GEO_URL}>
                      {({ geographies }) => geographies.map(geo => {
                        const status = getCountryStatus(geo, selected);
                        return (
                          <Geography key={geo.rsmKey} geography={geo} fill={statusColors[status] || statusColors.unknown}
                            stroke="#FFFFFF" strokeWidth={0.5}
                            style={{ default: { outline: 'none' }, hover: { fill: '#a855f7', cursor: 'pointer' } }}
                            onClick={() => {
                              if (selected) searchTrials(selected.Canonical_Name, geo.properties.NAME);
                            }}
                          />
                        );
                      })}
                    </Geographies>
                  </ZoomableGroup>
                </ComposableMap>
                <div className="flex flex-wrap justify-center gap-4 mt-4">
                  {Object.entries(statusColors).map(([key, color]) => (
                    <div key={key} className="flex items-center gap-1"><span className="w-4 h-4 rounded" style={{backgroundColor: color}}></span><span className="text-xs capitalize">{key.replace('_',' ')}</span></div>
                  ))}
                </div>
                <p className="text-xs text-gray-500 text-center mt-3">Click any country to search clinical trials for the selected compound.</p>
              </div>
            )}

            {activeTab === 'trials' && (
              <div className="space-y-6">
                <div className="bg-[#0d1526] border border-[#1e3a5f] rounded-xl p-6">
                  <div className="flex flex-col md:flex-row gap-4">
                    <input type="text" id="trialQuery" placeholder="Condition / Intervention" className="flex-1 px-4 py-2 rounded-lg border border-[#1e3a5f] bg-[#0a0f1a] text-white" defaultValue={selected?.Canonical_Name} />
                    <input type="text" id="trialCountry" placeholder="Country (optional)" className="flex-1 px-4 py-2 rounded-lg border border-[#1e3a5f] bg-[#0a0f1a] text-white" />
                    <button onClick={() => searchTrials(document.getElementById('trialQuery').value, document.getElementById('trialCountry').value)} className="px-6 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700">Search</button>
                  </div>
                </div>
                {trialsLoading ? <div className="text-center py-12"><span className="spin inline-block text-2xl">⟳</span></div> :
                  <div className="grid gap-4">
                    {trialsData.map(study => {
                      const p = study.protocolSection;
                      const id = p?.identificationModule;
                      return (
                        <div key={id?.nctId} className="bg-[#0d1526] border border-[#1e3a5f] rounded-xl p-6">
                          <div className="flex justify-between items-start"><h3 className="font-bold text-lg">{id?.briefTitle}</h3><span className="px-2 py-1 bg-blue-900/30 text-blue-300 text-xs rounded-full">{p?.statusModule?.overallStatus}</span></div>
                          <p className="text-sm text-gray-400">NCT ID: {id?.nctId}</p>
                          <a href={`https://clinicaltrials.gov/ct2/show/${id?.nctId}`} target="_blank" className="text-indigo-400 text-sm inline-flex items-center gap-1 mt-2">View on ClinicalTrials.gov <i data-lucide="external-link" className="w-3 h-3"></i></a>
                        </div>
                      );
                    })}
                  </div>
                }
              </div>
            )}

            {activeTab === 'ror' && (
              <div className="space-y-6">
                <div className="bg-[#0d1526] border border-[#1e3a5f] rounded-xl p-6">
                  <div className="flex flex-col md:flex-row gap-4">
                    <input type="text" id="rorQuery" placeholder="Organization name" className="flex-1 px-4 py-2 rounded-lg border border-[#1e3a5f] bg-[#0a0f1a] text-white" />
                    <input type="text" id="rorCountry" placeholder="Country (optional)" className="flex-1 px-4 py-2 rounded-lg border border-[#1e3a5f] bg-[#0a0f1a] text-white" />
                    <button onClick={() => searchROR(document.getElementById('rorQuery').value, document.getElementById('rorCountry').value)} className="px-6 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700">Search</button>
                  </div>
                </div>
                {rorLoading ? <div className="text-center py-12"><span className="spin inline-block text-2xl">⟳</span></div> :
                  <div className="grid gap-4">
                    {rorData.map(org => (
                      <div key={org.id} className="bg-[#0d1526] border border-[#1e3a5f] rounded-xl p-6">
                        <h3 className="font-bold text-lg">{org.name}</h3>
                        <p className="text-sm text-gray-400">{org.addresses?.[0]?.city}, {org.addresses?.[0]?.country}</p>
                        <a href={org.links?.[0]} target="_blank" className="text-indigo-400 text-sm inline-flex items-center gap-1 mt-2">Website <i data-lucide="external-link" className="w-3 h-3"></i></a>
                      </div>
                    ))}
                  </div>
                }
              </div>
            )}
          </main>

          {/* Detail Panel */}
          {selected && (
            <div ref={panelRef} className={`detail-panel open fixed inset-y-0 right-0 w-full md:w-[600px] bg-[#090e1b] border-l border-[#1e3a5f] shadow-xl z-50 overflow-y-auto`}>
              <div className="p-6">
                <div className="flex justify-between items-start mb-4">
                  <div>
                    <h2 className="text-2xl font-bold" style={{fontFamily:'Syne'}}>{selected.Canonical_Name}</h2>
                    <p className="text-sm text-gray-500 mt-1">{selected.Entity_ID} · {selected.Entity_Type}</p>
                    <div className="flex gap-2 mt-2 flex-wrap">
                      <RiskChip level={selected.Evidence_Quality || selected.Development_Stage_Global} />
                      <Badge color={wadaColor[selected.WADA_Status]}>WADA {selected.WADA_Category || selected.WADA_Status}</Badge>
                    </div>
                  </div>
                  <button onClick={() => setSelected(null)} className="p-2 hover:bg-gray-700 rounded-lg"><i data-lucide="x" className="w-5 h-5"></i></button>
                </div>
                {selected.Synonyms && <div className="mb-4 p-3 bg-[#0f1724] border border-[#1e3a5f] rounded-lg text-sm text-gray-400 font-mono">{selected.Synonyms}</div>}
                <SectionBlock title="Intended Use" accent="#22c55e">{selected.Intended_Use || selected.Mechanism_Summary}</SectionBlock>
                <SectionBlock title="Mechanism" accent="#3b82f6">{selected.Mechanism_Summary}</SectionBlock>
                <SectionBlock title="Discovered Functions" accent="#a78bfa">{selected.Discovered_Functions || '—'}</SectionBlock>
                <SectionBlock title="Side Effects" accent="#f59e0b">{selected.Side_Effects || '—'}</SectionBlock>
                <SectionBlock title="Safety Concerns" accent="#ef4444">{selected.Safety_Concerns || selected.Key_Regulatory_Risks}</SectionBlock>
                <SectionBlock title="Restriction Reasoning" accent="#f97316">{selected.Restriction_Reasoning || '—'}</SectionBlock>
                <div className="mb-6">
                  <div className="text-gray-400 text-xs font-mono font-semibold uppercase tracking-wider border-b border-[#1e3a5f] pb-1 mb-3">Jurisdiction Status</div>
                  <div className="grid grid-cols-2 md:grid-cols-3 gap-2">
                    {JURISDICTIONS.map(j => {
                      const status = selected[`${j}_FDA_Status`] || selected[`${j}_EMA_Status`] || selected[`${j}_Status`] || 'unknown';
                      const access = selected[`${j}_Legal_Access`] || 'unknown';
                      return <JurisCell key={j} status={status} access={access} />;
                    })}
                  </div>
                </div>
                <div className="mb-6 p-4 bg-red-950/20 border border-red-800 rounded-lg">
                  <h3 className="text-sm font-semibold text-red-400 mb-2">WADA Anti-Doping</h3>
                  <div className="grid grid-cols-2 gap-2 text-sm">
                    <div><span className="text-gray-400">Status:</span> <span className="font-medium" style={{color:wadaColor[selected.WADA_Status]}}>{selected.WADA_Status}</span></div>
                    <div><span className="text-gray-400">Category:</span> {selected.WADA_Category || '—'}</div>
                    <div><span className="text-gray-400">In-Competition:</span> {selected.WADA_In_Competition === 'TRUE' ? 'Prohibited' : 'Permitted'}</div>
                    <div><span className="text-gray-400">Out-of-Competition:</span> {selected.WADA_Out_Competition === 'TRUE' ? 'Prohibited' : 'Permitted'}</div>
                  </div>
                </div>
                <div className="text-xs text-gray-500">Last verified: {selected.Last_Verified || 'unknown'}</div>
              </div>
            </div>
          )}
        </div>
      );
    }

    ReactDOM.createRoot(document.getElementById('root')).render(<App />);
    setTimeout(() => lucide.createIcons(), 100);
  </script>
</body>
</html>
