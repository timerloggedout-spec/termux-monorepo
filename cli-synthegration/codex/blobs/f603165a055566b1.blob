import React from 'react';
import { X, ExternalLink } from 'lucide-react';

const JURISDICTIONS = [
  { key: 'US', label: 'USA', statusKey: 'US_FDA_Status', accessKey: 'US_Legal_Access', notesKey: 'US_Notes' },
  { key: 'EU', label: 'EU', statusKey: 'EU_EMA_Status', accessKey: 'EU_Legal_Access', notesKey: 'EU_Notes' },
  { key: 'CA', label: 'Canada', statusKey: 'CA_HealthCanada_Status', accessKey: 'CA_Legal_Access', notesKey: 'CA_Notes' },
  { key: 'AU', label: 'Australia', statusKey: 'AU_TGA_Status', accessKey: 'AU_Legal_Access', notesKey: 'AU_Notes' },
  { key: 'UK', label: 'UK', statusKey: 'UK_MHRA_Status', accessKey: 'UK_Legal_Access', notesKey: 'UK_Notes' },
  { key: 'JP', label: 'Japan', statusKey: 'JP_PMDA_Status', accessKey: 'JP_Legal_Access', notesKey: 'JP_Notes' },
  { key: 'RU', label: 'Russia', statusKey: 'RU_Status', accessKey: 'RU_Legal_Access', notesKey: 'RU_Notes' },
];

function Section({ title, children }) {
  return (
    <div className="mb-4">
      <h3 className="text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400 mb-1">
        {title}
      </h3>
      <p className="text-sm text-gray-700 dark:text-gray-300">{children || '—'}</p>
    </div>
  );
}

export default function DetailView({ compound, onClose }) {
  if (!compound) return null;

  return (
    <div className="fixed inset-y-0 right-0 w-full md:w-[500px] bg-white dark:bg-gray-800 shadow-xl overflow-y-auto border-l border-gray-200 dark:border-gray-700 z-50 animate-slide-in">
      <div className="p-6">
        <div className="flex justify-between items-start mb-4">
          <div>
            <h2 className="text-2xl font-bold text-gray-900 dark:text-white">{compound.Canonical_Name}</h2>
            <p className="text-sm text-gray-500 dark:text-gray-400 mt-1">
              {compound.Entity_ID} · {compound.Entity_Type || 'N/A'}
            </p>
          </div>
          <button onClick={onClose} className="p-2 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg">
            <X className="w-5 h-5" />
          </button>
        </div>

        {compound.Synonyms && (
          <div className="mb-4 p-3 bg-gray-50 dark:bg-gray-700 rounded-lg text-sm text-gray-600 dark:text-gray-300">
            <span className="font-medium">Synonyms:</span> {compound.Synonyms}
          </div>
        )}

        <Section title="Modality">{compound.Modality}</Section>
        <Section title="Mechanism">{compound.Mechanism_Summary}</Section>
        <Section title="Development Stage">{compound.Development_Stage_Global}</Section>
        <Section title="Key Risks">{compound.Key_Regulatory_Risks}</Section>

        {/* Jurisdiction matrix */}
        <div className="mb-6">
          <h3 className="text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400 mb-3">
            Jurisdiction Status
          </h3>
          <div className="grid grid-cols-2 md:grid-cols-3 gap-2">
            {JURISDICTIONS.map(j => {
              const status = compound[j.statusKey] || 'unknown';
              const access = compound[j.accessKey] || 'unknown';
              return (
                <div key={j.key} className="border border-gray-200 dark:border-gray-700 rounded-lg p-3">
                  <div className="text-xs text-gray-500 dark:text-gray-400">{j.label}</div>
                  <div className="font-medium text-gray-900 dark:text-white text-sm">{status}</div>
                  <div className="text-xs text-gray-500 dark:text-gray-400">{access}</div>
                </div>
              );
            })}
          </div>
        </div>

        {/* WADA card */}
        <div className="mb-6 p-4 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg">
          <h3 className="text-sm font-semibold text-red-800 dark:text-red-300 mb-2">WADA Anti-Doping Status</h3>
          <div className="grid grid-cols-2 gap-2 text-sm">
            <div>
              <span className="text-gray-600 dark:text-gray-400">Status:</span>
              <span className={`ml-2 font-medium ${
                compound.WADA_Status === 'prohibited' ? 'text-red-600 dark:text-red-400' :
                compound.WADA_Status === 'permitted' ? 'text-green-600 dark:text-green-400' :
                'text-gray-600'
              }`}>{compound.WADA_Status || 'unknown'}</span>
            </div>
            <div>
              <span className="text-gray-600 dark:text-gray-400">Category:</span>
              <span className="ml-2">{compound.WADA_Category || '—'}</span>
            </div>
            <div>
              <span className="text-gray-600 dark:text-gray-400">In-Competition:</span>
              <span className="ml-2">{compound.WADA_In_Competition === 'TRUE' ? 'Prohibited' : 'Permitted'}</span>
            </div>
            <div>
              <span className="text-gray-600 dark:text-gray-400">Out-of-Competition:</span>
              <span className="ml-2">{compound.WADA_Out_Competition === 'TRUE' ? 'Prohibited' : 'Permitted'}</span>
            </div>
          </div>
        </div>

        <div className="text-xs text-gray-500 dark:text-gray-400">
          <p>Last verified: {compound.Last_Verified || 'unknown'}</p>
          <div className="flex gap-3 mt-2">
            <a href="#" className="text-indigo-600 hover:underline flex items-center">
              ClinicalTrials.gov <ExternalLink className="w-3 h-3 ml-1" />
            </a>
            <a href="#" className="text-indigo-600 hover:underline flex items-center">
              FDA <ExternalLink className="w-3 h-3 ml-1" />
            </a>
          </div>
        </div>
      </div>
    </div>
  );
}
