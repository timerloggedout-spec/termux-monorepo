class ProductionController {
    constructor(dataManager, arbitrageEngine, ui, logger) {
        this.dataManager = dataManager;
        this.arbitrageEngine = arbitrageEngine;
        this.ui = ui;
        this.logger = logger;
        this.isInitialized = false;
        this.scanInterval = null;
    }

    async initializeEngine() {
        if (this.isInitialized) {
            this.logger.log('CONTROLLER', 'Engine already initialized', 'info');
            return true;
        }

        this.logger.log('CONTROLLER', 'Initializing production arbitrage system...', 'info');

        try {
            // Step 1: Initialize data manager with real market data
            this.logger.log('CONTROLLER', 'Loading real market data...', 'info');
            const dataLoaded = await this.dataManager.initializeExchangeData();
            
            if (!dataLoaded) {
                this.logger.log('CONTROLLER', 'Failed to load market data', 'error');
                this.ui.showNotification('Failed to connect to market data sources', 'error');
                return false;
            }

            // Step 2: Initialize arbitrage engine
            this.logger.log('CONTROLLER', 'Initializing arbitrage algorithms...', 'info');
            const engineInitialized = await this.arbitrageEngine.initialize();
            
            if (!engineInitialized) {
                this.logger.log('CONTROLLER', 'Failed to initialize arbitrage engine', 'error');
                this.ui.showNotification('Failed to initialize arbitrage algorithms', 'error');
                return false;
            }

            // Step 3: Initialize UI components
            this.logger.log('CONTROLLER', 'Initializing user interface...', 'info');
            this.ui.initialize();

            // Step 4: Start background scanning
            this.startBackgroundScanning();

            this.isInitialized = true;
            
            this.logger.log('CONTROLLER', 'Production system fully initialized', 'success');
            this.ui.showNotification('Arbitrage system ready - Live market data active', 'success');
            
            return true;

        } catch (error) {
            this.logger.log('CONTROLLER', `Initialization failed: ${error.message}`, 'error');
            this.ui.showNotification(`System initialization failed: ${error.message}`, 'error');
            return false;
        }
    }

    startBackgroundScanning() {
        // Start periodic scanning every 2 minutes
        this.scanInterval = setInterval(() => {
            if (!this.arbitrageEngine.isScanning) {
                this.executeBackgroundScan();
            }
        }, 120000); // 2 minutes

        this.logger.log('CONTROLLER', 'Background scanning scheduler started', 'info');
    }

    async executeBackgroundScan() {
        this.logger.log('CONTROLLER', 'Starting background arbitrage scan...', 'info');
        
        const params = {
            exchanges: ['coingecko', 'dexscreener'], // Focus on these for background scans
            method: 'triangular',
            investmentAmount: 100,
            batchSize: 50,
            minProfitPercent: 0.05 // Higher threshold for background scans
        };

        await this.arbitrageEngine.executeMultiExchangeScan(params);
    }

    async executeLiveScan() {
        if (this.arbitrageEngine.isScanning) {
            this.ui.showNotification('Scan already in progress', 'warning');
            return;
        }

        if (!this.isInitialized) {
            const initialized = await this.initializeEngine();
            if (!initialized) {
                this.ui.showNotification('System not initialized', 'error');
                return;
            }
        }

        this.logger.log('CONTROLLER', 'Starting live arbitrage scan...', 'info');

        // Get parameters from UI
        const exchanges = this.getSelectedExchanges();
        const method = document.getElementById('methodSelect').value;
        const investmentAmount = parseFloat(document.getElementById('investmentAmount').value) || 100;
        const batchSize = parseInt(document.getElementById('batchSize').value) || 100;
        const minProfitPercent = parseFloat(document.getElementById('minProfitPercent').value) || 0.01;

        const params = {
            exchanges,
            method,
            investmentAmount,
            batchSize,
            minProfitPercent
        };

        this.ui.showNotification(`Starting ${method} scan on ${exchanges.length} exchanges`, 'info');

        try {
            const opportunities = await this.arbitrageEngine.executeMultiExchangeScan(params);
            
            if (opportunities.length > 0) {
                this.ui.showNotification(`Found ${opportunities.length} arbitrage opportunities!`, 'success');
            } else {
                this.ui.showNotification('No arbitrage opportunities found', 'warning');
            }

        } catch (error) {
            this.logger.log('CONTROLLER', `Live scan failed: ${error.message}`, 'error');
            this.ui.showNotification(`Scan failed: ${error.message}`, 'error');
        }
    }

    getSelectedExchanges() {
        const select = document.getElementById('exchangeSelect');
        const selectedOptions = Array.from(select.selectedOptions).map(opt => opt.value);
        
        if (selectedOptions.includes('all')) {
            return ['binance', 'kraken', 'kucoin', 'coingecko', 'dexscreener'];
        }
        
        return selectedOptions;
    }

    stopScan() {
        const stopped = this.arbitrageEngine.stopScan();
        if (stopped) {
            this.ui.showNotification('Scan stopped', 'warning');
            this.logger.log('CONTROLLER', 'Scan stopped by user', 'info');
        }
    }

    getSystemStatus() {
        return {
            initialized: this.isInitialized,
            dataOnline: this.dataManager.isOnline,
            engineScanning: this.arbitrageEngine.isScanning,
            opportunitiesCount: this.arbitrageEngine.opportunities.length,
            performance: this.arbitrageEngine.getPerformanceMetrics()
        };
    }

    // Cleanup method for when the page is closed
    cleanup() {
        if (this.scanInterval) {
            clearInterval(this.scanInterval);
            this.scanInterval = null;
        }
        
        this.logger.log('CONTROLLER', 'Production controller cleaned up', 'info');
    }
}

// Make available globally
if (typeof module !== 'undefined' && module.exports) {
    module.exports = ProductionController;
} else {
    window.ProductionController = ProductionController;
}
