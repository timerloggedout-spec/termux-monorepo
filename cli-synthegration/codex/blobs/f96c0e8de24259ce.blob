   query GetPairs($tokenAddresses: [String!]) {
     pairs(where: { token0_in: $tokenAddresses, token1_in: $tokenAddresses }) {
       id
       token0 {
         id
         symbol
         decimals
       }
       token1 {
         id
         symbol
         decimals
       }
       reserve0
       reserve1
     }
   }
   
