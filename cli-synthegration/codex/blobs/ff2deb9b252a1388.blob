const gun = Gun(['https://gun-manhattan.herokuapp.com/gun']); // free public relay
const user = gun.user().recall({ sessionStorage: true });

// Store a gene node
gun.get('gene').get('FAS').put({
  symbol: 'FAS',
  name: 'Fas cell surface death receptor',
  species: 'Homo sapiens',
  source: 'open_genes',
  source_id: '114'
});

// Link gene → pathway
gun.get('gene').get('FAS').get('pathways').set(gun.get('pathway').get('TRPCAT-PWY'));

// Link gene → intervention
gun.get('intervention').get('int_001').put({
  type: 'genetic',
  target_gene_id: 'FAS',
  effect_on_lifespan: 'increased',
  model_organism: 'Mus musculus'
});
gun.get('gene').get('FAS').get('interventions').set(gun.get('intervention').get('int_001'));
