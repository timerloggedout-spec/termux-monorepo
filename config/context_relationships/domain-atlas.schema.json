{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/timerloggedout-spec/termux-monorepo/blob/master/config/context_relationships/domain-atlas.schema.json",
  "title": "Context Relationship Domain Atlas Projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "projection",
    "source_ref",
    "source_sha",
    "domains",
    "relationships"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "projection": {
      "const": "domain_atlas"
    },
    "source_ref": {
      "type": "string",
      "minLength": 1
    },
    "source_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "role",
          "summary",
          "sources"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/evidence"
            }
          }
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source",
          "target",
          "type",
          "layers",
          "classification",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "PRODUCES",
              "PROJECTED_INTO",
              "EMITS_AND_MEASURES",
              "FEEDS_ANALYSIS",
              "GOVERNS",
              "CONSUMES",
              "SUPPORTS",
              "OPTIONAL_CONSUMER",
              "UNKNOWN"
            ]
          },
          "layers": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "semantic",
                "operational"
              ]
            }
          },
          "classification": {
            "enum": [
              "verified",
              "candidate",
              "unknown"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/evidence"
            }
          }
        }
      }
    },
    "$defs": {
      "evidence": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "url",
          "claim"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "claim": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
