# Hindsight self-hosted — provider + parser config
# Copy to .env, never commit .env

HINDSIGHT_API_LLM_PROVIDER=gemini
HINDSIGHT_API_LLM_MODEL=gemini-2.0-flash
HINDSIGHT_API_LLM_API_KEY=AIza...

# Gemini free-tier: override to on_demand if service_tier errors
HINDSIGHT_API_LLM_GEMINI_SERVICE_TIER=on_demand

# File parsers: markitdown is free forever; iris costs tokens
HINDSIGHT_API_FILE_PARSER=markitdown,iris
HINDSIGHT_API_FILE_PARSER_ALLOWLIST=markitdown,iris

# Embedded database (self-hosted slim)
HINDSIGHT_API_DATABASE_URL=pg0+file://~/.hindsight/data
HINDSIGHT_API_PORT=8888

# Fallback LLM chain if gemini unavailable
HINDSIGHT_API_LLM_FALLBACK=openai:gpt-4o-mini,anthropic:claude-3-5-haiku
