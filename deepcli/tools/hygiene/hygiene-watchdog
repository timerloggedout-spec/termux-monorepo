#!/data/data/com.termux/files/usr/bin/bash
# hygiene-watchdog — Termux resource loop detector.
# sv-managed. Loops internally; sv respawns only on crash.
set -u
INTERVAL="${HYGIENE_WD_INTERVAL:-30}"
LOG="${HOME}/.deepcli/logs/hygiene/watchdog.jsonl"
STATE="${HOME}/.deepcli/watchdog/state.json"
MEM_FLOOR_MB="${HYGIENE_WD_MEM_FLOOR:-200}"
CPU_PEG="${HYGIENE_WD_CPU_PEG:-85}"
TMP="${TMPDIR:-/data/data/com.termux/files/usr/tmp}"

mkdir -p "$(dirname "$LOG")" "$(dirname "$STATE")" "$TMP"

log_event() {
    local ev="$1" extra="${2:-}"
    [ -z "$extra" ] && extra='"ok":true'
    printf '{"ts":%d,"iso":"%s","event":"%s",%s}\n' \
        "$(date +%s)" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$ev" "$extra" >> "$LOG"
}

sample() {
    local UP_NOW BOOT_ID MEM_KB MEM_MB UP_LAST BOOTS LAST_BOOT
    UP_NOW=$(awk '{print int($1)}' /proc/uptime 2>/dev/null); UP_NOW=${UP_NOW:-0}
    BOOT_ID=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null || echo unknown)
    MEM_KB=$(awk '/MemAvailable/{print $2}' /proc/meminfo 2>/dev/null); MEM_KB=${MEM_KB:-0}
    MEM_MB=$(( MEM_KB / 1024 ))
    UP_LAST=0; BOOTS=0; LAST_BOOT=""
    if [ -f "$STATE" ]; then
        UP_LAST=$(sed -n 's/.*"uptime":\([0-9]*\).*/\1/p' "$STATE" | head -1)
        BOOTS=$(sed -n 's/.*"boot_count":\([0-9]*\).*/\1/p' "$STATE" | head -1)
        LAST_BOOT=$(sed -n 's/.*"boot_id":"\([^"]*\)".*/\1/p' "$STATE" | head -1)
    fi
    UP_LAST=${UP_LAST:-0}; BOOTS=${BOOTS:-0}
    if [ -n "$LAST_BOOT" ] && [ "$LAST_BOOT" != "$BOOT_ID" ]; then
        BOOTS=$((BOOTS + 1))
        log_event "reboot_detected" "\"boot_id\":\"$BOOT_ID\",\"prev\":\"$LAST_BOOT\",\"boot_count\":$BOOTS"
    fi
    if [ "$MEM_MB" -lt "$MEM_FLOOR_MB" ]; then
        log_event "mem_low" "\"mem_mb\":$MEM_MB,\"floor\":$MEM_FLOOR_MB"
    fi
    for name in python3 node git zsh bash sh; do
        n=$(pgrep -c -x "$name" 2>/dev/null)
        n=$(printf '%s' "$n" | tr -dc '0-9')
        n=${n:-0}
        case "$name" in
            python3) lim=8;; node) lim=5;; git) lim=4;;
            zsh) lim=12;; bash) lim=25;; sh) lim=35;;
            *) lim=5;;
        esac
        if [ "$n" -gt "$lim" ]; then
            log_event "dup_procs" "\"name\":\"$name\",\"count\":$n,\"limit\":$lim"
        fi
    done
    printf '{"uptime":%d,"boot_count":%d,"mem_mb":%d,"boot_id":"%s","ts":%d}\n' \
        "$UP_NOW" "$BOOTS" "$MEM_MB" "$BOOT_ID" "$(date +%s)" > "$STATE"
    log_event "heartbeat" "\"mem_mb\":$MEM_MB,\"boots\":$BOOTS"
    if [ -f "$LOG" ]; then
        sz=$(wc -c < "$LOG" 2>/dev/null || echo 0)
        if [ "$sz" -gt 5242880 ]; then
            mv "$LOG" "$LOG.1"; : > "$LOG"
        fi
    fi
}

while true; do
    sample
    sleep "$INTERVAL"
done
