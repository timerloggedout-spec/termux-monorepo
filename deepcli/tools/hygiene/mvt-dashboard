#!/data/data/com.termux/files/usr/bin/env python3
"""mvt-dashboard v3 — session inventory + MVT scoreboard + model history.

Session types:
  DEEPAGENT  sessions keyed in ~/.deepcli/sessions.json (task-hash)
  LISTENER   session id in ~/.deepcli/active_session (auto-exec)
  UI         all others — manual TUI / copy-paste

Model history: read from msg.model field in each session message.
Empty in old sessions, populated in newer ones — the field exists in
every session (verified against 417ddd6d).

Load-bearing credential files: NOT read, NOT printed. Stat only:
  ~/.deepcli/config.json         (DeepSeek session token for core.py)
  ~/.deepcli/hub.token           (bearer for /gh /run /v1/agent)
  storage/downloads/.../cookies_2.json  (account-1 + account-2 auth)
  ~/.gnupg/.2fa-pass             (TOTP passphrase)
  ~/.password-store/secret/github.gpg   (TOTP encrypted)

Source: ~/.deepcli/session_store only. Exports + zips are stale.
"""
import sys, os, re, json, time, pathlib, subprocess, collections

HOME = pathlib.Path.home()
SS   = HOME/".deepcli"/"session_store"
SESS = HOME/".deepcli"/"sessions.json"
ACT  = HOME/".deepcli"/"active_session"
try:
    from mvt_safe_read import last_msg_ts as _lmts
except ImportError:
    def _lmts(_): return None

SCORE = HOME/".local"/"bin"/"mvt-score"

LOAD_BEARING = [
    HOME/".deepcli"/"config.json",
    HOME/".deepcli"/"hub.token",
    HOME/"storage"/"downloads"/"_doing"/"_1-build"/"DeepSeek"/"exports"/"cookies_2.json",
    HOME/".gnupg"/".2fa-pass",
    HOME/".password-store"/"secret"/"github.gpg",
]

# ─── message-count cache (mtime-keyed) ─────────────────────────────
COUNT_CACHE_FILE = HOME / ".deepcli" / "watchdog" / "msg-count-cache.json"

def load_count_cache():
    try:
        return json.loads(COUNT_CACHE_FILE.read_text())
    except Exception:
        return {}

def save_count_cache(cache):
    try:
        COUNT_CACHE_FILE.parent.mkdir(parents=True, exist_ok=True)
        COUNT_CACHE_FILE.write_text(json.dumps(cache))
    except Exception:
        pass

def count_messages(path, cache):
    """Return message count for a session file, cached by mtime.
    Cache entry: {path_str: [mtime, count]}."""
    ps = str(path)
    try:
        st = path.stat()
    except Exception:
        return 0
    mt = st.st_mtime
    ent = cache.get(ps)
    if ent and abs(float(ent[0]) - mt) < 0.001:
        return int(ent[1])
    try:
        raw = json.loads(path.read_text())
    except Exception:
        cache[ps] = [mt, 0]
        return 0
    n = len(raw) if isinstance(raw, list) else 0
    cache[ps] = [mt, n]
    return n

def aggregate_message_totals():
    """Return dict with totals and per-session detail. Uses cache so second
    call is fast (only changed files re-parse). Scans primary/secondary/flat
    so writes to any of them are counted."""
    cache = load_count_cache()
    sessions = []
    seen = set()
    for base in (SS/"primary", SS/"secondary", SS):
        if not base.is_dir(): continue
        for f in base.glob("*.json"):
            if f.stem in seen: continue
            seen.add(f.stem)
            sessions.append(f)
    total = 0
    biggest = []
    newest = None
    newest_mt = 0
    for f in sessions:
        n = count_messages(f, cache)
        total += n
        try: mt = f.stat().st_mtime
        except Exception: mt = 0
        if mt > newest_mt:
            newest_mt = mt
            newest = (f, n, mt)
        biggest.append((n, f.stem, mt))
    biggest.sort(reverse=True)
    save_count_cache(cache)
    return {
        "total_sessions": len(sessions),
        "total_messages": total,
        "newest": newest,
        "top5": biggest[:5],
    }



# ─── inline MVT scorer (no subprocess) + per-session score cache ──
SCORE_TIMEOUT = 30
MVT_SCORE_PATH = HOME / "deepcli" / "tools" / "hygiene" / "mvt-score"
SCORE_CACHE_FILE = HOME / ".deepcli" / "watchdog" / "mvt-score-cache.json"

_mvt_mod = None
def _load_mvt():
    global _mvt_mod
    if _mvt_mod is not None: return _mvt_mod
    if not MVT_SCORE_PATH.exists(): return None
    try:
        from importlib.machinery import SourceFileLoader
        from importlib.util import spec_from_loader, module_from_spec
        loader = SourceFileLoader("mvt_score_inline", str(MVT_SCORE_PATH))
        spec = spec_from_loader("mvt_score_inline", loader)
        m = module_from_spec(spec)
        import sys as _s
        _s.modules["mvt_score_inline"] = m
        loader.exec_module(m)
        _mvt_mod = m
        return m
    except Exception:
        return None

def load_score_cache():
    try: return json.loads(SCORE_CACHE_FILE.read_text())
    except Exception: return {}

def save_score_cache(cache):
    try:
        SCORE_CACHE_FILE.parent.mkdir(parents=True, exist_ok=True)
        SCORE_CACHE_FILE.write_text(json.dumps(cache))
    except Exception: pass

def scored_levels_for(path, cache):
    """Return {0: n, 1: n, 2: n} for one session, mtime-cached."""
    ps = str(path)
    try: mt = path.stat().st_mtime
    except Exception: return {0:0,1:0,2:0}
    ent = cache.get(ps)
    if ent and abs(float(ent[0]) - mt) < 0.001:
        return {int(k): int(v) for k, v in ent[1].items()}
    mod = _load_mvt()
    if mod is None: return {0:0,1:0,2:0}
    L = {0:0,1:0,2:0}
    try:
        trials = mod.score_session(path)
    except Exception:
        trials = []
    for t in trials:
        lv = t.get("level")
        if isinstance(lv, int): L[lv] = L.get(lv,0) + 1
    cache[ps] = [mt, {str(k): v for k, v in L.items()}]
    return L


def sz(n):
    for u in ("B","K","M","G"):
        if n < 1024: return f"{n:.1f}{u}"
        n /= 1024
    return f"{n:.1f}P"

def session_type(sid, deep_ids, listener_id):
    if listener_id and sid == listener_id: return "LISTENER"
    if sid in deep_ids: return "DEEPAGENT"
    return "UI"

def main():
    t0 = time.time()
    print(f"=== mvt-dashboard v3  {time.strftime('%Y-%m-%dT%H:%MZ', time.gmtime())} ===\n")

    deep_ids = set()
    if SESS.exists():
        try:
            for v in json.loads(SESS.read_text()).values():
                if isinstance(v, dict) and v.get("session_id"):
                    deep_ids.add(v["session_id"])
        except Exception: pass

    listener_id = None
    if ACT.exists():
        try: listener_id = ACT.read_text().strip() or None
        except Exception: pass

    _raw = []
    _seen = set()
    for _base in (SS/"primary", SS/"secondary", SS):
        if not _base.is_dir(): continue
        for _f in _base.glob("*.json"):
            if _f.stem in _seen: continue
            _seen.add(_f.stem)
            _raw.append(_f)
    files = sorted(_raw, key=lambda f: f.stat().st_mtime, reverse=True)
    by_type = {"DEEPAGENT": [], "LISTENER": [], "UI": []}
    for f in files:
        by_type[session_type(f.stem, deep_ids, listener_id)].append(f)

    print("── SESSION INVENTORY ──")
    print(f"  total           {len(files):>5d}")
    print(f"  DEEPAGENT       {len(by_type['DEEPAGENT']):>5d}")
    print(f"  LISTENER        {len(by_type['LISTENER']):>5d}")
    print(f"  UI (paste)      {len(by_type['UI']):>5d}")
    print()

    # message totals (cached)
    agg = aggregate_message_totals()
    print("── MESSAGE TOTALS (mtime-cached) ──")
    print(f"  total messages    {agg['total_messages']:>8d}")
    print(f"  total sessions    {agg['total_sessions']:>8d}")
    if agg["newest"]:
        f, n, mt = agg["newest"]
        mts = _lmts(f)
        ts = mts if mts else mt
        label = "last msg" if mts else "file"
        age = int(time.time() - ts)
        age_str = f"{age}s" if age < 120 else (f"{age//60}m" if age < 7200 else f"{age//3600}h")
        print(f"  newest session    {f.stem[:20]}  {n:>5d} msgs  ({label} {age_str} ago)")
    if agg["top5"]:
        print("  top 5 by size:")
        for n, sid, mt in agg["top5"]:
            age = int(time.time() - mt)
            age_str = f"{age//3600}h" if age > 3600 else f"{age//60}m"
            print(f"    {sid[:20]}  {n:>6d} msgs  ({age_str} old)")
    print()

    print("── MODEL FAMILY (proxy: thinking_enabled; msg.model empty in this data) ──")
    mc = collections.Counter()
    by_month = collections.defaultdict(collections.Counter)
    for f in files[:30]:
        try: raw = json.loads(f.read_text())
        except Exception: continue
        if not isinstance(raw, list): continue
        for m in raw:
            if not isinstance(m, dict): continue
            if (m.get("role") or "").lower() != "assistant": continue
            te = m.get("thinking_enabled")
            tc = m.get("thinking_content")
            # prefer explicit model when present
            explicit = m.get("model")
            if explicit and isinstance(explicit, str) and explicit.strip():
                fam = explicit
            elif te is True or (isinstance(tc, str) and tc.strip()):
                fam = "reasoner-family (thinking)"
            elif te is False:
                fam = "chat-family (no thinking)"
            else:
                fam = "(unknown)"
            mc[fam] += 1
            ts = m.get("inserted_at")
            month = None
            if isinstance(ts, str) and len(ts) >= 7:
                month = ts[:7]
            elif isinstance(ts, (int, float)) and ts > 0:
                # epoch seconds → YYYY-MM
                try: month = time.strftime("%Y-%m", time.localtime(ts))
                except Exception: month = None
            if month:
                by_month[month][fam] += 1
    if mc:
        for fam, n in mc.most_common(12):
            print(f"  {fam:36s} {n:>6d}")
        print("  by month:")
        for month in sorted(by_month)[-8:]:
            print(f"    {month}: {dict(by_month[month].most_common(3))}")
    else:
        print("  (no proxy signals in scanned samples)")
    print()

    print("── MVT SCORES (inline, mtime-cached; 6 per type) ──")
    score_cache = load_score_cache()
    for stype in ("DEEPAGENT", "LISTENER", "UI"):
        fl = by_type[stype][:6]
        if not fl:
            print(f"  {stype:10s}  (none)"); continue
        L = {0:0,1:0,2:0}
        for f in fl:
            s = scored_levels_for(f, score_cache)
            for k in L: L[k] += s.get(k, 0)
        print(f"  {stype:10s}  L0={L[0]:>3d}  L1={L[1]:>3d}  L2={L[2]:>3d}")
    save_score_cache(score_cache)
    print()

    print("── RECENT DEEPAGENT TASKS ──")
    if SESS.exists():
        try:
            d = json.loads(SESS.read_text())
            rows = sorted(d.items(), key=lambda kv: kv[1].get("last_used", 0), reverse=True)[:6]
            for k, v in rows:
                used = v.get("last_used", 0)
                used_s = time.strftime("%m-%d %H:%M", time.localtime(used)) if used else "?"
                task = (v.get("last_task") or "")[:60]
                print(f"  {used_s}  {k[:14]}  runs={v.get('runs','?')}  {task}")
        except Exception as e:
            print(f"  read fail: {e}")
    print()

    print("── LOAD-BEARING CREDENTIALS (stat only, never printed) ──")
    # cache /proc/mounts once
    try:
        mounts_raw = pathlib.Path("/proc/mounts").read_text().splitlines()
    except Exception:
        mounts_raw = []
    def fstype_of(p):
        try: resolved = str(p.resolve())
        except Exception: return "?"
        best = ""; fst = "?"
        for line in mounts_raw:
            parts = line.split()
            if len(parts) < 3: continue
            mp = parts[1]
            if resolved.startswith(mp) and len(mp) > len(best):
                best = mp; fst = parts[2]
        return fst
    for p in LOAD_BEARING:
        if p.exists():
            st = p.stat()
            mode = oct(st.st_mode)[-3:]
            fs = fstype_of(p)
            flag = "FUSE-noop-chmod" if fs == "fuse" else "local"
            print(f"  OK   {str(p.relative_to(HOME)):60s}  {sz(st.st_size):>8s}  mode={mode}  fs={fs}  [{flag}]")
        else:
            print(f"  MISS {str(p.relative_to(HOME))}")
    print()

    print(f"# elapsed {time.time()-t0:.1f}s")

def watch_loop(interval=5):
    """Re-run main() every interval seconds. Ctrl-C exits."""
    import time as _t
    while True:
        os.system("clear")
        try: main()
        except Exception as e: print(f"watch error: {e}")
        print(f"\n# next refresh in {interval}s — Ctrl-C to stop")
        try: _t.sleep(interval)
        except KeyboardInterrupt:
            print("\nstopped."); return

if __name__ == "__main__":
    if "--watch" in sys.argv:
        i = sys.argv.index("--watch")
        n = 5
        if i + 1 < len(sys.argv):
            try: n = int(sys.argv[i+1])
            except ValueError: pass
        watch_loop(interval=n)
    else:
        sys.exit(main())
