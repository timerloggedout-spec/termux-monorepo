#!/data/data/com.termux/files/usr/bin/env python3
"""mvt-tick — one-shot message-count check. Fast (mtime-cached)."""
import os, json, time, pathlib, sys

HOME = pathlib.Path.home()
SS   = HOME/".deepcli"/"session_store"

def _scan_dirs():
    """Primary, secondary, flat — deduped by stem, primary wins."""
    seen = {}
    for base in (SS/"primary", SS/"secondary", SS):
        if not base.is_dir(): continue
        for f in base.glob("*.json"):
            if f.stem in seen: continue
            seen[f.stem] = f
    return list(seen.values())

STATE= HOME/".deepcli"/"watchdog"/"tick-state.json"

def load_cache():
    p = HOME/".deepcli"/"watchdog"/"msg-count-cache.json"
    try: return json.loads(p.read_text())
    except Exception: return {}

def count_now():
    cache = load_cache()
    total = 0
    newest = None
    newest_mt = 0
    for f in _scan_dirs():
        ps = str(f)
        try: mt = f.stat().st_mtime
        except Exception: continue
        ent = cache.get(ps)
        if ent and abs(float(ent[0]) - mt) < 0.001:
            n = int(ent[1])
        else:
            try: n = len(json.loads(f.read_text())) if isinstance(json.loads(f.read_text()), list) else 0
            except Exception: n = 0
            cache[ps] = [mt, n]
        total += n
        if mt > newest_mt:
            newest_mt = mt
            newest = (f.stem, n, mt)
    # persist cache (helps next invocation)
    try:
        (HOME/".deepcli"/"watchdog").mkdir(parents=True, exist_ok=True)
        (HOME/".deepcli"/"watchdog"/"msg-count-cache.json").write_text(json.dumps(cache))
    except Exception: pass
    return total, newest

def main():
    now = int(time.time())
    total, newest = count_now()
    prev = 0
    prev_ts = 0
    if STATE.exists():
        try:
            st = json.loads(STATE.read_text())
            prev = int(st.get("total", 0))
            prev_ts = int(st.get("ts", 0))
        except Exception: pass
    delta = total - prev
    STATE.write_text(json.dumps({"total": total, "ts": now,
                                 "newest": newest[0] if newest else None}))
    iso = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(now))
    line = f"{iso}  total={total}  delta={delta:+d}"
    if newest:
        age = now - int(newest[2])  # file mtime, not msg time
        line += f"  newest={newest[0][:16]}  msgs={newest[1]}  file_file_age={age}s"
    print(line)

if __name__ == "__main__":
    sys.exit(main())
