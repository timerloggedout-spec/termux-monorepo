{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/timerloggedout-spec/termux-monorepo/docs/agentic/dependency-phases.schema.json",
  "title": "Agentic Dependency Phase Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "base_branch", "phases"],
  "properties": {
    "schema_version": {"const": 1},
    "plan_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"},
    "base_branch": {"const": "master-staging"},
    "policy": {"type": "object"},
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/phase"}
    }
  },
  "$defs": {
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase_id", "title", "proposal", "items", "depends_on", "required_gates",
        "approval", "execution", "completion"
      ],
      "properties": {
        "phase_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{2,63}$"},
        "title": {"type": "string", "minLength": 3},
        "proposal": {"type": "string", "minLength": 1},
        "items": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{2,63}$"}
        },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{2,63}$"}
        },
        "required_gates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["repo-gate", "termux-smoke"]}
        },
        "approval": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required"],
          "properties": {
            "required": {"type": "boolean"},
            "evidence_ref": {"type": "string", "pattern": "^docs/"}
          }
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "preferred_agent"],
          "properties": {
            "mode": {"enum": ["agent", "human", "agent_or_human"]},
            "preferred_agent": {"enum": ["jules", "human"]}
          }
        },
        "completion": {
          "type": "object",
          "additionalProperties": false,
          "required": ["require_merged_pr", "require_all_items_terminal", "evidence"],
          "properties": {
            "require_merged_pr": {"const": true},
            "require_all_items_terminal": {"const": true},
            "evidence": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "linked_pr_to_master_staging",
                  "required_checks_green",
                  "proposal_items_terminal",
                  "approval_evidence_present",
                  "idempotency_replay_test_green",
                  "deterministic_projection_fixture_green"
                ]
              }
            }
          }
        }
      }
    }
  }
}
