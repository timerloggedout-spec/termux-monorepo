{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timerloggedout-spec.github.io/termux-monorepo/polyglot/benchmark-result.schema.json",
  "title": "Matrice benchmark result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result_id",
    "domain",
    "target_id",
    "capability_ids",
    "benchmark",
    "baseline",
    "environment",
    "measurements",
    "correctness",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "result_id": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string"
    },
    "target_id": {
      "type": "string"
    },
    "capability_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "benchmark": {
      "type": "object",
      "required": [
        "suite_id",
        "suite_version",
        "workload_id"
      ],
      "properties": {
        "suite_id": {
          "type": "string"
        },
        "suite_version": {
          "type": "string"
        },
        "workload_id": {
          "type": "string"
        }
      }
    },
    "baseline": {
      "type": "object",
      "required": [
        "target_id",
        "revision"
      ],
      "properties": {
        "target_id": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        }
      }
    },
    "environment": {
      "type": "object",
      "required": [
        "os",
        "architecture"
      ],
      "properties": {
        "os": {
          "type": "string"
        },
        "architecture": {
          "type": "string"
        },
        "runtime": {
          "type": [
            "string",
            "null"
          ]
        },
        "hardware": {
          "type": [
            "string",
            "null"
          ]
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "measurements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "metric",
          "value",
          "unit"
        ],
        "properties": {
          "metric": {
            "type": "string"
          },
          "value": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          },
          "variance": {
            "type": [
              "number",
              "null"
            ]
          },
          "sample_count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          }
        }
      }
    },
    "correctness": {
      "enum": [
        "pass",
        "fail",
        "partial",
        "untested"
      ]
    },
    "provenance": {
      "type": "object",
      "required": [
        "producer",
        "source_revision",
        "measured_at"
      ],
      "properties": {
        "producer": {
          "type": "string"
        },
        "source_revision": {
          "type": "string"
        },
        "measured_at": {
          "type": "string",
          "format": "date-time"
        },
        "artifact_digest": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "parity_status": {
      "enum": [
        "unknown",
        "below",
        "parity",
        "above"
      ]
    },
    "advantage_claim": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
