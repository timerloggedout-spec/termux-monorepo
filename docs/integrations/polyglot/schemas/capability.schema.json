{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timerloggedout-spec.github.io/termux-monorepo/polyglot/capability.schema.json",
  "title": "PolyGlot capability",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capability_id",
    "name",
    "domain",
    "description",
    "status",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "capability_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "discovered",
        "specified",
        "mapped",
        "implemented",
        "verified",
        "benchmarked",
        "deprecated"
      ]
    },
    "guarantees": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "conformance_tests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_uri",
        "observed_at"
      ],
      "properties": {
        "source_uri": {
          "type": "string",
          "format": "uri"
        },
        "source_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "license": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
