{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/timerloggedout-spec/termux-monorepo/blob/master/docs/ops/AGENT-THROUGHPUT-EVENT.schema.json",
  "title": "Agent Throughput Event",
  "type": "object",
  "required": [
    "timestamp",
    "event"
  ],
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "event": {
      "enum": [
        "task_started",
        "task_completed",
        "tool_call",
        "tool_retry",
        "handoff",
        "active_window"
      ]
    },
    "agent_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "tool": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "success",
        "failed",
        "error",
        "skipped"
      ]
    },
    "duration_ms": {
      "type": "number",
      "minimum": 0
    },
    "latency_ms": {
      "type": "number",
      "minimum": 0
    },
    "active_seconds": {
      "type": "number",
      "minimum": 0
    },
    "inference_seconds": {
      "type": "number",
      "minimum": 0
    },
    "tokens_in": {
      "type": "number",
      "minimum": 0
    },
    "tokens_out": {
      "type": "number",
      "minimum": 0
    },
    "complexity_score": {
      "type": "number",
      "minimum": 0
    },
    "metrics": {
      "type": "object",
      "properties": {
        "additions": {
          "type": "number",
          "minimum": 0
        },
        "deletions": {
          "type": "number",
          "minimum": 0
        },
        "files_changed": {
          "type": "number",
          "minimum": 0
        },
        "complexity_score": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "gha_run_id": {
      "type": "integer",
      "minimum": 1
    },
    "gha_run_attempt": {
      "type": "integer",
      "minimum": 1
    },
    "source_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "adapter",
        "role",
        "identity_kind",
        "settings_fingerprint",
        "context_fingerprint",
        "attribution_method",
        "confidence",
        "evidence_refs"
      ],
      "properties": {
        "provider": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "model": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "adapter": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "role": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "identity_kind": {
          "enum": [
            "agent",
            "manager",
            "scout",
            "orchestrator",
            "infrastructure",
            "human",
            "unknown"
          ]
        },
        "settings_fingerprint": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "context_fingerprint": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "attribution_method": {
          "enum": [
            "workflow_name_mapping",
            "invocation_telemetry",
            "task_boundary_declared",
            "session_export",
            "human_attested",
            "inferred",
            "unresolved"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence_refs": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "controller",
        "surface",
        "route",
        "session_ref",
        "adapter_version",
        "attribution_method",
        "confidence",
        "evidence_refs"
      ],
      "properties": {
        "controller": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]*$",
          "minLength": 1,
          "maxLength": 128
        },
        "surface": {
          "enum": [
            "repo_owned_adapter",
            "external_computer",
            "seat_browser",
            "manual",
            "unknown"
          ]
        },
        "route": {
          "enum": [
            "api",
            "mcp",
            "web2api",
            "cli",
            "stdin",
            "dom_browser",
            "seat_browser",
            "manual",
            "unknown"
          ]
        },
        "session_ref": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^session:[a-z0-9_-]+:[A-Za-z0-9._-]{1,180}$",
          "maxLength": 256
        },
        "adapter_version": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$",
          "maxLength": 128
        },
        "attribution_method": {
          "enum": [
            "workflow_name_mapping",
            "invocation_telemetry",
            "task_boundary_declared",
            "session_export",
            "human_attested",
            "inferred",
            "unresolved"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence_refs": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#_-]{0,255}$",
            "minLength": 1,
            "maxLength": 256
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "controller": {
                "const": "que"
              }
            },
            "required": [
              "controller"
            ]
          },
          "then": {
            "properties": {
              "surface": {
                "const": "repo_owned_adapter"
              },
              "route": {
                "enum": [
                  "api",
                  "mcp",
                  "web2api",
                  "cli",
                  "stdin",
                  "dom_browser"
                ]
              },
              "session_ref": {
                "type": "string",
                "minLength": 1
              },
              "adapter_version": {
                "type": "string",
                "minLength": 1
              },
              "attribution_method": {
                "const": "invocation_telemetry"
              },
              "confidence": {
                "exclusiveMinimum": 0
              },
              "evidence_refs": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "event_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "cohort_id": {
      "type": "string",
      "minLength": 1
    },
    "task_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "task_contract_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "environment_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "github_actor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "triggering_actor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "workflow_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "workflow_run_url": {
      "type": "string",
      "pattern": "^https://",
      "maxLength": 2048
    },
    "workflow_event": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "job_id": {
      "type": "integer",
      "minimum": 1
    },
    "job_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "pull_request_number": {
      "type": "integer",
      "minimum": 1
    },
    "issue_number": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": false
}
