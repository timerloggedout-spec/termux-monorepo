{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/timerloggedout-spec/termux-monorepo/blob/master/docs/ops/OPS-EVENT-HITL.schema.json",
  "title":"OPS-EVENT HITL control-plane envelope",
  "type":"object","additionalProperties":false,
  "required":["schema_version","event_id","event_type","occurred_at","actor","scope","status","provenance"],
  "properties":{
    "schema_version":{"const":"ops-event.hitl.v1"},
    "event_id":{"type":"string","minLength":8,"maxLength":256},
    "event_type":{"type":"string","pattern":"^[a-z][a-z0-9_.-]{2,127}$"},
    "occurred_at":{"type":"string","format":"date-time"},
    "actor":{"type":"object","additionalProperties":false,"required":["kind","id"],"properties":{"kind":{"type":"string"},"id":{"type":"string"},"attribution_confidence":{"type":"number","minimum":0,"maximum":1}}},
    "scope":{"type":"object","additionalProperties":false,"required":["repo"],"properties":{"repo":{"type":"string","pattern":"^[^/\\s]+/[^/\\s]+$"},"ref":{"type":["string","null"]},"sha":{"type":["string","null"],"pattern":"^[0-9a-f]{7,40}$"},"entity_type":{"type":["string","null"]},"entity_id":{"type":["string","null"]}}},
    "status":{"type":"string","enum":["observed","draft","contextualized","policy_checked","awaiting_approval","approved","dispatched","running","effect_recorded","completed","failed","reconciled","partial","unverified","blocked"]},
    "correlation_id":{"type":["string","null"]},"causation_id":{"type":["string","null"]},
    "source_url":{"type":["string","null"],"format":"uri"},
    "evidence_refs":{"type":"array","items":{"type":"string"},"maxItems":50},
    "attributes":{"type":"object","additionalProperties":true},
    "context":{"type":["object","null"],"additionalProperties":false,"properties":{"verified_edges":{"type":"array","items":{"type":"string"}},"candidate_edges":{"type":"array","items":{"type":"string"}},"parent_url":{"type":["string","null"],"format":"uri"},"changed_files":{"type":"array","items":{"type":"string"}}}},
    "command":{"type":["object","null"],"additionalProperties":false,"properties":{"intent":{"type":"string"},"target":{"type":"string"},"approval_required":{"type":"boolean"},"approved_by":{"type":["string","null"]},"policy":{"type":["string","null"]}}},
    "projection":{"type":["object","null"],"additionalProperties":false,"properties":{"snapshot_id":{"type":"string"},"source_sha":{"type":["string","null"]},"event_start":{"type":["string","null"],"format":"date-time"},"event_end":{"type":["string","null"],"format":"date-time"},"event_count":{"type":["integer","null"],"minimum":0}}},
    "provenance":{"type":"object","additionalProperties":false,"required":["source"],"properties":{"source":{"type":"string"},"confidence":{"type":"number","minimum":0,"maximum":1}}}
  }
}