{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/timerloggedout-spec/termux-monorepo/blob/master/docs/ops/TOROIDAL-DOMAIN-RELATIONSHIP.schema.json",
  "title": "SHE Toroidal Domain Relationship Projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "source_ref",
    "source_sha",
    "generated_at",
    "coverage",
    "nodes",
    "edges"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "source_ref": {
      "type": "string",
      "minLength": 1
    },
    "source_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "COMPLETE",
            "PARTIAL_CONTINUATION_REQUIRED",
            "PARTIAL_BOUNDARY",
            "FAILED",
            "UNVERIFIED"
          ]
        },
        "next_start_page": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "layout_preset": {
      "type": "string",
      "enum": [
        "auto",
        "twelve-slot",
        "domain-cycle",
        "custom"
      ],
      "default": "auto"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ref"
      ],
      "properties": {
        "kind": {
          "enum": [
            "github_commit",
            "pull_request",
            "issue",
            "workflow_run",
            "artifact",
            "corpus_record",
            "snapshot",
            "external_reference"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "source_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "domain",
        "kind",
        "evidence_status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "evidence_status": {
          "enum": [
            "verified",
            "candidate",
            "inferred",
            "unknown"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "source_ref": {
          "type": "string"
        },
        "source_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "layout": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "major_angle": {
              "type": "number"
            },
            "minor_angle": {
              "type": "number"
            },
            "group": {
              "type": "string"
            }
          }
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "target",
        "relation_type",
        "status",
        "directionality",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "relation_type": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "verified",
            "candidate",
            "inferred",
            "unknown"
          ]
        },
        "directionality": {
          "enum": [
            "directed",
            "bidirectional",
            "symmetric"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "pair_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    }
  }
}
