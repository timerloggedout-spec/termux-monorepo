{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/timerloggedout-spec/termux-monorepo/blob/master/docs/ops/corpus/EVOLUTION-DESIGN.schema.json",
  "title": "Evolutionary Policy DoE Design",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "campaign_id",
    "seed",
    "factors",
    "arms",
    "control_arm_id",
    "execution_plane",
    "online_authority",
    "promotion_authority",
    "design_id"
  ],
  "properties": {
    "schema": {
      "const": "agent.evolution-doe-design.v1"
    },
    "campaign_id": {
      "type": "string",
      "minLength": 1
    },
    "seed": {
      "type": "integer"
    },
    "factors": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "enum": [
          "max_active",
          "min_score",
          "stop_after_terminal"
        ]
      },
      "properties": {
        "max_active": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1 }
        },
        "min_score": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": ["number", "null"]
          }
        },
        "stop_after_terminal": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "boolean" }
        }
      },
      "additionalProperties": false
    },
    "arms": {
      "type": "array",
      "minItems": 1,
      "contains": {
        "type": "object",
        "properties": {
          "role": {
            "const": "control"
          }
        },
        "required": [
          "role"
        ]
      },
      "minContains": 1,
      "maxContains": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "arm_id",
          "policy_id",
          "role",
          "policy"
        ],
        "properties": {
          "arm_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{16}$"
          },
          "policy_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{16}$"
          },
          "role": {
            "enum": [
              "control",
              "candidate"
            ]
          },
          "policy": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "max_active",
              "min_score",
              "stop_after_terminal"
            ],
            "properties": {
              "max_active": {
                "type": "integer",
                "minimum": 1
              },
              "min_score": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "stop_after_terminal": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "control_arm_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "execution_plane": {
      "const": "offline_replay"
    },
    "online_authority": {
      "const": "ATES_and_canonical_EXPERIMENT"
    },
    "promotion_authority": {
      "const": "proposal_lifecycle_and_dual_gate"
    },
    "design_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    }
  }
}
