{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://github.com/timerloggedout-spec/termux-monorepo/blob/master/docs/ops/corpus/LEARNING.schema.json","title":"Historical Learning Record","type":"object","additionalProperties":false,"required":["schema_version","learning_id","observed_at","experiment_id","evidence","decision","confidence"],"properties":{"schema_version":{"const":"1.0"},"learning_id":{"type":"string"},"observed_at":{"type":"string","format":"date-time"},"experiment_id":{"type":"string"},"cohort":{"type":"string"},"hypothesis":{"type":"string"},"treatment":{"type":"string"},"evidence":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["kind","ref"],"properties":{"kind":{"type":"string"},"ref":{"type":"string"},"sha":{"type":["string","null"],"pattern":"^(null|[0-9a-f]{40})$"}}}},"metrics":{"type":"object","additionalProperties":{"type":["number","integer","string","null"]}},"decision":{"type":"string","enum":["retain","adapt","cull","hold","inconclusive"]},"next_action":{"type":["string","null"]},"confidence":{"type":"string","enum":["high","medium","low"]}}}