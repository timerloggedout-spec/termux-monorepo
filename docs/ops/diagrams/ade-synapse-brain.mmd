    classDef partial fill:#fff1cc,stroke:#a87512,color:#503900
    classDef proposed fill:#e9e2f8,stroke:#6c4aa1,color:#30204d
    class IN,ATT,MEM,EXE,SEL,ACT,EVD,FB existing
    class COORD,SAFE partial
    class DMN,NOV,CONS,PLAST proposed
