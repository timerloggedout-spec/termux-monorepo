{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/timerloggedout-spec/termux-monorepo/blob/master/docs/ops/pcdoe/DO-STATEMENT.schema.json",
  "title": "PCDOE DO Statement",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "statement_id", "scope", "action", "constraints", "output", "state", "owner_ref", "acceptance", "evidence", "approval_class", "created_at", "updated_at", "version"],
  "properties": {
    "schema_version": { "const": "pcdoe.do-statement.v1" },
    "statement_id": { "type": "string", "minLength": 1 },
    "scope": { "type": "string", "minLength": 1 },
    "action": { "type": "string", "minLength": 1 },
    "constraints": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "output": { "type": "string", "minLength": 1 },
    "state": { "enum": ["proposed", "admitted", "claimed", "executing", "completed", "verified", "promoted", "blocked", "cancelled"] },
    "owner_ref": { "type": "string", "minLength": 1 },
    "acceptance": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "required"],
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" },
          "schema_ref": { "type": ["string", "null"], "format": "uri-reference" }
        }
      }
    },
    "approval_class": { "enum": ["preauthorized_low_risk", "review_required", "operator_required", "security_required"] },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "version": { "type": "integer", "minimum": 1 },
    "parent_statement_id": { "type": ["string", "null"] }
  }
}
