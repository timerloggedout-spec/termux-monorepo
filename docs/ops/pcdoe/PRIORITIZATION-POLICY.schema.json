{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/timerloggedout-spec/termux-monorepo/blob/master/docs/ops/pcdoe/PRIORITIZATION-POLICY.schema.json",
  "title": "PCDOE Prioritization Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_id", "version", "treatment_type", "hypothesis", "factors", "constraints", "missing_data", "tie_breaks", "outcomes", "owner_ref"],
  "properties": {
    "schema_version": { "const": "pcdoe.priority-policy.v1" },
    "policy_id": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "treatment_type": { "enum": ["incumbent", "value_density", "critical_path", "dependency_unlock", "risk_adjusted", "balanced"] },
    "hypothesis": { "type": "string", "minLength": 1 },
    "factors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["factor_id", "direction", "weight", "source_ref"],
        "properties": {
          "factor_id": { "type": "string", "minLength": 1 },
          "direction": { "enum": ["maximize", "minimize", "constraint", "report_only"] },
          "weight": { "type": "number", "minimum": 0, "maximum": 1 },
          "source_ref": { "type": "string", "minLength": 1 }
        }
      }
    },
    "constraints": { "type": "array", "items": { "type": "string" } },
    "missing_data": { "enum": ["preserve_unknown_and_reduce_confidence"] },
    "tie_breaks": { "type": "array", "items": { "type": "string" } },
    "outcomes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "owner_ref": { "type": "string", "minLength": 1 }
  }
}
