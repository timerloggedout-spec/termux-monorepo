{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/timerloggedout-spec/termux-monorepo/blob/master/docs/ops/rfp/LANE-COMPOSITION.schema.json",
  "title": "RFP DoE Lane Composition Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "composition_id",
    "version",
    "pattern",
    "task_contract",
    "lanes",
    "topology",
    "compatibility",
    "design",
    "governance"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "composition_id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9._-]{1,63}$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "pattern": {
      "enum": [
        "parallel_arms",
        "sequential_handoff",
        "phase_specialized",
        "ensemble_consensus",
        "conditional_routing",
        "complementary",
        "mixed_factorial"
      ]
    },
    "task_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "inputs",
        "outputs",
        "success_criteria"
      ],
      "properties": {
        "contract_id": {
          "type": "string"
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "success_criteria": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    },
    "lanes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lane_id",
          "candidate_id",
          "role",
          "configured_instance_key"
        ],
        "properties": {
          "lane_id": {
            "type": "string"
          },
          "candidate_id": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "configured_instance_key": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^([0-9a-f]{64})?$"
          },
          "phase_ownership": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 13
            }
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    },
    "topology": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from_lane",
          "to_lane",
          "transition",
          "condition"
        ],
        "properties": {
          "from_lane": {
            "type": "string"
          },
          "to_lane": {
            "type": "string"
          },
          "transition": {
            "enum": [
              "parallel",
              "handoff",
              "review",
              "route",
              "consensus",
              "merge"
            ]
          },
          "condition": {
            "type": "string"
          },
          "input_mapping": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_compatibility",
        "provenance_preservation",
        "security_review",
        "license_review",
        "capacity_review",
        "failure_semantics",
        "human_approval"
      ],
      "properties": {
        "schema_compatibility": {
          "enum": [
            "pass",
            "conditional",
            "fail",
            "pending"
          ]
        },
        "provenance_preservation": {
          "enum": [
            "pass",
            "conditional",
            "fail",
            "pending"
          ]
        },
        "security_review": {
          "enum": [
            "pass",
            "conditional",
            "fail",
            "pending"
          ]
        },
        "license_review": {
          "enum": [
            "pass",
            "conditional",
            "fail",
            "pending"
          ]
        },
        "capacity_review": {
          "enum": [
            "pass",
            "conditional",
            "fail",
            "pending"
          ]
        },
        "failure_semantics": {
          "enum": [
            "pass",
            "conditional",
            "fail",
            "pending"
          ]
        },
        "human_approval": {
          "enum": [
            "required",
            "granted",
            "not_required",
            "pending"
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "campaign_id",
        "design_class",
        "factors",
        "responses",
        "baseline",
        "randomization",
        "stopping_rule"
      ],
      "properties": {
        "campaign_id": {
          "type": "string"
        },
        "design_class": {
          "type": "string"
        },
        "factors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "levels"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "levels": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 2
              }
            }
          },
          "minItems": 1
        },
        "responses": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "baseline": {
          "type": "string"
        },
        "randomization": {
          "type": "string"
        },
        "blocking": {
          "type": [
            "string",
            "null"
          ]
        },
        "replication": {
          "type": [
            "string",
            "null"
          ]
        },
        "stopping_rule": {
          "type": "string"
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "owner",
        "production_routing_authorized"
      ],
      "properties": {
        "state": {
          "enum": [
            "draft",
            "compatibility_pending",
            "eligible_for_preregistration",
            "preregistered",
            "admitted_design_only",
            "executing",
            "validated",
            "promoted",
            "retained",
            "culled",
            "deferred",
            "blocked",
            "superseded"
          ]
        },
        "owner": {
          "type": "string"
        },
        "production_routing_authorized": {
          "const": false
        },
        "decision_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "review_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    }
  }
}
