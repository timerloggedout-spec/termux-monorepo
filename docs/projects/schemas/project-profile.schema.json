{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/timerloggedout-spec/termux-monorepo/blob/master/docs/projects/schemas/project-profile.schema.json",
  "title": "MonoRepo Project Profile",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "project_id",
    "slug",
    "display_name",
    "status",
    "repositories",
    "architecture",
    "game",
    "knowledge_access",
    "lanes"
  ],
  "properties": {
    "schema": {
      "const": "project-profile/v1"
    },
    "project_id": {
      "type": "string",
      "pattern": "^project:[a-z0-9][a-z0-9-]*$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "proposed",
        "active",
        "paused",
        "archived"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date"
    },
    "repositories": {
      "type": "object",
      "required": [
        "product",
        "control_plane",
        "research"
      ]
    },
    "architecture": {
      "type": "object",
      "required": [
        "contract",
        "stable_project_ref",
        "planes"
      ]
    },
    "game": {
      "type": "object",
      "required": [
        "project_kind",
        "genre_facets",
        "scales",
        "engine"
      ]
    },
    "knowledge_access": {
      "type": "object",
      "required": [
        "policy",
        "shared_knowledge_graph",
        "lenses"
      ]
    },
    "lanes": {
      "type": "object",
      "required": [
        "primary",
        "supporting"
      ]
    }
  }
}
