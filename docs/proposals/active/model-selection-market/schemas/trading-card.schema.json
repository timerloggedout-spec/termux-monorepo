{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timerloggedout-spec.github.io/termux-monorepo/schemas/trading-card.schema.json",
  "title": "TradingCard",
  "description": "Role-scoped negotiable code/meta card for model-selection-market. No secrets.",
  "type": "object",
  "required": ["card_id", "role", "owner", "share"],
  "additionalProperties": false,
  "properties": {
    "card_id": { "type": "string", "minLength": 8 },
    "role": {
      "oneOf": [
        { "type": "string", "enum": ["triage", "review", "invoke"] },
        { "type": "string", "pattern": "^(job|engine):[a-z0-9._-]+$" }
      ]
    },
    "owner": { "type": "string", "minLength": 1 },
    "artifact": {
      "type": "object",
      "properties": {
        "path": { "type": "string" },
        "blob_sha": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" }
      },
      "additionalProperties": false
    },
    "opt_script": {
      "type": ["object", "null"],
      "properties": {
        "path": { "type": "string" },
        "blob_sha": { "type": "string" }
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "properties": {
        "elo": { "type": "number" },
        "n": { "type": "integer", "minimum": 0 },
        "last_sha": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "share": { "type": "string", "enum": ["private", "role", "public"] },
    "trade_log": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["at", "from", "to", "action"],
        "properties": {
          "at": { "type": "string", "format": "date-time" },
          "from": { "type": "string" },
          "to": { "type": "string" },
          "action": { "type": "string", "enum": ["offer", "accept", "revoke", "settle"] },
          "sha": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  }
}
