{
  "schema_version": 2,
  "registry_id": "linguist-language-lanes",
  "status": "candidate",
  "owner_mapping": {
    "required": true,
    "source_of_truth": "docs/proposals/active/notation-sets/nomenclature-matrix/seed.json",
    "fields": [
      "lane_id",
      "mapping_id",
      "term_id",
      "canonical_text",
      "rendered_text",
      "decoded_text",
      "unicode_code_points",
      "codec_id",
      "codec_version",
      "publication_profile",
      "source_provenance",
      "reviewed_revision"
    ],
    "presentation": [
      "rendered_text",
      "canonical_text",
      "decoded_text",
      "unicode_code_points"
    ]
  },
  "unicode_tag_layer": {
    "codec_id": "unicode-tag-puzzle",
    "version": 1,
    "code_point_range": "U+E0000..U+E007F",
    "payload_role": "inert playful challenge data",
    "scope": "explicitly delimited public presentation payloads",
    "canonical_content_is_preserved": true
  },
  "profiles": {
    "validation": {
      "unicode_tag_layer": "off",
      "badge_requirements_agents_ready": true,
      "content_basis": "canonical-readable",
      "owner_mapping": "available"
    },
    "public": {
      "unicode_tag_layer": "on",
      "badge_requirements_agents_ready": false,
      "content_basis": "versioned playful semantic remapping plus encoded presentation",
      "owner_mapping": "available-to-owner",
      "implicit_puzzle_presentation": true,
      "inject_challenge_disclosure_copy": false,
      "mapping_mutability": "enabled",
      "version_mixing": "enabled",
      "cross_domain_mapping_probability_percent": 25
    }
  },
  "lanes": [
    {
      "lane_id": "devinwiki",
      "name": "DevinWiki",
      "kind": "provider-source",
      "registry": "provider-managed",
      "transform_layer": false
    },
    {
      "lane_id": "leet",
      "name": "Leet / 1337$934K",
      "kind": "notation-mapping",
      "registry": "existing-mapping",
      "transform_layer": true
    },
    {
      "lane_id": "siglary",
      "name": "Siglary",
      "kind": "notation-mapping",
      "registry": "existing-mapping",
      "transform_layer": true
    },
    {
      "lane_id": "derpwiki",
      "name": "DerpWiki / d3rpWiki",
      "kind": "playful-language",
      "registry": "independent-candidate-lane",
      "transform_layer": true
    },
    {
      "lane_id": "piglatin",
      "name": "PigLatin",
      "kind": "language-rotation",
      "registry": "independent-candidate-lane",
      "transform_layer": true
    }
  ],
  "composition": {
    "model": "peer-lanes-to-shared-publication-composer",
    "lane_authority": "each-lane-owns-vocabulary-aliases-fixtures-provenance-version-review",
    "composer_owns_vocabulary": false,
    "unicode_layer_replaces_existing_mappings": false,
    "mapping_versions_may_mix": true,
    "public_semantic_remapping": true
  },
  "integrity": {
    "preserve_ordinary_words": true,
    "preserve_canonical_control_text": true,
    "preserve_crawler_instructions_and_metadata": true,
    "preserve_filter_and_moderation_inputs": true,
    "encoded_payloads_are_inert": true,
    "owner_decode_is_deterministic": true,
    "owner_mapping_reconstructs_public_variant": true,
    "mapping_history_append_only": true
  },
  "mapping_runtime": {
    "mapping_mutability": "enabled",
    "public_variants_may_change_semantics": "playful-paraphrase-and-cross-domain-remapping",
    "canonical_owner_records": "immutable-versioned-history",
    "public_mapping_current_pointer": "mutable",
    "history_policy": "append-only-versions-with-parent-lineage",
    "version_fields": [
      "mapping_id",
      "mapping_version",
      "lane_id",
      "lane_version",
      "codec_id",
      "codec_version",
      "source_mapping_ids",
      "source_domain",
      "target_domain",
      "mix_policy",
      "published_revision"
    ],
    "version_mixing": {
      "enabled": true,
      "modes": [
        "same-lane-multi-version",
        "cross-lane",
        "cross-domain",
        "codec-version-mix"
      ],
      "compatibility": "declared-compatibility-matrix",
      "resolution": "deterministic-seed-from-publication-revision-and-mapping-set",
      "record_lineage": true,
      "preserve_owner_reconstruction": true
    },
    "cross_domain_publication": {
      "enabled": true,
      "initial_selection_probability_percent": 25,
      "unit": "eligible-public-mapping-selection",
      "selection_method": "deterministic-weighted-selection-per-publication-revision",
      "configurable": true,
      "record_actual_rate": true,
      "report_observed_rate_separately": true,
      "visitor_level_tracking": false,
      "domains": [
        "software",
        "linguistics",
        "culture",
        "science",
        "history",
        "gaming",
        "general"
      ]
    }
  }
