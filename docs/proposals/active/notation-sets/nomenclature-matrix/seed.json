    },
    {
      "concept_id": "knowledge_organization.lexical_label",
      "domain_id": "knowledge_organization",
      "preferred_label": "lexical label",
      "definition": "A language-tagged string used to name or refer to a concept; preferred, alternative, and hidden labels serve different presentation and retrieval roles.",
      "status": "candidate",
      "version": 1,
      "source_ids": [
        "w3c-skos-reference",
        "w3c-skos-primer"
      ]
    },
    {
      "concept_id": "knowledge_organization.controlled_vocabulary",
      "domain_id": "knowledge_organization",
      "preferred_label": "controlled vocabulary",
      "definition": "A curated set of terms used consistently to describe, index, retrieve, or organize information; mappings between vocabularies require explicit relationship types.",
      "status": "candidate",
      "version": 1,
      "source_ids": [
        "dariah-controlled-vocabularies",
        "getty-cona-intro"
      ]
    },
    {
      "concept_id": "terminology.colloquial_to_formal_mapping",
      "domain_id": "terminology_management",
      "preferred_label": "colloquial-to-formal terminology mapping",
      "definition": "A documented association between practitioner or community language and a formal vocabulary concept, preserving the source expression and the confidence and scope of the mapping.",
      "status": "candidate",
      "version": 1,
      "source_ids": [
        "cwld-colloquial-ontology",
        "w3c-skos-reference"
      ]
    },
    {
      "concept_id": "linguistics.near_synonymy",
      "domain_id": "lexical_semantics",
      "preferred_label": "near-synonymy",
      "definition": "A relationship between expressions with similar but not necessarily identical meaning; context and sense must be checked before treating them as interchangeable.",
      "status": "candidate",
      "version": 1,
      "source_ids": [
        "synonyms-near-synonyms-research",
        "wolfram-worddata"
      ]
    },
    {
      "concept_id": "group_theory.group",
      "domain_id": "group_theory",
      "preferred_label": "group",
      "definition": "A set G with an associative binary operation, an identity element, and an inverse for every element.",
      "status": "candidate",
      "version": 1,
      "source_ids": [
        "dummit-foote-abstract-algebra",
        "fraleigh-abstract-algebra"
      ]
    },
    {
      "concept_id": "group_theory.identity_element",
      "domain_id": "group_theory",
      "preferred_label": "identity element",
      "definition": "The unique element e of a group with e·g = g·e = g for every element g.",
      "status": "candidate",
      "version": 1,
      "source_ids": [
        "dummit-foote-abstract-algebra",
        "fraleigh-abstract-algebra"
      ]
    },
    {
      "concept_id": "group_theory.inverse",
      "domain_id": "group_theory",
      "preferred_label": "inverse",
      "definition": "For an element g, the unique element g⁻¹ with g·g⁻¹ = g⁻¹·g = e.",
      "status": "candidate",
      "version": 1,
      "source_ids": [
        "dummit-foote-abstract-algebra",
        "fraleigh-abstract-algebra"
      ]
    },
    {
      "concept_id": "group_theory.binary_operation",
      "domain_id": "group_theory",
      "preferred_label": "binary operation (group operation / composition)",
      "definition": "The operation · : G × G → G combining two elements; written multiplicatively, additively, or as composition depending on convention.",
      "status": "candidate",
      "version": 1,
      "source_ids": [
        "dummit-foote-abstract-algebra",
        "fraleigh-abstract-algebra"
      ]
    },
    {
      "concept_id": "group_theory.subgroup",
      "domain_id": "group_theory",
      "preferred_label": "subgroup",
      "definition": "A subset H of a group G that is itself a group under the restricted operation (written H ≤ G).",
      "status": "candidate",
      "version": 1,
      "source_ids": [
        "dummit-foote-abstract-algebra",
        "fraleigh-abstract-algebra"
      ]
    },
    {
      "concept_id": "group_theory.normal_subgroup",
      "domain_id": "group_theory",
      "preferred_label": "normal subgroup",
      "definition": "A subgroup N with gNg⁻¹ = N for every g in G (written N ⊲ G); exactly the kernels of homomorphisms and the denominators of quotient groups.",
      "status": "candidate",
      "version": 1,
      "source_ids": [
        "dummit-foote-abstract-algebra",
        "fraleigh-abstract-algebra"
      ]
    },
    {
      "concept_id": "group_theory.quotient_group",
      "domain_id": "group_theory",
      "preferred_label": "quotient group",
      "definition": "For a normal subgroup N, the group G/N of cosets of N with operation induced from G.",
      "status": "candidate",
      "version": 1,
      "source_ids": [
        "dummit-foote-abstract-algebra",
        "fraleigh-abstract-algebra"
      ]
    },
    {
      "concept_id": "group_theory.homomorphism",
      "domain_id": "group_theory",
      "preferred_label": "group homomorphism",
      "definition": "A map φ: G → H with φ(ab) = φ(a)φ(b) for all a, b in G.",
      "status": "candidate",
      "version": 1,
      "source_ids": [
        "dummit-foote-abstract-algebra",
        "fraleigh-abstract-algebra"
      ]
    },
    {
      "concept_id": "group_theory.isomorphism",
      "domain_id": "group_theory",
      "preferred_label": "group isomorphism",
      "definition": "A bijective homomorphism; groups related by one (G ≅ H) have identical group structure.",
      "status": "candidate",
      "version": 1,
      "source_ids": [
        "dummit-foote-abstract-algebra",
        "fraleigh-abstract-algebra"
      ]
    },
    {
      "concept_id": "group_theory.abelian_group",
      "domain_id": "group_theory",
      "preferred_label": "abelian group",
      "definition": "A group whose operation commutes: ab = ba for all elements. 'Commutative group' is the same concept.",
      "status": "candidate",
      "version": 1,
      "source_ids": [
        "dummit-foote-abstract-algebra",
        "fraleigh-abstract-algebra"
      ]
    },
    {
      "concept_id": "group_theory.group_action",
      "domain_id": "group_theory",
      "preferred_label": "group action",
      "definition": "A homomorphism from G into the symmetry group of a set X; equivalently a map G × X → X compatible with the operation and identity (written G ↷ X).",
      "status": "candidate",
      "version": 1,
      "source_ids": [
        "dummit-foote-abstract-algebra",
        "fraleigh-abstract-algebra"
      ]
    },
    {
      "concept_id": "group_theory.symmetry_group",
      "domain_id": "group_theory",
      "preferred_label": "symmetry group",
      "definition": "The group of all structure-preserving bijections of an object or set under composition; for a set X, Sym(X).",
      "status": "candidate",
      "version": 1,
      "source_ids": [
        "dummit-foote-abstract-algebra",
        "fraleigh-abstract-algebra"
      ]
    },
    {
      "concept_id": "group_theory.category_of_groups",
      "domain_id": "group_theory",
      "preferred_label": "category of groups (Grp)",
      "definition": "The category whose objects are groups and whose morphisms are group homomorphisms.",
      "status": "candidate",
      "version": 1,
      "source_ids": [
        "dummit-foote-abstract-algebra",
        "fraleigh-abstract-algebra"
      ]
    },
    {
      "concept_id": "group_theory.kernel",
      "domain_id": "group_theory",
      "preferred_label": "kernel of a homomorphism",
      "definition": "For a homomorphism φ: G → H, ker φ = {g in G : φ(g) = e_H}; always a normal subgroup of G. It measures exactly what φ collapses — the loss of a lossy map.",
      "status": "candidate",
      "version": 1,
      "source_ids": [
        "dummit-foote-abstract-algebra",
        "fraleigh-abstract-algebra"
      ]
    }
  ],
