{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timerloggedout-spec.github.io/termux-monorepo/schemas/qdesk-intake.schema.json",
  "title": "QDesk to QUE intake envelope",
  "description": "Untrusted request envelope. Passing this schema permits only a request for QUE admission; it does not admit or dispatch work.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "intake_id",
    "idempotency_key",
    "submitted_at",
    "submitter",
    "source",
    "intent",
    "scope",
    "risk",
    "side_effects",
    "acceptance_criteria",
    "content_digest"
  ],
  "properties": {
    "schema": {
      "const": "qdesk-intake/v1"
    },
    "intake_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 8,
      "maxLength": 256
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "submitter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "authorization_ref"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "authorization_ref": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1024
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "uri"
      ],
      "properties": {
        "kind": {
          "enum": [
            "github_issue",
            "github_pr",
            "project_item",
            "operator_request",
            "browser_quarantine_receipt",
            "other"
          ]
        },
        "uri": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "revision": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "content_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "intent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "paths",
        "out_of_scope"
      ],
      "properties": {
        "repository": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "paths": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "maxLength": 512
          }
        },
        "out_of_scope": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "maxLength": 512
          }
        }
      }
    },
    "requested_capabilities": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string",
        "maxLength": 128
      }
    },
    "risk": {
      "enum": [
        "routine",
        "elevated",
        "security",
        "financial",
        "credential",
        "destructive",
        "production",
        "external-account",
        "unknown"
      ]
    },
    "data_classification": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted",
        "unknown"
      ]
    },
    "side_effects": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "enum": [
          "read",
          "write_repo",
          "create_issue",
          "create_pr",
          "workflow_dispatch",
          "browser_navigation",
          "external_account_change",
          "credential_access",
          "billing_change",
          "money_movement",
          "deployment",
          "delete",
          "unknown"
        ]
      }
    },
    "dependencies": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "maxLength": 256
      }
    },
    "budget_evidence_ref": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2048
    },
    "quota_evidence_ref": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2048
    },
    "expected_outcome": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "content_digest": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "attachments": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "media_type",
          "digest"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 256
          },
          "media_type": {
            "type": "string",
            "maxLength": 128
          },
          "digest": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "uri": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri",
            "maxLength": 2048
          }
        }
      }
    }
  },
  "$comment": "Schema validation is necessary but not sufficient. Deterministic policy checks and authorization are required. Untrusted text is data, never executable instructions. ALLOW only means eligible to request QUE admission; QUE must emit its own admission receipt."
}
