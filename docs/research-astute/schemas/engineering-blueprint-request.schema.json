{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://researchastute.org/schemas/engineering-blueprint-request.schema.json",
  "title": "Engineering Blueprint Research Request Registry",
  "type": "object",
  "required": [
    "schema_version",
    "registry_kind",
    "authority",
    "policy",
    "blueprint_schema",
    "requests"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "registry_kind": {
      "const": "engineering-blueprint-research-requests"
    },
    "authority": {
      "const": "Research-Astute"
    },
    "policy": {
      "type": "string"
    },
    "blueprint_schema": {
      "type": "string"
    },
    "requests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "request_id",
          "blueprint_id",
          "organization",
          "subject",
          "collection",
          "priority",
          "status",
          "scope",
          "research_questions",
          "required_views",
          "initial_evidence",
          "deliverables",
          "open_questions"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "pattern": "^EBR-[A-Z0-9-]+$"
          },
          "blueprint_id": {
            "type": "string"
          },
          "organization": {
            "type": "string"
          },
          "subject": {
            "type": "object",
            "required": [
              "name",
              "subject_type"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "subject_type": {
                "enum": [
                  "organization",
                  "program",
                  "mission",
                  "vehicle",
                  "spacecraft",
                  "launch_system",
                  "energy_system",
                  "manufacturing_system",
                  "software_platform",
                  "subsystem",
                  "technology",
                  "other"
                ]
              }
            },
            "additionalProperties": true
          },
          "collection": {
            "type": "string",
            "pattern": "^Research-Astute/"
          },
          "priority": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "status": {
            "enum": [
              "request-seeded",
              "discovery",
              "evidence-gathering",
              "draft-map",
              "review",
              "validated",
              "published",
              "blocked"
            ]
          },
          "scope": {
            "type": "object",
            "required": [
              "included",
              "excluded",
              "as_of"
            ],
            "properties": {
              "included": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "excluded": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "as_of": {
                "type": "string",
                "format": "date"
              }
            },
            "additionalProperties": true
          },
          "research_questions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "required_views": {
            "type": "array",
            "items": {
              "enum": [
                "context",
                "functional",
                "logical",
                "physical",
                "software",
                "hardware",
                "deployment",
                "operational",
                "data",
                "safety",
                "cybersecurity",
                "manufacturing",
                "supply-chain",
                "maintenance",
                "lifecycle",
                "power",
                "thermal"
              ]
            }
          },
          "initial_evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "evidence_id",
                "evidence_state",
                "source_url",
                "publisher",
                "claim_or_artifact"
              ],
              "properties": {
                "evidence_id": {
                  "type": "string"
                },
                "evidence_state": {
                  "enum": [
                    "primary-source",
                    "secondary-source",
                    "analyst-inference",
                    "unverified-lead"
                  ]
                },
                "source_url": {
                  "type": "string",
                  "format": "uri"
                },
                "publisher": {
                  "type": "string"
                },
                "claim_or_artifact": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          },
          "deliverables": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "open_questions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
