{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://researchastute.org/schemas/research-source.schema.json",
  "title": "Research Source",
  "type": "object",
  "required": [
    "source_id",
    "title",
    "source_type",
    "canonical_url",
    "access_mode",
    "discovery",
    "ingestion_state"
  ],
  "properties": {
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "abstract": {
      "type": "string"
    },
    "source_type": {
      "enum": [
        "paper",
        "patent",
        "repository",
        "dataset",
        "technical_report",
        "book",
        "standard",
        "web_page",
        "software_release",
        "other"
      ]
    },
    "publisher": {
      "type": "string"
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "canonical_url": {
      "type": "string",
      "format": "uri"
    },
    "source_urls": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "identifiers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "scheme",
          "value"
        ],
        "properties": {
          "scheme": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "published_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time"
    },
    "license": {
      "type": [
        "string",
        "null"
      ]
    },
    "rights_url": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "access_mode": {
      "enum": [
        "open",
        "registration_required",
        "restricted",
        "metadata_only",
        "unknown"
      ]
    },
    "mime_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "original_size_bytes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "extracted_size_bytes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "stored_size_bytes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "storage_uri": {
      "type": [
        "string",
        "null"
      ]
    },
    "revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "discovery": {
      "type": "object",
      "required": [
        "provider",
        "query",
        "observed_at"
      ],
      "properties": {
        "provider": {
          "type": "string"
        },
        "query": {
          "type": "string"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "provider_record_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "ingestion_state": {
      "enum": [
        "discovered",
        "resolved",
        "classified",
        "fetched",
        "hashed",
        "extracted",
        "linked",
        "validated",
        "indexed",
        "documented",
        "skipped",
        "restricted",
        "unsupported",
        "partial",
        "retryable_failure",
        "permanent_failure"
      ]
    },
    "extraction": {
      "type": "object",
      "properties": {
        "tool": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "value"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "locator": {
            "type": [
              "string",
              "null"
            ]
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  },
  "additionalProperties": false
}
