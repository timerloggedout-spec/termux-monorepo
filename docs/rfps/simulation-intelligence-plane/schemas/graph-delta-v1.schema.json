{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/timerloggedout-spec/termux-monorepo/blob/master/docs/rfps/simulation-intelligence-plane/schemas/graph-delta-v1.schema.json",
  "title": "Simulation Graph Delta v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "base_graph_sha256",
    "overlay_id",
    "nodes",
    "edges",
    "promotion_state"
  ],
  "properties": {
    "schema_version": {
      "const": "sip.graph-delta.v1"
    },
    "run_id": {
      "type": "string"
    },
    "base_graph_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "overlay_id": {
      "type": "string",
      "minLength": 1
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "synthetic"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^synthetic:"
          },
          "kind": {
            "type": "string"
          },
          "synthetic": {
            "const": true
          },
          "attributes": {
            "type": "object"
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "target",
          "relation",
          "evidence_class"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "relation": {
            "type": "string"
          },
          "evidence_class": {
            "const": "simulation_observation"
          },
          "event_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "promotion_state": {
      "const": "not_promotable_from_simulation_alone"
    },
    "review_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
