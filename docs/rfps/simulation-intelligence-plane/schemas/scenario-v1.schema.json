{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/timerloggedout-spec/termux-monorepo/blob/master/docs/rfps/simulation-intelligence-plane/schemas/scenario-v1.schema.json",
  "title": "Simulation Scenario v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_id",
    "title",
    "objective",
    "source_cohort",
    "graph_snapshot",
    "assumptions",
    "environment",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "sip.scenario.v1"
    },
    "scenario_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "source_cohort": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cohort_id",
        "evidence_manifest_sha256"
      ],
      "properties": {
        "cohort_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_refs": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "graph_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_id",
        "sha256",
        "layer"
      ],
      "properties": {
        "snapshot_id": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "layer": {
          "enum": [
            "source_graph",
            "derived_graph"
          ]
        },
        "builder_version": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "statement": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "declared",
              "inferred",
              "synthetic"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "max_agents",
        "max_steps",
        "activation_probability",
        "max_wall_seconds"
      ],
      "properties": {
        "platform": {
          "enum": [
            "oasis-twitter",
            "oasis-reddit",
            "oasis-custom",
            "mesa",
            "deterministic-fake"
          ]
        },
        "max_agents": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "max_steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "activation_probability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "max_wall_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "max_cost_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "public_platform_actions": {
          "const": false
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "created_at",
        "created_by",
        "generator_version"
      ],
      "properties": {
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "created_by": {
          "type": "string"
        },
        "generator_version": {
          "type": "string"
        },
        "prompt_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
