{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Termux Monorepo FOSS Foresight Resource Registry",
  "type": "object",
  "required": [
    "schema_version",
    "registry_id",
    "updated_at",
    "policy",
    "resources"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "registry_id": {
      "type": "string"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "maintainer": {
      "type": "string"
    },
    "policy": {
      "type": "object",
      "required": [
        "horizons",
        "evidence_status",
        "canonical_evidence_plane",
        "vendor_neutrality",
        "missing_evidence",
        "secrets_allowed"
      ]
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "category",
          "horizon",
          "evidence_status",
          "canonical_sources",
          "capabilities",
          "lock_in_risk",
          "egress_risk",
          "reproducibility",
          "procurement_action",
          "unresolved"
        ]
      }
    }
  }
}
