{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:timerloggedout-spec:cns:writer-lease-receipt:v1",
  "title": "CNS Writer Lease Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lease_id",
    "lease_key",
    "resource",
    "owner",
    "epoch",
    "state",
    "observed_at",
    "expires_at",
    "evidence_ref"
  ],
  "properties": {
    "schema_version": { "const": "cns-writer-lease/v1" },
    "lease_id": { "type": "string", "minLength": 1 },
    "lease_key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*:.+:[1-9][0-9]*:[0-9a-f]{40}$"
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_id", "pull_request_number", "revision_sha"],
      "properties": {
        "repository_id": { "type": "string", "minLength": 1 },
        "pull_request_number": { "type": "integer", "minimum": 1 },
        "revision_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_id", "agent_id", "adapter_id", "invocation_id"],
      "properties": {
        "provider_id": { "type": "string", "minLength": 1 },
        "agent_id": { "type": "string", "minLength": 1 },
        "adapter_id": { "type": "string", "minLength": 1 },
        "invocation_id": { "type": "string", "minLength": 1 }
      }
    },
    "epoch": { "type": "integer", "minimum": 1 },
    "state": {
      "type": "string",
      "enum": ["acquired", "renewed", "released", "expired", "rejected", "recovered"]
    },
    "observed_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "evidence_ref": { "type": "string", "minLength": 1 }
  }
}
