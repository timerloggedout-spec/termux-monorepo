{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/timerloggedout-spec/termux-monorepo/blob/master/docs/schemas/collaborator-lifecycle.schema.json",
  "title": "Collaborator Lifecycle Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "collaborator_id",
    "identity",
    "declared_roles",
    "adapter_refs",
    "lifecycle",
    "provenance",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "collaborator_id": {
      "type": "string",
      "minLength": 1
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "display_name"
      ],
      "properties": {
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "moniker_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "github_actor": {
          "type": [
            "string",
            "null"
          ]
        },
        "provider_account_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "human_operator_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "declared_roles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "adapter_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "lifecycle": {
      "enum": [
        "discovered",
        "profiled",
        "qualified",
        "admitted",
        "active",
        "evaluated",
        "retained",
        "promoted",
        "quarantined",
        "culled"
      ]
    },
    "scope": {
      "type": "object",
      "properties": {
        "repositories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "operations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "data_classes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "observed_at",
        "source_ref"
      ],
      "properties": {
        "state": {
          "enum": [
            "available",
            "unavailable",
            "unknown",
            "stale",
            "capacity_limited"
          ]
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "policy_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "owner": {
      "type": [
        "string",
        "null"
      ]
    },
    "review_due_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
