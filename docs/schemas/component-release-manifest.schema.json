{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/timerloggedout-spec/termux-monorepo/blob/master/docs/schemas/component-release-manifest.schema.json",
  "title": "Component Release Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "component_id",
    "version",
    "source",
    "released_at",
    "contracts",
    "dependencies",
    "validation",
    "promotion"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "component_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "ref",
        "sha"
      ],
      "properties": {
        "repository": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        },
        "sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "released_at": {
      "type": "string",
      "format": "date-time"
    },
    "release_owner": {
      "type": [
        "string",
        "null"
      ]
    },
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "component_id",
          "version_range",
          "compatibility"
        ],
        "properties": {
          "component_id": {
            "type": "string"
          },
          "version_range": {
            "type": "string"
          },
          "compatibility": {
            "enum": [
              "compatible",
              "conditionally_compatible",
              "incompatible",
              "untested"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "properties": {
        "os": {
          "type": [
            "string",
            "null"
          ]
        },
        "architecture": {
          "type": [
            "string",
            "null"
          ]
        },
        "runtime": {
          "type": [
            "string",
            "null"
          ]
        },
        "lock_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "image_digest": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "run_refs"
      ],
      "properties": {
        "result": {
          "enum": [
            "pass",
            "fail",
            "partial",
            "not_run",
            "not_run_device_hold"
          ]
        },
        "run_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "test_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "security_review": {
      "type": [
        "string",
        "null"
      ]
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "known_limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "approver_ref"
      ],
      "properties": {
        "state": {
          "enum": [
            "not_promoted",
            "proposed",
            "approved",
            "promoted",
            "blocked"
          ]
        },
        "approver_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
