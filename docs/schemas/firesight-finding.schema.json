{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/timerloggedout-spec/termux-monorepo/blob/master/docs/schemas/firesight-finding.schema.json",
  "title": "FireSight Finding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "finding_id",
    "fingerprint",
    "detector",
    "severity",
    "state",
    "summary",
    "evidence_refs",
    "first_observed_at",
    "last_observed_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "finding_id": {
      "type": "string",
      "pattern": "^fire\\."
    },
    "fingerprint": {
      "type": "string",
      "minLength": 8
    },
    "detector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "rule_id"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "rule_id": {
          "type": "string"
        }
      }
    },
    "severity": {
      "enum": [
        "info",
        "warning",
        "major",
        "critical"
      ]
    },
    "confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "state": {
      "enum": [
        "open",
        "acknowledged",
        "mitigated",
        "resolved",
        "false_positive"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "affected": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string"
        },
        "ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^([0-9a-f]{40})$"
        },
        "entities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "first_observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "owner": {
      "type": [
        "string",
        "null"
      ]
    },
    "escalation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "policy_ref": {
          "type": "string"
        },
        "target": {
          "type": [
            "string",
            "null"
          ]
        },
        "due_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "related_finding_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "validated_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "validated_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    }
  }
}
