{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/timerloggedout-spec/termux-monorepo/blob/master/docs/schemas/inference-selection-receipt.schema.json",
  "title": "DoE-governed Inference Selection Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "selection_id",
    "selected_at",
    "authority",
    "doe",
    "task",
    "selector",
    "request",
    "endpoint",
    "pool_snapshot",
    "assignment",
    "correlation",
    "privacy"
  ],
  "properties": {
    "schema": {
      "const": "inference-selection-receipt/v1"
    },
    "selection_id": {
      "type": "string",
      "minLength": 1
    },
    "selected_at": {
      "type": "string",
      "format": "date-time"
    },
    "authority": {
      "const": "doe"
    },
    "doe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "campaign_id",
        "design_ref",
        "design_version",
        "allocation_id",
        "stratum_id"
      ],
      "properties": {
        "campaign_id": {
          "type": "string"
        },
        "design_ref": {
          "type": "string"
        },
        "design_version": {
          "type": "string"
        },
        "allocation_id": {
          "type": "string"
        },
        "stratum_id": {
          "type": "string"
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "task_class"
      ],
      "properties": {
        "task_id": {
          "type": "string"
        },
        "task_class": {
          "type": "string"
        },
        "task_fingerprint": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "scout_id",
        "selection_basis"
      ],
      "properties": {
        "kind": {
          "const": "scout"
        },
        "scout_id": {
          "type": "string"
        },
        "selection_basis": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "eligibility_snapshot_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manager_id",
        "request_id",
        "requester_role",
        "exempt"
      ],
      "properties": {
        "manager_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "request_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "requester_role": {
          "type": "string"
        },
        "exempt": {
          "type": "boolean"
        },
        "exemption_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "surface",
        "model",
        "protocol",
        "endpoint_id"
      ],
      "properties": {
        "provider": {
          "type": "string"
        },
        "surface": {
          "type": "string"
        },
        "model": {
          "type": "string",
          "description": "Exact model@version, verbatim"
        },
        "protocol": {
          "type": "string"
        },
        "endpoint_id": {
          "type": "string"
        },
        "endpoint_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "pool_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "sha256",
        "eligible_count"
      ],
      "properties": {
        "ref": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "eligible_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "arm_id",
        "probability",
        "endpoint_test_id"
      ],
      "properties": {
        "method": {
          "type": "string"
        },
        "arm_id": {
          "type": "string"
        },
        "probability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "endpoint_test_id": {
          "type": "string"
        },
        "repeat_permitted": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "custom_contract": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "contract_id",
        "status",
        "delta_dimensions",
        "fee"
      ],
      "properties": {
        "contract_id": {
          "type": "string"
        },
        "status": {
          "const": "active"
        },
        "delta_dimensions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fee": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "basis",
            "base_customization_pct",
            "participant_count",
            "participant_compound_rate_pct",
            "effective_pct",
            "currency_or_unit",
            "distribution"
          ],
          "properties": {
            "basis": {
              "type": "string",
              "description": "Explicit denominator/value to which the percentage applies"
            },
            "base_customization_pct": {
              "type": "number",
              "minimum": 0
            },
            "participant_count": {
              "type": "integer",
              "minimum": 1
            },
            "participant_compound_rate_pct": {
              "type": "number",
              "minimum": 0
            },
            "effective_pct": {
              "type": "number",
              "minimum": 0
            },
            "currency_or_unit": {
              "type": "string"
            },
            "distribution": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "doe_pct",
                "mvt_pct",
                "ates_pct",
                "moneyball_pct",
                "3l0_pct",
                "total_pct"
              ],
              "properties": {
                "doe_pct": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "mvt_pct": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "ates_pct": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "moneyball_pct": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "3l0_pct": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "total_pct": {
                  "const": 100
                }
              },
              "description": "Lane allocations sum to 100%. MVT and ATES are nested DoE members for roll-up and must not be double-counted."
            }
          }
        }
      }
    },
    "correlation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow",
        "run_id",
        "run_attempt",
        "request_id",
        "trace_id"
      ],
      "properties": {
        "workflow": {
          "type": [
            "string",
            "null"
          ]
        },
        "run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "run_attempt": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "request_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "trace_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy_visibility",
        "strategy_commitment_sha256",
        "release_trigger"
      ],
      "properties": {
        "strategy_visibility": {
          "enum": [
            "private_active",
            "sealed_culled",
            "released_authorized",
            "not_applicable"
          ]
        },
        "strategy_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "strategy_commitment_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(null|[0-9a-f]{64})$"
        },
        "release_trigger": {
          "enum": [
            "on_cull_with_authorization",
            "never",
            "not_applicable"
          ]
        },
        "history_ref": {
          "type": [
            "string",
            "null"
          ],
          "description": "Access-controlled collaborator-session or commit history reference; never plaintext strategy."
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "request": {
            "properties": {
              "exempt": {
                "const": true
              }
            },
            "required": [
              "exempt"
            ]
          }
        },
        "required": [
          "request"
        ]
      },
      "then": {
        "properties": {
          "request": {
            "required": [
              "exemption_reason"
            ]
          }
        }
      }
    }
  ]
}
