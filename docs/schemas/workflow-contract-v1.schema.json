{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timerloggedout-spec.github.io/termux-monorepo/schemas/workflow-contract-v1.schema.json",
  "title": "Workflow Contract v1",
  "description": "Initial interoperable contract for declarative repository workflows. This validates structure, not execution authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workflow_id", "objective", "scope", "tasks", "constraints", "success", "evidence"],
  "properties": {
    "schema_version": { "const": "wfc/v1" },
    "workflow_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" },
    "name": { "type": "string", "minLength": 1 },
    "owner": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "base_sha", "cohort"],
      "properties": {
        "repository": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
        "base_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "cohort": { "type": "string", "minLength": 1 },
        "ref": { "type": "string" },
        "environment": { "type": "string" },
        "paths": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "depends_on"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$" },
          "type": { "type": "string", "minLength": 1 },
          "depends_on": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "inputs": { "type": "object" },
          "outputs": { "type": "object" },
          "role": { "type": "string" },
          "capabilities": { "type": "array", "items": { "type": "string" } },
          "timeout_seconds": { "type": "integer", "minimum": 1 },
          "max_attempts": { "type": "integer", "minimum": 1, "maximum": 20 },
          "side_effect_class": { "enum": ["read_only", "repository_write", "external_write", "deployment", "financial"] }
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_parallel": { "type": "integer", "minimum": 1 },
        "max_attempts": { "type": "integer", "minimum": 1, "maximum": 20 },
        "deadline": { "type": "string", "format": "date-time" },
        "external_writes": { "enum": ["forbidden", "approval_required", "permitted_by_policy"] },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["unit", "limit"],
          "properties": {
            "unit": { "enum": ["inference_tokens", "usd_credits", "cpu_seconds", "wall_seconds", "requests"] },
            "limit": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      }
    },
    "success": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "policy_version": { "type": "string" },
    "projection_refs": { "type": "array", "items": { "type": "string" } }
  }
}
