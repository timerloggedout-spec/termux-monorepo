{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/timerloggedout-spec/termux-monorepo/blob/master/experiments/doe/gitreverse-reconstruction/TASK.schema.json",
  "title": "GitReverse Reconstruction DoE Task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "stratum",
    "repository",
    "snapshot",
    "evidence_inputs",
    "expected_output",
    "gold_annotations",
    "rubric_version"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "task_id": {
      "type": "string",
      "pattern": "^repo-recon-[0-9]{2,3}$"
    },
    "stratum": {
      "type": "string",
      "minLength": 3
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "default_branch"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "default_branch": {
          "type": "string"
        }
      }
    },
    "evidence_inputs": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "kind"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "readme",
              "tree",
              "source",
              "docs",
              "manifest",
              "test",
              "other"
            ]
          }
        }
      }
    },
    "source_depth": {
      "type": "string",
      "enum": [
        "metadata-readme-tree",
        "selected-files",
        "bounded-source-set"
      ]
    },
    "expected_output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "required_sections"
      ],
      "properties": {
        "format": {
          "type": "string",
          "enum": [
            "single-prompt",
            "implementation-brief",
            "structured-json"
          ]
        },
        "required_sections": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    },
    "gold_annotations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirements_ref",
        "claim_evidence_ref",
        "unknowns_ref"
      ],
      "properties": {
        "requirements_ref": {
          "type": "string"
        },
        "claim_evidence_ref": {
          "type": "string"
        },
        "unknowns_ref": {
          "type": "string"
        }
      }
    },
    "rubric_version": {
      "type": "string"
    },
    "extension_of": {
      "type": [
        "string",
        "null"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    }
  }
}
