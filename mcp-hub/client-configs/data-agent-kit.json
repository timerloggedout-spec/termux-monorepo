      "type": "stdio",
      "args": [
        "mcp/bin/mcp_proxy_bundle.cjs",
        "https://dataplex.googleapis.com/mcp"
      ],
      "env": {
        "X_GOOG_PROXY_HEADERS": "{\"User-Agent\":\"datacloud.antigravity\"}"
      }
    },
    "dak-spanner": {
      "command": "node",
      "type": "stdio",
      "args": [
        "mcp/bin/mcp_proxy_bundle.cjs",
        "https://spanner.googleapis.com/mcp"
      ],
      "env": {
        "X_GOOG_PROXY_HEADERS": "{\"User-Agent\":\"datacloud.antigravity\"}"
      }
    }
  }
}
