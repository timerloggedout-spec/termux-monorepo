{
  "rewrites": [
    {
      "source": "/mcp/:server",
      "destination": "/api/mcp/:server"
    },
    {
      "source": "/mcp-hub/:server",
      "destination": "/api/mcp/:server"
    }
  ],
  "functions": {
    "api/mcp/[server].ts": {
      "maxDuration": 60
    }
  },
  "ignoreCommand": "bash \"$(git rev-parse --show-toplevel)/scripts/ci/vercel_ignore_build.sh\" mcp-hub",
  "git": {
    "deploymentEnabled": false
  }
}
