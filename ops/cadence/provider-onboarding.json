      "kind": "llm"
    },
    {
      "provider": "cerebras",
      "kind": "llm"
    },
    {
      "provider": "cloudflare",
      "kind": "llm",
      "availability_extra_env": [
        "CLOUDFLARE_ACCOUNT_ID"
      ]
    },
    {
      "provider": "cohere",
      "kind": "llm"
    },
    {
