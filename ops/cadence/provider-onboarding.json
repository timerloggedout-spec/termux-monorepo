    },
    {
      "provider": "requesty",
      "kind": "llm"
    },
    {
      "provider": "routeway",
      "kind": "llm"
    },
    {
      "provider": "sambanova",
      "kind": "llm"
    },
    {
      "provider": "sealion",
      "kind": "llm"
    },
    {
      "provider": "siliconflow",
      "kind": "llm"
    },
    {
      "provider": "typhoon",
      "kind": "llm",
      "exceptions": [
        {
          "surface": "catalog_endpoint",
          "reason": "quota-family record only; no documented catalog endpoint wired in any catalog module"
        },
        {
          "surface": "catalog_secret",
          "reason": "quota-family record only; no catalog secret name established"
        },
        {
          "surface": "availability_env",
          "reason": "quota-family record only; not wired in provider-availability.yml"
        }
      ]
    },
    {
      "provider": "unorouter",
      "kind": "llm"
    },
    {
      "provider": "xfyun",
      "kind": "llm",
      "availability_extra_env": [
        "XFYUN_API_KEY",
        "IFLYTEK_SPARK_API_PASSWORD"
      ],
      "exceptions": [
        {
          "surface": "catalog_endpoint",
          "reason": "no catalog endpoint in any catalog module; availability wired under the vendor iFlytek names"
        },
        {
          "surface": "catalog_secret",
          "reason": "no catalog-module secret; availability uses XFYUN_API_KEY / IFLYTEK_SPARK_API_PASSWORD"
        }
      ]
    },
    {
      "provider": "xkiro",
      "kind": "llm",
      "exceptions": [
        {
          "surface": "availability_env",
          "reason": "public catalog (PUBLIC_CATALOGS): the availability probe needs no secret, so no env is wired in provider-availability.yml"
        }
      ]
    },
    {
      "provider": "zai",
      "kind": "llm",
      "exceptions": [
        {
          "surface": "catalog_endpoint",
          "reason": "secret-only wiring: ZAI_API_KEY is provisioned and probed for continuity, but no catalog endpoint is registered in any catalog module"
        }
      ]
    },
    {
      "provider": "aikido",
      "kind": "review"
    },
    {
      "provider": "coderabbit",
      "kind": "review"
    },
