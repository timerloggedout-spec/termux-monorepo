{
  "schema": "delphi.research-silos.v1",
  "doc": "docs/ops/RESEARCH-SILO-DELPHI.md",
  "status": "ACTIVE",
  "intent": "Each research-repo template under refTemplates/15_Research_Repo_Templates runs its own siloed Proposal → Delphi → cycle stovepipe for independent outcome comparison of validated outputs, feature extractions, and consensus implementations. No cross-silo score leakage.",
  "baseline_cycle": {
    "name": "RFP{1st_improve_request_cycle on RFP itself}→Delphi→cycle",
    "stages": [
      "RFP (improve-request on the RFP schema / surface itself)",
      "oracle + blind panel (5 roles)",
      "award shadow|parked",
      "validated output comparison",
      "feature extraction",
      "consensus implementation",
      "flywheel confirmed|miss → reweight"
    ],
    "comparison_axes": [
      "produced_output_results_validated",
      "feature_extractions",
      "consensus_implementation"
    ]
  },
  "evolutionary_extension": {
    "name": "feature 🧬 evolutionary selections & mixes",
    "variants": ["rnd", "specifically_selected", "control"],
    "note": "After baseline silo comparison, each silo may spawn variant RFPs (rnd / selected / control) for evolutionary feature mixes. Attribution remains per-silo + variant."
  },
  "expected_independent_results": {
    "baseline": 12,
    "attribution": "one result stream per research silo (slot)",
    "with_evolutionary": "12 × (1 + N_variants); N starts at 3 (rnd, selected, control) → up to 48 independent streams when fully extended",
    "current_schema_note": "Delphi Oracle RFP gate currently scores free-tier surfaces (ops/delphi/surfaces.json). Research silos are parallel metadata + RFP lanes that reuse the same gate, panel, and flywheel; each silo files its own delphi:rfp with surface_id = research.<slot>."
  },
