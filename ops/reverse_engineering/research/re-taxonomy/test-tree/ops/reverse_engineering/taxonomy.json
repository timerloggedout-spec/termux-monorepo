 "placement_rules": [
  "One node, placed once, by primary kind; overlap is expressed as extra parents + tags, never duplicate nodes.",
  "Kinds stay distinct: category != tool != platform != credential != format. A workspace (Kali, FLARE-VM) is not a discipline.",
  "Every claim carries the Foundry evidence vocabulary: observed | inferred | reproduced | contradicted | unknown.",
  "Toolchains are handoffs between stages, not shopping lists: a chain names the stage's tool(s) and the output that passes on."
 ],
 "schema": "re-taxonomy/v1",
 "source_example": "Adapted from a collaborator's Perplexity taxonomy export (owner-supplied 2026-10-28): cybersecurity polyhierarchy + RE category/toolchain map. Fleet version: machine-readable, validated, fleet assets placed; improvement research filed separately.",
 "toolchains": [
  {
   "category": "mobile-android",
   "stages": [
    {
     "output": "published artifact + provenance (source, version, build, sha256)",
     "stage": "acquire",
     "tools": [
      "apk-xref"
     ]
    },
    {
     "output": "manifest, permissions, resources, DEX + native split",
     "stage": "extract",
     "tools": [
      "apktool",
      "apk-xref"
     ]
    },
    {
     "output": "reconstructed logic per layer (DEX vs .so)",
     "stage": "analyze-static",
     "tools": [
      "jadx",
      "ghidra"
     ]
    },
    {
     "output": "runtime calls correlated across managed/native layers",
     "stage": "observe-dynamic",
     "tools": [
      "frida"
     ]
    },
    {
     "output": "repo<->APK divergences both directions, apk-xref/v1 findings",
     "stage": "validate",
     "tools": [
      "apk-xref"
     ]
    },
    {
     "output": "architecture notes + validated findings",
     "stage": "document",
     "tools": []
    }
   ]
  },
  {
   "category": "native-linux",
   "stages": [
    {
     "output": "format/architecture confirmation (ELF)",
     "stage": "identify",
     "tools": []
    },
    {
     "output": "functions, strings, xrefs, control flow",
     "stage": "analyze-static",
     "tools": [
      "ghidra",
      "rizin-cutter"
     ]
    },
    {
     "output": "breakpoint/trace validation of selected paths",
     "stage": "observe-dynamic",
     "tools": [
      "gdb",
      "frida"
     ]
    },
    {
     "output": "annotated functions + behaviour notes",
     "stage": "document",
     "tools": []
    }
   ]
  },
  {
   "category": "native-windows",
   "stages": [
    {
     "output": "reconstructed PE/DLL logic",
     "stage": "analyze-static",
     "tools": [
      "ghidra"
     ]
    },
    {
     "output": "observed execution",
     "stage": "observe-dynamic",
     "tools": [
      "platform-debuggers",
      "frida"
     ]
    },
    {
     "output": "documented behaviour (FLARE-VM as workspace when malware-adjacent)",
     "stage": "document",
     "tools": []
    }
   ]
  },
  {
   "category": "firmware-embedded-linux",
   "stages": [
    {
     "output": "component inventory: filesystems, scripts, configs, binaries",
     "stage": "extract",
     "tools": [
      "binwalk"
     ]
    },
    {
     "output": "selected service binaries analysed",
     "stage": "analyze-static",
     "tools": [
      "ghidra"
     ]
    },
    {
     "output": "emulated execution where the environment reproduces",
     "stage": "observe-dynamic",
     "tools": [
      "qemu",
      "gdb"
     ]
    },
    {
     "output": "component map + verified behaviour",
     "stage": "document",
     "tools": []
    }
   ]
  },
  {
   "category": "firmware-bare-metal",
   "stages": [
    {
     "output": "processor + memory layout established before code claims",
     "stage": "identify",
     "tools": [
      "ghidra"
     ]
    },
    {
     "output": "hardware debugging or emulation evidence",
     "stage": "observe-dynamic",
     "tools": [
      "qemu"
     ]
    },
    {
     "output": "code/data map + execution evidence",
     "stage": "document",
     "tools": []
    }
   ]
  },
  {
   "category": "work-malware",
   "stages": [
    {
