{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/timerloggedout-spec/termux-monorepo/blob/master/ops/roles/scientific-specialists.schema.json",
  "title": "Scientific Specialist Registry",
  "type": "object",
  "required": [
    "schema",
    "version",
    "authority",
    "canonical_doe_seats",
    "common_contract",
    "roles",
    "contract_status"
  ],
  "properties": {
    "schema": {
      "const": "scientific-specialist-registry/v1"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "authority": {
      "type": "string",
      "minLength": 1
    },
    "canonical_doe_seats": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "contract_status": {
      "type": "string"
    },
    "common_contract": {
      "type": "object",
      "required": [
        "required_inputs",
        "required_outputs",
        "abstain_or_escalate",
        "high_impact_review",
        "experiment_state"
      ]
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "domain",
          "competence",
          "mission",
          "scope",
          "exclusions",
          "authority",
          "required_competencies",
          "competence_evidence",
          "accepted_inputs",
          "tools_and_data_classes",
          "provenance_requirements",
          "required_outputs",
          "methods_assumptions_uncertainty",
          "acceptance_criteria",
          "independent_reviewer_role",
          "abstention_escalation",
          "prohibited_actions",
          "metrics",
          "skill_refs",
          "tool_manifest_refs",
          "configured_instance_identity",
          "qualification_status",
          "version",
          "change_history",
          "evaluation_fixtures",
          "canonical_seat_ids_created",
          "provider_identity"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "domain": {
            "type": "string",
            "minLength": 1
          },
          "competence": {
            "type": "string",
            "minLength": 1
          },
          "mission": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "exclusions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "authority": {
            "type": "string",
            "minLength": 1
          },
          "required_competencies": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "competence_evidence": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "accepted_inputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tools_and_data_classes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "provenance_requirements": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "required_outputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "methods_assumptions_uncertainty": {
            "type": "string"
          },
          "acceptance_criteria": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "independent_reviewer_role": {
            "type": "string"
          },
          "abstention_escalation": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "prohibited_actions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "metrics": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "skill_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tool_manifest_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "configured_instance_identity": {
            "type": "string"
          },
          "qualification_status": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "change_history": {
            "type": "array"
          },
          "evaluation_fixtures": {
            "type": "array"
          },
          "canonical_seat_ids_created": {
            "const": false
          },
          "provider_identity": {
            "const": false
          }
        },
        "additionalProperties": true
      }
    }
  }
}
