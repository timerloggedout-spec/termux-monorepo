{
  "upstream_repo": "nilbuild/developer-roadmap",
  "sync_branch": "master",
  "sync_depth": 1,
  "last_sync": null,
  "sync_count": 0,
  "auto_sync": true,
  "schedule": "0 0 * * 1",
  "notifications": {
    "on_success": true,
    "on_failure": true,
    "channels": ["github", "slack"]
  },
  "retries": {
    "max_attempts": 3,
    "retry_delay_ms": 5000
  },
  "excludes": [
    ".git",
    "node_modules",
    ".DS_Store",
    "*.log",
    "dist/",
    "build/"
  ]
}
