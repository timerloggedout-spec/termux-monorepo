{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/timerloggedout-spec/termux-monorepo/blob/master-staging/schemas/antigravity/encrypted-archive-v1.schema.json",
  "title": "Antigravity Encrypted Archive Header v1",
  "description": "This header is inside the age-encrypted plaintext envelope and is not a public sidecar.",
  "type": "object",
  "required": ["archive_schema_version", "telemetry_schema_version", "payload_sha256", "payload_bytes"],
  "properties": {
    "archive_schema_version": {"const": 1},
    "telemetry_schema_version": {"type": "integer", "minimum": 1},
    "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "payload_bytes": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807}
  },
  "additionalProperties": false
}
