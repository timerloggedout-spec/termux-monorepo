{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/timerloggedout-spec/termux-monorepo/blob/master-staging/schemas/antigravity/hindsight-summary-v1.schema.json",
  "title": "Reviewed Hindsight Run Summary v1",
  "description": "Aggregate-only summary. Excludes run/conversation IDs, model/account names, prompts, responses, paths, tool names, arguments, and results.",
  "type": "object",
  "required": ["summary_schema_version", "telemetry_schema_version", "source", "run_status", "producer_state", "usage_source", "usage_scope", "final_usage", "duration_seconds", "event_count", "tool_step_count", "malformed_event_count"],
  "properties": {
    "summary_schema_version": {"const": 1},
    "telemetry_schema_version": {"type": "integer", "minimum": 1},
    "source": {"const": "antigravity_cli_stream_json"},
    "run_status": {"enum": ["SUCCESS", "INCOMPLETE", "FAILED"]},
    "producer_state": {"enum": ["not_observed", "success", "failed", "signaled", "launch_failed"]},
    "usage_source": {"enum": ["stream-json:result.usage", "unavailable"]},
    "usage_scope": {"const": "run"},
    "final_usage": {"$ref": "#/$defs/usage"},
    "duration_seconds": {"type": ["number", "null"], "minimum": 0},
    "event_count": {"type": "integer", "minimum": 0},
    "tool_step_count": {"type": "integer", "minimum": 0},
    "malformed_event_count": {"type": "integer", "minimum": 0}
  },
  "$defs": {
    "tokenCount": {"oneOf": [{"type": "integer", "minimum": 0, "maximum": 9223372036854775807}, {"type": "null"}]},
    "usage": {
      "type": "object",
      "required": ["input_tokens", "output_tokens", "thinking_tokens", "cache_read_tokens", "total_tokens"],
      "properties": {
        "input_tokens": {"$ref": "#/$defs/tokenCount"},
        "output_tokens": {"$ref": "#/$defs/tokenCount"},
        "thinking_tokens": {"$ref": "#/$defs/tokenCount"},
        "cache_read_tokens": {"$ref": "#/$defs/tokenCount"},
        "total_tokens": {"$ref": "#/$defs/tokenCount"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
