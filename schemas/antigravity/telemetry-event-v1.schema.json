{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/timerloggedout-spec/termux-monorepo/blob/master-staging/schemas/antigravity/telemetry-event-v1.schema.json",
  "title": "Antigravity Sanitized Telemetry Event v1",
  "description": "Allowlisted event projection; source text, tool arguments/results, paths, conversation IDs, and raw payloads are excluded.",
  "type": "object",
  "required": ["schema_version", "record_type", "run_id", "sequence", "observed_at", "event_type"],
  "properties": {
    "schema_version": {"const": 1},
    "record_type": {"enum": ["telemetry_event", "run_summary"]},
    "run_id": {"type": "string", "maxLength": 256},
    "sequence": {"type": "integer", "minimum": 0},
    "observed_at": {"type": "string", "format": "date-time"},
    "event_type": {"enum": ["init", "step_update", "result", "malformed", "other", "run_summary"]},
    "reason": {"enum": ["oversized", "invalid_utf8", "invalid_type", "invalid_json", "invalid_unicode"]},
    "model": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/+\\-]{0,127}$"},
    "step_index": {"type": "integer", "minimum": 0},
    "step_type": {"enum": ["user_input", "agent_response", "tool", "checkpoint", "other"]},
    "state": {"enum": ["ACTIVE", "DONE", "other"]},
    "tool_name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/+\\-]{0,127}$"},
    "duration_seconds": {"type": "number", "minimum": 0},
    "num_turns": {"type": "integer", "minimum": 0},
    "usage_snapshot": {"$ref": "#/$defs/usage"},
    "final_usage": {"$ref": "#/$defs/usage"},
    "usage_role": {"enum": ["non_authoritative_step_snapshot", "authoritative_result_usage", "authoritative_run_total"]},
    "run_status": {"enum": ["SUCCESS", "INCOMPLETE", "FAILED"]},
    "producer_state": {"enum": ["not_observed", "success", "failed", "signaled", "launch_failed"]},
    "usage_source": {"enum": ["stream-json:result.usage", "unavailable"]},
    "event_count": {"type": "integer", "minimum": 0},
    "tool_step_count": {"type": "integer", "minimum": 0},
    "malformed_event_count": {"type": "integer", "minimum": 0}
  },
  "$defs": {
    "tokenCount": {"oneOf": [{"type": "integer", "minimum": 0, "maximum": 9223372036854775807}, {"type": "null"}]},
    "usage": {
      "type": "object",
      "required": ["input_tokens", "output_tokens", "thinking_tokens", "cache_read_tokens", "total_tokens"],
      "properties": {
        "input_tokens": {"$ref": "#/$defs/tokenCount"},
        "output_tokens": {"$ref": "#/$defs/tokenCount"},
        "thinking_tokens": {"$ref": "#/$defs/tokenCount"},
        "cache_read_tokens": {"$ref": "#/$defs/tokenCount"},
        "total_tokens": {"$ref": "#/$defs/tokenCount"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
