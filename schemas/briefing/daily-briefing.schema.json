{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/timerloggedout-spec/termux-monorepo/schemas/briefing/daily-briefing.schema.json",
  "title": "Daily Briefing Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "briefing_date",
    "generated_at",
    "contract",
    "items"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "briefing_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spec",
        "ingest",
        "procurement",
        "radar",
        "source_registry"
      ],
      "properties": {
        "spec": {
          "type": "string"
        },
        "ingest": {
          "type": "string"
        },
        "procurement": {
          "type": "string"
        },
        "radar": {
          "type": "string"
        },
        "source_registry": {
          "type": "string"
        }
      }
    },
    "evidence_note": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "$ref": "daily-item.schema.json"
      }
    },
    "radar_watch": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "horizon",
          "evidence_status",
          "source",
          "note"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "horizon": {
            "enum": [
              "H2",
              "H3"
            ]
          },
          "evidence_status": {
            "enum": [
              "confirmed",
              "research",
              "attributed",
              "signal",
              "speculative",
              "disputed"
            ]
          },
          "source": {
            "type": "string",
            "format": "uri"
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}
