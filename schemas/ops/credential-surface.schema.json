{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/timerloggedout-spec/termux-monorepo/schemas/ops/credential-surface.schema.json",
  "title": "Names-only credential surface",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "surface_id",
    "name",
    "class",
    "owner_surface",
    "last_used_class",
    "intended_use",
    "rotation_status",
    "issue",
    "observed_at"
  ],
  "properties": {
    "surface_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 80},
    "class": {
      "enum": [
        "actions_secret",
        "fine_grained_pat",
        "classic_pat",
        "oauth_app",
        "github_app",
        "ssh_key",
        "device_keyring"
      ]
    },
    "owner_surface": {"type": "string", "minLength": 1},
    "last_used_class": {
      "enum": [
        "never",
        "week",
        "two_weeks",
        "month",
        "quarter",
        "expired",
        "unknown"
      ]
    },
    "intended_use": {"type": "string", "minLength": 1},
    "rotation_status": {
      "enum": [
        "active",
        "rotate",
        "delete",
        "expired_delete",
        "unused_candidate_delete"
      ]
    },
    "issue": {"type": "integer", "const": 184},
    "observed_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "notes": {"type": "string"}
  }
}
