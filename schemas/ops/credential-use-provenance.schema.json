{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/timerloggedout-spec/termux-monorepo/schemas/ops/credential-use-provenance.schema.json",
  "title": "Credential use provenance envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "record_id", "observed_at", "credential", "consumer", "inference", "execution", "usage", "attribution"],
  "properties": {
    "schema": {"const": "credential-use-provenance/v1"},
    "record_id": {"type": "string", "minLength": 8, "maxLength": 160},
    "observed_at": {"type": "string", "format": "date-time"},
    "credential": {
      "type": "object", "additionalProperties": false,
      "required": ["ref", "name", "authn_mode", "principal_kind"],
      "properties": {
        "ref": {"type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9._:-]{2,127}$"},
        "name": {"type": ["string", "null"], "maxLength": 100},
        "authn_mode": {"enum": ["github_pat", "github_app_installation", "github_actions", "oauth", "provider_api_key", "unknown"]},
        "principal_kind": {"enum": ["github_user", "github_app", "actions_job", "oauth_client", "provider_account", "unknown"]},
        "principal_id": {"type": ["string", "null"], "maxLength": 160},
        "rotation_epoch": {"type": ["string", "null"], "maxLength": 40},
        "mapping_status": {"enum": ["mapped", "unmapped", "unverified"]}
      }
    },
    "consumer": {
      "type": "object", "additionalProperties": false,
      "required": ["moniker", "role", "context", "instance_key"],
      "properties": {
        "moniker": {"type": ["string", "null"], "maxLength": 100},
        "role": {"type": ["string", "null"], "maxLength": 100},
        "context": {"type": ["string", "null"], "maxLength": 200},
        "instance_key": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "system_prompt_ref": {"type": ["string", "null"], "maxLength": 240},
        "system_prompt_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "tools_ref": {"type": ["string", "null"], "maxLength": 240},
        "tools_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "inference": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "model", "endpoint_id", "settings_digest"],
      "properties": {
        "provider": {"type": ["string", "null"], "maxLength": 120},
        "model": {"type": ["string", "null"], "maxLength": 200},
        "endpoint_id": {"type": ["string", "null"], "maxLength": 200},
        "settings_digest": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "workflow", "run_id", "run_attempt", "job", "step", "event", "source_sha"],
      "properties": {
        "repository": {"type": ["string", "null"], "maxLength": 200},
        "workflow": {"type": ["string", "null"], "maxLength": 200},
        "run_id": {"type": ["string", "null"], "maxLength": 40},
        "run_attempt": {"type": ["integer", "null"], "minimum": 1},
        "job": {"type": ["string", "null"], "maxLength": 200},
        "step": {"type": ["string", "null"], "maxLength": 200},
        "event": {"type": ["string", "null"], "maxLength": 80},
        "source_sha": {"type": ["string", "null"], "pattern": "^[a-f0-9]{40,64}$"}
      }
    },
    "usage": {
      "type": "object", "additionalProperties": false,
      "required": ["value", "unit", "source", "window", "match", "status", "note"],
      "properties": {
        "value": {"type": ["number", "null"], "minimum": 0},
        "unit": {"type": ["string", "null"], "maxLength": 40},
        "source": {"type": ["string", "null"], "maxLength": 240},
        "window": {"type": ["string", "null"], "maxLength": 100},
        "match": {"enum": ["exact", "activity-proxy", null]},
        "status": {"enum": ["established", "activity-only", "waived", "fault", "pending"]},
        "note": {"type": ["string", "null"], "maxLength": 500}
      }
    },
    "attribution": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "evidence_legs", "confidence"],
      "properties": {
        "state": {"enum": ["corroborated", "single-leg", "disputed", "unattributed", "unmapped"]},
        "evidence_legs": {
          "type": "array",
          "items": {"enum": ["credential_mapping", "signed_dispatch_stamp", "doe_manifest", "workflow_context", "app_installation", "github_audit_event", "session_receipt"]}
        },
        "confidence": {"enum": ["exact", "corroborated", "single-leg", "unknown"]}
      }
    }
  }
}
