#!/data/data/com.termux/files/usr/bin/bash
# AGY-1497-10: runit supervises this foreground recovery wrapper, then sshd.
set -euo pipefail
exec 2>&1
marker="$HOME/.local/share/agy-1497-secondary/worktree/.agy-secondary-id"
[[ -f "$marker" && ! -L "$marker" && "$(cat "$marker")" == tmx-node-55619bd5 ]] || exit 21
[[ "$(whoami)" == u0_a243 && "$(getprop ro.product.model)" == B160V ]] || exit 23
[[ "$PREFIX" == /data/data/com.termux/files/usr ]] || exit 24
state="$HOME/.local/state/tmx-secondary-recovery"
mkdir -p "$state"
chmod 700 "$state"
# Never kill/adopt a manually started daemon. Poll only its exact process name.
# sshd-session children are not named sshd. On exit, take over port 8022.
if pgrep -u "$(id -u)" -x sshd >/dev/null; then
  printf '%s\n' 'Manual sshd present; non-killing recovery armed (not yet a supervised listener).' | tee "$state/listener-state"
  while pgrep -u "$(id -u)" -x sshd >/dev/null; do sleep 5; done
fi
"$PREFIX/bin/sshd" -t
printf '%s\n' 'Starting foreground sshd; use sv status and a fresh SSH connection to verify listening.' | tee "$state/listener-state"
exec "$PREFIX/bin/sshd" -D -e
