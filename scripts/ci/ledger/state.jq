# Ledger state object. Numeric fields are --argjson; blobs are --slurpfile.
{version:2,observed_at:$observed_at,base_sha:$base_sha,head_sha:$head_sha,merge_base:$merge_base,head_repo:$head_repo,state:$state,commit_count:$commit_count,empty_count:$empty_count,metadata_count:$metadata_count,effective_count:$effective_count,gross_add:$gross_add,gross_del:$gross_del,final_add:$final_add,final_del:$final_del,final_files:$final_files,final_delta:$final_delta,ahead:$ahead,behind:$behind,noop_pct:$noop_pct,realization_pct:$realization_pct,comment_count:$comment_count,review_count:$review_count,review_comment_count:$review_comment_count,actionable_comments:$actionable_comments,approvals:$approvals,changes_requested:$changes_requested,check_total:$check_total,check_success:$check_success,check_failure:$check_failure,check_pending:$check_pending,event_count:$event_count,followed_count:$followed_count,followthrough_pct:$followthrough_pct,median_lag_minutes:$median_lag_minutes,first_followthrough_sha:$first_followthrough_sha,recent_events:($recent_events[0] // []),delta:{final_delta:$delta_final,behind:$delta_behind,check_failure:$delta_failure,check_pending:$delta_pending,event_count:$delta_events,followed_count:$delta_followed},history:($history[0] // [])}
