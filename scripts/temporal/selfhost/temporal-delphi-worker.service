[Unit]
Description=Delphi cycle worker (Temporal, task queue delphi-cycle)
After=network.target temporal-selfhost.service
Wants=temporal-selfhost.service

[Service]
ExecStart=/home/hatch/workspace/temporal-selfhost/start-delphi-worker.sh
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
