# Copy to ~/.config/tmx-device/queue.env and chmod 600.
# Names only — the values below are placeholders/public, never real tokens.
# The device token is per-device, issued at provisioning time, and is stored
# ONLY in that on-device file (never in the repo, chat, or CI).
DEVICE_QUEUE_URL=https://tmx-device-queue.timerloggedout.workers.dev
DEVICE_QUEUE_DEVICE_TOKEN=<per-device-token-issued-at-provisioning>
# Optional: queue role this node claims for (default: engineer).
DEVICE_QUEUE_ROLE=engineer
