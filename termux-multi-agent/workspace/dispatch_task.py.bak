#!/usr/bin/env python3
"""dispatch_task.py – working task dispatcher with logging."""
import json, sys, os, shutil, subprocess, traceback, time
from pathlib import Path
from datetime import datetime, timezone

HOME = Path.home()
MASTER = HOME / 'workspace/llm_map/master_tasks.json'
WORKSPACE = HOME / 'termux-multi-agent/workspace'
ORCHESTRATOR = HOME / 'termux-multi-agent/run.py'
DEBUG_LOG = HOME / 'workspace/llm_map/dispatch_debug.log'

def log(msg):
    timestamp = datetime.now(timezone.utc).strftime('%H:%M:%S')
    line = f"[{timestamp}] {msg}"
    print(line)
    with open(DEBUG_LOG, 'a') as f:
        f.write(line + '\n')

def load_task(task_id):
    tasks = json.loads(MASTER.read_text())
    return next((t for t in tasks if t['id'] == task_id), None)

def save_tasks(tasks):
    MASTER.write_text(json.dumps(tasks, indent=2))

def log_verdict(task_id, verdict, agent, result=''):
    rh = HOME / 'termux-multi-agent/run_history.jsonl'
    entry = {
        "target_file": f"task:{task_id}",
        "verdict": verdict,
        "agent": agent,
        "timestamp": datetime.now(timezone.utc).isoformat(),
        "errors": str(result)[:300]
    }
    rh.parent.mkdir(parents=True, exist_ok=True)
    with open(rh, 'a') as f:
        f.write(json.dumps(entry) + '\n')

def run_task(task_id):
    log(f"START {task_id}")
    task = load_task(task_id)
    if not task:
        log(f"Not found: {task_id}")
        return
    if task.get('status') == 'done':
        log(f"Already done: {task_id}")
        return
    source = task.get('target_file', '')
    sandbox = Path(task.get('sandbox', '~/sandbox/default')).expanduser()
    sandbox.mkdir(parents=True, exist_ok=True)
    sf = HOME / source if source else sandbox / (task.get('target_name','output.py'))
    wf = WORKSPACE / sf.name
    if sf.exists():
        shutil.copy2(sf, wf)
        # If the target is inside termux-multi-agent, copy src/ too
        if source.startswith('termux-multi-agent/'):
            src_dir = HOME / 'termux-multi-agent/src'
            dst_dir = WORKSPACE / 'src'
            if src_dir.exists():
                if dst_dir.exists():
                    shutil.rmtree(dst_dir)
                shutil.copytree(src_dir, dst_dir)
                log('📋 Copied src/ directory → workspace')
    else:
        wf.write_text('# New file\n')
    instruction = f"{task.get('title','')}\n{task.get('instructions','')}"
    (WORKSPACE / 'current_task.txt').write_text(instruction)
    log(f"Workspace ready: {wf.name} ({len(instruction)} chars)")
    env = os.environ.copy()
        # Force-copy based on target_type
    target_type = task.get('target_type', 'source')
    if target_type == 'source':
        source_file = HOME / source
        workspace_file = WORKSPACE / source_file.name
        if source_file.exists() and source_file.is_file():
            shutil.copy2(source_file, workspace_file)
            log(f'Force-copied {source} → workspace')
        else:
            log(f'⚠️ Source file not found: {source}')
    else:
        # Output task – create empty target in workspace
        workspace_file = WORKSPACE / Path(source).name
        workspace_file.write_text('# New file – generated by ArchWiz\n')
        log(f'Created empty output target: {workspace_file.name}')
    env['TASK_WORKSPACE'] = str(WORKSPACE)
    env['TARGET_FILE'] = wf.name
    env['TASK_ID'] = task_id
    env['SESSION_ID'] = task.get('session_id', '')
    env['CONTEXT_MODE'] = task.get('context_mode', 'full')
    try:
        result = subprocess.run(['python3', str(ORCHESTRATOR)], capture_output=True, text=True, timeout=300, env=env)
        combined = result.stdout + result.stderr
        verdict = 'PASS' if ('Refactor succeeded' in combined or 'PASS' in combined.upper()) else 'FAIL'
        log(f"Verdict: {verdict}")
    except subprocess.TimeoutExpired:
        verdict = 'FAIL'
        combined = 'Timeout'
        log("Timeout")
    except Exception as e:
        verdict = 'FAIL'
        combined = str(e)
        log(f"Error: {e}")
    tasks = json.loads(MASTER.read_text())
    for t in tasks:
        if t['id'] == task_id:
            # Sentinel verification before marking done
            if verdict == 'PASS':
                import subprocess as sp
                sentinel_result = sp.run(
                    ['python3', str(HOME / 'archwiz/sentinel.py'), task_id],
                    capture_output=True, text=True
                )
                if sentinel_result.returncode != 0:
                    verdict = 'REVIEW'
                    log(f'Sentinel returned REVIEW – task held for inspection.')
            t['status'] = 'done' if verdict == 'PASS' else 'failed'
            t['result'] = combined[:200] if combined else ''
    save_tasks(tasks)
    log_verdict(task_id, verdict, task.get('assigned_agent','orchestrator'), combined[:300])

    # ── Collaborative Volley escalation on FAIL ──
    if verdict == 'FAIL':
        tasks = json.loads(MASTER.read_text())
        task = next((t for t in tasks if t['id'] == task_id), None)
        if task:
            task['attempt_count'] = task.get('attempt_count', 0) + 1
            if task['attempt_count'] >= 3:
                research_id = f'{task_id}-research'
                if not any(t['id'] == research_id for t in tasks):
                    tasks.append({
                        'id': research_id,
                        'title': f'Research failure of {task_id}',
                        'component': 'Research',
                        'assigned_agent': 'researcher',
                        'status': 'pending',
                        'context_mode': 'minimized',
                        'instructions': f'Research failure of {task_id}. Search session history for similar solutions.'
                    })
                    for suffix in ['A', 'B']:
                        tasks.append({
                            'id': f'{task_id}-{suffix}',
                            'title': f'{task_id} attempt {suffix}',
                            'component': task.get('component', 'Patch'),
                            'assigned_agent': 'developer',
                            'status': 'pending',
                            'context_mode': 'full',
                            'sandbox': f'~/sandbox/{task_id}_{suffix}',
                            'instructions': f'Alternative approach {suffix} for {task_id}.'
                        })
                    MASTER.write_text(json.dumps(tasks, indent=2))
                    log(f'Volley: spawned research + A/B for {task_id}')
            else:
                MASTER.write_text(json.dumps(tasks, indent=2))
                log(f'Attempt {task["attempt_count"]}/6 for {task_id}')
    log(f"END {task_id} ({verdict})")

if __name__ == '__main__':
    if len(sys.argv) < 2:
        print("Usage: python3 dispatch_task.py <task_id>")
        sys.exit(1)
    try:
        run_task(sys.argv[1])
    except Exception as e:
        log(f"FATAL: {e}")
        log(traceback.format_exc())
