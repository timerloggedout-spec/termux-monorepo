# ============================================================
# 5. Role resolution (same as original)
# ============================================================
def resolve_role(role_name, tag_index, visited=None):
    if visited is None:
        visited = set()
    if role_name in visited:
        return set()
    visited.add(role_name)
    rdef = ROLES[role_name]
    tool_set = set(rdef['tool_names'])
    for tag in rdef['includes_tags']:
        tool_set.update(tag_index.get(tag, []))
    for inc_role in rdef.get("includes_roles", []):
        tool_set.update(resolve_role(inc_role, tag_index, visited))
    return tool_set

# ============================================================
# 6. Main rebuild
# ============================================================
def main():
    # Load raw tools
    with open("all_tools.jsonl") as f:
        tools = [json.loads(line) for line in f]

    # 6a. Apply original extract_tags
    for t in tools:
        t['tags'] = extract_tags(t['name'])

    # 6b. Apply auto‑tags (remove 'other')
    for t in tools:
        apply_auto_tags(t)

    # 6c. Set category from first tag
    for t in tools:
        t['category'] = t['tags'][0] if t['tags'] else "other"

    # 6d. Write categories
    os.makedirs("categories", exist_ok=True)
    by_cat = defaultdict(list)
    for t in tools:
        by_cat[t['category']].append(t)
    for cat, tlist in by_cat.items():
        with open(f"categories/{cat}.json", "w") as f:
            json.dump({"category": cat, "tools": tlist}, f, indent=2)

    # 6e. Build tag index
    tag_index = defaultdict(list)
    for t in tools:
        for tag in t['tags']:
            tag_index[tag].append(t['name'])
    with open("TAG_INDEX.json", "w") as f:
        json.dump(dict(tag_index), f, indent=2)

    # 6f. Build roles
    os.makedirs("roles", exist_ok=True)
    role_map = {}
    for role_name in ROLES:
        tools_in_role = resolve_role(role_name, tag_index)
        role_tools = [t for t in tools if t['name'] in tools_in_role]
        role_obj = {"description": ROLES[role_name]['desc'], "tools": sorted(role_tools, key=lambda x: x['name'])}
        role_map[role_name] = role_obj
        with open(f"roles/{role_name}.json", "w") as f:
            json.dump(role_obj, f, indent=2)

    # 6g. Top‑level index
    top = {
        "metadata": {
            "total_tools": len(tools),
            "categories": sorted(by_cat.keys()),
            "tags": sorted(tag_index.keys()),
            "roles": sorted(role_map.keys())
        },
        "tag_counts": {tag: len(names) for tag, names in tag_index.items()},
        "category_counts": {c: len(by_cat[c]) for c in by_cat},
        "role_tool_counts": {r: len(role_map[r]['tools']) for r in role_map}
    }
    with open("TOOL_TAXONOMY.json", "w") as f:
        json.dump(top, f, indent=2)

    # Write tagged tools back to all_tools.jsonl
    with open("all_tools.jsonl","w") as f:
        for t in tools:
            f.write(json.dumps(t)+"\n")
    print(f"✅ Post‑refactor complete: {len(tools)} tools, {len(tag_index)} tags, {len(role_map)} roles.")
    print(f"   'other' remaining: {len(tag_index.get('other', []))}")

if __name__ == "__main__":
    main()
