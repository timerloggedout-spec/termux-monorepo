# ============================================================
# 3. Core functions
# ============================================================
def extract_tags(name):
    tags = set()
    for tag, patterns in TAG_RULES.items():
        for pat in patterns:
            if pat.endswith('*'):
                if name.startswith(pat[:-1]):
                    tags.add(tag)
            elif name == pat:
                tags.add(tag)
    if not tags:
        tags.add("other")
    return sorted(tags)

def load_auto_rules():
    import os
    if os.path.exists("auto_tag_rules.json"):
        with open("auto_tag_rules.json") as f:
            return json.load(f)
    return []

AUTO_RULES = None

def apply_auto_tags(tool):
    global AUTO_RULES
    if AUTO_RULES is None:
        AUTO_RULES = load_auto_rules()
    tags = set(tool.get("tags", []))
    if "other" not in tags:
        return
    pkg = tool.get("package", "")
    if not pkg:
        return
    for rule in AUTO_RULES:
        if re.match(rule["pattern"], pkg):
            if rule["tag"] != "other": tags.discard("other")
            tags.add(rule["tag"])
            tool["tags"] = sorted(tags)
            if rule["tag"] != "other": tool["auto_tag_source"] = f"auto:{rule["pattern"]}"
            return
